(lir-module "sequences" (init "run")
  (function "run"
    (vars (v obj) (s obj) (empty obj) (empty-string obj) (a obj) (b obj) (nil obj)
          (garbage obj) (literal obj) (character obj) (same obj)
          (length word) (index word) (one word) (n word) (more word))
    (block entry (set nil (nil)) (set a (fixnum 42)) (alloc a cons heap (a nil))
      (set length (word 17)) (alloc-sequence v simple-vector length a)
      (set b (fixnum 43)) (alloc b cons heap (b nil))
      (set index (word 16)) (vector-set v index b)
      (set length (word 2)) (alloc-sequence v simple-vector length v) (vector v (v v))
      (set length (word 5)) (set s (character 955)) (alloc-sequence s string length s)
      (set index (word 1)) (set character (character 33)) (string-set s index character)
      (set character (string-ref s index)) (set index (word 4))
      (set b (character 65536)) (string-set s index b)
      (set length (word 0)) (alloc-sequence empty simple-vector length v)
      (alloc-sequence empty-string string length b)
      (set length (word 17)) (set n (word 30000)) (set one (word 1)) (jump loop))
    (block loop (alloc-sequence garbage simple-vector length v) (vector literal (v s v))
      (set n (word-sub n one)) (set more (word-lt one n)) (branch more loop done))
    (block done (set index (word 0)) (set a (vector-ref v index))
      (set index (word 1)) (set b (vector-ref v index)) (set more (eq a b))
      (set same (fixnum-tag more)) (set index (word 0))
      (set a (vector-ref a index)) (set index (word 16)) (set a (vector-ref a index))
      (return (a s empty empty-string character same)))))
