(lir-module "objects" (init "run")
  (builtin undefined-function file) (builtin undefined-setf-function file)
  (builtin funcallable-trampoline file) (builtin funcallable-unset file)
  (function "noise" (vars (a obj) (b obj) (length word) (n word) (one word) (more word))
    (block e (set a (nil)) (set length (word 20)) (set n (word 30000)) (set one (word 1)) (jump loop))
    (block loop (alloc-sequence b simple-vector length a) (set n (word-sub n one))
      (set more (word-lt one n)) (branch more loop done)) (block done (return ())))
  (function "sink" (receive 1) (captures 1) (vars (a obj))
    (block e (set a (capture-ref 0)) (return (a))))
  (function "run" (vars (class obj) (stamp obj) (nil obj) (initial obj) (a obj) (b obj)
      (structure obj) (instance obj) (callable obj) (rack obj) (f obj) (returned obj)
      (first obj) (last obj) (layout obj) (klass obj) (slot obj) (stamp-out obj) (slots obj)
      (unbound obj) (function-ok obj) (count word) (index word) (same word) (m mv))
    (block e (set nil (nil)) (set class (fixnum 99)) (alloc class cons heap (class nil))
      (set stamp (fixnum 7)) (set initial (unbound-slot)) (set count (word 3))
      (set structure class) (alloc-structure structure structure count initial)
      (alloc-instance instance standard-instance class count stamp nil initial)
      (alloc-instance callable funcallable-instance class count stamp nil initial)
      (set a (fixnum 42)) (alloc a cons heap (a nil))
      (make-closure f "sink" heap (a)) (funcallable-function-set callable f)
      (set b (fixnum 43)) (alloc b cons heap (b nil))
      (set index (word 0)) (structure-slot-set structure index a) (instance-slot-set instance index a)
      (set index (word 2)) (structure-slot-set structure index b) (instance-slot-set instance index b)
      (instance-slot-definitions-set instance a) (set stamp (fixnum 8)) (instance-stamp-set instance stamp)
      (set rack (instance-rack instance)) (instance-rack-set callable rack)
      (set class (nil)) (set a (nil)) (set b (nil)) (set rack (nil))
      (set f (function "noise")) (call m f ())
      (set index (word 0)) (set first (structure-slot structure index))
      (set index (word 2)) (set last (structure-slot structure index))
      (set layout (structure-layout structure)) (set layout (field-ref cons.car layout))
      (set klass (instance-class callable)) (set klass (field-ref cons.car klass))
      (set slot (instance-slot callable index)) (set stamp-out (instance-stamp callable))
      (set slots (instance-slot-definitions callable)) (set index (word 1))
      (set a (instance-slot instance index)) (set same (eq a initial)) (set unbound (fixnum-tag same))
      (set a (funcallable-function callable)) (set same (test function a))
      (set function-ok (fixnum-tag same))
      (call m callable (first)) (set returned (mv-ref m 0))
      (return (first last layout klass slot stamp-out slots unbound returned function-ok)))))
