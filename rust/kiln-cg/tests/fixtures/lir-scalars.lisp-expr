(lir-module "scalars" (init "run")
  (function "run"
    (vars (a obj) (b obj) (q obj) (r obj) (bits obj) (shifted obj) (half obj) (even obj)
      (mask obj) (combined obj) (different obj) (logical obj) (signed obj) (product obj)
      (word-q obj) (word-r obj) (single obj) (negative-zero obj) (payload obj)
      (less obj) (equal obj) (greater obj) (unordered obj) (length-bad obj)
      (one word) (x word) (y word) (z word) (f f64) (g f64))
    (block e
      (set a (fixnum -17)) (set b (fixnum 5))
      (set q (fixnum-quotient a b)) (set r (fixnum-remainder a b))
      (set mask (fixnum-logand a b)) (set combined (fixnum-logior a b))
      (set different (fixnum-logxor a b)) (set bits (fixnum-lognot a))
      (set b (fixnum 2)) (set shifted (fixnum-shift-right a b))
      (set shifted (fixnum-shift-left shifted b))
      (set half (fixnum-half a)) (set x (fixnum-evenp a)) (set even (fixnum-tag x))
      (set x (word -1)) (set y (word 63)) (set x (word-shift-right-logical x y))
      (set logical (fixnum-tag x))
      (set x (word -8)) (set y (word 2)) (set z (word-shift-right x y))
      (set signed (fixnum-tag z)) (set z (word-mul z y)) (set product (fixnum-tag z))
      (set x (word -17)) (set y (word 5)) (set z (word-quotient x y))
      (set word-q (fixnum-tag z)) (set z (word-remainder x y)) (set word-r (fixnum-tag z))
      (set x (word 2147483648)) (set a (single-float-tag x)) (set y (single-float-bits a))
      (set x (word-eq x y)) (set single (fixnum-tag x))
      (set x (word -9223372036854775808)) (set f (f64-from-bits x)) (set y (f64-bits f))
      (set x (word-eq x y)) (set negative-zero (fixnum-tag x))
      (set x (word 9221120237041090626)) (set f (f64-from-bits x)) (set y (f64-bits f))
      (set x (word-eq x y)) (set payload (fixnum-tag x))
      (set g (f64 4607182418800017408)) (set x (f64-compare f g)) (set unordered (fixnum-tag x))
      (set f (f64 0)) (set x (f64-compare f g)) (set less (fixnum-tag x))
      (set x (f64-compare g f)) (set greater (fixnum-tag x))
      (set x (f64-compare g g)) (set equal (fixnum-tag x))
      (set a (fixnum -1)) (set x (invalid-vector-length a)) (set length-bad (fixnum-tag x))
      (runtime a gc ())
      (return (q r mask combined different bits shifted half even logical signed product
               word-q word-r single negative-zero payload less equal greater unordered length-bad)))))
