(lir-module "closures" (init "start")
  (function "start" (block e (return ())))
  (function "noise" (vars (a obj) (b obj) (x word) (one word) (keep word))
    (block e (set a (nil)) (set x (word 150000)) (set one (word 1)) (jump loop))
    (block loop (alloc b cons heap (a a)) (set x (word-sub x one))
      (set keep (word-lt one x)) (branch keep loop done)) (block done (return ())))
  (function "reader" (captures 1) (vars (a obj) (f obj) (m mv))
    (block e (set f (function "noise")) (call m f ()) (set a (capture-ref 0)) (return (a))))
  (function "alias" (vars (seed obj) (a obj) (f obj) (m mv))
    (block e (set seed (nil)) (set a (fixnum 42)) (alloc seed cons heap (a seed))
      (make-closure seed "reader" heap (seed)) (set f (function "noise")) (call m f ())
      (set f (nil)) (call-spread m seed () f) (set a (mv-ref m 0)) (set a (field-ref cons.car a)) (return (a))))
  (function "even" (captures 2) (receive 1)
    (vars (a obj) (f obj) (n word) (zero word) (one word) (done word))
    (block e (set a (arg-ref 0)) (set n (fixnum-untag a)) (set zero (word 0))
      (set done (word-eq n zero)) (branch done base recur))
    (block base (set a (capture-ref 1)) (return (a)))
    (block recur (set one (word 1)) (set n (word-sub n one)) (set a (fixnum-tag n))
      (set f (capture-ref 0)) (tail-call f (a))))
  (function "odd" (captures 2) (receive 1)
    (vars (a obj) (f obj) (n word) (zero word) (one word) (done word))
    (block e (set a (arg-ref 0)) (set n (fixnum-untag a)) (set zero (word 0))
      (set done (word-eq n zero)) (branch done base recur))
    (block base (set a (capture-ref 1)) (return (a)))
    (block recur (set one (word 1)) (set n (word-sub n one)) (set a (fixnum-tag n))
      (set f (capture-ref 0)) (tail-call f (a))))
  (function "recursive" (vars (seed obj) (even obj) (odd obj) (f obj) (a obj) (m mv))
    (block e (set seed (nil)) (set a (fixnum 42)) (alloc seed cons heap (a seed))
      (alloc-closure even "even" heap) (alloc-closure odd "odd" heap)
      (capture-set even "even" 0 odd) (capture-set even "even" 1 seed)
      (capture-set odd "odd" 0 even) (capture-set odd "odd" 1 seed)
      (set seed (nil)) (set f (function "noise")) (call m f ())
      (set a (fixnum 9)) (call m even (a)) (set a (mv-ref m 0))
      (set a (field-ref cons.car a)) (return (a))))
  (function "zeroed" (vars (seed obj) (a obj) (b obj) (f obj) (m mv))
    (block e (alloc-closure seed "reader" heap) (set f (function "noise")) (call m f ())
      (call m seed ()) (set b (mv-ref m 0)) (set a (fixnum 42)) (set f (nil))
      (alloc f cons heap (a f)) (capture-set seed "reader" 0 f)
      (set f (function "noise")) (call m f ()) (call m seed ()) (set a (mv-ref m 0))
      (set a (field-ref cons.car a)) (return (b a))))
  (function "escape" (captures 1) (vars (token obj) (a obj) (b obj) (m mv))
    (block e (set token (capture-ref 0)) (set a (fixnum 88)) (set b (fixnum 89))
      (values m (a b)) (exit-to token m)))
  (function "exit" (vars (token obj) (f obj) (m mv)) (region target exit-point nil landed)
    (block e (set token (nil)) (alloc token cons heap (token token)) (enter target (token))
      (make-closure f "escape" heap (token)) (set token (nil))
      (call m f () (region target)) (leave target) (return-mv m))
    (block landed (landing target m) (return-mv m)))
  (function "wide" (captures 20) (vars (a obj) (f obj) (m mv))
    (block e (set f (function "noise")) (call m f ()) (set a (capture-ref 19)) (return (a))))
  (function "large" (vars (seed obj) (f obj) (a obj) (b obj) (z obj) (m mv))
    (block e (set seed (nil)) (set a (fixnum 42)) (set z (fixnum 0))
      (alloc seed cons heap (a seed))
      (make-closure f "wide" heap (z z z z z z z z z z z z z z z z z z z seed))
      (alloc-closure b "wide" heap) (set a (function "noise")) (call m a ())
      (capture-set b "wide" 19 seed) (set seed (nil))
      (set a (function "noise")) (call m a ()) (call m f ())
      (set a (mv-ref m 0)) (set a (field-ref cons.car a))
      (call m b ()) (set b (mv-ref m 0)) (set b (field-ref cons.car b)) (return (a b))))
  (function "run" (vars (a obj) (b obj) (c obj) (d obj) (e obj) (f obj) (m mv))
    (block e (set f (function "alias")) (call m f ()) (mv-save a m)
      (set f (function "recursive")) (call m f ()) (mv-save b m)
      (set f (function "zeroed")) (call m f ()) (mv-save c m)
      (set f (function "exit")) (call m f ()) (mv-save d m)
      (set f (function "large")) (call m f ()) (mv-save e m)
      (return (a b c d e)))))
