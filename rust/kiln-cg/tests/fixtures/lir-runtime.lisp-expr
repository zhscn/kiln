(lir-module "runtime-services" (init "run")
  (function "echo" (receive 1) (vars (a obj) (ignored obj))
    (block e (set a (arg-ref 0)) (runtime ignored gc ()) (return (a))))
  (function "escape" (receive 1) (captures 1) (vars (a obj) (tag obj) (m mv))
    (block e (set a (arg-ref 0)) (set tag (capture-ref 0)) (values m (a)) (throw tag m)))
  (function "run" (vars (a obj) (b obj) (nil obj) (hash obj) (hash2 obj) (stable obj)
      (count obj) (ignored obj) (normal obj) (escaped obj) (f obj) (tag obj) (token obj)
      (token-ok obj) (same word) (m mv))
    (region r catch nil landed)
    (block e (set nil (nil)) (set a (fixnum 42)) (alloc a cons heap (a nil))
      (values m (a a)) (runtime hash identity-hash (a)) (runtime count gc-count ())
      (set b (mv-ref m 1)) (runtime ignored gc ())
      (runtime hash2 identity-hash (a)) (set same (eq hash hash2)) (set stable (fixnum-tag same))
      (set f (function "echo")) (runtime normal call-on-new-stack (f b))
      (set token (frame-pointer)) (set same (test fixnum token)) (set token-ok (fixnum-tag same))
      (set tag (fixnum 9)) (make-closure f "escape" heap (tag)) (enter r (tag))
      (runtime escaped call-on-new-stack (f b) (region r)) (leave r) (jump done))
    (block landed (landing r m) (set escaped (mv-ref m 0)) (jump done))
    (block done (runtime ignored gc ()) (return (b stable normal escaped token-ok)))))
