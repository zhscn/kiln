(lir-module "stack" (init "run")
  (function "noise" (vars (a obj) (b obj) (x word) (one word) (keep word))
    (block e (set a (nil)) (set x (word 150000)) (set one (word 1)) (jump loop))
    (block loop (alloc b cons heap (a a)) (set x (word-sub x one))
      (set keep (word-lt one x)) (branch keep loop done)) (block done (return ())))
  (function "reader" (captures 1) (vars (f obj) (cell obj) (a obj) (b obj) (m mv))
    (block e (set f (function "noise")) (call m f ()) (set cell (capture-ref 0))
      (set a (field-ref cons.car cell)) (set a (field-ref cons.car a))
      (set b (fixnum 43)) (return (a b))))
  (function "both" (vars (f obj) (cell obj) (seed obj) (a obj) (nil obj) (m mv))
    (stack-object cell cons) (stack-object fun (closure "reader"))
    (region cell-roots stack-roots nil cell) (region fun-roots stack-roots cell-roots fun)
    (block e (set nil (nil)) (set a (fixnum 42)) (alloc seed cons heap (a nil))
      (enter cell-roots ()) (enter fun-roots ()) (set f (function "noise")) (call m f ())
      (alloc cell cons (stack cell) (seed nil)) (make-closure f "reader" (stack fun) (cell))
      (set seed nil) (set cell nil) (call m f ()) (leave fun-roots) (leave cell-roots) (return-mv m)))
  (function "cons-only" (vars (a obj) (b obj) (f obj) (nil obj) (m mv))
    (stack-object pair cons) (region roots stack-roots nil pair)
    (block e (set nil (nil)) (set a (fixnum 42)) (set b (fixnum 43))
      (alloc a cons heap (a nil)) (alloc b cons heap (b nil)) (enter roots ())
      (alloc b cons (stack pair) (a b)) (set a nil) (set f (function "noise")) (call m f ())
      (set a (field-ref cons.car b)) (set a (field-ref cons.car a))
      (set b (field-ref cons.cdr b)) (set b (field-ref cons.car b))
      (leave roots) (return (a b))))
  (function "reenter" (vars (a obj) (b obj) (f obj) (seed obj) (nil obj) (n word) (one word) (zero word) (more word) (m mv))
    (stack-object pair cons) (region roots stack-roots nil pair)
    (block e (set nil (nil)) (set a (fixnum 42)) (alloc seed cons heap (a nil))
      (set n (word 3)) (set one (word 1)) (set zero (word 0)) (set f (function "noise")) (jump loop))
    (block loop (enter roots ()) (call m f ()) (alloc b cons (stack pair) (seed nil))
      (set a (field-ref cons.car b)) (set a (field-ref cons.car a)) (leave roots)
      (call m f ()) (set n (word-sub n one)) (set more (word-lt zero n)) (branch more loop done))
    (block done (return (a))))
  (function "escaping" (receive 1) (vars (tag obj) (seed obj) (pair obj) (a obj) (b obj) (f obj) (nil obj) (m mv))
    (stack-object pair cons) (region roots stack-roots nil pair)
    (block e (set tag (arg-ref 0)) (set nil (nil)) (set a (fixnum 42))
      (enter roots ()) (alloc seed cons heap (a nil)) (alloc pair cons (stack pair) (seed nil))
      (set seed nil) (set f (function "noise")) (call m f ())
      (set seed (field-ref cons.car pair)) (set b (fixnum 7)) (values m (seed b)) (throw tag m)))
  (function "catcher" (vars (tag obj) (f obj) (a obj) (b obj) (m mv)) (region target catch nil landed)
    (block e (set tag (nil)) (set f (function "escaping")) (enter target (tag))
      (call m f (tag) (region target)) (leave target) (return-mv m))
    (block landed (landing target m) (set a (mv-ref m 0)) (set a (field-ref cons.car a))
      (set b (mv-ref m 1)) (return (a b))))
  (function "wide" (captures 20) (vars (f obj) (a obj) (m mv))
    (block e (set f (function "noise")) (call m f ()) (set a (capture-ref 19))
      (set a (field-ref cons.car a)) (return (a))))
  (function "large" (vars (f obj) (seed obj) (a obj) (nil obj) (m mv))
    (stack-object fun (closure "wide")) (region roots stack-roots nil fun)
    (block e (set nil (nil)) (set a (fixnum 42)) (alloc seed cons heap (a nil))
      (enter roots ()) (set f (function "noise")) (call m f ())
      (alloc-closure f "wide" (stack fun)) (capture-set f "wide" 19 seed)
      (set seed nil) (call m f ()) (leave roots) (return-mv m)))
  (function "run" (vars (f obj) (a obj) (b obj) (c obj) (d obj) (e obj) (m mv))
    (block entry (set f (function "both")) (call m f ()) (mv-save a m)
      (set f (function "cons-only")) (call m f ()) (mv-save b m)
      (set f (function "reenter")) (call m f ()) (mv-save c m)
      (set f (function "catcher")) (call m f ()) (mv-save d m)
      (set f (function "large")) (call m f ()) (mv-save e m)
      (set f (function "noise")) (call m f ()) (return (a b c d e)))))
