(lir-module "arguments" (init "run")
  (function "noise" (vars (a obj) (b obj) (n word) (one word) (more word))
    (block e (set a (nil)) (set n (word 150000)) (set one (word 1)) (jump loop))
    (block loop (alloc b cons heap (a a)) (set n (word-sub n one))
      (set more (word-lt one n)) (branch more loop done)) (block done (return ())))
  (function "heap" (receive 2) (rest tail 2)
    (vars (tail obj) (f obj) (m mv))
    (block e (set f (function "noise")) (call m f ()) (return (tail))))
  (function "sink" (receive 1) (vars (a obj))
    (block e (set a (arg-ref 0)) (return (a))))
  (function "stack" (rest tail 1 (stack 3))
    (vars (tail obj) (f obj) (a obj) (empty word) (m mv))
    (block e (set f (function "noise")) (call m f ())
      (set a (nil)) (set empty (eq tail a)) (branch empty zero some))
    (block zero (return (tail)))
    (block some (set a (field-ref cons.car tail)) (set f (function "sink")) (tail-call f (a))))
  (function "escape" (receive 1) (rest tail 1 (stack 2))
    (vars (tail obj) (tag obj) (a obj) (m mv))
    (block e (set tag (arg-ref 0)) (set a (field-ref cons.car tail))
      (values m (a)) (throw tag m)))
  (function "sum" (rest tail 0)
    (vars (tail obj) (total obj) (pair obj) (item obj) (nil obj) (empty word))
    (block e (set total (fixnum 0)) (set nil (nil)) (jump loop))
    (block loop (set empty (eq tail nil)) (branch empty done body))
    (block body (set pair (field-ref cons.car tail)) (set item (field-ref cons.car pair))
      (set total (fixnum-add total item)) (set tail (field-ref cons.cdr tail)) (jump loop))
    (block done (return (total))))
  (function "run" (vars (f obj) (nil obj) (a obj) (b obj) (c obj) (d obj) (e obj)
      (h obj) (z obj) (s obj) (t obj) (u obj) (escaped obj) (tag obj) (m mv)
      (args obj) (item obj) (sum obj) (n word) (one word) (zero word) (more word))
    (region r catch nil landed)
    (block e (set nil (nil)) (set a (fixnum 10)) (set b (fixnum 20))
      (set c (fixnum 30)) (set d (fixnum 40)) (set e (fixnum 50))
      (set f (function "heap")) (call m f (a b c d e)) (set h (mv-ref m 0))
      (set a (fixnum 42)) (alloc a cons heap (a nil))
      (set b (fixnum 43)) (alloc b cons heap (b nil))
      (set c (fixnum 44)) (alloc c cons heap (c nil))
      (set d (fixnum 45)) (alloc d cons heap (d nil))
      (set f (function "stack")) (call m f (nil)) (set z (mv-ref m 0))
      (call m f (nil a b)) (set s (mv-ref m 0))
      (call m f (nil a b c)) (set t (mv-ref m 0))
      (call m f (nil a b c d)) (set u (mv-ref m 0))
      (set tag (fixnum 9)) (enter r (tag)) (set f (function "escape"))
      (call m f (tag a b) (region r)) (set escaped (mv-ref m 0)) (leave r) (jump done))
    (block landed (landing r m) (set escaped (mv-ref m 0)) (jump done))
    (block done (set f (function "noise")) (call m f ())
      (set args (nil)) (set n (word 1024)) (set one (word 1)) (set zero (word 0)) (jump build))
    (block build (set item (fixnum 1)) (alloc item cons heap (item nil))
      (alloc args cons heap (item args)) (set n (word-sub n one))
      (set more (word-lt zero n)) (branch more build calls))
    (block calls (set f (function "sum")) (set n (word 100)) (jump again))
    (block again (call-spread m f () args) (set sum (mv-ref m 0))
      (set n (word-sub n one)) (set more (word-lt zero n)) (branch more again final))
    (block final (return (h z s t u escaped sum)))))
