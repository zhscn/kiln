(lir-module "spread" (init "run")
  (function "count" (vars (n word) (a obj))
    (block e (set n (arg-count)) (set a (fixnum-tag n)) (return (a))))
  (function "ends" (receive 4) (vars (first obj) (last obj) (n word) (count obj))
    (block e (set first (arg-ref 0)) (set last (arg-ref 3)) (set n (arg-count))
      (set count (fixnum-tag n)) (return (first last count))))
  (function "ends-max" (receive 1024) (vars (first obj) (last obj) (n word) (count obj))
    (block e (set first (arg-ref 0)) (set last (arg-ref 1023)) (set n (arg-count))
      (set count (fixnum-tag n)) (return (first last count))))
  (function "empty" (vars (f obj) (tail obj) (m mv))
    (block e (set f (function "count")) (set tail (nil))
      (call-spread m f () tail) (return-mv m)))
  (function "prefix" (vars (f obj) (tail obj) (a obj) (b obj) (c obj) (d obj) (m mv))
    (block e (set f (function "ends")) (set tail (nil))
      (set a (fixnum 10)) (set b (fixnum 20)) (set c (fixnum 30)) (set d (fixnum 40))
      (alloc tail cons heap (d tail)) (alloc tail cons heap (c tail))
      (call-spread m f (a b) tail (loc 12 24)) (return-mv m)))
  (function "maximum" (receive 1)
    (vars (f obj) (tail obj) (a obj) (b obj) (c obj) (n word) (one word) (zero word) (more word) (m mv))
    (block e (set a (arg-ref 0)) (set n (fixnum-untag a)) (set tail (nil))
      (set a (fixnum 10)) (set b (fixnum 20)) (set c (fixnum 30))
      (set one (word 1)) (set zero (word 0)) (jump loop))
    (block loop (alloc tail cons heap (c tail)) (set n (word-sub n one))
      (set more (word-lt zero n)) (branch more loop done))
    (block done (set f (function "ends-max"))
      (call-spread m f (a b) tail) (return-mv m)))
  (function "dotted" (vars (f obj) (tail obj) (a obj) (m mv))
    (block e (set f (function "count")) (set tail (fixnum 9)) (set a (fixnum 1))
      (alloc tail cons heap (a tail)) (call-spread m f () tail) (return-mv m)))
  (function "cycle" (vars (f obj) (tail obj) (a obj) (m mv))
    (block e (set f (function "count")) (set tail (nil)) (set a (fixnum 1))
      (alloc tail cons heap (a tail)) (field-set cons.cdr tail tail)
      (call-spread m f () tail) (return-mv m)))
  (function "run" (vars (f obj) (a obj) (b obj) (c obj) (n obj) (m mv))
    (block e (set f (function "empty")) (call m f ()) (mv-save a m)
      (set f (function "prefix")) (call m f ()) (mv-save b m)
      (set f (function "maximum")) (set n (fixnum 1022)) (call m f (n)) (mv-save c m)
      (return (a b c)))))
