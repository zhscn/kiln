(lir-module "unwind" (init "start")
  (function "start" (block e (return ())))
  (function "noise" (vars (a obj) (b obj) (x word) (one word) (keep word))
    (block e (set a (nil)) (set one (word 1)) (set x (word 150000)) (jump loop))
    (block loop (alloc b cons heap (a a)) (set x (word-sub x one))
      (set keep (word-lt one x)) (branch keep loop done))
    (block done (return ())))
  (function "maker" (vars (a obj) (b obj) (m mv))
    (block e (set a (fixnum 7)) (set b (nil)) (alloc b cons heap (a b))
      (values m (a b)) (return-mv m)))
  (function "thrower" (receive 1) (vars (tag obj) (f obj) (m mv))
    (block e (set tag (arg-ref 0)) (set f (function "maker")) (call m f ()) (throw tag m)))
  (function "catcher" (vars (tag obj) (f obj) (m mv))
    (region r catch nil caught)
    (block e (set tag (nil)) (set f (function "thrower")) (enter r (tag))
      (call-spread m f (tag) tag (region r)) (leave r) (return-mv m))
    (block caught (landing r m) (return-mv m)))
  (function "nested" (vars (tag obj) (other obj) (f obj) (m mv))
    (region outer catch nil caught) (region inner catch outer wrong)
    (block e (set tag (nil)) (set other (t)) (set f (function "thrower"))
      (enter outer (tag)) (enter inner (other)) (call m f (tag) (region inner))
      (leave inner) (leave outer) (return-mv m))
    (block wrong (landing inner m) (leave outer) (trap))
    (block caught (landing outer m) (return-mv m)))
  (function "protected" (vars (tag obj) (f obj) (flag obj) (a obj) (b obj) (m mv) (ignored mv))
    (region outer catch nil caught) (region cleanup unwind-protect outer clean)
    (block e (set tag (nil)) (set flag (fixnum 0)) (set f (function "thrower"))
      (enter outer (tag)) (enter cleanup ()) (call m f (tag) (region cleanup))
      (leave cleanup) (leave outer) (return-mv m))
    (block clean (landing cleanup) (set f (function "noise"))
      (call ignored f () (region outer)) (set flag (fixnum 77)) (continue-unwind cleanup))
    (block caught (landing outer m) (set a (mv-ref m 0)) (set b (mv-ref m 1))
      (values m (a b flag)) (return-mv m)))
  (function "override" (vars (tag obj) (f obj) (a obj) (m mv))
    (region outer catch nil caught) (region cleanup unwind-protect outer clean)
    (block e (set tag (nil)) (set f (function "thrower"))
      (enter outer (tag)) (enter cleanup ()) (call m f (tag) (region cleanup))
      (leave cleanup) (leave outer) (return-mv m))
    (block clean (landing cleanup) (leave cleanup) (leave outer) (set a (fixnum 99)) (return (a)))
    (block caught (landing outer m) (return-mv m)))
  (function "exiter" (receive 1) (vars (tag obj) (a obj) (b obj) (m mv))
    (block e (set tag (arg-ref 0)) (set a (fixnum 55)) (set b (fixnum 56))
      (values m (a b)) (exit-to tag m)))
  (function "exitpoint" (vars (tag obj) (f obj) (m mv))
    (region target exit-point nil landed)
    (block e (set tag (nil)) (alloc tag cons heap (tag tag)) (set f (function "exiter"))
      (enter target (tag)) (call m f (tag) (region target)) (leave target) (return-mv m))
    (block landed (landing target m) (return-mv m)))
  (function "zero" (vars (tag obj) (m mv)) (region target catch nil landed)
    (block e (set tag (nil)) (enter target (tag)) (values m ()) (throw tag m))
    (block landed (landing target m) (return-mv m)))
  (function "single" (vars (tag obj) (m mv)) (region target catch nil landed)
    (block e (set tag (nil)) (enter target (tag)) (values m (tag)) (throw tag m))
    (block landed (landing target m) (return-mv m)))
  (function "saved" (vars (f obj) (saved obj) (m mv) (n mv))
    (block e (set f (function "maker")) (call m f ()) (mv-save saved m)
      (set f (function "noise")) (call m f ()) (mv-restore m saved) (mv-move n m) (mv-move m n)
      (set saved (nil)) (mv-push saved m saved) (values-from-list m saved)
      (set saved (nil)) (mv-push saved m saved) (values-from-list m saved)
      (return-mv m)))
  (function "bind-normal" (receive 1) (vars (s obj) (a obj) (b obj)) (region bound bind nil)
    (block e (set s (arg-ref 0)) (set a (fixnum 1)) (set b (fixnum 2))
      (enter bound (s a)) (set a (special-ref s)) (special-set s b)
      (leave bound) (set b (special-ref s)) (set s (special-ref s)) (return (a b s))))
  (function "read-throw" (receive 2) (vars (s obj) (tag obj) (a obj) (m mv))
    (block e (set s (arg-ref 0)) (set tag (arg-ref 1)) (set a (special-ref s))
      (values m (a)) (throw tag m)))
  (function "bind-unwind" (receive 1) (vars (s obj) (tag obj) (a obj) (b obj) (f obj) (m mv))
    (region target catch nil landed) (region bound bind target)
    (block e (set s (arg-ref 0)) (set tag (nil)) (set a (fixnum 9)) (set f (function "read-throw"))
      (enter target (tag)) (enter bound (s a)) (call m f (s tag) (region target))
      (leave bound) (leave target) (return-mv m))
    (block landed (landing target m) (set a (mv-ref m 0)) (set b (special-ref s)) (return (a b))))
  (function "progv-normal" (receive 2)
    (vars (s obj) (t obj) (nil obj) (symbols obj) (values obj) (a obj) (b obj) (c obj) (d obj) (condition word))
    (region bound progv nil)
    (block e (set s (arg-ref 0)) (set t (arg-ref 1)) (set nil (nil))
      (set a (fixnum 1)) (set b (fixnum 2))
      (alloc symbols cons heap (t nil)) (alloc symbols cons heap (s symbols)) (alloc symbols cons heap (s symbols))
      (alloc values cons heap (b nil)) (alloc values cons heap (a values))
      (enter bound (symbols values)) (set a (special-ref s)) (set b (special-ref t))
      (set c (unbound)) (set condition (eq b c)) (set b (fixnum-tag condition))
      (leave bound) (set c (special-ref s)) (set d (special-ref t)) (return (a b c d))))
  (function "progv-unwind" (receive 2)
    (vars (s obj) (t obj) (nil obj) (symbols obj) (values obj) (a obj) (b obj) (c obj) (f obj) (m mv))
    (region target catch nil landed) (region bound progv target)
    (block e (set s (arg-ref 0)) (set t (arg-ref 1)) (set nil (nil))
      (set a (fixnum 1)) (set b (fixnum 2)) (set f (function "read-throw"))
      (alloc symbols cons heap (t nil)) (alloc symbols cons heap (s symbols)) (alloc symbols cons heap (s symbols))
      (alloc values cons heap (b nil)) (alloc values cons heap (a values))
      (enter target (nil)) (enter bound (symbols values)) (call m f (s nil) (region target))
      (leave bound) (leave target) (return-mv m))
    (block landed (landing target m) (set a (mv-ref m 0)) (set b (special-ref s)) (set c (special-ref t)) (return (a b c))))
  (function "rethrown" (vars (tag obj) (other obj) (a obj) (f obj) (m mv))
    (region outer catch nil landed) (region cleanup unwind-protect outer clean) (region inner catch cleanup wrong)
    (block e (set tag (nil)) (set other (t)) (set f (function "thrower"))
      (enter outer (tag)) (enter cleanup ()) (call m f (tag) (region cleanup))
      (leave cleanup) (leave outer) (return-mv m))
    (block clean (landing cleanup) (enter inner (other)) (set a (fixnum 88)) (values m (a)) (throw tag m))
    (block wrong (landing inner m) (leave cleanup) (leave outer) (trap))
    (block landed (landing outer m) (return-mv m)))
  (function "exit-reenter" (vars (token obj) (f obj) (a obj) (b obj) (c obj) (x word) (one word) (limit word) (more word) (m mv))
    (region target exit-point nil landed)
    (block e (set token (nil)) (alloc token cons heap (token token)) (set f (function "exiter"))
      (set x (word 0)) (set one (word 1)) (set limit (word 3))
      (enter target (token)) (call m f (token) (region target)) (leave target) (return-mv m))
    (block again (enter target (token)) (call m f (token) (region target)) (leave target) (return-mv m))
    (block landed (landing target m) (set a (mv-ref m 0)) (set b (mv-ref m 1))
      (set x (word-add x one)) (set more (word-lt x limit)) (branch more again done))
    (block done (set c (fixnum-tag x)) (return (a b c))))
  (function "run" (receive 2)
    (vars (f obj) (s obj) (t obj) (a obj) (b obj) (c obj) (d obj) (e obj) (g obj) (h obj) (i obj) (j obj) (k obj) (l obj) (o obj) (p obj) (q obj) (m mv))
    (block e
      (set s (arg-ref 0)) (set t (arg-ref 1))
      (set f (function "catcher")) (call m f ()) (mv-save a m)
      (set f (function "nested")) (call m f ()) (mv-save b m)
      (set f (function "protected")) (call m f ()) (mv-save c m)
      (set f (function "override")) (call m f ()) (mv-save d m)
      (set f (function "exitpoint")) (call m f ()) (mv-save e m)
      (set f (function "zero")) (call m f ()) (mv-save g m)
      (set f (function "single")) (call m f ()) (mv-save h m)
      (set f (function "saved")) (call m f ()) (mv-save i m)
      (set f (function "bind-normal")) (call m f (s)) (mv-save j m)
      (set f (function "bind-unwind")) (call m f (s)) (mv-save k m)
      (set f (function "progv-normal")) (call m f (s t)) (mv-save l m)
      (set f (function "progv-unwind")) (call m f (s t)) (mv-save o m)
      (set f (function "rethrown")) (call m f ()) (mv-save p m)
      (set f (function "exit-reenter")) (call m f ()) (mv-save q m)
      (return (a b c d e g h i j k l o p q)))))
