;;;; Run with SBCL after tools/env.lisp and (ql:quickload "kiln").
(in-package #:kiln.compiler)

(defun ir-test-form (form)
  (let ((*source-file* "ir-test") (*toplevel-source* nil))
    (let ((forms (front-end-forms (list form))))
      (assert (= (length forms) 1))
      (toplevel-form-ast (first forms)))))

(defun ir-test-nodes (fun)
  (let ((result '()))
    (labels ((visit-function (fun) (ir-map-function #'visit fun))
             (visit (node)
               (push node result)
               (case (ir-node-kind node)
                 (13 (loop for child across (ir-node-a node) do (visit-function child))
                     (visit (ir-node-b node)))
                 ((6 7)
                  (let ((child (ir-own-function node))) (when child (visit-function child)))
                  (when (= (ir-node-kind node) 7)
                    (when (ir-node-p (ir-node-a node)) (visit (ir-node-a node)))
                    (loop for arg across (ir-node-b node) do (visit arg))))
                 (24 (visit-function (ir-node-a node)))
                 (otherwise (ir-map-children #'visit node)))))
      (visit-function fun))
    (nreverse result)))

(let* ((root (ir-test-form '(let ((x 1)) (list (lambda () x) (lambda (v) (setq x v))))))
       (var (svref (ir-node-a (ir-fun-body root)) 0))
       (functions (mapcar #'ir-node-a (remove-if-not (lambda (n) (= (ir-node-kind n) 6))
                                                    (ir-test-nodes root)))))
  (assert (= (logand (ir-var-flags var) 7) 7))
  (assert (= (length functions) 2))
  (dolist (fun functions) (assert (find var (ir-fun-free fun)))))

(let* ((root (ir-test-form '(let ((x 1)) (lambda () (lambda () x)))))
       (outer (ir-node-a (ir-node-c (ir-fun-body root))))
       (inner (ir-node-a (ir-fun-body outer))))
  (assert (= (length (ir-fun-free outer)) 1))
  (assert (eq (svref (ir-fun-free outer) 0) (svref (ir-fun-free inner) 0))))

(let* ((root (ir-test-form '(block done (lambda () (return-from done 1)))))
       (exit (ir-node-a (ir-fun-body root)))
       (child (ir-node-a (ir-node-b (ir-fun-body root)))))
  (assert (logtest 1 (ir-exit-flags exit)))
  (assert (find (ir-exit-token exit) (ir-fun-free child))))

(let ((nodes (ir-test-nodes (ir-test-form '(flet ((inc (x) (+ x 1))) (inc 2))))))
  (assert (notany (lambda (n) (and (= (ir-node-kind n) 7) (ir-fun-p (ir-node-a n)))) nodes))
  (assert (some (lambda (n) (= (ir-node-kind n) 11)) nodes)))

(let* ((root (ir-test-form '(let ((x 1)) (declare (ignorable x) (type fixnum x)) x)))
       (var (svref (ir-node-a (ir-fun-body root)) 0)))
  (assert (some (lambda (node) (and (= (ir-node-kind node) 1)
                                    (eq (ir-node-a node) var) (eq (ir-node-b node) 'fixnum)))
                (ir-test-nodes root)))
  (assert (logtest 8 (ir-var-flags var))))

(dolist (form '((declare (ignore x)) (if 1) (setq x) (let ((x 1) (x 2)) x)
                (function (setf x y)) (return-from missing) (go nowhere)
                (lambda (&rest)) (lambda (x x) x) (lambda (&optional &optional) nil)
                (lambda (x &aux x) x) (load-time-value 1 :invalid)
                (symbol-macrolet ((x 1)) (declare (special x)) x)))
  (assert (handler-case (progn (ir-test-form form) nil) (kiln-compile-error () t))
          () "Accepted invalid form ~S" form))

(let ((location (ir-source-position 4095 123 33554431)))
  (assert (typep location 'fixnum))
  (assert (= (ir-source-file-id location) 4095))
  (assert (equal (ir-source-range location) '(123 . 33554431))))

(let* ((root (ir-test-form '(flet ((and (x y) (+ x y))) (and 1 2))))
       (nodes (ir-test-nodes root)))
  (assert (some (lambda (node) (and (= (ir-node-kind node) 7) (eq (ir-node-a node) '+))) nodes)))

(let ((nodes (ir-test-nodes (ir-test-form '(let ((x 1)) (lambda () (setq x 2))))))
      (seen (make-hash-table :test 'eq)))
  (dolist (node nodes)
    (assert (not (gethash node seen)))
    (setf (gethash node seen) t)
    (assert (or (null (ir-node-source node)) (typep (ir-node-source node) 'fixnum)))))

(let* ((root (ir-test-form '(let ((x 1))
                              (flet ((capture (y) (lambda () (+ x y)))) (capture 2)))))
       (nodes (ir-test-nodes root))
       (closure (ir-node-a (find 6 nodes :key #'ir-node-kind))))
  (assert (eq (ir-fun-parent closure) root))
  (assert (= (length (ir-fun-free closure)) 2))
  (loop for var across (ir-fun-free closure) do (assert (eq (ir-var-owner var) root))))

(let ((nodes (ir-test-nodes
              (ir-test-form '(flet ((outer (x) (flet ((inner (y) (+ x y))) (inner 2)))) (outer 3))))))
  (assert (notany (lambda (node) (member (ir-node-kind node) '(6 13)))
                  (remove-if (lambda (node) (and (= (ir-node-kind node) 13)
                                                (zerop (length (ir-node-a node))))) nodes))))

(let ((root (ir-test-form '(labels ((producer () (load-time-value (list 1)))
                                   (caller () (producer)))
                            (caller)))))
  (assert (= (ir-buffer-count (ir-fun-load-time-values root)) 1)))

(assert (ir-fun-p (ir-test-form '(flet (((setf place) (value object)
                                          (declare (ignore object))
                                          (return-from place value)))
                                  (funcall #'(setf place) 1 nil)))))

(let ((nodes (ir-test-nodes
              (ir-test-form '(macrolet ((value () 4))
                               (let ((x 1))
                                 (macrolet ((probe (&environment env) (macroexpand '(value) env)))
                                   (probe))))))))
  (assert (some (lambda (node) (and (= (ir-node-kind node) 0) (eql (ir-node-a node) 4))) nodes)))


;;; The IR evaluator (lisp/ir/eval.lisp) against the host's EVAL.
(let ((session (make-session)))
  (call-with-front-end
   session
   (lambda ()
     (dolist (form
              '((let ((x 1)) (+ x 2))
                (multiple-value-list (values 1 2 3))
                (funcall (lambda (a &optional (b 10) &key (c (+ a b)) d) (list a b c d)) 1 2 :d 4)
                (funcall (lambda (a &optional (b 10 b-p) &rest r &key c &allow-other-keys)
                           (list a b b-p r c))
                         1 2 :z 3 :c 4 :c 5)
                (funcall (lambda (&key ((:x y) 7 y-p)) (list y y-p)))
                (funcall (lambda (&key a) a) :a 1 :allow-other-keys t :b 2)
                (let ((fns '()))
                  (dotimes (i 3) (let ((j i)) (push (lambda () j) fns)))
                  (mapcar #'funcall fns))
                (let ((fns '()))
                  (dolist (i '(1 2 3)) (let ((j i)) (push (lambda () (incf j 10)) fns)))
                  (list (mapcar #'funcall fns) (mapcar #'funcall fns)))
                (let ((x 0)) (flet ((inc () (incf x))) (inc) (inc) (list x (inc))))
                (labels ((ev (n) (if (zerop n) t (od (1- n)))) (od (n) (if (zerop n) nil (ev (1- n)))))
                  (list (ev 10) (ev 7) (mapcar #'ev '(1 2))))
                (block b (mapc (lambda (x) (when (> x 2) (return-from b x))) '(1 2 3 4)) :none)
                (block b (let ((y 1)) (if y (return-from b (values 1 2)) 3)))
                (multiple-value-list (block b (dolist (x '(1 2 3)) (when (= x 2) (return (values x :two)))) 9))
                (let ((n 0) (acc '())) (tagbody top (push n acc) (incf n) (when (< n 5) (go top))) acc)
                (let ((acc '()))
                  (tagbody (funcall (lambda () (push 1 acc) (go out))) (push 2 acc) out (push 3 acc))
                  acc)
                (let ((acc '()) (k 0))
                  (tagbody a (push (list 'a k) acc)
                           (setq k (+ k (if (< k 3) (progn (push k acc) (incf k) (go a)) 100)))
                           (push k acc))
                  acc)
                (catch 'tag (list 1 (throw 'tag (values 2 3))))
                (multiple-value-list (catch 'tag (throw 'tag (values 2 3))))
                (let ((log '()))
                  (list (catch 'x (unwind-protect (throw 'x 1) (push :cleanup log))) log))
                (let ((log '()))
                  (block b (unwind-protect (return-from b 1) (push :c log))) log)
                (let ((sv 10)) (declare (special sv)) sv)
                (let ((x 1)) (declare (special x))
                  (flet ((getx () (symbol-value 'x)))
                    (list (getx) (let ((x 2)) (declare (special x)) (getx)) (getx))))
                (let ((y 1)) (declare (special y))
                  (list (catch 'z (let ((y 2)) (declare (special y)) (throw 'z (symbol-value 'y))))
                        (symbol-value 'y)))
                (funcall (lambda (z &optional (w (symbol-value 'z))) (declare (special z)) (list z w)) 5)
                (progv '(p q) '(1) (list (symbol-value 'p) (boundp 'q)))
                (multiple-value-call #'list (values 1 2) 3 (values) (values 4 5))
                (multiple-value-call #'+ (values 1 2))
                (multiple-value-list (multiple-value-prog1 (values 1 2) 3))
                (funcall 'list 1 2)
                (apply #'list 1 '(2 3))
                (list (load-time-value (list 1)))
                (macrolet ((twice (x) (list (quote progn) x x))) (let ((n 0)) (twice (incf n)) n))
                (symbol-macrolet ((s (car c))) (let ((c (list 1))) (setq s 5) c))
                (let ((x 1)) (setq x 2) (let ((f (lambda () x))) (setq x 3) (funcall f)))
                (the fixnum (+ 1 2))
                (flet (((setf thing) (v o) (list v o))) (setf (thing 1) 2))
                (loop for i from 1 to 5 when (oddp i) collect i into odd finally (return odd))))
       (let ((ours (ir-eval form *environment*)) (host (eval form)))
         (assert (equal ours host) () "IR evaluator: ~S gave ~S, host ~S" form ours host)))
     (dolist (form '((funcall (lambda (a) a)) (funcall (lambda (&key a) a) :b 1)
                     (funcall (lambda (&optional a) a) 1 2) (funcall (lambda (&key a) a) :a)))
       (assert (handler-case (progn (ir-eval form *environment*) nil) (program-error () t))
               () "IR evaluator: ~S did not signal a PROGRAM-ERROR" form)))))

(flet ((calls (form name)
         (remove-if-not (lambda (node) (and (= (ir-node-kind node) 7)
                                           (eq (ir-node-a node) name)))
                        (ir-test-nodes (ir-test-form form)))))
  (let ((call (first (calls '(let ((x (logand (unknown-input) 255))) (+ x 1)) '+))))
    (assert (equal (ir-node-type call) '(integer 1 256))))
  (let ((call (first (calls '(lambda (x) (if (typep x 'fixnum) (+ x 1) nil)) '+))))
    (assert (eq (ir-node-type (svref (ir-node-b call) 0)) 'fixnum))
    (assert (equal (ir-node-type call) '(integer -4611686018427387903 4611686018427387904))))
  (let ((call (first (calls '(lambda (x) (if (not (typep x 'fixnum)) nil (+ x 1))) '+))))
    (assert (eq (ir-node-type (svref (ir-node-b call) 0)) 'fixnum)))
  (let ((call (first (calls '(let ((x 1)) (funcall (lambda () (setq x "changed")))
                                   (integerp x)) 'integerp))))
    (assert (eq (ir-node-type (svref (ir-node-b call) 0)) :native-string)))
  (let ((call (first (calls '(let ((x 1))
                              (let ((writer (lambda () (setq x "changed"))))
                                (funcall writer) (integerp x))) 'integerp))))
    (assert (eq (ir-node-type (svref (ir-node-b call) 0)) t)))
  (let ((call (first (calls '(let ((x (unknown-input)))
                              (locally (declare (type fixnum x)) nil)
                              (+ x 1)) '+))))
    (assert (eq (ir-node-type (svref (ir-node-b call) 0)) t)))
  (let ((call (first (calls '(+ 4611686018427387903 1) '+))))
    (assert (equal (ir-node-type call) '(integer 4611686018427387904 4611686018427387904)))))

(dolist (value (list nil t 'sample 0 -1 4611686018427387904 -4611686018427387905
                     123456789012345678901234567890
                     1/3 1f0 1d0 #c(1 2) #\a "text" #(1 2) '(1 . 2)))
  (dolist (predicate '(integerp rationalp realp numberp floatp consp symbolp characterp
                      simple-vector-p stringp simple-string-p vectorp arrayp functionp null not listp))
    (multiple-value-bind (truth known) (ir-type-predicate predicate (ir-constant-type value))
      (when known
        (assert (eq truth (not (null (funcall predicate value)))))))))

(dolist (bounds '((-4611686018427387904 -4611686018427387903)
                  (-100 -1) (-5 7) (0 0) (0 255)
                  (4611686018427387902 4611686018427387903)))
  (dolist (other '((-3 5) (0 1) (100 255) (4611686018427387903 4611686018427387903)))
    (let ((a (ir-node 0 nil (first bounds))) (b (ir-node 0 nil (first other))))
      (setf (ir-node-type a) (ir-integer-range (first bounds) (second bounds))
            (ir-node-type b) (ir-integer-range (first other) (second other)))
      (dolist (op '(+ - * logand logior logxor))
        (let ((type (ir-call-type op (vector a b))))
          (dolist (x (list (first bounds) (floor (+ (first bounds) (second bounds)) 2)
                          (second bounds)))
            (dolist (y (list (first other) (second other)))
              (assert (if (eq type 'fixnum)
                          (<= +ir-fixnum-min+ (funcall op x y) +ir-fixnum-max+)
                          (typep (funcall op x y) type))))))))))

(flet ((last-call (form name)
         (car (last (remove-if-not
                     (lambda (node) (and (= (ir-node-kind node) 7) (eq (ir-node-a node) name)))
                     (ir-test-nodes (ir-test-form form)))))))
  (dolist (form '((let ((x nil)) (setq x 5) (+ x 1))
                  (let ((x 0)) (if (unknown-input) (setq x 2) (setq x 7)) (+ x 1))
                  (let ((x 0)) (let ((temporary nil)) (setq temporary 1 x 5)) (+ x 1))))
    (assert (ir-range-p (ir-node-type (last-call form '+)))))
  (dolist (form '((let ((x 1)) (if (unknown-input) (setq x "changed")) (integerp x))
                  (let ((x 1)) (block done (if (unknown-input) (return-from done))
                                             (setq x "changed")) (integerp x))
                  (let ((x 1)) (unwind-protect (setq x "changed") (integerp x)) (integerp x))))
    (let ((call (last-call form 'integerp)))
      (assert (eq (ir-node-type (svref (ir-node-b call) 0)) t)))))

(let* ((root (ir-test-form '(let ((x 1))
                             (tagbody start (integerp x) (setq x "changed")
                                      (if (unknown-input) (go start)))
                             (integerp x))))
       (calls (remove-if-not (lambda (node) (and (= (ir-node-kind node) 7)
                                                (eq (ir-node-a node) 'integerp)))
                             (ir-test-nodes root))))
  (assert (= (length calls) 2))
  (assert (eq (ir-node-type (svref (ir-node-b (first calls)) 0)) t))
  (assert (eq (ir-node-type (svref (ir-node-b (second calls)) 0)) :native-string)))

(let* ((outer (make-ir-var :name 'x)) (inner (make-ir-var :name 'x))
       (base (ir-env nil :vars (list (cons 'x outer))))
       (declared (ir-declare base '((type fixnum x))))
       (narrow (ir-declare declared '((type (unsigned-byte 8) x))))
       (shadow (ir-env declared :vars (list (cons 'x inner)))))
  (assert (eq (ir-var-type outer) t))
  (assert (eq (ir-declared-variable-type base outer) t))
  (assert (eq (ir-declared-variable-type declared outer) 'fixnum))
  (assert (equal (ir-declared-variable-type narrow outer) '(and (unsigned-byte 8) fixnum)))
  (assert (eq (trucler:type (trucler:describe-variable nil shadow 'x)) t))
  (assert (eq (trucler:type (trucler:describe-variable nil declared 'x)) 'fixnum)))

(let* ((root (ir-test-form '(lambda (x) (declare (type (unsigned-byte 8) x)) (+ x x))))
       (refs (remove-if-not (lambda (node) (and (= (ir-node-kind node) 1)
                                               (equal (ir-node-b node) '(unsigned-byte 8))))
                            (ir-test-nodes root))))
  (assert (= (length refs) 2))
  (assert (null (ir-node-c (first refs))))
  (assert (null (ir-node-c (second refs))))
  (dolist (ref refs) (assert (equal (ir-node-type ref) '(integer 0 255)))))

(dolist (form '((lambda (first &optional (second first)) (declare (fixnum first)) second)
                (let* ((first (unknown-input)) (second first)) (declare (fixnum first)) second)))
  (let ((refs (remove-if-not (lambda (node) (and (= (ir-node-kind node) 1)
                                               (eq (ir-var-name (ir-node-a node)) 'first)))
                             (ir-test-nodes (ir-test-form form)))))
    (assert refs)
    (dolist (ref refs) (assert (eq (ir-node-b ref) 'fixnum)))))

(let* ((root (ir-test-form '(lambda (value)
                             (declare (type (integer 0 200) value))
                             (locally (declare (type (integer 100 255) value)) (+ value value)))))
       (refs (remove-if-not (lambda (node) (= (ir-node-kind node) 1)) (ir-test-nodes root))))
  (assert (= (length refs) 2))
  (assert (equal (ir-node-type (first refs)) '(integer 100 200)))
  (assert (ir-node-c (first refs)))
  (assert (null (ir-node-c (second refs)))))

(let* ((root (ir-test-form '(let ((value (unknown-input)))
                             (declare (fixnum value))
                             (flet ((write-value (new) (setq value new)))
                               (unknown-call #'write-value) (+ value 1)))))
       (refs (remove-if-not (lambda (node) (and (= (ir-node-kind node) 1)
                                               (eq (ir-var-name (ir-node-a node)) 'value)))
                            (ir-test-nodes root))))
  (assert refs)
  (dolist (ref refs)
    (assert (eq (ir-var-type (ir-node-a ref)) 'fixnum))
    (assert (eq (ir-node-type ref) 'fixnum))
    (assert (null (ir-node-c ref)))))

(dolist (name '(< <= > >= = /=))
  (dolist (positive '(t nil))
    (loop for al from -2 to 2 do
      (loop for ah from al to 2 do
        (loop for bl from -2 to 2 do
          (loop for bh from bl to 2 do
            (let* ((av (make-ir-var :name 'a)) (bv (make-ir-var :name 'b))
                   (a (ir-node 1 nil av)) (b (ir-node 1 nil bv))
                   (at (ir-integer-range al ah)) (bt (ir-integer-range bl bh))
                   (environment (list (cons av at) (cons bv bt))))
              (setf (ir-node-type a) at (ir-node-type b) bt)
              (let* ((state (ir-refine-comparison (ir-node 7 nil name (vector a b)) environment positive))
                     (ar (cdr (assoc av state))) (br (cdr (assoc bv state))))
                (loop for x from al to ah do
                  (loop for y from bl to bh
                        when (eq (not (null (funcall name x y))) positive)
                          do (assert (<= (second ar) x (third ar)))
                             (assert (<= (second br) y (third br)))))))))))))

(dolist (form '((lambda (x y) (declare (fixnum x y)) (if (< x y) (1+ x) nil))
                (lambda (x y) (declare (fixnum x y)) (if (> x y) (1+ y) nil))
                (lambda (x y) (declare (fixnum x y)) (if (>= x y) nil (1+ x)))))
  (let ((call (find-if (lambda (node) (and (= (ir-node-kind node) 7) (eq (ir-node-a node) '1+)))
                       (ir-test-nodes (ir-test-form form)))))
    (assert (equal (ir-node-type call) `(integer ,(1+ +ir-fixnum-min+) ,+ir-fixnum-max+)))))

(let* ((root (ir-test-form '(lambda (limit)
                             (declare (fixnum limit))
                             (let ((counter 0))
                               (tagbody top
                                  (if (>= counter limit) (go done))
                                  (setq counter (1+ counter))
                                  (go top)
                                done)
                               counter))))
       (step (find-if (lambda (node) (and (= (ir-node-kind node) 7)
                                         (eq (ir-node-a node) '1+))) (ir-test-nodes root))))
  (assert (equal (ir-node-type step) `(integer 1 ,+ir-fixnum-max+))))

(let* ((root (ir-test-form '(let ((counter 0))
                             (tagbody top (setq counter (1+ counter))
                                      (if (unknown-input) (go top)))
                             counter)))
       (step (find-if (lambda (node) (and (= (ir-node-kind node) 7)
                                         (eq (ir-node-a node) '1+))) (ir-test-nodes root))))
  (assert (eq (ir-node-type step) 'integer)))

(let* ((root (ir-test-form '(let ((value (unknown-input)))
                             (tagbody top
                                (locally (declare (fixnum value)) (1+ value))
                                (setq value 1) (if (unknown-input) (go top)))
                             value)))
       (ref (find-if (lambda (node) (and (= (ir-node-kind node) 1)
                                        (eq (ir-node-b node) 'fixnum))) (ir-test-nodes root))))
  ;; A checked backedge cannot justify removing the unknown entry check.
  (assert (ir-node-c ref)))

(let* ((root (ir-test-form '(lambda (n)
                             (declare (fixnum n))
                             (let ((limit (- n 1)) (counter 0))
                               (tagbody top
                                  (if (>= counter limit) (go done))
                                  (setq counter (1+ counter))
                                  (go top)
                                done)
                               counter))))
       (step (find-if (lambda (node) (and (= (ir-node-kind node) 7)
                                         (eq (ir-node-a node) '1+))) (ir-test-nodes root))))
  (assert (equal (ir-node-type step) `(integer 1 ,(1- +ir-fixnum-max+)))))

(dolist (bounds '((-4611686018427387905 -4611686018427387904)
                  (-4611686018427387904 0) (0 4611686018427387903)
                  (4611686018427387903 4611686018427387904)))
  (let* ((var (make-ir-var)) (old (apply #'ir-integer-range bounds))
         (new (ir-integer-range (1- (first bounds)) (1+ (second bounds))))
         (state (ir-widen-type-environment (list (cons var old)) (list (cons var new))))
         (type (cdar state)))
    (dolist (value (list (1- (first bounds)) (first bounds) (second bounds) (1+ (second bounds))))
      (assert (typep value type)))))
(assert (not (ir-fixnum-type-p (ir-integer-range 4611686018427387903 4611686018427387904))))
(assert (not (ir-fixnum-type-p (ir-integer-range -4611686018427387905 -4611686018427387904))))

(flet ((local-fun (root name)
         (let ((result nil))
           (dolist (node (ir-test-nodes root))
             (when (= (ir-node-kind node) 13)
               (loop for fun across (ir-node-a node)
                     when (eq (ir-fun-name fun) name) do (setf result fun))))
           (or result (error "Missing local function ~S" name)))))
  (let* ((root (ir-test-form '(flet ((step-value (flag)
                                    (block done (if flag (return-from done 2) 3))))
                               (declare (notinline step-value))
                               (list (step-value t) (step-value nil)))))
         (fun (local-fun root 'step-value)))
    (assert (equal (ir-fun-result-type fun) '(integer 2 3))))
  (let* ((root (ir-test-form '(flet ((step-value (x) (+ x 1)))
                               (declare (notinline step-value))
                               (list (step-value 2) (step-value 4)))))
         (fun (local-fun root 'step-value)))
    (assert (equalp (ir-fun-input-types fun) #((integer 2 4))))
    (assert (equal (ir-fun-result-type fun) '(integer 3 5))))
  (let* ((root (ir-test-form '(flet ((step-value (x) (+ x 1)))
                               (unknown-save #'step-value)
                               (list (step-value 2) (step-value 4)))))
         (fun (local-fun root 'step-value)))
    (assert (null (ir-fun-input-types fun)))
    (assert (eq (ir-fun-result-type fun) t)))
  (let* ((root (ir-test-form '(labels ((make-value (x) (+ x 1))
                                     (consume-value (x) (declare (notinline make-value)) (make-value x)))
