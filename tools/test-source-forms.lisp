;;;; Run after tools/env.lisp and (ql:quickload "kiln").
(in-package #:kiln.compiler)

(let* ((symbol (make-symbol "private"))
       (cycle (list symbol))
       (array (make-array 2 :element-type '(unsigned-byte 8) :initial-contents '(17 23)))
       (graph (vector cycle cycle symbol symbol "λ中文" 123456789012345678901234567890 3/7 array)))
  (setf (cdr cycle) cycle)
  (let* ((restored (decode-source-form (encode-source-form graph)))
         (cell (svref restored 0)))
    (assert (eq cell (svref restored 1)))
    (assert (eq cell (cdr cell)))
    (assert (eq (car cell) (svref restored 2)))
    (assert (eq (svref restored 2) (svref restored 3)))
    (assert (null (symbol-package (svref restored 2))))
    (assert (equalp (subseq restored 4 7) (subseq graph 4 7)))
    (assert (eq array (svref restored 7)))))

(dolist (bits '(0 #x80000000 #x7f800000 #xff800000 #x7fc00123))
  (let* ((value (sb-kernel:make-single-float
                 (if (logbitp 31 bits) (- bits #x100000000) bits)))
         (restored (decode-source-form (encode-source-form value))))
    (assert (= bits (single-float-bits restored)))))

(dolist (bits '(0 #x80000000 #x7ff00000 #xfff00000 #x7ff80000))
  (let* ((value (sb-kernel:make-double-float
                 (if (logbitp 31 bits) (- bits #x100000000) bits) 291))
         (restored (decode-source-form (encode-source-form value))))
    (assert (= bits (double-float-high-bits restored)))
    (assert (= 291 (double-float-low-bits restored)))))

(assert (source-form-equal-p (list (make-symbol "same")) (list (make-symbol "same"))))
(let ((symbol (make-symbol "same")))
  (assert (not (source-form-equal-p (list symbol symbol)
                                   (list (make-symbol "same") (make-symbol "same"))))))
(assert (equalp (encode-source-form (list (make-symbol "OBJECT0")) t)
                (encode-source-form (list (make-symbol "OBJECT37")) t)))
(format t "Source graph codec passed.~%")

(let* ((*source-file* "definition-reference-model")
       (form '(defun reference-model (x) (reference-helper x)))
       (keys '((:macro reference-helper) (:compiler-macro reference-helper)
               (:function (setf reference-helper)) (:function reference-helper)))
       (calls '(reference-helper (setf reference-helper) reference-other))
       (saved-keys (copy-tree keys)) (saved-calls (copy-tree calls))
       (a (source-definition-record form keys calls nil nil))
       (b (source-definition-record form (reverse keys) (reverse calls) nil nil)))
  (assert (source-form-equal-p a b))
  (assert (equal (getf a :keys)
                 '((:compiler-macro reference-helper) (:function reference-helper)
                   (:function (setf reference-helper)) (:macro reference-helper))))
  (assert (= (length keys) (length (getf a :keys))))
  (assert (= (length calls) (length (getf a :calls))))
  (assert (every (lambda (key) (member key keys :test #'eq)) (getf a :keys)))
  (assert (equal keys saved-keys))
  (assert (equal calls saved-calls)))

(labels ((record (a-name b-name reverse-p)
           (let* ((*source-file* "definition-reference-model")
                  (a (make-symbol a-name)) (b (make-symbol b-name))
                  (literal (vector a b nil))
                  (form `(defun reference-model () ',literal))
                  (keys (list (list :macro a) (list :macro b)
                              (list :function (list 'setf a))))
                  (calls (list b a (list 'setf a))))
             (setf (svref literal 2) literal)
             (let ((record (source-definition-record form
                            (if reverse-p (reverse keys) keys)
                            (if reverse-p (reverse calls) calls) nil nil)))
               (assert (eq a (second (find :macro (getf record :keys) :key #'first))))
               (encode-source-form record t)))))
  (assert (equalp (record "PRIVATE9" "PRIVATE10" nil)
                  (record "PRIVATE999" "PRIVATE1000" t))))
(let* ((a (make-symbol "SAME")) (b (make-symbol "SAME"))
       (form (vector b a nil))
       (keys (list (list :macro a) (list :macro b))))
  (setf (svref form 2) form)
  (let ((ordered (canonical-definition-references form keys nil)))
    (assert (eq b (second (first ordered))))
    (assert (eq a (second (second ordered))))))
(format t "Definition references have stable order, preserve identities and leave query collectors intact.~%")
