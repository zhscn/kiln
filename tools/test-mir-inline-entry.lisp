;;;; Run after tools/test-mir-inline.lisp.
(in-package #:kiln.compiler)
(dolist (form
         '((lambda (x)
             (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
             (flet ((choose (a &optional (b (+ a 1) bp)) (values a b bp)))
               (list (multiple-value-list (choose x))
                     (multiple-value-list (choose x nil))
                     (multiple-value-list (choose x 9)))))
           (lambda (x)
             (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
             (flet ((collect (a &rest tail) (list a tail)))
               (list (collect x) (collect x 1 nil 2))))
           (lambda (x)
             (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
             (flet ((collect (&key (a 1) (b (+ a 1))) (list a b)))
               (list (collect) (collect :a x) (collect :b nil :a 2))))
           (lambda (x)
             (declare (ignore x) (optimize (speed 3) (debug 0) (compilation-speed 0)))
             (flet ((probe (&rest tail &key (a (progn (rplaca (cdr tail) :changed) 9)) (b nil bp))
                      (list a b bp tail)))
               (list (probe :b 3) (probe :a 1 :b 2))))))
  (let* ((*source-file* "mir-inline-entry") (*toplevel-source* nil)
         (forms (front-end-forms (list form)))
         (unit (mir-lift-local-functions (hir-to-mir (toplevel-form-ast (first forms)))))
         (before (mir-inline-test-call-count unit)))
    (mir-inline-local-functions unit :body-budget 8192 :growth-budget 65536)
    (verify-mir unit)
    (assert (> before (mir-inline-test-call-count unit)))
    (format t "MIR inline entry: ~D -> ~D calls.~%" before (mir-inline-test-call-count unit))))
(dolist (form
         '((lambda (x)
             (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
             (let ((n x))
               (flet ((probe (&optional (a (incf n) ap) &rest tail) (list a ap tail n)))
                 (list (probe) (probe nil 4 5)))))
           (lambda (x)
             (declare (ignore x) (optimize (speed 3) (debug 0) (compilation-speed 0)))
             (flet ((probe (&key a) (list a)))
               (list (probe :unknown 1 :allow-other-keys t) (probe :a 1 :a 2))))
           (lambda (x)
             (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
             (flet ((probe (a &optional b) (list a b))) (list (probe x) (probe x nil))))))
  (let* ((*source-file* "mir-inline-entry-boundaries") (*toplevel-source* nil)
         (forms (front-end-forms (list form)))
         (unit (mir-lift-local-functions (hir-to-mir (toplevel-form-ast (first forms)))))
         (before (mir-inline-test-call-count unit)))
    (mir-inline-local-functions unit :body-budget 8192 :growth-budget 65536)
    (verify-mir unit)
    (assert (> before (mir-inline-test-call-count unit)))
    (format t "MIR inline entry boundaries: ~D -> ~D calls.~%" before (mir-inline-test-call-count unit))))
(dolist (entry
         '((:unknown (lambda (x)
                       (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                       (flet ((probe (&key a) (list a))) (probe :a x) (probe :unknown 1))))
           (:odd (lambda (x)
                   (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                   (flet ((probe (&key a) (list a))) (probe :a x) (probe :a))))
           (:low (lambda (x)
                   (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                   (flet ((probe (a &optional b) (list a b))) (probe x) (probe))))
           (:high (lambda (x)
                    (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                    (flet ((probe (a &optional b) (list a b))) (probe x) (probe 1 2 3))))))
  (let* ((*source-file* "mir-inline-entry-errors") (*toplevel-source* nil)
         (forms (front-end-forms (list (second entry))))
         (unit (mir-lift-local-functions (hir-to-mir (toplevel-form-ast (first forms))))))
    (mir-inline-local-functions unit :body-budget 8192 :growth-budget 65536)
    (verify-mir unit)
    (assert (= (if (member (first entry) '(:low :high)) 1 0) (mir-inline-test-call-count unit)))
    (format t "MIR inline entry error graph: ~S.~%" (first entry))))

(let* ((form `(lambda (x)
                (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                (flet ((keep (&rest args) args))
                  (values (keep x) (keep x ,@(loop for i below 32 collect i))))))
       (*source-file* "mir-inline-entry-budget") (*toplevel-source* nil)
       (forms (front-end-forms (list form)))
       (unit (hir-to-mir (toplevel-form-ast (first forms)))))
  (assert (= 2 (mir-inline-test-call-count unit)))
  (mir-inline-local-functions unit)
  (verify-mir unit)
  (assert (= 1 (mir-inline-test-call-count unit))))
(format t "MIR rest construction participates in the inline growth budget.~%")
