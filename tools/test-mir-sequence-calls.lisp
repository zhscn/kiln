;;;; Run after tools/env.lisp and (ql:quickload "kiln").
;;;; Requires kernel.lir and clos.lir from tools/test.sh.
(in-package #:kiln.compiler)

(defun mir-sequence-test-unit (body &optional notinline)
  (let* ((*source-file* "mir-sequence-model") (*toplevel-source* nil)
         (forms (front-end-forms
                 (list `(lambda (x xs)
                          (declare (optimize (speed 3) (safety 3)) ,@(when notinline '((notinline member assoc))))
                          ,body)))))
    (hir-to-mir (toplevel-form-ast (first forms)))))

(dolist (entry '(((member x xs) kiln.kernel::%member-eql)
                 ((member x xs :test #'eq) kiln.kernel::%member-eq)
                 ((member x xs :test 'eql) kiln.kernel::%member-eql)
                 ((assoc x xs) kiln.kernel::%assoc-eql)
                 ((assoc x xs :test 'eq) kiln.kernel::%assoc-eq)
                 ((assoc x xs :test #'eql) kiln.kernel::%assoc-eql)
                 ((assoc x xs :key #'identity) assoc)
                 ((member x xs :test #'equal) member)
                 ((member x xs :test #'eq :test #'eql) member)
                 ((assoc x xs :test x) assoc)))
  (let ((unit (mir-sequence-test-unit (first entry))))
    (mir-specialize-direct-calls unit)
    (verify-mir unit)
    (assert (loop for function across (hir-vector (mir-unit-functions unit))
                  thereis (find (second entry) (hir-vector (mir-function-instructions function))
                                :key #'mir-instruction-data :test #'eq)))))
(let ((unit (mir-sequence-test-unit '(member x xs :test #'eq) t)))
  (mir-specialize-direct-calls unit)
  (verify-mir unit)
  (assert (loop for function across (hir-vector (mir-unit-functions unit))
                thereis (find 'member (hir-vector (mir-function-instructions function))
                              :key #'mir-instruction-data :test #'eq))))
(format t "MIR sequence searches specialize complete EQ/EQL contracts and retain generic keyword and NOTINLINE calls.~%")

(let* ((root (asdf:system-source-directory "kiln"))
       (output (merge-pathnames "build/mir-sequence-test/searches.lir" root))
       (session (make-session))
       (forms '((defvar *mir-search-events* nil)
                (defun mir-search-eq (item list)
                  (declare (optimize (speed 3) (safety 3)))
                  (member (progn (push :item *mir-search-events*) item)
                          (progn (push :list *mir-search-events*) list)
                          :test (progn (push :test *mir-search-events*) #'eq)))
                (let* ((item (list :item)) (tail (list item)) (list (cons :other tail)))
                  (print (eq (mir-search-eq item list) tail))
                  (print (equal *mir-search-events* '(:test :list :item))))
                (let* ((key (list :key)) (pair (cons key 7)))
                  (print (eq (assoc key (list nil (cons :other 0) pair) :test 'eq) pair)))
                (let* ((number (+ (expt 2 70) 1))
                       (other (+ (expt 2 70) 1)) (tail (list other)) (pair (cons other 9)))
                  (print (eq (member number tail) tail))
                  (print (eq (assoc number (list pair) :test #'eql) pair)))
                (print (equal (member (copy-seq "abc") '("abc" "def") :test #'equal)
                              '("abc" "def")))
                (print (equal (assoc :key '(((:key) . 1) ((:other) . 2)) :key #'car)
                              '((:key) . 1))))))
  (ensure-directories-exist output)
  (kiln::write-module (compile-module (front-end-forms forms session) "mir-sequence-calls"
                                     :session session :pipeline :mir) output)
  (let ((text (uiop:run-program
               (mapcar #'namestring
                       (list (merge-pathnames "target/debug/kiln-cg" root) #P"jit"
                             (merge-pathnames "build/test/kernel.lir" root)
                             (merge-pathnames "build/test/clos.lir" root) output))
               :output :string :error-output :string)))
    (assert (equal text (format nil "T~%T~%T~%T~%T~%T~%T~%"))
            () "Unexpected MIR sequence search output: ~S" text)))
(format t "MIR searches preserve tail and pair identity, numeric EQL, argument effects and generic tests.~%")
