;;;; Run after tools/env.lisp and (ql:quickload "kiln").
(in-package #:kiln.compiler)

(defun mir-capture-test-unit (body)
  (let* ((*source-file* "mir-function-capture-model") (*toplevel-source* nil)
         (forms (front-end-forms (list `(lambda (n) (declare (optimize (debug 0))) ,body))))
         (*toplevel* (first forms)))
    (hir-to-mir (toplevel-form-ast *toplevel*))))

(defun mir-capture-test-function (unit name)
  (or (find name (hir-vector (mir-unit-functions unit)) :key #'mir-function-name)
      (error "Missing capture test function ~S" name)))

;; Exported captured functions retain their environments while private wrappers lift.
(dolist (body
         '((flet ((g (x) (+ n x)))
             (flet ((f (x) (g x))) (declare (notinline f)) (values (f 1) #'g)))
           (let ((delta 7))
             (flet ((g (x) (+ n x)))
               (flet ((f (x) (+ delta (g x)))) (declare (notinline f)) (values (f 1) #'g))))
           (let ((count 0))
             (flet ((g (x) (+ n x)))
               (flet ((f (x) (incf count) (+ count (g x))))
                 (declare (notinline f)) (f 1) (f 2) (values count #'g))))
           (flet ((g (x) (+ n x)))
             (flet ((f (x &optional (y (g x) yp) &rest tail) (list y yp tail)))
               (declare (notinline f)) (f 1) (values (f 1 7 :a :b) #'g)))
           (flet ((g (x) (+ n x)))
             (flet ((f (&key (x (g 1) xp)) (list x xp)))
               (declare (notinline f)) (f) (values (f :x 7) #'g)))))
  (let* ((unit (mir-capture-test-unit body))
         (f (mir-capture-test-function unit 'f)) (g (mir-capture-test-function unit 'g))
         (width (length (mir-function-captures f)))
         (cells (mir-function-capture-cells f))
         (slot (position (mir-function-id g) (mir-function-capture-functions f)))
         (g-captures (copy-seq (mir-function-captures g))))
    (assert slot)
    (mir-lift-local-functions unit)
    (verify-mir unit)
    (assert (= width (mir-function-internal-prefix f)))
    (assert (= cells (mir-function-argument-cells f)))
    (assert (zerop (length (mir-function-captures f))))
    (assert (zerop (mir-function-internal-prefix g)))
    (assert (equalp g-captures (mir-function-captures g)))
    (let ((flow (mir-infer-function-flow unit)))
      (assert (eql (mir-function-id g)
                   (svref (svref (mir-function-flow-inputs flow) (mir-function-id f)) slot))))
    (mir-lift-local-functions unit)
    (assert (= width (mir-function-internal-prefix f)))))

(dolist (body
         '((flet ((g (x) (+ n x)))
             (flet ((f (x) (g x))) (f 1) #'f))
           (flet ((g (x) (+ n x)))
             (flet ((f (x) (g x))) (eq #'f #'f) (f 1)))
           (flet ((g (x) (+ n x)))
             (flet ((f (x) (declare (optimize (debug 3))) (g x))) (f 1)))
           (flet ((g (x) (+ n x))) (flet ((f (x) (g x))) (f)))
           (flet ((g (x) (+ n x)))
             (flet ((f (x) (g x))) (multiple-value-call #'f (mir-unknown n))))
           (labels ((f (x) (if (zerop x) n (f (1- x))))) (f 3) #'f)))
  (let* ((unit (mir-capture-test-unit body)) (f (mir-capture-test-function unit 'f))
         (captures (copy-seq (mir-function-captures f))))
    (assert (plusp (length captures)))
    (mir-lift-local-functions unit)
    (verify-mir unit)
    (assert (zerop (mir-function-internal-prefix f)))
    (assert (equalp captures (mir-function-captures f)))))
(format t "MIR function capture prefixes preserve public environments, shared cells, entry protocols and observation boundaries.~%")

(let* ((session (make-session))
       (module (compile-module (front-end-forms '(nil) session) "capture-layout" :session session :pipeline :mir))
       (kiln.kir::*module* module))
  (kiln.kir::with-function ("unused-captured-entry")
    (let ((self (kiln.kir::new-var)))
      (kiln.kir::emit `(:set ,self :self))
      (kiln.kir::emit `(:return (:closure-ref ,self 0) 1))))
  (setf (gethash "unused-captured-entry" (kiln.kir::kmodule-function-captures module)) 2)
  (let* ((program (kiln.kir::normalize-lir-module module))
         (entry (find "unused-captured-entry" (cddr program) :key #'second :test #'equal)))
    (assert (equal '(:captures 2) (assoc :captures (cddr entry)))))
  (kiln.kir::module-data "unused-captured-object" '(:static-function "unused-captured-entry"))
  (assert (handler-case (progn (kiln.kir::normalize-lir-module module) nil) (error () t)))
  (setf (gethash "unused-captured-entry" (kiln.kir::kmodule-function-captures module)) 0)
  (assert (handler-case (progn (kiln.kir::normalize-lir-module module) nil) (error () t))))
(format t "MIR capture declarations preserve entries without allocation sites and validate capture reads.~%")

;; Sharing code must preserve the actual captured function on each incoming edge.
(let* ((unit (mir-capture-test-unit
              '(let ((a 10) (b 20))
                 (flet ((left (x) (+ a x)) (right (x) (+ b x)))
                   (flet ((pick-left (x) (left x)) (pick-right (x) (right x)))
                     (values (funcall (if n #'pick-left #'pick-right) 1) #'left #'right))))))
       (owner (mir-at (mir-unit-functions unit) 1))
       (left (mir-capture-test-function unit 'left))
       (right (mir-capture-test-function unit 'right))
       (pick-left (mir-capture-test-function unit 'pick-left))
       (pick-right (mir-capture-test-function unit 'pick-right))
       (original (map 'simple-vector (lambda (block) (length (mir-block-parameters block)))
                      (hir-vector (mir-function-blocks owner)))))
  (mir-run-pass unit owner
    (lambda (function)
      (loop for instruction across (hir-vector (mir-function-instructions function))
            for kind = (mir-instruction-kind instruction)
            for data = (mir-instruction-data instruction)
            for target = (case kind (23 data) (24 (car data)))
            for replacement = (cond ((eql target (mir-function-id right)) (mir-function-id left))
                                    ((eql target (mir-function-id pick-right)) (mir-function-id pick-left)))
            when replacement do
              (setf (mir-instruction-data instruction)
                    (if (= kind 23) replacement (cons replacement (cdr data)))))))
  (mir-lift-local-functions unit)
  (verify-mir unit)
  (assert (= 1 (mir-function-internal-prefix pick-left)))
  (assert (zerop (mir-function-internal-prefix left)))
  (assert
   (loop for block across (hir-vector (mir-function-blocks owner))
         thereis (loop for index from (svref original (mir-block-id block))
                       below (length (mir-block-parameters block))
                       thereis (> (length (remove-duplicates
                                           (loop for predecessor across (hir-vector (mir-function-blocks owner))
                                                 append (loop for edge across (mir-terminator-edges (mir-block-terminator predecessor))
                                                              when (= (mir-edge-target edge) (mir-block-id block))
                                                                collect (svref (mir-edge-arguments edge) index))))) 1)))))
(format t "MIR shared-code function captures retain distinct edge environments.~%")

;; A capture read proves the identity needed to initialize another closure.
;; Turning the read into an ordinary argument would lose that proof.
(let* ((unit (mir-capture-test-unit
              '(flet ((g (x) (+ n x)))
                 (flet ((f () (lambda () (g 1))))
                   (declare (notinline f))
                   (values (f) #'g)))))
       (f (mir-capture-test-function unit 'f)))
  (mir-lift-direct-environments unit)
  (verify-mir unit)
  (assert (zerop (mir-function-internal-prefix f))))
