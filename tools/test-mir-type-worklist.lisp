;;;; Run after tools/env.lisp and (ql:quickload "kiln").
(in-package #:kiln.compiler)

(defun mir-type-comparison-test-unit ()
  (let* ((unit (make-mir-unit))
         (function (make-mir-function :name 'comparison-flow :required 1))
         (blocks (mir-function-blocks function)))
    (hir-push function (mir-unit-functions unit))
    (dotimes (id 5) (hir-push (make-mir-block :id id) blocks))
    (labels ((emit (block kind representation args data)
               (let* ((id (hir-buffer-count (mir-function-instructions function)))
                      (result (and representation
                                   (mir-add-value function representation (mir-block-id block)
                                                  (hir-buffer-count (mir-block-instructions block))))))
                 (hir-push (make-mir-instruction :id id :kind kind :result result :operands args :data data
                                                :effects (svref *mir-instruction-effects* kind))
                           (mir-function-instructions function))
                 (hir-push id (mir-block-instructions block)) result))
             (parameter (block)
               (mir-add-value function :obj block -1))
             (jump (block target args)
               (setf (mir-block-terminator (mir-at blocks block))
                     (make-mir-terminator :kind 0 :edges (vector (make-mir-edge :target target :arguments args))))))
      (let* ((entry (mir-at blocks 0)) (head (mir-at blocks 1))
             (out (mir-at blocks 3)) (body (mir-at blocks 4))
             (count (emit entry 12 :count #() nil))
             (check (emit entry 13 nil (vector count) '(1 . 1)))
             (argument (emit entry 1 :obj #() 0))
             (n (emit entry 11 :obj (vector argument)
                      (make-hir-type-declaration '(integer 0 100) '(integer 0 100))))
             (zero (emit entry 0 :obj #() 0))
             (head-n (parameter 1)) (head-i (parameter 1))
             (out-n (parameter 3)) (body-n (parameter 4)))
        (declare (ignore check))
        (setf (mir-block-parameters head) (vector head-n head-i)
              (mir-block-parameters out) (vector out-n)
              (mir-block-parameters body) (vector body-n))
        (jump 0 1 (vector n zero))
        ;; A comparison can dominate a branch in another block. Widening its
        ;; inputs must revisit that branch even if its Boolean type is unchanged.
        (let* ((comparison (emit head 6 :bundle (vector head-i head-n) '<))
               (condition (emit head 10 :obj (vector comparison) nil)))
          (jump 1 2 #())
          (setf (mir-block-terminator (mir-at blocks 2))
                (make-mir-terminator :kind 1 :operands (vector condition)
                                     :edges (vector (make-mir-edge :target 3 :arguments (vector head-n))
                                                    (make-mir-edge :target 4 :arguments (vector head-n))))))
        (let ((bundle (emit out 9 :bundle (vector out-n) nil)))
          (setf (mir-block-terminator out) (make-mir-terminator :kind 2 :operands (vector bundle))))
        (let* ((one (emit body 0 :obj #() 1))
               (difference (emit body 6 :bundle (vector body-n one) '-))
               (next (emit body 10 :obj (vector difference) nil)))
          (jump 4 1 (vector body-n next)))
        (values unit out-n)))))

(multiple-value-bind (unit result) (mir-type-comparison-test-unit)
  (verify-mir unit)
  (let ((types (mir-infer-types (mir-at (mir-unit-functions unit) 0))))
    (assert (equal (svref types result) '(integer 0 100)))))
(multiple-value-bind (unit result) (mir-type-comparison-test-unit)
  (let* ((function (mir-at (mir-unit-functions unit) 0))
         (comparison (find-if (lambda (instruction)
                                (and (= (mir-instruction-kind instruction) 6)
                                     (eq (mir-instruction-data instruction) '<)))
                              (hir-vector (mir-function-instructions function))))
         (operands (copy-seq (mir-instruction-operands comparison))))
    (mir-run-pass unit function
      (lambda (function)
        (setf (mir-instruction-data comparison) 'integerp
              (mir-instruction-operands comparison) (vector (svref operands 1)))
        function))
    (assert (equal (svref (mir-infer-types function) result) '(integer 0 100)))
    ;; Adding a comparison operand also changes which blocks consume its type.
    (mir-run-pass unit function
      (lambda (function)
        (setf (mir-instruction-data comparison) '<
              (mir-instruction-operands comparison) operands)
        function))
    (assert (equal (svref (mir-infer-types function) result) '(integer 0 100)))))
(dolist (order '(#(0 4 3 2 1) #(0 2 4 1 3)))
  (multiple-value-bind (unit result) (mir-type-comparison-test-unit)
    (let ((function (mir-at (mir-unit-functions unit) 0)))
      (mir-run-pass unit function
        (lambda (function)
          (let* ((old (copy-seq (hir-vector (mir-function-blocks function))))
                 (numbers (make-array (length old))) (blocks (make-hir-buffer)))
            (loop for id across order for new from 0 do (setf (svref numbers id) new))
            (loop for value across (hir-vector (mir-function-values function)) do
              (setf (mir-value-block value) (svref numbers (mir-value-block value))))
            (loop for block across old do
              (loop for edge across (mir-terminator-edges (mir-block-terminator block)) do
                (setf (mir-edge-target edge) (svref numbers (mir-edge-target edge)))))
            (loop for id across order for new from 0 for block = (svref old id) do
              (setf (mir-block-id block) new) (hir-push block blocks))
            (setf (mir-function-blocks function) blocks))
          function))
      (assert (equal (svref (mir-infer-types function) result) '(integer 0 100))))))
(format t "MIR comparison-edge refinements follow widening inputs across blocks.~%")

;; A local fixed point in one body must not re-run unrelated type solvers.
(let* ((forms (front-end-forms '((list (lambda () 1) (lambda () 2) (lambda () 3)))))
       (unit (hir-to-mir (toplevel-form-ast (first forms))))
       (original (symbol-function 'mir-compute-types))
       (counts (make-hash-table :test 'eq)))
  (unwind-protect
       (progn
         (setf (symbol-function 'mir-compute-types)
               (lambda (function &rest arguments)
                 (incf (gethash function counts 0))
                 (apply original function arguments)))
         (mir-infer-calls unit)
         (assert (= (hash-table-count counts) (hir-buffer-count (mir-unit-functions unit))))
         ;; One solve and one finalization, with no unrelated round trips.
         (maphash (lambda (function count) (declare (ignore function)) (assert (= count 2))) counts))
    (setf (symbol-function 'mir-compute-types) original)))
