;;;; Run after tools/env.lisp and (ql:quickload "kiln").
(in-package #:kiln.compiler)
(let* ((session (make-session))
       (module (compile-module (front-end-forms '((lambda () 123456789 (identity t))) session)
                               "dead-loads" :session session)))
  (labels ((contains (form)
             (and (consp form)
                  (or (equal form '(:fixnum-tag 123456789))
                      (contains (car form)) (contains (cdr form))))))
    (assert (not (contains (kiln.kir::kmodule-funcs module))))))
;; A discarded operation can still signal a type error and must execute.
(let* ((session (make-session))
       (module (compile-module (front-end-forms '((lambda () (car 123456789) (identity t))) session)
                               "retained-effects" :session session)))
  (labels ((contains (form)
             (and (consp form)
                  (or (equal form '(:fixnum-tag 123456789))
                      (contains (car form)) (contains (cdr form))))))
    (assert (contains (kiln.kir::kmodule-funcs module)))))
(format t "Unused pure loads disappear while discarded potentially failing operations remain.~%")
