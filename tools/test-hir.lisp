;;;; Run with SBCL after tools/env.lisp and (ql:quickload "kiln").
(in-package #:kiln.compiler)

(defun hir-test-form (form)
  (let ((*source-file* "hir-test") (*toplevel-source* nil))
    (let ((forms (front-end-forms (list form))))
      (assert (= (length forms) 1))
      (toplevel-form-ast (first forms)))))

(defun hir-test-nodes (fun)
  (let ((result '()))
    (labels ((visit-function (fun) (hir-map-function #'visit fun))
             (visit (node)
               (push node result)
               (case (hir-node-kind node)
                 (13 (loop for child across (hir-node-a node) do (visit-function child))
                     (visit (hir-node-b node)))
                 ((6 7)
                  (let ((child (hir-own-function node))) (when child (visit-function child)))
                  (when (= (hir-node-kind node) 7)
                    (when (hir-node-p (hir-node-a node)) (visit (hir-node-a node)))
                    (loop for arg across (hir-node-b node) do (visit arg))))
                 (24 (visit-function (hir-node-a node)))
                 (otherwise (hir-map-children #'visit node)))))
      (visit-function fun))
    (nreverse result)))

(let* ((root (hir-test-form '(let ((x 1)) (list (lambda () x) (lambda (v) (setq x v))))))
       (var (svref (hir-node-a (hir-fun-body root)) 0))
       (functions (mapcar #'hir-node-a (remove-if-not (lambda (n) (= (hir-node-kind n) 6))
                                                    (hir-test-nodes root)))))
  (assert (= (logand (hir-var-flags var) 7) 7))
  (assert (= (length functions) 2))
  (dolist (fun functions) (assert (find var (hir-fun-free fun)))))

(let* ((root (hir-test-form '(let ((x 1)) (lambda () (lambda () x)))))
       (outer (hir-node-a (hir-node-c (hir-fun-body root))))
       (inner (hir-node-a (hir-fun-body outer))))
  (assert (= (length (hir-fun-free outer)) 1))
  (assert (eq (svref (hir-fun-free outer) 0) (svref (hir-fun-free inner) 0))))

(let* ((root (hir-test-form '(block done (lambda () (return-from done 1)))))
       (exit (hir-node-a (hir-fun-body root)))
       (child (hir-node-a (hir-node-b (hir-fun-body root)))))
  (assert (logtest 1 (hir-exit-flags exit)))
  (assert (find (hir-exit-token exit) (hir-fun-free child))))

(let ((nodes (hir-test-nodes (hir-test-form '(flet ((inc (x) (+ x 1))) (inc 2))))))
  (assert (notany (lambda (n) (and (= (hir-node-kind n) 7) (hir-fun-p (hir-node-a n)))) nodes))
  (assert (some (lambda (n) (= (hir-node-kind n) 11)) nodes)))

(let* ((root (hir-test-form '(let ((x 1)) (declare (ignorable x) (type fixnum x)) x)))
       (var (svref (hir-node-a (hir-fun-body root)) 0)))
  (assert (some (lambda (node) (and (= (hir-node-kind node) 1)
                                    (eq (hir-node-a node) var) (eq (hir-node-b node) 'fixnum)))
                (hir-test-nodes root)))
  (assert (logtest 8 (hir-var-flags var))))

(dolist (form '((declare (ignore x)) (if 1) (setq x) (let ((x 1) (x 2)) x)
                (function (setf x y)) (return-from missing) (go nowhere)
                (lambda (&rest)) (lambda (x x) x) (lambda (&optional &optional) nil)
                (lambda (x &aux x) x) (load-time-value 1 :invalid)
                (symbol-macrolet ((x 1)) (declare (special x)) x)))
  (assert (handler-case (progn (hir-test-form form) nil) (kiln-compile-error () t))
          () "Accepted invalid form ~S" form))

(let ((location (hir-source-position 4095 123 33554431)))
  (assert (typep location 'fixnum))
  (assert (= (hir-source-file-id location) 4095))
  (assert (equal (hir-source-range location) '(123 . 33554431))))

(let* ((root (hir-test-form '(flet ((and (x y) (+ x y))) (and 1 2))))
       (nodes (hir-test-nodes root)))
  (assert (some (lambda (node) (and (= (hir-node-kind node) 7) (eq (hir-node-a node) '+))) nodes)))

(let ((nodes (hir-test-nodes (hir-test-form '(let ((x 1)) (lambda () (setq x 2))))))
      (seen (make-hash-table :test 'eq)))
  (dolist (node nodes)
    (assert (not (gethash node seen)))
    (setf (gethash node seen) t)
    (assert (or (null (hir-node-source node)) (typep (hir-node-source node) 'fixnum)))))

(let* ((root (hir-test-form '(let ((x 1))
                              (flet ((capture (y) (lambda () (+ x y)))) (capture 2)))))
       (nodes (hir-test-nodes root))
       (closure (hir-node-a (find 6 nodes :key #'hir-node-kind))))
  (assert (eq (hir-fun-parent closure) root))
  (assert (= (length (hir-fun-free closure)) 2))
  (loop for var across (hir-fun-free closure) do (assert (eq (hir-var-owner var) root))))

(let ((nodes (hir-test-nodes
              (hir-test-form '(flet ((outer (x) (flet ((inner (y) (+ x y))) (inner 2)))) (outer 3))))))
  (assert (notany (lambda (node) (member (hir-node-kind node) '(6 13)))
                  (remove-if (lambda (node) (and (= (hir-node-kind node) 13)
                                                (zerop (length (hir-node-a node))))) nodes))))

(let ((root (hir-test-form '(labels ((producer () (load-time-value (list 1)))
                                   (caller () (producer)))
                            (caller)))))
  (assert (= (hir-buffer-count (hir-fun-load-time-values root)) 1)))

(assert (hir-fun-p (hir-test-form '(flet (((setf place) (value object)
                                          (declare (ignore object))
                                          (return-from place value)))
                                  (funcall #'(setf place) 1 nil)))))

(let ((nodes (hir-test-nodes
              (hir-test-form '(macrolet ((value () 4))
                               (let ((x 1))
                                 (macrolet ((probe (&environment env) (macroexpand '(value) env)))
                                   (probe))))))))
  (assert (some (lambda (node) (and (= (hir-node-kind node) 0) (eql (hir-node-a node) 4))) nodes)))


;;; The HIR evaluator (lisp/hir/eval.lisp) against the host's EVAL.
(let ((session (make-session)))
  (call-with-front-end
   session
   (lambda ()
     (dolist (form
              '((let ((x 1)) (+ x 2))
                (multiple-value-list (values 1 2 3))
                (funcall (lambda (a &optional (b 10) &key (c (+ a b)) d) (list a b c d)) 1 2 :d 4)
                (funcall (lambda (a &optional (b 10 b-p) &rest r &key c &allow-other-keys)
                           (list a b b-p r c))
                         1 2 :z 3 :c 4 :c 5)
                (funcall (lambda (&key ((:x y) 7 y-p)) (list y y-p)))
                (funcall (lambda (&key a) a) :a 1 :allow-other-keys t :b 2)
                (let ((fns '()))
                  (dotimes (i 3) (let ((j i)) (push (lambda () j) fns)))
                  (mapcar #'funcall fns))
                (let ((fns '()))
                  (dolist (i '(1 2 3)) (let ((j i)) (push (lambda () (incf j 10)) fns)))
                  (list (mapcar #'funcall fns) (mapcar #'funcall fns)))
                (let ((x 0)) (flet ((inc () (incf x))) (inc) (inc) (list x (inc))))
                (labels ((ev (n) (if (zerop n) t (od (1- n)))) (od (n) (if (zerop n) nil (ev (1- n)))))
                  (list (ev 10) (ev 7) (mapcar #'ev '(1 2))))
                (block b (mapc (lambda (x) (when (> x 2) (return-from b x))) '(1 2 3 4)) :none)
                (block b (let ((y 1)) (if y (return-from b (values 1 2)) 3)))
                (multiple-value-list (block b (dolist (x '(1 2 3)) (when (= x 2) (return (values x :two)))) 9))
                (let ((n 0) (acc '())) (tagbody top (push n acc) (incf n) (when (< n 5) (go top))) acc)
                (let ((acc '()))
                  (tagbody (funcall (lambda () (push 1 acc) (go out))) (push 2 acc) out (push 3 acc))
                  acc)
                (let ((acc '()) (k 0))
                  (tagbody a (push (list 'a k) acc)
                           (setq k (+ k (if (< k 3) (progn (push k acc) (incf k) (go a)) 100)))
                           (push k acc))
                  acc)
                (catch 'tag (list 1 (throw 'tag (values 2 3))))
                (multiple-value-list (catch 'tag (throw 'tag (values 2 3))))
                (let ((log '()))
                  (list (catch 'x (unwind-protect (throw 'x 1) (push :cleanup log))) log))
                (let ((log '()))
                  (block b (unwind-protect (return-from b 1) (push :c log))) log)
                (let ((sv 10)) (declare (special sv)) sv)
                (let ((x 1)) (declare (special x))
                  (flet ((getx () (symbol-value 'x)))
                    (list (getx) (let ((x 2)) (declare (special x)) (getx)) (getx))))
                (let ((y 1)) (declare (special y))
                  (list (catch 'z (let ((y 2)) (declare (special y)) (throw 'z (symbol-value 'y))))
                        (symbol-value 'y)))
                (funcall (lambda (z &optional (w (symbol-value 'z))) (declare (special z)) (list z w)) 5)
                (progv '(p q) '(1) (list (symbol-value 'p) (boundp 'q)))
                (multiple-value-call #'list (values 1 2) 3 (values) (values 4 5))
                (multiple-value-call #'+ (values 1 2))
                (multiple-value-list (multiple-value-prog1 (values 1 2) 3))
                (funcall 'list 1 2)
                (apply #'list 1 '(2 3))
                (list (load-time-value (list 1)))
                (macrolet ((twice (x) (list (quote progn) x x))) (let ((n 0)) (twice (incf n)) n))
                (symbol-macrolet ((s (car c))) (let ((c (list 1))) (setq s 5) c))
                (let ((x 1)) (setq x 2) (let ((f (lambda () x))) (setq x 3) (funcall f)))
                (the fixnum (+ 1 2))
                (flet (((setf thing) (v o) (list v o))) (setf (thing 1) 2))
                (loop for i from 1 to 5 when (oddp i) collect i into odd finally (return odd))))
       (let ((ours (hir-eval form *environment*)) (host (eval form)))
         (assert (equal ours host) () "HIR evaluator: ~S gave ~S, host ~S" form ours host)))
     (dolist (form '((funcall (lambda (a) a)) (funcall (lambda (&key a) a) :b 1)
                     (funcall (lambda (&optional a) a) 1 2) (funcall (lambda (&key a) a) :a)))
       (assert (handler-case (progn (hir-eval form *environment*) nil) (program-error () t))
               () "HIR evaluator: ~S did not signal a PROGRAM-ERROR" form)))))

(flet ((calls (form name)
         (remove-if-not (lambda (node) (and (= (hir-node-kind node) 7)
                                           (eq (hir-node-a node) name)))
                        (hir-test-nodes (hir-test-form form)))))
  (let ((call (first (calls '(let ((x (logand (unknown-input) 255))) (+ x 1)) '+))))
    (assert (equal (hir-node-type call) '(integer 1 256))))
  (let ((call (first (calls '(lambda (x) (if (typep x 'fixnum) (+ x 1) nil)) '+))))
    (assert (eq (hir-node-type (svref (hir-node-b call) 0)) 'fixnum))
    (assert (equal (hir-node-type call) '(integer -4611686018427387903 4611686018427387904))))
  (let ((call (first (calls '(lambda (x) (if (not (typep x 'fixnum)) nil (+ x 1))) '+))))
    (assert (eq (hir-node-type (svref (hir-node-b call) 0)) 'fixnum)))
  (let ((call (first (calls '(let ((x 1)) (funcall (lambda () (setq x "changed")))
                                   (integerp x)) 'integerp))))
    (assert (eq (hir-node-type (svref (hir-node-b call) 0)) :native-string)))
  (let ((call (first (calls '(let ((x 1))
                              (let ((writer (lambda () (setq x "changed"))))
                                (funcall writer) (integerp x))) 'integerp))))
    (assert (eq (hir-node-type (svref (hir-node-b call) 0)) t)))
  (let ((call (first (calls '(let ((x (unknown-input)))
                              (locally (declare (type fixnum x)) nil)
                              (+ x 1)) '+))))
    (assert (eq (hir-node-type (svref (hir-node-b call) 0)) t)))
  (let ((call (first (calls '(+ 4611686018427387903 1) '+))))
    (assert (equal (hir-node-type call) '(integer 4611686018427387904 4611686018427387904)))))

(dolist (value (list nil t 'sample 0 -1 4611686018427387904 -4611686018427387905
                     123456789012345678901234567890
                     1/3 1f0 1d0 #c(1 2) #\a "text" #(1 2) '(1 . 2)))
  (dolist (predicate '(integerp rationalp realp numberp floatp consp symbolp characterp
                      simple-vector-p stringp simple-string-p vectorp arrayp functionp null not listp))
    (multiple-value-bind (truth known) (hir-type-predicate predicate (hir-constant-type value))
      (when known
        (assert (eq truth (not (null (funcall predicate value)))))))))

(dolist (bounds '((-4611686018427387904 -4611686018427387903)
                  (-100 -1) (-5 7) (0 0) (0 255)
                  (4611686018427387902 4611686018427387903)))
  (dolist (other '((-3 5) (0 1) (100 255) (4611686018427387903 4611686018427387903)))
    (let ((a (hir-node 0 nil (first bounds))) (b (hir-node 0 nil (first other))))
      (setf (hir-node-type a) (hir-integer-range (first bounds) (second bounds))
            (hir-node-type b) (hir-integer-range (first other) (second other)))
      (dolist (op '(+ - * logand logior logxor))
        (let ((type (hir-call-type op (vector a b))))
          (dolist (x (list (first bounds) (floor (+ (first bounds) (second bounds)) 2)
                          (second bounds)))
            (dolist (y (list (first other) (second other)))
              (assert (if (eq type 'fixnum)
                          (<= +hir-fixnum-min+ (funcall op x y) +hir-fixnum-max+)
                          (typep (funcall op x y) type))))))))))

(flet ((last-call (form name)
         (car (last (remove-if-not
                     (lambda (node) (and (= (hir-node-kind node) 7) (eq (hir-node-a node) name)))
                     (hir-test-nodes (hir-test-form form)))))))
  (dolist (form '((let ((x nil)) (setq x 5) (+ x 1))
                  (let ((x 0)) (if (unknown-input) (setq x 2) (setq x 7)) (+ x 1))
                  (let ((x 0)) (let ((temporary nil)) (setq temporary 1 x 5)) (+ x 1))))
    (assert (hir-range-p (hir-node-type (last-call form '+)))))
  (dolist (form '((let ((x 1)) (if (unknown-input) (setq x "changed")) (integerp x))
                  (let ((x 1)) (block done (if (unknown-input) (return-from done))
                                             (setq x "changed")) (integerp x))
                  (let ((x 1)) (unwind-protect (setq x "changed") (integerp x)) (integerp x))))
    (let ((call (last-call form 'integerp)))
      (assert (eq (hir-node-type (svref (hir-node-b call) 0)) t)))))

(let* ((root (hir-test-form '(let ((x 1))
                             (tagbody start (integerp x) (setq x "changed")
                                      (if (unknown-input) (go start)))
                             (integerp x))))
       (calls (remove-if-not (lambda (node) (and (= (hir-node-kind node) 7)
                                                (eq (hir-node-a node) 'integerp)))
                             (hir-test-nodes root))))
  (assert (= (length calls) 2))
  (assert (eq (hir-node-type (svref (hir-node-b (first calls)) 0)) t))
  (assert (eq (hir-node-type (svref (hir-node-b (second calls)) 0)) :native-string)))

(let* ((outer (make-hir-var :name 'x)) (inner (make-hir-var :name 'x))
       (base (hir-env nil :vars (list (cons 'x outer))))
       (declared (hir-declare base '((type fixnum x))))
       (narrow (hir-declare declared '((type (unsigned-byte 8) x))))
       (shadow (hir-env declared :vars (list (cons 'x inner)))))
  (assert (eq (hir-var-type outer) t))
  (assert (eq (hir-declared-variable-type base outer) t))
  (assert (eq (hir-declared-variable-type declared outer) 'fixnum))
  (assert (equal (hir-declared-variable-type narrow outer) '(and (unsigned-byte 8) fixnum)))
  (assert (eq (trucler:type (trucler:describe-variable nil shadow 'x)) t))
  (assert (eq (trucler:type (trucler:describe-variable nil declared 'x)) 'fixnum)))

(let* ((root (hir-test-form '(lambda (x) (declare (type (unsigned-byte 8) x)) (+ x x))))
       (refs (remove-if-not (lambda (node) (and (= (hir-node-kind node) 1)
                                               (equal (hir-node-b node) '(unsigned-byte 8))))
                            (hir-test-nodes root))))
  (assert (= (length refs) 2))
  (assert (null (hir-node-c (first refs))))
  (assert (null (hir-node-c (second refs))))
  (dolist (ref refs) (assert (equal (hir-node-type ref) '(integer 0 255)))))

(dolist (form '((lambda (first &optional (second first)) (declare (fixnum first)) second)
                (let* ((first (unknown-input)) (second first)) (declare (fixnum first)) second)))
  (let ((refs (remove-if-not (lambda (node) (and (= (hir-node-kind node) 1)
                                               (eq (hir-var-name (hir-node-a node)) 'first)))
                             (hir-test-nodes (hir-test-form form)))))
    (assert refs)
    (dolist (ref refs) (assert (eq (hir-node-b ref) 'fixnum)))))

(let* ((root (hir-test-form '(lambda (value)
                             (declare (type (integer 0 200) value))
                             (locally (declare (type (integer 100 255) value)) (+ value value)))))
       (refs (remove-if-not (lambda (node) (= (hir-node-kind node) 1)) (hir-test-nodes root))))
  (assert (= (length refs) 2))
  (assert (equal (hir-node-type (first refs)) '(integer 100 200)))
  (assert (hir-node-c (first refs)))
  (assert (null (hir-node-c (second refs)))))

(let* ((root (hir-test-form '(let ((value (unknown-input)))
                             (declare (fixnum value))
                             (flet ((write-value (new) (setq value new)))
                               (unknown-call #'write-value) (+ value 1)))))
       (refs (remove-if-not (lambda (node) (and (= (hir-node-kind node) 1)
                                               (eq (hir-var-name (hir-node-a node)) 'value)))
                            (hir-test-nodes root))))
  (assert refs)
  (dolist (ref refs)
    (assert (eq (hir-var-type (hir-node-a ref)) 'fixnum))
    (assert (eq (hir-node-type ref) 'fixnum))
    (assert (null (hir-node-c ref)))))

(dolist (name '(< <= > >= = /=))
  (dolist (positive '(t nil))
    (loop for al from -2 to 2 do
      (loop for ah from al to 2 do
        (loop for bl from -2 to 2 do
          (loop for bh from bl to 2 do
            (let* ((av (make-hir-var :name 'a)) (bv (make-hir-var :name 'b))
                   (a (hir-node 1 nil av)) (b (hir-node 1 nil bv))
                   (at (hir-integer-range al ah)) (bt (hir-integer-range bl bh))
                   (environment (list (cons av at) (cons bv bt))))
              (setf (hir-node-type a) at (hir-node-type b) bt)
              (let* ((state (hir-refine-comparison (hir-node 7 nil name (vector a b)) environment positive))
                     (ar (cdr (assoc av state))) (br (cdr (assoc bv state))))
                (loop for x from al to ah do
                  (loop for y from bl to bh
                        when (eq (not (null (funcall name x y))) positive)
                          do (assert (<= (second ar) x (third ar)))
                             (assert (<= (second br) y (third br)))))))))))))

(dolist (form '((lambda (x y) (declare (fixnum x y)) (if (< x y) (1+ x) nil))
                (lambda (x y) (declare (fixnum x y)) (if (> x y) (1+ y) nil))
                (lambda (x y) (declare (fixnum x y)) (if (>= x y) nil (1+ x)))))
  (let ((call (find-if (lambda (node) (and (= (hir-node-kind node) 7) (eq (hir-node-a node) '1+)))
                       (hir-test-nodes (hir-test-form form)))))
    (assert (equal (hir-node-type call) `(integer ,(1+ +hir-fixnum-min+) ,+hir-fixnum-max+)))))

(let* ((root (hir-test-form '(lambda (limit)
                             (declare (fixnum limit))
                             (let ((counter 0))
                               (tagbody top
                                  (if (>= counter limit) (go done))
                                  (setq counter (1+ counter))
                                  (go top)
                                done)
                               counter))))
       (step (find-if (lambda (node) (and (= (hir-node-kind node) 7)
                                         (eq (hir-node-a node) '1+))) (hir-test-nodes root))))
  (assert (equal (hir-node-type step) `(integer 1 ,+hir-fixnum-max+))))

(let* ((root (hir-test-form '(let ((counter 0))
                             (tagbody top (setq counter (1+ counter))
                                      (if (unknown-input) (go top)))
                             counter)))
       (step (find-if (lambda (node) (and (= (hir-node-kind node) 7)
                                         (eq (hir-node-a node) '1+))) (hir-test-nodes root))))
  (assert (eq (hir-node-type step) 'integer)))

(let* ((root (hir-test-form '(let ((value (unknown-input)))
                             (tagbody top
                                (locally (declare (fixnum value)) (1+ value))
                                (setq value 1) (if (unknown-input) (go top)))
                             value)))
       (ref (find-if (lambda (node) (and (= (hir-node-kind node) 1)
                                        (eq (hir-node-b node) 'fixnum))) (hir-test-nodes root))))
  ;; A checked backedge cannot justify removing the unknown entry check.
  (assert (hir-node-c ref)))

(let* ((root (hir-test-form '(lambda (n)
                             (declare (fixnum n))
                             (let ((limit (- n 1)) (counter 0))
                               (tagbody top
                                  (if (>= counter limit) (go done))
                                  (setq counter (1+ counter))
                                  (go top)
                                done)
                               counter))))
       (step (find-if (lambda (node) (and (= (hir-node-kind node) 7)
                                         (eq (hir-node-a node) '1+))) (hir-test-nodes root))))
  (assert (equal (hir-node-type step) `(integer 1 ,(1- +hir-fixnum-max+)))))

(dolist (bounds '((-4611686018427387905 -4611686018427387904)
                  (-4611686018427387904 0) (0 4611686018427387903)
                  (4611686018427387903 4611686018427387904)))
  (let* ((var (make-hir-var)) (old (apply #'hir-integer-range bounds))
         (new (hir-integer-range (1- (first bounds)) (1+ (second bounds))))
         (state (hir-widen-type-environment (list (cons var old)) (list (cons var new))))
         (type (cdar state)))
    (dolist (value (list (1- (first bounds)) (first bounds) (second bounds) (1+ (second bounds))))
      (assert (typep value type)))))
(assert (not (hir-fixnum-type-p (hir-integer-range 4611686018427387903 4611686018427387904))))
(assert (not (hir-fixnum-type-p (hir-integer-range -4611686018427387905 -4611686018427387904))))

(flet ((local-fun (root name)
         (let ((result nil))
           (dolist (node (hir-test-nodes root))
             (when (= (hir-node-kind node) 13)
               (loop for fun across (hir-node-a node)
                     when (eq (hir-fun-name fun) name) do (setf result fun))))
           (or result (error "Missing local function ~S" name)))))
  (let* ((root (hir-test-form '(flet ((step-value (flag)
                                    (block done (if flag (return-from done 2) 3))))
                               (declare (notinline step-value))
                               (list (step-value t) (step-value nil)))))
         (fun (local-fun root 'step-value)))
    (assert (equal (hir-fun-result-type fun) '(integer 2 3))))
  (let* ((root (hir-test-form '(flet ((step-value (x) (+ x 1)))
                               (declare (notinline step-value))
                               (list (step-value 2) (step-value 4)))))
         (fun (local-fun root 'step-value)))
    (assert (equalp (hir-fun-input-types fun) #((integer 2 4))))
    (assert (equal (hir-fun-result-type fun) '(integer 3 5))))
  (let* ((root (hir-test-form '(flet ((step-value (x) (+ x 1)))
                               (unknown-save #'step-value)
                               (list (step-value 2) (step-value 4)))))
         (fun (local-fun root 'step-value)))
    (assert (null (hir-fun-input-types fun)))
    (assert (eq (hir-fun-result-type fun) t)))
  (let* ((root (hir-test-form '(labels ((make-value (x) (+ x 1))
