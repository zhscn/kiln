;;;; Run after tools/env.lisp and (ql:quickload "kiln").
(in-package #:kiln.compiler)

(defun mir-list-test-unit (form)
  (let ((expand (symbol-function 'expand-hir-list-bindings)))
    (unwind-protect
         (progn
           (setf (symbol-function 'expand-hir-list-bindings)
                 (lambda (&rest arguments) (declare (ignore arguments)) nil))
           (let* ((*source-file* "mir-list-model") (*toplevel-source* nil)
                  (forms (front-end-forms (list form))))
             (hir-to-mir (toplevel-form-ast (first forms)))))
      (setf (symbol-function 'expand-hir-list-bindings) expand))))

(defun mir-list-test-count (unit name)
  (loop for function across (hir-vector (mir-unit-functions unit))
        sum (count-if (lambda (instruction)
                        (and (= (mir-instruction-kind instruction) 6)
                             (eq (mir-instruction-data instruction) name)))
                      (hir-vector (mir-function-instructions function)))))

(dolist (entry '((list 2 (lambda (x) (list x 2)))
                 (list* 2 (lambda (x) (list* x 2 x)))
                 (list 1 (lambda (x) (list x)))
                 (list* 1 (lambda (x) (list* x x)))))
  (let ((unit (mir-list-test-unit (third entry))))
    (assert (= 1 (mir-list-test-count unit (first entry))))
    (mir-expand-list-calls unit)
    (verify-mir unit)
    (assert (zerop (mir-list-test-count unit (first entry))))
    (assert (= (second entry) (mir-list-test-count unit 'cons)))))

(dolist (entry '((list (lambda () (list)))
                 (list* (lambda (x) (list* x)))
                 (list* (lambda () (list*)))
                 (list (lambda (x) (list x 1 2 3 4 5 6 7 8)))
                 (list (lambda (x) (declare (notinline list)) (list x 2)))
                 (list* (lambda (x) (declare (notinline list*)) (list* x 2 x)))
                 (list (lambda (x) (declare (optimize (speed 0) (compilation-speed 3)))
                         (list x 2)))))
  (let* ((unit (mir-list-test-unit (second entry)))
         (revisions (map 'simple-vector #'mir-function-revision (hir-vector (mir-unit-functions unit)))))
    (mir-expand-list-calls unit)
    (verify-mir unit)
    (assert (= 1 (mir-list-test-count unit (first entry))))
    (assert (zerop (mir-list-test-count unit 'cons)))
    (assert (equalp revisions
                    (map 'simple-vector #'mir-function-revision (hir-vector (mir-unit-functions unit)))))))

(let* ((unit (mir-list-test-unit '(lambda (x) (list x 2))))
       (revisions (map 'simple-vector #'mir-function-revision (hir-vector (mir-unit-functions unit)))))
  (mir-expand-list-calls unit :cell-budget 0)
  (verify-mir unit)
  (assert (= 1 (mir-list-test-count unit 'list)))
  (assert (equalp revisions
                  (map 'simple-vector #'mir-function-revision (hir-vector (mir-unit-functions unit))))))

(let ((unit (mir-list-test-unit
             '(lambda (x)
                (values (list x 1 2 3 4 5 6 7) (list x 1 2 3 4 5 6 7)
                        (list x 1 2 3 4 5 6 7))))))
  (mir-expand-list-calls unit)
  (verify-mir unit)
  (assert (= 1 (mir-list-test-count unit 'list)))
  (assert (= 16 (mir-list-test-count unit 'cons))))

(let ((unit (mir-list-test-unit
             '(lambda (x)
                (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                (let ((pair (list x 2))) (+ (car pair) (car (cdr pair))))))))
  (mir-expand-list-calls unit)
  (assert (= 2 (mir-list-test-count unit 'cons)))
  (mir-optimize-unit unit)
  (verify-mir unit)
  (assert (< (mir-list-test-count unit 'cons) 2))
  (mir-scalar-replace unit)
  (verify-mir unit)
  (assert (zerop (mir-list-test-count unit 'cons))))
(format t "MIR list expansion preserves fallback policies, budgets and scalar proofs.~%")
