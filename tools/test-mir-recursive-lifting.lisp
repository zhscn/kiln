;;;; Run after tools/env.lisp and (ql:quickload "kiln").
(in-package #:kiln.compiler)

(defun mir-recursive-lifting-unit (body)
  (let* ((*source-file* "mir-recursive-lifting-model") (*toplevel-source* nil)
         (forms (front-end-forms (list `(lambda (n) (declare (optimize (debug 0))) ,body))))
         (*toplevel* (first forms)))
    (hir-to-mir (toplevel-form-ast *toplevel*))))

(defun mir-recursive-lifting-function (unit name)
  (or (find name (hir-vector (mir-unit-functions unit)) :key #'mir-function-name)
      (error "Missing function ~S" name)))

(dolist (case
         '((1 0 (labels ((f (x) (if (zerop x) n (f (1- x))))) (f 3)))
           (1 0 (labels ((f (x) (if (zerop x) n (g (1- x)))) (g (x) (f x))) (f 3)))
           (2 1 (let ((count 0))
                  (labels ((f (x) (incf count) (if (zerop x) (+ n count) (f (1- x))))) (f 3))))
           (1 0 (let ((base (+ n 1)))
                  (labels ((f (x) (if (zerop x) base (f (1- x))))) (f 3))))
           (1 0 (flet ((g (x) (+ n x))) (flet ((f (x) (g x))) (f 3))))
           (1 0 (labels ((f (x &optional (y n yp)) (if (zerop x) (list y yp) (f (1- x) (1+ y))))) (f 3)))
           (1 0 (labels ((f (x &rest tail) (if (zerop x) (list n (car tail)) (f (1- x) (car tail))))) (f 3 :a)))
           (1 0 (labels ((f (x &key (y n)) (if (zerop x) y (f (1- x) :y (1+ y))))) (f 3)))
           (2 1 (let ((count 0))
                  (labels ((f (x) (incf count)
                             (if (zerop x) (+ n count) (multiple-value-call #'f (values (1- x)))))) (f 3))))))
  (destructuring-bind (width cells body) case
    (let* ((unit (mir-recursive-lifting-unit body)) (f (mir-recursive-lifting-function unit 'f)))
      (assert (plusp (length (mir-function-captures f))))
      (mir-lift-local-functions unit)
      (verify-mir unit)
      (assert (= width (mir-function-internal-prefix f)))
      (assert (= cells (logcount (mir-function-argument-cells f))))
      (assert (zerop (length (mir-function-captures f))))
      (let ((g (find 'g (hir-vector (mir-unit-functions unit)) :key #'mir-function-name)))
        (when g
          (assert (= width (mir-function-internal-prefix g)))
          (assert (zerop (length (mir-function-captures g))))))
      (mir-lift-local-functions unit)
      (assert (= width (mir-function-internal-prefix f))))))
(format t "Private function groups lift transitive fields, cells and positional/list entry protocols.~%")

(dolist (body
         '((labels ((f (x) (if (zerop x) n (f (1- x))))) (f 3) #'f)
           (labels ((f (x) (if (zerop x) n (f (1- x))))) (eq #'f #'f) (f 3))
           (labels ((f (x) (declare (optimize (debug 3))) (if (zerop x) n (f (1- x))))) (f 3))
           (labels ((f (x) (if (zerop x) n (f (1- x))))) (f))
           (labels ((f (x) (if (zerop x) n (f (1- x))))) (multiple-value-call #'f (mir-unknown n)))
           (labels ((f (x) (if (zerop x) n (g (1- x)))) (g (x) (f x))) (f 3) #'g)))
  (let* ((unit (mir-recursive-lifting-unit body)) (f (mir-recursive-lifting-function unit 'f))
         (captures (copy-seq (mir-function-captures f))))
    (mir-lift-local-functions unit)
    (verify-mir unit)
    (assert (zerop (mir-function-internal-prefix f)))
    (assert (equalp captures (mir-function-captures f)))))
(format t "Observed, exported, high-debug and invalid recursive entries retain their public ABI.~%")

(let* ((unit (mir-recursive-lifting-unit
              '(labels ((f (x) (if (zerop x) n (f (1- x)))))
                 (funcall (if n #'f (identity #'f)) 3))))
       (f (mir-recursive-lifting-function unit 'f)))
  (mir-lift-local-functions unit :parameter-budget 0)
  (assert (zerop (mir-function-internal-prefix f)))
  (assert (plusp (length (mir-function-captures f)))))

(let* ((arguments (loop repeat (- kiln.kir::+backend-argument-limit+ 2) collect (gensym "ARG")))
       (unit (mir-recursive-lifting-unit
              `(let ((a 1) (b 2))
                 (labels ((f ,arguments (if (zerop ,(first arguments)) n (g)))
                          (g () (if (plusp a) (f ,@(make-list (length arguments) :initial-element 0)) (+ a b))))
                   (f ,@(make-list (length arguments) :initial-element 0))))))
       (f (mir-recursive-lifting-function unit 'f)))
  (assert (svref (mir-lifting-environment-candidates unit) (mir-function-id f)))
  (mir-lift-local-functions unit)
  (verify-mir unit)
  (assert (zerop (mir-function-internal-prefix f))))
(format t "Expanded recursive environments respect argument and block parameter budgets.~%")

;; Two captures may share code while carrying different data environments.
(let* ((unit (mir-recursive-lifting-unit
              '(let ((a 1) (b 2))
                 (flet ((left (x) (+ a x)) (right (x) (+ b x)))
                   (flet ((both (x) (+ (left x) (right x)))) (both n))))))
       (left (mir-recursive-lifting-function unit 'left)) (right (mir-recursive-lifting-function unit 'right))
       (both (mir-recursive-lifting-function unit 'both)) (owner (mir-at (mir-unit-functions unit) 1)))
  (mir-run-unit-pass unit
    (lambda (ignored)
      (declare (ignore ignored))
      (loop for i across (hir-vector (mir-function-instructions owner))
            for kind = (mir-instruction-kind i) for data = (mir-instruction-data i)
            do (case kind
                 (23 (when (eql data (mir-function-id right)) (setf (mir-instruction-data i) (mir-function-id left))))
                 (24 (when (eql (car data) (mir-function-id right))
                       (setf (mir-instruction-data i) (cons (mir-function-id left) (cdr data)))))))
      (setf (mir-function-capture-functions both)
            (map 'simple-vector (lambda (id) (if (eql id (mir-function-id right)) (mir-function-id left) id))
                 (mir-function-capture-functions both)))))
  (let* ((candidates (mir-lifting-environment-candidates unit)) (layouts (mir-lifting-environment-layouts unit candidates)))
    (multiple-value-bind (failure code) (mir-lifting-environment-values unit owner candidates layouts)
      (assert (eq failure :conflict)) (assert (= code (mir-function-id left)))))
  (mir-lift-local-functions unit)
  (verify-mir unit)
  (assert (zerop (mir-function-internal-prefix left)))
  (assert (= 1 (length (mir-function-captures left))))
  (assert (= 2 (mir-function-internal-prefix both))))
(format t "Conflicting same-code environments retain both public function objects through lifted wrappers.~%")

(let* ((unit (mir-recursive-lifting-unit '(labels ((f (x) (if (zerop x) n (f (1- x))))) (f 3))))
       (owner (mir-at (mir-unit-functions unit) 1))
       (candidates (mir-lifting-environment-candidates unit)) (layouts (mir-lifting-environment-layouts unit candidates))
       (environments (mir-lifting-environment-values unit owner candidates layouts))
       (call (find 7 (hir-vector (mir-function-instructions owner)) :key #'mir-instruction-kind)))
  (assert call)
  ;; A call's own result cannot supply an added argument to that call.
  (setf (svref (svref environments (svref (mir-instruction-operands call) 0)) 0) (mir-instruction-result call))
  (assert (= (mir-function-id (mir-recursive-lifting-function unit 'f))
             (mir-lifting-environment-use-failure owner candidates environments))))
(format t "Prospective hidden fields must dominate their new argument uses.~%")
