;;;; Iteration scenarios run from an initialized, compiler-specific image.
(defpackage #:kiln.bench (:use #:cl) (:export #:run))
(in-package #:kiln.bench)

(defvar *edit-version* 0)

(defun environment (name)
  (or (kiln.sys:getenv name) (error "Missing benchmark setting ~A" name)))

(defun measure (name function)
  (format t "~&BENCH-BEGIN ~A~%" name)
  (finish-output)
  (let* ((mode (kiln.sys:getenv "KILN_BENCH_PROFILE"))
         (profile (and mode (equal name (kiln.sys:getenv "KILN_BENCH_PROFILE_PHASE")))))
    (when profile
      (kiln.sys:start-profiler :mode (if (equal mode "alloc") :alloc :cpu)))
    (unwind-protect
         (let ((wall (get-internal-real-time)) (cpu (get-internal-run-time))
               (metrics (make-hash-table :test 'eq))
               (details (make-hash-table :test 'equal)))
           (progv '(kiln.compiler::*compilation-metrics* kiln.compiler::*compilation-metrics-frame*
                    kiln.compiler::*compilation-metric-details*)
                  (list metrics nil details)
             (funcall function))
           (format t "~&BENCH-END ~A ~D ~D ~D~%" name
                   (- (get-internal-real-time) wall) (- (get-internal-run-time) cpu)
                   internal-time-units-per-second)
           (maphash (lambda (phase values)
                      (format t "~&BENCH-METRIC ~A ~A~{ ~D~}~%" name phase (coerce values 'list)))
                    metrics)
           (maphash (lambda (key values)
                      (format t "~&BENCH-METRIC ~A ~{~A~^/~}~{ ~D~}~%" name key (coerce values 'list)))
                    details))
      (when profile
        (kiln.sys:stop-profiler)
        (kiln.sys:write-folded-stacks (environment "KILN_BENCH_PROFILE_OUT"))))
    (finish-output)))

(defun compile-checked (source fasl)
  (multiple-value-bind (output warnings failure) (compile-file source :output-file fasl)
    (declare (ignore warnings))
    (unless (and output (not failure)) (error "Compilation failed: ~A" source))))

(defun save-packets (fasl prefix)
  ;; Inspect record data without executing constructors or load-time forms.
  ;; This work is outside the timed compile/load intervals.
  (with-open-file (stream fasl :element-type '(unsigned-byte 8))
    (dolist (byte '(137 75 70 65 83 2))
      (assert (= (read-byte stream) byte)))
    (kiln.kernel::fasl-read-uint stream)
    (let ((number 0))
      (dotimes (index (kiln.kernel::fasl-read-uint stream))
        (declare (ignore index))
        (let ((record (kiln.kernel::fasl-read-data stream)))
          (when (eq (first record) :run)
            (let ((path (format nil "~A-~D.lir" prefix (incf number))))
              (with-open-file (output path :direction :output :if-exists :supersede
                                          :element-type '(unsigned-byte 8))
                (write-sequence (second record) output)))))))))

(defun edited-function (form version)
  (assert (and (consp form) (eq (first form) 'defun)))
  (let ((prefix nil) (body (cdddr form)))
    (when (and (stringp (first body)) (rest body)) (push (pop body) prefix))
    (loop while (and (consp (first body)) (eq (caar body) 'declare))
          do (push (pop body) prefix))
    `(defun ,(second form) ,(third form)
       ,@(nreverse prefix)
       (multiple-value-prog1 (progn ,@body) (incf *edit-version* ,version)))))

(defun run-scenarios ()
  (let* ((*compile-verbose* nil) (*load-verbose* nil)
         (kiln.sys:*warn-on-cross-file-redefinition* nil)
         (source (environment "KILN_BENCH_SOURCE"))
         (fasl (environment "KILN_BENCH_FASL"))
         (packets (environment "KILN_BENCH_PACKETS"))
         (name (read-from-string (environment "KILN_BENCH_DEFINITION")))
         (records (kiln.sys:find-definitions name))
         (form (and records (kiln.sys:definition-form (first records)))))
    (assert (and form (eq (first form) 'defun) (equal (second form) name)))
    (measure "first-file-compile" (lambda () (compile-checked source fasl)))
    (save-packets fasl (concatenate 'string packets "first"))
    (measure "first-fasl-load" (lambda () (load fasl)))
    (measure "repeat-file-compile" (lambda () (compile-checked source fasl)))
    (save-packets fasl (concatenate 'string packets "repeat"))
    (measure "repeat-fasl-load" (lambda () (load fasl)))
    ;; The library source stays untouched. The scratch file acquires one
    ;; observable compile/load-time effect owned by this benchmark image.
    (with-open-file (stream source :direction :output :if-exists :append)
      (write-line "" stream)
      (write-line "(eval-when (:compile-toplevel :load-toplevel :execute)" stream)
      (write-line "  (incf kiln.bench::*edit-version*))" stream))
    (measure "changed-file-compile" (lambda () (compile-checked source fasl)))
    (save-packets fasl (concatenate 'string packets "changed"))
    (measure "changed-fasl-load" (lambda () (load fasl)))
    (assert (= *edit-version* 2))
    (measure "same-function-eval" (lambda () (eval form)))
    (measure "changed-function-eval" (lambda () (eval (edited-function form 1))))
    (assert (fboundp name))
    (format t "~&BENCH-COMPLETE~%")
    (finish-output)))

(defun run ()
  (handler-case (progn (run-scenarios) (kiln.sys:exit 0))
    (error (condition)
      (format *error-output* "~&Benchmark failed: ~A~%" condition)
      (kiln.sys:exit 1))))
