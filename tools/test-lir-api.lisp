;;;; Run after tools/env.lisp and (ql:quickload "kiln").
(in-package #:cl-user)
(let* ((program '(:lir-module "api" (:init "body")
                  (:function "body" (:block entry (:return ())))))
       (bytes (kiln.lir:encode-program program)))
  (assert (plusp (length bytes)))
  (assert (= (aref bytes 16) 2))
  (assert (handler-case (progn (kiln.lir:encode-program '(:module "legacy")) nil) (error () t)))
  (assert (= (kiln.lir:target-fingerprint) kiln.kir::+backend-target-fingerprint+)))
(format t "The public LIR encoder fixes the production payload and rejects compatibility input.~%")

(dolist (description kiln.kir::+backend-lir-runtime-operations+)
  (multiple-value-bind (arity safepoint) (kiln.lir:runtime-signature (first description))
    (assert (= arity (second description)))
    (assert (eq safepoint (third description)))))
(assert (handler-case (progn (kiln.lir:runtime-signature :invented-runtime-call) nil) (error () t)))

(let* ((state (kiln.kir::make-lir-function :name "alias-test"))
       (aliases (kiln.kir::lir-function-value-aliases state))
       (closures (kiln.kir::lir-function-closure-entries state))
       (first (vector #\v 1 :obj nil))
       (second (vector #\v 2 :obj nil))
       (last (vector #\v 3 :obj nil)))
  (setf (gethash first aliases) second
        (gethash second aliases) last
        (gethash last closures) "entry")
  (assert (kiln.kir::lir-primary-alias-p state first (copy-seq last)))
  (assert (equal (kiln.kir::lir-closure-entry state first) "entry"))
  (remhash last closures)
  (setf (gethash last aliases) first)
  (assert (not (kiln.kir::lir-primary-alias-p state first :self)))
  (assert (handler-case (progn (kiln.kir::lir-closure-entry state first) nil)
            (error (condition)
              (search "closure alias cycle" (princ-to-string condition))))))


(assert (equal (kiln.kir::lir-string-constant "λ漢") '(:string "λ漢")))
(let ((surrogate (code-char #xd800)))
  (when surrogate
    (assert (equal (kiln.kir::lir-string-constant (string surrogate)) '(:string #xd800)))))

(let* ((state (kiln.kir::make-lir-function :name "result-projections"))
       (view (kiln.kir::lir-new-temporary state :mv))
       (primary (kiln.kir::lir-new-temporary state :obj))
       (count (kiln.kir::lir-new-temporary state :word))
       (copy (kiln.kir::lir-new-temporary state :word))
       (blocks (list (list :block :entry
                           (list :set primary (list :mv-ref view 0))
                           (list :set count (list :mv-count view))
                           (list :set copy count)
                           (list :return (list primary))))))
  (kiln.kir::lir-drop-unused-result-copies state blocks nil)
  (assert (equal (cddar blocks)
                 (list (list :set primary (list :mv-ref view 0))
                       (list :return (list primary)))))
  (assert (equal (mapcar #'first (kiln.kir::lir-function-temporaries state)) (list primary view))))

(let* ((state (kiln.kir::make-lir-function :name "constant-operands"))
       (first (kiln.kir::lir-operand state '(:fixnum 1) :obj)))
  (assert (eq first (kiln.kir::lir-operand state '(:fixnum 1) :obj)))
  (setf (kiln.kir::lir-function-block-constants state) nil)
  (assert (not (eq first (kiln.kir::lir-operand state '(:fixnum 1) :obj)))))

(let* ((kiln.kir::*func* (kiln.kir::make-kfunc :name "typed-expression"))
       (block (kiln.kir::new-block))
       (input (kiln.kir::new-var :raw)))
  (kiln.kir::start-block block)
  (let* ((form (list :fixnum-tag (list :word-add input 1)))
         (first (kiln.compiler::copy-to-var form))
         (second (kiln.compiler::copy-to-var form))
         (statements (reverse (kiln.kir::kblock-stmts block))))
    (destructuring-bind (constant add-first tag-first add-second tag-second) statements
      (assert (every (lambda (statement) (eq (first statement) :lir-set)) statements))
      (assert (equal (third constant) '(:word 1)))
      (assert (equal (third add-first) (list :word-add input (second constant))))
      (assert (equal (third add-second) (third add-first)))
      (assert (equal (rest tag-first)
                     (list first (list :fixnum-tag (second add-first)))))
      (assert (equal (rest tag-second)
                     (list second (list :fixnum-tag (second add-second))))))
    (let ((other (kiln.kir::new-block)))
      (kiln.kir::start-block other)
      (kiln.compiler::copy-to-var form)
      (let ((constant (first (last (kiln.kir::kblock-stmts other)))))
        (assert (equal (third constant) '(:word 1)))
        (assert (not (eq (second constant) (second (first statements)))))))))
