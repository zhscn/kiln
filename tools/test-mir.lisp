       (function (mir-at (mir-unit-functions unit) 0))
       (annotation (find 39 (hir-vector (mir-function-instructions function)) :key #'mir-instruction-kind)))
  (loop for block across (hir-vector (mir-function-blocks function))
        do (setf (mir-terminator-policy (mir-block-terminator block)) 975))
  (mir-fold-type-predicates unit)
  (assert (eql 0 (mir-values-fact-count (svref (mir-infer-value-facts function unit) (mir-instruction-result annotation)))))
  (assert (not (find 1 (hir-vector (mir-function-blocks function))
                     :key (lambda (block) (mir-terminator-kind (mir-block-terminator block)))))))
(dolist (type '((values *) (values &rest) (values &key integer)
                (values &optional &optional integer) (values &rest t integer)))
  (assert (handler-case (progn (mir-test-unit `(the ,type (values))) nil) (mir-error () t))))
(format t "MIR VALUES declarations retain counts, refine padded types and fold presence branches.~%")
(assert (eq (hir-declaration-check-type '(function (t) integer)) 'function))
(assert (eq (hir-declaration-check-type '(not (function (t) integer))) t))
(assert (equal (hir-declaration-check-type '(cons (function (t) integer) null)) '(cons function null)))
