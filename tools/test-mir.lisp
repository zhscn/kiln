(dolist (form '((the (values) (values)) (the (values) (values 1 2))
                (the (values integer symbol) (values 1))
                (the (values &optional fixnum) (values))
                (the (values integer &optional symbol &rest character) (values 1 'a #\x #\y))
                (the (values &rest symbol) (values 'a 'b))))
  (verify-mir (mir-test-unit form)))
(let* ((unit (mir-test-unit '(the (values double-float integer) (mir-unknown))))
       (function (mir-at (mir-unit-functions unit) 0))
       (annotation (find 39 (hir-vector (mir-function-instructions function)) :key #'mir-instruction-kind))
       (packets (mir-infer-value-facts function unit))
       (fact (svref packets (mir-instruction-result annotation))))
  (assert (null (mir-values-fact-count fact)))
  (assert (eq (mir-values-ref-type fact 0) 'double-float))
  (assert (eq (mir-values-ref-type fact 1) 'integer)))
(let* ((unit (mir-test-unit '(the (values &optional double-float) (mir-unknown))))
       (function (mir-at (mir-unit-functions unit) 0))
       (annotation (find 39 (hir-vector (mir-function-instructions function)) :key #'mir-instruction-kind)))
  (assert (eq t (svref (mir-infer-types function unit) (mir-instruction-result annotation)))))
