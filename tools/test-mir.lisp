  (assert (null (mir-values-fact-count fact)))
  (assert (eq (mir-values-ref-type fact 10) 'symbol)))
(let* ((unit (mir-test-predicate-unit
              '(let ((x 1)) (flet ((f () x)) (funcall (the (values &rest function) #'f))))))
       (proof (svref (mir-infer-storage unit) 0)))
  (assert (zerop (mir-storage-analysis-closures proof))))

(defun mir-test-parameter-count (unit)
  (loop for function across (hir-vector (mir-unit-functions unit))
        sum (loop for block across (hir-vector (mir-function-blocks function))
                  sum (length (mir-block-parameters block)))))

(dolist (form '((lambda (flag x) (let ((unused x)) (if flag x x)))
                (lambda (x)
                  (let ((i 0))
                    (tagbody again (setq i (1+ i)) (if (< i 3) (go again))) x))
                (lambda (a b n)
                  (tagbody again (if (zerop n) (go done))
                    (let ((temp a)) (setq a b b temp))
                    (setq n (1- n)) (go again) done)
                  (list a b))
                (lambda (flag) (if flag (mir-unknown) (values 1 2)))
                (lambda (x)
                  (catch 'done
                    (setq x (1+ x))
                    (flet ((done () (throw 'done x))) (done))))
                (lambda (x)
                  (unwind-protect
                       (block done (flet ((exit () (return-from done (values x 2)))) (exit)))
                    (setq x (1+ x))))))
  (let* ((unit (mir-test-unit form))
         (before (mir-test-parameter-count unit))
         (signatures (map 'simple-vector #'mir-function-signature (hir-vector (mir-unit-functions unit)))))
    (mir-infer-calls unit)
    (mir-simplify-block-parameters unit)
    (verify-mir unit)
    (assert (< (mir-test-parameter-count unit) before))
    (assert (equalp signatures (map 'simple-vector #'mir-function-signature (hir-vector (mir-unit-functions unit)))))
    (mir-infer-calls unit)
    (mir-infer-storage unit)
    (let ((revisions (map 'simple-vector #'mir-function-revision (hir-vector (mir-unit-functions unit)))))
      (mir-simplify-block-parameters unit)
      (assert (equalp revisions (map 'simple-vector #'mir-function-revision (hir-vector (mir-unit-functions unit))))))))
(format t "MIR block parameter simplification preserves loops, bundles, cells and private layouts.~%")
(let* ((unit (mir-test-unit
              '(lambda (flag)
                 (let ((unused 0))
                   (if flag (setq unused 1) (setq unused 2))
                   (tagbody again (if flag (go done))
                     (setq unused 3) (go again) done)
                   17))))
       (instructions (loop for function across (hir-vector (mir-unit-functions unit))
                           sum (hir-buffer-count (mir-function-instructions function))))
       (calls (mir-infer-calls unit)))
  (assert (plusp (mir-test-parameter-count unit)))
  (mir-simplify-block-parameters unit)
  (assert (zerop (mir-test-parameter-count unit)))
  (assert (= instructions (loop for function across (hir-vector (mir-unit-functions unit))
                                sum (hir-buffer-count (mir-function-instructions function)))))
  (assert (not (eq calls (mir-infer-calls unit)))))
(format t "MIR dead parameter cycles disappear without dropping operations or keeping stale summaries.~%")

(dolist (entry '(((car (mir-unknown)) nil)
                 ((multiple-value-bind (a) (mir-unknown) (list a)) nil)
