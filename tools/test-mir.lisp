;;;; Run after tools/env.lisp and (ql:quickload "kiln").
(in-package #:kiln.compiler)

(defun mir-test-unit (form)
  (let* ((*source-file* "mir-model") (*toplevel-source* nil)
         (forms (front-end-forms (list form))))
    (hir-to-mir (toplevel-form-ast (first forms)))))

(dolist (form '((let ((x 1)) (if (identity x) (setq x 2) (setq x 3)) x)
                (let ((x 0)) (tagbody loop (setq x (1+ x)) (if (< x 3) (go loop))) x)
                (block done (if (identity t) (return-from done (values 1 2)) (values 3 4)))
                (multiple-value-prog1 (values 1 2) (identity 3))))
  (verify-mir (mir-test-unit form)))

(let* ((unit (mir-test-unit '(if (identity t) 1 2)))
       (function (mir-at (mir-unit-functions unit) 0))
       (block (mir-at (mir-function-blocks function) 0))
       (edge (svref (mir-terminator-edges (mir-block-terminator block)) 0))
       (saved (mir-edge-arguments edge)))
  (setf (mir-edge-arguments edge) #(0))
  (assert (handler-case (progn (verify-mir unit) nil) (mir-error () t)))
  (setf (mir-edge-arguments edge) saved)
  (verify-mir unit)
  (let ((computations 0))
    (flet ((compute (f) (declare (ignore f)) (incf computations)))
      (assert (= 1 (mir-analysis function :test #'compute)))
      (assert (= 1 (mir-analysis function :test #'compute)))
      (mir-run-pass unit function #'identity :preserves '(:test))
      (assert (= 1 (mir-analysis function :test #'compute)))
      (mir-run-pass unit function #'identity)
      (assert (= 2 (mir-analysis function :test #'compute))))))

(let* ((unit (mir-test-unit '(if (identity t) 1 2)))
       (function (mir-at (mir-unit-functions unit) 0))
       (values (hir-vector (mir-function-values function)))
       (instructions (hir-vector (mir-function-instructions function)))
       (entry (mir-at (mir-function-blocks function) 0))
       (use (find 10 instructions :key #'mir-instruction-kind))
       (foreign (find-if (lambda (value) (and (plusp (mir-value-block value))
                                              (eq (mir-value-representation value) :bundle))) values)))
  (declare (ignore entry))
  (setf (mir-instruction-operands use) (vector (mir-value-id foreign)))
  (assert (handler-case (progn (verify-mir unit) nil) (mir-error () t))))

(let* ((unit (mir-test-unit '(identity 1)))
       (function (mir-at (mir-unit-functions unit) 0))
       (call (find 6 (hir-vector (mir-function-instructions function)) :key #'mir-instruction-kind)))
  (setf (mir-instruction-effects call) 0)
  (assert (handler-case (progn (verify-mir unit) nil) (mir-error () t))))

(let* ((unit (mir-test-unit '(identity 1)))
       (text (with-output-to-string (stream) (print-mir unit stream))))
  (assert (search "function 0" text)))

(verify-mir (mir-test-unit '(unwind-protect (identity 1) (identity 2))))

(let* ((unit (mir-test-unit '(function (lambda (x) (declare (type nil x)) x))))
       (function (mir-at (mir-unit-functions unit) 1)))
  (assert (find 11 (hir-vector (mir-function-instructions function)) :key #'mir-instruction-kind)))

(format t "MIR graph, SSA validation and analysis invalidation passed.~%")

;;; MIR facts are derived from SSA, independently of HIR annotations.
(defun mir-test-checks (form)
  (let* ((unit (mir-test-unit form))
         (function (mir-at (mir-unit-functions unit) 0))
         (types (mir-infer-types function)))
    (values (loop for instruction across (hir-vector (mir-function-instructions function))
                  when (= 11 (mir-instruction-kind instruction))
                    collect (not (null (mir-check-proven-p instruction types))))
            function unit)))

(assert (equal '(t) (mir-test-checks '(the fixnum (if (identity t) 1 2)))))
(assert (equal '(nil) (mir-test-checks '(the fixnum (if (identity t) 1 'bad)))))
(assert (equal '(nil) (mir-test-checks '(the fixnum (mir-unknown 1)))))
(assert (equal '(t) (mir-test-checks '(the null (values)))))
(assert (equal '(nil) (mir-test-checks '(the nil 1))))
(assert (equal '(nil) (mir-test-checks '(the (integer 0 1) 2))))
(assert (equal '(t) (mir-test-checks
                    '(let ((x 1))
                       (tagbody again (if (identity t) (go done)) (setq x 2) (go again) done)
                       (the fixnum x)))))
(assert (equal '(nil) (mir-test-checks
                      '(let ((x 1))
                         (tagbody again (if (identity t) (go done)) (setq x 'bad) (go again) done)
                         (the fixnum x)))))
(multiple-value-bind (checks function unit) (mir-test-checks '(the fixnum 1))
  (declare (ignore checks))
  (let ((types (mir-infer-types function)))
    (assert (eq types (mir-infer-types function)))
    (mir-run-pass unit function
                  (lambda (f)
                    (loop for instruction across (hir-vector (mir-function-instructions f))
                          when (and (= 0 (mir-instruction-kind instruction))
                                    (eql 1 (mir-instruction-data instruction)))
                            do (setf (mir-instruction-data instruction) 'bad))))
    (assert (not (eq types (mir-infer-types function))))
    (assert (loop for instruction across (hir-vector (mir-function-instructions function))
                  always (not (mir-check-proven-p instruction (mir-infer-types function)))))))
(let* ((unit (mir-test-unit '(if (identity t) 1 2)))
       (function (mir-at (mir-unit-functions unit) 0)))
  (assert (= (1- (ash 1 (hir-buffer-count (mir-function-blocks function))))
             (mir-control-flow function))))
(assert (equal '(t) (mir-test-checks
                    '(let ((x 1))
                       (tagbody (go done) skipped (setq x 'bad) done)
                       (the fixnum x)))))

(format t "MIR type propagation and declaration proofs passed.~%")

(dolist (form '((the (integer 5 5) (+ 2 3))
                (the (integer -6 -6) (- 2 8))
                (the (integer -12 -12) (* -3 4))
                (the (integer 5 5) (1+ 4))
                (the (integer 3 3) (1- 4))
                (the double-float (+ 1d0 2d0))
                (the (integer 0 7) (logand (mir-unknown) 7))
                (the null (values))
                (the (integer 8 8) (values 8 9))
                (the fixnum (identity 2))))
  (assert (equal '(t) (mir-test-checks form))))
(dolist (form '((the fixnum (+ #.+hir-fixnum-max+ 1))
                (the (integer 0 10) (+ 10 1))
                (the fixnum (mir-unknown 2))
                (the fixnum (funcall (mir-unknown) 2))))
  (assert (equal '(nil) (mir-test-checks form))))
;;; A growing cycle must reach a post-fixed point, rather than retaining the
;;; finite prefix seen during the first few iterations.
(assert (equal '(t) (mir-test-checks
                    '(let ((x 0))
                       (tagbody again (setq x (1+ x)) (if (mir-unknown) (go again)))
                       (the integer x)))))
(assert (equal '(nil) (mir-test-checks
                      '(let ((x 0))
                         (tagbody again (setq x (1+ x)) (if (mir-unknown) (go again)))
                         (the fixnum x)))))
(format t "MIR call types and interval widening passed.~%")

(assert (equal '(nil t) (mir-test-checks
                        '(the integer (the fixnum (mir-unknown))))))
(assert (equal '(nil nil t) (mir-test-checks
                            '(let ((x (mir-unknown)))
                               (the integer x)
                               (let ((y (the fixnum x))) (the integer y))))))
(let* ((unit (mir-test-unit
              '(function (lambda (x)
                           (declare (type fixnum x))
                           (the integer (+ x 1))))))
       (function (mir-at (mir-unit-functions unit) 1))
       (types (mir-infer-types function))
       (checks (remove-if-not (lambda (instruction) (= 11 (mir-instruction-kind instruction)))
                              (hir-vector (mir-function-instructions function)))))
  (assert (= 2 (length checks)))
  (assert (not (mir-check-proven-p (svref checks 0) types)))
  (assert (mir-check-proven-p (svref checks 1) types))
  (let ((value (mir-at (mir-function-values function)
                       (mir-instruction-result (svref checks 1)))))
    (setf (mir-value-representation value) :obj)
    (assert (handler-case (progn (verify-mir unit) nil) (mir-error () t)))))
(format t "MIR declaration result types passed.~%")

(assert (equal '(t nil) (mir-test-checks
                        '(let ((x (mir-unknown)))
                           (if (integerp x) (the integer x) (the integer x))))))
(assert (equal '(nil t) (mir-test-checks
                        '(let ((x (mir-unknown)))
                           (if x (the null x) (the null x))))))
(assert (equal '(t nil) (mir-test-checks
                        '(let ((x (mir-unknown)))
                           (if (null x) (the null x) (the null x))))))
(assert (equal '(t) (mir-test-checks
                    '(let ((x (mir-unknown)))
                       (if (consp x) (the cons x) nil)))))
(assert (equal '(nil) (mir-test-checks
                      '(let ((x (mir-unknown)))
                         (if (integerp x) (setq x 'changed))
                         (the integer x)))))
(assert (equal '(nil) (mir-test-checks
                      '(let ((x (mir-unknown)))
                         (if (integerp x) (progn (setq x 'changed) (the integer x)) nil)))))
(assert (equal '(nil) (mir-test-checks
                      '(let ((x (mir-unknown)))
                         (if (mir-unknown x) (the integer x) nil)))))
(format t "MIR conditional edge types passed.~%")

(dolist (form '((let ((x (the fixnum (mir-unknown))))
                 (if (< x 10) (the (integer #.+hir-fixnum-min+ 9) x)
                     (the (integer 10 #.+hir-fixnum-max+) x)))
                (let ((x (the fixnum (mir-unknown))))
                  (if (< 10 x) (the (integer 11 #.+hir-fixnum-max+) x)
                      (the (integer #.+hir-fixnum-min+ 10) x)))
                (let ((x (the fixnum (mir-unknown))))
                  (if (<= x 10) (the (integer #.+hir-fixnum-min+ 10) x)
                      (the (integer 11 #.+hir-fixnum-max+) x)))
                (let ((x (the fixnum (mir-unknown))))
                  (if (= x 10) (the (integer 10 10) x) (the fixnum x)))))
  (assert (equal '(nil t t) (mir-test-checks form))))
(assert (equal '(nil nil) (mir-test-checks
                          '(let ((x (the fixnum (mir-unknown))))
                             (if (< x (progn (setq x 99) 10))
                                 (the (integer #.+hir-fixnum-min+ 9) x) nil)))))
(format t "MIR comparison edge ranges passed.~%")

;;; Check the abstract bounds against concrete comparisons, including both
;;; truth values and intervals that overlap or have no satisfying pair.
(dolist (name '(< <= > >= =))
  (loop for low from -3 to 3 do
    (loop for high from low to 3 do
      (loop for other-low from -3 to 3 do
        (loop for other-high from other-low to 3 do
          (dolist (positive '(t nil))
            (let ((type (inferred-comparison-range
                         name (hir-integer-range low high)
                         (hir-integer-range other-low other-high) positive)))
              (loop for x from low to high do
                (loop for y from other-low to other-high
                      when (eq (not (null (funcall name x y))) positive)
                        do (assert (hir-known-subtype-p (hir-integer-range x x) type)))))))))))
(format t "Integer comparison range soundness passed.~%")

(defun mir-test-call-checks (form)
  (let* ((unit (mir-test-unit `(locally (declare (optimize (speed 0))) ,form)))
         (function (mir-at (mir-unit-functions unit) 0))
         (types (mir-infer-types function unit)))
    (values (loop for instruction across (hir-vector (mir-function-instructions function))
                  when (= 11 (mir-instruction-kind instruction))
                    collect (not (null (mir-check-proven-p instruction types))))
            unit)))

(dolist (form '((the (integer 7 7) (funcall (lambda () 7)))
                (flet ((f () 7)) (the (integer 7 7) (f)))
                (labels ((f (n) (if (zerop n) 7 (g (1- n))))
                         (g (n) (if (zerop n) 7 (f (1- n)))))
                  (the (integer 7 7) (f 10)))
                (let* ((f (lambda () 7)) (g (if (mir-unknown) f f)))
                  (the (integer 7 7) (funcall g)))
                (let ((f (lambda () 7)))
                  (tagbody again (if (mir-unknown) (go again)))
                  (the (integer 7 7) (funcall f)))
                (flet ((f () (values))) (the null (f)))))
  (assert (equal '(t) (mir-test-call-checks form))))
(dolist (form '((let ((f (if (mir-unknown) (lambda () 7) (lambda () 'wrong))))
                 (the integer (funcall f)))
                (let ((f (lambda () 7)))
                  (setq f (mir-unknown)) (the integer (funcall f)))
                (labels ((f (n) (if (zerop n) 0 (1+ (f (1- n))))))
                  (the fixnum (f 10)))
                (the integer (mir-unknown))))
  (assert (equal '(nil) (mir-test-call-checks form))))
(multiple-value-bind (checks unit)
    (mir-test-call-checks '(labels ((f (n) (if (zerop n) 0 (1+ (f (1- n))))))
                            (the integer (f 10))))
  (assert (equal '(t) checks))
  (let ((calls (mir-infer-calls unit)))
    (assert (equal 'integer (svref (mir-call-analysis-summaries calls) 1)))
    (assert (member '(1) (mir-call-analysis-components calls) :test #'equal))))
(multiple-value-bind (checks unit)
    (mir-test-call-checks '(flet ((f () 7)) (the integer (f))))
  (assert (equal '(t) checks))
  (let* ((before (mir-infer-calls unit))
         (callee (mir-at (mir-unit-functions unit) 1)))
    (assert (eq before (mir-infer-calls unit)))
    (mir-run-pass unit callee
                  (lambda (function)
                    (loop for instruction across (hir-vector (mir-function-instructions function))
                          when (and (= 0 (mir-instruction-kind instruction))
                                    (eql 7 (mir-instruction-data instruction)))
                            do (setf (mir-instruction-data instruction) 'wrong))))
    (assert (not (eq before (mir-infer-calls unit))))
    (let* ((caller (mir-at (mir-unit-functions unit) 0))
           (types (mir-infer-types caller unit)))
      (assert (notany (lambda (instruction) (mir-check-proven-p instruction types))
                      (hir-vector (mir-function-instructions caller)))))))
(format t "MIR function identities and call SCC summaries passed.~%")
(assert (equal '(nil)
               (mir-test-call-checks '(labels ((f () (f))) (the integer (f))))))
(verify-mir (mir-test-unit '(locally (declare (optimize (speed 0)))
                             (let ((x (mir-unknown))) (flet ((f () x)) (f))))))

(dolist (form '((flet ((f (x) (1+ x))) (the (integer 3 3) (f 2)))
                (flet ((f (x) (1+ x))) (f 2) (the (integer 3 5) (f 4)))
                (flet ((f (x) (1+ x))) (the integer (f 2)))
                (labels ((f (x) (if (mir-unknown) x (f (1+ x)))))
                  (the integer (f 0)))))
  (assert (equal '(t) (mir-test-call-checks form))))
(dolist (form '((flet ((f (x) (1+ x))) (f 2) (the (integer 5 5) (f 4)))
                (flet ((f (x) x))
                  (values (the fixnum (f 2)) #'f))
                (flet ((f (x) x))
                  (setq *mir-escaped-function* #'f) (the fixnum (f 2)))
                (flet ((f (x) x))
                  (mir-unknown #'f) (the fixnum (f 2)))
                (flet ((f (x) x))
                  (list #'f) (the fixnum (f 2)))
                (flet ((f (x) x) (g (h) (funcall h 'wrong)))
                  (g #'f) (the fixnum (f 2)))
                (flet ((f (x) x) (g (x) x))
                  (funcall (if (mir-unknown) #'f #'g) 'wrong)
                  (the fixnum (f 2)))
                (labels ((f (x) (if (mir-unknown) x (f (1+ x)))))
                  (the fixnum (f 0)))))
  (assert (equal '(nil) (mir-test-call-checks form))))
(multiple-value-bind (checks unit)
    (mir-test-call-checks '(flet ((f (x) (1+ x))) (the integer (f 2))))
  (assert (equal '(t) checks))
  (let* ((calls (mir-infer-calls unit))
         (caller (mir-at (mir-unit-functions unit) 0)))
    (assert (equal '(integer 2 2) (svref (svref (mir-call-analysis-inputs calls) 1) 0)))
    (assert (not (logbitp 1 (mir-call-analysis-external calls))))
    (mir-run-pass unit caller
                  (lambda (function)
                    (loop for instruction across (hir-vector (mir-function-instructions function))
                          when (and (= 0 (mir-instruction-kind instruction))
                                    (eql 2 (mir-instruction-data instruction)))
                            do (setf (mir-instruction-data instruction) 'wrong))))
    (let ((updated (mir-infer-calls unit)))
      (assert (not (eq calls updated)))
      (assert (eq 'symbol (svref (svref (mir-call-analysis-inputs updated) 1) 0))))))
(format t "MIR local call inputs and external entries passed.~%")
(let* ((names (loop repeat 80 collect (gensym "LOCAL")))
       (last (car (last names)))
       (form `(flet ,(mapcar (lambda (name) `(,name (x) x)) names)
                ,@(mapcar (lambda (name) `(,name 0)) (butlast names))
                (values (the fixnum (,last 2)) (function ,last)))))
  (multiple-value-bind (checks unit) (mir-test-call-checks form)
    (assert (equal '(nil) checks))
    (let* ((calls (mir-infer-calls unit)) (external (mir-call-analysis-external calls)))
      (assert (logbitp 80 external))
      (loop for id from 1 below 80 do (assert (not (logbitp id external)))))))
(format t "Wide MIR external-entry sets passed.~%")

(dolist (form '((multiple-value-bind (a b c) (values 1 2)
                 (the (integer 1 1) a) (the (integer 2 2) b) (the null c))
                (multiple-value-bind (a b) (values)
                  (the null a) (the null b))
                (flet ((f () (values 1 'ok)))
                  (multiple-value-bind (a b c) (f)
                    (the (integer 1 1) a) (the symbol b) (the null c)))
                (flet ((f (p) (if p (values 1 'ok) (values 2 'yes))))
                  (multiple-value-bind (a b c) (f (mir-unknown))
                    (the (integer 1 2) a) (the symbol b) (the null c)))
                (multiple-value-bind (a b) (multiple-value-prog1 (values 1 'ok) (mir-unknown))
                  (the integer a) (the symbol b))))
  (assert (every #'identity (mir-test-call-checks form))))
(assert (equal '(nil)
               (mir-test-call-checks
                '(flet ((f (p) (if p (values 1 2) (values))))
                   (multiple-value-bind (a b) (f (mir-unknown))
                     (declare (ignore a)) (the integer b))))))
(multiple-value-bind (checks unit)
    (mir-test-call-checks '(flet ((f () (values 1 2))) (f)))
  (declare (ignore checks))
  (let ((fact (svref (mir-call-analysis-value-summaries (mir-infer-calls unit)) 1)))
    (assert (= 2 (mir-values-fact-count fact)))
    (assert (equal '(integer 2 2) (mir-values-ref-type fact 1)))
    (assert (eq 'null (mir-values-ref-type fact 2)))))
(multiple-value-bind (checks unit)
    (mir-test-call-checks
     '(labels ((f (n) (if (zerop n) (values 0 0)
                         (multiple-value-bind (a b) (f (1- n)) (values a (1+ b))))))
        (multiple-value-bind (a b) (f 5)
          (the (integer 0 0) a) (the integer b))))
  (assert (equal '(t t) checks))
  (let ((fact (svref (mir-call-analysis-value-summaries (mir-infer-calls unit)) 1)))
    (assert (= 2 (mir-values-fact-count fact)))
    (assert (eq 'integer (mir-values-ref-type fact 1)))))
(let* ((unit (mir-test-unit '(multiple-value-bind (a b) (values 1 2) b)))
       (function (mir-at (mir-unit-functions unit) 0))
       (instruction (find 14 (hir-vector (mir-function-instructions function)) :key #'mir-instruction-kind)))
  (assert instruction)
  (setf (mir-instruction-data instruction) -1)
  (assert (handler-case (progn (verify-mir unit) nil) (mir-error () t))))
(format t "MIR multiple-value facts and bindings passed.~%")
(assert (equal '(nil)
               (mir-test-call-checks
                '(flet ((f (x) x))
                   (multiple-value-bind (a g) (values 0 #'f)
                     (declare (ignore a)) (mir-unknown g))
                   (the fixnum (f 2))))))
(let* ((count (+ 2 +mir-values-prefix-limit+))
       (fact (mir-fixed-values (make-array count :initial-element 'integer))))
  (assert (= count (mir-values-fact-count fact)))
  (assert (eq t (mir-values-ref-type fact +mir-values-prefix-limit+)))
  (assert (eq 'null (mir-values-ref-type fact count))))

(dolist (form '((flet ((f (a b c) (values (+ a b) c)))
                 (multiple-value-bind (a b)
                     (multiple-value-call #'f (values 1 2) (values) (values 3))
                   (the (integer 3 3) a) (the (integer 3 3) b)))
                (flet ((f () (values 7 8)))
                  (multiple-value-bind (a b) (multiple-value-call #'f (values))
                    (the (integer 7 7) a) (the (integer 8 8) b)))
                (flet ((f (x) (1+ x)))
                  (f 2) (the (integer 3 3) (multiple-value-call #'f (values 2))))))
  (assert (every #'identity (mir-test-call-checks form))))
(assert (equal '(nil)
               (mir-test-call-checks
                '(flet ((f (x) x))
                   (f 1) (the fixnum (multiple-value-call #'f (mir-unknown)))))))
(assert (equal '(nil)
               (mir-test-call-checks
                '(flet ((f (x) x) (invoke (g) (multiple-value-call g (values 'wrong))))
                   (multiple-value-call #'invoke (values #'f))
                   (the fixnum (f 1))))))
(let* ((unit (mir-test-unit '(multiple-value-call #'list (values 1 2))))
       (function (mir-at (mir-unit-functions unit) 0))
       (instruction (find 15 (hir-vector (mir-function-instructions function)) :key #'mir-instruction-kind)))
  (assert instruction)
  (setf (mir-instruction-operands instruction) #())
  (assert (handler-case (progn (verify-mir unit) nil) (mir-error () t))))
(format t "MIR multiple-value call inputs passed.~%")
(assert (equal '(t)
               (mir-test-call-checks
                '(flet ((f () (values)))
                   (multiple-value-bind (a) (multiple-value-call #'f) (the null a))))))

(defun mir-test-storage (form &optional (optimize t))
  (let ((unit (mir-test-unit `(locally (declare (optimize (speed 0))) ,form))))
    ;; Isolate MIR selection from the production tree optimizer.
    (when optimize
      (loop for function across (hir-vector (mir-unit-functions unit)) do
        (mir-run-pass unit function
                      (lambda (function)
                        (loop for instruction across (hir-vector (mir-function-instructions function))
                              do (setf (mir-instruction-policy instruction) 1023))))))
    (let ((analysis (svref (mir-infer-storage unit) 0)))
      (values (logcount (mir-storage-analysis-stack analysis)) analysis unit))))

(dolist (form '((let ((x (cons 1 2))) (car x))
                (let* ((x (cons 1 nil)) (y (cons x nil))) (car (car y)))
                (let ((x (cons 1 nil))) (rplacd x x) (eq x (cdr x)))
                (let ((x (cons 1 2)))
                  (tagbody again (if (mir-unknown) (go again))) (car x))))
  (assert (plusp (mir-test-storage form))))
(dolist (form '((cons 1 2)
                (let ((x (cons 1 2))) (mir-unknown x) (car x))
                (let ((x (cons 1 2))) (setq *mir-escaped-cons* x) nil)
                (let ((x (cons 1 2))) (rplaca (mir-unknown) x) nil)
                (let ((x (cons 1 2))) (list x) nil)
                (let* ((x (cons 1 2)) (y (cons x nil))) y)
                (let ((x nil)) (tagbody again (setq x (cons 1 x)) (if (mir-unknown) (go again))) (car x))
                (let ((x (cons 1 2))) (multiple-value-bind (a b) (values x 3)
                                         (declare (ignore b)) (car a)))
                (let ((x (cons 1 2))) (let ((y (if (mir-unknown) (values x) (values x 3)))) (car y)))
                (locally (declare (notinline car)) (let ((x (cons 1 2))) (car x)))
                (locally (declare (notinline cons)) (let ((x (cons 1 2))) (car x)))))
  (assert (zerop (mir-test-storage form))))
(assert (= 2 (mir-test-storage '(let* ((x (cons 1 nil)) (y (cons x nil))) (eq x (car y))))))
(assert (zerop (mir-test-storage '(let ((x (cons 1 2))) (car x)) nil)))
(format t "MIR cons graph escape and storage proofs passed.~%")
(assert (zerop (mir-test-storage
                '(let ((x (cons 1 nil)))
                   (tagbody again (cons x nil) (if (mir-unknown) (go again))) nil))))
(assert (zerop (mir-test-storage
                '(let ((x (cons 1 nil)) (y (cons 2 nil))) (rplaca y x) y))))
(multiple-value-bind (count analysis unit) (mir-test-storage '(let ((x (cons 1 nil))) (car x)))
  (assert (= count 1))
  (let ((function (mir-at (mir-unit-functions unit) 0)))
