  (assert (not (svref carriers (mir-instruction-result annotation)))))
(let* ((unit (mir-test-unit '(car (mir-unknown))))
       (function (mir-at (mir-unit-functions unit) 0))
       (call (find-if (lambda (instruction)
                       (and (= (mir-instruction-kind instruction) 6)
                            (eq (mir-instruction-data instruction) 'mir-unknown)))
                     (hir-vector (mir-function-instructions function))))
       (old (mir-bundle-carriers function)))
  (mir-run-pass unit function
    (lambda (function)
      (loop for block across (hir-vector (mir-function-blocks function))
            for term = (mir-block-terminator block) when (= (mir-terminator-kind term) 2)
              do (setf (mir-terminator-operands term) (vector (mir-instruction-result call))))))
  (assert (not (eq old (mir-bundle-carriers function))))
  (assert (svref (mir-bundle-carriers function) (mir-instruction-result call))))
