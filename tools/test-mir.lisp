(dolist (form '((unwind-protect (values 1 2) (mir-effect))
                (let ((x 0)) (catch 'tag (unwind-protect (throw 'tag x) (setq x 1))) x)
                (block done (unwind-protect (return-from done (values 1 2)) (mir-effect)))
                (block done (unwind-protect (return-from done 1) (return-from done 2)))
                (catch 'tag (unwind-protect (throw 'tag 1) (throw 'tag 2)))
                (catch 'tag (unwind-protect (throw 'tag 1) (catch 'inner (throw 'inner 2))))
                (tagbody again (unwind-protect (if (mir-unknown) (go again)) (mir-effect)))
                (unwind-protect (unwind-protect 1 (mir-effect)) (mir-effect))))
  (let ((unit (mir-test-predicate-unit form)))
    (verify-mir unit)
    (mir-fold-type-predicates unit)
    (mir-lift-local-functions unit)
    (mir-scalar-replace unit)
    (verify-mir unit)))
(let* ((unit (mir-test-unit '(unwind-protect 1 2)))
       (function (mir-at (mir-unit-functions unit) 0))
       (block (find 6 (hir-vector (mir-function-blocks function))
                    :key (lambda (block) (mir-terminator-kind (mir-block-terminator block))))))
  (assert block)
  (setf (mir-terminator-region (mir-block-terminator block)) 999)
  (assert (handler-case (progn (verify-mir unit) nil) (mir-error () t))))
(format t "MIR UNWIND-PROTECT cleanup states, local exits and overriding exits passed.~%")
(let* ((unit (mir-test-unit '(unwind-protect 1 2)))
       (function (mir-at (mir-unit-functions unit) 0))
       (header (mir-at (mir-function-blocks function) 0))
       (body (mir-at (mir-function-blocks function)
                     (mir-edge-target (svref (mir-terminator-edges (mir-block-terminator header)) 0))))
       (term (mir-block-terminator body)))
  (setf (mir-terminator-kind term) 6 (mir-terminator-operands term) #()
        (mir-terminator-edges term) #() (mir-terminator-region term) 0)
  (assert (handler-case (progn (verify-mir unit) nil) (mir-error () t))))

(dolist (form '((block done (flet ((exit () (return-from done (values 1 2)))) (declare (notinline exit)) (exit)))
                (let ((x 0))
                  (block done (flet ((exit () (setq x 1) (return-from done x)))
                                (declare (notinline exit)) (unwind-protect (exit) (setq x 2)))))
                (block done (lambda () (return-from done 1)))
                (let ((n 0))
                  (tagbody again
                    (flet ((jump () (go again)))
                      (declare (notinline jump)) (setq n (1+ n)) (if (< n 3) (jump)))))
