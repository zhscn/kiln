;;;; Run after tools/env.lisp and (ql:quickload "kiln").
(in-package #:kiln.compiler)
(defun mir-inline-test-call-count (unit)
  (loop for function across (hir-vector (mir-unit-functions unit))
        sum (count 7 (hir-vector (mir-function-instructions function)) :key #'mir-instruction-kind)))
(dolist (form '((lambda (x)
                 (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                 (flet ((add (a) (+ a 1))) (values (add x) (add 2))))
                (lambda (x)
                  (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                  (flet ((choose (a) (if a (values 1 2) (values))))
                    (values (choose x) (choose nil))))
                (lambda (x)
                  (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                  (flet ((sum (n)
                           (let ((i 0) (total 0))
                             (tagbody again (if (= i n) (go done))
                               (incf total i) (incf i) (go again) done)
                             total)))
                    (values (sum x) (sum 3))))))
  (let* ((*source-file* "inline-model") (*toplevel-source* nil)
         (forms (front-end-forms (list form)))
         (unit (hir-to-mir (toplevel-form-ast (first forms))))
         (before (mir-inline-test-call-count unit)))
    (mir-inline-local-functions unit :body-budget 128)
    (verify-mir unit)
    (assert (> before (mir-inline-test-call-count unit)))
    (format t "Inline verified: ~D -> ~D calls.~%" before (mir-inline-test-call-count unit))))
(let ((reductions '(0 0 0 1)))
(dolist (form '((lambda (x)
                 (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                 (flet ((add (a) (+ a 1)))
                   (declare (notinline add)) (values (add x) (add 2))))
                (lambda (x)
                  (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                  (labels ((rec (n) (if (zerop n) n (rec (1- n)))))
                    (values (rec x) (rec 2))))
                (lambda (x)
                  (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                  (flet ((add (a) (+ a x))) (values (add x) (add 2))))
                (lambda (x)
                  (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                  (flet ((add (a) (+ a 1))) (values (add x) (add 2 3))))))
  (let* ((*source-file* "inline-conservative") (*toplevel-source* nil)
         (forms (front-end-forms (list form)))
         (unit (hir-to-mir (toplevel-form-ast (first forms))))
         (before (mir-inline-test-call-count unit)))
    (mir-inline-local-functions unit)
    (verify-mir unit)
    (assert (= (pop reductions) (- before (mir-inline-test-call-count unit))))
    (format t "Inline conservative verified: ~D -> ~D calls.~%" before (mir-inline-test-call-count unit))))
)
(let* ((form '(lambda (x)
                (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                (let ((n x))
                  (flet ((next () (incf n))) (values (next) (next) n)))))
       (*source-file* "inline-cell-prefix") (*toplevel-source* nil)
       (forms (front-end-forms (list form)))
       (unit (mir-lift-local-functions (hir-to-mir (toplevel-form-ast (first forms)))))
       (before (mir-inline-test-call-count unit)))
  (mir-inline-local-functions unit)
  (verify-mir unit)
  (assert (> before (mir-inline-test-call-count unit)))
  (format t "Inline cell prefix verified: ~D -> ~D calls.~%" before (mir-inline-test-call-count unit)))
(let* ((form '(lambda (x)
                (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                (flet ((make (a) (lambda () (incf a))))
                  (let ((a (make x)) (b (make 10)))
                    (values (funcall a) (funcall a) (funcall b))))))
       (*source-file* "inline-closure-construction") (*toplevel-source* nil)
       (forms (front-end-forms (list form)))
       (unit (mir-lift-local-functions (hir-to-mir (toplevel-form-ast (first forms)))))
       (before (mir-inline-test-call-count unit)))
  (mir-inline-local-functions unit)
  (verify-mir unit)
  (assert (> before (mir-inline-test-call-count unit)))
  (format t "Inline closure construction verified: ~D -> ~D calls.~%" before (mir-inline-test-call-count unit)))
(let* ((form '(lambda (x)
                (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                (flet ((leave (a) (kiln.sys:%gc) (throw 'done (values a :exit))))
                  (catch 'done (if x (leave x) (leave nil))))))
       (*source-file* "inline-throw-in-catch") (*toplevel-source* nil)
       (forms (front-end-forms (list form)))
       (unit (mir-lift-local-functions (hir-to-mir (toplevel-form-ast (first forms)))))
       (before (mir-inline-test-call-count unit)))
  (mir-inline-local-functions unit)
  (verify-mir unit)
  (assert (> before (mir-inline-test-call-count unit)))
  (format t "Inline THROW in caller CATCH verified: ~D -> ~D calls.~%" before (mir-inline-test-call-count unit)))
(let* ((form '(lambda (x)
                (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                (flet ((apply-one (function argument) (funcall function argument))
                       (add (a) (+ a 1)))
                  (values (apply-one #'add x) (apply-one #'add 2)))))
       (*source-file* "inline-function-argument") (*toplevel-source* nil)
       (forms (front-end-forms (list form)))
       (unit (mir-lift-local-functions (hir-to-mir (toplevel-form-ast (first forms)))))
       (before (mir-inline-test-call-count unit)))
  (mir-inline-local-functions unit)
  (verify-mir unit)
  (assert (> before (mir-inline-test-call-count unit)))
  (format t "Inline function argument verified: ~D -> ~D calls.~%" before (mir-inline-test-call-count unit)))

(dolist (budgets '((:body-budget 0) (:growth-budget 0)))
  (let* ((*source-file* "inline-budget") (*toplevel-source* nil)
         (forms (front-end-forms
                 '((lambda (x)
                     (declare (optimize (speed 3) (debug 0) (compilation-speed 0)))
                     (flet ((add (a) (+ a 1))) (values (add x) (add 2)))))))
         (unit (hir-to-mir (toplevel-form-ast (first forms))))
         (before (mir-inline-test-call-count unit))
         (revisions (map 'simple-vector #'mir-function-revision (hir-vector (mir-unit-functions unit)))))
    (apply #'mir-inline-local-functions unit budgets)
    (assert (= before (mir-inline-test-call-count unit)))
    (assert (equalp revisions (map 'simple-vector #'mir-function-revision (hir-vector (mir-unit-functions unit)))))
    (verify-mir unit)))
(format t "MIR inline budgets preserve bodies and analysis revisions.~%")

(let* ((form '(lambda (x)
                (declare (ignore x) (optimize (speed 3) (debug 0) (compilation-speed 0)))
                (let ((n 0))
                  (flet ((probe (a b) (list a b n)))
                    (values (probe (incf n) (incf n))
                            (probe (incf n) (incf n)) n)))))
       (*source-file* "inline-argument-effects") (*toplevel-source* nil)
       (forms (front-end-forms (list form)))
       (unit (mir-lift-local-functions (hir-to-mir (toplevel-form-ast (first forms)))))
       (before (mir-inline-test-call-count unit)))
  (mir-inline-local-functions unit)
  (verify-mir unit)
  (assert (> before (mir-inline-test-call-count unit)))
  (format t "Inline argument effects verified: ~D -> ~D calls.~%" before (mir-inline-test-call-count unit)))

(let* ((form '(lambda (x)
                (declare (ignore x) (optimize (speed 3) (debug 0) (compilation-speed 0)))
                (flet ((literal () (load-time-value (list :token))))
                  (let ((first (literal)))
                    (kiln.sys:%gc)
                    (values (eq first (literal)) (car (literal)))))))
       (*source-file* "inline-load-time-identity") (*toplevel-source* nil)
       (forms (front-end-forms (list form)))
       (unit (mir-lift-local-functions (hir-to-mir (toplevel-form-ast (first forms)))))
       (before (mir-inline-test-call-count unit)))
  (mir-inline-local-functions unit)
  (verify-mir unit)
  (assert (> before (mir-inline-test-call-count unit)))
  (format t "Inline load-time identity verified: ~D -> ~D calls.~%" before (mir-inline-test-call-count unit)))
