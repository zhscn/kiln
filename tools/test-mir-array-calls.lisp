;;;; Run after tools/env.lisp and (ql:quickload "kiln").
;;;; Requires kernel.lir and clos.lir from tools/test.sh.
(in-package #:kiln.compiler)

(labels ((contains (opcode tree)
           (if (consp tree)
               (or (contains opcode (car tree)) (contains opcode (cdr tree)))
               (eq opcode tree))))
  (dolist (entry '(((lambda (array index)
                     (declare (optimize (speed 3) (safety 3))) (aref array index)) :vector-ref :string-ref)
                   ((lambda (value array index)
                      (declare (optimize (speed 3) (safety 3))) (setf (aref array index) value)) :vector-set :string-set)))
    (let ((module (compile-module (front-end-forms (list (first entry))) "mir-array-fast-path" :pipeline :mir)))
      (dolist (opcode (rest entry)) (assert (contains opcode (kiln.kir::kmodule-funcs module))))))
  (let ((module (compile-module
                 (front-end-forms '((lambda (array index)
                                     (declare (optimize (speed 3) (safety 3)) (notinline aref))
                                     (aref array index))))
                 "mir-array-notinline" :pipeline :mir)))
    (assert (not (contains :vector-ref (kiln.kir::kmodule-funcs module))))
    (assert (not (contains :string-ref (kiln.kir::kmodule-funcs module))))))

(let* ((root (asdf:system-source-directory "kiln"))
       (output (merge-pathnames "build/mir-array-test/arrays.lir" root))
       (session (make-session))
       (forms '((defun mir-array-read (array index)
                  (declare (optimize (speed 3) (safety 3))) (aref array index))
                (defun mir-array-write (value array index)
                  (declare (optimize (speed 3) (safety 3))) (setf (aref array index) value))
                (defun mir-array-read-notinline (array index)
                  (declare (optimize (speed 3) (safety 3)) (notinline aref)) (aref array index))
                (defun mir-array-read-two (array row column) (aref array row column))
                (defun mir-array-read-zero (array) (aref array))
                (let ((array (vector 1 2)))
                  (print (list (mir-array-read array 1)
                               (mir-array-write nil array 0)
                               (mir-array-read array 0)
                               (mir-array-read-notinline array 1))))
                (let ((array (make-array 3 :element-type 'character :initial-element #\x :fill-pointer 0)))
                  (print (list (mir-array-read array 2)
                               (mir-array-write #\z array 1)
                               (mir-array-read array 1) (length array))))
                (let* ((backing (make-array 4 :element-type 'bit :initial-element 1))
                       (array (make-array 2 :element-type 'bit :displaced-to backing :displaced-index-offset 1)))
                  (print (list (mir-array-read array 0) (mir-array-write 0 array 1)
                               (mir-array-read array 1) (aref backing 2))))
                (print (mir-array-read-two (make-array '(2 2) :initial-element 7) 1 0))
                (print (mir-array-read-zero (make-array nil :initial-element 9))))))
  (ensure-directories-exist output)
  (kiln::write-module (compile-module (front-end-forms forms session) "mir-array-calls"
                                     :session session :pipeline :mir) output)
  (let ((text (uiop:run-program
               (mapcar #'namestring
                       (list (merge-pathnames "target/debug/kiln-cg" root) #P"jit"
                             (merge-pathnames "build/test/kernel.lir" root)
                             (merge-pathnames "build/test/clos.lir" root) output))
               :output :string :error-output :string)))
    (assert (equal text (format nil "(2 NIL NIL 2)~%(#\\x #\\z #\\z 0)~%(1 0 0 0)~%7~%9~%"))
            () "Unexpected MIR array call output: ~S" text)))
(format t "MIR array calls preserve dynamic shapes, stores, dimensions and NOTINLINE.~%")
