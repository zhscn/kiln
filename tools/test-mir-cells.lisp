;;;; Run after tools/env.lisp and (ql:quickload "kiln").
(in-package #:kiln.compiler)

(defun mir-cell-test-unit (count width &key backwards cycle read-cell initialized unreachable-predecessor)
  "Build typed SSA cell edges with controllable propagation and observation."
  (let* ((unit (make-mir-unit)) (function (make-mir-function :name 'cell-flow))
         (blocks (mir-function-blocks function)))
    (hir-push function (mir-unit-functions unit))
    (dotimes (id count) (hir-push (make-mir-block :id id) blocks))
    (labels ((emit (block kind representation operands data)
               (let* ((id (hir-buffer-count (mir-function-instructions function)))
                      (position (hir-buffer-count (mir-block-instructions block)))
                      (result (and representation (mir-add-value function representation (mir-block-id block) position))))
                 (hir-push (make-mir-instruction :id id :kind kind :result result :operands operands :data data
                                                :effects (svref *mir-instruction-effects* kind))
                           (mir-function-instructions function))
                 (hir-push id (mir-block-instructions block))
                 result)))
      (let* ((entry (mir-at blocks 0))
             (nargs (emit entry 12 :count #() nil))
             (check (emit entry 13 nil (vector nargs) '(0 . 0)))
             (nil-value (emit entry 0 :obj #() nil))
             (seed (if initialized (emit entry 19 :cell (vector nil-value) nil)
                       (emit entry 25 :cell #() nil)))
             (terminal (if backwards 1 (1- count))))
        (declare (ignore check))
        (loop for id from 1 below count
              do (setf (mir-block-parameters (mir-at blocks id))
                       (coerce (loop repeat width collect (mir-add-value function :cell id -1)) 'simple-vector)))
        (dotimes (id count)
          (let* ((block (mir-at blocks id))
                 (next (if backwards (if (zerop id) (1- count) (1- id)) (1+ id)))
                 (arguments (if (zerop id) (make-array width :initial-element seed)
                                (mir-block-parameters block))))
            (cond ((= id terminal)
                   (when read-cell
                     (emit block 20 :obj (vector (svref (mir-block-parameters block) (1- width))) nil))
                   (let ((bundle (emit block 9 :bundle (vector nil-value) nil)))
                     (setf (mir-block-terminator block) (make-mir-terminator :kind 2 :operands (vector bundle)))))
                  ((and cycle (= id (floor count 2)))
                   (setf (mir-block-terminator block)
                         (make-mir-terminator :kind 1 :operands (vector nil-value)
                                              :edges (vector (make-mir-edge :target 1 :arguments arguments)
                                                             (make-mir-edge :target next :arguments arguments)))))
                  (t (setf (mir-block-terminator block)
                           (make-mir-terminator :kind 0
                                                :edges (vector (make-mir-edge :target next :arguments arguments))))))))
        (when unreachable-predecessor
          (let* ((block (make-mir-block :id count))
                 (unbound (emit block 25 :cell #() nil)))
            (hir-push block blocks)
            (setf (mir-block-terminator block)
                  (make-mir-terminator :kind 0
                                       :edges (vector (make-mir-edge :target 1
                                                                    :arguments (make-array width :initial-element unbound)))))))))
    unit))

(dolist (shape '((8 16) (128 16) (64 16 :backwards t) (32 16 :cycle t)))
  (verify-mir (apply #'mir-cell-test-unit shape))
  (let ((rejected nil))
    (handler-case (verify-mir (apply #'mir-cell-test-unit (append shape '(:read-cell t))))
      (mir-error (condition)
        (setf rejected (search "cell is used before its binding is initialized" (princ-to-string condition)))))
    (assert rejected () "Uninitialized cell read was not rejected in ~S" shape)))
(verify-mir (mir-cell-test-unit 64 16 :read-cell t :initialized t))
(verify-mir (mir-cell-test-unit 64 16 :read-cell t :initialized t :unreachable-predecessor t))
(format t "MIR cell initialization follows high SSA IDs, loops and reachable predecessors.~%")
