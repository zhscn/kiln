;;;; Run after tools/env.lisp and (ql:quickload "kiln").
;;;; Requires kernel.lir and clos.lir from tools/test.sh.
(in-package #:kiln.compiler)

(defun mir-value-test-unit (body &optional notinline)
  (let* ((*source-file* "mir-value-model") (*toplevel-source* nil)
         (forms (front-end-forms
                 (list `(lambda (x xs)
                          (declare (optimize (speed 3) (safety 3)) ,@(when notinline '((notinline eql append))))
                          ,body)))))
    (hir-to-mir (toplevel-form-ast (first forms)))))

(dolist (entry '(((eql x :key) eq 2) ((eql x nil) eq 2) ((eql x #\a) eq 2)
                 ((eql x 1f0) eq 2) ((eql x "text") eq 2)
                 ((eql x 1000000000000000000000000000000) eql 2)
                 ((eql x 1/3) eql 2) ((eql x 1d0) eql 2) ((eql x #c(1d0 2d0)) eql 2)
                 ((eql x xs) eql 2)
                 ((append) list 0) ((append x) identity 1) ((append nil x) identity 1)
                 ((append x nil) kiln.kernel::append-2 2)
                 ((append nil x nil xs) kiln.kernel::append-2 2)
                 ((append x nil xs x) append 3)))
  (let ((unit (mir-value-test-unit (first entry))))
    (mir-specialize-direct-calls unit)
    (verify-mir unit)
    (assert (loop for function across (hir-vector (mir-unit-functions unit))
                  thereis (loop for instruction across (hir-vector (mir-function-instructions function))
                                thereis (and (= (mir-instruction-kind instruction) 6)
                                             (eq (mir-instruction-data instruction) (second entry))
                                             (= (length (mir-instruction-operands instruction)) (third entry))))))
    (let ((revisions (map 'list #'mir-function-revision (hir-vector (mir-unit-functions unit)))))
      (mir-specialize-direct-calls unit)
      (assert (equal revisions (map 'list #'mir-function-revision (hir-vector (mir-unit-functions unit))))))))
(dolist (body '((eql x :key) (append nil x)))
  (let ((unit (mir-value-test-unit body t)))
    (mir-specialize-direct-calls unit)
    (verify-mir unit)
    (assert (loop for function across (hir-vector (mir-unit-functions unit))
                  thereis (find (car body) (hir-vector (mir-function-instructions function))
                                :key #'mir-instruction-data :test #'eq)))))
(format t "MIR value calls preserve heap-number EQL, APPEND copy boundaries and NOTINLINE; rewrites are idempotent.~%")

(let* ((root (asdf:system-source-directory "kiln"))
       (output (merge-pathnames "build/mir-value-test/values.lir" root))
       (session (make-session))
       (forms '((defvar *mir-value-events* nil)
                (defun mir-append-copy (prefix tail) (append prefix tail))
                (defun mir-append-nils (prefix tail)
                  (append (progn (push 1 *mir-value-events*) nil)
                          (progn (push 2 *mir-value-events*) prefix)
                          (progn (push 3 *mir-value-events*) nil)
                          (progn (push 4 *mir-value-events*) tail)))
                (let* ((item (list :item)) (prefix (list item :second)) (tail (list :last))
                       (result (mir-append-copy prefix tail)))
                  (print (and (not (eq result prefix)) (eq (car result) item)
                              (eq (cddr result) tail)))
                  (let ((copy (mir-append-copy prefix nil)))
                    (print (and (equal copy prefix) (not (eq copy prefix)))))
                  (print (and (eq (append nil prefix) prefix) (eq (append prefix) prefix)))
                  (print (and (null (append)) (eq (append nil :tail) :tail)))
                  (print (eq (cddr (mir-append-copy prefix :tail)) :tail))
                  (print (equal (mir-append-nils prefix tail) (append prefix tail)))
                  (print (equal *mir-value-events* '(4 3 2 1))))
                (print (eql (+ (expt 2 100) 1) 1267650600228229401496703205377))
                (print (eql (/ 1 3) 1/3))
                (print (eql (+ 0.25d0 0.75d0) 1d0))
                (print (eql (complex 1d0 2d0) #c(1d0 2d0)))
                (print (eql (code-char 97) #\a)))))
  (ensure-directories-exist output)
  (kiln::write-module (compile-module (front-end-forms forms session) "mir-value-calls"
                                     :session session :pipeline :mir) output)
  (let ((text (uiop:run-program
               (mapcar #'namestring
                       (list (merge-pathnames "target/debug/kiln-cg" root) #P"jit"
                             (merge-pathnames "build/test/kernel.lir" root)
                             (merge-pathnames "build/test/clos.lir" root) output))
               :output :string :error-output :string)))
    (assert (equal text (format nil "~{~A~%~}" (make-list 12 :initial-element t)))
            () "Unexpected MIR value call output: ~S" text)))
(format t "MIR value calls preserve APPEND sharing, copying, dotted tails, evaluation order and heap-number EQL.~%")
