            () "Unexpected MIR capture type output: ~S" text)))
(format t "Host MIR capture type proofs and shared cell GC execution passed.~%")

(let* ((session (make-session))
       (form '(function (lambda (x) (declare (optimize (speed 0))) (the fixnum x))))
       (module (compile-module (front-end-forms (list form) session) "mir-capture-negative" :session session :pipeline :mir)))
  (assert (gethash (kiln.kir::kir-name "kiln_sym_" (symbol-label 'kiln.kernel::%declared-type-error))
                   (kiln.kir::kmodule-defined module))
          () "Unproved declaration check disappeared from MIR output."))

(let* ((root (asdf:system-source-directory "kiln"))
       (output (merge-pathnames "build/mir-test/stack-closures.lir" root))
       (session (make-session))
       (form '(flet ((owner ()
                      (declare (optimize (debug 0)))
                      (let ((x nil))
                        (flet ((put () (setq x (cons (list 60) nil)) (kiln.sys:%gc))
                               (peek () (kiln.sys:%gc) x))
                          (declare (notinline put peek))
                          (put) (kiln.sys:%gc) (car (peek))))))
                (declare (notinline owner)) (print (owner))))
       (module (compile-module (front-end-forms (list form) session) "mir-stack-closures" :session session :pipeline :mir)))
  (labels ((operations (tree name)
             (if (consp tree) (+ (if (eq (car tree) name) 1 0)
                                (operations (car tree) name) (operations (cdr tree) name)) 0)))
    (assert (= 2 (operations (kiln.kir::kmodule-funcs module) :stack-closure))
            () "MIR did not select both local closures for stack storage.")
    (assert (= 1 (operations (kiln.kir::kmodule-funcs module) :stack-cons))
            () "MIR did not select the shared cell for stack storage."))
  (ensure-directories-exist output)
  (kiln::write-module module output)
  (let ((text (uiop:run-program
               (mapcar #'namestring
                       (list (merge-pathnames "target/debug/kiln-cg" root) #P"jit"
                             (merge-pathnames "build/test/kernel.lir" root)
                             (merge-pathnames "build/test/clos.lir" root) output))
               :output :string :error-output :string)))
    (assert (search "(60)" text) () "Unexpected MIR stack closure output: ~S" text)))
(format t "Host MIR stack closures and shared cell GC execution passed.~%")

;; Keep the source free of arithmetic literals so that HIR constant folding
;; cannot supply the operation being checked here.
(let* ((root (asdf:system-source-directory "kiln"))
       (output (merge-pathnames "build/mir-test/double-arithmetic.lir" root))
       (session (make-session))
       (form '(flet ((calculate (x y)
                      (declare (double-float x y))
                      (list (+ x y) (- x y) (* x y) (/ x y)
                            (- x) (abs x) (1+ x) (1- x))))
                (declare (notinline calculate))
                (print (calculate 6d0 2d0))))
       (module (compile-module (front-end-forms (list form) session)
                               "mir-double-arithmetic" :session session :pipeline :mir)))
  (labels ((contains (tree name)
             (and (consp tree) (or (eq (car tree) name)
                                  (contains (car tree) name) (contains (cdr tree) name)))))
    (dolist (op '(:f64-add :f64-sub :f64-mul :f64-div))
      (assert (contains (kiln.kir::kmodule-funcs module) op) () "Missing MIR operation ~S" op)))
  (kiln::write-module module output)
  (let ((text (uiop:run-program
               (mapcar #'namestring
                       (list (merge-pathnames "target/debug/kiln-cg" root) #P"jit"
                             (merge-pathnames "build/test/kernel.lir" root)
                             (merge-pathnames "build/test/clos.lir" root) output))
               :output :string :error-output :string)))
    (assert (search "8.0" text) () "Unexpected MIR arithmetic output: ~S" text)))
(format t "Host MIR double arithmetic execution passed.~%")
(dolist (form '((lambda (x y) (+ x y))
                (lambda (x y) (declare (double-float x y) (notinline +)) (+ x y))
                (lambda (x y) (declare (double-float x y) (optimize (speed 0))) (+ x y))))
  (let* ((session (make-session))
         (module (compile-module (front-end-forms (list form) session)
                                 "mir-generic-arithmetic" :session session :pipeline :mir)))
    (labels ((contains (tree)
               (and (consp tree) (or (eq (car tree) :f64-add)
                                    (contains (car tree)) (contains (cdr tree))))))
      (assert (not (contains (kiln.kir::kmodule-funcs module)))))))

(let* ((root (asdf:system-source-directory "kiln"))
       (output (merge-pathnames "build/mir-test/raw-double-joins.lir" root))
       (session (make-session))
       (form '(flet ((calculate (x y)
                      (declare (optimize (debug 0)) (double-float x y))
                      (let ((n 0))
                        (tagbody again
                          (if (= n 3) (go done))
                          (let ((temp x)) (setq x y y temp))
                          (setq x (1+ x) y (* y 2d0) n (1+ n))
                          (kiln.sys:%gc)
                          (go again)
                         done)
                        (+ (* x y) (- x y)))))
                (declare (notinline calculate))
                (print (= (calculate 1d0 2d0) 43d0))))
       (module (compile-module (front-end-forms (list form) session)
                               "mir-raw-double-joins" :session session :pipeline :mir)))
  (labels ((boxes (tree)
             (if (consp tree)
                 (+ (if (and (eq (car tree) :alloc-fixed)
                             (eql (third tree) kiln.kir::+packet-class-double+)) 1 0)
                    (boxes (car tree)) (boxes (cdr tree))) 0)))
    (assert (= 1 (boxes (kiln.kir::kmodule-funcs module)))
            () "Raw MIR loop intermediates should require only the return box."))
  (kiln::write-module module output)
  (let ((text (uiop:run-program
               (mapcar #'namestring
                       (list (merge-pathnames "target/debug/kiln-cg" root) #P"jit"
                             (merge-pathnames "build/test/kernel.lir" root)
                             (merge-pathnames "build/test/clos.lir" root) output))
               :output :string :error-output :string)))
    (assert (search "T" text) () "Unexpected MIR raw loop output: ~S" text)))
(format t "Host MIR raw double loop copies and GC execution passed.~%")

(let* ((root (asdf:system-source-directory "kiln"))
       (output (merge-pathnames "build/mir-test/double-comparison.lir" root))
       (session (make-session))
       (form '(flet ((compare (x y)
                      (declare (optimize (debug 0)) (double-float x y))
                      (< (+ x y) (progn (kiln.sys:%gc) (* x y)))))
