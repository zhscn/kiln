(let* ((root (asdf:system-source-directory "kiln"))
       (output (merge-pathnames "build/mir-test/stack-rest.lir" root))
       (session (make-session))
       (form '(flet ((reader (&rest items)
                      (let ((sum 0))
                        (tagbody again
                           (when (null items) (go done))
                           (kiln.sys:%gc)
                           (setq sum (+ sum (car (car items))) items (cdr items))
                           (go again)
                         done)
                        sum)))
                (declare (notinline reader))
                (print (reader))
                (print (reader (list 3)))
                (print (reader (list 1) (list 2) (list 3) (list 4)
                               (list 5) (list 6) (list 7) (list 8)))
                (print (reader (list 1) (list 2) (list 3) (list 4)
                               (list 5) (list 6) (list 7) (list 8) (list 9)))))
       (module (compile-module (front-end-forms (list form) session) "mir-stack-rest" :session session :pipeline :mir))
       (program (kiln.kir::normalize-lir-module module)))
  (assert (some (lambda (function)
                  (and (eq (first function) :function) (search "kiln_mir_" (second function))
                       (some (lambda (part) (and (eq (first part) :rest)
                                                (equal (fourth part) '(:stack 8)))) (cddr function))))
                (cddr program)) () "MIR did not select bounded stack rest storage.")
  (ensure-directories-exist output)
  (kiln::write-module module output)
  (let ((text (uiop:run-program
               (mapcar #'namestring
                       (list (merge-pathnames "target/debug/kiln-cg" root) #P"jit"
                             (merge-pathnames "build/test/kernel.lir" root)
                             (merge-pathnames "build/test/clos.lir" root) output))
               :output :string :error-output :string)))
    (assert (equal '(0 3 36 45)
                   (with-input-from-string (stream text)
                     (loop for value = (read stream nil :eof) until (eq value :eof) collect value)))
            () "Unexpected MIR stack rest output: ~S" text)))
(format t "Host MIR bounded stack rest and GC execution passed.~%")

(let* ((root (asdf:system-source-directory "kiln"))
       (output (merge-pathnames "build/mir-test/scalar.lir" root))
       (session (make-session))
       (form '(flet ((scalar (n)
                      (declare (optimize (debug 0)))
                      (let ((x (cons (progn (print :car) 0) (progn (print :cdr) 1))))
                        (tagbody again
                           (when (zerop n) (go done))
                           (rplaca x (+ (car x) (cdr x)))
                           (rplacd x (1+ (cdr x)))
                           (setq n (1- n))
                           (kiln.sys:%gc)
                           (go again)
                         done)
                        (list (car x) (cdr x)))))
                (declare (notinline scalar)) (print (scalar 3))))
       (module (compile-module (front-end-forms (list form) session) "mir-scalar" :session session :pipeline :mir))
       (program (kiln.kir::normalize-lir-module module)))
  (assert (notany (lambda (function)
                    (and (eq (first function) :function)
                         (some (lambda (part) (eq (first part) :stack-object)) (cddr function))))
                  (cddr program)) () "MIR retained scalar-only cons storage.")
  (ensure-directories-exist output)
  (kiln::write-module module output)
  (let ((text (uiop:run-program
               (mapcar #'namestring
                       (list (merge-pathnames "target/debug/kiln-cg" root) #P"jit"
                             (merge-pathnames "build/test/kernel.lir" root)
                             (merge-pathnames "build/test/clos.lir" root) output))
               :output :string :error-output :string)))
    (assert (equal '(:car :cdr (6 4))
                   (with-input-from-string (stream text)
                     (loop for value = (read stream nil :eof) until (eq value :eof) collect value)))
            () "Unexpected MIR scalar output: ~S" text)))
(format t "Host MIR scalar field SSA, evaluation order and GC execution passed.~%")

(let* ((root (asdf:system-source-directory "kiln"))
       (output (merge-pathnames "build/mir-test/captures.lir" root))
       (session (make-session))
       (form '(progn
                (print (let ((x (list 30))) (funcall (lambda () (kiln.sys:%gc) (car x)))))
                (let ((x 0))
                  (flet ((inc () (kiln.sys:%gc) (setq x (1+ x))) (peek () x))
                    (declare (notinline inc peek))
                    (inc) (inc) (print (peek))))
                (let ((x 0))
                  (labels ((f (n) (if (zerop n) x (g (1- n))))
                           (g (n) (kiln.sys:%gc) (setq x (1+ x)) (f n)))
                    (declare (notinline f g)) (print (f 3))))))
       (module (compile-module (front-end-forms (list form) session) "mir-captures" :session session :pipeline :mir)))
  (ensure-directories-exist output)
  (kiln::write-module module output)
  (let ((text (uiop:run-program
               (mapcar #'namestring
                       (list (merge-pathnames "target/debug/kiln-cg" root) #P"jit"
                             (merge-pathnames "build/test/kernel.lir" root)
                             (merge-pathnames "build/test/clos.lir" root) output))
               :output :string :error-output :string)))
    (assert (equal '(30 2 3)
                   (with-input-from-string (stream text)
                     (loop for value = (read stream nil :eof) until (eq value :eof) collect value)))
            () "Unexpected MIR capture output: ~S" text)))
(format t "Host MIR closures, shared cells and recursive GC execution passed.~%")

(let* ((root (asdf:system-source-directory "kiln"))
       (output (merge-pathnames "build/mir-test/capture-types.lir" root))
       (session (make-session))
       (form '(locally (declare (optimize (speed 0)))
                (print (let ((x 1))
                         (flet ((put (v) (setq x v)) (peek () x))
                           (put 2) (kiln.sys:%gc) (the (integer 1 2) (peek)))))
                (print (let ((x 33))
                         (flet ((peek () (values x 34)))
                           (multiple-value-bind (a b) (peek)
                             (list (the (integer 33 33) a) (the (integer 34 34) b))))))))
       (module (compile-module (front-end-forms (list form) session) "mir-capture-types" :session session :pipeline :mir)))
  (assert (not (gethash (kiln.kir::kir-name "kiln_sym_" (symbol-label 'kiln.kernel::%declared-type-error))
                        (kiln.kir::kmodule-defined module)))
          () "MIR retained checks proved by capture or shared cell types.")
  (ensure-directories-exist output)
  (kiln::write-module module output)
  (let ((text (uiop:run-program
               (mapcar #'namestring
                       (list (merge-pathnames "target/debug/kiln-cg" root) #P"jit"
                             (merge-pathnames "build/test/kernel.lir" root)
                             (merge-pathnames "build/test/clos.lir" root) output))
               :output :string :error-output :string)))
    (assert (equal '(2 (33 34))
