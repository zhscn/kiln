(defun typed-vector-store (vector index value)
  (declare (simple-vector vector))
  (funcall #'(setf aref) value vector index))
(defun typed-svref-store (vector index value)
  (declare (simple-vector vector))
  (funcall #'(setf svref) value vector index))
(defun typed-vector-length (vector)
  (declare (simple-vector vector))
  (length vector))
(let ((vector (vector 1 2 3)))
  (print (list (typed-vector-store vector 1 '(4 5)) (aref vector 1)))
  (print (list (typed-svref-store vector 2 'last) (svref vector 2)))
  (print (typed-vector-length vector))
  (dolist (index '(-1 3 1/2 4611686018427387904))
    (print (handler-case (typed-vector-store vector index 'bad) (error () 'bounds)))
    (print (handler-case (typed-svref-store vector index 'bad) (error () 'bounds)))))
(print (handler-case (typed-vector-length nil) (type-error () 'type-error)))

(let ((vector (vector 1 2)) (events nil))
  (print (funcall #'(setf aref)
                  (progn (push 'value events) '(saved))
                  (progn (push 'vector events) vector)
                  (progn (push 'index events) (setq vector nil) 0)))
  (print (nreverse events))
  (print vector))

(let ((string (kiln.sys:%primop :make-string 3 #\a)))
  (print (list (length string) (char-code (char string 1)) (schar string 2)))
  (print (funcall #'(setf char) #\λ string 1))
  (print (funcall #'(setf schar) #\z string 2))
  (print (funcall #'(setf aref) #\q string 0))
  (print string)
  (dolist (index '(-1 3 1/2 4611686018427387904))
    (print (handler-case (char string index) (error () 'bounds)))
    (print (handler-case (funcall #'(setf aref) #\b string index) (error () 'bounds))))
  (print (handler-case (funcall #'(setf char) 4 string 0) (type-error () 'type-error)))
  (print string))

(let ((string (make-array 4 :element-type 'base-char :initial-element #\x :fill-pointer 2)))
  (declare (string string))
  (print (list (length string) (char string 1)))
  (setf (char string 1) #\y)
  (print (list (length string) (char string 0) (char string 1))))
(let ((base (vector 1 2 3 4)))
  (let ((view (make-array 2 :displaced-to base :displaced-index-offset 1)))
    (declare (vector view))
    (setf (aref view 0) 7)
    (print (list (length view) (aref view 0) (aref base 1)))))

(defun typed-vector-elt (vector index)
  (declare (simple-vector vector))
  (elt vector index))
(print (typed-vector-elt #(10 20) 1))
(print (handler-case (typed-vector-elt #(10) 1) (error () 'bounds)))
(let ((text (kiln.sys:%primop :make-string 2 #\q)))
  (print (elt text 1))
  (print (handler-case (elt text 2) (error () 'bounds))))

(defun typed-vector-set-elt (vector index value)
  (declare (simple-vector vector))
  (funcall #'(setf elt) value vector index))
(let ((vector (vector 1 2)))
  (print (typed-vector-set-elt vector 1 '(3 4)))
  (print (aref vector 1))
  (print (handler-case (typed-vector-set-elt vector 2 5) (error () 'bounds))))
(let ((text (kiln.sys:%primop :make-string 2 #\q)))
  (print (funcall #'(setf elt) #\z text 0))
  (print text)
  (print (handler-case (funcall #'(setf elt) 4 text 0) (type-error () 'type-error))))
(let ((vector (make-array 3 :initial-element 1 :fill-pointer 1)))
  (declare (vector vector))
  (print (handler-case (funcall #'(setf elt) 9 vector 1) (type-error () 'bounds)))
  (print (aref vector 1)))

(defun typed-array-extent (array)
  (declare (type (simple-array t (3)) array))
  (list (length array) (elt array 1)))
(print (typed-array-extent (vector 10 20 30)))
(print (handler-case (typed-array-extent (vector 10 20)) (type-error () 'extent-error)))
(defun typed-array-element (array)
  (declare (type (array bit (*)) array))
  (elt array 0))
(print (typed-array-element (make-array 2 :element-type 'bit :initial-element 1)))
(print (handler-case (typed-array-element (vector 1 0)) (type-error () 'element-error)))

(defun typed-simple-bit-elt (array index)
  (declare (type (simple-array bit (*)) array))
  (elt array index))
(defun typed-simple-bit-set-elt (array index value)
  (declare (type (simple-array bit (*)) array))
  (funcall #'(setf elt) value array index))
(let ((bits (make-array 2 :element-type 'bit :initial-element 1)))
  (print (typed-simple-bit-elt bits 1))
  (print (typed-simple-bit-set-elt bits 1 0))
  (print (typed-simple-bit-elt bits 1))
  (print (handler-case (typed-simple-bit-elt bits 2) (error () 'bounds)))
  (print (handler-case (typed-simple-bit-set-elt bits 0 3) (type-error () 'element-error))))

(let ((bits (make-array 2 :element-type 'bit :initial-element 1)))
  (print (elt bits 0))
  (print (funcall #'(setf elt) 0 bits 1))
  (print (elt bits 1))
  (print (handler-case (funcall #'(setf elt) 3 bits 1) (type-error () 'element-error))))

(let ((vector (vector 1 2 3 2 3)))
  (print (search '(2 3) vector))
  (print (search (list 3 2) vector))
  (print (search '(4 5 6) vector))
  (print (search '(1 2 3 4 5 6) vector)))
(let ((bits (make-array 4 :element-type 'bit :initial-element 0)))
  (setf (aref bits 2) 1)
  (print (search '(0 1) bits)))
(let ((text (kiln.sys:%primop :make-string 3 #\q)))
  (setf (char text 1) #\z)
  (print (search '(#\q #\z) text))
  (print (search nil text)))
(let ((vector (vector :a :b :a :b)))
  (print (search '(:a :b) vector))
  (print (search '(:a :b) vector :from-end t))
  (print (search '(1) (vector 1d0)))
  (print (search '(1) (vector 1d0) :test #'=)))
