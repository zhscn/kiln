;;; The printer (Incless).

(defun show (x) (write-line (prin1-to-string x)))

(show 42)
(show -1234567890123456789012345)
(show 3/4)
(show 1.5)
(show 0.1)
(show 1.0d0)
(show 1e10)
(show 1.5e-5)
(show -0.0)
(show 123456.7)
(show #\a)
(show #\Space)
(show #\Newline)
(show "a \"quoted\" string")
(show 'symbol)
(show :keyword)
(show '|mixed Case|)
(show (make-symbol "UNINTERNED"))
(show 'kiln.kernel::internal)
(show '(1 (2 3) . 4))
(show '(quote x))
(show #(1 "two" #\3))
(show (make-array '(2 2) :initial-contents '((1 2) (3 4))))
(show (make-array 3 :element-type 'bit :initial-contents '(1 0 1)))
(show (let ((v (make-array 5 :fill-pointer 2 :initial-element 7))) v))
(write-line (princ-to-string "no quotes"))
(write-line (princ-to-string #\x))
(write-line (princ-to-string '(a "b" #\c)))
(write-line (write-to-string 255 :base 16 :radix t))
(write-line (write-to-string 'downcase :case :downcase))
(let ((*print-length* 3)) (show '(1 2 3 4 5)))
(let ((*print-level* 2)) (show '(1 (2 (3 (4))))))
(defstruct point x y)
(show (make-point :x 1 :y 2))
(defclass thing () ())
(write-line (subseq (prin1-to-string (make-instance 'thing)) 0 8))
(defmethod print-object ((p point) stream)
  (format-free-print p stream))
(defun format-free-print (p stream)
  (write-string "<point " stream)
  (prin1 (point-x p) stream)
  (write-string ">" stream))
(show (make-point :x 5 :y 6))
(defclass named () ((name :initarg :name)))
(defmethod print-object ((n named) stream)
  (print-unreadable-object (n stream :type t)
    (prin1 (slot-value n 'name) stream)))
(show (make-instance 'named :name "bob"))
(prin1 '(written to standard output))
(terpri)
(princ "done")
(terpri)
