"/a/b/c.lisp" => (:ABSOLUTE "a" "b") "c" "lisp" :NEWEST | "/a/b/c.lisp"
"a/b/" => (:RELATIVE "a" "b") NIL NIL NIL | "a/b/"
"c" => NIL "c" NIL :NEWEST | "c"
".bashrc" => NIL ".bashrc" NIL :NEWEST | ".bashrc"
"foo.tar.gz" => NIL "foo.tar" "gz" :NEWEST | "foo.tar.gz"
"foo." => NIL "foo" "" :NEWEST | "foo."
"." => NIL "." NIL :NEWEST | "."
"../x/y.z" => (:RELATIVE :UP "x") "y" "z" :NEWEST | "../x/y.z"
"./a/b" => (:RELATIVE "." "a") "b" NIL :NEWEST | "./a/b"
"~/x.y" => (:ABSOLUTE :HOME) "x" "y" :NEWEST | "~/x.y"
"/" => (:ABSOLUTE) NIL NIL NIL | "/"
"" => NIL NIL NIL NIL | ""
"*.lisp" => NIL :WILD "lisp" :NEWEST | "*.lisp"
"/a/**/*.*" => (:ABSOLUTE "a" :WILD-INFERIORS) :WILD :WILD :NEWEST | "/a/**/*.*"
"a*b.c" => NIL "a*b" "c" :NEWEST | "a*b.c"
"/a/../b" => (:ABSOLUTE "a" :UP) "b" NIL :NEWEST | "/a/../b"
"a//b" => (:RELATIVE "a") "b" NIL :NEWEST | "a/b"
"x.y.z" => NIL "x.y" "z" :NEWEST | "x.y.z"
".a.b" => NIL ".a" "b" :NEWEST | ".a.b"
