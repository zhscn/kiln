;;; FORMAT (Invistra).

(defun f (control &rest args) (write-line (apply #'format nil control args)))

(f "plain")
(f "~a and ~s" "str" "str")
(f "~d ~5d|~5,'0d|~:d" 42 42 42 1234567)
(f "~b ~o ~x ~36r" 10 10 255 35)
(f "~r / ~:r / ~@r" 123 4 1999)
(f "~f ~,2f ~8,3f|" 3.14159 2.5 1.0)
(f "~e" 12345.678)
(f "~$" 3.5)
(f "~c ~:c" #\a #\Space)
(f "~a~%~a" 1 2)
(f "~{~a~^, ~}" '(1 2 3))
(f "~:{(~a ~a)~}" '((1 2) (3 4)))
(f "~[zero~;one~;two~]" 1)
(f "~:[no~;yes~]" t)
(f "~@[got ~a~]" 5)
(f "~10a|~10@a|" "left" "right")
(f "~(~a~) ~:@(~a~)" "LOWER" "upper")
(f "~a ~:*~a" 'again)
(f "~?" "~a-~a" '(x y))
(f "~p ~:p" 1 2)
(f "~&fresh")
(format t "to stdout ~a~%" 'ok)
(let ((s (make-string-output-stream)))
  (format s "into ~a" "stream")
  (write-line (get-output-stream-string s)))
(let ((s (make-array 0 :element-type 'character :adjustable t :fill-pointer 0)))
  (format s "fill ~a" "pointer")
  (write-line s))
(write-line (with-output-to-string (s) (funcall (formatter "~a+~a") s 1 2)))
(print (handler-case (format nil "~q") (error () 'format-error)))
(print (handler-case (error "bad ~a" 'thing)
         (error (c) (format nil "~a" c))))
