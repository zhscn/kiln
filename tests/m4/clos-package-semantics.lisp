;; Package mutations return true, including operations on empty symbol lists.
(let ((a (make-package "KILN-ANSI-PACKAGE-A" :use nil))
      (b (make-package "KILN-ANSI-PACKAGE-B" :use nil)))
  (unwind-protect
       (let ((symbol (intern "EXPORTED" a)))
         (print (export symbol a))
         (print (import symbol a))
         (print (use-package a b))
         (print (nth-value 1 (find-symbol "EXPORTED" b)))
         (print (unuse-package a b))
         (print (find-symbol "EXPORTED" b))
         (print (import symbol b))
         (print (nth-value 1 (find-symbol "EXPORTED" b)))
         (print (unexport symbol a))
         (print (unexport symbol a))
         (print (nth-value 1 (find-symbol "EXPORTED" a)))
         (print (shadowing-import symbol b))
         (print (shadow "LOCAL" b))
         (print (eq a (handler-bind ((package-error (lambda (c) (continue c))))
                        (make-package "KILN-ANSI-PACKAGE-A" :use nil))))
         (print (eq a (handler-bind ((package-error (lambda (c) (continue c))))
                        (make-package "KILN-ANSI-PACKAGE-C"
                                      :nicknames '("KILN-ANSI-PACKAGE-A") :use nil))))
         (print (export nil b))
         (print (import nil b))
         (let* ((name (make-array 4 :element-type 'character
                                  :initial-contents "ABCD" :fill-pointer 3))
                (new (intern name a)))
           (print (symbol-name new))
           (print (eq new (find-symbol "ABC" a))))
         (print (handler-case (package-name "KILN-ANSI-NO-SUCH-PACKAGE")
                  (package-error () :missing)))
         (print (handler-case (find-package 37) (type-error () :invalid))))
    (delete-package b)
    (delete-package a)))
(print (do-all-symbols (s :bad) (return :good)))
(let ((value :dynamic))
  (declare (special value))
  (let ((value :lexical))
    (print (do-symbols (s "COMMON-LISP" value) (declare (special value))))
    (print (do-external-symbols (s "COMMON-LISP" value) (declare (special value))))
    (print (do-all-symbols (s value) (declare (special value))))))
(let ((a (make-package "KILN-ANSI-PACKAGE-A" :use nil))
      (b (make-package "KILN-ANSI-PACKAGE-B" :use nil)))
  (unwind-protect
       (let ((original (intern "NAME" a)) (replacement (make-symbol "NAME")))
         (export original a)
         (intern "HIDDEN" a)
         (use-package a b)
         (print (nth-value 1 (find-symbol "HIDDEN" b)))
         (print (shadowing-import replacement b))
         (print (eq (find-symbol "NAME" b) replacement))
         (print (eq (symbol-package replacement) b))
         (print (handler-bind ((package-error (lambda (c) (continue c))))
                  (delete-package a)))
         (print (package-use-list b)))
    (delete-package b)
    (delete-package a)))

(print (handler-bind ((package-error (lambda (c) (continue c))))
         (delete-package "KILN-ANSI-NO-SUCH-PACKAGE")))
