(defvar *file-author-directory* (merge-pathnames "build/test/file-author/"))
(ensure-directories-exist *file-author-directory*)
(setf (logical-pathname-translations "KILNAUTHOR")
      `(("**;*.*.*" ,(merge-pathnames "**/*.*" *file-author-directory*))))
(let ((path (merge-pathnames "owner.txt" *file-author-directory*)))
  (unwind-protect
       (progn
         (with-open-file (stream path :direction :output :if-exists :supersede)
           (write-string "owned" stream)
           (print (equal (file-author stream) (file-author path))))
         (let ((author (file-author path)))
           (print (and (stringp author) (plusp (length author))))
           (print (equal author (file-author (namestring path))))
           (print (equal author (file-author "KILNAUTHOR:OWNER.TXT")))
           (let ((stream (open path)))
             (close stream)
             (print (equal author (file-author stream)))))
         (dolist (designator (list (make-pathname :name :wild :type "txt" :defaults path)
                                  (make-pathname :type :wild :defaults path)
                                  (merge-pathnames "missing.txt" *file-author-directory*)
                                  "KILNAUTHOR:*.TXT"))
           (print (handler-case (file-author designator)
                    (file-error () :rejected))))
         (print (handler-case (file-author 42) (type-error () :rejected))))
    (when (probe-file path) (delete-file path))))
