;;; Native layout, inclusion, reflection, copying, and GC reachability.
(defstruct empty)
(defstruct root value)
(defstruct (child (:include root)) other)
(defstruct (leaf (:include child)) last)
(defstruct unrelated value)

(defgeneric describe-root (object))
(defmethod describe-root ((object root)) (root-value object))
(defmethod describe-root ((object leaf))
  (list (call-next-method) (leaf-last object)))

(let* ((object (make-leaf :value (list 1 2) :other "abc" :last 3))
       (copy (copy-structure object)))
  (print (kiln.sys:%primop :structure-instance-p object))
  (print (kiln.sys:%primop :standard-instance-p object))
  (print (mapcar (lambda (type) (typep object type))
                 '(leaf child root empty unrelated structure-object standard-object)))
  (print (eq (class-of object) (find-class 'leaf)))
  (print (describe-root object))
  (print (equalp object copy))
  (setf (slot-value object 'value) (list 4 5))
  (setf (root-value object) (list 6 7))
  (print (slot-value object 'value))
  (print (equalp object copy))
  (print (slot-boundp object 'other))
  (slot-makunbound object 'other)
  (print (slot-boundp (copy-structure object) 'other))
  (setf (child-other object) (vector copy))
  (kiln.sys:%gc)
  (print (root-value (svref (child-other object) 0)))
  (print (handler-case (root-value (make-unrelated)) (type-error () 'checked)))
  (print (handler-case (change-class object 'root) (error () 'checked))))

(print (empty-p (copy-structure (make-empty))))
(print (handler-case (copy-structure 1) (type-error () 'checked)))
(let ((object (allocate-instance (find-class 'root))))
  (print (slot-boundp object 'value))
  (setf (slot-value object 'value) 10)
  (print (root-value object)))

(let ((object (make-instance 'root :value 42)))
  (print (root-value object))
  (print (root-p object)))

(let ((table (make-hash-table :test 'equalp)))
  (setf (gethash (make-root :value (list 1 2)) table) 'found)
  (print (gethash (make-root :value (list 1 2)) table)))

(defun print-visible (object stream)
  (format stream "<~A>" (visible-value object)))
(defstruct (visible (:print-object print-visible)) value)
(print (prin1-to-string (make-visible :value 11)))
