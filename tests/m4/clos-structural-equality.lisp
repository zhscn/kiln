(let* ((a (make-array 5 :element-type 'bit :initial-contents '(1 0 1 0 0) :fill-pointer 3))
       (b (coerce '(1 0 1) 'bit-vector))
       (table (make-hash-table :test 'equal)))
  (print (equal a b))
  (print (equal b (make-array 3 :element-type 'bit :displaced-to a)))
  (setf (gethash a table) :bits)
  (print (gethash b table)))
(dolist (pair (list (list (make-array nil :initial-element 7 :element-type '(unsigned-byte 8))
                          (make-array nil :initial-element 7.0))
                   (list (make-array '(2 2) :initial-contents '((1 2) (3 4)))
                         (make-array '(2 2) :initial-contents '((1.0 2.0) (3.0 4.0))))
                   (list (make-array 5 :fill-pointer 3 :initial-contents '(1 2 3 4 5))
                         (vector 1.0 2.0 3.0))))
  (let ((table (make-hash-table :test 'equalp)))
    (print (equalp (first pair) (second pair)))
    (setf (gethash (first pair) table) :array)
    (print (gethash (second pair) table))))
(dolist (test '(eq eql equal equalp))
  (let ((a (make-hash-table :test test :size 16))
        (b (make-hash-table :test test :size 101))
        (outer (make-hash-table :test 'equalp)))
    (dotimes (i 32) (setf (gethash (* i 17) a) (vector #\a i)))
    (dotimes (i 32)
      (let ((j (- 31 i)))
        (setf (gethash (* j 17) b) (vector #\A (float j)))))
    (print (equalp a b))
    (setf (gethash a outer) :table)
    (print (gethash b outer))
    (setf (gethash 0 b) nil)
    (print (equalp a b))))
(let ((a (make-hash-table)) (b (make-hash-table)))
  (setf (gethash :a a) nil (gethash :b b) nil)
  (print (equalp a b)))
(print (equalp (make-array '(1 2) :initial-element 0)
               (make-array '(2 1) :initial-element 0)))
