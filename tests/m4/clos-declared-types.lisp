(defun declared-byte (value)
  (declare (type (unsigned-byte 8) value))
  (+ value value))
(print (declared-byte 255))
(print (handler-case (declared-byte 256) (type-error () 'type-error)))
(print (handler-case (declared-byte "bad") (type-error () 'type-error)))

(defun declared-fixnum (value)
  (declare (fixnum value))
  (+ value 1))
(print (declared-fixnum 4611686018427387903))
(print (handler-case (declared-fixnum 4611686018427387904) (type-error () 'type-error)))

;;; Declarations apply to binding identities, not names outside their scope.
(let ((value 3))
  (locally (declare (fixnum value)) (print (+ value 1)))
  (setq value 1d0)
  (print (= (+ value 2d0) 3d0)))
(let ((value 2))
  (declare (fixnum value))
  (let ((value "inner")) (print (length value)))
  (print (+ value 1)))

(defun declared-intersection (value)
  (declare (integer value))
  (locally (declare (type (unsigned-byte 8) value)) (+ value 1)))
(print (declared-intersection 42))
(print (handler-case (declared-intersection -1) (type-error () 'type-error)))

(defun declared-default (first &optional (second (+ first 1)))
  (declare (fixnum first))
  second)
(print (declared-default 8))
(print (handler-case (declared-default "bad") (type-error () 'type-error)))
(let* ((first 4) (second (+ first 1)))
  (declare (fixnum first))
  (print second))

(defun declared-vector (value index)
  (declare (simple-vector value) (fixnum index))
  (aref value index))
(print (declared-vector #(10 20) 1))
(print (handler-case (declared-vector nil 0) (type-error () 'type-error)))
(print (handler-case (declared-vector #(10) 1) (error () 'bounds)))

(defun declared-cons (value)
  (declare (cons value))
  (list (car value) (cdr value)))
(print (declared-cons '(1 . 2)))
(print (handler-case (declared-cons nil) (type-error () 'type-error)))
(defun declared-character (value)
  (declare (character value))
  (char-code value))
(print (declared-character #\λ))
(print (handler-case (declared-character nil) (type-error () 'type-error)))

;;; The writer lives outside the declaration's scope; the next read checks it.
(let ((value 1))
  (let ((writer (lambda () (setq value "changed"))))
    (print (locally (declare (fixnum value)) (+ value 1)))
    (funcall writer)
    (print (handler-case (locally (declare (fixnum value)) (+ value 1))
             (type-error () 'type-error)))))

;;; A failed write preserves the checked binding, including closure cells.
(let ((value 3))
  (declare (fixnum value))
  (let ((writer (lambda (new) (setq value new))))
    (print (funcall writer 4))
    (print (handler-case (funcall writer "bad") (type-error () 'type-error)))
    (print value)))
(defun declared-optional (&optional (value 7) (next (+ value 1)))
  (declare (fixnum value next))
  (list value next))
(print (declared-optional))
(print (declared-optional 9))
(print (handler-case (declared-optional "bad") (type-error () 'type-error)))
(let ((value 4611686018427387903))
  (declare (fixnum value))
  (print (handler-case (incf value)
           (type-error (condition) (type-error-datum condition))))
  (print value))
(defun declared-arithmetic-write (value other operation)
  (declare (fixnum value other))
  (handler-case
      (case operation
        (+ (setq value (+ value other)))
        (- (setq value (- value other)))
        (* (setq value (* value other)))
        (1- (setq value (1- value))))
    (type-error (condition) (list (type-error-datum condition) value))))
(print (declared-arithmetic-write 2 3 '+))
(print (declared-arithmetic-write 2 3 '-))
(print (declared-arithmetic-write 2 3 '*))
(print (declared-arithmetic-write -4611686018427387904 1 '-))
(print (declared-arithmetic-write -4611686018427387904 1 '1-))
(print (declared-arithmetic-write 4611686018427387903 2 '*))
(defun declared-compared-step (value limit)
  (declare (fixnum value limit))
  (if (< value limit) (1+ value) (1- limit)))
(print (declared-compared-step 4611686018427387902 4611686018427387903))
(print (declared-compared-step -4611686018427387904 -4611686018427387904))
(defun declared-comparison-effects (value)
  (declare (fixnum value))
  (if (< value (setq value 4611686018427387903)) (1+ value) nil))
(print (declared-comparison-effects 0))
