;;; Streams (Cyclosis).

(defun show (object) (write-line (prin1-to-string object)))

(write-string "hello")
(write-char #\Space)
(write-line "world")
(terpri)
(show (with-output-to-string (s)
         (write-string "abc" s)
         (write-char #\d s)
         (terpri s)
         (write-string "xyz" s :start 1)))
(let ((s (make-string-output-stream)))
  (write-string "one" s)
  (show (get-output-stream-string s))
  (write-string "two" s)
  (show (get-output-stream-string s)))
(with-input-from-string (in "line 1
line 2
end")
  (show (string (read-line in)))
  (show (read-char in))
  (show (peek-char nil in))
  (show (string (read-line in)))
  (let ((l (multiple-value-list (read-line in)))) (show (list (string (first l)) (second l))))
  (show (read-line in nil :eof)))
(show (streamp *standard-output*))
(show (output-stream-p *standard-output*))
(show (input-stream-p *standard-output*))
(show (typep (make-string-output-stream) 'string-stream))
(let ((b (make-broadcast-stream (make-string-output-stream) (make-string-output-stream))))
  (write-string "both" b)
  (show (mapcar #'get-output-stream-string (broadcast-stream-streams b))))
(let ((c (make-concatenated-stream (make-string-input-stream "ab")
                                   (make-string-input-stream "cd"))))
  (show (list (read-char c) (read-char c) (read-char c) (read-char c)
               (read-char c nil :eof))))
(fresh-line)
(write-string "fresh")
(fresh-line)
(fresh-line)
(write-line "unicode: λ→✓")
(write-string "to stderr" *error-output*)
(terpri *error-output*)
(show (handler-case (read-char (make-string-input-stream "")) (end-of-file () 'eof)))
(let ((source (make-string 257 :initial-element #\λ)))
  (with-input-from-string (in (concatenate 'string (string #\Newline) source))
    (multiple-value-bind (line missing-newline-p) (read-line in)
      (show (and (typep line 'simple-string) (zerop (length line)) (not missing-newline-p))))
    (multiple-value-bind (line missing-newline-p) (read-line in)
      (show (and (typep line 'simple-string) missing-newline-p
                 (= (length line) 257) (char= (schar line 256) #\λ)
                 (string= line source))))
    (show (multiple-value-list (read-line in nil :eof)))))
(let ((source (make-array 6 :element-type 'character :fill-pointer 4
                          :initial-contents '(#\x #\λ #\→ #\y #\z #\!))))
  (fresh-line)
  (write-sequence source *standard-output* :start 1 :end 3)
  (write-sequence source *standard-output* :start 2 :end 2)
  (fresh-line)
  (show (eq (write-sequence source *standard-output* :start 4) source)))

(let ((source (format nil "~%xλ~%z~%")))
  (assert (string= (with-output-to-string (stream)
                     (assert (eq (write-sequence source stream :start 2 :end 5) source))
                     (assert (= (file-position stream) 3))
                     (assert (= (cyclosis:stream-line-column stream) 1))
                     (write-sequence source stream :start 5 :end 5)
                     (assert (= (cyclosis:stream-line-column stream) 1)))
                   (format nil "λ~%z"))))

(let ((string (copy-seq "λbcde")))
  (assert (eq (replace string string :start1 1 :end2 4) string))
  (assert (string= string "λλbcd"))
  (replace string string :start2 1)
  (assert (string= string "λbcdd")))

(let* ((piece (format nil "λ~%"))
       (actual (with-output-to-string (stream)
                 (dotimes (i 128) (write-sequence piece stream))
                 (assert (= (file-position stream) 256))
                 (assert (zerop (cyclosis:stream-line-column stream))))))
  (assert (= (length actual) 256))
  (dotimes (i 128)
    (assert (char= (char actual (* i 2)) #\λ))
    (assert (char= (char actual (1+ (* i 2))) #\Newline))))
