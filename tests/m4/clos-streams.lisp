;;; Streams (Cyclosis).

(write-string "hello")
(write-char #\Space)
(write-line "world")
(terpri)
(print (with-output-to-string (s)
         (write-string "abc" s)
         (write-char #\d s)
         (terpri s)
         (write-string "xyz" s :start 1)))
(let ((s (make-string-output-stream)))
  (write-string "one" s)
  (print (get-output-stream-string s))
  (write-string "two" s)
  (print (get-output-stream-string s)))
(with-input-from-string (in "line 1
line 2
end")
  (print (string (read-line in)))
  (print (read-char in))
  (print (peek-char nil in))
  (print (string (read-line in)))
  (let ((l (multiple-value-list (read-line in)))) (print (list (string (first l)) (second l))))
  (print (read-line in nil :eof)))
(print (streamp *standard-output*))
(print (output-stream-p *standard-output*))
(print (input-stream-p *standard-output*))
(print (typep (make-string-output-stream) 'string-stream))
(let ((b (make-broadcast-stream (make-string-output-stream) (make-string-output-stream))))
  (write-string "both" b)
  (print (mapcar #'get-output-stream-string (broadcast-stream-streams b))))
(let ((c (make-concatenated-stream (make-string-input-stream "ab")
                                   (make-string-input-stream "cd"))))
  (print (list (read-char c) (read-char c) (read-char c) (read-char c)
               (read-char c nil :eof))))
(fresh-line)
(write-string "fresh")
(fresh-line)
(fresh-line)
(write-line "unicode: λ→✓")
(write-string "to stderr" *error-output*)
(terpri *error-output*)
(print (handler-case (read-char (make-string-input-stream "")) (end-of-file () 'eof)))
