;;; Streams (Cyclosis).

(defun show (object) (write-line (prin1-to-string object)))

(write-string "hello")
(write-char #\Space)
(write-line "world")
(terpri)
(show (with-output-to-string (s)
         (write-string "abc" s)
         (write-char #\d s)
         (terpri s)
         (write-string "xyz" s :start 1)))
(let ((s (make-string-output-stream)))
  (write-string "one" s)
  (show (get-output-stream-string s))
  (write-string "two" s)
  (show (get-output-stream-string s)))
(with-input-from-string (in "line 1
line 2
end")
  (show (string (read-line in)))
  (show (read-char in))
  (show (peek-char nil in))
  (show (string (read-line in)))
  (let ((l (multiple-value-list (read-line in)))) (show (list (string (first l)) (second l))))
  (show (read-line in nil :eof)))
(show (streamp *standard-output*))
(show (output-stream-p *standard-output*))
(show (input-stream-p *standard-output*))
(show (typep (make-string-output-stream) 'string-stream))
(let ((b (make-broadcast-stream (make-string-output-stream) (make-string-output-stream))))
  (write-string "both" b)
  (show (mapcar #'get-output-stream-string (broadcast-stream-streams b))))
(let ((c (make-concatenated-stream (make-string-input-stream "ab")
                                   (make-string-input-stream "cd"))))
  (show (list (read-char c) (read-char c) (read-char c) (read-char c)
               (read-char c nil :eof))))
(fresh-line)
(write-string "fresh")
(fresh-line)
(fresh-line)
(write-line "unicode: λ→✓")
(write-string "to stderr" *error-output*)
(terpri *error-output*)
(show (handler-case (read-char (make-string-input-stream "")) (end-of-file () 'eof)))
