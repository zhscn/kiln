(deftype two-letters () '(member #\a #\b))
(dolist (type '(character base-char standard-char two-letters))
  (let ((text (make-string 3 :element-type type :initial-element #\a)))
    (print (list (stringp text) (length text) (char text 0) (char text 2)))))
(print (length (make-string 0 :element-type 'base-char)))
(print (every (lambda (code)
                (let ((character (code-char code)))
                  (or (graphic-char-p character)
                      (let ((name (char-name character)))
                        (and name (eql (name-char name) character))))))
              (loop for code below 160 collect code)))
(print (mapcar (lambda (code) (char-name (code-char code))) '(1 7 11 27 127 128 133 159)))
(print (list (eql (name-char "Bel") (code-char 7))
             (eql (name-char "Escape") (code-char 27))
             (eql (name-char "Linefeed") #\Newline)))

(print (every (lambda (code)
                (let ((character (code-char code)))
                  (eql character (read-from-string (format nil "~@C" character)))))
              (loop for code below 160 collect code)))
