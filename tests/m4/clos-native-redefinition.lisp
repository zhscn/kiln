;;; Existing structures retain their layout, class, and dispatch stamp.
(defstruct changing first)
(defgeneric old-structure-value (object))
(defmethod old-structure-value ((object changing))
  (slot-value object 'first))
(defvar *old-structure* (make-changing :first 7))
(defvar *old-class* (class-of *old-structure*))
(defstruct changing second third)
(print (eq (class-of *old-structure*) *old-class*))
(print (eq (class-of *old-structure*) (find-class 'changing)))
(print (old-structure-value *old-structure*))
(print (slot-value (copy-structure *old-structure*) 'first))
(print (changing-third (make-changing :second 8 :third 9)))
(kiln.sys:%gc)
(print (old-structure-value *old-structure*))
