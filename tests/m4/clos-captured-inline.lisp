(let ((value 1))
  (flet ((read-value () value))
    (let ((value 9))
      (declare (ignore value))
      (print (list (read-value) (read-value))))))

(let ((state 0))
  (flet ((add-value (n) (setq state (+ state n))))
    (print (list (add-value 2) (add-value 3) state))))

(let ((state 0))
  (flet ((add-value (n) (setq state (+ state n))))
    (let ((observer (lambda () state)))
      (print (list (add-value 2) (add-value 3) (funcall observer))))))

(defvar *saved-captured-function* nil)
(let ((state 0))
  (flet ((add-value (n) (setq state (+ state n))))
    (setq *saved-captured-function* #'add-value)
    (print (list (add-value 2) (add-value 3)))))
(print (funcall *saved-captured-function* 4))

(let ((value 10))
  (flet ((sum-value (delta)
           (let ((before value))
             (let ((value delta)) (+ before value)))))
    (print (list (sum-value 1) (sum-value 2) value))))

(let ((value 1))
  (flet ((checked-value () (locally (declare (fixnum value)) (+ value 1))))
    (print (checked-value))
    (setq value "bad")
    (print (handler-case (checked-value) (type-error () 'type-error)))))

(defmacro many-captured-calls ()
  `(let ((state 0))
     (flet ((add-value (n) (setq state (+ state n))))
       ,@(loop repeat 100 collect '(add-value 1))
       state)))
(print (many-captured-calls))

(let ((caller (let ((state 0))
                (flet ((add-value (n) (setq state (+ state n))))
                  (lambda (n) (list (add-value n) (add-value n)))))))
  (print (funcall caller 3))
  (print (funcall caller 4)))

(let ((callback #'1+))
  (flet ((call-value (n) (funcall callback n)))
    (print (list (call-value 2) (call-value 3)))))
