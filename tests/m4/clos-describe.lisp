(defclass describe-custom-fixture () ((value :initarg :value :reader describe-fixture-value)))
(defmethod describe-object ((object describe-custom-fixture) stream)
  (format stream "custom description: ~D" (describe-fixture-value object))
  (values :ignored :also-ignored))
(defclass describe-slot-fixture () ((describe-bound :initform 7) describe-unbound))
(let ((object (make-instance 'describe-custom-fixture :value 42)))
  (dolist (designator '(:default nil t :explicit))
    (let ((values :unset))
      (let ((standard-output (make-string-output-stream))
            (terminal-output (make-string-output-stream))
            (explicit-output (make-string-output-stream))
            (terminal-input (make-string-input-stream "X")))
        (let ((*standard-output* standard-output)
              (*terminal-io* (make-two-way-stream terminal-input terminal-output)))
          (setf values (multiple-value-list
                        (case designator
                          (:default (describe object))
                          (:explicit (describe object explicit-output))
                          (otherwise (describe object designator))))))
        (let ((standard (get-output-stream-string standard-output))
              (terminal (get-output-stream-string terminal-output))
              (explicit (get-output-stream-string explicit-output)))
          (print (list values
                       (equal standard (if (member designator '(:default nil))
                                           "custom description: 42" ""))
                       (equal terminal (if (eq designator t) "custom description: 42" ""))
                       (equal explicit (if (eq designator :explicit)
                                           "custom description: 42" ""))
                       (char= (read-char terminal-input) #\X))))))))
(dolist (object (list nil 42 1.5d0 '(a b) "hello" (make-array 1 :element-type nil)
                      (make-hash-table) (make-instance 'describe-slot-fixture)
                      #'car (find-class 'standard-object)))
  (let ((values :unset))
    (let ((output (with-output-to-string (stream)
                    (setf values (multiple-value-list (describe object stream))))))
      (print (list values (plusp (length output)))))))

(let ((table (make-hash-table :test 'eq)))
  (dolist (symbol '(nil t))
    (setf (gethash (symbol-name symbol) table) symbol)
    (multiple-value-bind (value present) (gethash (symbol-name symbol) table)
      (print (list present (eq value symbol))))))
