;;; Pathnames and files.

(defun show-pathname (string)
  (let ((p (pathname string)))
    (format t "~s => ~s ~s ~s ~s | ~s~%" string (pathname-directory p) (pathname-name p)
            (pathname-type p) (pathname-version p) (namestring p))))

(dolist (s '("/a/b/c.lisp" "a/b/" "c" ".bashrc" "foo.tar.gz" "foo." "." "../x/y.z" "./a/b"
             "~/x.y" "/" "" "*.lisp" "/a/**/*.*" "a*b.c" "/a/../b" "a//b" "x.y.z" ".a.b"))
  (show-pathname s))

(format t "~s~%" (list (pathname-version (merge-pathnames "x"))
                       (namestring (merge-pathnames "a/b.c" "/x/y/z.d"))
                       (namestring (merge-pathnames "../b.c" "/x/y/"))
                       (namestring (merge-pathnames (make-pathname :directory '(:relative :back "q"))
                                                    "/x/y/"))
                       (enough-namestring "/a/b/c.d" "/a/")
                       (directory-namestring "/a/b/c.d")
                       (file-namestring "/a/b/c.d")
                       (pathname-match-p "/a/b/c.lisp" "/a/**/*.lisp")
                       (pathname-match-p "/a/b/c.lisp" "/a/*.lisp")
                       (namestring (translate-pathname "/a/b/c.lisp" "/a/**/*.lisp" "/z/**/*.fasl"))
                       (namestring (translate-pathname "foo-bar.lisp" "foo-*.lisp" "baz-*.l"))
                       (wild-pathname-p "a/*.b")
                       (wild-pathname-p "a/b.c")
                       (namestring (make-pathname :name "FOO" :case :common))
                       (pathname-name "foo" :case :common)
                       (namestring (make-pathname :directory '(:absolute "a") :name "x" :type "y"))
                       (namestring (make-pathname :type "fasl" :defaults "/a/b.lisp"))))

;;; Pathnames are EQUAL by components, also as hash keys; they print as #P.
(let ((table (make-hash-table :test 'equal)))
  (setf (gethash (pathname "/a/b.c") table) 1)
  (format t "~s ~s ~s ~s~%"
          (equal (pathname "/a/b.c") (pathname "/a/b.c"))
          (equal (pathname "/a/b.c") (pathname "/a/b.d"))
          (gethash (pathname "/a/b.c") table)
          (pathnamep (pathname "x"))))
(prin1 (pathname "/a/b.c"))
(terpri)
(princ (pathname "/a/b.c"))
(terpri)

;;; Logical pathnames.
(setf (logical-pathname-translations "KTEST")
      '(("SRC;**;*.*.*" "/src/kiln/**/*.*")
        ("**;*.*.*" "/other/**/*.*")))
(let ((p (pathname "KTEST:SRC;A;B;FOO.LISP")))
  (format t "~s ~s ~s ~s~%" (pathname-host p) (pathname-directory p) (pathname-name p)
          (namestring p))
  (format t "~s~%" (namestring (translate-logical-pathname p)))
  (format t "~s~%" (namestring (translate-logical-pathname "KTEST:X;Y.Z"))))

;;; Files, in a directory of the build tree.
(defvar *dir* "build/test/files-tmp/")
(ensure-directories-exist *dir*)
(defun tmp (name) (merge-pathnames name *dir*))
(dolist (name '("a.txt" "b.txt" "c.bin" "big.txt" "moved.txt" "t.txt"))
  (when (probe-file (tmp name))
    (delete-file (tmp name))))

(with-open-file (s (tmp "a.txt") :direction :output)
  (write-line "first line" s)
  (format s "second ~a~%" 2)
  (write-string "héllo, 世界" s)
  (terpri s))
(with-open-file (s (tmp "a.txt"))
  (format t "~s~%" (loop for line = (read-line s nil) while line collect line))
  (format t "length ~s~%" (file-length s)))
(with-open-file (s (tmp "a.txt") :direction :output :if-exists :append)
  (write-line "appended" s))
(with-open-file (s (tmp "a.txt"))
  (format t "~s~%" (loop for line = (read-line s nil) while line collect line)))
(handler-case (open (tmp "a.txt") :direction :output)
  (file-error (c) (format t "~a~%" (type-of c))))
(handler-case (open (tmp "missing.txt"))
  (file-error (c) (format t "~a~%" (type-of c))))
(format t "~s~%" (open (tmp "missing.txt") :if-does-not-exist nil))
(with-open-file (s (tmp "a.txt") :direction :output :if-exists :supersede)
  (write-string "new" s))
(with-open-file (s (tmp "a.txt"))
  (format t "~s ~s~%" (read-line s) (file-position s))
  (file-position s 1)
  (format t "~s~%" (read-char s)))

;;; Binary files.
(with-open-file (s (tmp "c.bin") :direction :output :element-type '(unsigned-byte 8))
  (dotimes (i 300) (write-byte (mod i 256) s)))
(with-open-file (s (tmp "c.bin") :element-type '(unsigned-byte 8))
  (format t "~s ~s~%" (file-length s)
          (loop for b = (read-byte s nil) while b sum b)))

;;; More than the buffer.
(with-open-file (s (tmp "big.txt") :direction :output)
  (dotimes (i 5000) (format s "line ~d~%" i)))
(with-open-file (s (tmp "big.txt"))
  (let ((count 0) (last nil))
    (loop for line = (read-line s nil) while line do (incf count) (setf last line))
    (format t "~s ~s~%" count last)))

;;; The file system.
(format t "~s ~s~%" (not (null (probe-file (tmp "a.txt")))) (probe-file (tmp "missing.txt")))
(format t "~s~%" (integerp (file-write-date (tmp "a.txt"))))
;;; The new name is merged with the old one.
(rename-file (tmp "big.txt") "moved.txt")
(format t "~s~%" (mapcar #'file-namestring (directory (merge-pathnames "*.*" *dir*))))
(format t "~s~%" (mapcar #'file-namestring (directory (merge-pathnames "*.txt" *dir*))))
(format t "~s~%" (equal (truename *dir*) (probe-file *dir*)))
(dolist (name '("a.txt" "c.bin" "moved.txt"))
  (delete-file (tmp name)))
(format t "~s~%" (directory (merge-pathnames "*.*" *dir*)))
