;;; ANSI functions cl-bench found missing: SEARCH and MISMATCH with all
;;; their keywords, GENTEMP, the bitwise operations on integers and bit
;;; arrays, RANDOM and random states.

(defun show (x) (write-line (prin1-to-string x)))

(show (list (search "lo" "hello world") (search "o" "hello world" :from-end t)
             (search "o" "hello world" :start2 5) (search "xo" "hello world" :start1 1 :end2 5)
             (search "abc" "xxABC" :test #'char-equal) (search '(2 3) #(1 2 3 4))
             (search "" "abc") (search "" "abc" :from-end t)
             (search '(1 2) '((0 1) (0 2)) :key (lambda (x) (if (consp x) (second x) x)))))
(show (list (mismatch "abcd" "abxd") (mismatch "abc" "abc") (mismatch "abc" "abcde")
             (mismatch "abcd" "xbcd" :from-end t) (mismatch "xbcd" "abcd" :start1 1 :start2 1)))

(let ((s (gentemp "FOO")))
  (show (list (symbol-package s) (eq s (find-symbol (symbol-name s)))
               (string= "FOO" (subseq (symbol-name s) 0 3)) (eq s (gentemp "FOO")))))

(show (list (logeqv 12 10) (lognand 12 10) (lognor 12 10) (logandc1 12 10) (logandc2 12 10)
             (logorc1 12 10) (logorc2 12 10) (logcount 13) (logcount -8)
             (boole boole-xor 12 10) (boole boole-andc2 12 10) (boole boole-1 12 10)))
(defun bits (&rest bits) (make-array (length bits) :element-type 'bit :initial-contents bits))
(let ((a (bits 1 1 0 0)) (b (bits 1 0 1 0)))
  (show (list (bit-and a b) (bit-ior a b) (bit-xor a b) (bit-eqv a b) (bit-nand a b)
               (bit-nor a b) (bit-andc1 a b) (bit-andc2 a b) (bit-orc1 a b) (bit-orc2 a b)
               (bit-not a)))
  (let ((r (make-array 4 :element-type 'bit)))
    (show (list (eq r (bit-xor a b r)) r)))
  (let ((c (copy-seq a)))
    (bit-not c t)
    (show c))
  (show (list (subseq a 1) (reverse a) (remove 0 a) (typep (copy-seq a) 'simple-bit-vector)))
  (show (bit-and (make-array '(2 2) :element-type 'bit :initial-contents '((1 1) (0 1)))
                  (make-array '(2 2) :element-type 'bit :initial-contents '((1 0) (1 1))))))

(let ((s1 (make-random-state nil)) (s2 (make-random-state nil)))
  (show (list (random-state-p s1) (typep s1 'random-state)
               (equal (loop repeat 10 collect (random 1000 s1))
                      (loop repeat 10 collect (random 1000 s2)))))
  (show (every (lambda (n) (and (integerp n) (<= 0 n 9))) (loop repeat 200 collect (random 10))))
  (show (= 10 (length (remove-duplicates (loop repeat 500 collect (random 10))))))
  (let ((big (random (expt 10 30))))
    (show (and (integerp big) (< -1 big (expt 10 30)))))
  (show (every (lambda (x) (and (typep x 'single-float) (<= 0 x) (< x 2.5)))
                (loop repeat 100 collect (random 2.5))))
  (show (every (lambda (x) (and (typep x 'double-float) (<= 0 x) (< x 1d0)))
                (loop repeat 100 collect (random 1d0))))
  (show (handler-case (random -1) (type-error () 'type-error)))
  (show (random-state-p (make-random-state t))))
