(declaim (optimize (safety 3)))
(let ((z (complex 1.0 -0.0)))
  (print (= z z))
  (print (/= z))
  (print (not (/= z z)))
  (print (not (zerop z)))
  (print (eql (+ z) z))
  (print (eql (* z) z))
  (print (eql (funcall #'+ z) z))
  (print (eql (funcall #'* z) z))
  (print (funcall #'= z)))
(print (eql (- 0.0) -0.0))
(print (eql (- -0.0d0) 0.0d0))
(print (eql (conjugate (complex 0.0 0.0)) (complex 0.0 -0.0)))
(print (eql (- (complex 1.0 0.0)) (complex -1.0 -0.0)))
(print (= (- most-negative-fixnum) (1+ most-positive-fixnum)))
(dolist (f (list (lambda () (funcall #'max 'bad))
                       (lambda () (funcall #'min 'bad))
                       (lambda () (funcall #'< (complex 1 2)))
                       (lambda () (funcall #'= 'bad))
                       (lambda () (funcall #'/= 1 1 'bad))))
  (print (handler-case (progn (funcall f) nil) (type-error () t))))

(print (eql (coerce 1.0d0 'single-float) 1.0))
(print (eql (phase -1) (coerce pi 'single-float)))
(let ((zero (complex 0.0 -0.0)))
  (print (eql (signum zero) zero)))
(let ((z (complex 1.0 0.0)))
  (print (eql (- 0 z) (- z))))
(let ((x 0)) (print (incf x (setf x 1))) (print x))
(let ((x 0)) (print (decf x (setf x 1))) (print x))

(defun unchecked-declared-increment (n)
  (declare (fixnum n) (optimize (speed 3) (safety 0)))
  (let ((result (1+ n)))
    (declare (fixnum result))
    result))

(defun checked-declared-increment (n)
  (declare (fixnum n) (optimize (speed 3) (safety 3)))
  (let ((result (1+ n)))
    (declare (fixnum result))
    result))

(assert (= (unchecked-declared-increment (1- most-positive-fixnum))
           most-positive-fixnum))
(assert (= (checked-declared-increment (1- most-positive-fixnum))
           most-positive-fixnum))
(assert (handler-case (progn (checked-declared-increment most-positive-fixnum) nil)
          (type-error (condition)
            (= (type-error-datum condition) (1+ most-positive-fixnum)))))

(defun compare-fixnum-with-decrement (a b)
  (declare (fixnum a b) (optimize (speed 3) (safety 3)))
  (let ((limit (1- b)))
    (list (<= a limit) (< limit a) (= a limit) (/= limit a))))

(defun compare-fixnum-with-increment (a b)
  (declare (fixnum a b) (optimize (speed 3) (safety 3)))
  (let ((limit (1+ b)))
    (list (<= a limit) (< limit a) (= a limit) (/= limit a))))

(assert (equal (compare-fixnum-with-decrement most-negative-fixnum most-negative-fixnum)
               '(nil t nil t)))
(assert (equal (compare-fixnum-with-increment most-positive-fixnum most-positive-fixnum)
               '(t nil nil t)))
(assert (equal (compare-fixnum-with-decrement 1 2) '(t nil t nil)))
(assert (equal (compare-fixnum-with-increment 2 1) '(t nil t nil)))

(defun masked-arithmetic (a b)
  (declare (fixnum a b) (optimize (speed 3) (safety 3)))
  (logand 255 (+ (* a b) (1- a))))

(defun observed-masked-arithmetic (a b flag)
  (declare (fixnum a b) (optimize (speed 3) (safety 3)))
  (let ((sum (+ a b)))
    (if flag sum (logand 255 sum))))

(dolist (a (list most-negative-fixnum most-positive-fixnum -1 0 1))
  (dolist (b (list most-negative-fixnum most-positive-fixnum -1 0 1))
    (assert (= (masked-arithmetic a b)
               (locally (declare (notinline logand))
                 (logand 255 (+ (* a b) (1- a))))))
    (assert (= (observed-masked-arithmetic a b t) (+ a b)))
    (assert (= (observed-masked-arithmetic a b nil) (logand 255 (+ a b))))))
