(declaim (optimize (safety 3)))
(let ((z (complex 1.0 -0.0)))
  (print (= z z))
  (print (/= z))
  (print (not (/= z z)))
  (print (not (zerop z)))
  (print (eql (+ z) z))
  (print (eql (* z) z))
  (print (eql (funcall #'+ z) z))
  (print (eql (funcall #'* z) z))
  (print (funcall #'= z)))
(print (eql (- 0.0) -0.0))
(print (eql (- -0.0d0) 0.0d0))
(print (eql (conjugate (complex 0.0 0.0)) (complex 0.0 -0.0)))
(print (eql (- (complex 1.0 0.0)) (complex -1.0 -0.0)))
(print (= (- most-negative-fixnum) (1+ most-positive-fixnum)))
(dolist (f (list (lambda () (funcall #'max 'bad))
                       (lambda () (funcall #'min 'bad))
                       (lambda () (funcall #'< (complex 1 2)))
                       (lambda () (funcall #'= 'bad))
                       (lambda () (funcall #'/= 1 1 'bad))))
  (print (handler-case (progn (funcall f) nil) (type-error () t))))

(print (eql (coerce 1.0d0 'single-float) 1.0))
(print (eql (phase -1) (coerce pi 'single-float)))
(let ((zero (complex 0.0 -0.0)))
  (print (eql (signum zero) zero)))
(let ((z (complex 1.0 0.0)))
  (print (eql (- 0 z) (- z))))
(let ((x 0)) (print (incf x (setf x 1))) (print x))
(let ((x 0)) (print (decf x (setf x 1))) (print x))
