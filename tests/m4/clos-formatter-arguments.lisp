(dolist (entry (list (list (formatter "~A") '(1 2 3))
                     (list (formatter "~v%") '(0 :remaining))
                     (list (formatter "~#D") '(7 :remaining))
                     (list (formatter "~A~0^ignored") '(1 2 3))
                     (list (formatter "~A~:*~A") '(1 2 3))
                     (list (formatter "~{~A~^,~}") '((1 2) :remaining))
                     (list (formatter "~?~A") '("~A" (1 2) 3 :remaining))
                     (list (formatter "~@?~A") '("~A" 1 2 :remaining))
                     (list (formatter "~@[~A~]") '(nil :remaining))
                     (list (formatter "~@[~A~]") '(7 :remaining))))
  (let ((result nil))
    (let ((text (with-output-to-string (stream)
                  (setf result (multiple-value-list
                                 (apply (first entry) stream (second entry)))))))
      (print (list text result)))))
