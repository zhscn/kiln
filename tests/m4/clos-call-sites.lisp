;;; Repeated call sites follow class bindings, methods and obsolete instances.
(defun show (x) (write-line (prin1-to-string x)))
(defclass point () ((x :initarg :x :initform 1) (y :initform 2)))
(defun new-point (value) (make-instance 'point :x value))
(show (list (slot-value (new-point 3) 'x) (slot-value (new-point 4) 'y)))
(defclass point () ((y :initform 5) (x :initarg :x :initform 1)))
(show (list (slot-value (new-point 6) 'x) (slot-value (new-point 7) 'y)))
(defmethod initialize-instance :after ((p point) &rest args)
  (declare (ignore args)) (incf (slot-value p 'x) 10))
(show (slot-value (new-point 8) 'x))
(defclass other () ((x :initarg :x)))
(setf (find-class 'point) (find-class 'other))
(show (eq (class-of (new-point 9)) (find-class 'other)))

(defgeneric identify (x))
(defmethod identify ((x integer)) (values :integer x))
(defmethod identify ((x string)) (values :string x))
(defun call-identify (x) (multiple-value-list (identify x)))
(show (list (call-identify 3) (call-identify 4) (call-identify "s")))
(defmethod identify ((x integer)) (values :new x))
(show (list (call-identify 3) (call-identify 4)))
(defmethod identify ((x (eql 3))) :three)
(show (list (call-identify 3) (call-identify 4)))
(remove-method #'identify (find-method #'identify '() (list (clostrophilia::intern-eql-specializer 3))))
(show (call-identify 3))
(setf (fdefinition 'identify) (lambda (x) (values :ordinary x)))
(show (call-identify 3))

(defclass base () ())
(defclass child (base) ())
(defgeneric classify (x))
(defmethod classify ((x base)) :base)
(defmethod classify ((x child)) :child)
(defun call-classify (x) (classify x))
(defvar *old* (make-instance 'child))
(show (list (call-classify *old*) (call-classify *old*)))
(defclass child () ())
(remove-method #'classify (find-method #'classify '() (list (find-class 'child))))
(show (handler-case (call-classify *old*) (error () :no-method)))
(kiln.sys:%gc)
(show (slot-value (new-point 11) 'x))


;;; An explicitly installed callable overrides the standard method history.
(defgeneric overridden (x))
(defmethod overridden ((x integer)) (+ x 1))
(defun call-overridden (x) (overridden x))
(show (list (call-overridden 1) (call-overridden 2) (call-overridden 3)))
(clostrophilia::set-funcallable-instance-function #'overridden (lambda (x) (+ x 100)))
(show (list (call-overridden 1) (call-overridden 2)))
