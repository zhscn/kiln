(defclass allocation-probe () ((x :initarg :x) (y :initform 2)))
(let ((object (allocate-instance (find-class 'allocation-probe))))
  (print (slot-boundp object 'x))
  (print (slot-boundp object 'y))
  (print (eq object (shared-initialize object t :x 1)))
  (print (list (slot-value object 'x) (slot-value object 'y))))

(defclass missing-probe () ())
(defvar *missing-operation* nil)
(defmethod slot-missing (class (object missing-probe) name operation
                        &optional (new-value nil supplied))
  (declare (ignore class object))
  (setf *missing-operation* (list name operation new-value supplied))
  (values *missing-operation* :extra))
(let ((object (make-instance 'missing-probe)))
  (print (slot-value object 'missing))
  (print (setf (slot-value object 'missing) 7))
  (print *missing-operation*)
  (print (eq object (slot-makunbound object 'missing)))
  (print *missing-operation*)
  (print (not (null (slot-boundp object 'missing))))
  (print (length (multiple-value-list (slot-boundp object 'missing)))))

(defgeneric removal-probe (x))
(defmethod removal-probe (x) x)
(defmethod removal-probe ((x integer)) (1+ x))
(defgeneric other-removal-probe (x))
(defmethod other-removal-probe (x) x)
(let ((method (find-method #'other-removal-probe nil (list (find-class t)))))
  (print (eq #'removal-probe (remove-method #'removal-probe method)))
  (print (other-removal-probe :unchanged)))
(let ((method (find-method #'removal-probe nil (list (find-class 'integer)))))
  (print (removal-probe 10))
  (print (eq #'removal-probe (remove-method #'removal-probe method)))
  (print (removal-probe 10)))
