(dolist (preserve '(nil t))
  (dolist (string '("(1 2 3)X" "123  " "  123 x"))
    (print (multiple-value-list
            (read-from-string string t nil :preserve-whitespace preserve)))))
(print (multiple-value-list (read-from-string "xx123  yy" t nil :start 2 :end 7
                                              :preserve-whitespace t)))
(with-input-from-string (stream "éλ")
  (print (file-position stream))
  (let ((char (read-char stream)))
    (print (list (char-code char) (file-position stream)))
    (unread-char char stream)
    (print (file-position stream))
    (print (list (char-code (peek-char nil stream)) (file-position stream)))
    (print (list (char-code (read-char stream)) (file-position stream)))
    (unread-char char stream)
    (file-position stream 1)
    (print (list (char-code (read-char stream)) (file-position stream)))))
(let ((index nil))
  (print (with-input-from-string (stream "ab" :index index)
           (let ((char (read-char stream))) (unread-char char stream))
           :done))
  (print index))
(let ((*readtable* (copy-readtable)))
  (set-macro-character #\? (lambda (stream char) (declare (ignore stream char)) 17))
  (print (multiple-value-list (read-from-string "?!")))
  (print (multiple-value-list (read-from-string "!?"))))
(dolist (mode '(:upcase :downcase :preserve :invert))
  (let ((table (copy-readtable)))
    (print (setf (readtable-case table) mode))
    (print (readtable-case table))))
(dolist (object '(nil 0 #\a "bad" (a b)))
  (print (handler-case (readtable-case object)
           (type-error (condition) (eq object (type-error-datum condition)))))
  (print (handler-case (setf (readtable-case object) :upcase)
           (type-error (condition) (eq object (type-error-datum condition)))))
  (let ((table (copy-readtable)))
    (print (handler-case (setf (readtable-case table) object)
             (type-error (condition) (eq object (type-error-datum condition)))))
    (print (readtable-case table))))
