(declaim (optimize (safety 3)))

;; ELT uses the active sequence length, including a vector's fill pointer.
(dolist (f (list (lambda () (elt nil 0))
                (lambda () (elt '(a b) -1))
                (lambda () (elt '(a b) 2))
                (lambda () (setf (elt (vector 1 2) 2) 3))
                (lambda () (elt (make-array 4 :fill-pointer 2) 3))))
  (print (handler-case (progn (funcall f) nil) (type-error () t))))
(let ((seen nil))
  (print (count 2 #(1 2 3 4) :from-end t
                :key (lambda (x) (push x seen) x)))
  (print seen))
(print (count-if #'oddp '(1 2 3 4 5) :start 1 :end 4 :from-end t))
(print (count-if-not #'oddp #(1 2 3 4) :from-end t))
(print (remove 'a '(a b a c a) :from-end t :count 1))
(print (remove-if #'oddp #(1 2 3 4 5) :from-end t :count 2))
(let* ((x (vector 1 2 1 3)) (result (nsubstitute 9 1 x :count nil)))
  (print (eq x result))
  (print x))
(let ((x (copy-seq "ababa")))
  (print (nsubstitute #\x #\a x :from-end t :count 2))
  (print x))
(let ((x (list 1 2 3 4)))
  (print (nsubstitute-if-not 0 #'oddp x :count 1 :from-end t))
  (print x))
(let ((x (list 1 2 3)))
  (print (substitute-if 0 #'oddp x))
  (print x))
(let ((v (make-array 5 :initial-element 0 :fill-pointer 1)))
  (print (eq v (map-into v #'1+ '(10 20 30))))
  (print (fill-pointer v))
  (print (coerce v 'list))
  (print (aref v 4)))
(let ((s (make-array 4 :element-type 'character :initial-element #\x :fill-pointer 0)))
  (map-into s (lambda () #\a))
  (print (fill-pointer s))
  (print (map 'string #'identity s)))
