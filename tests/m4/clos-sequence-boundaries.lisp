(declaim (optimize (safety 3)))

;; ELT uses the active sequence length, including a vector's fill pointer.
(dolist (f (list (lambda () (elt nil 0))
                (lambda () (elt '(a b) -1))
                (lambda () (elt '(a b) 2))
                (lambda () (setf (elt (vector 1 2) 2) 3))
                (lambda () (elt (make-array 4 :fill-pointer 2) 3))))
  (print (handler-case (progn (funcall f) nil) (type-error () t))))
(let ((seen nil))
  (print (count 2 #(1 2 3 4) :from-end t
                :key (lambda (x) (push x seen) x)))
  (print seen))
(print (count-if #'oddp '(1 2 3 4 5) :start 1 :end 4 :from-end t))
(print (count-if-not #'oddp #(1 2 3 4) :from-end t))
(print (remove 'a '(a b a c a) :from-end t :count 1))
(print (remove-if #'oddp #(1 2 3 4 5) :from-end t :count 2))
(let* ((x (vector 1 2 1 3)) (result (nsubstitute 9 1 x :count nil)))
  (print (eq x result))
  (print x))
(let ((x (copy-seq "ababa")))
  (print (nsubstitute #\x #\a x :from-end t :count 2))
  (print x))
(let ((x (list 1 2 3 4)))
  (print (nsubstitute-if-not 0 #'oddp x :count 1 :from-end t))
  (print x))
(let ((x (list 1 2 3)))
  (print (substitute-if 0 #'oddp x))
  (print x))
(let ((v (make-array 5 :initial-element 0 :fill-pointer 1)))
  (print (eq v (map-into v #'1+ '(10 20 30))))
  (print (fill-pointer v))
  (print (coerce v 'list))
  (print (aref v 4)))
(let ((s (make-array 4 :element-type 'character :initial-element #\x :fill-pointer 0)))
  (map-into s (lambda () #\a))
  (print (fill-pointer s))
  (print (map 'string #'identity s)))
(print (search "xλxq" "abλxλxcd" :start1 1 :end1 3 :start2 2 :end2 7))
(print (search "xλxq" "abλxλxcd" :start1 1 :end1 3 :start2 2 :end2 7 :from-end t))
(print (search "abc" "aaaa"))
(print (search "abc" "ab"))
(print (search "" "abc" :start2 1 :end2 2))
(print (search "" "abc" :start2 1 :end2 2 :from-end t))
(print (search "a" "xA" :test #'char-equal))
(print (search "ab" (make-array 3 :element-type 'character :initial-contents "xab"
                               :fill-pointer 2)))

(let ((vector (make-array 5 :element-type '(unsigned-byte 8)
                            :initial-contents '(2 9 2 9 2) :fill-pointer 4)))
  (assert (= (find 9 vector :test #'= :start 2) 9))
  (assert (= (position 2 vector :test '= :from-end t) 2))
  (assert (null (find -1 vector :test #'=)))
  (assert (null (find-if #'minusp vector :from-end t)))
  (assert (= (find-if #'minusp vector :key #'-) 2))
  (assert (= (find 9d0 vector :test #'=) 9))
  (assert (= (position -2 vector :test #'= :key #'-) 0))
  (assert (handler-case (progn (find-if #'minusp vector :end 5) nil)
            (type-error () t))))
(assert (= (find-if #'minusp (make-array 2 :element-type '(signed-byte 8)
                                           :initial-contents '(3 -3))) -3))
(defun find-in-simple-vector (item array)
  (declare (simple-vector array) (optimize (speed 3) (space 1) (safety 3)))
  (find item array))

(defun position-in-simple-vector (item array)
  (declare (simple-vector array) (optimize (speed 3) (space 1) (safety 3)))
  (position item array :test #'eq))

(let* ((number (1+ most-positive-fixnum))
       (other (+ number 0))
       (array (vector :first other other)))
  (assert (eq (find-in-simple-vector number array) other))
  (assert (eql (position-in-simple-vector other array) 1))
  (assert (null (position-in-simple-vector :absent array)))
  (assert (null (find-in-simple-vector number #()))))

(locally (declare (optimize (speed 3) (space 1) (safety 3)))
  (assert (handler-case (progn (evenp :not-an-integer) nil)
            (type-error () t))))
