(defun transcript-text (pathname)
  (with-open-file (stream pathname)
    (with-output-to-string (output)
      (loop for char = (read-char stream nil nil)
            while char do (write-char char output)))))
(let ((reporter *standard-output*)
      (first "build/test/dribble-first.log")
      (second "build/test/dribble-second.log"))
  (unwind-protect
       (progn
         (dolist (path (list first second)) (when (probe-file path) (delete-file path)))
         (let* ((input (make-string-input-stream "ab"))
                (output (make-string-output-stream))
                (errors (make-string-output-stream))
                (*standard-input* input) (*standard-output* output) (*error-output* errors)
                (started nil) (stopped nil))
           (unwind-protect
                (progn
                  (setf started (multiple-value-list (dribble first)))
                  (let ((char (read-char))) (unread-char char *standard-input*) (read-char))
                  (write-string "OUT")
                  (write-string "ERR" *error-output*)
                  (setf stopped (multiple-value-list (dribble))))
             (when #+kiln kiln.kernel::*dribble-stream* #+sbcl sb-impl::*dribble-stream*
               (dribble)))
           (let ((restored (and (eq input *standard-input*) (eq output *standard-output*)
                                (eq errors *error-output*))))
             (let ((result (list (null started) (null stopped) restored
                                 (get-output-stream-string output)
                                 (get-output-stream-string errors))))
               (write result :stream reporter)
               (terpri reporter))))
         (print (transcript-text first))
         (let* ((output (make-string-output-stream))
                (*standard-input* (make-string-input-stream "ab"))
                (*standard-output* output) (*error-output* output))
           (dribble first)
           (read-char)
           (write-string "outer-")
           (dribble second)
           (read-char)
           (write-string "inner")
           (dribble)
           (write-string "-tail")
           (dribble))
         (print (transcript-text first))
         (print (transcript-text second))
         (print (handler-case (dribble) (error () :inactive))))
    (when #+kiln kiln.kernel::*dribble-stream* #+sbcl sb-impl::*dribble-stream* (dribble))
    (dolist (path (list first second)) (when (probe-file path) (delete-file path)))))
