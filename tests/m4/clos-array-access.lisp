;;; One-index access must use the dimension and follow current displacement.
(let* ((base (make-array 6 :element-type 'single-float :initial-element 1f0))
       (middle (make-array 4 :element-type 'single-float
                           :displaced-to base :displaced-index-offset 1))
       (view (make-array 2 :element-type 'single-float :fill-pointer 0
                         :displaced-to middle :displaced-index-offset 1)))
  (print (= (setf (aref view 1) 7f0) 7f0))
  (print (= (aref base 3) 7f0))
  (print (= (aref view 1) 7f0))
  (print (zerop (length view)))
  (print (handler-case (progn (setf (aref view 0) 7d0) nil)
           (type-error () t)))
  (print (= (aref base 2) 1f0)))

(let ((array (make-array 2 :element-type '(unsigned-byte 8)
                         :adjustable t :initial-element 4)))
  (adjust-array array 4 :initial-element 9)
  (print (aref array 3))
  (dolist (index '(-1 4 1/2 #\a 100000000000000000000))
    (print (handler-case (progn (aref array index) nil) (error () t)))
    (print (handler-case (progn (setf (aref array index) 3) nil) (error () t)))))

;;; Rank checks apply even when a row-major index would be in bounds.
(dolist (array (list (make-array nil :initial-element 0)
                    (make-array '(1 2) :initial-element 0)
                    (make-array 0 :element-type nil)))
  (print (handler-case (progn (aref array 0) nil) (error () t)))
  (print (handler-case (progn (setf (aref array 0) nil) nil) (error () t))))

(let ((array (make-array 1 :element-type 'base-char :initial-element #\a)))
  (assert (char= (schar array 0) #\a))
  (dolist (index '(-1 1 :invalid))
    (assert (handler-case (progn (schar array index) nil)
              (type-error () t))))
  (dolist (other (list (make-array 1 :element-type 'base-char :adjustable t)
                       (make-array 1 :element-type 'base-char :fill-pointer 1)
                       (make-array 1 :element-type 'base-char :displaced-to array)))
    (assert (handler-case (progn (schar other 0) nil)
              (type-error () t))))
  (print (char= (aref array 0) #\a))
  (print (handler-case (progn (setf (aref array 0) #\λ) nil) (type-error () t)))
  (print (char= (aref array 0) #\a)))

(defconstant +byte-table+ (make-array 3 :element-type '(unsigned-byte 8)
                                       :initial-contents '(1 2 255)))

(let* ((source (make-array 3 :element-type 'base-char :fill-pointer 2
                             :initial-contents '(#\a #\b #\c)))
       (copy (coerce source '(simple-base-string 2))))
  (assert (typep copy 'simple-base-string))
  (assert (string= copy "ab"))
  (setf (char source 0) #\z)
  (assert (string= copy "ab"))
  (assert (eq copy (coerce copy 'simple-base-string)))
  (assert (handler-case (progn (coerce source '(simple-base-string 3)) nil)
            (type-error () t))))

(let* ((base (make-array 2 :element-type 'base-char :adjustable t :fill-pointer 0))
       (view (make-array 1 :element-type 'base-char :displaced-to base
                           :displaced-index-offset 1 :fill-pointer 0)))
  (assert (= 0 (vector-push-extend #\a base)))
  (assert (handler-case (progn (vector-push-extend #\λ base) nil)
            (type-error () t)))
  (assert (= 1 (fill-pointer base)))
  (assert (= 0 (vector-push-extend #\b view)))
  (assert (char= #\b (aref base 1)))
  (assert (= 1 (vector-push-extend #\b base)))
  (assert (= 2 (vector-push-extend #\c base 1)))
  (assert (string= base "abc")))
(defmacro last-byte-at-compile-time ()
  (aref +byte-table+ 2))
(defun last-byte-at-runtime ()
  (aref +byte-table+ 2))
(print (and (equal (array-element-type +byte-table+) '(unsigned-byte 8))
            (= (last-byte-at-compile-time) (last-byte-at-runtime) 255)))

;; ELT uses the fill pointer even when AREF can reach the underlying slot.
(dolist (type '(single-float double-float))
  (let* ((one (coerce 1 type))
         (two (coerce 2 type))
         (base (make-array 3 :element-type type :initial-element one))
         (direct (make-array 3 :element-type type :initial-element one :fill-pointer 1))
         (view (make-array 2 :element-type type :displaced-to base
                             :displaced-index-offset 1 :fill-pointer 1)))
    (print (and (= (setf (elt direct 0) two) (elt direct 0) two)
                (= (aref direct 1) one)
                (handler-case (progn (setf (elt direct 1) two) nil)
                  (type-error () t))
                (= (setf (elt view 0) two) (elt view 0) (aref base 1) two)
                (handler-case (progn (elt view 1) nil)
                  (type-error () t))))))

(let* ((type (upgraded-array-element-type '(integer 0 1000)))
       (base (make-array 3 :element-type type :initial-element 0 :fill-pointer 1))
       (view (make-array 1 :element-type type :displaced-to base :displaced-index-offset 2)))
  (assert (= (setf (aref base 2) 1000) (aref view 0) 1000))
  (assert (handler-case (progn (setf (aref base 2) -1) nil) (type-error () t)))
  (assert (= (aref base 2) 1000)))

(let ((array (make-array 1 :element-type '(unsigned-byte 8) :initial-element 0 :adjustable t)))
  (assert (= (setf (aref array 0) 255) 255))
  (dolist (value (list 256 -1 255d0 (1+ most-positive-fixnum)))
    (assert (handler-case (progn (setf (aref array 0) value) nil) (type-error () t)))
    (assert (= (aref array 0) 255))))

(let* ((array (make-array '(2 3 4) :element-type '(unsigned-byte 8) :initial-element 17))
       (view (make-array '(2 2) :element-type '(unsigned-byte 8)
                               :displaced-to array :displaced-index-offset 5))
       (bits (make-array '(2 3) :element-type 'bit :initial-element 0))
       (empty (make-array '(2 0 4)))
       (scalar (make-array nil :initial-element nil)))
  (assert (null (aref scalar)))
  (assert (= 31 (setf (aref array 1 2 3) 31)))
  (assert (= 31 (row-major-aref array 23)))
  (assert (= 52 (setf (aref view 1 0) 52)))
  (assert (= 52 (aref array 0 1 3)))
  (assert (= 1 (setf (aref bits 1 2) 1)))
  (assert (and (= 1 (aref bits 1 2)) (zerop (aref bits 0 0))))
  (assert (handler-case (progn (setf (aref array 1 2 3) 256) nil) (type-error () t)))
  (dolist (subscripts '((0 0 4) (0 0) (0 -1 0) (0 0 1/2)))
    (assert (handler-case (progn (apply #'aref array subscripts) nil) (error () t))))
  (assert (handler-case (progn (aref empty 0 0 0) nil) (error () t))))

(let ((matrix (make-array '(2 3) :element-type '(unsigned-byte 8) :initial-element 9)))
  (assert (= (aref matrix 1 2) 9))
  (assert (= (setf (aref matrix 1 2) 129) 129))
  (assert (= (row-major-aref matrix 5) 129))
  (assert (handler-case (progn (aref matrix 0 3) nil) (error () t)))
  (assert (handler-case (progn (setf (aref matrix 1 2) 256) nil) (type-error () t))))

(defun fill-with-index (size)
  (declare (type (integer 0 100) size) (optimize (speed 3) (safety 3)))
  (let ((array (make-array size :element-type 'double-float :initial-element 0d0)))
    (dotimes (i size array)
      (setf (aref array i) (float i 0d0)))))

(defun fill-with-invalid-index (size)
  (declare (type (integer 0 100) size) (optimize (speed 3) (safety 3)))
  (let ((array (make-array size :element-type 'double-float :initial-element 0d0)))
    (dotimes (i size array)
      (setf (aref array (1+ i)) 1d0))))

(assert (zerop (length (fill-with-index 0))))
(assert (equalp (fill-with-index 3) #(0d0 1d0 2d0)))
(assert (handler-case (progn (fill-with-invalid-index 1) nil)
          (error () t)))

(defun fill-input-vector (array)
  (declare ((simple-array double-float (*)) array) (optimize (speed 3) (safety 3)))
  (dotimes (i (length array) array)
    (setf (aref array i) 1d0)))

(assert (zerop (length (fill-input-vector (fill-with-index 0)))))
(assert (equalp (fill-input-vector (fill-with-index 3)) #(1d0 1d0 1d0)))

(defun fill-private-array (size)
  (declare (fixnum size) (optimize (speed 3) (safety 3)))
  (let ((array (make-array size :element-type 'double-float)))
    (flet ((fill-array ()
             (dotimes (i size array)
               (setf (aref array i) 2d0))))
      (declare (notinline fill-array))
      (fill-array))))

(assert (zerop (length (fill-private-array 0))))
(assert (equalp (fill-private-array 3) #(2d0 2d0 2d0)))

(defun fill-recursive-array (size change)
  (declare (fixnum size change) (optimize (speed 3) (safety 3)))
  (let ((array (make-array size :element-type 'double-float :initial-element 0d0)))
    (labels ((fill-array (n pending)
               (declare (fixnum n))
               (if pending
                   (fill-array (+ n change) nil)
                   (dotimes (i n array)
                     (setf (aref array i) 2d0)))))
      (declare (notinline fill-array))
      (fill-array size t))))

(assert (equalp (fill-recursive-array 3 -1) #(2d0 2d0 0d0)))
(assert (handler-case (progn (fill-recursive-array 3 1) nil)
          (error () t)))

(defun increment-array-recursively (array size)
  (declare ((simple-array double-float (*)) array) (fixnum size)
           (optimize (speed 3) (safety 3)))
  (labels ((increment-from (i)
             (declare (fixnum i))
             (when (< i size)
               (incf (aref array i) 1d0)
               (kiln.sys:%gc)
               (increment-from (1+ i)))))
    (declare (notinline increment-from))
    (increment-from 0))
  array)

(let ((array (make-array 3 :element-type 'double-float :initial-element 0d0)))
  (assert (equalp (increment-array-recursively array 3) #(1d0 1d0 1d0)))
  (let ((kiln.kernel::*specialized-array-storage-slots* #()))
    (assert (equalp (increment-array-recursively array 3) #(2d0 2d0 2d0)))))

(defun reverse-array-pairs (array z)
  (declare ((simple-array fixnum (*)) array)
           ((unsigned-byte 30) z) (optimize (speed 3) (safety 3)))
  (when (< z (length array))
    (loop for i from 0 to (ash z -1)
          collect (list (aref array i) (aref array (- z i))))))

(defun reverse-array-pairs-from-other (guarded other z)
  (declare ((simple-array fixnum (*)) guarded other)
           ((unsigned-byte 30) z) (optimize (speed 3) (safety 3)))
  (when (< z (length guarded))
    (loop for i from 0 to (ash z -1)
          collect (list (aref guarded i) (aref guarded (- z i))
                        (aref other i) (aref other (- z i))))))

(let ((array (make-array 4 :element-type 'fixnum :initial-contents '(1 2 3 4)))
      (empty (make-array 0 :element-type 'fixnum))
      (short (make-array 2 :element-type 'fixnum :initial-element 0)))
  (assert (equal (reverse-array-pairs array 3) '((1 4) (2 3))))
  (assert (equal (reverse-array-pairs array 0) '((1 1))))
  (assert (null (reverse-array-pairs array 4)))
  (assert (null (reverse-array-pairs empty 0)))
  (assert (handler-case (progn (reverse-array-pairs-from-other array short 3) nil)
            (error () t))))
