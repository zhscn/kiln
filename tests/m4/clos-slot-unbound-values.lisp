(defclass slot-return-probe ()
  ((zero :reader zero-reader)
   (many :reader many-reader)
   (shared :reader shared-reader :allocation :class)))
(defmethod slot-unbound ((class standard-class) (object slot-return-probe) name)
  (case name (zero (values)) (many (values 1 2 3)) (shared (values 7 8))))
(let ((object (make-instance 'slot-return-probe)))
  (dolist (name '(zero many shared))
    (print (multiple-value-list (slot-value object name)))
    (print (multiple-value-list (funcall #'slot-value object name))))
  (dotimes (i 2)
    (print (multiple-value-list (zero-reader object)))
    (print (multiple-value-list (many-reader object)))
    (print (multiple-value-list (shared-reader object)))))
