(let* ((symbol (make-symbol "UNDEFINED"))
       (ordinary (%primop :symbol-function symbol))
       (setf-function (%primop :symbol-setf-function symbol)))
  (kiln.sys:%gc)
  (print (list (fboundp symbol) (fboundp (list 'setf symbol))))
  (handler-case (funcall ordinary)
    (undefined-function (condition)
      (print (eq (cell-error-name condition) symbol))))
  (handler-case (funcall setf-function)
    (undefined-function (condition)
      (let ((name (cell-error-name condition)))
        (print (and (eq (car name) 'setf) (eq (cadr name) symbol)))))))

(let ((instance (%primop :allocate-general-funcallable-instance nil 0)))
  (handler-case (funcall instance)
    (type-error (condition)
      (print (eq (type-error-expected-type condition) 'function)))))
