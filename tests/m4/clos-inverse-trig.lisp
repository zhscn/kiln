(defun near-number (x y &optional (tolerance 2d-12))
  (<= (abs (- x y)) (* tolerance (max 1 (abs y)))))
(print (near-number (asin #c(1d0 2d0)) #c(0.42707858639247614d0 1.5285709194809982d0)))
(print (near-number (acos #c(1d0 2d0)) #c(1.1437177404024204d0 -1.5285709194809982d0)))
(print (near-number (asin #c(0d0 -2000d0)) #c(0d0 -8.294049702602021d0)))
(print (near-number (asinh -1d-20) -1d-20 1d-30))
(print (near-number (asinh -2000d0) -8.294049702602021d0))
(print (near-number (asinh 1d300) 691.4686750787737d0))
(dolist (z '(#c(0.0 2000.0) #c(0.0 -2000.0) #c(1000.0 2000.0)
             #c(-1000.0 -2000.0) #c(1d300 1d300)))
  (let ((a (asin z)) (b (acos z)))
    (print (and (numberp a) (numberp b)
                (near-number (+ a b) (float (/ pi 2) (realpart a)) 1d-6)))))
(print (near-number (asin #c(1d300 1d300)) #c(0.7853981633974483d0 691.8152486690536d0)))
(let* ((z #c(1d300 -1d300)) (root (sqrt z)))
  (print (near-number (/ (* root root) 1d300) #c(1d0 -1d0))))
(print (eql (float-sign (imagpart (sqrt #c(-1d0 -0d0)))) -1d0))
(print (float-sign (abs -0.0)))
(print (float-sign (abs -0d0)))
(print (handler-case (atan 1 nil) (type-error () :type-error)))
