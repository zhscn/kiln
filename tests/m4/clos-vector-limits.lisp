(defun rejected-vector-length-p (n)
  (handler-case (progn (kiln.kernel::make-simple-vector n nil) nil)
    (error () t)))
(defun rejected-string-length-p (n)
  (handler-case (progn (make-string n :initial-element #\x) nil)
    (error () t)))
(print (list (rejected-vector-length-p -1)
             (rejected-vector-length-p 4294967296)
             (rejected-string-length-p 4294967296)
             (length (kiln.kernel::make-simple-vector 0 nil))))
