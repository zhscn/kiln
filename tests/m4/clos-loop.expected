T
same (LOOP FOR I FROM 1 TO 3 COLLECT I)
same (LOOP FOR X IN (QUOTE (1 2 3)) AND Y = 0 THEN X SUM (* X Y))
same (LOOP FOR (A . B) ON (QUOTE (1 2 3)) BY (FUNCTION CDDR) WHEN (ODDP A) COLLECT A INTO ODDS FINALLY (RETURN ODDS))
same (LOOP FOR C ACROSS "abc" COUNT (CHAR= C #\b))
same (LOOP FOR K BEING THE HASH-KEYS OF (MAKE-HASH-TABLE) USING (HASH-VALUE V) COLLECT (CONS K V))
same (LOOP WITH N = 0 REPEAT 3 DO (INCF N) MAXIMIZE N)
same (LOOP NAMED OUTER FOR I BELOW 10 THEREIS (AND (> I 5) I))
same (LOOP (LOOP-FINISH))
same (LOOP FOR I DOWNFROM 10 ABOVE 0 BY 2 APPEND (LIST I) INTO L FINALLY (RETURN (NREVERSE L)))
