(defun generic-call-error-p (function)
  (handler-case (progn (funcall function) nil) (program-error () t)))
(defvar *keyword-before* nil)
(defgeneric keyword-select (object &key))
(defmethod keyword-select ((object number) &key number-key)
  (declare (ignore object)) (values :number number-key))
(defmethod keyword-select ((object symbol) &key symbol-key)
  (declare (ignore object)) (values :symbol symbol-key))
(defmethod keyword-select :before ((object integer) &key before-key)
  (declare (ignore object)) (setf *keyword-before* before-key))
(dotimes (i 2)
  (print (multiple-value-list (keyword-select 1 :before-key 7 :number-key 9)))
  (print *keyword-before*)
  (setf *keyword-before* :untouched)
  (print (generic-call-error-p (lambda () (keyword-select 1 :symbol-key 3))))
  (print *keyword-before*)
  (print (generic-call-error-p (lambda () (keyword-select 1.0 :before-key 7))))
  (print (multiple-value-list (keyword-select 'x :symbol-key 4))))
(print (generic-call-error-p (lambda () (keyword-select 1 :bad 1 :allow-other-keys nil
                                                        :allow-other-keys t))))
(print (multiple-value-list (keyword-select 1 :bad 1 :allow-other-keys t)))
(print (generic-call-error-p (lambda () (keyword-select 1 "NUMBER-KEY" 7))))
(defgeneric optional-keyed (x &optional y &key known))
(defmethod optional-keyed ((x t) &optional (y 5) &key known) (list x y known))
(print (optional-keyed 1))
(print (optional-keyed 1 2 :known 3))
(print (generic-call-error-p (lambda () (optional-keyed 1 :known 3))))
(defgeneric optional-only (x &optional y))
(defmethod optional-only ((x t) &optional y) (list x y))
(print (optional-only 1))
(print (generic-call-error-p (lambda () (optional-only))))
(print (generic-call-error-p (lambda () (optional-only 1 2 3))))
(defgeneric any-rest (x &rest args))
(defmethod any-rest ((x t) &rest args) (declare (ignore x)) args)
(print (any-rest 1 2 :foo 3))
(defgeneric restricted-rest (x &rest args))
(defmethod restricted-rest ((x t) &key known) (declare (ignore x)) known)
(print (restricted-rest 1 :known 7))
(print (generic-call-error-p (lambda () (restricted-rest 1 :bad 2))))
(print (restricted-rest 1 :bad 2 :allow-other-keys t))
(defgeneric nonkeyword-keyed (x &key ((non-keyword value))))
(defmethod nonkeyword-keyed ((x t) &key ((non-keyword value)))
  (declare (ignore x)) value)
(print (nonkeyword-keyed 1 'non-keyword 7))
(print (generic-call-error-p (lambda () (nonkeyword-keyed 1 :non-keyword 7))))
(defgeneric selectively-open (x &key))
(defmethod selectively-open ((x number) &key &allow-other-keys)
  (declare (ignore x)) :number)
(defmethod selectively-open ((x symbol) &key accepted) (declare (ignore x)) accepted)
(print (selectively-open 1 :anything 2))
(print (generic-call-error-p (lambda () (selectively-open 'x :anything 2))))
(defgeneric late-key (x &key))
(defmethod late-key ((x integer) &key base) (declare (ignore x)) base)
(print (generic-call-error-p (lambda () (late-key 1 :later 2))))
(defmethod late-key :before ((x t) &key later) (declare (ignore x later)) nil)
(print (late-key 1 :later 2 :base 3))
(remove-method #'late-key (find-method #'late-key '(:before) (list (find-class t))))
(print (generic-call-error-p (lambda () (late-key 1 :later 2))))

(defclass string-key-init () ((x :initarg :x :initform 0)))
(print (generic-call-error-p (lambda () (make-instance 'string-key-init "X" 7))))
(print (slot-value (make-instance 'string-key-init "X" 7 :allow-other-keys t) 'x))
(defgeneric keyword-rest (x &key a))
(defmethod keyword-rest ((x t) &rest args) (declare (ignore x)) args)
(print (keyword-rest 1 :a 2))
(print (generic-call-error-p (lambda () (keyword-rest 1 :bad 2))))
