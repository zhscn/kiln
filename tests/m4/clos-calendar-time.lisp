(declaim (notinline encode-universal-time decode-universal-time))

(print (multiple-value-list (decode-universal-time 0 0)))
(print (multiple-value-list (decode-universal-time 0 -1)))
(print (loop for year in '(1900 1904 1999 2000 2001 2100 2400 10000)
             always (let ((time (encode-universal-time 59 58 23 28 2 year 11/2)))
                      (equal (subseq (multiple-value-list
                                      (decode-universal-time time 11/2)) 0 6)
                             (list 59 58 23 28 2 year)))))
(print (loop for time in '(0 1 2208988800 3160857600 10000000000 100000000000000000000)
             always (loop for zone in '(-24 -11/2 -1/3600 0 1/3600 24)
                          always (let ((parts (multiple-value-list
                                               (decode-universal-time time zone))))
                                   (= time (apply #'encode-universal-time
                                                  (append (subseq parts 0 6) (list zone))))))))
(print (loop for time in '(0 2208988800 3160857600 4000000000 10000000000)
             always (let ((parts (multiple-value-list (decode-universal-time time))))
                      (= time (apply #'encode-universal-time (subseq parts 0 6))))))
(let* ((now (get-universal-time))
       (year (nth-value 5 (decode-universal-time now)))
       (short (mod year 100)))
  (print (= (encode-universal-time 0 0 0 1 1 short 0)
            (encode-universal-time 0 0 0 1 1 year 0))))
(print (= (length (multiple-value-list (get-decoded-time))) 9))
(print (= (- (encode-universal-time 0 0 0 1 3 2000 0)
             (encode-universal-time 0 0 0 28 2 2000 0))
          (* 2 86400)))
(print (= (- (encode-universal-time 0 0 0 1 3 2100 0)
             (encode-universal-time 0 0 0 28 2 2100 0))
          86400))
(print (handler-case (progn (encode-universal-time 0 0 0 1 1 1900 -1) nil)
         (type-error () t)))
(print (handler-case (progn (decode-universal-time -1 0) nil)
         (type-error () t)))
