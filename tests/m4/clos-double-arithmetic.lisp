(defun double-ops (a b)
  (declare (double-float a b))
  (list (+ a b) (- a b) (* a b) (+ (* a b) (- a b))))
(print (equalp (double-ops 1.5d0 2d0) '(3.5d0 -0.5d0 3d0 2.5d0)))
(print (handler-case (double-ops 1 2d0) (type-error () 'type-error)))
(let ((negative-zero (* -0d0 1d0)))
  (print (minusp (float-sign negative-zero)))
  (print (minusp (float-sign (+ negative-zero negative-zero))))
  (print (plusp (float-sign (- negative-zero negative-zero)))))
(let ((events nil))
  (print (= (+ (progn (push 'first events) 1d0)
               (progn (push 'second events) 2d0)) 3d0))
  (print (nreverse events)))
(print (= (+ 1d0 least-positive-double-float) 1d0))
(print (= (* least-positive-double-float 1d0) least-positive-double-float))
(print (zerop (* least-positive-double-float 0.5d0)))

(defun double-allocation-step ()
  (make-array 10000 :initial-element 'live))
(defun double-safepoint (a)
  (declare (double-float a))
  (+ (* a 1.2d0) (progn (double-allocation-step) 2d0)))
(print (= (double-safepoint 1.2d0) 3.44d0))
(let ((a 1d0))
  (declare (double-float a))
  (print (= (+ a (progn (setq a 2d0) a)) 3d0)))
