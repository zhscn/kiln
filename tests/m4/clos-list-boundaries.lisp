;; Tail operations retain dotted tails and handle arbitrarily large counts.
(print (last '(a b . c) 0))
(print (last '(a b . c) 2))
(print (last '(a b . c) (ash 1 100)))
(print (butlast '(a b . c) 0))
(print (butlast '(a b . c) 1))
(let ((x (list 'a 'b 'c 'd)))
  (print (eq x (nbutlast x 2)))
  (print x))
(let ((x (list* 'a 'b 'tail)))
  (print (ldiff x 'tail))
  (print (tailp 'tail x))
  (print (tailp (cdr x) x)))
(let* ((pair (cons 'a 'b)) (copy (copy-alist (list pair nil))))
  (print copy)
  (print (eq pair (car copy))))
(let ((x (make-list 10)))
  (setf (fourth x) 4 (fifth x) 5 (sixth x) 6 (seventh x) 7
        (eighth x) 8 (ninth x) 9 (tenth x) 10)
  (print x)
  (print (list (sixth x) (seventh x) (eighth x) (ninth x) (tenth x))))
(print (maplist (lambda (a b) (list (length a) (car b))) '(a b c) '(1 2)))
(print (mapcon (lambda (a b) (list (car a) (car b))) '(a b c) '(1 2)))
(let ((x (list 'a 'b)) (count 0))
  (print (eq x (mapl (lambda (a b) (incf count (+ (length a) (length b))))
                     x '(1 2 3))))
  (print count))
(print (multiple-value-list (tree-equal 1 2 :test (lambda (a b) (values (< a b) t)))))
(dolist (f (list (lambda () (make-list 1.5)) (lambda () (last '(a) -1))
                (lambda () (butlast 'a 0)) (lambda () (rplaca nil 1))
                (lambda () (nthcdr -1 '(a)))))
  (print (handler-case (progn (funcall f) nil) (type-error () t))))

;; Generalized places evaluate their subforms once, before the indicator.
(let ((v (vector (list 'a 1 'b 2))) (order nil))
  (print (remf (aref v (progn (push 'place order) 0))
               (progn (push 'indicator order) 'a)))
  (print (aref v 0))
  (print (reverse order)))
(let ((x (list 'a 1)))
  (print (remf x (progn (setq x (list 'b 2)) 'a)))
  (print x))
(let ((x 'a))
  (print (multiple-value-list
          (handler-bind ((type-error (lambda (c) (store-value 'b c))))
            (ccase x (b (values x 7))))))
  (print x))
(let ((x 3))
  (print (multiple-value-list (ctypecase x (integer (values x 4))))))
