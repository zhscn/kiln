(defun overflow-result (function &rest arguments)
  (handler-case (progn (apply function arguments) :missing-error)
    (floating-point-overflow (condition)
      (let ((operation (arithmetic-error-operation condition))
            (operands (arithmetic-error-operands condition)))
        (if (eq operation 'coerce)
            (list :overflow operation (type-of (first operands)) (second operands))
            (list :overflow operation operands))))))
(dolist (prototype '(1.0 1d0))
  (let ((maximum (if (typep prototype 'double-float)
                     most-positive-double-float most-positive-single-float)))
    (print (overflow-result #'exp (+ (log maximum) 100)))
    (print (overflow-result #'expt maximum 2))
    (print (overflow-result #'expt (- maximum) 3))
    (print (plusp (exp (- (log maximum) 1))))
    (print (zerop (exp (- (+ (log maximum) 1000)))))))
(dolist (base '(0 0.0 -0d0 #c(0.0 0.0)))
  (dolist (power '(-1 -0.5 #c(0.0 1.0)))
    (print (handler-case (expt base power)
             (division-by-zero () :division-by-zero)))))
(print (expt 0 0))
(print (expt 0.0 0))
(print (= (expt 2 1000) (ash 1 1000)))
(print (overflow-result #'expt #c(1d200 1d200) 4))
(print (zerop (expt #c(1d200 0d0) -2)))
