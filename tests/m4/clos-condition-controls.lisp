(print (simple-condition-format-arguments
        (make-condition 'simple-error :format-control "message")))
(let ((control (lambda (stream &rest arguments) (apply #'format stream "Value: ~A" arguments))))
  (print (handler-case (error control 7)
           (simple-error (condition)
             (list (eq control (simple-condition-format-control condition))
                   (simple-condition-format-arguments condition)
                   (format nil "~A" condition)))))
  (handler-bind ((simple-condition
                   (lambda (condition)
                     (print (eq control (simple-condition-format-control condition)))
                     (print (simple-condition-format-arguments condition)))))
    (signal control 8))
  (handler-bind ((warning
                   (lambda (condition)
                     (print (eq control (simple-condition-format-control condition)))
                     (print (simple-condition-format-arguments condition))
                     (muffle-warning condition))))
    (warn control 9)))
(let ((condition (make-condition 'simple-condition :format-control "not a warning")))
  (print (handler-case (progn (warn condition) nil)
           (type-error (error)
             (and (eq condition (type-error-datum error))
                  (not (typep condition (type-error-expected-type error))))))))
(let ((condition (make-condition 'simple-error :format-control "error")))
  (print (handler-bind ((simple-error
                         (lambda (error)
                           (print (eq error condition))
                           (print (format nil "~A" (find-restart 'continue error)))
                           (continue error))))
           (cerror "Continue with ~A." condition 10))))

(print (handler-case (values 1 2 3)
         (:no-error (a b c) (list c b a))))
(let ((value :outside))
  (declare (special value))
  (let ((value :inside))
    (print (handler-case nil
             (:no-error (ignored &aux (saved value))
               (declare (special value) (ignore ignored))
               saved)))))
