;;; CASE evaluates its key once and preserves multiple values in every arm.
(defun dispatch (key)
  (case key
    (-3 (values 'negative 1))
    (0 (values 'zero 2))
    (1 (values 'one 3))
    (2 (values 'two 4))
    (3 (values 'three 5))
    (1000000 (values 'sparse 6))
    (otherwise (values 'default 7))))
(dolist (key '(-3 0 1 2 3 1000000 -4 4 0.0 a nil))
  (print (multiple-value-list (dispatch key))))
(let ((count 0))
  (print (case (incf count) (0 'a) (1 'b) (2 'c) (t 'd)))
  (print count))
(defun duplicate-dispatch (key)
  (cond ((eql key 1) 'first)
        ((eql key 2) 'second)
        ((eql key 1) 'duplicate)
        ((eql key 3) 'third)))
(print (duplicate-dispatch 1))
(print (duplicate-dispatch 9))
(defun extreme-dispatch (key)
  (case key
    (-4611686018427387904 'low)
    (4611686018427387903 'high)
    (0 'zero)
    (t 'other)))
(print (extreme-dispatch -4611686018427387904))
(print (extreme-dispatch 4611686018427387903))

(defun grouped-dispatch (key)
  (case key
    ((0 1) 'small)
    ((2 3 4) 'medium)
    ((5 6) 'large)
    (t 'other)))
(print (mapcar #'grouped-dispatch '(0 1 2 3 4 5 6 7 a)))
