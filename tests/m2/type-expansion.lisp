(deftype frontend-index () '(integer 0 10))
(deftype frontend-indirect () 'frontend-index)
(defun frontend-index-plus (x)
  (declare (type frontend-indirect x))
  (+ x 1))
(print (frontend-index-plus 5))
(print (typep 5 'frontend-indirect))
(print (typep 11 'frontend-indirect))
(deftype frontend-limit (n) `(integer 0 ,n))
(defun frontend-in-range-p (x) (typep x '(frontend-limit 8)))
(print (frontend-in-range-p 8))
(print (frontend-in-range-p 9))
(defun frontend-sequential (x)
  (let* ((a x) (b (+ a 1)))
    (declare (frontend-index a b))
    b))
(print (frontend-sequential 4))
