(defun cm-add (x) (+ x 100))
(define-compiler-macro cm-add (x) `(+ ,x 1))
(print (cm-add 10))
(print (funcall #'cm-add 20))
(print (locally (declare (notinline cm-add)) (cm-add 10)))
(print (flet ((cm-add (x) (+ x 200))) (cm-add 10)))
(print (flet ((cm-add (x) (+ x 300))) (funcall #'cm-add 10)))
(print (macrolet ((cm-add (x) `(+ ,x 400))) (cm-add 10)))
(defun cm-decline (x) (+ x 5))
(define-compiler-macro cm-decline (&whole form x)
  (if (numberp x) (+ x 7) form))
(print (cm-decline 10))
(print (let ((x 10)) (cm-decline x)))
(defun cm-nil () :ordinary)
(define-compiler-macro cm-nil () nil)
(print (cm-nil))
(defun cm-place (x) x)
(defun (setf cm-place) (v x) (list :ordinary v x))
(define-compiler-macro (setf cm-place) (v x) `(list :expanded ,v ,x))
(print (funcall #'(setf cm-place) 1 2))
(print (locally (declare (notinline (setf cm-place))) (funcall #'(setf cm-place) 1 2)))
(defmacro cm-environment (&environment env)
  `(quote ,(not (null (compiler-macro-function 'cm-add env)))))
(print (cm-environment))
(print (flet ((cm-add (x) x)) (cm-environment)))
(defun cm-cycle (x) x)
(define-compiler-macro cm-cycle (&whole form &rest arguments)
  (declare (ignore arguments))
  (copy-list form))
(print (cm-cycle 17))
