;;; Places that are local macros or symbol macros: the standard macros see
;;; the lexical environment (vendor/README.md, Common-macros).
(defun f (v)
  (macrolet ((out (i) (declare (ignore i)) `(car v)))
    (setf (out 0) 1)
    (incf (out 0) 10)
    v))
(print (f (list 0 2)))
(defun g (v)
  (symbol-macrolet ((head (car v)))
    (push 'x head)
    v))
(print (g (list nil 2)))
;; THE as a place (CLHS 5.1.2.6)
(defun h (v)
  (setf (the fixnum (car v)) 5)
  (incf (the fixnum (cadr v)) 2)
  v)
(print (h (list 0 1)))
