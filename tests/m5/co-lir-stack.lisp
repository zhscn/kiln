(defvar *lir-stack-function* nil)

(let ((session (kiln.compiler:make-session)))
  (multiple-value-bind (module original-literals)
      (kiln.compiler:compile-module
       (kiln.compiler::front-end-forms
        (sublis (loop for name in '(pair reader alias) collect (cons name (gensym (symbol-name name))))
         '((setq *lir-stack-function*
                (lambda (payload)
                  (declare (optimize (speed 3) (compilation-speed 0)))
                  (let ((pair (cons payload nil)))
                    (declare (dynamic-extent pair))
                    (let ((reader (lambda () (kiln.sys:%gc) payload)))
                      (declare (dynamic-extent reader))
                      (kiln.sys:%gc)
                      (let* ((alias (if (consp payload) nil reader))
                             (value (funcall alias)))
                        (rplaca pair (vector value))
                        (kiln.sys:%gc)
                        (values value (svref (car pair) 0)))))))))
        session)
       "stack-producer" :session session :image t)
    (multiple-value-bind (program literals)
        (kiln.kir::normalize-lir-module module original-literals)
      (let ((objects (loop for form in (cddr program) when (eq (first form) :function)
                           append (remove-if-not (lambda (part) (eq (first part) :stack-object)) (cddr form)))))
        (print (list (not (null (find :cons objects :key #'third)))
                     (some (lambda (object) (consp (third object))) objects))))
      (let* ((direct (kiln.sys:%primop :compile-program program literals kiln.kir::+backend-target-fingerprint+))
             (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
             (decoded (kiln.sys:%primop :compile-packet packet literals)))
        (dolist (initializer (list direct decoded))
          (funcall initializer)
          (let ((identity (vector 'identity)))
            (multiple-value-bind (a b) (funcall *lir-stack-function* identity)
              (print (list (eq a identity) (eq b identity))))))))))

(let ((cons-class kiln.kir::+packet-class-cons+))
  (dolist (case
            `((:init-shape "stack initialization needs"
               (:func "bad" (:vars (:a :obj))
                 (:slots (:s (:stack-object ,cons-class 2)))
                 (:block :e (:stack-object-init :s ,cons-class 3) (:return (:fixnum-tag 0) 1))))
              (:root-shape "stack roots need"
               (:func "bad" (:vars (:a :obj))
                 (:slots (:s (:stack-object ,cons-class 2)) (:r (:stack-roots-entry)))
                 (:block :e (:stack-object-init :s ,cons-class 2)
                   (:stack-roots-enter :r :s ,cons-class 1) (:return (:fixnum-tag 0) 1))))
              (:inactive-root "no active root region"
               (:func "bad" (:vars (:a :obj))
                 (:slots (:s (:stack-object ,cons-class 2)) (:r (:stack-roots-entry)))
                 (:block :e (:stack-object-init :s ,cons-class 2)
                   (:stack-roots-enter :r :s ,cons-class 2) (:stack-roots-leave :r)
                   (:stack-cons :a (:slot :s) (:fixnum-tag 1) (:fixnum-tag 2))
                   (:return :a 1))) :backend)
              (:root-order "not innermost"
               (:func "bad" (:vars)
                 (:slots (:s (:stack-object ,cons-class 2)) (:r (:stack-roots-entry))
                         (:s2 (:stack-object ,cons-class 2)) (:r2 (:stack-roots-entry)))
                 (:block :e (:stack-object-init :s ,cons-class 2)
                   (:stack-roots-enter :r :s ,cons-class 2)
                   (:stack-object-init :s2 ,cons-class 2)
                   (:stack-roots-enter :r2 :s2 ,cons-class 2)
                   (:stack-roots-leave :r) (:stack-roots-leave :r2)
                   (:return (:fixnum-tag 0) 1))) :backend)))
    (let* ((module (kiln.kir:make-kmodule "rejected-stack"))
           (kiln.kir::*module* module))
      (kiln.kir:module-data "entry" '(:static-function "bad"))
      (kiln.kir:module-init "entry")
      (push (third case) (kiln.kir::kmodule-funcs module))
      (handler-case
          (let ((program (kiln.kir::normalize-lir-module module)))
            (when (fourth case)
              (print (and (null (kiln.sys:%primop :compile-program program #() kiln.kir::+backend-target-fingerprint+))
                          (first case)))))
        (error (condition)
          (print (and (search (second case) (princ-to-string condition)) (first case))))))))
