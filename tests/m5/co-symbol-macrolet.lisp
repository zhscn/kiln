(defconstant symbol-macro-constant nil)
(defvar *symbol-macro-special* :outer)
(defun symbol-macro-contracts ()
  (dolist (form '((symbol-macrolet ((x 10)) (declare (special x)) 20)
                  (symbol-macrolet ((symbol-macro-constant :bad)) symbol-macro-constant)
                  (symbol-macrolet ((*symbol-macro-special* :bad)) *symbol-macro-special*)
                  (symbol-macrolet ((t :bad)) t)
                  (symbol-macrolet ((nil :bad)) nil)
                  (symbol-macrolet ((:keyword :bad)) :keyword)
                  (let ((x :outer)) (declare (special x))
                    (symbol-macrolet ((x :bad)) x))))
    (print (handler-case (eval form) (program-error () :rejected))))
  (dolist (form '((let ((x :dynamic)) (declare (special x))
                    (let ((x :lexical))
                      (declare (ignorable x))
                      (symbol-macrolet ((x :macro))
                        (locally (declare (special x)) x))))
                  (symbol-macrolet ((x :outer))
                    (let ((x :inner)) (declare (special x)) x))
                  (symbol-macrolet ((x :outer))
                    (let ((x :inner)) x))
                  (symbol-macrolet ((x :outer))
                    (symbol-macrolet ((x :inner)) x))
                  (symbol-macrolet ((x :outer))
                    (declare (type symbol x)) x)
                  (let ((x :dynamic)) (declare (special x))
                    (let ((x :lexical))
                      (declare (ignorable x))
                      (symbol-macrolet () (declare (special x)) x)))))
    (print (eval form))))
(symbol-macro-contracts)
#+kiln
(let ((kiln.kernel::*eval-function* nil))
  (symbol-macro-contracts))
#-kiln
(symbol-macro-contracts)
