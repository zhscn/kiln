(defun double-multiple-binding (a b)
  (declare (double-float a b))
  (let ((log nil))
    (multiple-value-bind (x y marker missing)
        (values (+ a b) (* a b) (progn (push :marker log) :ok))
      (declare (double-float x y))
      (print (+ x y)) (print marker) (print missing) (print log))))
(double-multiple-binding 2d0 3d0)
(let ((x 2d0))
  (declare (double-float x))
  (multiple-value-bind (a b)
      (values x (progn (setq x 99d0) 3d0) (print :extra))
    (declare (double-float a b))
    (print (+ a b)) (print x)))
(print (handler-case
           (multiple-value-bind (a b) (values (+ 2d0 3d0))
             (declare (double-float a b)) (+ a b))
         (type-error () :missing-error)))
(print (handler-case
           (multiple-value-bind (a b) (values (+ 2d0 3d0) (identity :bad) (print :before-error))
             (declare (double-float a b)) (+ a b))
         (type-error () :type-error)))
(let ((function (compile nil '(lambda (a b)
                               (declare (double-float a b))
                               (multiple-value-bind (x y) (values (+ a b) (* a b))
                                 (declare (double-float x y)) (< x y))))))
  (print (funcall function 2d0 3d0)))
