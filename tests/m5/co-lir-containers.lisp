(defvar *lir-container-function* nil)

(let ((session (kiln.compiler:make-session)))
  (multiple-value-bind (module original-literals)
      (kiln.compiler:compile-module
       (kiln.compiler::front-end-forms
        '((setq *lir-container-function*
                (lambda (size initial)
                  (let ((items (kiln.sys:%primop :make-simple-vector size initial))
                        (zeros (kiln.sys:%primop :make-simple-vector size 0))
                        (text (kiln.sys:%primop :make-string size #\λ))
                        (record (kiln.sys:%primop :allocate-structure 'layout size)))
                    (kiln.sys:%primop :set-svref items 0 record)
                    (kiln.sys:%primop :set-schar text 0 #\界)
                    (kiln.sys:%primop :set-structure-slot record 0 initial)
                    (vector items zeros text record)))))
        session)
       "container-producer" :session session :image t)
    (multiple-value-bind (program literals)
        (kiln.kir::normalize-lir-module module original-literals)
      (let* ((direct (kiln.sys:%primop :compile-program program literals kiln.kir::+backend-target-fingerprint+))
             (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
             (decoded (kiln.sys:%primop :compile-packet packet literals)))
        (dolist (initializer (list direct decoded))
          (funcall initializer)
          (let* ((identity (list 'identity))
                 (result (funcall *lir-container-function* 3 identity))
                 (items (svref result 0))
                 (zeros (svref result 1))
                 (text (svref result 2))
                 (record (svref result 3)))
            (kiln.sys:%gc)
            (print (list (eq (svref items 0) record)
                         (eq (svref items 2) identity)
                         (coerce zeros 'list)
                         text
                         (eq (kiln.sys:%primop :structure-slot record 0) identity)
                         (kiln.sys:%primop :structure-slot record 2)
                         (kiln.sys:%primop :structure-layout record)))
            (handler-case (funcall *lir-container-function* 0 identity)
              (type-error () (print :empty-bounds)))
            (handler-case (funcall *lir-container-function* -1 identity)
              (type-error () (print :negative-length)))))))))

(dolist (case
          '((:store-arity "wrong operand count"
             (:func "bad" (:vars (:a :obj))
               (:block :e (:vector-set :a 0) (:return :a 1))))
            (:store-type "expected :WORD, got :OBJ"
             (:func "bad" (:vars (:a :obj))
               (:block :e (:vector-set :a :a :a) (:return :a 1))))))
  (let* ((module (kiln.kir:make-kmodule "rejected-container"))
         (kiln.kir::*module* module))
    (kiln.kir:module-data "entry" '(:static-function "bad"))
    (kiln.kir:module-init "entry")
    (push (third case) (kiln.kir::kmodule-funcs module))
    (handler-case (kiln.kir::normalize-lir-module module)
      (error (condition)
        (print (and (search (second case) (princ-to-string condition)) (first case)))))))
