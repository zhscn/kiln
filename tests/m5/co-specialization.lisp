;;; Native promotion of constructor objects.
(defun show (x) (write-line (prin1-to-string x)))
(setf clostrophilia::*specialization-threshold* 2)
(defvar *defaults* 0)
(defclass native-point ()
  ((x :initarg :x) (y :initform 7) (shared :allocation :class :initform 11))
  (:default-initargs :x (incf *defaults*)))
(defvar *constructor-cache* (cons nil nil))
(defun build-native-point ()
  (funcall (kiln.kernel::%constructor-target *constructor-cache* 'native-point '())))
(show (list (slot-value (build-native-point) 'x)
            (slot-value (build-native-point) 'x)
            (slot-value (build-native-point) 'x)))
(loop repeat 20 until (svref (car *constructor-cache*) 7) do (build-native-point))
(show (svref (car *constructor-cache*) 7))
(unless (svref (car *constructor-cache*) 7)
  (show clostrophilia::*specialization-last-error*))
(show (list (slot-value (build-native-point) 'y)
            (slot-value (build-native-point) 'shared)))
(defclass native-point () ((y :initform 19) (x :initarg :x :initform 23)))
(show (list (slot-value (build-native-point) 'x) (slot-value (build-native-point) 'y)))
(defmethod initialize-instance :after ((p native-point) &rest args)
  (declare (ignore args)) (incf (slot-value p 'x) 100))
(show (slot-value (build-native-point) 'x))

;;; Promotion hooks may change assumptions before a target is returned.
(defclass promotion-old () ((value :initform 1)))
(defclass promotion-new () ((value :initform 2)))
(let ((cache (cons nil nil)) (changed nil)
      (clostrophilia::*specialization-threshold* 1))
  (let ((clostrophilia::*specialization-compiler*
          (lambda (form)
            (declare (ignore form))
            (unless changed
              (setq changed t)
              (setf (find-class 'promotion-old) (find-class 'promotion-new)))
            nil)))
    (show (= (slot-value (funcall (kiln.kernel::%constructor-target
                                  cache 'promotion-old '())) 'value) 2))))
;;; HIR evaluation contexts defer promotion without poisoning a site.
(defclass delayed-promotion () ((value :initform 1)))
(let ((cache (cons nil nil)) (clostrophilia::*specialization-threshold* 1))
  (let ((kiln.kernel::*compile-function* nil))
    (kiln.kernel::%constructor-target cache 'delayed-promotion '()))
  (show (null (svref (car cache) 7)))
  (loop repeat 20 until (svref (car cache) 7)
        do (kiln.kernel::%constructor-target cache 'delayed-promotion '()))
  (show (eq (svref (car cache) 7) t)))

;;; Equivalent constructor sites share a promotion, including its callable.
(defclass shared-constructor () ((value :initform 1)))
(let ((first (cons nil nil)) (second (cons nil nil)) (attempts 0)
      (class (find-class 'shared-constructor))
      (clostrophilia::*specialization-threshold* 1))
  (let ((clostrophilia::*specialization-compiler*
          (lambda (form)
            (declare (ignore form)) (incf attempts)
            (lambda () (clostrophilia::construct-instance class nil)))))
    (let ((a (kiln.kernel::%constructor-target first 'shared-constructor '()))
          (b (kiln.kernel::%constructor-target second 'shared-constructor '())))
      (show (and (= attempts 1) (eq a b)
                 (= (slot-value (funcall a) 'value) 1)
                 (= (slot-value (funcall b) 'value) 1))))))
