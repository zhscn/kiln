(defvar *fasl-events* nil)
(let* ((source "build/test/co-fasl-source.lisp")
       (output (compile-file-pathname source))
       (*compile-verbose* nil)
       (*compile-print* nil)
       (*fasl-events* nil))
  (unwind-protect
       (progn
         (with-open-file (stream source :direction :output :if-exists :supersede)
           (write-string "(in-package :cl-user)
(eval-when (:compile-toplevel)
  (assert (and (not *compile-verbose*) (not *compile-print*)))
  (push :compile *fasl-events*))
(eval-when (:load-toplevel) (push :load *fasl-events*))
(defmacro fasl-plus (x) `(+ ,x 17))
(defun fasl-sum (x) (fasl-plus x))
(defun fasl-constant () '#1=(shared . #1#))
(defun fasl-paths () (list #.*compile-file-pathname* #.*compile-file-truename*))
(values 101 202)
" stream))
         (dolist (name '(fasl-sum fasl-constant fasl-paths)) (fmakunbound name))
         (let ((result nil))
           (print (string= "" (with-output-to-string (*standard-output*)
                               (setf result (multiple-value-list (compile-file source))))))
           (print (list (= 3 (length result)) (equal (first result) (truename output))
                        (second result) (third result))))
         (print *fasl-events*)
         (print (fboundp 'fasl-sum))
         (print (load output :verbose nil :print nil))
         (print *fasl-events*)
         (print (funcall 'fasl-sum 25))
         (let ((object (funcall 'fasl-constant)))
           (print (list (car object) (eq object (cdr object))
                        (eq object (funcall 'fasl-constant)))))
         (print (equal (funcall 'fasl-paths)
                       (list (merge-pathnames source) (truename source))))
         (with-open-file (stream output :element-type '(unsigned-byte 8))
           (print (load stream :verbose nil :print nil)))
         (print *fasl-events*)
         (print (list *compile-file-pathname* *compile-file-truename*))
         (print (not (string= "" (with-output-to-string (*standard-output*)
                                   (load output :verbose nil :print t)))))
         (let ((*read-eval* nil) (*error-output* (make-string-output-stream)))
           (print (multiple-value-list (compile-file source :verbose nil :print nil))))
         (print (list *compile-file-pathname* *compile-file-truename*)))
    (when (probe-file source) (delete-file source))
    (when (probe-file output) (delete-file output))))
(let* ((source "build/test/co-fasl-package.lisp")
       (output (compile-file-pathname source)))
  (unwind-protect
       (progn
         (when (find-package "KILN-FASL-TEST") (delete-package "KILN-FASL-TEST"))
         (with-open-file (stream source :direction :output :if-exists :supersede)
           (write-string "(defpackage :kiln-fasl-test (:use :cl) (:export :answer))
(in-package :kiln-fasl-test)
(defun answer () 42)
" stream))
         (compile-file source :verbose nil :print nil)
         (delete-package "KILN-FASL-TEST")
         (load output :verbose nil :print nil)
         (multiple-value-bind (name status) (find-symbol "ANSWER" "KILN-FASL-TEST")
           (print (list status (funcall name)))))
    (when (find-package "KILN-FASL-TEST") (delete-package "KILN-FASL-TEST"))
    (when (probe-file source) (delete-file source))
    (when (probe-file output) (delete-file output))))
