(handler-bind ((warning #'muffle-warning))
  (dolist (entry '(((x) (x y) nil)
                   ((x &optional y) (x &optional y z) nil)
                   ((x &rest r) (x) nil)
                   ((x) (x &key) nil)
                   ((x &key foo) (x &key bar) nil)
                   ((x &key foo &allow-other-keys) (x &key) t)
                   ((x &key foo) (x &key ((:foo differently-named))) t)
                   ((x &key foo) (x &rest r) t)
                   ((x &key foo) (x &key &allow-other-keys) t)
                   ((x &rest r) (x &key foo) t)
                   ((x &optional y &key foo) (x &optional (z 3) &key foo bar) t)
                   ((x &key ((non-keyword k))) (x &key ((non-keyword v))) t)
                   ((x &key ((non-keyword k))) (x &key non-keyword) nil)))
    (let ((name (gensym "GF")))
      (eval `(defgeneric ,name ,(first entry)))
      (print (eql (third entry)
                  (handler-case
                      (not (null (typep (eval `(defmethod ,name ,(second entry) :ok)) 'method)))
                    (program-error () nil))))))
)
(defgeneric method-move-source (x))
(defmethod method-move-source ((x integer)) :integer)
(defmethod method-move-source ((x t)) :default)
(defgeneric method-move-target (x))
(defgeneric method-move-incompatible (x y))
(let ((method (find-method #'method-move-source nil (list (find-class 'integer)))))
  (print (eq #'method-move-source (remove-method #'method-move-source method)))
  (print (eq #'method-move-target (add-method #'method-move-target method)))
  (print (list (method-move-source 1) (method-move-target 1)))
  (remove-method #'method-move-target method)
  (print (handler-case (progn (add-method #'method-move-incompatible method) nil)
           (program-error () t)))
  (print (eq #'method-move-target (add-method #'method-move-target method)))
  (print (method-move-target 1)))
