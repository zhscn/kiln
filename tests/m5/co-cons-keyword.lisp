(let ((inner (cons 31 nil)))
  (let ((outer (cons inner nil)))
    (flet ((inspect (x &key (y x supplied))
             (print supplied)
             (print (eq x y))
             (print (car (car y)))))
      (inspect outer)
      (inspect outer :y outer)
      (inspect outer :y outer :y nil))))
(let ((saved nil))
  (let ((inner (cons 37 nil)))
    (let ((outer (cons inner nil)))
      (flet ((retain (x &key (y (setq saved x))) y))
        (retain outer))))
  (print (car (car saved))))
