(defun discard-double-results (a b)
  (declare (double-float a b))
  (+ a b)
  (values (* a b) (progn (print :second) (- a b)) (progn (print :third) (abs (- a))))
  :done)
(print (discard-double-results 2d0 3d0))
(defun discard-double-division (a b)
  (declare (double-float a b))
  (values (progn (print :left) (+ a 1d0)) (/ a b) (print :too-late))
  :done)
(print (handler-case (discard-double-division 7d0 -0d0)
         (division-by-zero () :division-error)))
(print (block done
         (values (+ 2d0 3d0) (return-from done :secondary-exit) (print :too-late))
         :done))
(let ((function (compile nil '(lambda (a b)
                               (declare (double-float a b))
                               (values (+ a b) (/ a b))
                               :done))))
  (print (funcall function 2d0 3d0))
  (print (handler-case (funcall function 2d0 0d0) (division-by-zero () :division-error)))
  (print (handler-case (funcall function 2 3d0) (type-error () :type-error))))
