(defclass moving-source () ((value :initarg :value)))
(defclass moving-target () ((value :initarg :value) (added :initarg :added :initform 12)))
(print (handler-case (progn (change-class (make-instance 'moving-source) 'moving-target :unknown 1) nil)
         (program-error () t)))
(print (handler-case (progn (change-class (make-instance 'moving-source) 'moving-target '(bad) 1) nil)
         (program-error () t)))
(let ((object (make-instance 'moving-source :value 9)))
  (print (eq object (change-class object 'moving-target :added 15)))
  (print (list (slot-value object 'value) (slot-value object 'added))))
(defclass shared-target () ((value :allocation :class :initarg :value)))
(let ((other (make-instance 'shared-target)))
  (slot-makunbound other 'value)
  (let ((object (make-instance 'moving-source :value 9)))
    (change-class object 'shared-target)
    (print (list (slot-boundp object 'value) (slot-boundp other 'value)))))
(defvar *moving-token* nil)
(defmethod update-instance-for-different-class :after
    ((previous moving-source) (current moving-target) &key token)
  (declare (ignore previous current))
  (setf *moving-token* token))
(change-class (make-instance 'moving-source) 'moving-target :token :accepted)
(print *moving-token*)
(print (typep (change-class (make-instance 'moving-source) 'moving-target
                           :unknown 1 :allow-other-keys t) 'moving-target))
