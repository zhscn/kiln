(defvar *fasl-order* nil)
(defclass fasl-node ()
  ((name :initarg :name :reader fasl-node-name)
   (dependency :initarg :dependency :initform nil :accessor fasl-node-dependency)
   (payload :initarg :payload :initform nil :accessor fasl-node-payload)))
(defun create-fasl-node (name dependency)
  (push (list :create name) *fasl-order*)
  (make-instance 'fasl-node :name name :dependency dependency))
(defun initialize-fasl-node (object payload)
  (push (list :initialize (fasl-node-name object)) *fasl-order*)
  (setf (fasl-node-payload object) payload))
(defmethod make-load-form ((object fasl-node) &optional environment)
  (declare (ignore environment))
  (values `(create-fasl-node ',(fasl-node-name object) ',(fasl-node-dependency object))
          `(initialize-fasl-node ',object ',(fasl-node-payload object))))
(defvar *fasl-a*)
(defvar *fasl-b*)
(let* ((source "build/test/co-fasl-order-source.lisp")
       (output (compile-file-pathname source)))
  (unwind-protect
       (progn
         (with-open-file (stream source :direction :output :if-exists :supersede)
           (write-string "(in-package :cl-user)
(eval-when (:compile-toplevel)
  (setf *fasl-a* (make-instance 'fasl-node :name :a)
        *fasl-b* (make-instance 'fasl-node :name :b :dependency *fasl-a*)
        (fasl-node-payload *fasl-a*) (list :marker *fasl-b*)
        (fasl-node-payload *fasl-b*) (list :marker *fasl-a*)))
(defparameter *fasl-b* #.*fasl-b*)
(defparameter *fasl-a* #.*fasl-a*)
" stream))
         (compile-file source :verbose nil :print nil)
         (let ((*fasl-order* nil) (*fasl-a* nil) (*fasl-b* nil))
           (load output :verbose nil :print nil)
           (print (reverse *fasl-order*))
           (print (eq (fasl-node-dependency *fasl-b*) *fasl-a*))
           (print (list (first (fasl-node-payload *fasl-a*))
                        (eq (second (fasl-node-payload *fasl-a*)) *fasl-b*)
                        (first (fasl-node-payload *fasl-b*))
                        (eq (second (fasl-node-payload *fasl-b*)) *fasl-a*)))))
    (when (probe-file source) (delete-file source))
    (when (probe-file output) (delete-file output))))
