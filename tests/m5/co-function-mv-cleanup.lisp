(flet ((target (x) (+ x 7)) (other (x) (- x 7)))
  (declare (notinline target other))
  (let ((current #'target))
    (multiple-value-bind (unused f)
        (unwind-protect
             (unwind-protect (values nil current) (print :inner))
          (setq current #'other) (print :outer))
      (print (funcall f 3)) (print (funcall current 4)))))
(print (catch 'done
         (flet ((target (x) (+ x 7)))
           (declare (notinline target))
           (multiple-value-bind (unused f)
               (unwind-protect (values nil #'target) (throw 'done :cleanup-exit))
             (funcall f 3)))))
(print (catch 'done
         (flet ((target (x) (+ x 7)))
           (declare (notinline target))
           (multiple-value-bind (unused f)
               (unwind-protect (values nil (throw 'done :protected-exit)) (print :unwind))
             (funcall f 3)))))
(let ((function (compile nil '(lambda ()
                               (flet ((target (x) (+ x 7)) (other (x) (- x 7)))
                                 (declare (notinline target other))
                                 (let ((current #'target))
                                   (multiple-value-bind (unused f)
                                       (unwind-protect (values nil current) (setq current #'other))
                                     (list (funcall f 3) (funcall current 4)))))))))
  (print (funcall function)))
