(defvar *lir-heap-rest-function* nil)
(defvar *lir-stack-rest-function* nil)
(defvar *lir-key-function* nil)

(let ((session (kiln.compiler:make-session)))
  (multiple-value-bind (module original-literals)
      (kiln.compiler:compile-module
       (kiln.compiler::front-end-forms
        (sublis (loop for name in '(args pair) collect (cons name (gensym (symbol-name name))))
         '((setq *lir-heap-rest-function*
                 (lambda (prefix &rest tail)
                   (kiln.sys:%gc)
                   (values prefix tail)))
           (setq *lir-stack-rest-function*
                 (lambda (prefix &rest args)
                   (declare (ignore prefix) (optimize (speed 3) (compilation-speed 0)))
                   (let ((pair (cons (car args) nil)))
                     (kiln.sys:%gc)
                     (car pair))))
           (setq *lir-key-function*
                 (lambda (&key (value 'default) &allow-other-keys) value))))
        session)
       "rest-producer" :session session :image t)
    (multiple-value-bind (program literals)
        (kiln.kir::normalize-lir-module module original-literals)
      (let ((rest (loop for form in (cddr program)
                        for declaration = (and (eq (first form) :function) (assoc :rest (cddr form)))
                        when declaration collect declaration)))
        (print (list (some (lambda (declaration) (null (fourth declaration))) rest)
                     (some (lambda (declaration) (equal (fourth declaration) '(:stack 8))) rest)
                     (some (lambda (form) (and (eq (first form) :function)
                                               (not (null (assoc :stack-object (cddr form))))))
                           (cddr program)))))
      (let* ((direct (kiln.sys:%primop :compile-program program literals kiln.kir::+backend-target-fingerprint+))
             (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
             (decoded (kiln.sys:%primop :compile-packet packet literals)))
        (dolist (initializer (list direct decoded))
          (funcall initializer)
          (let ((identity (list 'identity)))
            (multiple-value-bind (prefix tail) (funcall *lir-heap-rest-function* identity identity 'last)
              (kiln.sys:%gc)
              (print (list (eq prefix identity) (eq (car tail) identity) (cdr tail))))
            (print (mapcar (lambda (count)
                             (let ((result (apply *lir-stack-rest-function* nil (make-list count :initial-element identity))))
                               (if (zerop count) (null result) (eq result identity))))
                           '(0 1 8 9 12)))
            (print (list (funcall *lir-key-function*)
                         (eq (funcall *lir-key-function* :ignored 1 :value identity) identity)))
            (handler-case (funcall *lir-heap-rest-function*)
              (program-error () (print :arity)))))))))

(dolist (case
          '((:duplicate-rest "duplicate incoming rest list"
             (:func "bad" (:vars (:a :obj) (:b :obj))
               (:block :e (:rest-list :a 0 nil :nil) (:rest-list :b 0 nil :nil) (:return :a 1))))
            (:negative-start "rest start needs"
             (:func "bad" (:vars (:a :obj))
               (:block :e (:rest-list :a -1 nil :nil) (:return :a 1))))
            (:duplicate-storage "rest storage must be distinct"
             (:func "bad" (:vars (:a :obj))
               (:block :e (:rest-list :a 0 (:s :s) :nil) (:return :a 1))))
            (:storage-shape "rest storage needs cons slots"
             (:func "bad" (:vars (:a :obj))
               (:slots (:s (:stack-roots-entry)))
               (:block :e (:rest-list :a 0 (:s) :nil) (:return :a 1))))))
  (let* ((module (kiln.kir:make-kmodule "rejected-rest"))
         (kiln.kir::*module* module))
    (kiln.kir:module-data "entry" '(:static-function "bad"))
    (kiln.kir:module-init "entry")
    (push (third case) (kiln.kir::kmodule-funcs module))
    (handler-case (kiln.kir::normalize-lir-module module)
      (error (condition)
        (print (and (search (second case) (princ-to-string condition)) (first case)))))))
