(defun typed-double-predicates (x)
  (declare (double-float x))
  (list (zerop x) (plusp x) (minusp x)))
(defun generic-double-predicates (x)
  (declare (notinline zerop plusp minusp))
  (list (zerop x) (plusp x) (minusp x)))
(dolist (x '(0d0 -0d0 2d0 -2d0)) (print (typed-double-predicates x)))
(print (every (lambda (x) (equal (typed-double-predicates x) (generic-double-predicates x)))
              (list 0d0 -0d0 2d0 -2d0
                    (kiln.kernel::%primop :make-double-float-bits 0 1)
                    (kiln.kernel::%primop :make-double-float-bits #x80000000 1)
                    (kiln.kernel::%primop :make-double-float-bits #x7ff00000 0)
                    (kiln.kernel::%primop :make-double-float-bits #xfff00000 0)
                    (kiln.kernel::%primop :make-double-float-bits #x7ff80000 123))))
(let ((function (compile nil '(lambda (a b)
                               (declare (double-float a b))
                               (list (zerop (+ a b)) (plusp (- a b)) (minusp (* a b)))))))
  (print (funcall function -3d0 3d0))
  (print (handler-case (funcall function -3 3d0) (type-error () :type-error))))
