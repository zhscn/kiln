(defun unary-double-chain (value)
  (declare (double-float value))
  (* (1+ (abs (- value))) (1- value)))
(print (unary-double-chain -2d0))

(let ((function (compile nil '(lambda (value)
                               (declare (double-float value))
                               (* (1+ (abs (- value))) (1- value))))))
  (print (funcall function -2d0))
  (print (funcall function 3d0))
  (print (handler-case (funcall function 3) (type-error () 'type-error))))

(defun unary-double-bits (value)
  (declare (double-float value))
  (let ((negative (- value)) (positive (abs value)))
    (list (kiln.kernel::%primop :double-float-high-bits negative)
          (kiln.kernel::%primop :double-float-low-bits negative)
          (kiln.kernel::%primop :double-float-high-bits positive)
          (kiln.kernel::%primop :double-float-low-bits positive))))
(dolist (value (list 0d0 -0d0
                    (kiln.kernel::%primop :make-double-float-bits #x7ff80000 123)
                    (kiln.kernel::%primop :make-double-float-bits #xfff80000 123)))
  (print (unary-double-bits value)))

(let ((value -2d0))
  (declare (double-float value))
  (dotimes (i 5)
    (setq value (1+ (abs (- value))))
    (kiln.kernel::%gc))
  (print value))

(let ((value -2d0))
  (declare (double-float value))
  (print (* (1+ (abs (- value)))
            (progn (setq value 4d0) (kiln.sys:%gc) (1- value)))))
