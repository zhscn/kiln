(deftype implicit-key (&key value) `(eql ,value))
(deftype listed-key (&key (value)) `(eql ,value))
(deftype renamed-key (&key ((:named value))) `(eql ,value))
(deftype explicit-key (&key (value nil supplied))
  (if supplied `(eql ,value) '(eql nil)))
(deftype key-interval (&key low high) `(integer ,low ,high))
(print (typep '* '(implicit-key)))
(print (typep '* '(listed-key)))
(print (typep '* '(renamed-key)))
(print (typep nil '(explicit-key)))
(print (typep 4 '(explicit-key :value 4)))
(print (typep 4 '(renamed-key :named 4)))
(print (typep -10 '(key-interval)))
(print (typep 4 '(key-interval :low 3 :high 5)))
(print (typep 2 '(key-interval :low 3 :high 5)))
(print (typep 4 '(key-interval :low 3 :low 8 :high 5)))
(print (typep 4 '(key-interval :unknown 9 :allow-other-keys t)))
(print (destructuring-bind (&key value (other)) nil (list value other)))
(print (typep 4 '(key-interval :allow-other-keys nil)))
(print (destructuring-bind (&key value) '(:allow-other-keys nil) value))
(print (handler-case
           (eval '(destructuring-bind (&key value)
                      '(:unknown 1 :allow-other-keys nil :allow-other-keys t) value))
         (error () :rejected)))
