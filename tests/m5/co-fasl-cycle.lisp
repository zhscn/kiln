(defclass fasl-cycle () ((other :initarg :other :initform nil :accessor fasl-cycle-other)))
(defmethod make-load-form ((object fasl-cycle) &optional environment)
  (declare (ignore environment))
  `(make-instance 'fasl-cycle :other ',(fasl-cycle-other object)))
(defvar *fasl-cycle-root*)
(let* ((source "build/test/co-fasl-cycle-source.lisp")
       (output (compile-file-pathname source)))
  (unwind-protect
       (progn
         (with-open-file (stream source :direction :output :if-exists :supersede)
           (write-string "(in-package :cl-user)
(eval-when (:compile-toplevel)
  (let ((a (make-instance 'fasl-cycle)) (b (make-instance 'fasl-cycle)))
    (setf (fasl-cycle-other a) b (fasl-cycle-other b) a *fasl-cycle-root* a)))
(defparameter *fasl-cycle-root* #.*fasl-cycle-root*)
" stream))
         (let ((*error-output* (make-string-output-stream)))
           (print (handler-case
                      (multiple-value-bind (file warnings-p failure-p)
                          (compile-file source :verbose nil :print nil)
                        (declare (ignore file))
                        (and warnings-p failure-p))
                    (program-error () t)
                    (error () nil)))))
    (when (probe-file source) (delete-file source))
    (when (probe-file output) (delete-file output))))
