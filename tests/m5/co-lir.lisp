(let ((function (compile nil '(lambda (callee first tail)
                               (apply callee first tail)))))
  (print (funcall function #'list 1 '(2 3 4)))
  (handler-case (funcall function #'list 1 '(2 . 3))
    (type-error (condition) (print (type-error-datum condition))))
  (print (multiple-value-list
          (funcall function (lambda (&rest arguments)
                              (values (length arguments) (car arguments)))
                   1 '(2 3)))))

