(let ((floor (compile nil '(lambda (a b) (kiln.sys:%primop :integer-floor a b))))
      (length (compile nil '(lambda (a) (kiln.sys:%primop :integer-length a))))
      (car (compile nil '(lambda (a) (car a)))))
  (print (multiple-value-list (funcall floor -17 5)))
  (print (funcall length 18446744073709551616))
  (handler-case (funcall car 42)
    (type-error (condition) (print (type-error-datum condition)))))

