(let* ((wrapper
         '(:lir-module "runtime-compile" (:init "runtime-compile-run")
           (:function "runtime-compile-run" (:receive 3)
             (:vars (:program :obj) (:literals :obj) (:target :obj) (:f :obj)
                    (:a :obj) (:b :obj) (:m :mv))
             (:block :entry (:set :program (:arg-ref 0)) (:set :literals (:arg-ref 1))
               (:set :target (:arg-ref 2)) (:set :a (:fixnum 7)) (:values :m (:a :a))
               (:runtime :f :compile-program (:program :literals :target))
               (:set :b (:mv-ref :m 1)) (:return (:f :b))))))
       (inner '(:lir-module "runtime-nested" (:init "runtime-nested-run")
                 (:function "runtime-nested-run" (:vars (:a :obj))
                   (:block :entry (:set :a (:fixnum 42)) (:return (:a))))))
       (function (kiln.sys:%primop :compile-program wrapper #()
                                  kiln.kir::+backend-target-fingerprint+)))
  (multiple-value-bind (compiled saved)
      (funcall function inner #() kiln.kir::+backend-target-fingerprint+)
    (print (list (funcall compiled) saved))))

