(dolist (case '((:vector -1 (:alloc-sequence :a :simple-vector :length :nil))
                (:vector 4294967296 (:alloc-sequence :a :simple-vector :length :nil))
                (:string 1 (:alloc-sequence :a :string :length :a))
                (:structure -1 (:alloc-structure :a :nil :length :nil))
                (:instance -1 (:alloc-instance :a :standard-instance :nil :length :nil :nil :nil))))
  (let* ((program `(:lir-module "bad-sequence" (:init "bad-sequence-run")
                    (:function "bad-sequence-run" (:vars (:a :obj) (:nil :obj) (:length :word))
                      (:block :entry (:set :nil (:nil)) (:set :a (:fixnum 0))
                        (:set :length (:word ,(second case))) ,(third case) (:return (:a))))))
         (function (kiln.sys:%primop :compile-program program #()
                                    kiln.kir::+backend-target-fingerprint+)))
    (handler-case (funcall function)
      (type-error (condition) (print (list (first case) (type-error-datum condition)))))))

