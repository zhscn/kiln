(let* ((literal (list 'identity))
       (program '(:lir-module "constant-literals" (:init "constant-literals-run")
                  (:literals 1)
                  (:constants (:cons (:literal 0) (:constant 0)))
                  (:cells (:literal 0) (:constant 0))
                  (:function "constant-literals-run" (:vars (:a :obj))
                    (:block :entry (:set :a (:constant 0))
                      (:set :a (:field-ref :cons.cdr :a))
                      (:set :a (:field-ref :cons.car :a)) (:cell-set 0 :a)
                      (:set :a (:cell-ref 0)) (:return (:a))))))
       (literals (vector literal))
       (direct (kiln.sys:%primop :compile-program program literals
                                kiln.kir::+backend-target-fingerprint+))
       (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
       (decoded (kiln.sys:%primop :compile-packet packet literals)))
  (dotimes (i 100000) (list i))
  (print (list (eq (funcall direct) literal) (eq (funcall decoded) literal))))

(let* ((probe-name 'lir-debug-probe)
       (probe
         (lambda ()
           (let ((frame (find probe-name (kiln.sys:frame-list)
                              :key #'kiln.sys:frame-name)))
             (print (multiple-value-list (kiln.sys:frame-source frame)))
             (let ((variables (kiln.sys:frame-variables frame)))
               (print (list (cdr (assoc 'x variables))
                            (cdr (assoc 'd variables))
                            (cdr (assoc 'boxed variables))))))))
       (program
         '(:lir-module "debug-lir" (:init "debug-lir-run") (:literals 6)
           (:function "debug-lir-run"
             (:vars (:a :obj) (:d :f64) (:boxed :obj) (:nil :obj)
                    (:helper :obj) (:m :mv) (:double :obj) (:value :obj))
             (:debug (:literal 0) (:literal 1) 100 200
                     ((:a (:literal 2)) (:d (:literal 3)) (:boxed (:literal 4) :cell)))
             (:block :entry (:set :a (:fixnum 42))
               (:set :d (:f64 4612811918334230528)) (:set :nil (:nil))
               (:alloc :boxed :cons :heap (:a :nil))
               (:set :helper (:literal 5)) (:call :m :helper () (:loc 120 130))
               (:alloc :double :double-float :heap (:d))
               (:set :value (:field-ref :cons.car :boxed))
               (:return (:a :double :value))))))
       (literals (vector probe-name "lir-debug.lisp" 'x 'd 'boxed probe))
       (direct (kiln.sys:%primop :compile-program program literals
                                kiln.kir::+backend-target-fingerprint+))
       (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
       (decoded (kiln.sys:%primop :compile-packet packet literals)))
  (dolist (function (list direct decoded))
    (print (multiple-value-list (funcall function)))))

