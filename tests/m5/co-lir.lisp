;;; The structured snapshot and byte adapters compile the same independent
;;; backend program, preserving image literals and returned value counts.
(let* ((literal (list 'identity))
       (program
         '(:lir-module "runtime-lir" (:init "runtime-lir-body") (:literals 1)
           (:function "runtime-lir-body"
             (:vars (:literal :obj) (:number :obj) (:result :mv))
             (:block :entry
               (:set :literal (:literal 0))
               (:set :number (:fixnum 42))
               (:values :result (:number :literal))
               (:return-mv :result)))))
       (literals (vector literal))
       (direct (kiln.sys:%primop :compile-program program literals
                                kiln.kir::+backend-target-fingerprint+))
       (packet (kiln.sys:%primop :encode-packet program
                                kiln.kir::+packet-lir-payload+))
       (decoded (kiln.sys:%primop :compile-packet packet literals)))
  (dolist (function (list direct decoded))
    (multiple-value-bind (number object) (funcall function)
      (print (list number (eq object literal)))))
  (print (equal (multiple-value-list (funcall direct))
                (multiple-value-list (funcall decoded)))))

;;; Read names in a data-only package so NIL and T remain identifiers in
;;; the backend program; empty lists still represent empty operand lists.
(let* ((program
         (let ((*package* (or (find-package "LIR-FIXTURE")
                             (make-package "LIR-FIXTURE" :use '()))))
           (with-open-file (stream "rust/kiln-cg/tests/fixtures/lir-unwind.lisp-expr")
             (read stream))))
       (first-symbol (gensym))
       (second-symbol (gensym)))
  (setf (second (third program)) "run"
        (symbol-value first-symbol) 31
        (symbol-value second-symbol) 32)
  (let ((direct (kiln.sys:%primop :compile-program program #()
                                 kiln.kir::+backend-target-fingerprint+))
        (packet (kiln.sys:%primop :encode-packet program
                                 kiln.kir::+packet-lir-payload+)))
    (let ((decoded (kiln.sys:%primop :compile-packet packet #())))
      (dolist (function (list direct decoded))
        (print (multiple-value-list (funcall function first-symbol second-symbol)))))))

(dolist (operation '(:throw :exit-to))
  (let* ((program `(:lir-module "invalid-exit" (:init "invalid-exit-body")
                    (:function "invalid-exit-body" (:vars (:tag :obj) (:values :mv))
                      (:block :entry (:set :tag (:nil)) (:values :values ())
                        (,operation :tag :values)))))
         (function (kiln.sys:%primop :compile-program program #()
                                    kiln.kir::+backend-target-fingerprint+)))
    (handler-case (funcall function)
      (control-error () (print operation)))))

