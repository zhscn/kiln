(defun double-multiple-cleanup (a b)
  (declare (double-float a b))
  (multiple-value-bind (x y marker)
      (unwind-protect
           (unwind-protect (values (+ a b) (* a b) (cons :saved nil))
             (print :inner))
        (setq a 99d0) (print :outer))
    (declare (double-float x y))
    (print (+ x y)) (print marker) (print a)))
(double-multiple-cleanup 2d0 3d0)
(print (catch 'done
         (multiple-value-bind (x y)
             (unwind-protect (values (+ 2d0 3d0) (* 2d0 3d0))
               (throw 'done :cleanup-exit))
           (declare (double-float x y)) (+ x y))))
(print (catch 'done
         (multiple-value-bind (x y)
             (unwind-protect (values (+ 2d0 3d0) (throw 'done :protected-exit))
               (print :unwind-cleanup))
           (declare (double-float x y)) (+ x y))))
(print (handler-case
           (multiple-value-bind (x y)
               (unwind-protect (values (+ 2d0 3d0) (* 2d0 3d0)) (error "cleanup"))
             (declare (double-float x y)) (+ x y))
         (error () :cleanup-error)))
(print (block done
         (multiple-value-bind (x y)
             (unwind-protect (values (+ 2d0 3d0) (* 2d0 3d0))
               (return-from done :local-cleanup-exit))
           (declare (double-float x y)) (+ x y))))
(let ((function (compile nil '(lambda (a b)
                               (declare (double-float a b))
                               (multiple-value-bind (x y)
                                   (unwind-protect (values (+ a b) (* a b)) (setq a 99d0))
                                 (declare (double-float x y)) (< x y))))))
  (print (funcall function 2d0 3d0)))
