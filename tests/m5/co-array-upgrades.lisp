(dolist (type '(nil bit (eql 256) (integer 0 (65536))
                (unsigned-byte 2) (unsigned-byte 4) (unsigned-byte 7)
                (unsigned-byte 15) (unsigned-byte 31) (unsigned-byte 62)
                (unsigned-byte 63) (signed-byte 8) fixnum base-char character))
  (let ((upgraded (upgraded-array-element-type type)))
    (print upgraded)
    (print (equal upgraded (array-element-type (make-array 0 :element-type type))))))
(print (handler-case (array-has-fill-pointer-p nil) (type-error () :type-error)))
(print (array-has-fill-pointer-p (make-array 2 :fill-pointer 0)))
(print (array-has-fill-pointer-p (make-array '(2 2))))
(let ((string (make-string 3 :element-type 'base-char :initial-element #\A)))
  (print (list (stringp string) (simple-string-p string)
               (typep string 'base-string) (typep string 'simple-base-string)))
  (print (type-of string))
  (print (eq (string string) string))
  (print (string= string "AAA"))
  (print (array-element-type (remove #\A string)))
  (print (array-element-type (remove-duplicates string)))
  (print (typep (copy-seq string) 'base-string))
  (print (typep (concatenate 'base-string string) 'base-string))
  (setf (schar string 1) #\Z)
  (print (schar string 1))
  (print (handler-case (progn (setf (aref string 0) (code-char 128)) nil)
           (type-error () :type-error))))
(let ((array (make-array 1 :element-type nil)))
  (print (array-element-type array))
  (print (stringp array))
  (print (handler-case (aref array 0) (type-error () :type-error)))
  (print (handler-case (setf (aref array 0) nil) (type-error () :type-error))))
(deftype changing-element-type () 'bit)
(print (upgraded-array-element-type 'changing-element-type))
(deftype changing-element-type () 'character)
(print (upgraded-array-element-type 'changing-element-type))
(let ((string (make-array 7 :element-type 'base-char :initial-contents "aabbbaa" :fill-pointer 6)))
  (print (eq (string string) string))
  (print (equal (string-trim "a" string) "bbb"))
  (print (equal (string-left-trim "a" string) "bbba"))
  (print (equal (string-right-trim "a" string) "aabbb"))
  (print (handler-case (schar string 0) (type-error () :type-error))))
