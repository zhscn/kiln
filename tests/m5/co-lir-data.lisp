(let* ((literal (list 'identity))
       (module (kiln.kir:make-kmodule "data-producer"))
       (kiln.kir::*module* module))
  (kiln.kir:module-init "entry")
  (kiln.kir:module-data "entry" '(:static-function "run"))
  (kiln.kir::module-builtin :undefined-function :image)
  (kiln.kir::module-builtin :undefined-setf-function :image)
  (kiln.kir:module-data "cycle" '(:static-cons (:fixnum 7) (:object-data "cycle" :cons)))
  (kiln.kir:module-data "left" '(:static-mutable-cons (:object-data "kiln_nil" :general)
                                                     (:object-data "kiln_nil" :general)))
  (kiln.kir:module-data "right" '(:static-mutable-cons (:object-data "kiln_nil" :general)
                                                      (:object-data "kiln_nil" :general)))
  (kiln.kir:module-data "large" '(:static-integer "18446744073709551616"))
  (kiln.kir::module-object-cell "saved" '(:object-data "kiln_nil" :general))
  (kiln.kir::module-literal-table 1)
  (kiln.kir::module-object-cell "literal" '(:literal 0))
  (flet ((add-symbol (label name package)
           (let ((name-label (concatenate 'string label "-name"))
                 (package-label (concatenate 'string label "-package"))
                 (ordinary (concatenate 'string label "-ordinary"))
                 (setf-function (concatenate 'string label "-setf")))
             (kiln.kir:module-data name-label (cons :static-string (map 'list #'char-code name)))
             (when package
               (kiln.kir:module-data package-label (cons :static-string (map 'list #'char-code package))))
             (kiln.kir:module-data ordinary `(:static-builtin :undefined-function (:object-data ,label :general)))
             (kiln.kir:module-data setf-function `(:static-builtin :undefined-setf-function (:object-data ,label :general)))
             (kiln.kir:module-data label
               `(:static-symbol (:object-data ,name-label :general)
                 (:object-data ,(if package package-label "kiln_nil") :general)
                 (:object-data ,ordinary :general)
                 ,(if (equal package "KEYWORD") `(:object-data ,label :general) '(:unbound))
                 (:object-data "kiln_nil" :general) (:object-data ,setf-function :general))))))
    (add-symbol "keyword" "KEY" "KEYWORD")
    (add-symbol "uninterned-a" "NAME" nil)
    (add-symbol "uninterned-b" "NAME" nil))
  (let* ((data (kiln.kir::collect-lir-data module))
         (indices (kiln.kir::lir-data-indices data))
         (program
           `(:lir-module "data-producer"
             ,@(kiln.kir::lir-data-declarations data)
             (:function "run"
               (:vars (:left :obj) (:right :obj) (:cycle :obj) (:a :obj) (:b :obj)
                      (:nil :obj) (:large :obj) (:distinct :obj) (:cyclic :obj) (:x :word)
                      (:keyword :obj) (:missing :obj) (:different :obj) (:literal :obj))
               (:block :entry
                 (:set :nil (:nil))
                 (:set :left (:constant ,(gethash "left" indices)))
                 (:set :right (:constant ,(gethash "right" indices)))
                 (:set :x (:eq :left :right)) (:set :distinct (:fixnum-tag :x))
                 (:set :cycle (:constant ,(gethash "cycle" indices)))
                 (:set :a (:field-ref :cons.cdr :cycle)) (:set :x (:eq :a :cycle))
                 (:set :cyclic (:fixnum-tag :x))
                 (:set :a (:fixnum 42)) (:alloc :a :cons :heap (:a :nil))
                 (:field-set :cons.car :left :a) (:cell-set 0 :a)
                 (:set :a (:nil)) (:runtime :a :gc ())
                 (:set :a (:field-ref :cons.car :left)) (:set :b (:cell-ref 0))
                 (:set :x (:eq :a :b)) (:set :b (:fixnum-tag :x))
                 (:set :large (:constant ,(gethash "large" indices)))
                 (:set :keyword (:constant ,(gethash "keyword" indices)))
                 (:set :missing (:field-ref :symbol.function :keyword))
                 (:set :x (:undefined-function-p :missing)) (:set :missing (:fixnum-tag :x))
                 (:set :left (:constant ,(gethash "uninterned-a" indices)))
                 (:set :right (:constant ,(gethash "uninterned-b" indices)))
                 (:set :x (:eq :left :right)) (:set :different (:fixnum-tag :x))
                 (:set :literal (:cell-ref 1))
                 (:return (:distinct :cyclic :a :b :large :keyword :missing :different :literal))))))
         (direct (kiln.sys:%primop :compile-program program (vector literal)
                                  kiln.kir::+backend-target-fingerprint+))
         (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
         (decoded (kiln.sys:%primop :compile-packet packet (vector literal))))
    (dolist (function (list direct decoded))
      (let ((results (multiple-value-list (funcall function))))
        (print (append (butlast results) (list (eq (car (last results)) literal))))))))
