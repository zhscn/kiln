(let* ((module (kiln.kir:make-kmodule "function-producer"))
       (kiln.kir::*module* module))
  (kiln.kir:module-init "entry")
  (kiln.kir:module-data "entry" '(:static-function "run"))
  (kiln.kir:module-data "loop-entry" '(:static-function "loop"))
  (kiln.kir:module-data "name" '(:static-string 114 117 110))
  (kiln.kir:module-data "a-name" '(:static-string 65))
  (kiln.kir:module-data "b-name" '(:static-string 66))
  (kiln.kir:module-data "r-name" '(:static-string 82))
  (kiln.kir:module-data "names"
    '(:static-vector (:object-data "a-name" :general) (:object-data "b-name" :general)
                     (:object-data "r-name" :general)))
  (kiln.kir:module-data "debug"
    '(:static-vector (:object-data "name" :general) (:object-data "kiln_nil" :general)
                     (:fixnum 0) (:fixnum 0) (:object-data "names" :general)))
  (kiln.kir:with-function ("run")
    (let ((a (kiln.kir:new-var)) (b (kiln.kir:new-var))
          (result (kiln.kir:new-var)) (count (kiln.kir:new-var :raw))
          (returned-count (kiln.kir:new-var :raw)) (flag (kiln.kir:new-var :raw))
          (wrong (kiln.kir:new-block)) (check-a (kiln.kir:new-block))
          (bad-a (kiln.kir:new-block)) (check-b (kiln.kir:new-block))
          (bad-b (kiln.kir:new-block)) (choose (kiln.kir:new-block))
          (add (kiln.kir:new-block)) (subtract (kiln.kir:new-block))
          (overflow (kiln.kir:new-block)) (success (kiln.kir:new-block)))
      (kiln.kir::label-var a 0) (kiln.kir::label-var b 1) (kiln.kir::label-var result 2)
      (setf (kiln.kir::kfunc-debug kiln.kir::*func*) '(:debug (:object-data "debug" :general)))
      (kiln.kir:emit '(:poll :entry-retry :nil))
      (kiln.kir:emit `(:receive-prefix (,a ,b) ,count))
      (kiln.compiler::br `(:ne ,count 2) wrong check-a)
      (kiln.kir:start-block wrong)
      (kiln.kir:emit `(:signal-error 3 (:fixnum-tag ,count) :nil))
      (kiln.kir:start-block check-a)
      (kiln.kir:emit `(:guarded-class-test ,flag ,kiln.kir::+packet-class-fixnum+ ,a))
      (kiln.compiler::br flag check-b bad-a)
      (kiln.kir:start-block bad-a) (kiln.kir:emit `(:signal-error 1 ,a :nil))
      (kiln.kir:start-block check-b)
      (kiln.kir:emit `(:guarded-class-test ,flag ,kiln.kir::+packet-class-fixnum+ ,b))
      (kiln.compiler::br flag choose bad-b)
      (kiln.kir:start-block bad-b) (kiln.kir:emit `(:signal-error 1 ,b :nil))
      (kiln.kir:start-block choose)
      (kiln.compiler::br `(:fixnum-lt ,a ,b) add subtract)
      (kiln.kir:start-block add)
      (kiln.kir:emit `(:fixnum-add-ovf ,result ,flag ,a ,b))
      (kiln.compiler::br flag overflow success)
      (kiln.kir:start-block subtract)
      (kiln.kir:emit `(:fixnum-sub-ovf ,result ,flag ,a ,b))
      (kiln.compiler::br flag overflow success)
      (kiln.kir:start-block overflow) (kiln.kir:emit `(:signal-error 2 ,a :nil))
      (kiln.kir:start-block success)
      (kiln.kir:emit `(:set ,returned-count 1))
      (kiln.kir:emit `(:return ,result ,returned-count))))
  (kiln.kir:with-function ("loop")
    (let ((n (kiln.kir:new-var)) (sum (kiln.kir:new-var)) (count (kiln.kir:new-var :raw))
          (head (kiln.kir:new-block)) (body (kiln.kir:new-block)) (done (kiln.kir:new-block)))
      (kiln.kir:emit `(:receive-prefix (,n) ,count))
      (kiln.kir:emit `(:set ,sum (:fixnum-tag 0)))
      (kiln.compiler::jump head)
      (kiln.kir:start-block head) (kiln.kir:emit '(:poll :loop :nil))
      (kiln.compiler::br `(:fixnum-le ,n (:fixnum-tag 0)) done body)
      (kiln.kir:start-block body)
      (kiln.kir:emit `(:set ,sum (:fixnum-add ,sum ,n)))
      (kiln.kir:emit `(:set ,n (:fixnum-sub ,n (:fixnum-tag 1))))
      (kiln.compiler::jump head)
      (kiln.kir:start-block done) (kiln.kir:emit `(:return ,sum 1))))
  (let* ((program (kiln.kir::normalize-lir-module module))
         (direct (kiln.sys:%primop :compile-program program #() kiln.kir::+backend-target-fingerprint+))
         (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
         (decoded (kiln.sys:%primop :compile-packet packet #())))
    (dolist (function (list direct decoded))
      (kiln.sys:%gc)
      (print (list (multiple-value-list (funcall function 7 9))
                   (multiple-value-list (funcall function 20 4))
                   (multiple-value-list (funcall function -2 3)))))
    (handler-case (funcall direct 1)
      (program-error () (print :arity)))
    (handler-case (funcall decoded '(not-a-fixnum) 3)
      (type-error () (print :type)))
    (setf (second (assoc :init (cddr program))) "loop")
    (let ((function (kiln.sys:%primop :compile-program program #() kiln.kir::+backend-target-fingerprint+)))
      (print (funcall function 4)))))

(dolist (case
          '((:raw-load "unknown pure operation"
             (:func "bad" (:vars (:a :obj))
               (:block :e (:set :a (:load 0 0)) (:return :a 1))))
            (:dynamic-count "multi-value view"
             (:func "bad" (:vars (:a :obj) (:b :obj) (:n :raw))
               (:block :e (:set :a (:fixnum-tag 1)) (:set :n 1)
                 (:fixnum-add-ovf :b :n :a :a) (:return :b :n))))))
  (let* ((module (kiln.kir:make-kmodule "rejected"))
         (kiln.kir::*module* module))
    (kiln.kir:module-data "entry" '(:static-function "bad"))
    (kiln.kir:module-init "entry")
    (push (third case) (kiln.kir::kmodule-funcs module))
    (handler-case (kiln.kir::normalize-lir-module module)
      (error (condition)
        (print (and (search (second case) (princ-to-string condition)) (first case)))))))
