(declaim (notinline coerce))
(deftype coercion-vector () '(vector t))
(deftype coercion-double () 'double-float)
(deftype coercion-complex () '(complex double-float))
(let ((objects (list nil t 1 3/2 1.5 1.5d0 #\a "abc" '(1 2) #(1 2) #c(1 2))))
  (print (every (lambda (object) (eq object (coerce object (class-of object)))) objects)))
(print (equalp (coerce '(1 2) (find-class 'vector)) #(1 2)))
(print (equalp (coerce '(1 2) 'coercion-vector) #(1 2)))
(print (typep (coerce 1/2 'coercion-double) 'double-float))
(print (loop for object in '(0 3 5/3) always (eql object (coerce object 'complex))))
(print (typep (coerce 1.5 'complex) '(complex single-float)))
(print (typep (coerce 3 'coercion-complex) '(complex double-float)))
(print (equal (mapcar #'upgraded-complex-part-type
                      '(nil (or) (integer 2 1) integer rational float real
                            single-float double-float (member 1.0)))
              '(nil nil nil rational rational float real single-float double-float single-float)))
(print (typep #c(1/2 1/3) '(complex (integer 0 1))))
(print (not (typep #c(1 2) '(complex nil))))
(let ((string (make-array 3 :element-type 'character :initial-contents "abc"
                            :fill-pointer 1)))
  (print (char= (coerce string 'character) #\a)))
(print (eq (coerce '(setf car) 'function) (fdefinition '(setf car))))
(print (every (lambda (spec)
                (handler-case (progn (coerce 3 spec) nil)
                  (type-error (condition)
                    (and (eql (type-error-datum condition) 3)
                         (equal (type-error-expected-type condition) spec)))))
              '((complex nil) (double-float 0d0 1d0))))
(let* ((class (make-instance 'standard-class :direct-superclasses
                             (list (find-class 'standard-object))))
       (object (make-instance class)))
  (print (and (typep object class) (eq (coerce object class) object))))
