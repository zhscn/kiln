(defun double-multiple-preserved (a b)
  (declare (double-float a b))
  (multiple-value-bind (x y marker)
      (let ((local a))
        (declare (double-float local))
        (multiple-value-prog1 (values (+ local b) (* local b) (cons :saved nil))
          (setq local 99d0)
          (print :after-values)
          (values :ignored :also-ignored)))
    (declare (double-float x y))
    (print (+ x y)) (print marker)))
(double-multiple-preserved 2d0 3d0)
(let ((x 2d0))
  (declare (double-float x))
  (multiple-value-bind (a b)
      (multiple-value-prog1 (values x (+ x 1d0)) (setq x 99d0))
    (declare (double-float a b))
    (print (+ a b)) (print x)))
(print (block done
         (multiple-value-bind (x y)
             (multiple-value-prog1 (values (+ 2d0 3d0) (* 2d0 3d0))
               (return-from done :after-exit))
           (declare (double-float x y)) (+ x y))))
(print (handler-case
           (multiple-value-bind (x y)
               (multiple-value-prog1 (values (+ 2d0 3d0) (* 2d0 3d0)) (error "after-values"))
             (declare (double-float x y)) (+ x y))
         (error () :after-error)))
(let ((function (compile nil '(lambda (a b)
                               (declare (double-float a b))
                               (multiple-value-bind (x y)
                                   (let ((local a))
                                     (declare (double-float local))
                                     (multiple-value-prog1 (values (+ local b) (* local b))
                                       (setq local 99d0)))
                                 (declare (double-float x y)) (< x y))))))
  (print (funcall function 2d0 3d0)))
