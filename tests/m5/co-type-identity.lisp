(deftype literal-type-parameter (object) `(eql ,object))
(defun check-literal-types (left right)
  (let ((a `(eql ,left)) (b `(eql ,right)))
    (print (multiple-value-list (subtypep a b)))
    (print (multiple-value-list (subtypep `(and t ,a) `(and t ,b))))
    (print (multiple-value-list (subtypep `(literal-type-parameter ,left)
                                         `(literal-type-parameter ,right))))))
(check-literal-types (copy-seq "abc") (copy-seq "abc"))
(check-literal-types (list 'a) (list 'a))
(let ((shared (list 'a)))
  (print (multiple-value-list (subtypep `(member 10 ,shared 20)
                                       `(member 20 10 ,shared)))))
(let* ((left (list 'a)) (right (list 'a)) (type `(eql ,left)))
  (print (multiple-value-list (subtypep type `(eql ,left))))
  (setf (second type) right)
  (print (multiple-value-list (subtypep type `(eql ,left)))))
(defgeneric identity-generic (object))
(defmethod identity-generic ((object t)) object)
(let ((function #'identity-generic))
  (print (eq (type-of function) 'standard-generic-function))
  (print (multiple-value-list (subtypep (type-of function) (class-of function)))))
(let* ((name (gensym "NAMED-CLASS")) (renamed (gensym "NEW-NAME"))
       (class (eval `(defclass ,name () ()))) (object (make-instance class)))
  (print (eq (type-of object) name))
  (print (eq (setf (class-name class) renamed) renamed))
  (print (eq (find-class name) class))
  (print (null (find-class renamed nil)))
  (print (eq (type-of object) class))
  (setf (class-name class) nil)
  (print (and (eq (type-of object) class) (typep object class))))
(let* ((name (gensym "UNBOUND-CLASS")) (class (eval `(defclass ,name () ())))
       (object (make-instance class)))
  (setf (find-class name) nil)
  (print (eq (type-of object) class)))
(defvar *rename-updates* 0)
(defclass rename-stable-layout () ((value :initform 42)))
(defmethod update-instance-for-redefined-class :after
    ((object rename-stable-layout) added discarded plist &rest initargs)
  (declare (ignore added discarded plist initargs))
  (incf *rename-updates*))
(let ((object (make-instance 'rename-stable-layout)))
  (setf (class-name (class-of object)) nil)
  (print (list (slot-value object 'value) *rename-updates*)))
