(handler-bind ((warning #'muffle-warning))
(defun generic-definition-error-p (form)
  (handler-case (progn (eval form) nil) (program-error () t)))
(print (generic-definition-error-p '(defgeneric duplicate-doc (x)
                                     (:documentation "a") (:documentation "b"))))
(print (generic-definition-error-p '(defgeneric unknown-generic-option (x) (:unknown t))))
(dolist (option '((:method-class nil) (:generic-function-class nil) (:method-combination nil)))
  (print (handler-case (progn (eval `(defgeneric invalid-explicit-option (x) ,option)) nil)
           (error () t))))
(defun ordinary-generic-conflict () :ordinary)
(print (generic-definition-error-p '(defgeneric ordinary-generic-conflict ())))
(print (ordinary-generic-conflict))
(defmacro macro-generic-conflict () :macro)
(print (generic-definition-error-p '(defgeneric macro-generic-conflict ())))
(print (generic-definition-error-p '(defgeneric if ())))
(defgeneric stable-generic (x))
(defmethod stable-generic ((x t)) (list x))
(print (handler-case (progn (eval '(defgeneric stable-generic (x y))) nil)
         (error () t)))
(print (stable-generic :unchanged))
(print (handler-case (progn (ensure-generic-function 'stable-generic :lambda-list '(x y)) nil)
         (error () t)))
(print (stable-generic :still-unchanged))
(defgeneric order-generic (left right))
(defmethod order-generic ((left integer) (right t)) (declare (ignore left right)) :left)
(defmethod order-generic ((left t) (right integer)) (declare (ignore left right)) :right)
(print (order-generic 1 2))
(ensure-generic-function 'order-generic :lambda-list '(left right)
                         :argument-precedence-order '(right left))
(print (order-generic 1 2))
(defclass retained-method-class (standard-method) ())
(defgeneric retained-options (x) (:method-class retained-method-class) (:method-combination +))
(defmethod retained-options + ((x number)) (declare (ignore x)) 1)
(defmethod retained-options + ((x t)) (declare (ignore x)) 2)
(print (retained-options 1))
(eval '(defgeneric retained-options (object)))
(print (retained-options 1))
(print (eq (class-name (#+kiln clostrophilia:generic-function-method-class
                       #-kiln sb-mop:generic-function-method-class
                       #'retained-options)) 'retained-method-class))
(let ((name (gensym "EMPTY-GENERIC")))
  (ensure-generic-function name :lambda-list '(x))
  (eval `(defgeneric ,name (x y)))
  (eval `(defmethod ,name ((x t) (y t)) (list x y)))
  (print (funcall name 1 2))))
