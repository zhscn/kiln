(defun macro-pattern-contracts ()
  (dolist (form '((macrolet ((m (&rest (x y z)) `(quote (,x ,y ,z)))) (m 1 2 3))
                  (macrolet ((m (&body (x y z)) `(quote (,x ,y ,z)))) (m 1 2 3))
                  (macrolet ((m (()) :matched)) (m ()))
                  (macrolet ((m (&rest ()) :matched)) (m))
                  (macrolet ((m (&rest (x &optional (y (1+ x))))
                               `(quote (,x ,y)))) (m 4))
                  (macrolet ((m (&body (&key ((:pair (x y)) '(7 8))))
                               `(quote (,x ,y)))) (m))
                  (macrolet ((m (&rest (x . y)) `(quote (,x ,y)))) (m 1 2 3))
                  (destructuring-bind (&whole (a . b) c . d) '(1 . 2)
                    (list a b c d))
                  (destructuring-bind ((&whole (a b) c d)) '((1 2))
                    (list a b c d))
                  (let ((calls 0))
                    (list (destructuring-bind (&whole (a b) c d)
                              (progn (incf calls) '(1 2))
                            (list a b c d)) calls))
                  (destructuring-bind (&rest ()) nil :matched)))
    (print (eval form)))
  (dolist (form '((macrolet ((m (()) :bad)) (m (1)))
                  (macrolet ((m (&rest ()) :bad)) (m 1))
                  (macrolet ((m (&rest (x y)) `(quote (,x ,y)))) (m 1))
                  (destructuring-bind (&whole (a) &rest tail) '(1 2)
                    (list a tail))
                  (destructuring-bind (&rest ()) '(1) :bad)))
    (print (handler-case (progn (eval form) nil) (error () :rejected)))))
(macro-pattern-contracts)
#+kiln
(let ((kiln.kernel::*eval-function* nil))
  (macro-pattern-contracts))
#-kiln
(macro-pattern-contracts)
