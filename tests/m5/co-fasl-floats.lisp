(defvar *fasl-float-patterns* (list (kiln.sys:%primop :make-single-float-bits #x7f800000)
           (kiln.sys:%primop :make-single-float-bits #xff800000)
           (kiln.sys:%primop :make-single-float-bits #x7fc00123)
           (kiln.sys:%primop :make-single-float-bits #x80000000)
           (kiln.sys:%primop :make-double-float-bits #x7ff00000 0)
           (kiln.sys:%primop :make-double-float-bits #xfff00000 0)
           (kiln.sys:%primop :make-double-float-bits #x7ff80000 #x123)
           (kiln.sys:%primop :make-double-float-bits #x80000000 0)))
(let* ((source "build/test/co-fasl-floats-source.lisp")
       (output nil) (*compile-verbose* nil))
  (unwind-protect
       (progn
         (with-open-file (stream source :direction :output :if-exists :supersede)
           (write-string "(defun fasl-float-patterns ()
  '#.*fasl-float-patterns*)" stream))
         (setf output (compile-file source))
         (load output)
         (let ((values (funcall 'fasl-float-patterns)))
           (print (equal (mapcar (lambda (value) (kiln.sys:%primop :single-float-bits value))
                                (subseq values 0 4))
                         '(#x7f800000 #xff800000 #x7fc00123 #x80000000)))
           (print (equal (mapcar (lambda (value)
                                  (list (kiln.sys:%primop :double-float-high-bits value)
                                        (kiln.sys:%primop :double-float-low-bits value)))
                                (subseq values 4))
                         '((#x7ff00000 0) (#xfff00000 0) (#x7ff80000 #x123) (#x80000000 0))))))
    (when output (delete-file output))
    (delete-file source)))
