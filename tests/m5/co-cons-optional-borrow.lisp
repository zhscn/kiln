(flet ((borrow (x &optional (y x supplied))
         (print supplied) (car y)))
  (declare (notinline borrow))
  (let ((pair (cons 17 19)))
    (print (borrow pair)) (print (borrow nil pair))))
(flet ((borrow (x &optional (y x)) y))
  (declare (notinline borrow))
  (let ((pair (cons 23 29))) (print (car (borrow pair)))))
(labels ((borrow (n x &optional (y x))
           (if (zerop n) (car y) (borrow (1- n) x y))))
  (declare (notinline borrow))
  (let ((pair (cons 31 37))) (print (borrow 3 pair))))
(let ((saved nil))
  (flet ((retain (x &optional (y (setq saved x))) y))
    (declare (notinline retain))
    (let ((pair (cons 41 43))) (retain pair)))
  (print saved))
(let ((function (compile nil '(lambda ()
                               (flet ((borrow (x &optional (y x)) y))
                                 (declare (notinline borrow))
                                 (let ((pair (cons 47 53))) (car (borrow pair))))))))
  (print (funcall function)))
