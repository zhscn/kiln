(defun block-secondary-function (flag)
  (flet ((target (x) (+ x 7)))
    (declare (notinline target))
    (multiple-value-bind (marker f)
        (block done
          (if flag (return-from done (values :early #'target)))
          (values :normal #'target))
      (print marker) (funcall f 3))))
(print (block-secondary-function t))
(print (block-secondary-function nil))
(flet ((target (x) (+ x 7)) (other (x) (- x 7)))
  (declare (notinline target other))
  (multiple-value-bind (marker f)
      (block done
        (unwind-protect (return-from done (values :original #'target))
          (return-from done (values :replacement #'other))))
    (print marker) (print (funcall f 3))))
(dolist (flag '(t nil))
  (flet ((target (x) (+ x 7)) (other (x) (- x 7)))
    (declare (notinline target other))
    (multiple-value-bind (unused f)
        (block done
          (if flag (return-from done (values 1 #'target)))
          (values 2 #'other))
      (print (funcall f 3)))))
(let ((function (compile nil '(lambda (flag)
                               (flet ((target (x) (+ x 7)))
                                 (declare (notinline target))
                                 (multiple-value-bind (unused f)
                                     (block done
                                       (if flag (return-from done (values 1 #'target)))
                                       (values 2 #'target))
                                   (funcall f 3)))))))
  (print (funcall function t)) (print (funcall function nil)))
