(dolist (form '((defclass invalid-slots () (x (x :initform 1)))
                (defclass invalid-initargs () () (:default-initargs :x 1 :x 2))
                (defclass invalid-initform () ((x :initform 1 :initform 2)))
                (defclass invalid-allocation () ((x :allocation :instance :allocation :class)))
                (defclass invalid-type () ((x :type integer :type number)))
                (defclass invalid-documentation () ((x :documentation "a" :documentation "b")))))
  (print (handler-case (progn (macroexpand-1 form) nil)
           (program-error () t))))
(defclass repeated-slot-options ()
  ((x :initarg :x :initarg :also-x :reader read-x :reader also-read-x)))
(let ((object (make-instance 'repeated-slot-options :also-x 7)))
  (print (list (read-x object) (also-read-x object))))
