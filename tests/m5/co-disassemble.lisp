(defun disassembly-probe (x) (+ x 1))
(defun (setf disassembly-probe) (value cell) (setf (car cell) value))
(defgeneric disassembly-generic (x))
(defmethod disassembly-generic ((x t)) x)
(dolist (designator (list 'car #'disassembly-probe '(setf disassembly-probe)
                         '(lambda (x) (cons x x)) #'disassembly-generic
                         (funcall (compile nil '(lambda (x) (lambda (y) (+ x y)))) 17)))
  (let ((result t) (original (fdefinition 'disassembly-probe)))
    (print (plusp (length (with-output-to-string (*standard-output*)
                           (setf result (disassemble designator))))))
    (print (null result))
    (print (eq original (fdefinition 'disassembly-probe)))))
(let* (#+kiln (kiln.kernel::*compile-function* nil)
       (function (compile nil '(lambda (x) (cons x x))))
       (text (with-output-to-string (*standard-output*) (disassemble function))))
  (print (plusp (length text)))
  #+kiln (print (not (null (search "Bytecode" text))))
  #-kiln (print t)
  (print (funcall function 7)))
(dolist (object '(17 1.5 #\a "bad" #(a b) (setf) (setf a b)))
  (print (handler-case (disassemble object)
           (type-error (condition) (eq (type-error-datum condition) object)))))
