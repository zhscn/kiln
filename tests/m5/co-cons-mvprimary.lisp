(let* ((inner (cons 17 nil)) (outer (cons inner nil)))
  (flet ((project (x) (car x)))
    (declare (notinline project))
    (multiple-value-bind (x ignored) (project outer)
      (rplacd x outer)
      (print (car x)) (print (eq (cdr x) outer)) (print ignored))))
