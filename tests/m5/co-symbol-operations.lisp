(let* ((name (make-array 5 :element-type 'character :initial-contents "abcde"
                           :fill-pointer 3))
       (symbol (make-symbol name)))
  (print (list (symbol-name symbol) (symbol-package symbol))))
(let* ((source (make-symbol "COPY")) (value (list 1))
       (function (lambda (x) (+ x 1))) (plist (list :a value :b 2)))
  (setf (symbol-value source) value (symbol-function source) function
        (symbol-plist source) plist)
  (let ((copy (copy-symbol source t)) (empty (copy-symbol source)))
    (print (list (eq (symbol-value copy) value) (eq (symbol-function copy) function)
                 (equal (symbol-plist copy) plist) (eq (symbol-plist copy) plist)
                 (null (symbol-package copy)) (boundp empty) (fboundp empty)
                 (symbol-plist empty)))
    (setf (get copy :a) :changed)
    (print (eq (get source :a) value))))
(let ((symbol (make-symbol "DYNAMIC")))
  (set symbol :global)
  (print (progv (list symbol) (list :local)
           (list (set symbol :changed) (symbol-value symbol))))
  (print (symbol-value symbol)))
(let* ((symbol (make-symbol "PROPS")) (plist (list :a 1 :b 2 :a 3)))
  (setf (symbol-plist symbol) plist)
  (print (eq (remprop symbol :a) plist))
  (print (symbol-plist symbol))
  (print (not (null (remprop symbol :a))))
  (print (symbol-plist symbol))
  (print (remprop symbol :a)))
(let ((*gensym-counter* 40))
  (print (list (symbol-name (gensym)) (symbol-name (gensym 99))
               (symbol-name (gensym "X")) *gensym-counter*)))
(let ((*gensym-counter* 100))
  (gentemp "SYMBOL-TEST-")
  (print (= *gensym-counter* 100)))
(print (every (lambda (argument)
                (handler-case (progn (gensym argument) nil)
                  (type-error (condition) (eql argument (type-error-datum condition)))))
              (list nil -1 1.5 '(a))))
