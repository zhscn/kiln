(handler-bind ((warning #'muffle-warning))
(defgeneric replace-initial (x) (:method ((x symbol)) :initial))
(defmethod replace-initial ((x integer)) (declare (ignore x)) :external)
(print (replace-initial 'x))
(eval '(defgeneric replace-initial (x) (:method ((x t)) :new)))
(print (replace-initial 'x))
(print (replace-initial 1))
(defmethod replace-initial ((x t)) (declare (ignore x)) :replacement)
(eval '(defgeneric replace-initial (x)))
(print (replace-initial 'x))
(defgeneric initial-arity (x) (:method ((x t)) x))
(print (initial-arity 1))
(eval '(defgeneric initial-arity (x y) (:method ((x t) (y t)) (list x y))))
(print (initial-arity 1 2))
(let ((result :lexical))
  (defgeneric initial-lexical (x) (:method ((x t)) (declare (ignore x)) result)))
(print (initial-lexical 1))
(defgeneric initial-failure (x) (:method ((x symbol)) :initial))
(defmethod initial-failure ((x t)) (declare (ignore x)) :retained)
(print (initial-failure 'x))
(print (handler-case (progn (eval '(defgeneric initial-failure (x y))) nil)
         (error () t)))
(print (initial-failure 'x))
(let ((method (find-method #'initial-arity nil (list (find-class 't) (find-class 't)))))
  (remove-method #'initial-arity method)
  (defgeneric moved-initial (x y))
  (add-method #'moved-initial method)
  (eval '(defgeneric initial-arity (x y)))
  (print (moved-initial 3 4)))
(let ((name (gensym "INITIAL-SETF")))
  (eval `(defgeneric (setf ,name) (value object)
           (:method (value (object symbol)) (declare (ignore value object)) :old)))
  (eval `(defgeneric (setf ,name) (value object)
           (:method (value (object t)) (declare (ignore value object)) :new)))
  (print (funcall (fdefinition `(setf ,name)) 1 'x))))
