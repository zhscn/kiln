(defconstant documented-core-constant 17 "A documented constant.")
(print (list (symbol-value nil) (symbol-value t) (boundp nil) (boundp t)))
(print (list (eval '(symbol-value nil)) (eval '(symbol-value t))))
(print (documentation 'documented-core-constant 'variable))
(print (eval '(defconstant documented-core-constant 17 "Updated documentation.")))
(print (documentation 'documented-core-constant 'variable))
(defun rejected-values-list (value)
  (handler-case (multiple-value-list (values-list value))
    (type-error (condition)
      (list :rejected (type-error-datum condition)
            (type-error-expected-type condition)
            (typep (type-error-datum condition)
                   (type-error-expected-type condition))))))
(dolist (value '(nil (1) (1 2 3) :atom (1 . :tail) (1 2 3 . :tail)))
  (print (rejected-values-list value)))
(dolist (form '((etypecase :bad (integer :integer) (string :string))
                (etypecase :bad)
                (etypecase '(1 2) (cons :cons) (symbol :symbol))))
  (print (handler-case (eval form)
           (type-error (condition)
             (let ((expected (type-error-expected-type condition)))
               (list (type-error-datum condition)
                     (if (subtypep expected nil) :empty-type expected)
                     (typep (type-error-datum condition) expected)))))))

(print (list (fboundp 'declaration) (fboundp 'method-combination)))
