(defvar *lir-numeric-function* nil)
(defvar *lir-numeric-eql* nil)
(defvar *lir-numeric-sign* nil)

(let ((session (kiln.compiler:make-session)))
  (multiple-value-bind (module original-literals)
      (kiln.compiler:compile-module
       (kiln.compiler::front-end-forms
        '((setq *lir-numeric-function*
                (lambda (a h v tail n)
                  (kiln.sys:%gc)
                  (list (+) (- a) (zerop a) (plusp a) (minusp a)
                        (nthcdr n tail) (kiln.sys:%primop :hash-mix h v))))
          (setq *lir-numeric-eql* (lambda (a b) (eql a b)))
          (setq *lir-numeric-sign*
                (lambda (a)
                  (declare (type fixnum a))
                  (list (zerop a) (plusp a) (minusp a)))))
        session)
       "numeric-producer" :session session :image t)
    (multiple-value-bind (program literals)
        (kiln.kir::normalize-lir-module module original-literals)
      (let* ((direct (kiln.sys:%primop :compile-program program literals kiln.kir::+backend-target-fingerprint+))
             (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
             (decoded (kiln.sys:%primop :compile-packet packet literals)))
        (dolist (initializer (list direct decoded))
          (funcall initializer)
          (let ((tail (list 'first 'second 'third)))
            (print (mapcar
                    (lambda (case)
                      (destructuring-bind (a h v hash) case
                        (equal (funcall *lir-numeric-function* a h v tail 1)
                               (list 0 (- a) (zerop a) (plusp a) (minusp a) (cdr tail) hash))))
                    (list (list 0 0 0 0) (list 1 1 2 3298534884633)
                          (list -1 -1 1 -2199023256422)
                          (list most-negative-fixnum most-positive-fixnum -7 -4611679421357618638)
                          (list (ash 1 80) most-negative-fixnum most-positive-fixnum -1099511628211)
                          (list 1/2 0 0 0) (list 1.5f0 0 0 0) (list 2.5d0 0 0 0))))
            (print (mapcar (lambda (a) (funcall *lir-numeric-sign* a)) '(0 1 -1)))
            (handler-case (funcall *lir-numeric-function* 0 0 0 tail -1)
              (type-error () (print :index))))
          (let* ((big (ash 1 80)) (same (vector 'identity))
                 (cases (list (list nil t nil) (list 0 #\a nil)
                              (list (cons 1 2) (cons 1 2) nil)
                              (list (vector 1) (vector 1) nil)
                              (list same same t) (list big (+ big 1) nil)
                              (list big (+ big big (- big)) t)
                              (list 1/2 (- 3/4 1/4) t)
                              (list 2.5d0 (+ 2.0d0 0.5d0) t)
                              (list 1.0f0 2.0f0 nil))))
            (print (mapcar (lambda (case)
                             (eq (funcall *lir-numeric-eql* (first case) (second case)) (third case)))
                           cases))))))))
