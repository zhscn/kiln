(defun cons-multiple-join (flag)
  (let* ((inner (cons 17 nil)) (outer (cons inner nil)))
    (multiple-value-bind (x y missing)
        (if flag (progn (print :yes) (values inner outer))
            (progn (print :no) (values outer inner)))
      (rplacd x y)
      (print (eq (cdr x) y)) (print missing)
      (print (if flag (car x) (car y))))))
(cons-multiple-join t)
(cons-multiple-join nil)
(defun return-joined-child (flag)
  (let* ((inner (cons 23 nil)) (outer (cons inner nil)))
    (multiple-value-bind (x y)
        (if flag (values inner outer) (values outer inner))
      (if flag x y))))
(print (return-joined-child t))
(print (return-joined-child nil))
(let ((function (compile nil '(lambda (flag)
                               (let* ((inner (cons 31 nil)) (outer (cons inner nil)))
                                 (multiple-value-bind (x y)
                                     (if flag (values inner outer) (values outer inner))
                                   (rplacd x y)
                                   (eq (cdr x) y)))))))
  (print (funcall function t)) (print (funcall function nil)))
