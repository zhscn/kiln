(defvar *reinit-token* nil)
(handler-bind ((warning #'muffle-warning))
(defgeneric lookup-method (x))
(defmethod lookup-method ((x integer)) x)
(print (handler-case (progn (find-method #'lookup-method nil nil nil) nil) (error () t)))
(print (handler-case (progn (find-method #'lookup-method nil
                                       (list (find-class 't) (find-class 't)) nil) nil)
         (error () t)))
(print (null (find-method #'lookup-method nil (list (find-class 'symbol)) nil)))
(defclass reinit-target () ((value :initarg :value :initform 10)))
(let ((object (make-instance 'reinit-target)))
  (print (handler-case (progn (reinitialize-instance object :garbage t) nil)
           (program-error () t)))
  (print (eq object (reinitialize-instance object :value 20)))
  (print (slot-value object 'value))
  (print (eq object (reinitialize-instance object :garbage t :allow-other-keys t)))
  (print (handler-case (progn (reinitialize-instance object :garbage t
                                                     :allow-other-keys nil :allow-other-keys t) nil)
           (program-error () t))))
(defmethod reinitialize-instance :after ((object reinit-target) &key token)
  (declare (ignore object)) (setf *reinit-token* token))
(let ((object (make-instance 'reinit-target)))
  (reinitialize-instance object :token :accepted)
  (print *reinit-token*))
(defclass unrelated-reinit () ())
(defmethod reinitialize-instance :after ((object unrelated-reinit) &key &allow-other-keys)
  (declare (ignore object)))
(let ((object (make-instance 'reinit-target)))
  (print (handler-case (progn (reinitialize-instance object :not-a-token t) nil)
           (program-error () t))))
(let ((chosen (make-instance 'reinit-target)))
  (eval `(defmethod shared-initialize :after ((object (eql ,chosen)) (slots (eql nil)) &key extra)
           (declare (ignore object slots extra))))
  (print (eq chosen (reinitialize-instance chosen :extra t))))
(let* ((name (gensym "RENAMED-CLASS")) (other-name (gensym "NEW-CLASS-NAME"))
       (old (eval `(defclass ,name () ((value :initform :old)))))
       (object (make-instance old)))
  (setf (class-name old) other-name)
  (let ((new (eval `(defclass ,name () ((value :initform :new))))))
    (print (and (not (eq old new)) (eq (class-of object) old)
                (typep object old) (not (typep object new))
                (eq (class-name old) other-name) (eq (class-name new) name)))
    (print (list (slot-value object 'value) (slot-value (make-instance new) 'value))))))
