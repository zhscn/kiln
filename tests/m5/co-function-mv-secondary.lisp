(defun secondary-function (flag)
  (flet ((target (x) (+ x 7)) (other (x) (- x 7)))
    (declare (notinline target other))
    (multiple-value-bind (unused f)
        (if flag (values 1 #'target) (progn (print :else) (values 2 #'target)))
      (funcall f 3))))
(print (secondary-function t))
(print (secondary-function nil))
(flet ((target (x) (+ x 7)) (other (x) (- x 7)))
  (declare (notinline target other))
  (let ((current #'target))
    (multiple-value-bind (unused f extra)
        (values 1 current (setq current #'other))
      (print (funcall f 3)) (print (funcall current 4)) (print (funcall extra 5)))))
(dolist (flag '(t nil))
  (flet ((target (x) (+ x 7)) (other (x) (- x 7)))
    (declare (notinline target other))
    (multiple-value-bind (unused f)
        (if flag (values 1 #'target) (values 2 #'other))
      (print (funcall f 3)))))
(let ((function (compile nil '(lambda (flag)
                               (flet ((target (x) (+ x 7)))
                                 (declare (notinline target))
                                 (multiple-value-bind (unused f)
                                     (if flag (values 1 #'target) (values 2 #'target))
                                   (funcall f 3)))))))
  (print (funcall function t)) (print (funcall function nil)))
