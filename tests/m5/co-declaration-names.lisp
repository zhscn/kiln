(dolist (evaluator (list #'eval #+kiln #'kiln.kernel::maclina-eval #-kiln #'eval))
  (let ((warnings 0) (name (gensym "DECL")))
    (handler-bind ((warning (lambda (condition)
                             (incf warnings)
                             (muffle-warning condition))))
      (funcall evaluator `(let () (declare (,name)) nil)))
    (print (= warnings 1))
    (proclaim `(declaration ,name))
    (setf warnings 0)
    (print (handler-bind ((warning (lambda (condition)
                                    (incf warnings)
                                    (muffle-warning condition))))
             (funcall evaluator `(let ((x 7)) (declare (,name x) (fixnum x)) x))))
    (print (zerop warnings)))
  (dolist (object (list "x" (vector 1 2) 7))
    (print (loop for type in (list (type-of object) (class-of object))
                 collect (eql object
                              (funcall evaluator
                                       `(let ((value ',object))
                                          (declare (,type value))
                                          value))))))
  (dolist (kind '(type class structure condition))
    (let* ((name (gensym "TYPE"))
           (form (case kind
                   (type `(deftype ,name () 'integer))
                   (class `(defclass ,name () ()))
                   (structure `(defstruct ,name x))
                   (condition `(define-condition ,name (condition) ())))))
      (proclaim `(declaration ,name))
      (print (handler-case (progn (funcall evaluator form) nil) (error () t)))))
  (dolist (kind '(type class structure condition))
    (let* ((name (gensym "TYPE"))
           (form (case kind
                   (type `(deftype ,name () 'integer))
                   (class `(defclass ,name () ()))
                   (structure `(defstruct ,name x))
                   (condition `(define-condition ,name (condition) ())))))
      (funcall evaluator form)
      (print (handler-case (progn (proclaim `(declaration ,name)) nil) (error () t))))))
(print (handler-case (progn (proclaim '(declaration fixnum)) nil) (error () t)))
