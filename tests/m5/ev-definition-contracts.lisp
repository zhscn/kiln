(defun sample-compiler-macro (x) (1+ x))
(print (multiple-value-list
        (eval '(define-compiler-macro sample-compiler-macro (x) `(+ ,x 1)))))
(print (functionp (compiler-macro-function 'sample-compiler-macro)))
(print (funcall (compiler-macro-function 'sample-compiler-macro)
                '(sample-compiler-macro 9) nil))
(print (multiple-value-list
        (eval '(define-compiler-macro (setf sample-compiler-macro) (&whole form &rest args)
                 (declare (ignore args)) form))))
(print (functionp (compiler-macro-function '(setf sample-compiler-macro))))
(defun rejected-proclamation (form)
  (handler-case (progn (proclaim form) nil) (error () t)))
(dolist (form '(nil name (optimize . tail) (inline . tail) (notinline . tail)
               (type . tail) (ftype . tail) (type integer . tail)
               (integer . tail) (ftype (function (t) t) . tail)))
  (print (rejected-proclamation form)))
(print (proclaim '(optimize)))
(print (proclaim '(inline sample-compiler-macro)))
(let ((name (gensym "SPECIAL-DECLARATION")))
  (print (proclaim `(special ,name)))
  (print (eval `(let ((,name :dynamic)) (symbol-value ',name)))))
