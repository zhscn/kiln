(flet ((target (x) (+ x 7)) (other (x) (- x 7)))
  (declare (notinline target other))
  (let ((current #'target))
    (multiple-value-bind (unused f)
        (let ((snapshot current))
          (multiple-value-prog1 (values nil snapshot)
            (setq current #'other) (print :after-values)))
      (print (funcall f 3)) (print (funcall current 4)))))
(flet ((target (x) (+ x 7)))
  (declare (notinline target))
  (multiple-value-bind (unused f)
      (let ((current #'target))
        (multiple-value-bind (a b) (values nil current) (values a b)))
    (print (funcall f 3))))
(print (block done
         (flet ((target (x) (+ x 7)))
           (declare (notinline target))
           (multiple-value-bind (unused f)
               (multiple-value-prog1 (values nil #'target)
                 (return-from done :after-exit))
             (funcall f 3)))))
(let ((function (compile nil '(lambda ()
                               (flet ((target (x) (+ x 7)) (other (x) (- x 7)))
                                 (declare (notinline target other))
                                 (let ((current #'target))
                                   (multiple-value-bind (unused f)
                                       (let ((snapshot current))
                                         (multiple-value-prog1 (values nil snapshot) (setq current #'other)))
                                     (list (funcall f 3) (funcall current 4)))))))))
  (print (funcall function)))
