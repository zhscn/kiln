(defun inferred-double-loop (a b)
  (declare (double-float a b))
  (let ((x (+ a b)))
    (dotimes (i 3) (setq x (* x b)))
    (print x)
    (< x b)))
(print (inferred-double-loop 1d0 2d0))
(defun inferred-double-changing-type (a b)
  (declare (double-float a b))
  (let ((x (+ a b)))
    (setq x :changed)
    x))
(print (inferred-double-changing-type 1d0 2d0))
(let ((function (compile nil '(lambda (a b)
                               (declare (double-float a b))
                               (let ((x (+ a b))) (setq x (* x b)) (< x b))))))
  (print (funcall function -5d0 3d0))
  (print (handler-case (funcall function -5 3d0) (type-error () :type-error))))
(let ((x (+ 1d0 2d0)))
  (let ((reader (lambda () x)))
    (setq x :captured-change) (print (funcall reader))))
(let ((x (+ 1d0 2d0))) (multiple-value-bind () (setq x :empty-values)) (print x))
(let ((x (+ 1d0 2d0))) (print (list x x)))
