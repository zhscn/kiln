(define-method-combination binding-combination () ((methods *))
  (:arguments &whole whole x &optional (y :default yp) &rest rest &key (z :z zp))
  (:generic-function gf)
  `(list ,x ,y ,yp ,rest ,z ,zp ,whole ',gf
         ,@(mapcar (lambda (method) `(call-method ,method)) methods)))
(defgeneric bound-zero () (:method-combination binding-combination))
(defmethod bound-zero () :zero)
(let ((result (bound-zero)))
  (print (append (subseq result 0 7) (list (eq (eighth result) #'bound-zero)) (nthcdr 8 result))))
(defgeneric bound-key (x &optional y &key z) (:method-combination binding-combination))
(defmethod bound-key ((x integer) &optional y &key z) (declare (ignore x y z)) :integer)
(defmethod bound-key ((x (eql 1)) &optional y &key z) (declare (ignore x y z)) :one)
(let ((result (bound-key 1 2 :z 3)))
  (print (append (subseq result 0 7) (list (eq (eighth result) #'bound-key)) (nthcdr 8 result))))
(define-method-combination empty-arguments () ((methods *))
  (:arguments)
  `(call-method ,(first methods)))
(defgeneric empty-bound (x) (:method-combination empty-arguments))
(defmethod empty-bound ((x integer)) (1+ x))
(print (empty-bound 8))
(define-method-combination captured-arguments () ((around (:around)) (primary ()))
  (:arguments x)
  `(list ,x (call-method ,(first around) ((make-method (call-method ,(first primary)))))))
(defgeneric captured-bound (x) (:method-combination captured-arguments))
(defmethod captured-bound :around ((x integer)) (call-next-method (1+ x)))
(defmethod captured-bound ((x integer)) x)
(print (captured-bound 4))
(defparameter *combination-default* :captured)
(define-method-combination lexical-arguments () ((methods *))
  (:arguments &optional (x *combination-default*))
  `(list ,x (call-method ,(first methods))))
(defgeneric lexical-bound () (:method-combination lexical-arguments))
(defmethod lexical-bound () :method)
(print (lexical-bound))
(defgeneric rest-bound (x &optional y &rest rest) (:method-combination binding-combination))
(defmethod rest-bound ((x integer) &optional y &rest rest)
  (declare (ignore x y rest)) :method)
(print (handler-case (progn (rest-bound 1 2 :unknown 3) nil) (error () t)))
