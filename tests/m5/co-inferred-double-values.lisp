(defun inferred-double-values (a b flag)
  (declare (double-float a b))
  (multiple-value-bind (x y)
      (if flag (values (+ a b) (* a b))
          (unwind-protect (values (- a b) (/ a b)) (print :cleanup)))
    (dotimes (i 3) (setq x (* x b)))
    (print x) (print y) (< x y)))
(print (inferred-double-values 6d0 2d0 t))
(print (inferred-double-values 6d0 2d0 nil))
(multiple-value-bind (x y) (values (+ 1d0 2d0) (* 3d0 4d0))
  (setq x :changed) (print x) (print y))
(multiple-value-bind (x y) (if (identity nil) (values (+ 1d0 2d0) (* 3d0 4d0))
                             (values (- 4d0 2d0)))
  (print x) (print y))
(multiple-value-bind (x y) (values (+ 1d0 2d0) (* 3d0 4d0))
  (let ((reader (lambda () x)))
    (setq x :captured) (print (funcall reader)))
  (print y))
(defvar *inferred-values-saved* nil)
(let ((function (compile nil '(lambda (a b flag)
                               (declare (double-float a b))
                               (multiple-value-bind (x y)
                                   (if flag (values (+ a b) (* a b))
                                       (multiple-value-prog1 (values (- a b) (/ a b))
                                         (setq *inferred-values-saved* :saved)))
                                 (setq x (* x b)) (< x y))))))
  (print (funcall function -5d0 3d0 t))
  (print (funcall function -5d0 3d0 nil))
  (print *inferred-values-saved*)
  (print (handler-case (funcall function -5 3d0 t) (type-error () :type-error))))
