(defvar *lir-progv-a* :outside-a)
(defvar *lir-progv-b* :outside-b)
(defvar *lir-progv-state* nil)
(defvar *lir-progv-function* nil)

(let ((session (kiln.compiler:make-session)))
  (multiple-value-bind (module original-literals)
      (kiln.compiler:compile-module
       (kiln.compiler::front-end-forms
        '((setq *lir-progv-function*
                (lambda (symbols vals mode)
                  (catch 'done
                   (block finished
                    (progv symbols vals
                      (kiln.sys:%gc)
                      (let ((observed
                              (list (boundp (car symbols))
                                    (if (boundp (car symbols)) (symbol-value (car symbols)) :unbound)
                                    (boundp (cadr symbols))
                                    (if (boundp (cadr symbols)) (symbol-value (cadr symbols)) :unbound))))
                        (progv (list '*lir-progv-a*) (list :nested)
                          (kiln.sys:%gc)
                          (setq *lir-progv-state* *lir-progv-a*))
                        (cond ((eq mode :local) (return-from finished (values observed :local)))
                              ((eq mode :error) (car 1))
                              (mode (throw 'done (values observed :thrown)))
                              (t (values observed :normal))))))))))
        session)
       "progv-producer" :session session :image t)
    (multiple-value-bind (program literals)
        (kiln.kir::normalize-lir-module module original-literals)
      (let* ((direct (kiln.sys:%primop :compile-program program literals kiln.kir::+backend-target-fingerprint+))
             (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
             (decoded (kiln.sys:%primop :compile-packet packet literals)))
        (dolist (initializer (list direct decoded))
          (funcall initializer)
          (let* ((identity (vector 'identity)) (fresh (gensym))
                 (cases (list (list '(*lir-progv-a* *lir-progv-b*) (list identity :local-b) nil)
                              (list '(*lir-progv-a* *lir-progv-b*) (list identity) t)
                              (list '(*lir-progv-a* *lir-progv-b*) (list identity :local-b) :local)
                              (list '(*lir-progv-a* *lir-progv-a*) (list :first identity) nil)
                              (list (list fresh fresh) nil t)
                              (list nil nil nil))))
            (dolist (case cases)
              (multiple-value-bind (observed kind) (apply *lir-progv-function* case)
                (kiln.sys:%gc)
                (print (list (first observed) (eq (second observed) identity) (third observed)
                             (if (eq (fourth observed) identity) :identity (fourth observed))
                             kind *lir-progv-state* *lir-progv-a* *lir-progv-b*))))
            (print (boundp fresh))
            (dolist (case (list (list (cons '*lir-progv-a* 1) nil nil)
                               (list '(*lir-progv-a* *lir-progv-b*) (cons identity 1) nil)
                               (list (list '*lir-progv-a* 17) (list identity identity) nil)
                               (list '(*lir-progv-a* *lir-progv-b*) (list identity identity) :error)))
              (handler-case (apply *lir-progv-function* case)
                (type-error () (print (list :type *lir-progv-a* *lir-progv-b*)))))))))))

(let* ((module (kiln.kir:make-kmodule "rejected-progv"))
       (kiln.kir::*module* module))
  (kiln.kir:module-data "entry" '(:static-function "bad"))
  (kiln.kir:module-init "entry")
  (push '(:func "bad" (:vars) (:slots (:r (:dynamic-entry :bind)))
           (:block :e (:progv-restore :r) (:return (:fixnum-tag 0) 1)))
        (kiln.kir::kmodule-funcs module))
  (handler-case (kiln.kir::normalize-lir-module module)
    (error (condition)
      (print (and (search "restoration needs a progv region" (princ-to-string condition)) :restore-kind)))))
