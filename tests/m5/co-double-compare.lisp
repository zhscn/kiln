(defun compare-double-values (left right)
  (declare (double-float left right))
  (list (< left right) (> left right) (<= left right)
        (>= left right) (= left right) (/= left right)))
(defun generic-double-predicate (operator left right)
  (funcall operator left right))
(defun compare-double-generic (left right)
  (mapcar (lambda (operator) (generic-double-predicate operator left right))
          (list #'< #'> #'<= #'>= #'= #'/=)))

(dolist (pair (list (cons 1d0 2d0) (cons 2d0 1d0) (cons -0d0 0d0)
                   (cons (kiln.kernel::%primop :make-double-float-bits #x7ff00000 0) 1d0)
                   (cons (kiln.kernel::%primop :make-double-float-bits #x7ff80000 123) 1d0)))
  (let ((specialized (compare-double-values (car pair) (cdr pair)))
        (generic (compare-double-generic (car pair) (cdr pair))))
    (print specialized)
    (print (equal specialized generic))))

(let ((function (compile nil '(lambda (left right)
                               (declare (double-float left right))
                               (if (< (1+ left) (* right 2d0)) :less :other)))))
  (print (funcall function 3d0 4d0))
  (print (funcall function 9d0 1d0))
  (print (handler-case (funcall function 3 4d0) (type-error () 'type-error))))

(let ((value 3d0))
  (declare (double-float value))
  (print (< (1+ value)
            (progn (setq value 100d0) (kiln.sys:%gc) (1- value)))))

(let ((value 0d0) (count 0))
  (declare (double-float value))
  (tagbody again
     (if (>= value 3d0) (go done))
     (setq value (1+ value))
     (incf count)
     (go again)
   done)
  (print count))

(defun mixed-double-equal (left right)
  (declare (double-float left))
  (= left right))
(print (mixed-double-equal 9007199254740992d0 9007199254740993))
(print (mixed-double-equal 9007199254740992d0 9007199254740992))
