(defvar *lir-rack-function* nil)

(let ((session (kiln.compiler:make-session)))
  (multiple-value-bind (module original-literals)
      (kiln.compiler:compile-module
       (kiln.compiler::front-end-forms
        '((setq *lir-rack-function*
                (lambda (class size callback)
                  (let* ((normal (kiln.sys:%primop :allocate-general-instance class size))
                         (callable (kiln.sys:%primop :allocate-general-funcallable-instance class size))
                         (initial (list (kiln.sys:%primop :standard-instance-access normal -2)
                                        (kiln.sys:%primop :standard-instance-access normal -1)
                                        (kiln.sys:%primop :standard-instance-access normal 1)
                                        (kiln.sys:%primop :standard-instance-access callable 1))))
                    (kiln.sys:%primop :set-standard-instance-access normal -2 77)
                    (kiln.sys:%primop :set-standard-instance-access normal 0 class)
                    (kiln.sys:%primop :set-standard-instance-access callable 1 class)
                    (kiln.sys:%primop :set-funcallable-instance-function callable callback)
                    (kiln.sys:%gc)
                    (values normal callable initial (funcall callable class))))))
        session)
       "rack-producer" :session session :image t)
    (multiple-value-bind (program literals)
        (kiln.kir::normalize-lir-module module original-literals)
      (let* ((direct (kiln.sys:%primop :compile-program program literals kiln.kir::+backend-target-fingerprint+))
             (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
             (decoded (kiln.sys:%primop :compile-packet packet literals)))
        (dolist (initializer (list direct decoded))
          (funcall initializer)
          (let ((class (vector 'class)) (callback (lambda (value) value)))
            (multiple-value-bind (normal callable initial value) (funcall *lir-rack-function* class 4 callback)
              (kiln.sys:%gc)
              (print (list initial
                           (kiln.sys:%primop :standard-instance-p normal)
                           (kiln.sys:%primop :funcallable-instance-p callable)
                           (eq (kiln.sys:%primop :instance-class normal) class)
                           (eq (kiln.sys:%primop :instance-class callable) class)
                           (kiln.sys:%primop :standard-instance-access normal -2)
                           (eq (kiln.sys:%primop :standard-instance-access normal 0) class)
                           (eq (kiln.sys:%primop :standard-instance-access callable 1) class)
                           (eq value class))))
            (handler-case (funcall *lir-rack-function* class -1 callback)
              (type-error () (print :size)))))))))
