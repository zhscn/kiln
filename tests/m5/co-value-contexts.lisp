(defun throw-context-values () (throw 'value-tag (values :first :second)))
(defun value-context-contracts ()
  (dolist (form '((list :before (catch 'value-tag (throw-context-values)) :after)
                  (list :before (catch 'value-tag (throw 'value-tag (values))) :after)
                  (list :before (catch 'value-tag :normal) :after)
                  (multiple-value-list (catch 'value-tag (throw-context-values)))
                  (progn (catch 'value-tag (throw-context-values)) :discarded)
                  (let ((seen nil))
                    (flet ((save (&rest args) (setf seen args)))
                      (multiple-value-call #'save (values 1 2) (values 3)))
                    seen)
                  (let ((seen nil))
                    (multiple-value-call #'(lambda (&rest args) (setf seen args))
                      (values 1 2) (values 3))
                    seen)
                  (let ((output (with-output-to-string (*standard-output*)
                                  (multiple-value-list (write-line "abc")))))
                    (equal output (format nil "abc~%")))
                  (let ((stream (make-string-output-stream)))
                    (list (catch 'done (with-open-stream (output stream)
                                         (throw 'done :closed)))
                          (open-stream-p stream)))
                  (let ((*readtable* (copy-readtable)))
                    (set-syntax-from-char #\Space #\a)
                    (with-input-from-string (*standard-input* "  x")
                      (mapcar #'char-code (list (peek-char) (read-char)
                                               (peek-char t) (read-char)))))
                  (let ((*readtable* (copy-readtable)))
                    (set-syntax-from-char #\x #\Space)
                    (with-input-from-string (*standard-input* "xxa")
                      (mapcar #'char-code (list (peek-char) (read-char)
                                               (peek-char t) (read-char)))))))
    (print (eval form)))
  (dolist (thrown '(nil t))
    (print (eval `(let ((n 0))
                    (list :before
                          (catch 'value-tag
                            ,@(loop repeat 100 collect '(incf n))
                            ,(if thrown '(throw 'value-tag (values n :second)) 'n))
                          :after))))))
(value-context-contracts)
#+kiln
(let ((kiln.kernel::*eval-function* nil))
  (value-context-contracts))
#-kiln
(value-context-contracts)
