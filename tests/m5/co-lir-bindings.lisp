(defvar *lir-bound-value* :outside)
(defvar *lir-binding-function* nil)

(let ((session (kiln.compiler:make-session)))
  (multiple-value-bind (module original-literals)
      (kiln.compiler:compile-module
       (kiln.compiler::front-end-forms
        (sublis (list (cons 'pair (gensym "PAIR")))
         '((setq *lir-binding-function*
                (lambda (flag value)
                  (declare (optimize (speed 3) (compilation-speed 0)))
                  (let ((pair (cons value nil)))
                    (declare (dynamic-extent pair))
                    (let ((*lir-bound-value* (car pair)))
                    (let ((observed
                            (if flag
                                (let ((*lir-bound-value* :inner))
                                  (kiln.sys:%gc)
                                  *lir-bound-value*)
                                (progn (kiln.sys:%gc) *lir-bound-value*))))
                      (values observed *lir-bound-value*))))))))
        session)
       "binding-producer" :session session :image t)
    (multiple-value-bind (program literals)
        (kiln.kir::normalize-lir-module module original-literals)
      (print (some (lambda (form) (and (eq (first form) :function)
                                      (not (null (assoc :stack-object (cddr form))))))
                   (cddr program)))
      (let* ((direct (kiln.sys:%primop :compile-program program literals kiln.kir::+backend-target-fingerprint+))
             (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
             (decoded (kiln.sys:%primop :compile-packet packet literals)))
        (dolist (initializer (list direct decoded))
          (funcall initializer)
          (let ((identity (vector 'identity)))
            (multiple-value-bind (observed bound) (funcall *lir-binding-function* t identity)
              (print (list observed (eq bound identity) *lir-bound-value*)))
            (multiple-value-bind (observed bound) (funcall *lir-binding-function* nil identity)
              (print (list (eq observed identity) (eq bound identity) *lir-bound-value*)))))))))

(dolist (case
          '((:join "source regions disagree at a CFG join"
             (:func "bad" (:vars (:flag :raw))
               (:slots (:r (:dynamic-entry :bind)))
               (:block :e (:set :flag 0) (:br :flag :left :right))
               (:block :left (:dynamic-enter :r :bind (:object-address "kiln_nil" :general)) (:jump :join))
               (:block :right (:jump :join))
               (:block :join (:return (:fixnum-tag 0) 1))))
            (:leave-order "source region leave is not innermost"
             (:func "bad" (:vars)
               (:slots (:r (:dynamic-entry :bind)))
               (:block :e (:dynamic-enter :r :bind (:object-address "kiln_nil" :general))
                 (:dynamic-leave :other) (:return (:fixnum-tag 0) 1))))))
  (let* ((module (kiln.kir:make-kmodule "rejected-binding"))
         (kiln.kir::*module* module))
    (kiln.kir:module-data "entry" '(:static-function "bad"))
    (kiln.kir:module-init "entry")
    (push (third case) (kiln.kir::kmodule-funcs module))
    (handler-case (kiln.kir::normalize-lir-module module)
      (error (condition)
        (print (and (search (second case) (princ-to-string condition)) (first case)))))))
