(defvar *lir-tail-branches* nil)

(let ((session (kiln.compiler:make-session)))
  (multiple-value-bind (module original-literals)
      (kiln.compiler:compile-module
       (kiln.compiler::front-end-forms
        '((setq *lir-tail-branches*
                (lambda (flag callback payload)
                  (if flag
                      (kiln.sys:%primop :tail-funcall-function callback payload)
                      (kiln.sys:%primop :tail-funcall-function callback payload)))))
        session)
       "tail-branches" :session session :image t)
    (multiple-value-bind (program literals)
        (kiln.kir::normalize-lir-module module original-literals)
      (print (some (lambda (source)
                     (let ((normalized (find (second source)
                                             (remove-if-not (lambda (form) (eq (first form) :function)) (cddr program))
                                             :key #'second :test #'equal)))
                       (and normalized
                            (< (count :block (cddr normalized) :key #'first)
                               (count :block (cddr source) :key #'first)))))
                   (kiln.kir::kmodule-funcs module)))
      (let* ((direct (kiln.sys:%primop :compile-program program literals kiln.kir::+backend-target-fingerprint+))
             (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
             (decoded (kiln.sys:%primop :compile-packet packet literals)))
        (dolist (initializer (list direct decoded))
          (funcall initializer)
          (let ((payload (vector 'identity)) (callback (lambda (value) (values value :tail))))
            (dolist (flag '(t nil))
              (multiple-value-bind (value kind) (funcall *lir-tail-branches* flag callback payload)
                (print (list (eq value payload) kind))))))))))

(let* ((module (kiln.kir:make-kmodule "dead-regions"))
       (kiln.kir::*module* module))
  (kiln.kir:module-data "entry" '(:static-function "run"))
  (kiln.kir:module-init "entry")
  (push '(:func "run" (:vars (:a :obj) (:n :raw) (:unused :obj) (:count :raw))
           (:slots (:r (:dynamic-entry :catch)))
           (:block :entry (:return (:fixnum-tag 5) 1))
           (:block :dead (:dynamic-enter :r :catch (:fixnum-tag 0))
             (:move-values :a :n :unused :count) (:dynamic-leave :r) (:return :a :n))
           (:block :handler (:br (:unwind-target-p :r) :land :outer))
           (:block :land (:landed-values :a :n) (:return :a :n))
           (:block :outer (:trap)))
        (kiln.kir::kmodule-funcs module))
  (let* ((program (kiln.kir::normalize-lir-module module))
         (function (find :function (cddr program) :key #'first))
         (direct (kiln.sys:%primop :compile-program program #() kiln.kir::+backend-target-fingerprint+))
         (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
         (decoded (kiln.sys:%primop :compile-packet packet #())))
    (print (list (null (assoc :region (cddr function))) (count :block (cddr function) :key #'first)))
    (print (funcall direct))
    (print (funcall decoded))))
