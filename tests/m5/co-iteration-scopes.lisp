(defun iteration-scope-contracts ()
  (dolist (form '((block nil (dolist (x (return :inner)) (declare (ignorable x))) :outer)
                  (block nil (dotimes (i (return :inner))) :outer)
                  (let ((x :dynamic)) (declare (special x))
                    (let ((x :lexical))
                      (declare (ignorable x))
                      (dolist (element nil x)
                        (declare (ignorable element) (special x)))))
                  (let ((x :dynamic)) (declare (special x))
                    (let ((x :lexical))
                      (declare (ignorable x))
                      (dotimes (i 0 x) (declare (special x)))))
                  (let ((x :dynamic)) (declare (special x))
                    (let ((x :lexical))
                      (dolist (element (return-from nil x))
                        (declare (ignorable element) (special x)))))
                  (dolist (element '(1 2) element)
                    (declare (type integer element) (ignorable element)))
                  (dolist (element '(1 2) (symbol-value 'element))
                    (declare (special element) (type integer element)))
                  (let ((count 0) (seen nil))
                    (list (dolist (element (progn (incf count) '(1 2 3))
                                           (list element (reverse seen)))
                            (push element seen)) count))
                  (let ((count 0) (seen nil))
                    (list (dotimes (i (progn (incf count) 3) (list i (reverse seen)))
                            (push i seen)) count))))
    (print (eval form))))
(iteration-scope-contracts)
#+kiln
(let ((kiln.kernel::*eval-function* nil))
  (iteration-scope-contracts))
#-kiln
(iteration-scope-contracts)
