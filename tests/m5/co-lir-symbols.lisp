(defvar *lir-symbol-make* nil)
(defvar *lir-symbol-clear* nil)

(let ((session (kiln.compiler:make-session)))
  (multiple-value-bind (module original-literals)
      (kiln.compiler:compile-module
       (kiln.compiler::front-end-forms
        '((setq *lir-symbol-make*
                (lambda (name)
                  (let ((symbol (kiln.sys:%primop :make-symbol name)))
                    (kiln.sys:%gc)
                    symbol)))
          (setq *lir-symbol-clear*
                (lambda (symbol)
                  (kiln.sys:%primop :unbind-function symbol)
                  (kiln.sys:%primop :unbind-setf-function symbol)
                  (kiln.sys:%gc)
                  symbol)))
        session)
       "symbol-producer" :session session :image t)
    (multiple-value-bind (program literals)
        (kiln.kir::normalize-lir-module module original-literals)
      (let* ((direct (kiln.sys:%primop :compile-program program literals kiln.kir::+backend-target-fingerprint+))
             (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
             (decoded (kiln.sys:%primop :compile-packet packet literals)))
        (dolist (initializer (list direct decoded))
          (funcall initializer)
          (let* ((name (make-string 4 :initial-element #\λ))
                 (symbol (funcall *lir-symbol-make* name))
                 (setf-name (list 'setf symbol))
                 (payload (vector 'payload)))
            (kiln.sys:%gc)
            (print (list (symbolp symbol) (eq (symbol-name symbol) name) (symbol-package symbol)
                         (boundp symbol) (fboundp symbol) (fboundp setf-name)
                         (eq symbol (funcall *lir-symbol-make* name))))
            (setf (symbol-value symbol) payload
                  (symbol-function symbol) (lambda () :defined)
                  (fdefinition setf-name) (lambda (value) value))
            (print (list (fboundp symbol) (fboundp setf-name) (funcall (symbol-function symbol))))
            (print (list (eq (funcall *lir-symbol-clear* symbol) symbol)
                         (eq (symbol-value symbol) payload) (fboundp symbol) (fboundp setf-name)))
            (handler-case (funcall (symbol-function symbol))
              (undefined-function (condition) (print (eq (cell-error-name condition) symbol))))
            (handler-case (funcall (fdefinition setf-name) payload)
              (undefined-function (condition) (print (equal (cell-error-name condition) setf-name))))))))))
