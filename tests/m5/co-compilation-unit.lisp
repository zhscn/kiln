(defun check-compilation-units ()
  (print (multiple-value-list (with-compilation-unit () (values 1 2 3))))
  (let ((name (gensym "FORWARD")) (warnings 0))
    (handler-bind ((style-warning (lambda (c) (incf warnings) (muffle-warning c))))
      (with-compilation-unit ()
        (compile nil `(lambda () (,name)))
        (print warnings)
        (eval `(defun ,name () :defined)))
      (print warnings))
    (fmakunbound name))
  (let ((name (gensym "UNDEFINED")) (warnings 0))
    (handler-bind ((style-warning (lambda (c) (incf warnings) (muffle-warning c))))
      (with-compilation-unit ()
        (compile nil `(lambda () (,name)))
        (compile nil `(lambda () (,name)))
        (print warnings))
      (print warnings)))
  (let ((name (gensym "NESTED")) (warnings 0))
    (handler-bind ((style-warning (lambda (c) (incf warnings) (muffle-warning c))))
      (with-compilation-unit ()
        (with-compilation-unit (:override nil)
          (compile nil `(lambda () (,name))))
        (print warnings))
      (print warnings)))
  (let ((name (gensym "OVERRIDE")) (warnings 0))
    (handler-bind ((style-warning (lambda (c) (incf warnings) (muffle-warning c))))
      (with-compilation-unit ()
        (with-compilation-unit (:override t)
          (compile nil `(lambda () (,name))))
        (print warnings)
        (eval `(defun ,name () :defined)))
      (print warnings))
    (fmakunbound name))
  (print (block out (with-compilation-unit () (return-from out :exited))))
  (let ((name (gensym "AFTER-EXIT")) (warnings 0))
    (handler-bind ((style-warning (lambda (c) (incf warnings) (muffle-warning c))))
      (with-compilation-unit () (compile nil `(lambda () (,name))))
      (print warnings))))
(check-compilation-units)
#+kiln
(let ((kiln.kernel::*compile-function* nil)) (check-compilation-units))
#-kiln
(check-compilation-units)
(defun check-variable-compilation-unit ()
  (let ((name (gensym "FORWARD-VARIABLE")) (warnings 0))
    (handler-bind ((warning (lambda (c) (incf warnings) (muffle-warning c))))
      (with-compilation-unit ()
        (compile nil `(lambda () ,name))
        (print warnings)
        (eval `(defparameter ,name 42)))
      (print warnings)))
  (let ((name (gensym "UNKNOWN-VARIABLE")) (warnings 0))
    (handler-bind ((warning (lambda (c) (incf warnings) (muffle-warning c))))
      (with-compilation-unit ()
        (compile nil `(lambda () ,name))
        (print warnings))
      (print warnings))))
#+kiln
(let ((kiln.kernel::*compile-function* nil)) (check-variable-compilation-unit))
#-kiln
(check-variable-compilation-unit)
