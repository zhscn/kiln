(defun check-generalized-setf ()
  (print (eq (eval '(defmacro setf-test-macro () 1)) 'setf-test-macro))
  (eval '(defun setf-test-access (cell &optional (index 0)) (nth index cell)))
  (eval '(defsetf setf-test-access (cell &optional (index 0)) (value)
           (return-from setf-test-access `(setf (nth ,index ,cell) ,value))))
  (print (eval '(let ((cell (list 1 2)) (count 0))
                 (list (setf (setf-test-access (progn (incf count) cell) 1)
                             (progn (incf count) 9)) cell count))))
  (eval '(defun setf-test-pair (cell) (values (car cell) (cdr cell))))
  (eval '(defsetf setf-test-pair (cell) (a b)
           `(progn (setf (car ,cell) ,a (cdr ,cell) ,b) (values ,a ,b))))
  (print (eval '(let ((cell (cons 0 0)))
                 (list (multiple-value-list (setf (setf-test-pair cell) (values 3 4)))
                       cell))))
  (eval '(define-modify-macro setf-test-values (&rest args) values))
  (print (eval '(let ((cell (cons 1 2))) (setf-test-values (setf-test-pair cell) 3) cell)))
  (print (eq (eval '(define-modify-macro setf-test-add (&optional (delta 1)) +))
             'setf-test-add))
  (print (eval '(let ((x 10)) (setf-test-add x (progn (setf x 20) 2)) x)))
  (print (eval '(let ((x 1))
                 (macrolet ((local-place () 'x))
                   (setf-test-add (local-place) 3))
                 x)))
  (print (eval '(let ((array (vector 0 0)) (count 0))
                 (list (setf (apply #'aref (progn (incf count) array)
                                    (progn (incf count) (list 1)))
                             (progn (incf count) 7))
                       array count))))
  (eval '(defun setf-test-key (cell &key index) (nth index cell)))
  (eval '(defsetf setf-test-key (cell &key (index 0)) (value)
           `(setf (nth ,index ,cell) ,value)))
  (print (eval '(let ((cell (list 1 2))) (incf (setf-test-key cell :index 1)) cell))))
(check-generalized-setf)
#+kiln
(let ((kiln.kernel::*eval-function* nil) (kiln.kernel::*compile-function* nil))
  (check-generalized-setf))
#-kiln
(check-generalized-setf)
