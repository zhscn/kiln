(defun double-assignment-primary (a b)
  (declare (double-float a b))
  (let ((x a))
    (declare (double-float x))
    (print (+ (setq x (+ x b)) (progn (setq x 99d0) b)))
    (print x)
    (print (+ (setq x (setq x (* a b))) x))))
(double-assignment-primary 2d0 3d0)
(let ((x 2d0))
  (declare (double-float x))
  (print (handler-case (+ (setq x (identity :bad)) 3d0)
           (type-error () :type-error)))
  (print x))
(let ((function (compile nil '(lambda (a b)
                               (declare (double-float a b))
                               (let ((x a))
                                 (declare (double-float x))
                                 (< (setq x (+ x b)) (progn (setq x 99d0) b)))))))
  (print (funcall function -5d0 3d0)))
(let ((x 2d0))
  (declare (double-float x))
  (print (multiple-value-list (setq x (+ x 3d0)))))
