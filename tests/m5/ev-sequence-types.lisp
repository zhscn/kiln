(declaim (optimize (safety 3)))
(print (make-sequence '(vector * 3) 3 :initial-element 'x))
(print (make-sequence (find-class 'cons) 2 :initial-element 'x))
(print (map (find-class 'list) #'1+ #(1 2 3)))
(let* ((x (list 'a 'b)) (result (concatenate 'list x)))
  (print result)
  (print (eq x result)))
(print (coerce (concatenate '(bit-vector 4) '(0 1) (make-array 2 :element-type 'bit :initial-contents '(1 0))) 'list))
(print (merge '(vector * 4) '(1 3) '(2 4) #'<))
(dolist (f (list (lambda () (make-sequence 'null 1))
                (lambda () (make-sequence 'cons 0))
                (lambda () (make-sequence '(vector * 3) 2))
                (lambda () (concatenate '(string 2) "abc"))
                (lambda () (map 'symbol #'identity '(1)))
                (lambda () (merge '(vector t 3) '(1) '(2) #'<))
                (lambda () (fill (vector 1 2) 0 :end -1))))
  (print (handler-case (progn (funcall f) nil) (type-error () t))))
(let* ((bits (make-array 4 :element-type 'bit :initial-contents '(1 1 1 1)))
       (result (replace bits (make-array 2 :element-type 'bit :initial-element 0))))
  (print (eq result bits))
  (print (coerce bits 'list))
  (print (handler-case (progn (replace bits #(2)) nil) (type-error () t))))
(let* ((s (copy-seq "cab")) (result (sort s #'char<)))
  (print (eq s result))
  (print s))
(print (remove-duplicates '(a b a c a d) :start 1 :end 5))
(print (remove-duplicates '(a b a c a d) :start 1 :end 5 :from-end t))
(print (funcall (coerce 'car 'function) '(a b)))
(print (funcall (coerce '(lambda (x) (+ x 2)) 'function) 10))

(print (length (multiple-value-list (coerce '(lambda (x) x) 'function))))
