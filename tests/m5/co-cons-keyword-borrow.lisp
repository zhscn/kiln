(flet ((borrow (x &key (y x supplied)) (print supplied) (car y)))
  (declare (notinline borrow))
  (let ((pair (cons 17 19)))
    (print (borrow pair)) (print (borrow pair :y '(23 . 29)))))
(flet ((borrow (x &key (y x)) y))
  (declare (notinline borrow))
  (let ((pair (cons 31 37))) (print (car (borrow pair)))))
(labels ((borrow (n x &key (y x))
           (if (zerop n) (car y) (borrow (1- n) x))))
  (declare (notinline borrow))
  (let ((pair (cons 41 43))) (print (borrow 3 pair))))
(let ((saved nil))
  (flet ((retain (x &key (y (setq saved x))) y))
    (declare (notinline retain))
    (let ((pair (cons 47 53))) (retain pair)))
  (print saved))
(let ((function (compile nil '(lambda ()
                               (flet ((borrow (x &key (y x)) y))
                                 (declare (notinline borrow))
                                 (let ((pair (cons 59 61))) (car (borrow pair))))))))
  (print (funcall function)))
