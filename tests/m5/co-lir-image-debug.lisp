(defvar *lir-image-function* nil)
(defvar *lir-image-identity* nil)
(defvar *lir-image-observed* nil)

(defun lir-image-probe ()
  (kiln.sys:%gc)
  (let* ((frame (find-if (lambda (frame)
                           (assoc 'image-x (kiln.sys:frame-variables frame)))
                         (kiln.sys:frame-list)))
         (variables (kiln.sys:frame-variables frame)))
    (setf *lir-image-observed*
          (list (eq (cdr (assoc 'image-x variables)) *lir-image-identity*)
                (eql (cdr (assoc 'image-z variables)) 1.25d0)))))

(let ((session (kiln.compiler:make-session))
      (*lir-image-identity* (list 'identity)))
  (multiple-value-bind (module original-literals)
      (kiln.compiler:compile-module
       (kiln.compiler::front-end-forms
        '((setq *lir-image-function*
                (lambda (image-x image-y)
                  (let ((image-z 1.25d0))
                    (declare (type double-float image-z))
                    (lir-image-probe)
                    (if (eq image-x image-y) image-z 0.0d0)))))
        session)
       "image-debug-producer" :session session :image t)
    (multiple-value-bind (program literals)
        (kiln.kir::normalize-lir-module module original-literals)
      (print (loop for index below (length original-literals)
                   always (eq (svref original-literals index) (svref literals index))))
      (print (> (length literals) (length original-literals)))
      (handler-case (kiln.kir::normalize-lir-module module #())
        (error (condition)
          (print (and (search "literal bindings disagree" (princ-to-string condition)) :literal-count))))
      (let* ((function (find-if (lambda (function)
                                  (some #'third (rest (assoc :vars (cddr function)))))
                                (kiln.kir::kmodule-funcs module)))
             (index (second (assoc :debug-literal (cddr function))))
             (bad (copy-seq original-literals)))
        (setf (svref bad index) 0)
        (handler-case (kiln.kir::normalize-lir-module module bad)
          (error (condition)
            (print (and (search "debug record needs five fields" (princ-to-string condition)) :debug-record))))
        (setf (svref bad index) (copy-seq (svref original-literals index))
              (svref (svref bad index) 4) nil)
        (handler-case (kiln.kir::normalize-lir-module module bad)
          (error (condition)
            (print (and (search "debug variable index is out of range" (princ-to-string condition)) :debug-index)))))
      (let* ((direct (kiln.sys:%primop :compile-program program literals kiln.kir::+backend-target-fingerprint+))
             (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
             (decoded (kiln.sys:%primop :compile-packet packet literals)))
        (dolist (initializer (list direct decoded))
          (let ((*lir-image-function* nil) (*lir-image-observed* nil))
            (funcall initializer)
            (print (list (eql (funcall *lir-image-function* *lir-image-identity* *lir-image-identity*) 1.25d0)
                         *lir-image-observed*))))))))
