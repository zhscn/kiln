(defclass load-form-probe ()
  ((x :initarg :x) (y) (z :initform 99) (shared :allocation :class :initform 42)))
(defstruct load-form-structure (value 0 :read-only t))
(print (eq (find-class 'load-form-probe)
           (eval (make-load-form (find-class 'load-form-probe)))))
(let ((object (make-instance 'load-form-probe :x (list :saved))))
  (multiple-value-bind (creation initialization) (make-load-form-saving-slots object)
    (setf (slot-value object 'shared) 100)
    (let ((copy (eval creation)))
      (eval (subst copy object initialization))
      (print (eq (class-of object) (class-of copy)))
      (print (slot-value copy 'x))
      (print (slot-boundp copy 'y))
      (print (slot-value copy 'z))
      (print (slot-value copy 'shared))))
  (multiple-value-bind (creation initialization)
      (make-load-form-saving-slots object :slot-names '(x))
    (let ((copy (eval creation)))
      (eval (subst copy object initialization))
      (print (slot-value copy 'x))
      (print (slot-boundp copy 'z))))
  (print (handler-case (progn (make-load-form object) nil) (error () t))))
(let ((object (make-load-form-structure :value 123)))
  (multiple-value-bind (creation initialization) (make-load-form-saving-slots object)
    (let ((copy (eval creation)))
      (eval (subst copy object initialization))
      (print (load-form-structure-value copy)))))
