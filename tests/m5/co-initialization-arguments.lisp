(defun initarg-error-p (function)
  (handler-case (progn (funcall function) nil) (program-error () t)))
(defclass checked-init () ((x :initarg :x :initform 0)))
(print (slot-value (make-instance 'checked-init :x 7) 'x))
(print (initarg-error-p (lambda () (make-instance 'checked-init :bad 1))))
(print (initarg-error-p (lambda () (funcall #'make-instance 'checked-init :x))))
(print (typep (make-instance 'checked-init :bad 1 :allow-other-keys t) 'checked-init))
(print (initarg-error-p (lambda () (make-instance 'checked-init :allow-other-keys nil
                                                 :allow-other-keys t :bad 1))))
(print (typep (make-instance 'checked-init 1 2 :allow-other-keys t) 'checked-init))
(defvar *default-init-count* 0)
(defclass defaulted-init () ((x :initarg :x))
  (:default-initargs :x (incf *default-init-count*)))
(setf *default-init-count* 0)
(print (slot-value (make-instance 'defaulted-init :x 9) 'x))
(print (slot-value (make-instance 'defaulted-init) 'x))
(print *default-init-count*)
(defclass invalid-default-init () ()
  (:default-initargs :bad (incf *default-init-count*)))
(setf *default-init-count* 0)
(print (initarg-error-p (lambda () (make-instance 'invalid-default-init))))
(print *default-init-count*)
(defclass cached-init () ((x :initarg :x :initform 0)))
(print (initarg-error-p (lambda () (make-instance 'cached-init :feature 11))))
(defmethod initialize-instance :after ((object cached-init) &key feature)
  (setf (slot-value object 'x) feature))
(print (slot-value (make-instance 'cached-init :feature 11) 'x))
(let ((method (find-method #'initialize-instance '(:after) (list (find-class 'cached-init)))))
  (remove-method #'initialize-instance method))
(print (initarg-error-p (lambda () (make-instance 'cached-init :feature 11))))
(defclass open-init () ())
(defmethod initialize-instance :after ((object open-init) &key &allow-other-keys)
  (declare (ignore object)) nil)
(print (typep (make-instance 'open-init :anything 1) 'open-init))
(print (initarg-error-p (lambda () (make-instance 'checked-init :anything 1))))
(defvar *allocation-token* nil)
(defclass allocator-init () ())
(defmethod allocate-instance :after ((class (eql (find-class 'allocator-init))) &key token)
  (declare (ignore class)) (setf *allocation-token* token))
(make-instance 'allocator-init :token 13)
(print *allocation-token*)
(defclass option-metaclass (standard-class)
  ((data :initarg class-option)))
(defmethod #+kiln clostrophilia::validate-superclass #-kiln sb-mop:validate-superclass
    ((class option-metaclass) (superclass standard-class))
  (declare (ignore class superclass)) t)
(defclass option-slot-definition
    (#+kiln clostrophilia:standard-direct-slot-definition #-kiln sb-mop:standard-direct-slot-definition)
  ((data :initarg slot-option)))
(defmethod #+kiln clostrophilia::direct-slot-definition-class #-kiln sb-mop:direct-slot-definition-class
    ((class option-metaclass) &rest initargs)
  (declare (ignore class initargs)) (find-class 'option-slot-definition))
(defclass extended-init () ((x slot-option (not-called) :initform 0)
                           (y slot-option 1 slot-option 2))
  (:metaclass option-metaclass) (class-option (also-not-called)))
(print (slot-value (find-class 'extended-init) 'data))
(print (slot-value (first (#+kiln clostrophilia:class-direct-slots #-kiln sb-mop:class-direct-slots
                          (find-class 'extended-init))) 'data))

(print (slot-value (second (#+kiln clostrophilia:class-direct-slots #-kiln sb-mop:class-direct-slots
                           (find-class 'extended-init))) 'data))
(defclass cached-init () ((x :initarg :x :initform 0) (added :initarg :added)))
(print (slot-value (make-instance 'cached-init :added 23) 'added))

