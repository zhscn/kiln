(let* ((module (kiln.kir:make-kmodule "scoped-roots"))
       (kiln.kir::*module* module)
       (cons-class kiln.kir::+packet-class-cons+)
       (car-field kiln.kir::+packet-field-cons-car+))
  (kiln.kir:module-data "entry" '(:static-function "run"))
  (kiln.kir:module-init "entry")
  (push `(:func "run" (:vars (:a :obj) (:flag :obj) (:count :raw) (:pair :obj)
                            (:out :obj) (:n :raw) (:ignored :obj))
           (:slots (:s (:stack-object ,cons-class 2)) (:r (:stack-roots-entry))
                   (:c (:dynamic-entry :catch)))
           (:block :entry (:receive-prefix (:a :flag) :count)
             (:dynamic-enter :c :catch (:fixnum-tag 0)) (:jump :late))
           (:block :late (:stack-object-init :s ,cons-class 2)
             (:stack-roots-enter :r :s ,cons-class 2)
             (:stack-cons :pair (:slot :s) :a (:object-address "kiln_nil" :general))
             (:runtime-op :ignored :gc () :handler)
             (:set :out (:field-load ,car-field :pair))
             (:br (:ne :flag (:object-address "kiln_nil" :general)) :throw :finish))
           (:block :throw (:unwind-values :throw (:fixnum-tag 0) :out 1 :handler))
           (:block :finish (:stack-roots-leave :r) (:dynamic-leave :c) (:return :out 1))
           (:block :handler (:br (:unwind-target-p :c) :land :outer))
           (:block :land (:landed-values :out :n) (:return :out :n))
           (:block :outer (:trap)))
        (kiln.kir::kmodule-funcs module))
  (let* ((program (kiln.kir::normalize-lir-module module))
         (function (find :function (cddr program) :key #'first))
         (root (find :r (cddr function) :key #'second))
         (direct (kiln.sys:%primop :compile-program program #() kiln.kir::+backend-target-fingerprint+))
         (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
         (decoded (kiln.sys:%primop :compile-packet packet #())))
    (print (eq (fourth root) :c))
    (dolist (compiled (list direct decoded))
      (let ((identity (vector 'identity)))
        (print (list (eq (funcall compiled identity nil) identity)
                     (eq (funcall compiled identity t) identity)))))))
