(defun double-multiple-join (flag a b)
  (declare (double-float a b))
  (multiple-value-bind (x y marker)
      (if flag (progn (print :yes) (values (+ a b) (* a b) :marker))
          (progn (print :no) (values (- a b) (+ a b))))
    (declare (double-float x y))
    (print (+ x y)) (print marker)))
(double-multiple-join t 2d0 3d0)
(double-multiple-join nil 2d0 3d0)
(dolist (flag '(t nil))
  (print (handler-case
             (multiple-value-bind (x y)
                 (if flag (values (+ 2d0 3d0) (* 2d0 3d0))
                     (values (- 2d0 3d0)))
               (declare (double-float x y)) (+ x y))
           (type-error () :missing-error))))
(let ((function (compile nil '(lambda (flag a b)
                               (declare (double-float a b))
                               (multiple-value-bind (x y)
                                   (if flag (values (+ a b) (* a b)) (values (- a b) (+ a b)))
                                 (declare (double-float x y)) (< x y))))))
  (print (funcall function t 2d0 3d0))
  (print (funcall function nil 2d0 3d0)))
(defun generic-double-values () (values 7d0 8d0))
(dolist (flag '(t nil))
  (multiple-value-bind (x y)
      (if flag (values (+ 2d0 3d0) (* 2d0 3d0)) (generic-double-values))
    (declare (double-float x y)) (print (+ x y))))
