;;; The shared index preserves the original reconstruction's locations and aliases.
(defun same-cst-graph-p (left right &optional (same-raw-p #'eq))
  (let ((seen (make-hash-table :test 'eq)))
    (labels ((visit (a b)
               (cond ((gethash a seen) (eq b (gethash a seen)))
                     (t (setf (gethash a seen) b)
                        (and (funcall same-raw-p (cst:raw a) (cst:raw b))
                             (equal (cst:source a) (cst:source b))
                             (eq (cst:consp a) (cst:consp b))
                             (or (not (cst:consp a))
                                 (and (visit (cst:first a) (cst:first b))
                                      (visit (cst:rest a) (cst:rest b)))))))))
      (visit left right))))
(let ((client (make-instance 'kiln.compiler::source-reader-client)))
  (dolist (input '("nil" "quote" "(quote quote nil nil)" "#1=(a . #1#)"
                   "(a b . c)" "`(,a . ,b)" "(a #1=(b c) #1#)"))
    (let* ((child (eclector.concrete-syntax-tree:read-from-string input))
           (children (list child))
           (expression (list 'quote (cst:raw child))))
      (multiple-value-bind (first rest)
          (eclector.concrete-syntax-tree::reconstruct-expression-parts
           client expression children)
        (assert (same-cst-graph-p first (cst:reconstruct nil (car expression) children)))
        (assert (same-cst-graph-p rest (cst:reconstruct nil (cdr expression) children)))))))
(let* ((path "build/test/source-token-input.lisp")
       (text (format nil "(foo!bar)~%   (123 foo\\a |Mixed Case| foo#bar)~%~A~%last"
                     (make-string 9000 :initial-element #\a)))
       (eof (list nil))
       (*readtable* (copy-readtable nil))
       (eclector.base:*client* (make-instance 'kiln.compiler::source-reader-client)))
  (set-syntax-from-char #\! #\Space)
  (unwind-protect
       (progn
         (with-open-file (out path :direction :output :if-exists :supersede)
           (write-string text out))
         (with-open-file (file path)
           (with-input-from-string (string text)
             (loop for actual = (eclector.concrete-syntax-tree:read file nil eof)
                   for expected = (eclector.concrete-syntax-tree:read string nil eof)
                   do (assert (eq (eq actual eof) (eq expected eof)))
                   until (eq actual eof)
                   do (assert (same-cst-graph-p actual expected #'equal))
                      (assert (= (file-position file) (file-position string)))))))
    (delete-file path)))
(print :reconstruction-matches)
