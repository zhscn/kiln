;;; The shared index preserves the original reconstruction's locations and aliases.
(defun same-cst-graph-p (left right)
  (let ((seen (make-hash-table :test 'eq)))
    (labels ((visit (a b)
               (cond ((gethash a seen) (eq b (gethash a seen)))
                     (t (setf (gethash a seen) b)
                        (and (eq (cst:raw a) (cst:raw b))
                             (equal (cst:source a) (cst:source b))
                             (eq (cst:consp a) (cst:consp b))
                             (or (not (cst:consp a))
                                 (and (visit (cst:first a) (cst:first b))
                                      (visit (cst:rest a) (cst:rest b)))))))))
      (visit left right))))
(let ((client (make-instance 'kiln.compiler::source-reader-client)))
  (dolist (input '("nil" "quote" "(quote quote nil nil)" "#1=(a . #1#)"
                   "(a b . c)" "`(,a . ,b)" "(a #1=(b c) #1#)"))
    (let* ((child (eclector.concrete-syntax-tree:read-from-string input))
           (children (list child))
           (expression (list 'quote (cst:raw child))))
      (multiple-value-bind (first rest)
          (eclector.concrete-syntax-tree::reconstruct-expression-parts
           client expression children)
        (assert (same-cst-graph-p first (cst:reconstruct nil (car expression) children)))
        (assert (same-cst-graph-p rest (cst:reconstruct nil (cdr expression) children)))))))
(print :reconstruction-matches)
