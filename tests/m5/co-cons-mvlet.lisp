(multiple-value-bind (x y)
    (let* ((inner (cons 17 nil)) (outer (cons inner nil)))
      (values inner outer))
  (rplacd x y)
  (print (car x)) (print (eq (car y) x)) (print (eq (cdr x) y)))
(multiple-value-bind (x y)
    (let* ((inner (cons 23 nil)) (outer (cons inner nil)))
      (multiple-value-bind (a b) (values inner outer) (values b a)))
  (rplacd y x) (print (car y)) (print (eq (car x) y)) (print (eq (cdr y) x)))
(defun return-lexical-child ()
  (multiple-value-bind (x y)
      (let* ((inner (cons 29 nil)) (outer (cons inner nil)))
        (values inner outer))
    x))
(print (return-lexical-child))
(let ((function (compile nil '(lambda ()
                               (multiple-value-bind (x y)
                                   (let* ((inner (cons 31 nil)) (outer (cons inner nil)))
                                     (values inner outer))
                                 (rplacd x y)
                                 (list (car x) (eq (car y) x) (eq (cdr x) y)))))))
  (print (funcall function)))
