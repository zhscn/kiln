(let* ((source "build/test/co-fasl-arrays-source.lisp")
       (output (compile-file-pathname source)))
  (unwind-protect
       (progn
         (with-open-file (stream source :direction :output :if-exists :supersede)
           (write-string "(in-package :cl-user)
(defun fasl-byte-vector () '#.(make-array 4 :element-type '(unsigned-byte 8) :initial-contents '(0 7 128 255)))
(defun fasl-displaced-vector ()
  '#.(let* ((base (make-array 5 :initial-contents '(a b c d e)))
            (view (make-array 3 :displaced-to base :displaced-index-offset 1 :adjustable t :fill-pointer 2)))
       (list base view)))
(defun fasl-hash-cycle ()
  '#.(let ((table (make-hash-table :test 'eq))) (setf (gethash :self table) table) table))
(defun fasl-uninterned () '#.(let ((s (make-symbol \"private\"))) (list s s)))
(defun fasl-numbers () '(123456789012345678901234567890 3/7 #C(1.25d0 -2.5d0) -0.0d0))
(defun fasl-unicode () \"λ中文\")
" stream))
         (compile-file source :verbose nil :print nil)
         (load output :verbose nil :print nil)
         (print (equalp (funcall 'fasl-byte-vector) #(0 7 128 255)))
         (destructuring-bind (base view) (funcall 'fasl-displaced-vector)
           (multiple-value-bind (target offset) (array-displacement view)
             (print (and (eq target base) (= offset 1) (= (fill-pointer view) 2)
                         (adjustable-array-p view) (eq (aref view 0) 'b)))))
         (let ((table (funcall 'fasl-hash-cycle)))
           (print (eq table (gethash :self table))))
         (let ((symbols (funcall 'fasl-uninterned)))
           (print (and (eq (first symbols) (second symbols))
                       (not (symbol-package (first symbols))))))
         (destructuring-bind (integer ratio complex zero) (funcall 'fasl-numbers)
           (print (and (= integer 123456789012345678901234567890) (= ratio 3/7)
                       (= complex #C(1.25d0 -2.5d0))
                       (minusp (float-sign zero)))))
         (print (string= (funcall 'fasl-unicode) "λ中文")))
    (when (probe-file source) (delete-file source))
    (when (probe-file output) (delete-file output))))
