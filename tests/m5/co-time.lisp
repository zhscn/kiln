(defun time-contracts ()
  (dolist (form '(nil
                  (values)
                  (values :a :b :c)
                  (let ((x (list :same))) (list (eq (time x) x)))
                  (let ((x :lexical)) (flet ((read-x () x)) (time (read-x))))
                  (macrolet ((local-value () :expanded)) (time (local-value)))
                  (block exit (time (return-from exit :returned)))
                  (catch 'exit (time (throw 'exit :thrown)))
                  (funcall (compile nil '(lambda () (time (values :compiled :values)))))))
    (let ((values nil))
      (let ((output (with-output-to-string (*trace-output*)
                      (setf values (multiple-value-list (eval `(time ,form)))))))
        (print values)
        (print (plusp (length output))))))
  (let ((calls 0) (output nil) (value nil))
    (setf output (with-output-to-string (*trace-output*)
                   (setf value (time (progn (incf calls) :once)))))
    (print (list calls value (plusp (length output)))))
  (let ((output (with-output-to-string (*trace-output*)
                  (handler-case (time (error "timed failure"))
                    (error () (print :propagated))))))
    (print (plusp (length output)))))
(time-contracts)
#+kiln
(let ((kiln.kernel::*eval-function* nil))
  (time-contracts))
#-kiln
(time-contracts)
