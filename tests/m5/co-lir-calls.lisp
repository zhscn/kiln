(let* ((module (kiln.kir:make-kmodule "call-producer"))
       (kiln.kir::*module* module))
  (kiln.kir:module-init "caller-entry")
  (kiln.kir:module-data "caller-entry" '(:static-function "caller"))
  (kiln.kir:module-data "callee-entry" '(:static-function "callee"))
  (kiln.kir:with-function ("callee")
    (let ((flag (kiln.kir:new-var)) (argc (kiln.kir:new-var :raw))
          (a (kiln.kir:new-var)) (b (kiln.kir:new-var)) (c (kiln.kir:new-var))
          (empty (kiln.kir:new-block)) (many (kiln.kir:new-block)))
      (kiln.kir:emit `(:receive-prefix (,flag) ,argc))
      (kiln.compiler::br `(:eq ,flag (:object-address "kiln_nil" :general)) empty many)
      (kiln.kir:start-block empty) (kiln.kir:emit '(:publish-values ()))
      (kiln.kir:emit '(:return (:object-address "kiln_nil" :general) 0))
      (kiln.kir:start-block many)
      (kiln.kir:emit `(:set ,a (:fixnum-tag 1)))
      (kiln.kir:emit `(:set ,b (:fixnum-tag 2)))
      (kiln.kir:emit `(:set ,c (:fixnum-tag 3)))
      (kiln.kir:emit `(:publish-values (,a ,b ,c)))
      (kiln.kir:emit `(:return ,a 3))))
  (kiln.kir:with-function ("caller")
    (let ((flag (kiln.kir:new-var)) (argc (kiln.kir:new-var :raw))
          (f (kiln.kir:new-var)) (primary (kiln.kir:new-var)) (count (kiln.kir:new-var :raw))
          (joined (kiln.kir:new-var)) (number (kiln.kir:new-var :raw))
          (second (kiln.kir:new-var)) (saved (kiln.kir:new-var)) (ignored (kiln.kir:new-var))
          (restored (kiln.kir:new-var)) (restored-count (kiln.kir:new-var :raw))
          (ordinary (kiln.kir:new-block)) (known (kiln.kir:new-block)) (join (kiln.kir:new-block)))
      (kiln.kir:emit `(:receive-prefix (,flag) ,argc))
      (kiln.kir:emit `(:set ,f (:object-address "callee-entry" :general)))
      (kiln.compiler::br `(:eq ,flag (:object-address "kiln_nil" :general)) ordinary known)
      (kiln.kir:start-block ordinary)
      (kiln.kir:emit `(:invoke ,primary ,count ,f (,flag) :nil))
      (kiln.compiler::set-mv joined number primary count)
      (kiln.compiler::jump join)
      (kiln.kir:start-block known)
      (kiln.kir:emit `(:invoke-known ,primary ,count "callee" ,f (,flag) :nil))
      (kiln.compiler::set-mv joined number primary count)
      (kiln.compiler::jump join)
      (kiln.kir:start-block join)
      (kiln.kir:emit `(:set ,second (:select (:gt ,number 1) (:secondary-value-ref 1)
                                          (:object-address "kiln_nil" :general))))
      (kiln.kir:emit `(:save-values ,saved ,joined ,number :nil))
      (kiln.kir:emit `(:runtime-op ,ignored :gc () :nil))
      (kiln.kir:emit `(:restore-values ,restored ,restored-count ,saved ,number :nil))
      (kiln.kir:emit `(:return ,restored ,restored-count))))
  (let* ((program (kiln.kir::normalize-lir-module module))
         (direct (kiln.sys:%primop :compile-program program #() kiln.kir::+backend-target-fingerprint+))
         (packet (kiln.sys:%primop :encode-packet program kiln.kir::+packet-lir-payload+))
         (decoded (kiln.sys:%primop :compile-packet packet #())))
    (dolist (function (list direct decoded))
      (print (multiple-value-list (funcall function t)))
      (print (multiple-value-list (funcall function nil))))))
