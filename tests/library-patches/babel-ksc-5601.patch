 ;;; Testing consistency by encoding and decoding a simple string for
 ;;; all character encodings.
+(defun round-trip-sample (encoding)
+  (if (eq encoding :ksc_5601)
+      (map 'string #'code-char '(#xac00 #xb098 #xb2e4))
+      *standard-characters*))
+
+(deftest ksc-5601-fixed-byte-order ()
+  (let ((sample (string (code-char #xac00))))
+    (is (equalp (ub8v #x30 #x21)
+                (string-to-octets sample :encoding :ksc_5601)))
+    (is (string= sample (octets-to-string (ub8v #x30 #x21) :encoding :ksc_5601)))
+    (signals character-encoding-error
+      (string-to-octets "a" :encoding :ksc_5601 :errorp t))))
+
 (deftest rw-equiv.1 ()
   (let ((compatible-encodings (remove :ebcdic-international (list-character-encodings))))
     (dolist (*default-character-encoding* compatible-encodings)
-      (let ((octets (string-to-octets *standard-characters*)))
-        (is (string= (octets-to-string octets) *standard-characters*))))))
+      (let* ((sample (round-trip-sample *default-character-encoding*))
+             (octets (string-to-octets sample)))
+        (is (string= (octets-to-string octets) sample))))))

