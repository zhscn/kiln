--- a/Code/port.lisp
+++ b/Code/port.lisp
@@ -14,6 +14,20 @@ (in-package :fset)
 ;;; `without-interrupts'.  On kernel-threads implementations, we have to do
 ;;; real locking.
 
+#+kiln
+(progn
+  ;; kiln currently executes Lisp on one mutator without concurrent Lisp
+  ;; threads. This adapter implements FSet's non-threaded configuration.
+  (defun make-lock (&optional name)
+    (declare (ignore name)) nil)
+  (defmacro with-lock ((lock &key (wait? t)) &body body)
+    (let ((lock-var (gensym "LOCK")) (wait-var (gensym "WAIT")))
+      `(let ((,lock-var ,lock) (,wait-var ,wait?))
+         (declare (ignore ,lock-var ,wait-var))
+         ,@body)))
+  (defmacro read-memory-barrier () nil)
+  (defmacro write-memory-barrier () nil))
+
 #+allegro
 (progn
   (defun make-lock (&optional name)
@@ -375,8 +389,8 @@ (defun base-char-p (x)
