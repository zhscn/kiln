(let ((first "build/test/navigation-first.lisp")
      (second "build/test/navigation-second.lisp")
      (warnings 0))
  (unwind-protect
       (progn
         (dolist (file (list first second))
           (with-open-file (stream file :direction :output :if-exists :supersede)
             (write-string "(defun navigation-function () 17)" stream)))
         (load first)
         (handler-bind ((style-warning
                          (lambda (condition)
                            (when (typep condition 'kiln.compiler::source-redefinition-warning)
                              (incf warnings)
                              (muffle-warning condition)))))
           (load second))
         (print (= warnings 1))
         (print (null (kiln.sys:definitions-in-file first)))
         (let ((record (first (kiln.sys:definitions-in-file second))))
           (print (equal (kiln.sys:definition-form record)
                         '(defun navigation-function () 17))))
         (with-open-file (stream second :direction :output :if-exists :supersede)
           (write-string "(defun navigation-private () '#:private)" stream))
         (kiln.sys:reload-source-file second)
         (let ((saved (fdefinition 'navigation-private)))
           (kiln.sys:reload-source-file second)
           (print (eq saved (fdefinition 'navigation-private)))))
    (delete-file first) (delete-file second)))
(eval '(defstruct navigation-structure (value 0)))
(print (not (null (kiln.sys:find-definitions '(defstruct navigation-structure)))))
(eval '(defmacro navigation-expansion () 1))
(eval '(defmacro navigation-replaced () (navigation-expansion)))
(eval '(defun navigation-replaced () 29))
(eval '(defmacro navigation-expansion () 2))
(print (not (macro-function 'navigation-replaced)))
(print (funcall 'navigation-replaced))
(print (null (kiln.sys:find-definitions '(defmacro navigation-replaced))))
