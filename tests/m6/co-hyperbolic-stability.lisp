(dolist (x '(1d-20 -1d-20 1f-12 -1f-12))
  (assert (= (sinh x) x))
  (assert (= (tanh x) x)))
(dolist (function (list #'sinh #'tanh))
  (assert (= (float-sign (funcall function -0d0)) -1d0)))
(assert (= (cosh -0d0) 1d0))
(assert (typep (sinh 1) 'single-float))
(assert (typep (cosh 1f0) 'single-float))
(assert (typep (tanh 1d0) 'double-float))
(assert (= (tanh 1000d0) 1d0))
(assert (= (tanh -1000d0) -1d0))
(assert (< (abs (- (sinh 1d0) 1.1752011936438014d0)) 3d-16))
(assert (< (abs (- (cosh 1d0) 1.5430806348152437d0)) 3d-16))
(let* ((z #c(1d-20 1d-20)) (result (sinh z)))
  (assert (= result z)))
(assert (handler-case (progn (sinh 1000d0) nil) (floating-point-overflow () t)))
(assert (handler-case (progn (cosh 1000d0) nil) (floating-point-overflow () t)))
(assert (kiln.sys:float-infinity-p
         (kiln.sys:with-float-traps-masked (:overflow) (sinh 1000d0))))
(print :hyperbolic-stability)
