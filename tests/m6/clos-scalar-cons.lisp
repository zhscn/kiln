(defvar *scalar-cons-events* nil)
(defun scalar-cons-left () (push 'left *scalar-cons-events*) 1)
(defun scalar-cons-right () (push 'right *scalar-cons-events*) 2)
(let ((pair (cons (scalar-cons-left) (scalar-cons-right))) (other 3))
  (print (+ (car pair) (cdr pair) other)))
(print (nreverse *scalar-cons-events*))
(let ((value 1))
  (let ((pair (cons value (progn (setq value 3) value))))
    (print (list (car pair) (cdr pair) value))))
(let ((pair (cons nil '(2 3))))
  (print (if (car pair) 0 (cdr pair))))

(defun scalar-cons-probe ()
  (kiln.sys:%gc)
  (let* ((frame (find 'scalar-cons-visible (kiln.sys:frame-list) :key #'kiln.sys:frame-name))
         (pair (cdr (assoc 'pair (kiln.sys:frame-variables frame)))))
    (print (consp pair))
    (rplaca pair 9)))
(defun scalar-cons-visible ()
  (let ((pair (cons 1 2)))
    (scalar-cons-probe)
    (list (car pair) (cdr pair))))
(print (scalar-cons-visible))
(defvar *escaped-scalar-cons* nil)
(let ((pair (cons 3 4)))
  (setq *escaped-scalar-cons* pair)
  (print (car pair)))
(print (cdr *escaped-scalar-cons*))
(let ((pair (cons 1 2)))
  (rplaca pair 5)
  (print (list (car pair) (cdr pair))))
(let ((reader (let ((pair (cons 1 2))) (lambda () pair))))
  (print (eq (funcall reader) (funcall reader))))
(print (handler-case
           (let ((pair (cons 1 2)))
             (declare (fixnum pair))
             (car pair))
         (type-error (condition) (equal (type-error-datum condition) '(1 . 2)))))

(defun scalar-cons-mutate (flag)
  (let ((pair (cons 1 2)) (saved 0))
    (rplaca pair (cdr pair))
    (setq saved (car pair))
    (if flag (rplacd pair 7) (rplaca pair 8))
    (list saved (car pair) (cdr pair))))
(print (scalar-cons-mutate t))
(print (scalar-cons-mutate nil))
(print (let ((pair (cons 1 2))) (eq pair (rplaca pair 3))))
(print (let ((pair (cons 1 2))) (rplacd pair pair) (eq (cdr pair) pair)))
(let ((count 0))
  (let ((pair (cons 1 2)))
    (rplaca pair (progn (setq count (1+ count)) (cdr pair)))
    (print (list count (car pair) (cdr pair)))))
(defun scalar-cons-mutation-probe ()
  (kiln.sys:%gc)
  (let* ((frame (find 'scalar-cons-mutating (kiln.sys:frame-list) :key #'kiln.sys:frame-name))
         (pair (cdr (assoc 'pair (kiln.sys:frame-variables frame)))))
    (rplacd pair 42)
    9))
(defun scalar-cons-mutating ()
  (let ((pair (cons 1 2)))
    (rplaca pair (scalar-cons-mutation-probe))
    (list (car pair) (cdr pair))))
(print (scalar-cons-mutating))
