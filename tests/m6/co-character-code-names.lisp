(dolist (entry '(("U0" . 0) ("uED" . 237) ("U+20AC" . 8364)
                 ("u10FFFF" . 1114111) ("uDCF0" . 56560)))
  (assert (= (cdr entry) (char-code (name-char (car entry))))))
(dolist (name '("U" "U+" "U-1" "U110000" "UZZ" "U 41"))
  (assert (null (name-char name))))
(assert (= 237 (char-code (read-from-string "#\\uED"))))
(assert (= 56560 (char-code (read-from-string "#\\uDCF0"))))
(assert (= 31 (char-code (name-char "Us"))))
(print :character-code-names)
