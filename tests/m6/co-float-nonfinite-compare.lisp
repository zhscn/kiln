(let ((positive (kiln.sys:bits-double-float #x7ff0000000000000))
      (negative (kiln.sys:bits-single-float #xff800000)))
  (dolist (finite (list 0 1/3 -1f0 0d0 (expt 2 2000)))
    (assert (< negative finite positive))
    (assert (> positive finite negative))
    (assert (not (= positive finite)))
    (assert (not (= negative finite))))
  (assert (= positive (kiln.sys:bits-single-float #x7f800000)))
  (assert (= negative (kiln.sys:bits-double-float #xfff0000000000000))))
(dolist (nan (list (kiln.sys:bits-single-float #x7fc12345)
                   (kiln.sys:bits-double-float #x7ff8123456789abc)))
  (dolist (other (list nan 0 1/3 -1f0 0d0
                       (kiln.sys:bits-double-float #x7ff0000000000000)))
    (dolist (predicate (list #'= #'< #'> #'<= #'>=))
      (assert (not (funcall predicate nan other)))
      (assert (not (funcall predicate other nan))))
    (assert (/= nan other))))
(defun typed-float-comparisons (a b)
  (declare (double-float a b) (optimize (speed 3) (debug 0)))
  (list (< a b) (> a b) (<= a b) (>= a b) (= a b) (/= a b)
        (zerop a) (plusp a) (minusp a)))
(let ((nan (kiln.sys:bits-double-float #x7ff8123456789abc))
      (positive (kiln.sys:bits-double-float #x7ff0000000000000))
      (negative (kiln.sys:bits-double-float #xfff0000000000000)))
  (assert (equal '(nil nil nil nil nil t nil nil nil) (typed-float-comparisons nan 0d0)))
  (assert (equal '(nil t nil t nil t nil t nil) (typed-float-comparisons positive 0d0)))
  (assert (equal '(t nil t nil nil t nil nil t) (typed-float-comparisons negative 0d0))))
(assert (> (1+ (expt 2 53)) 9007199254740992d0))
(assert (< 1/10 0.1d0))
(print :nonfinite-comparisons)
