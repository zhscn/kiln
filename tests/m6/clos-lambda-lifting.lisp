(defun lifted-direct-calls (value)
  (labels ((add (n) (+ n value)))
    (declare (notinline add))
    (list (add 1) (add 2))))
(print (lifted-direct-calls 10))
(defun lifted-mutual-cells (value)
  (let ((count 0))
    (labels ((left (n)
               (declare (notinline right))
               (if (zerop n) (list value count) (progn (incf count) (right (1- n)))))
             (right (n)
               (declare (notinline left))
               (if (zerop n) (list count value) (progn (incf count) (left (1- n))))))
      (declare (notinline left right))
      (left 5))))
(print (lifted-mutual-cells (copy-seq "mutual")))
(defun make-lifted-caller (value)
  (labels ((read-value () value))
    (lambda () (declare (notinline read-value)) (read-value))))
(let ((a (make-lifted-caller (copy-seq "first")))
      (b (make-lifted-caller (copy-seq "second"))))
  (kiln.sys:%gc)
  (print (list (funcall a) (funcall b))))
(defun lifted-shared-function (value)
  (let ((count 0))
    (labels ((escaping () (incf count) value)
             (call-it () (declare (notinline escaping)) (escaping)))
      (declare (notinline call-it))
      (let ((function #'escaping))
        (list (call-it) (funcall function) (call-it) count)))))
(print (lifted-shared-function (copy-seq "shared")))
(defun make-lifted-nested (value)
  (labels ((outer (argument)
             (labels ((inner () (list argument value)))
               (lambda () (declare (notinline inner)) (inner)))))
    (declare (notinline outer))
    (outer (copy-seq "nested"))))
(let ((function (make-lifted-nested (copy-seq "capture"))))
  (kiln.sys:%gc)
  (print (funcall function)))
(defun lifted-many-arguments (a b c d e)
  (labels ((collect (x y z)
             (kiln.sys:%gc)
             (list a x b y c z d e)))
    (declare (notinline collect))
    (collect (copy-seq "x") (copy-seq "y") (copy-seq "z"))))
(print (lifted-many-arguments (copy-seq "a") (copy-seq "b") (copy-seq "c")
                              (copy-seq "d") (copy-seq "e")))
(defvar *lifted-special* 1)
(defun lifted-special-parameter (value)
  (labels ((read-special (*lifted-special*) (list value *lifted-special*)))
    (declare (notinline read-special))
    (list (read-special 8) *lifted-special*)))
(print (lifted-special-parameter (copy-seq "special")))
(defun lifted-argument-effects ()
  (let ((value 1))
    (labels ((read-value (ignored) (declare (ignore ignored)) value))
      (declare (notinline read-value))
      (list (read-value (setq value 2)) (read-value (setq value 3))))))
(print (lifted-argument-effects))
(defun make-lifted-optional (value)
  (labels ((helper (n) (if (zerop n) value (helper (1- n))))
           (read-value (&optional (x (helper 0))) x))
    #'read-value))
(let ((function (make-lifted-optional (copy-seq "default"))))
  (kiln.sys:%gc)
  (print (list (funcall function) (funcall function 7))))
(print (let ((cleanup 0))
         (list (block done
                 (labels ((leave () (return-from done 17)))
                   (declare (notinline leave))
                   (unwind-protect (leave) (incf cleanup))))
               cleanup)))
(print (let ((value 7))
         (labels ((wrong (x) (+ x value)))
           (declare (notinline wrong))
           (handler-case (wrong) (program-error () :wrong-arity)))))
(defun lifted-checked-parameter (value)
  (labels ((checked (x) (declare (type fixnum x)) (list value x)))
    (declare (notinline checked))
    (handler-case (checked (identity "bad")) (type-error () :type-error))))
(print (lifted-checked-parameter 9))
(print (let ((value 10))
         (flet ((read-value () value))
           (declare (notinline read-value))
           (flet ((read-value () (read-value)))
             (declare (notinline read-value))
             (read-value)))))

(defun make-lifted-parameter-cell (value)
  (labels ((build (item)
             (lambda (&optional new)
               (when new (setq item new))
               (list value item))))
    (declare (notinline build))
    (build (copy-seq "initial"))))
(let ((function (make-lifted-parameter-cell (copy-seq "rooted"))))
  (kiln.sys:%gc)
  (print (funcall function))
  (print (funcall function (copy-seq "changed"))))
