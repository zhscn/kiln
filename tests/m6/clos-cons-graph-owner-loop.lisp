(defmacro exercise-owner-graph-loop ()
  (let ((inner (gensym "INNER")) (outer (gensym "OUTER")))
    `(let ((,inner (cons (vector 17 18) nil)))
       (let ((,outer (cons ,inner nil)) (count 0))
         (tagbody again
            (rplaca ,inner (vector count))
            (rplacd ,inner ,outer)
            (kiln.sys:%gc)
            (print (eq (cdr (car ,outer)) ,outer))
            (incf count)
            (if (< count 3) (go again)))
         (print (svref (car ,inner) 0))))))
(exercise-owner-graph-loop)

(defmacro make-repeated-owner-graphs ()
  (let ((inner (gensym "INNER")) (outer (gensym "OUTER")))
    `(let ((saved nil) (count 0))
       (tagbody again
          (let ((,inner (cons count nil)))
            (let ((,outer (cons ,inner nil))) (push ,outer saved)))
          (incf count)
          (if (< count 3) (go again)))
       saved)))
(defun repeated-owner-graphs () (make-repeated-owner-graphs))
(let ((graphs (repeated-owner-graphs)))
  (kiln.sys:%gc)
  (print (mapcar #'caar graphs))
  (print (eq (car (first graphs)) (car (second graphs)))))

(defvar *owner-loop-holder* nil)
(defmacro store-owner-graph-child ()
  (let ((inner (gensym "INNER")) (outer (gensym "OUTER")))
    `(let ((,inner (cons 31 32)))
       (let ((,outer (cons ,inner nil)) (count 0))
         (tagbody again
            (setq *owner-loop-holder* (cons ,inner nil))
            (kiln.sys:%gc)
            (incf count)
            (if (< count 3) (go again)))
         (eq ,outer ,outer)
         nil))))
(defun retain-owner-loop-child () (store-owner-graph-child))
(retain-owner-loop-child)
(kiln.sys:%gc)
(print *owner-loop-holder*)
