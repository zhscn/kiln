(defmacro define-rest-reader ()
  (let ((items (gensym "ITEMS")))
    `(defun stack-rest-reader (prefix &optional (offset 10) &rest ,items)
       (let ((sum (+ prefix offset)))
         (tagbody again
           (when (null ,items) (go done))
           (kiln.sys:%gc)
           (incf sum (svref (car ,items) 0))
           (setq ,items (cdr ,items))
           (go again)
          done)
         sum))))
(define-rest-reader)
(print (stack-rest-reader 1))
(print (stack-rest-reader 1 2))
(print (stack-rest-reader 1 2 (vector 3)))
(print (stack-rest-reader 1 2 (vector 1) (vector 2) (vector 3) (vector 4)
                          (vector 5) (vector 6) (vector 7) (vector 8)))
(print (stack-rest-reader 1 2 (vector 1) (vector 2) (vector 3) (vector 4)
                          (vector 5) (vector 6) (vector 7) (vector 8) (vector 9)))
(defun escape-rest-tail (&rest items)
  (declare (dynamic-extent items))
  (cdr items))
(let ((tail (escape-rest-tail 1 (vector 41))))
  (kiln.sys:%gc)
  (print (svref (car tail) 0)))

(defmacro define-rest-exit ()
  (let ((items (gensym "ITEMS")))
    `(defun stack-rest-exit (tag &rest ,items)
       (kiln.sys:%gc)
       (throw tag (car ,items)))))
(define-rest-exit)
(print (svref (catch 'done
                (unwind-protect
                     (stack-rest-exit 'done (vector 53))
                  (kiln.sys:%gc))) 0))
(kiln.sys:%gc)
(print :after-unwind)
