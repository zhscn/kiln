(defun block-result-integer (flag)
  (+ 1 (block done (if flag (return-from done 4) 8))))
(print (block-result-integer t))
(print (block-result-integer nil))
(defun block-result-overflow (flag)
  (+ 1 (block done (if flag (return-from done 4611686018427387903) 0))))
(print (block-result-overflow t))
(print (block-result-overflow nil))
(defun block-result-mixed (flag)
  (block done (if flag (return-from done "word") 7)))
(print (block-result-mixed t))
(print (block-result-mixed nil))
(print (+ 1 (block done (block done (return-from done 3)) 4)))
(print (+ 1 (block done (funcall (lambda () (block inner (return-from inner 1))))
                       (return-from done 2))))
(print (+ 1 (block done (unwind-protect (return-from done 3) (return-from done 4)))))
(declaim (notinline invoke-block-result-exit))
(defun invoke-block-result-exit (function) (funcall function))
(print (block done (invoke-block-result-exit (lambda () (return-from done "nonlocal"))) 7))
(defun block-result-write (flag)
  (let ((value 1))
    (block done (if flag (return-from done 3)) (setq value "changed"))
    value))
(print (block-result-write t))
(print (block-result-write nil))
(print (multiple-value-list (block done (return-from done (values 3 4)))))
(print (multiple-value-list (block done (return-from done (values)))))
(print (block done (+ (return-from done 9) (error "Unreachable"))))
