(defun high-debug-double-arithmetic (a b)
  (declare (double-float a b) (optimize (speed 3) (debug 3)))
  (+ (* a b) (progn (kiln.sys:%gc) b)))
(print (= (high-debug-double-arithmetic 1.25d0 2d0) 4.5d0))
(print (handler-case (high-debug-double-arithmetic 1d0 "bad") (type-error () t)))
(defun high-debug-double-identity (a b)
  (declare (double-float a b) (optimize (speed 3) (debug 3)))
  (let ((result (+ (* a b) b))) (eq result result)))
(print (high-debug-double-identity 1.25d0 2d0))
