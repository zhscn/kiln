(eval '(defmacro observed-macro (x) `(list :expanded ,x)))
(multiple-value-bind (events values)
    (kiln.sys:collect-macroexpansions
     (lambda () (funcall (compile nil '(lambda () (observed-macro 7))))))
  (print values)
  (let ((event (find-if (lambda (event)
                          (and (eq (getf event :phase) :exit)
                               (equal (getf event :input) '(observed-macro 7)))) events)))
    (print (getf event :kind))
    (print (getf event :output))
    (print (and (search "OBSERVED-MACRO"
                        (with-output-to-string (out)
                          (kiln.sys:print-macroexpansions (list event) out))) t))))
(let ((events nil))
  (let ((kiln.sys:*macroexpansion-hook* (lambda (event) (push event events))))
    (eval '(defmacro bad-observed-macro () (error "expansion failed")))
    (handler-case (compile nil '(lambda () (bad-observed-macro)))
      (error () nil)))
  (print (some (lambda (event) (eq (getf event :phase) :error)) events)))
(multiple-value-bind (events values)
    (kiln.sys:collect-macroexpansions
     (lambda () (funcall (compile nil '(lambda ()
                                       (symbol-macrolet ((observed-symbol :symbol))
                                         observed-symbol))))))
  (print values)
  (print (some (lambda (event) (eq (getf event :kind) :symbol-macro)) events)))
(let ((*macroexpand-hook*
        (lambda (expander form environment)
          (if (and (consp form) (eq (first form) 'observed-macro))
              '(quote :hook)
              (funcall expander form environment)))))
  (print (funcall (compile nil '(lambda () (observed-macro 1))))))
