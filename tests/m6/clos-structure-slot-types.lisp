(defstruct slot-types
  (count 1 :type fixnum)
  (items #() :type simple-vector)
  (constant 3 :type fixnum :read-only t))
(defstruct (slot-types-child (:include slot-types (count 2)))
  (weight 1d0 :type double-float))
(defstruct (slot-types-boa (:constructor make-slot-types-boa (count)))
  (count 0 :type fixnum))
(defun typed-slot-arithmetic (object)
  (+ (slot-types-count object) (length (slot-types-items object))))
(let ((object (make-slot-types :count 4 :items #(a b))))
  (print (= 6 (typed-slot-arithmetic object)))
  (print (= 7 (setf (slot-types-count object) 7)))
  (print (= 7 (slot-types-count object)))
  (print (handler-case (setf (slot-types-count object) "bad") (type-error () t)))
  (print (= 7 (slot-types-count object)))
  (print (handler-case (setf (slot-types-items object) '(a)) (type-error () t)))
  (print (handler-case (make-slot-types :count "bad") (type-error () t)))
  (print (handler-case (make-slot-types-boa "bad") (type-error () t)))
  (print (= 3 (slot-types-constant object)))
  (print (handler-case (slot-types-count 'bad) (type-error () t))))
(let ((child (make-slot-types-child :count 5)))
  (print (= 5 (slot-types-count child)))
  (print (= 5 (slot-types-child-count child)))
  (print (handler-case (setf (slot-types-child-count child) 'bad) (type-error () t))))
