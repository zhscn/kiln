(defun find-symbol-pair (vector)
  (declare (type simple-vector vector))
  (search '(a b) vector))
(defun find-number-pair (vector)
  (declare (type simple-vector vector))
  (search '(10 20) vector))
(print (list (find-symbol-pair #(z a b a b))
             (find-symbol-pair #(a b))
             (find-symbol-pair #(z z a b))
             (find-symbol-pair #(a))
             (find-symbol-pair #())
             (find-symbol-pair #(a z b))))
(print (list (find-number-pair #(10 20 30))
             (find-number-pair #(0 10 20))
             (find-number-pair #(10 10 20))
             (find-number-pair #(10))))
