(defun return-lifetime-source (n)
  (if (zerop n) (values) (values :a :b :c)))
(defun return-lifetime-loop (n)
  (multiple-value-prog1 (return-lifetime-source 3)
    (dotimes (i n) (return-lifetime-source i) (kiln.sys:%gc))))
(defun return-lifetime-cleanup ()
  (unwind-protect (return-lifetime-source 3) (return-lifetime-source 0) (kiln.sys:%gc)))
(defun return-lifetime-zero-join (flag)
  (if flag (values) (return-lifetime-source 3)))
(print (equal '(:a :b :c) (multiple-value-list (return-lifetime-loop 4))))
(print (equal '(:a :b :c) (multiple-value-list (return-lifetime-cleanup))))
(print (null (multiple-value-list (return-lifetime-zero-join t))))
(print (equal '(:a :b :c) (multiple-value-list (return-lifetime-zero-join nil))))
(print (equal '(:a :b :c :a :b :c)
              (multiple-value-call #'list
                (return-lifetime-source 3) (return-lifetime-source 0)
                (return-lifetime-source 3))))
