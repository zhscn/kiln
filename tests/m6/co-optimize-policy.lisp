(eval '(proclaim '(optimize (speed 0))))
(eval '(defun policy-global-target (x) (+ x 100)))
(eval '(define-compiler-macro policy-global-target (x) `(+ ,x 1)))
(eval '(defun policy-global-slow (x) (policy-global-target x)))
(print (policy-global-slow 10))
(eval '(proclaim '(optimize (speed 3))))
(eval '(defun policy-global-fast (x) (policy-global-target x)))
(print (policy-global-fast 10))
(print (policy-global-slow 10))
(print (funcall (compile nil '(lambda (x)
                               (locally (declare (optimize (speed 0)))
                                 (policy-global-target x)))) 10))
(print (funcall (compile nil '(lambda (x)
                               (declare (fixnum x) (optimize (safety 1)))
                               (+ x 1))) 10))
(print (handler-case
           (funcall (compile nil '(lambda (x)
                                   (declare (fixnum x) (optimize (safety 3))) x)) :bad)
         (type-error () :checked)))
(eval '(defun policy-rest-reader (&rest items)
         (declare (optimize (debug 0)))
         (kiln.sys:%gc)
         (svref (car items) 0)))
(print (policy-rest-reader (vector 31)))
