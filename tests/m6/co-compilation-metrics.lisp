(let ((kiln.compiler::*compilation-metrics* nil) (calls 0))
  (assert (equal (multiple-value-list
                  (kiln.compiler::with-compilation-phase (:disabled)
                    (incf calls) (values 1 nil 3)))
                 '(1 nil 3)))
  (assert (= calls 1)))
(let ((kiln.compiler::*compilation-metrics* (make-hash-table :test 'eq))
      (kiln.compiler::*compilation-metrics-frame* nil)
      (kiln.compiler::*compilation-metric-details* (make-hash-table :test 'equal)))
  (assert (eq (catch 'done
                (kiln.compiler::with-compilation-phase (:outer)
                  (kiln.compiler::with-compilation-phase (:inner)
                    (throw 'done :done)))) :done))
  (let ((outer (gethash :outer kiln.compiler::*compilation-metrics*))
        (inner (gethash :inner kiln.compiler::*compilation-metrics*)))
    (assert (= (svref outer 4) 1 (svref inner 4)))
    (assert (>= (svref outer 0) (svref inner 0)))
    (assert (>= (svref outer 2) 0)))
  (clrhash kiln.compiler::*compilation-metrics*)
  (let ((function (compile nil '(lambda (x) (+ x 1)))))
    (assert (= (funcall function 41) 42)))
  (dolist (phase '(:frontend :mir-build :mir-optimize :mir-lir :lir-normalize :backend))
    (let ((entry (gethash phase kiln.compiler::*compilation-metrics*)))
      (assert entry)
      (assert (plusp (svref entry 4)))
      (assert (>= (svref entry 0) (svref entry 2) 0))))
  (let ((total (gethash :mir-analysis kiln.compiler::*compilation-metrics*))
        (details kiln.compiler::*compilation-metric-details*))
    (assert (plusp (hash-table-count details)))
    (dotimes (index 5)
      (assert (= (svref total index)
                 (loop for entry being the hash-values of details sum (svref entry index)))))))
(print :compilation-metrics)
