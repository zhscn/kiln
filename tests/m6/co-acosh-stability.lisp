(dolist (value '(0d0 0.14285714285714285d0 0.5d0 -0.5d0 -1d0))
  (let ((result (acosh value)))
    (assert (zerop (realpart result)))
    (assert (< (abs (- (imagpart result) (acos value))) 3d-15))))
(dolist (sign '(1d0 -1d0))
  (let* ((tiny (* sign 1d-300)) (result (acosh (complex 0d0 tiny))))
    (assert (< (abs (- (/ (realpart result) 1d-300) 1d0)) 3d-15))
    (assert (< (abs (- (imagpart result) (* sign (/ pi 2)))) 3d-16))))
(assert (< (abs (- (acosh 1d300) (+ (log 1d300) (log 2d0)))) 1d-12))
(assert (zerop (acosh 1d0)))
(assert (typep (acosh 0.5f0) '(complex single-float)))
(assert (= -1d0 (float-sign (imagpart (acosh #c(2d0 -0d0))))))
(print :acosh-stability)
