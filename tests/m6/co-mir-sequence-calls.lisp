(defvar *mir-search-events* nil)
(dolist (pipeline '(:hir :mir))
  (let* ((kiln.compiler::*compiler-pipeline* pipeline)
         (member-eq (compile nil '(lambda (item list)
                                   (member (progn (push :item *mir-search-events*) item)
                                           (progn (push :list *mir-search-events*) list)
                                           :test (progn (push :test *mir-search-events*) #'eq)))))
         (member-eql (compile nil '(lambda (item list) (member item list))))
         (assoc-eq (compile nil '(lambda (item list) (assoc item list :test 'eq))))
         (assoc-eql (compile nil '(lambda (item list) (assoc item list :test #'eql))))
         (ordinary (compile nil '(lambda (item list) (declare (notinline assoc)) (assoc item list :test #'eq))))
         (number (+ (expt 2 70) 1)) (other (+ (expt 2 70) 1))
         (item (list :item)) (tail (list item)) (pair (cons item 7)))
    (let ((list (list other))) (print (eq (funcall member-eql number list) list)))
    (setf *mir-search-events* nil)
    (print (eq (funcall member-eq item (cons :other tail)) tail))
    (print (equal *mir-search-events* '(:test :list :item)))
    (print (eq (funcall assoc-eq item (list nil (cons :other 0) pair)) pair))
    (let ((numeric-pair (cons other 9)))
      (print (eq (funcall assoc-eql number (list numeric-pair)) numeric-pair)))
    (let ((list (list (list :x 1) (list :y 2))))
      (print (eq (member :x list :key #'car) list)))
    (let ((list (list "abc" "def")))
      (print (eq (member (copy-seq "abc") list :test #'equal) list))
      (print (null (member (copy-seq "abc") list :test #'eq :test #'equal))))
    (print (eq (funcall ordinary item (list pair)) pair))
    (print (and (null (funcall member-eql :absent nil)) (null (funcall assoc-eq :absent nil))))))
