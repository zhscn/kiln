(setq *print-pretty* nil)
(defun lifted-optionals (value)
  (let ((effects 0))
    (labels ((read-value (&optional (a (progn (incf effects) value) a-p)
                                   (b (list a value) b-p))
               (list a a-p b b-p effects)))
      (declare (notinline read-value))
      (list (read-value) (read-value 7) (read-value 8 9)))))
(print (lifted-optionals (copy-seq "optional")))
(defun lifted-rest (a b c d)
  (labels ((collect (required &rest rest)
             (kiln.sys:%gc)
             (list a b c d required rest)))
    (declare (notinline collect))
    (list (collect 1) (collect 2 3 4 5 6))))
(print (lifted-rest (copy-seq "a") (copy-seq "b") (copy-seq "c") (copy-seq "d")))
(defun lifted-keywords (value)
  (labels ((collect (&key (a value a-p) (b (list a value) b-p))
             (list a a-p b b-p)))
    (declare (notinline collect))
    (list (collect) (collect :a 7) (collect :b 8 :a 9) (collect :a 2 :a 3))))
(print (lifted-keywords (copy-seq "key")))
(defun lifted-rest-keywords (value)
  (labels ((collect (&rest rest &key (a value supplied-p) &allow-other-keys)
             (kiln.sys:%gc)
             (list rest a supplied-p)))
    (declare (notinline collect))
    (list (collect) (collect :a 7 :extra 8))))
(print (lifted-rest-keywords (copy-seq "rest-key")))
(defvar *lifted-default-special* 1)
(defun lifted-default-special (value)
  (labels ((collect (&optional (*lifted-default-special* value)
                              (a (list *lifted-default-special* value))
                    &key (b (list a *lifted-default-special*)))
             (list a b *lifted-default-special*)))
    (declare (notinline collect))
    (list (collect) (collect 9 8 :b 7) *lifted-default-special*)))
(print (lifted-default-special 5))
(defun lifted-recursive-optional (value)
  (let ((defaults 0))
    (labels ((visit (&optional (n (progn (incf defaults) 2)))
               (declare (notinline visit))
               (if (zerop n) (list value defaults) (visit (1- n)))))
      (declare (notinline visit))
      (list (visit) (visit 1)))))
(print (lifted-recursive-optional (copy-seq "recursive")))
(defun make-lifted-keyword-caller (value)
  (labels ((collect (&key (x value)) (list value x)))
    (lambda () (declare (notinline collect)) (collect :x 7))))
(let ((function (make-lifted-keyword-caller (copy-seq "escaped"))))
  (kiln.sys:%gc)
  (print (funcall function)))
(defun lifted-keyword-effects ()
  (let ((value 0))
    (labels ((collect (&key (x (incf value))) (list x value)))
      (declare (notinline collect))
      (list (collect :x (incf value)) (collect) (collect :x (incf value))))))
(print (lifted-keyword-effects))
(defun lifted-invalid-keyword (value keyword)
  (labels ((collect (&key x) (list value x)))
    (declare (notinline collect))
    (handler-case (collect keyword 1) (program-error () :invalid-keyword))))
(print (lifted-invalid-keyword 7 :unknown))
(defun lifted-odd-keyword (value)
  (labels ((collect (&key x) (list value x)))
    (declare (notinline collect))
    (handler-case (collect :x) (program-error () :odd-keyword))))
(print (lifted-odd-keyword 8))
(defun lifted-checked-default (value)
  (labels ((collect (&optional (x value))
             (declare (type fixnum x)) x))
    (declare (notinline collect))
    (handler-case (collect) (type-error () :type-error))))
(print (lifted-checked-default "bad"))
(defun lifted-allow-other-keys (value)
  (labels ((collect (&key (x value)) x))
    (declare (notinline collect))
    (collect :unknown 7 :allow-other-keys t)))
(print (lifted-allow-other-keys (copy-seq "allowed")))
(macrolet ((call-at-limit ()
             `(let ((value (copy-seq "limit")))
                (flet ((collect (&rest args) (list value (length args))))
                  (declare (notinline collect))
                  (collect ,@(loop repeat 1024 collect 1))))))
  (print (call-at-limit)))
