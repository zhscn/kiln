(labels ((sum-down (n) (if (zerop n) 0 (+ n (sum-down (1- n))))))
  (declare (notinline sum-down))
  (print (sum-down 6)))
(defun make-static-recursive ()
  (labels ((ping (n) (if (zerop n) #'pong (pong (1- n))))
           (pong (n) (if (zerop n) #'ping (ping (1- n)))))
    #'ping))
(print (eq (make-static-recursive) (make-static-recursive)))
(let ((function (make-static-recursive)))
  (kiln.sys:%gc)
  (print (eq function (funcall function 1))))
(defun make-stateful-recursive (value)
  (labels ((ping (n) (pong n))
           (pong (n) (if (zerop n) value (ping (1- n)))))
    #'ping))
(let ((first (make-stateful-recursive 11)) (second (make-stateful-recursive 22)))
  (kiln.sys:%gc)
  (print (funcall first 3))
  (print (funcall second 3))
  (print (not (eq first second))))
(defun make-mixed-functions (value)
  (labels ((closed (n) (if (zerop n) 0 (+ n (closed (1- n)))))
           (stateful () value))
    (list #'closed #'stateful)))
(let ((functions (make-mixed-functions 77)))
  (kiln.sys:%gc)
  (print (funcall (first functions) 5))
  (print (funcall (second functions))))
(print (block done
         (flet ((leave () (return-from done 17)))
           (declare (notinline leave))
           (leave)
           0)))
(defun make-indirect-static ()
  (labels ((helper (n) (if (zerop n) 0 (+ n (helper (1- n))))))
    (lambda (n) (helper n))))
(let ((function (make-indirect-static)))
  (kiln.sys:%gc)
  (print (funcall function 5)))
(defvar *static-function-bias* 1)
(labels ((sum-bias (n) (if (zerop n) 0 (+ *static-function-bias* (sum-bias (1- n))))))
  (declare (notinline sum-bias))
  (let ((*static-function-bias* 3)) (print (sum-bias 3))))
(labels ((ping (vector n) (if (zerop n) (pong vector) (ping vector (1- n))))
         (pong (vector) (kiln.sys:%gc) (aref vector 0)))
  (declare (notinline ping pong))
  (print (ping (vector 99) 4)))
(let ((function (labels ((self (&optional (value #'self)) value)) #'self)))
  (print (eq function (funcall function))))
(defun make-optional-function (value)
  (flet ((read-value (&optional (argument value)) argument)) #'read-value))
(print (funcall (make-optional-function 42)))
(print (funcall (make-optional-function 84)))

(labels ((helper (n) (if (zerop n) 0 (helper (1- n)))))
  (let ((pair (cons 1 2)))
    (print (funcall (lambda (&optional left right) (+ left right (helper 0)))
                    (car pair) (cdr pair)))))
