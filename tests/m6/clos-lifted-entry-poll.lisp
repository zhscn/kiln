(defun lifted-entry-poll-loop (value count)
  (let ((checksum 0))
    (labels ((entry-step (n) (+ n (length value)))
             (entry-default (&optional (n 1)) (+ n (length value))))
      (declare (notinline entry-step entry-default))
      (dotimes (index count)
        (incf checksum (entry-step index))
        (incf checksum (entry-default))))
    checksum))
(kiln.sys:start-profiler :mode :cpu :interval 50)
(let ((value (lifted-entry-poll-loop (copy-seq "poll") 100000)))
  (kiln.sys:stop-profiler)
  (print value))
(print (plusp (reduce #'+ (kiln.sys:profile-samples) :key #'car)))
