;;; Cached native artifacts still execute each top-level effect and macro expansion.
(defun show (x) (write-line (prin1-to-string x)))
(defvar *effects* 0)
(kiln.sys:clear-compilation-cache)
(eval '(incf *effects*))
(eval '(incf *effects*))
(show *effects*)
(show (multiple-value-bind (hits misses entries) (kiln.sys:compilation-cache-statistics)
        (and (= hits 1) (= misses 1) (= entries 1))))
(defvar *expansions* 0)
(eval '(defmacro cached-value () (incf *expansions*) 41))
(kiln.sys:clear-compilation-cache)
(show (list (eval '(car (list (cached-value)))) (eval '(car (list (cached-value)))) *expansions*))
(eval '(defmacro cached-value () (incf *expansions*) 42))
(show (list (eval '(car (list (cached-value)))) *expansions*))

;;; Different quoted objects must retain their own identity on replay.
(let ((a (list 1)) (b (list 1)))
  (show (list (eq (eval `(identity ',a)) a) (eq (eval `(identity ',b)) b))))
(let ((a (copy-seq "same")) (b (copy-seq "same")))
  (show (list (eq (eval `(identity ',a)) a) (eq (eval `(identity ',b)) b))))

;;; Load-time cells belong to one compilation and must not alter older functions.
(let* ((form '(function (lambda () (load-time-value (list 1)))))
       (first (eval form)) (second (eval form)))
  (setf (car (funcall first)) 7)
  (show (list (car (funcall first)) (car (funcall second))
              (eq (funcall first) (funcall second)))))
(let ((kiln.sys:*compilation-cache-limit* 2))
  (kiln.sys:clear-compilation-cache)
  (eval '(+ *effects* 1)) (eval '(+ *effects* 2)) (eval '(+ *effects* 3))
  (show (multiple-value-bind (hits misses entries) (kiln.sys:compilation-cache-statistics)
          (declare (ignore hits)) (and (= misses 3) (= entries 2)))))
(let ((kiln.sys:*compilation-cache-limit* 1))
  (eval '(+ *effects* 3))
  (show (multiple-value-bind (hits misses entries) (kiln.sys:compilation-cache-statistics)
          (declare (ignore hits misses)) (= entries 1))))
(kiln.sys:clear-compilation-cache)
(show (multiple-value-list (kiln.sys:compilation-cache-statistics)))
