;;; Cached native artifacts still execute each top-level effect and macro expansion.
(defun show (x) (write-line (prin1-to-string x)))
(defvar *effects* 0)
(kiln.sys:clear-compilation-cache)
(eval '(incf *effects*))
(eval '(incf *effects*))
(show *effects*)
(show (multiple-value-bind (hits misses entries) (kiln.sys:compilation-cache-statistics)
        (and (= hits 1) (= misses 1) (= entries 1))))
(defvar *expansions* 0)
(eval '(defmacro cached-value () (incf *expansions*) 41))
(kiln.sys:clear-compilation-cache)
(show (list (eval '(car (list (cached-value)))) (eval '(car (list (cached-value)))) *expansions*))
(eval '(defmacro cached-value () (incf *expansions*) 42))
(show (list (eval '(car (list (cached-value)))) *expansions*))

;;; Different quoted objects must retain their own identity on replay.
(let ((a (list 1)) (b (list 1)))
  (show (list (eq (eval `(identity ',a)) a) (eq (eval `(identity ',b)) b))))
(let ((a (copy-seq "same")) (b (copy-seq "same")))
  (show (list (eq (eval `(identity ',a)) a) (eq (eval `(identity ',b)) b))))

;;; Load-time cells belong to one compilation and must not alter older functions.
(let* ((form '(function (lambda () (load-time-value (list 1)))))
       (first (eval form)) (second (eval form)))
  (setf (car (funcall first)) 7)
  (show (list (car (funcall first)) (car (funcall second))
              (eq (funcall first) (funcall second)))))
(let ((kiln.sys:*compilation-cache-limit* 2))
  (kiln.sys:clear-compilation-cache)
  (eval '(+ *effects* 1)) (eval '(+ *effects* 2)) (eval '(+ *effects* 3))
  (show (multiple-value-bind (hits misses entries) (kiln.sys:compilation-cache-statistics)
          (declare (ignore hits)) (and (= misses 3) (= entries 2)))))
(let ((kiln.sys:*compilation-cache-limit* 1))
  (eval '(+ *effects* 3))
  (show (multiple-value-bind (hits misses entries) (kiln.sys:compilation-cache-statistics)
          (declare (ignore hits misses)) (= entries 1))))
(kiln.sys:clear-compilation-cache)
(show (multiple-value-list (kiln.sys:compilation-cache-statistics)))

(defvar *file-cache-expansions* 0)
(defvar *file-cache-result* 7)
(defmacro file-cache-macro ()
  (incf *file-cache-expansions*)
  *file-cache-result*)

(let ((source "build/test/compilation-cache-input.lisp")
      (output "build/test/compilation-cache-input.fasl")
      (compiler (symbol-function 'kiln.compiler::compile-module))
      (lowerings 0)
      (literal-lowerings 0))
  (unwind-protect
       (progn
         (with-open-file (stream source :direction :output :if-exists :supersede)
           (write-line "(defun file-cache-value (x) (+ x (file-cache-macro)))" stream)
           (write-line "(defun file-cache-literal () (values '#1=(1 2 3) '#1#))" stream))
         (setf (symbol-function 'kiln.compiler::compile-module)
               (lambda (forms name &rest arguments)
                 (when (and (>= (length name) 5) (string= name "file-" :end1 5))
                   (case (car (kiln.compiler::toplevel-form-definition (first forms)))
                     (file-cache-value (incf lowerings))
                     (file-cache-literal (incf literal-lowerings))))
                 (apply compiler forms name arguments)))
         (assert (compile-file source :output-file output :verbose nil :print nil))
         (assert (= lowerings 1))
         (assert (= *file-cache-expansions* 1))
         (assert (compile-file source :output-file output :verbose nil :print nil))
         (assert (= lowerings 1))
         (assert (= literal-lowerings 1))
         (assert (= *file-cache-expansions* 2))
         (load output)
         (assert (= (funcall 'file-cache-value 1) 8))
         (multiple-value-bind (literal alias) (funcall 'file-cache-literal)
           (assert (eq literal alias))
           (setf *file-cache-result* 11)
           (assert (compile-file source :output-file output :verbose nil :print nil))
           (assert (= lowerings 2))
           (assert (= literal-lowerings 1))
           (load output)
           (assert (= (funcall 'file-cache-value 1) 12))
           (multiple-value-bind (fresh alias) (funcall 'file-cache-literal)
             (assert (equal literal fresh))
             (assert (eq fresh alias))
             (assert (not (eq literal fresh))))))
    (setf (symbol-function 'kiln.compiler::compile-module) compiler)
    (when (probe-file source) (delete-file source))
    (when (probe-file output) (delete-file output))
    (kiln.sys:clear-compilation-cache)))
