(dolist (bits '(0 #x80000000 #x1 #x7f7fffff #x7f800000 #xff800000 #x7fc12345 #x7f812345))
  (let ((value (kiln.sys:bits-single-float bits)))
    (assert (= bits (kiln.sys:single-float-bits value)))
    (assert (eq (not (null (kiln.sys:float-infinity-p value)))
                (not (null (member bits '(#x7f800000 #xff800000))))))
    (assert (eq (not (null (kiln.sys:float-nan-p value)))
                (not (null (member bits '(#x7fc12345 #x7f812345))))))))
(dolist (bits '(0 #x8000000000000000 #x1 #x7fefffffffffffff #x7ff0000000000000
               #xfff0000000000000 #x7ff8123456789abc #x7ff0123456789abc))
  (let ((value (kiln.sys:bits-double-float bits)))
    (assert (= bits (kiln.sys:double-float-bits value)))))
(dolist (thunk (list (lambda () (kiln.sys:bits-single-float -1))
                    (lambda () (kiln.sys:bits-single-float #x100000000))
                    (lambda () (kiln.sys:bits-double-float #x10000000000000000))
                    (lambda () (kiln.sys:single-float-bits 1d0))
                    (lambda () (kiln.sys:double-float-bits 1f0))
                    (lambda () (kiln.sys:float-nan-p 0))))
  (assert (handler-case (progn (funcall thunk) nil) (type-error () t))))
(print :float-bit-interface)
