(defmacro exercise-stack-graph ()
  (let ((inner (gensym "INNER")) (outer (gensym "OUTER")))
    `(let ((,inner (cons (vector 17 18) nil)))
       (declare (dynamic-extent ,inner))
       (let ((,outer (cons ,inner (vector 23))))
         (declare (dynamic-extent ,outer))
         (print (eq ,outer ,outer))
         (kiln.sys:%gc)
         (print (eq (car ,outer) ,inner))
         (print (svref (car (car ,outer)) 1))
         (rplacd ,inner ,outer)
         (kiln.sys:%gc)
         (print (eq (cdr (car ,outer)) ,outer))
         (print (svref (cdr ,outer) 0))))))
(exercise-stack-graph)

(defmacro exercise-stack-cycle ()
  (let ((pair (gensym "PAIR")))
    `(let ((,pair (cons (vector 31) nil)))
       (rplacd ,pair ,pair)
       (kiln.sys:%gc)
       (print (eq (cdr ,pair) ,pair))
       (print (svref (car ,pair) 0)))))
(exercise-stack-cycle)

(defmacro make-cons-graph (return-inner)
  (let ((inner (gensym "INNER")) (outer (gensym "OUTER")))
    `(let ((,inner (cons 41 42)))
       (let ((,outer (cons ,inner nil)))
         (eq ,outer ,outer)
         ,(if return-inner `(car ,outer) outer)))))
(defun escaping-cons-graph () (make-cons-graph nil))
(defun escaping-cons-child () (make-cons-graph t))
(let ((graph (escaping-cons-graph))) (kiln.sys:%gc) (print graph))
(let ((child (escaping-cons-child))) (kiln.sys:%gc) (print child))

(defvar *graph-holder* (cons nil nil))
(defmacro store-graph-child ()
  (let ((inner (gensym "INNER")) (outer (gensym "OUTER")))
    `(let ((,inner (cons 51 52)))
       (let ((,outer (cons ,inner nil)))
         (rplaca *graph-holder* ,inner)
         (eq ,outer ,outer)
         nil))))
(defun retain-graph-child () (store-graph-child))
(retain-graph-child)
(kiln.sys:%gc)
(print (car *graph-holder*))

(defvar *debug-graph-child* nil)
(defun inspect-cons-graph ()
  (kiln.sys:%gc)
  (let* ((frame (find 'visible-cons-graph (kiln.sys:frame-list) :key #'kiln.sys:frame-name))
         (parent (cdr (assoc 'parent (kiln.sys:frame-variables frame)))))
    (setq *debug-graph-child* (car parent))
    (rplaca *debug-graph-child* 99)))
(defun visible-cons-graph ()
  (let ((child (cons 61 62)))
    (let ((parent (cons child nil)))
      (inspect-cons-graph)
      (car (car parent)))))
(print (visible-cons-graph))
(kiln.sys:%gc)
(print *debug-graph-child*)

(defmacro borrow-cons-graph ()
  (let ((inner (gensym "INNER")) (outer (gensym "OUTER")))
    `(flet ((read-child (item) (car item)))
       (declare (notinline read-child))
       (let ((,inner (cons 71 72)))
         (let ((,outer (cons ,inner nil)))
           (eq ,outer ,outer)
           (read-child ,outer))))))
(defun return-borrowed-graph-child () (borrow-cons-graph))
(let ((child (return-borrowed-graph-child))) (kiln.sys:%gc) (print child))
