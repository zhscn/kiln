(let* ((source (make-string-input-stream "ab"))
       (joined (make-concatenated-stream (make-string-input-stream "") source)))
  (assert (char= #\a (read-char joined)))
  (unread-char #\a joined)
  (assert (char= #\a (read-char source)))
  (assert (char= #\b (peek-char nil joined)))
  (assert (char= #\b (read-char source))))
(let* ((source (make-string-input-stream "a)"))
       (joined (make-concatenated-stream (make-string-input-stream "#\\") source)))
  (assert (char= #\a (read joined)))
  (assert (char= #\) (read-char source))))
(let* ((source (make-string-input-stream "z"))
       (inner (make-concatenated-stream source))
       (outer (make-concatenated-stream inner)))
  (unread-char (read-char outer) outer)
  (assert (char= #\z (read-char source))))
(print :concatenated-unread)
