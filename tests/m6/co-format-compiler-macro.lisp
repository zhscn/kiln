(defun format-cm-cross (text)
  (format nil "~(~a~) ~d ~{~s~^,~}" text 17 '(a b)))
(print (format-cm-cross "UPPER"))
(print (funcall (compile nil '(lambda (text)
                               (format nil "~(~a~) ~d ~{~s~^,~}" text 17 '(a b)))) "UPPER"))
(dolist (entry '(("~a ~s ~d" hello (a b) 17)
                 ("~:[no~;yes~] ~@[value ~a~]" t 23)
                 ("~:{(~a ~a)~}" ((1 2) (3 4)))
                 ("~a ~:*~a ~,2f" again 1.25d0)
                 ("~(~a~) ~:@(~a~)" "LOWER" "upper")))
  (let* ((control (car entry)) (arguments (cdr entry))
         (function (compile nil `(lambda ()
                                   (format nil ,control
                                           ,@(mapcar (lambda (value) (list 'quote value)) arguments))))))
    (print (equal (funcall function) (apply #'format nil control arguments)))))
(let ((events nil))
  (print (format nil "~a~a" (progn (push 1 events) 'a) (progn (push 2 events) 'b)))
  (print events))
