(defmacro stack-cons-exercise ()
  (let ((pair (gensym "PAIR")) (alias (gensym "ALIAS")))
    `(let ((,pair (cons (vector 17 18) (cons 23 24))))
       (declare (dynamic-extent ,pair))
       (let ((,alias (if (consp ,pair) ,pair nil)))
         (kiln.sys:%gc)
         (print (eq ,pair ,alias))
         (rplaca ,alias (vector 31 32))
         (kiln.sys:%gc)
         (print (svref (car ,pair) 1))
         (print (cdr (cdr ,pair)))))))
(stack-cons-exercise)

(print (let ((pair (cons 1 2))) (declare (dynamic-extent pair))
         (eq pair (rplaca pair 3))))

(defvar *stack-cons-escaped* nil)
(let ((pair (cons 7 8)))
  (declare (dynamic-extent pair))
  (setq *stack-cons-escaped* pair))
(kiln.sys:%gc)
(print *stack-cons-escaped*)

(defmacro stack-cons-exit (tag)
  (let ((pair (gensym "PAIR")))
    `(let ((,pair (cons (vector 41) nil)))
       (declare (dynamic-extent ,pair))
       (kiln.sys:%gc)
       (throw ',tag (svref (car ,pair) 0)))))
(defun stack-cons-unwind () (stack-cons-exit finish))
(print (catch 'finish (unwind-protect (stack-cons-unwind) (kiln.sys:%gc))))
(kiln.sys:%gc)
(print :after-unwind)

(defmacro stack-cons-loop ()
  (let ((pair (gensym "PAIR")))
    `(let ((,pair (cons nil nil)) (counter 0))
       (declare (dynamic-extent ,pair))
       (tagbody again
          (rplaca ,pair (vector counter))
          (kiln.sys:%gc)
          (print (svref (car ,pair) 0))
          (incf counter)
          (when (< counter 3) (go again)))
       nil)))
(stack-cons-loop)

(defmacro stack-cons-across-stack ()
  (let ((pair (gensym "PAIR")))
    `(let ((,pair (cons (vector 53) nil)))
       (declare (dynamic-extent ,pair))
       (kiln.sys:%call-on-new-stack (lambda (ignored) (declare (ignore ignored)) (kiln.sys:%gc)) nil)
       (print (svref (car ,pair) 0)))))
(stack-cons-across-stack)
