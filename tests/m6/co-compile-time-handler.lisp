(defmacro invalid-during-expansion ()
  (error "Invalid syntax detected during macro expansion"))
(multiple-value-bind (value condition)
    (ignore-errors (eval '(invalid-during-expansion)) :missing-error)
  (assert (null value))
  (assert (typep condition 'error)))
(multiple-value-bind (value condition)
    (ignore-errors (compile nil '(lambda () (invalid-during-expansion))) :missing-error)
  (assert (null value))
  (assert (typep condition 'error)))
(assert (equal '(1 2) (multiple-value-list (values 1 2))))
(print :compile-time-handler)
