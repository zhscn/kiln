(dolist (pair '((#c(2d0 3d0) #c(1.6741492280355401d0 0.8959774761298381d0))
                (#c(-7d0 0.1d0) #c(0.018897741595958507d0 2.645818800416504d0))
                (#c(5.7d0 -2.9d0) #c(2.459198119522682d0 -0.5896230923767287d0))))
  (let ((result (sqrt (first pair))) (reference (second pair)))
    (assert (< (abs (- result reference)) (* 2d-16 (abs reference))))))
(assert (= (sqrt #c(2f0 3f0)) #c(1.6741493f0 0.8959775f0)))
(dolist (scale '(1d300 1d-300))
  (let* ((z (complex scale scale)) (root (sqrt z)))
    (assert (< (abs (- (/ (* root root) scale) #c(1d0 1d0))) 8d-16))))
(dolist (sign '(1d0 -1d0))
  (let ((root (sqrt (complex -4d0 (* sign 0d0)))))
    (assert (= (realpart root) 0d0))
    (assert (= (imagpart root) (* sign 2d0)))))
(let ((infinity (kiln.sys:bits-double-float #x7ff0000000000000)))
  (dolist (z (list (complex infinity 1d0) (complex (- infinity) -0d0)
                  (complex 1d0 infinity)))
    (let ((root (sqrt z)))
      (assert (or (kiln.sys:float-infinity-p (realpart root))
                  (kiln.sys:float-infinity-p (imagpart root))))
      (assert (= (float-sign (imagpart root)) (float-sign (imagpart z)))))))
(print :complex-sqrt-rounding)
