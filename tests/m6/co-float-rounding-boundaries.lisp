(defun assert-rounded (value prototype nearest positive negative zero)
  (let ((bits (if (typep prototype 'double-float) #'kiln.sys:double-float-bits #'kiln.sys:single-float-bits)))
    (assert (= nearest (funcall bits (kiln.sys:with-rounding-mode :nearest (float value prototype)))))
    (assert (= positive (funcall bits (kiln.sys:with-rounding-mode :positive (float value prototype)))))
    (assert (= negative (funcall bits (kiln.sys:with-rounding-mode :negative (float value prototype)))))
    (assert (= zero (funcall bits (kiln.sys:with-rounding-mode :zero (float value prototype)))))))
(assert-rounded (+ 1 (expt 2 -24)) 1f0 #x3f800000 #x3f800001 #x3f800000 #x3f800000)
(assert-rounded (- (+ 1 (expt 2 -24))) 1f0 #xbf800000 #xbf800000 #xbf800001 #xbf800000)
(assert-rounded (+ 1 (* 3 (expt 2 -24))) 1f0 #x3f800002 #x3f800002 #x3f800001 #x3f800001)
(assert-rounded (+ 1 (expt 2 -53)) 1d0 #x3ff0000000000000 #x3ff0000000000001 #x3ff0000000000000 #x3ff0000000000000)
(assert-rounded (- (+ 1 (expt 2 -53))) 1d0 #xbff0000000000000 #xbff0000000000000 #xbff0000000000001 #xbff0000000000000)
(assert-rounded (expt 2 -150) 1f0 0 1 0 0)
(assert-rounded (- (expt 2 -150)) 1f0 #x80000000 #x80000000 #x80000001 #x80000000)
(assert-rounded (* 3 (expt 2 -150)) 1f0 2 2 1 1)
(assert-rounded (expt 2 -1075) 1d0 0 1 0 0)
(assert-rounded (- (expt 2 -1075)) 1d0 #x8000000000000000 #x8000000000000000 #x8000000000000001 #x8000000000000000)
(assert-rounded (- (expt 2 -126) (expt 2 -150)) 1f0 #x800000 #x800000 #x7fffff #x7fffff)
(assert-rounded (- (expt 2 -1022) (expt 2 -1075)) 1d0 #x10000000000000 #x10000000000000 #xfffffffffffff #xfffffffffffff)
(kiln.sys:with-float-traps-masked (:overflow)
  (assert-rounded (expt 2 128) 1f0 #x7f800000 #x7f800000 #x7f7fffff #x7f7fffff)
  (assert-rounded (- (expt 2 128)) 1f0 #xff800000 #xff7fffff #xff800000 #xff7fffff)
  (assert-rounded (expt 2 1024) 1d0 #x7ff0000000000000 #x7ff0000000000000 #x7fefffffffffffff #x7fefffffffffffff))
(print :float-rounding-boundaries)
