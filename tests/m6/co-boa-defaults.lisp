(defstruct (boa-defaults (:constructor make-boa-defaults (required &optional bare explicit (override :argument) &key key ((:alias aliased)))))
 required bare (explicit :slot) (override :slot) key aliased)
(let ((record (make-boa-defaults 7)))
  (assert (= 7 (boa-defaults-required record)))
  (assert (null (boa-defaults-bare record)))
  (assert (eq :slot (boa-defaults-explicit record)))
  (assert (eq :argument (boa-defaults-override record)))
  (assert (null (boa-defaults-key record)))
  (assert (null (boa-defaults-aliased record))))
(let ((record (make-boa-defaults 7 :bare :explicit :override :key 11 :alias 12)))
  (assert (eq :bare (boa-defaults-bare record)))
  (assert (eq :explicit (boa-defaults-explicit record)))
  (assert (eq :override (boa-defaults-override record)))
  (assert (= 11 (boa-defaults-key record)))
  (assert (= 12 (boa-defaults-aliased record))))
(defstruct (boa-parent (:constructor nil)) (inherited :parent))
(defstruct (boa-child (:include boa-parent) (:constructor make-boa-child (&optional inherited bare))) bare)
(let ((record (make-boa-child)))
  (assert (eq :parent (boa-child-inherited record)))
  (assert (null (boa-child-bare record))))
(print :boa-defaults)
