(let* ((b (+ (ash 1 8192) 17)) (q (+ (ash 1 4096) 3))
       (a (+ (* b q) 7)))
  (dolist (sa '(1 -1))
    (dolist (sb '(1 -1))
      (multiple-value-bind (result remainder) (truncate (* sa a) (* sb b))
        (assert (= result (* sa sb q)))
        (assert (= remainder (* sa 7))))
      (dolist (function (list #'floor #'ceiling #'round #'truncate))
        (multiple-value-bind (result remainder) (funcall function (* sa a) (* sb b))
          (assert (= (+ (* result sb b) remainder) (* sa a)))
          (assert (< (abs remainder) b)))))))
(dolist (a '(5 7 -5 -7))
  (dolist (b '(2 -2))
    (assert (= (round (* a (ash 1 100)) (* b (ash 1 100))) (round a b)))))
(let ((base (ash 1 64)))
  (dolist (exponent '(64 127 128 191 192))
    (let ((power (ash 1 exponent)))
      (dolist (delta '(-1 0 1))
        (let ((value (- delta power)))
          (multiple-value-bind (q r) (floor value base)
            (assert (= q (+ (- (ash 1 (- exponent 64))) (if (minusp delta) -1 0))))
            (assert (= r (if (minusp delta) (1- base) delta)))))))))
(print :bignum-division-rounding)
