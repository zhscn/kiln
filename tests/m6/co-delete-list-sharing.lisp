(let* ((list (list 1 2 3)) (alias list) (tail (cddr list)))
  (assert (eq list (delete 2 list)))
  (assert (equal '(1 3) alias))
  (assert (eq tail (cdr alias))))
(let* ((list (list 2 1 2 3 2)) (alias list))
  (assert (equal '(2 1 3) (delete 2 list :from-end t :count 2)))
  (assert (equal '(2 1 3) alias)))
(let ((list (list 1 2 1 2 1)))
  (assert (equal '(1 2 2 1) (delete-if #'oddp list :start 1 :end 4 :count 1))))
(let ((calls 0) (list (list (cons 1 :a) (cons 2 :b) (cons 1 :c))))
  (assert (equal '((2 . :b))
                 (delete-if-not (lambda (value) (incf calls) (evenp value)) list :key #'car)))
  (assert (= 3 calls)))
(assert (null (delete 1 (list 1 1))))
(assert (equalp #(2 3) (delete 1 (vector 1 2 3))))
(print :destructive-list-deletion)
