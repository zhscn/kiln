(setq *print-pretty* nil)
(defun function-alias-named (value)
  (labels ((read-value (n) (list value n)))
    (let* ((first #'read-value) (second first))
      (list (funcall first 1) (funcall second 2)))))
(print (function-alias-named (copy-seq "named")))
(defun function-alias-anonymous (value)
  (let* ((first (lambda (n) (list value n))) (second first))
    (list (funcall first 3) (funcall second 4))))
(print (function-alias-anonymous (copy-seq "anonymous")))
(defun make-function-alias-caller (value)
  (let ((function (lambda () value)))
    (lambda () (funcall function))))
(let ((a (make-function-alias-caller (copy-seq "first")))
      (b (make-function-alias-caller (copy-seq "second"))))
  (kiln.sys:%gc)
  (print (list (funcall a) (funcall b))))
(defun make-escaping-function-alias (value)
  (let ((function (lambda (n) (list value n))))
    (list function (funcall function 5))))
(let* ((values (make-escaping-function-alias (copy-seq "escaped")))
       (function (first values)))
  (kiln.sys:%gc)
  (print (second values))
  (print (funcall function 6)))
(print (flet ((first-value () 1) (second-value () 2))
         (let ((function #'first-value))
           (list (funcall function)
                 (progn (setq function #'second-value) (funcall function))))))
(print (flet ((first-value () 3) (second-value () 4))
         (let ((function #'first-value))
           (let ((function #'second-value) (outer function))
             (list (funcall function) (funcall outer))))))
(defun make-function-alias-cell (value)
  (let* ((function (lambda (&optional new) (when new (setq value new)) value))
         (other function))
    (lambda (new) (funcall other new))))
(let ((function (make-function-alias-cell (copy-seq "old"))))
  (kiln.sys:%gc)
  (print (funcall function nil))
  (print (funcall function (copy-seq "new"))))
(defun function-alias-keywords (value)
  (let ((function (lambda (&key (x value)) (list value x))))
    (list (funcall function) (funcall function :x 9))))
(print (function-alias-keywords (copy-seq "key")))
(defun function-alias-checked (value)
  (flet ((read-value () value))
    (let ((function #'read-value))
      (handler-case
          (locally (declare (type symbol function)) (funcall function))
        (type-error () :type-error)))))
(print (function-alias-checked 7))
(defun function-alias-mixed-initializers (value)
  (let ((function (lambda () value))
        (before (progn (setq value (copy-seq "changed")) :before)))
    (list before (funcall function))))
(print (function-alias-mixed-initializers (copy-seq "original")))
(defvar *function-alias-load-time* nil)
(defun function-alias-load-time ()
  (let ((before (load-time-value (progn (push :before *function-alias-load-time*) 1)))
        (function (lambda () (load-time-value (progn (push :inside *function-alias-load-time*) 2))))
        (after (load-time-value (progn (push :after *function-alias-load-time*) 3))))
    (list before (funcall function) after)))
(print *function-alias-load-time*)
(print (function-alias-load-time))
(print *function-alias-load-time*)
(defun function-alias-unused-load-time ()
  (let ((function (lambda () (load-time-value (progn (push :unused *function-alias-load-time*) 4)))))
    (declare (ignore function))
    5))
(print *function-alias-load-time*)
(print (function-alias-unused-load-time))
(print *function-alias-load-time*)
(print (load-time-value (let ((function (lambda (x) (+ x 10)))) (funcall function 7))))
(defun function-alias-global () 10)
(let ((function (symbol-function 'function-alias-global)))
  (setf (symbol-function 'function-alias-global) (lambda () 20))
  (print (list (funcall function) (function-alias-global))))
