(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun records-aot-helper (x) (+ x 3)))
(defmacro records-aot-macro (x) (records-aot-helper x))
(defun records-aot-user () (records-aot-macro 4))
(print (records-aot-user))
(print (not (null (member '(defun records-aot-helper)
                         (kiln.sys:who-calls '+) :test #'equal))))
(print (let ((record (first (kiln.sys:find-definitions 'records-aot-user))))
         (and record (stringp (getf record :file)) (consp (getf record :source)))))
(eval '(defun records-aot-helper (x) (+ x 5)))
(print (records-aot-user))
(let ((file "build/test/co-definition-records-source.lisp"))
  (unwind-protect
       (progn
         (with-open-file (stream file :direction :output :if-exists :supersede)
           (write-string "(defun records-incremental () 10)
(defun records-changing () 20)
(defun records-removed () 0)" stream))
         (load file)
         (let ((saved (fdefinition 'records-incremental)))
           (with-open-file (stream file :direction :output :if-exists :supersede)
             (write-string "; changed source offsets
(defun records-incremental () 10)
(defun records-changing () 30)" stream))
           (multiple-value-bind (changed unchanged) (kiln.sys:reload-source-file file)
             (print (equal changed '((defun records-changing))))
             (print (equal unchanged '((defun records-incremental)))))
           (print (eq saved (fdefinition 'records-incremental)))
           (print (funcall 'records-changing))
           (print (not (fboundp 'records-removed)))
           (print (= 2 (length (kiln.sys:definitions-in-file file))))))
    (delete-file file)))

(eval '(defun records-leaf () 41))
(eval '(defun records-middle () (funcall #'records-leaf)))
(eval '(defmacro records-chain () (records-middle)))
(eval '(defun records-chain-user () (records-chain)))
