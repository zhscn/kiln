(dolist (marker '(#\f #\d))
  (dolist (sign '("" "-"))
    (dolist (exponent '(-100000000 -71174558))
      (let* ((text (format nil "~A1~A~D" sign marker exponent))
             (value (read-from-string text)))
        (assert (zerop value))
        (assert (eq (minusp (float-sign value)) (string= sign "-")))))
    (let ((value (read-from-string (format nil "~A0~A100000000" sign marker))))
      (assert (zerop value))
      (assert (eq (minusp (float-sign value)) (string= sign "-"))))))
(assert (= least-positive-double-float (read-from-string "5d-324")))
(assert (zerop (read-from-string "1d-325")))
(assert (= least-positive-single-float (read-from-string "1.4f-45")))
(assert (= most-positive-double-float (read-from-string "1.7976931348623157d308")))
(flet ((convert (thunk)
         (handler-case (funcall thunk)
           (floating-point-overflow () :overflow))))
  (assert (eql (convert (lambda () (read-from-string "1d100000000")))
               (convert (lambda () (coerce (* 2 (rational most-positive-double-float))
                                          'double-float))))))
(print :bounded-float-reader)
