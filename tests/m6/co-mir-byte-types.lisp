(defun unsigned-byte-member (value) (typep value 'unsigned-byte))
(defun signed-byte-member (value) (typep value 'signed-byte))
(defun require-unsigned-byte (value) (the unsigned-byte value))
(defun require-signed-byte (value) (the signed-byte value))
(dolist (value (list 0 1 most-positive-fixnum (ash 1 100)))
  (print (not (null (unsigned-byte-member value))))
  (print (= value (require-unsigned-byte value))))
(dolist (value (list -1 most-negative-fixnum (- (ash 1 100))))
  (print (not (unsigned-byte-member value)))
  (print (handler-case (require-unsigned-byte value) (type-error () t)))
  (print (not (null (signed-byte-member value))))
  (print (= value (require-signed-byte value))))
(dolist (value '(nil "bad" #\a 1/2 1d0))
  (print (not (unsigned-byte-member value)))
  (print (not (signed-byte-member value)))
  (print (handler-case (require-unsigned-byte value) (type-error () t)))
  (print (handler-case (require-signed-byte value) (type-error () t))))
