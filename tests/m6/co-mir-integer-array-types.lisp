(defun increment-octet (array index)
  (declare ((simple-array (unsigned-byte 8) (*)) array)
           (optimize (speed 3) (safety 3)))
  (setf (aref array index) (logand (1+ (aref array index)) 255)))

(defun store-octet (array index value)
  (declare ((simple-array (unsigned-byte 8) (*)) array)
           (optimize (speed 3) (safety 3)))
  (setf (aref array index) value))

(defun make-fixnum-vector (size value)
  (declare (integer size) (fixnum value) (optimize (speed 3) (safety 3)))
  (let ((array (make-array size :element-type 'fixnum)))
    (setf (aref array 0) value)
    (kiln.sys:%gc)
    (1+ (aref array 0))))

(let ((array (make-array 2 :element-type '(unsigned-byte 8) :initial-contents '(255 3))))
  (print (and (= (increment-octet array 0) 0)
              (= (increment-octet array 1) 4)
              (= (aref array 1) 4)))
  (print (and (handler-case (progn (store-octet array 0 256) nil) (type-error () t))
              (every (lambda (index)
                       (handler-case (progn (increment-octet array index) nil)
                         (type-error () t)))
                     (list -1 2 :invalid (ash 1 80)))
              (= (aref array 0) 0))))
(print (and (= (make-fixnum-vector 2 -42) -41)
            (handler-case (progn (make-fixnum-vector 0 1) nil)
              (type-error () t))))

(defun return-values-after-array-access (size)
  (declare (fixnum size) (optimize (speed 3) (safety 3)))
  (multiple-value-prog1 (values :primary :secondary)
    (let ((array (make-array size :element-type 'fixnum)))
      (setf (aref array 0) 7)
      (kiln.sys:%gc)
      (assert (= (aref array 0) 7)))))

(print (equal (multiple-value-list (return-values-after-array-access 2))
              '(:primary :secondary)))

(defun store-upgraded-unsigned-vector (size value)
  (declare (fixnum size value) (optimize (speed 3) (safety 3)))
  (let ((array (make-array size :element-type '(integer 0 1000))))
    (setf (aref array 0) (mod value 1000))
    (kiln.sys:%gc)
    (assert (= (aref array 0) (mod value 1000)))
    array))

(let ((array (store-upgraded-unsigned-vector 1 -1)))
  (assert (equal (array-element-type array) (upgraded-array-element-type '(integer 0 1000))))
  (assert (= (aref array 0) 999)))
(assert (handler-case (progn (store-upgraded-unsigned-vector 0 0) nil)
          (type-error () t)))
(let ((array (make-array 64 :element-type '(integer 0 1))))
  (setf (aref array 63) 1)
  (assert (and (eq (array-element-type array) 'bit)
               (= (aref array 62) 0) (= (aref array 63) 1))))

(defun reverse-fixnum-prefix (array last)
  (declare ((simple-array fixnum (*)) array) (fixnum last)
           (optimize (speed 3) (space 1) (safety 3) (debug 0)))
  (loop for i from 0 to (ash last -1)
        do (let ((first (aref array i))
                 (k (- last i)))
             (setf (aref array i) (aref array k)
                   (aref array k) first)))
  array)

(loop for (last expected) in '((-1 (1 2 3 4)) (0 (1 2 3 4))
                             (1 (2 1 3 4)) (2 (3 2 1 4)) (3 (4 3 2 1)))
      do (let ((array (make-array 4 :element-type 'fixnum :initial-contents '(1 2 3 4))))
           (assert (eq array (reverse-fixnum-prefix array last)))
           (assert (equal (coerce array 'list) expected))))
(let ((array (make-array 2 :element-type 'fixnum :initial-contents '(1 2))))
  (assert (handler-case (progn (reverse-fixnum-prefix array 2) nil)
            (type-error () t)))
  (assert (equal (coerce array 'list) '(1 2))))

(defun checked-fixnum-with-live-object (index object)
  (declare (fixnum index) (optimize (speed 3) (safety 3) (debug 0)))
  (kiln.sys:%gc)
  (values index object))

(let ((object (list :live)))
  (dolist (index (list most-negative-fixnum 0 most-positive-fixnum))
    (multiple-value-bind (value returned) (checked-fixnum-with-live-object index object)
      (assert (and (eql value index) (eq returned object) (equal returned '(:live))))))
  (assert (handler-case (progn (checked-fixnum-with-live-object object nil) nil)
            (type-error (condition) (eq (type-error-datum condition) object)))))
