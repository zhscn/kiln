(defun make-compact-cells (prefix suffix)
  (let ((value 1))
    (labels ((zero () 0) (one () 1)
             (read-value ()
               (declare (notinline zero one))
               (list prefix (zero) value (one) suffix))
             (write-value (new) (setq value new)))
      (list #'read-value #'write-value))))
(let ((functions (make-compact-cells (copy-seq "prefix") (copy-seq "suffix"))))
  (kiln.sys:%gc)
  (print (funcall (first functions)))
  (funcall (second functions) (copy-seq "updated"))
  (kiln.sys:%gc)
  (print (funcall (first functions))))
(defun make-compact-default (value)
  (labels ((helper (n) (if (zerop n) 3 (helper (1- n))))
           (read-value (&optional (argument (cons (helper 0) value)))
             (declare (notinline helper))
             argument))
    #'read-value))
(let ((function (make-compact-default (copy-seq "captured"))))
  (kiln.sys:%gc)
  (print (funcall function))
  (print (funcall function 9)))
(print (block done
         (labels ((helper () 5)
                  (leave () (declare (notinline helper)) (helper) (return-from done 17)))
           (declare (notinline leave))
           (leave)
           0)))
(defun make-compact-function-chain (value)
  (labels ((read-static () 0) (read-dynamic () value)
           (read-all ()
             (declare (notinline read-static read-dynamic))
             (list (read-static) (read-dynamic))))
    #'read-all))
(let ((function (make-compact-function-chain (copy-seq "nested"))))
  (kiln.sys:%gc)
  (print (funcall function)))
(defun make-function-value-reader (function)
  (lambda () (funcall function)))
(let ((first (make-function-value-reader (lambda () 11)))
      (second (make-function-value-reader (lambda () 22))))
  (kiln.sys:%gc)
  (print (funcall first))
  (print (funcall second)))
