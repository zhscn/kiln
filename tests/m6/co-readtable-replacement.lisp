(defun readtable-seventeen (stream char number)
  (declare (ignore stream char number)) 17)
(defun readtable-nineteen (stream char number)
  (declare (ignore stream char number)) 19)
(defun readtable-ordinary (stream char)
  (declare (ignore stream char)) :ordinary)

(let ((source (copy-readtable nil)) (target (copy-readtable nil)))
  (make-dispatch-macro-character #\! t source)
  (set-dispatch-macro-character #\! #\a #'readtable-seventeen source)
  (set-syntax-from-char #\? #\! target source)
  (assert (nth-value 1 (get-macro-character #\? target)))
  (let ((*readtable* target)) (assert (= (read-from-string "?a") 17)))
  (set-dispatch-macro-character #\! #\a #'readtable-nineteen source)
  (let ((*readtable* target)) (assert (= (read-from-string "?a") 17)))
  (set-syntax-from-char #\? #\A target)
  (assert (null (get-macro-character #\? target)))
  #+kiln
  (assert (handler-case (progn (get-dispatch-macro-character #\? #\a target) nil)
            (error () t)))
  (make-dispatch-macro-character #\? nil target)
  (set-dispatch-macro-character #\? #\a #'readtable-seventeen target)
  (set-macro-character #\? #'readtable-ordinary nil target)
  (let ((*readtable* target)) (assert (eq (read-from-string "?") :ordinary)))
  #+kiln
  (assert (handler-case (progn (get-dispatch-macro-character #\? #\a target) nil)
            (error () t)))
  (make-dispatch-macro-character #\% nil target)
  (set-dispatch-macro-character #\% #\a #'readtable-seventeen target)
  (copy-readtable source target)
  #+kiln
  (assert (handler-case (progn (get-dispatch-macro-character #\% #\a target) nil)
            (error () t)))
  (assert (null (get-macro-character #\? target)))
  (assert (eq (copy-readtable target target) target))
  (let ((*readtable* target)) (assert (= (read-from-string "!a") 19))))
(print :readtable-replacement)
