(defun return-values-source (n)
  (case n (0 (values)) (1 (values :one)) (otherwise (values :one :two :three))))
(defun return-values-join (flag n)
  (if flag (return-values-source n) (values :other)))
(defun return-values-nested (flag n)
  (if flag (if (zerop n) (return-values-source 0) (return-values-source n))
      (values :other :tail)))
(defun return-values-preserved (n)
  (multiple-value-prog1 (return-values-source n)
    (return-values-source 1) (kiln.sys:%gc)))
(defun return-values-loop (n)
  (let ((i n))
    (tagbody again (if (plusp i) (progn (decf i) (go again))))
    (return-values-source n)))
(defun return-values-checked (n)
  (the (values symbol symbol &optional symbol) (return-values-source n)))
(dolist (n '(0 1 3))
  (let ((expected (multiple-value-list (return-values-source n))))
    (print (equal expected (multiple-value-list (return-values-join t n))))
    (print (equal expected (multiple-value-list (return-values-nested t n))))
    (print (equal expected (multiple-value-list (return-values-preserved n))))
    (print (equal expected (multiple-value-list (return-values-loop n))))))
(print (equal '(:other) (multiple-value-list (return-values-join nil 3))))
(print (equal '(:other :tail) (multiple-value-list (return-values-nested nil 3))))
(print (equal '(:one :two :three) (multiple-value-list (return-values-checked 3))))
(print (equal '(t) (multiple-value-list (typep 7 'integer))))
