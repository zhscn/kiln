(defmacro compile-during-expansion ()
  (funcall (compile nil '(lambda () '(quote :nested)))))
(let ((kiln.compiler::*available-image-sessions* nil))
  (print (funcall (compile nil '(lambda () :first))))
  (let ((session (first kiln.compiler::*available-image-sessions*)))
    (print (funcall (compile nil '(lambda () :second))))
    (print (eq session (first kiln.compiler::*available-image-sessions*))))
  (handler-case (compile nil '(lambda (&optional &optional) nil)) (error () nil))
  (print (= 1 (length kiln.compiler::*available-image-sessions*)))
  (print (funcall (compile nil '(lambda () (compile-during-expansion)))))
  (print (= 2 (length kiln.compiler::*available-image-sessions*))))
