(defmacro exercise-cons-borrow ()
  (let ((pair (gensym "PAIR")) (item (gensym "ITEM")) (read (gensym "READ")))
    `(flet ((,read (,item)
              (kiln.sys:%gc)
              (rplaca ,item (vector 31 32))
              (car ,item)))
       (declare (notinline ,read))
       (let ((,pair (cons (vector 17 18) (cons 23 24))))
         (declare (dynamic-extent ,pair))
         (print (svref (,read ,pair) 1))
         (kiln.sys:%gc)
         (print (cdr (cdr ,pair)))
         (print (eq ,pair ,pair))))))
(exercise-cons-borrow)

(defmacro exercise-recursive-cons-borrow ()
  (let ((pair (gensym "PAIR")) (item (gensym "ITEM"))
        (left (gensym "LEFT")) (right (gensym "RIGHT")))
    `(labels ((,left (,item n)
                (kiln.sys:%gc)
                (if (zerop n) (car ,item) (,right ,item (1- n))))
              (,right (,item n)
                (kiln.sys:%gc)
                (if (zerop n) (cdr ,item) (,left ,item (1- n)))))
       (declare (notinline ,left ,right))
       (let ((,pair (cons (vector 41) (vector 53))))
         (declare (dynamic-extent ,pair))
         (print (svref (,left ,pair 4) 0))
         (print (svref (,left ,pair 3) 0))))))
(exercise-recursive-cons-borrow)

(defvar *borrow-escaped* nil)
(defmacro exercise-rejected-cons-borrow ()
  (let ((pair (gensym "PAIR")) (item (gensym "ITEM"))
        (left (gensym "LEFT")) (right (gensym "RIGHT")))
    `(labels ((,left (,item n)
                (if (zerop n) (car ,item) (,right ,item (1- n))))
              (,right (,item n)
                (if (zerop n) (progn (setq *borrow-escaped* ,item) (car ,item))
                    (,left ,item (1- n)))))
       (declare (notinline ,left ,right))
       (let ((,pair (cons 61 62)))
         (declare (dynamic-extent ,pair))
         (,left ,pair 3)))))
(exercise-rejected-cons-borrow)
(kiln.sys:%gc)
(print *borrow-escaped*)

(defun record-borrow-frame ()
  (kiln.sys:%gc)
  (let* ((frame (find-if (lambda (frame)
                           (let ((name (kiln.sys:frame-name frame)))
                             (and (consp name) (eq (first name) 'flet)
                                  (eq (second name) 'borrow-visible))))
                         (kiln.sys:frame-list)))
         (pair (cdr (assoc 'item (kiln.sys:frame-variables frame)))))
    (setq *borrow-escaped* pair)
    (rplacd pair 79)))
(defmacro invoke-cons-borrower (function)
  (let ((pair (gensym "PAIR")))
    `(let ((,pair (cons 71 72)))
       (declare (dynamic-extent ,pair))
       (,function ,pair))))
(flet ((borrow-visible (item) (record-borrow-frame) (cdr item)))
  (declare (notinline borrow-visible))
  (print (invoke-cons-borrower borrow-visible)))
(kiln.sys:%gc)
(print *borrow-escaped*)
