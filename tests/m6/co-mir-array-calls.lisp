(dolist (pipeline '(:mir))
  (let* ((kiln.compiler::*compiler-pipeline* pipeline)
         (reader (compile nil '(lambda (array index)
                                 (declare (optimize (speed 3) (safety 3))) (aref array index))))
         (writer (compile nil '(lambda (value array index)
                                 (declare (optimize (speed 3) (safety 3))) (setf (aref array index) value))))
         (ordinary (compile nil '(lambda (array index)
                                   (declare (optimize (speed 3) (safety 3)) (notinline aref))
                                   (aref array index))))
         (vector (vector 1 2)))
    (print (= (funcall reader vector 1) 2))
    (print (and (null (funcall writer nil vector 0)) (null (funcall reader vector 0))))
    (print (= (funcall ordinary vector 1) 2))
    (let ((string (make-array 3 :element-type 'character :initial-element #\x :fill-pointer 0)))
      (print (and (char= (funcall reader string 2) #\x)
                  (char= (funcall writer #\z string 1) #\z)
                  (char= (funcall reader string 1) #\z) (zerop (length string)))))
    (let* ((backing (make-array 4 :element-type 'bit :initial-element 1))
           (bits (make-array 2 :element-type 'bit :displaced-to backing :displaced-index-offset 1)))
      (print (and (= (funcall reader bits 0) 1) (= (funcall writer 0 bits 1) 0)
                  (= (funcall reader bits 1) 0) (= (aref backing 2) 0))))
    (let ((floats (make-array 2 :element-type 'double-float :initial-element 1d0)))
      (print (and (= (funcall reader floats 0) 1d0) (= (funcall writer 2d0 floats 1) 2d0)
                  (= (funcall reader floats 1) 2d0))))
    (print (every (lambda (index)
                    (handler-case (progn (funcall reader vector index) nil) (type-error () t)))
                  '(-1 2 :bad)))
    (print (every (lambda (index)
                    (handler-case (progn (funcall writer 7 vector index) nil) (type-error () t)))
                  '(-1 2 :bad)))
    (print (handler-case (progn (funcall reader (make-array '(2 2)) 0) nil) (error () t)))
    (print (handler-case (progn (funcall writer #\x (make-array nil) 0) nil) (error () t)))))
