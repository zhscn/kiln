(defmacro exercise-stack-closure ()
  (let ((f (gensym "CLOSURE")) (alias (gensym "ALIAS")))
    `(let ((payload (vector 17 23)))
       (let ((,f (lambda () (kiln.sys:%gc) (svref payload 1))))
         (let ((,alias (if (consp payload) nil ,f)))
           (kiln.sys:%gc)
           (print (eq ,f ,alias))
           (print (funcall ,alias))
           (print (funcall ,f)))))))
(exercise-stack-closure)

(defun escaped-closure (value)
  (let ((f (lambda () value)))
    (declare (dynamic-extent f))
    f))
(let ((f (escaped-closure (vector 31))))
  (kiln.sys:%gc)
  (print (svref (funcall f) 0)))

(defun escaped-closure-caller (value)
  (let ((f (lambda () value)))
    (print (eq f f))
    (lambda () (funcall f))))
(let ((caller (escaped-closure-caller (vector 59))))
  (kiln.sys:%gc)
  (print (svref (funcall caller) 0)))
