(defmacro exercise-graph-call ()
  (let ((inner (gensym "INNER")) (outer (gensym "OUTER"))
        (item (gensym "ITEM")) (left (gensym "LEFT")) (right (gensym "RIGHT"))
        (read (gensym "READ")) (link (gensym "LINK")) (alias (gensym "ALIAS")))
    `(flet ((,read (,item) (kiln.sys:%gc) (car ,item))
            (,link (,left ,right) (kiln.sys:%gc) (rplacd ,left ,right) nil))
       (declare (notinline ,read ,link))
       (let ((,inner (cons (vector 17 18) nil)))
         (let ((,outer (cons ,inner nil)))
           (eq ,outer ,outer)
           (let ((,alias (,read ,outer)))
             (print (eq ,alias ,inner))
             (,link ,alias ,outer)
             (kiln.sys:%gc)
             (print (eq (cdr (car ,outer)) ,outer))
             (print (svref (car ,alias) 1))))))))
(exercise-graph-call)

(defmacro exercise-recursive-graph-call ()
  (let ((inner (gensym "INNER")) (outer (gensym "OUTER")) (item (gensym "ITEM"))
        (left (gensym "LEFT")) (right (gensym "RIGHT")) (alias (gensym "ALIAS")))
    `(labels ((,left (,item count)
                (kiln.sys:%gc)
                (if (zerop count) (car ,item) (,right ,item (1- count))))
              (,right (,item count)
                (kiln.sys:%gc)
                (if (zerop count) (car ,item) (,left ,item (1- count)))))
       (declare (notinline ,left ,right))
       (let ((,inner (cons (vector 31) nil)))
         (let ((,outer (cons ,inner nil)))
           (eq ,outer ,outer)
           (let ((,alias (,left ,outer 5)))
             (kiln.sys:%gc)
             (print (eq ,alias ,inner))
             (print (svref (car ,alias) 0))))))))
(exercise-recursive-graph-call)

(defvar *graph-call-saved* nil)
(defmacro retain-graph-call-child ()
  (let ((inner (gensym "INNER")) (outer (gensym "OUTER"))
        (item (gensym "ITEM")) (save (gensym "SAVE")))
    `(flet ((,save (,item) (setq *graph-call-saved* (car ,item)) nil))
       (declare (notinline ,save))
       (let ((,inner (cons 41 42)))
         (let ((,outer (cons ,inner nil)))
           (eq ,outer ,outer) (,save ,outer))))))
(defun retain-called-child () (retain-graph-call-child))
(retain-called-child)
(kiln.sys:%gc)
(print *graph-call-saved*)

(defmacro wrap-graph-call ()
  (let ((inner (gensym "INNER")) (outer (gensym "OUTER"))
        (item (gensym "ITEM")) (wrap (gensym "WRAP")))
    `(flet ((,wrap (,item) (cons ,item nil)))
       (declare (notinline ,wrap))
       (let ((,inner (cons 51 52)))
         (let ((,outer (cons ,inner nil))) (,wrap ,outer))))))
(defun wrapped-called-graph () (wrap-graph-call))
(let ((wrapped (wrapped-called-graph))) (kiln.sys:%gc) (print wrapped))
