(dolist (x '(1d-20 -1d-20 1f-12 -1f-12))
  (assert (= (atanh x) x)))
(assert (= (float-sign (atanh -0d0)) -1d0))
(let ((result (atanh -2d0)))
  (assert (< (abs (- (realpart result) -0.5493061443340549d0)) 2d-16))
  (assert (= (imagpart result) (/ pi 2d0))))
(dolist (function (list #'atan #'atanh))
  (let ((z #c(1d-20 -1d-20)))
    (assert (= (funcall function z) z))))
(dolist (sign '(1d0 -1d0))
  (dolist (x '(2d0 -2d0))
    (let ((result (atanh (complex x (* sign 0d0)))))
      (assert (< (abs (- (realpart result) (* (signum x) 0.5493061443340549d0))) 2d-16))
      (assert (= (imagpart result) (* sign (/ pi 2d0)))))))
;; Re(atanh(1+iy)) = log((4+y*y)/(y*y))/4. Keep the
;; logarithms separate so the tiny squared denominator need not be represented.
(let ((result (atanh #c(1d0 1d-300))))
  (assert (< (abs (- (realpart result) 345.7343375393868d0)) 1d-13))
  (assert (= (imagpart result) (/ pi 4d0))))
(let ((result (atanh #c(1d300 1d300))))
  (assert (< (abs (- (/ (realpart result) 1d-300) 0.5d0)) 2d-16))
  (assert (= (imagpart result) (/ pi 2d0))))
(assert (typep (atan #c(1f0 2f0)) '(complex single-float)))
(print :inverse-tangent-stability)
