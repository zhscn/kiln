(defun close-complex-quotient (a b reference)
  (let ((result (/ a b)))
    (assert (< (abs (- result reference)) (* 5d-15 (max 1d-310 (abs reference)))))))
(close-complex-quotient 1 #c(0d0 1d300) #c(0d0 -1d-300))
(close-complex-quotient 1 #c(0d0 1d-300) #c(0d0 -1d300))
(close-complex-quotient #c(1d300 1d300) #c(1d300 1d300) #c(1d0 0d0))
(close-complex-quotient #c(1d-300 1d-300) #c(1d-300 1d-300) #c(1d0 0d0))
(assert (= (/ #c(3 4) #c(1 2)) #c(11/5 -2/5)))
(let ((result (/ #c(1d0 2d0) #c(3f0 4f0))))
  (assert (typep result '(complex double-float)))
  (assert (< (abs (- result #c(0.44d0 0.08d0))) 1d-16)))
(print :complex-division-scale)
