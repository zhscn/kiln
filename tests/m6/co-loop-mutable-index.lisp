(assert (equal '(0 2 4) (loop for i below 6 collect i do (incf i))))
(assert (equal '(6 4 2) (loop for i downfrom 6 above 0 collect i do (decf i))))
(assert (equal '(1 4 7) (loop for i from 1 below 10 by 2 collect i do (incf i))))
(assert (equal '((0 0) (2 1) (4 3))
               (loop for i below 6 and old = 0 then i
                     collect (list i old) do (incf i))))
(assert (= 6 (loop for i below 6 do (incf i) finally (return i))))
(let ((source #(65 195 169 66)) (output nil))
  (loop for i below (length source)
        do (push (if (= (aref source i) 195)
                     (progn (incf i) 233)
                     (aref source i)) output))
  (assert (equal '(65 233 66) (nreverse output))))
(print :loop-mutable-index)
