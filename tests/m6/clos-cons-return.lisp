(defmacro exercise-returned-cons ()
  (let ((pair (gensym "PAIR")) (alias (gensym "ALIAS"))
        (item (gensym "ITEM")) (same (gensym "SAME")))
    `(flet ((,same (,item)
              (unwind-protect
                   (multiple-value-prog1 (values ,item) (kiln.sys:%gc))
                (kiln.sys:%gc))))
       (declare (notinline ,same))
       (let ((,pair (cons (vector 17 18) nil)))
         (declare (dynamic-extent ,pair))
         (let ((,alias (,same ,pair)))
           (kiln.sys:%gc)
           (print (eq ,alias ,pair))
           (print (svref (car ,alias) 1))
           (rplacd ,alias (list 23 24))
           (kiln.sys:%gc)
           (print (cdr ,pair)))))))
(exercise-returned-cons)

(defmacro exercise-recursive-cons-return ()
  (let ((pair (gensym "PAIR")) (alias (gensym "ALIAS")) (item (gensym "ITEM"))
        (left (gensym "LEFT")) (right (gensym "RIGHT")))
    `(labels ((,left (,item n)
                (kiln.sys:%gc)
                (if (zerop n) ,item (,right ,item (1- n))))
              (,right (,item n)
                (kiln.sys:%gc)
                (if (zerop n) (values ,item) (,left ,item (1- n)))))
       (declare (notinline ,left ,right))
       (let ((,pair (cons (vector 31) nil)))
         (declare (dynamic-extent ,pair))
         (let ((,alias (multiple-value-prog1 (,left ,pair 5) (kiln.sys:%gc))))
           (print (eq ,pair ,alias))
           (print (svref (car ,alias) 0)))))))
(exercise-recursive-cons-return)

(defmacro return-cons-from-holder (&optional multiple secondary)
  (let ((pair (gensym "PAIR")) (item (gensym "ITEM")) (same (gensym "SAME")))
    `(flet ((,same (,item)
              ,(cond (secondary `(values 9 ,item))
                     (multiple `(values ,item 9))
                     (t item))))
       (declare (notinline ,same))
       (let ((,pair (cons 41 42)))
         (declare (dynamic-extent ,pair))
         ,(if multiple `(multiple-value-list (,same ,pair)) `(,same ,pair))))))
(defun escaped-cons-return () (return-cons-from-holder))
(defun escaped-cons-values () (return-cons-from-holder t))
(defun escaped-cons-secondary () (return-cons-from-holder t t))
(let ((value (escaped-cons-return))) (kiln.sys:%gc) (print value))
(let ((value (escaped-cons-values))) (kiln.sys:%gc) (print value))
(let ((value (escaped-cons-secondary))) (kiln.sys:%gc) (print value))

(defvar *returned-cons* nil)
(defmacro store-returned-cons ()
  (let ((pair (gensym "PAIR")) (item (gensym "ITEM")) (same (gensym "SAME")))
    `(flet ((,same (,item) ,item))
       (declare (notinline ,same))
       (let ((,pair (cons 51 52)))
         (declare (dynamic-extent ,pair))
         (setq *returned-cons* (,same ,pair))))))
(defun save-cons-return () (store-returned-cons) nil)
(save-cons-return)
(kiln.sys:%gc)
(print *returned-cons*)

(defmacro with-returned-cons ((alias) &body body)
  (let ((pair (gensym "PAIR")) (item (gensym "ITEM")) (same (gensym "SAME")))
    `(flet ((,same (,item) ,item))
       (declare (notinline ,same))
       (let ((,pair (cons 81 82)))
         (declare (dynamic-extent ,pair))
         (let ((,alias (,same ,pair))) ,@body)))))
(defun inspect-cons-return ()
  (kiln.sys:%gc)
  (let* ((frame (find 'visible-cons-return (kiln.sys:frame-list) :key #'kiln.sys:frame-name))
         (value (cdr (assoc 'alias (kiln.sys:frame-variables frame)))))
    (setq *returned-cons* value)
    (rplaca value 91)))
(defun visible-cons-return ()
  (with-returned-cons (alias) (inspect-cons-return) (car alias)))
(print (visible-cons-return))
(kiln.sys:%gc)
(print *returned-cons*)
