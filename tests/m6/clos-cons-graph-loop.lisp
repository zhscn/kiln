(defmacro exercise-graph-helper-loop ()
  (let ((inner (gensym "INNER")) (outer (gensym "OUTER")) (item (gensym "ITEM"))
        (read (gensym "READ")) (left (gensym "LEFT")) (right (gensym "RIGHT"))
        (link (gensym "LINK")) (alias (gensym "ALIAS")))
    `(flet ((,read (,item count)
              (tagbody again
                 (kiln.sys:%gc)
                 (if (zerop count) (go done))
                 (setq count (1- count)) (go again)
               done)
              (car ,item))
            (,link (,left ,right count)
              (tagbody again
                 (rplacd ,left ,right)
                 (kiln.sys:%gc)
                 (if (zerop count) (go done))
                 (setq count (1- count)) (go again)
               done)
              nil))
       (declare (notinline ,read ,link))
       (let ((,inner (cons (vector 17 18) nil)))
         (let ((,outer (cons ,inner nil)))
           (eq ,outer ,outer)
           (let ((,alias (,read ,outer 4)))
             (print (eq ,alias ,inner))
             (,link ,alias ,outer 3)
             (print (eq (cdr (car ,outer)) ,outer))
             (print (svref (car ,alias) 1))))))))
(exercise-graph-helper-loop)

(defvar *loop-graph-saved* nil)
(defmacro retain-loop-graph-child ()
  (let ((inner (gensym "INNER")) (outer (gensym "OUTER"))
        (item (gensym "ITEM")) (save (gensym "SAVE")))
    `(flet ((,save (,item count)
              (tagbody again
                 (if (zerop count) (go save))
                 (setq count (1- count)) (go again)
               save
                 (setq *loop-graph-saved* (car ,item)))
              nil))
       (declare (notinline ,save))
       (let ((,inner (cons 31 32)))
         (let ((,outer (cons ,inner nil)))
           (eq ,outer ,outer) (,save ,outer 4))))))
(defun retain-loop-child () (retain-loop-graph-child))
(retain-loop-child)
(kiln.sys:%gc)
(print *loop-graph-saved*)
