(defun checked-vector-read (vector index)
  (declare (simple-vector vector) (fixnum index))
  (svref vector index))
(defun nonnegative-vector-read (vector index)
  (declare (simple-vector vector) (type (unsigned-byte 8) index))
  (svref vector index))
(defun nonnegative-vector-write (vector index value)
  (declare (simple-vector vector) (type (unsigned-byte 8) index))
  (setf (svref vector index) value))
(let ((vector (vector :a :b)))
  (print (eq (checked-vector-read vector 1) :b))
  (print (handler-case (checked-vector-read vector -1) (error () t)))
  (print (eq (nonnegative-vector-read vector 0) :a))
  (print (handler-case (nonnegative-vector-read vector 2) (error () t)))
  (print (eq (nonnegative-vector-write vector 1 :c) :c))
  (print (eq (svref vector 1) :c))
  (let ((evaluated nil))
    (print (handler-case
               (nonnegative-vector-write vector 2 (progn (setq evaluated t) :bad))
             (error () evaluated))))
)

(defun find-fixnum-in-simple-vector (item array)
  (declare (fixnum item) (simple-vector array) (optimize (speed 3) (space 1)))
  (find item array))

(defun position-fixnum-in-simple-vector (item array)
  (declare (fixnum item) (simple-vector array) (optimize (speed 3) (space 1)))
  (position item array :test #'eql))

(let ((array (vector -3d0 "other" -3 -3)))
  (assert (eql -3 (find-fixnum-in-simple-vector -3 array)))
  (assert (eql 2 (position-fixnum-in-simple-vector -3 array)))
  (assert (null (find-fixnum-in-simple-vector 4 array)))
  (assert (null (position-fixnum-in-simple-vector 4 #()))))

(dotimes (length 10)
  (let ((array (make-array length :initial-element 0)))
    (assert (null (position-fixnum-in-simple-vector 1 array)))
    (dotimes (i length)
      (setf (aref array i) 1)
      (when (< (1+ i) length)
        (setf (aref array (1+ i)) 1))
      (assert (eql i (position-fixnum-in-simple-vector 1 array)))
      (assert (eql 1 (find-fixnum-in-simple-vector 1 array)))
      (setf (aref array i) 0))))

(defun find-eql-in-simple-vector (item array)
  (declare (simple-vector array) (optimize (speed 3) (space 1)))
  (find item array))

(let* ((item (kiln.sys:bits-double-float #x4008000000000000))
       (element (kiln.sys:bits-double-float #x4008000000000000))
       (array (vector 3 element)))
  (assert (eq element (find-eql-in-simple-vector item array))))

(defun position-from-end (item array)
  (declare (fixnum item) (simple-vector array) (optimize (speed 3) (space 1)))
  (position item array :key nil :from-end t :start 0 :end nil :test #'eql))

(defun find-eql-from-end (item array)
  (declare (simple-vector array) (optimize (speed 3) (space 1)))
  (find item array :from-end t))

(dotimes (length 11)
  (let ((array (make-array length :initial-element 0)))
    (assert (null (position-from-end 1 array)))
    (dotimes (i length)
      (setf (aref array i) 1)
      (assert (eql i (position-from-end 1 array))))))

(let* ((item (kiln.sys:bits-double-float #x4008000000000000))
       (left (kiln.sys:bits-double-float #x4008000000000000))
       (right (kiln.sys:bits-double-float #x4008000000000000)))
  (assert (eq right (find-eql-from-end item (vector left right)))))

(defun search-operand-order (array)
  (declare (simple-vector array) (optimize (speed 3) (space 1)))
  (let ((events nil))
    (let ((result (position (progn (push :item events) 1)
                            (progn (push :vector events) array)
                            :from-end (progn (push :direction events) t)
                            :test (progn (push :test events) #'eq))))
      (values result (reverse events)))))

(multiple-value-bind (index events) (search-operand-order #(1 0 1))
  (assert (= index 2))
  (assert (equal events '(:item :vector :direction :test))))

(defun search-with-callback (array)
  (declare (simple-vector array) (optimize (speed 3) (space 1)))
  (let ((events nil))
    (let ((result (position 1 array :from-end t
                            :key (lambda (element)
                                   (push element events)
                                   (car element)))))
      (values result (reverse events)))))

(multiple-value-bind (index events) (search-with-callback #((1 . :left) (1 . :right) (2 . :miss)))
  (assert (= index 1))
  (assert (equal events '((2 . :miss) (1 . :right)))))

(let ((evaluated nil) (array (vector 1 0 1)))
  (declare (simple-vector array))
  (assert (= 0 (position 1 array :from-end nil :from-end (setf evaluated t))))
  (assert evaluated))
