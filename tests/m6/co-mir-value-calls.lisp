(defvar *mir-value-events* nil)
(defun mir-value-check (body &optional (pipelines '(:hir :mir)))
  (dolist (pipeline pipelines)
    (let* ((kiln.compiler::*compiler-pipeline* pipeline)
           (function (compile nil `(lambda (x xs) (declare (optimize (speed 3) (safety 3))) ,body))))
      (setf *mir-value-events* nil)
      (print (funcall function (list 1 2) (list 3))))))

(mir-value-check '(let ((result (append x xs)))
                   (and (equal result '(1 2 3)) (not (eq result x)) (eq (cddr result) xs))))
(mir-value-check '(let ((result (append x nil))) (and (equal result x) (not (eq result x)))))
(mir-value-check '(and (eq (append nil xs) xs) (eq (append xs) xs)))
(mir-value-check '(and (null (append)) (eq (append nil :tail) :tail)))
(mir-value-check '(eq (cddr (append x :tail)) :tail))
(mir-value-check '(let ((result (append (progn (push 1 *mir-value-events*) nil)
                                      (progn (push 2 *mir-value-events*) x)
                                      (progn (push 3 *mir-value-events*) nil)
                                      (progn (push 4 *mir-value-events*) xs))))
                   (and (equal result '(1 2 3)) (equal *mir-value-events* '(4 3 2 1)))))
(mir-value-check '(eql (+ (expt 2 100) 1) 1267650600228229401496703205377))
(mir-value-check '(eql (/ 1 3) 1/3))
(mir-value-check '(eql (+ 0.25d0 0.75d0) 1d0))
(mir-value-check '(eql (complex 1d0 2d0) #c(1d0 2d0)))
(mir-value-check '(eql (code-char 97) #\a))
(mir-value-check '(and (eq (append (values) xs) xs)
                      (eq (append (values nil (push :extra *mir-value-events*)) xs) xs)
                      (equal *mir-value-events* '(:extra))))
(mir-value-check '(handler-case
                     (progn (append (progn (push :first *mir-value-events*) :bad)
                                    (progn (push :second *mir-value-events*) nil)) nil)
                   (type-error () (equal *mir-value-events* '(:second :first)))))
(mir-value-check '(handler-case
                     (progn (append (let ((value nil)) (declare (type integer value)) value) xs) nil)
                   (type-error () t)))
(mir-value-check '(handler-case (progn (append (the integer nil) xs) nil) (type-error () t)) '(:mir))
