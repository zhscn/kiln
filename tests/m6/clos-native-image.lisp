;;; Layout ancestry, structure slots, and cycles survive heap image relocation.
(defstruct saved-root value)
(defstruct (saved-leaf (:include saved-root)) next)
(defvar *saved-structure* (make-saved-leaf :value (list 1 2)))
(setf (saved-leaf-next *saved-structure*) *saved-structure*)
(defgeneric saved-value (object))
(defmethod saved-value ((object saved-root)) (saved-root-value object))
(defun restored ()
  (kiln.sys:%gc)
  (print (saved-root-p *saved-structure*))
  (print (saved-leaf-p *saved-structure*))
  (print (eq (saved-leaf-next *saved-structure*) *saved-structure*))
  (print (saved-value *saved-structure*))
  (setf (saved-root-value *saved-structure*) (list 3 4))
  (kiln.sys:%gc)
  (print (saved-value (copy-saved-leaf *saved-structure*)))
  (print (saved-root-value (make-saved-leaf :value 5))))
(kiln.sys:save-image "clos-native-image.img" :toplevel #'restored)
(print 'saved)
