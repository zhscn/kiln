(let ((data (list (loop for i below 20000 collect i)
                  (loop with tree = :leaf repeat 5000 do (setf tree (list tree)) finally (return tree))
                  (cons :dotted :tail) "λ" #\Newline #(0 127 128 255))))
  (with-open-file (stream "build/test/deep-record.bin" :direction :output
                          :element-type '(unsigned-byte 8) :if-exists :supersede)
    (kiln.kernel::fasl-write-data data stream))
  (with-open-file (stream "build/test/deep-record.bin" :element-type '(unsigned-byte 8))
    (let ((result (kiln.kernel::fasl-read-data stream)))
      (assert (= 20000 (length (first result))))
      (loop for value in (first result) for index from 0 do (assert (= value index)))
      (let ((tree (second result)))
        (dotimes (i 5000) (assert (null (cdr tree))) (setf tree (car tree)))
        (assert (eq tree :leaf)))
      (assert (equal (third result) '(:dotted . :tail)))
      (assert (string= "λ" (fourth result)))
      (assert (eql #\Newline (fifth result)))
      (assert (equalp #(0 127 128 255) (sixth result)))
      (assert (eq :end (read-byte stream nil :end)))))
  (delete-file "build/test/deep-record.bin"))
(let* ((buffered "build/test/fasl-buffered.bin")
       (reference "build/test/fasl-reference.bin")
       (program '(:lir-module "packed-write"))
       (packet (kiln.lir::encode-image-program program))
       (unit (list 1 (list (list :string 0 (make-string 5000 :initial-element #\λ))
                           (list :run #(0 127 128 255) 0)
                           (list :run packet 0)
                           (list :character 0 #\Newline)))))
  (assert (equalp (kiln.lir:encode-program program) (kiln.sys:%primop :packet-vector packet)))
  (unwind-protect
       (progn
         (with-open-file (stream buffered :direction :output :if-exists :supersede
                                          :element-type '(unsigned-byte 8))
           (kiln.kernel::write-native-fasl unit stream))
         (with-open-file (stream reference :direction :output :if-exists :supersede
                                           :element-type '(unsigned-byte 8))
           (kiln.kernel::fasl-write-records unit stream))
         (with-open-file (left buffered :element-type '(unsigned-byte 8))
           (with-open-file (right reference :element-type '(unsigned-byte 8))
             (loop for byte = (read-byte left nil nil)
                   do (assert (eql byte (read-byte right nil nil)))
                   while byte))))
    (when (probe-file buffered) (delete-file buffered))
    (when (probe-file reference) (delete-file reference))))
(print :deep-fasl-records)
