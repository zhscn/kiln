(eval '(defun cm-image (x) (+ x 100)))
(eval '(define-compiler-macro cm-image (x) `(+ ,x 1)))
(eval '(defun cm-user (x) (cm-image x)))
(print (cm-user 10))
(print (not (null (member 'cm-user (kiln.sys:dependents :compiler-macro 'cm-image) :test #'equal))))
(eval '(define-compiler-macro cm-image (x) `(+ ,x 2)))
(print (cm-user 10))
(setf (compiler-macro-function 'cm-image) nil)
(print (cm-user 10))
(eval '(define-compiler-macro cm-image (x) `(+ ,x 3)))
(print (cm-user 10))
(print (funcall (compile nil '(lambda (x) (funcall #'cm-image x))) 20))
(print (funcall (compile nil '(lambda (x) (declare (notinline cm-image)) (cm-image x))) 20))
(print (funcall (compile nil '(lambda (x) (flet ((cm-image (x) (+ x 200))) (cm-image x)))) 20))
(eval '(defun cm-empty () :ordinary))
(eval '(define-compiler-macro cm-empty () nil))
(print (funcall (compile nil '(lambda () (cm-empty)))))
(eval '(defun cm-later-user (x) (cm-later x)))
(eval '(defun cm-later (x) (+ x 100)))
(print (cm-later-user 1))
(eval '(define-compiler-macro cm-later (x) `(+ ,x 10)))
(print (cm-later-user 1))
(eval '(declaim (notinline cm-image)))
(print (funcall (compile nil '(lambda (x) (cm-image x))) 30))
(print (not (null (compiler-macro-function 'cm-image))))
(eval '(proclaim '(inline cm-image)))
(print (funcall (compile nil '(lambda (x) (cm-image x))) 30))
(eval '(defmacro cm-query () (if (compiler-macro-function 'cm-image) 1 2)))
