(defclass mir-slot-value-probe () ((zero) (many) (shared :allocation :class)))
(defmethod slot-unbound ((class standard-class) (object mir-slot-value-probe) name)
  (declare (ignore class object))
  (case name (zero (values)) (many (values 1 2 3)) (shared (values 7 8))))

(dolist (pipeline '(:mir))
  (let ((kiln.compiler::*compiler-pipeline* pipeline)
        (object (make-instance 'mir-slot-value-probe)))
    (dolist (entry '((zero nil) (many 1) (shared 7)))
      (let ((reader (compile nil `(lambda (object)
                                   (declare (optimize (speed 3) (safety 3) (debug 1)))
                                   (slot-value object ',(first entry))))))
        (dotimes (iteration 2)
          (print (equal (multiple-value-list (funcall reader object)) (list (second entry))))
          (when (zerop iteration) (kiln.sys:%gc)))))))
