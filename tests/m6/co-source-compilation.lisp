(compile 'named-compiled
         '(lambda () (kiln.sys:frame-name (first (kiln.sys:frame-list)))))
(print (named-compiled))
(compile '(setf named-compiled)
         '(lambda (value) (declare (ignore value))
            (kiln.sys:frame-name (first (kiln.sys:frame-list)))))
(print (funcall #'(setf named-compiled) nil))
(let ((path "build/test/source-location-input.lisp"))
  (with-open-file (out path :direction :output :if-exists :supersede)
    (write-line "(in-package :cl-user)" out)
    (write-line "(defparameter *loaded-read-time-value* #.(+ 2 3))" out)
    (write-line "(defmacro loaded-probe () '(first (kiln.sys:frame-list)))" out)
    (write-line "(defun loaded-source ()" out)
    (write-line "  (multiple-value-list (kiln.sys:frame-source (loaded-probe))))" out))
  (load path)
  (print (symbol-value '*loaded-read-time-value*))
  (eval '(defmacro loaded-probe () '(first (kiln.sys:frame-list))))
  (let ((source (loaded-source)))
    (print (and (search "source-location-input.lisp" (first source)) t))
    (print (and (integerp (second source)) (integerp (third source))
                (< 0 (second source) (third source)))))
  (delete-file path))
;; A macro can recursively compile while the outer session is leased.
(eval '(defmacro compiled-answer ()
         (funcall (compile nil '(lambda () '(quote :nested))))))
(print (funcall (compile nil '(lambda () (compiled-answer)))))
(print (funcall (compile nil '(lambda () :after))))
