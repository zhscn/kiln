(let* ((path "build/test/binary-chunks.bin")
       (size 20003)
       (data (make-array size :element-type '(unsigned-byte 8))))
  (dotimes (i size) (setf (aref data i) (mod i 251)))
  (unwind-protect
       (progn
         (with-open-file (out path :direction :output :if-exists :supersede
                                  :element-type '(unsigned-byte 8))
           (write-sequence data out))
         (with-open-file (in path :element-type '(unsigned-byte 8))
           (assert (= (read-byte in) 0))
           (let ((bytes (make-array (+ size 5) :initial-element :untouched)))
             (assert (= (read-sequence bytes in :start 3 :end (+ size 4)) (+ size 2)))
             (dotimes (i (1- size)) (assert (= (svref bytes (+ i 3)) (aref data (1+ i)))))
             (assert (eq (svref bytes 2) :untouched))
             (assert (eq (svref bytes (+ size 2)) :untouched)))
           (assert (= (file-position in) size))
           (assert (eq (read-byte in nil :end) :end))
           (file-position in 8189)
           (let ((bytes (make-array 9 :element-type '(unsigned-byte 8))))
             (assert (= (read-sequence bytes in) 9))
             (assert (equalp bytes (subseq data 8189 8198))))
           (assert (= (read-byte in) (aref data 8198))))
         (with-open-file (io path :direction :io :if-exists :overwrite
                                 :element-type '(unsigned-byte 8))
           (write-byte 77 io)
           (let ((bytes (make-array 3)))
             (assert (= (read-sequence bytes io) 3))
             (assert (equalp bytes #(1 2 3)))))
         (with-open-file (in path :element-type '(unsigned-byte 16))
           (let ((values (make-array 2)))
             (assert (= (read-sequence values in) 2))
             (assert (= (svref values 0) (+ 77 (ash 1 8))))
             (assert (= (svref values 1) (+ 2 (ash 3 8)))))))
    (when (probe-file path) (delete-file path))))

(let ((path "build/test/packet-record.bin") (bytes (make-array 20003)))
  (dotimes (i (length bytes)) (setf (svref bytes i) (mod i 256)))
  (unwind-protect
       (progn
         (with-open-file (out path :direction :output :if-exists :supersede
                                  :element-type '(unsigned-byte 8))
           (kiln.kernel::fasl-write-data bytes out)
           (write-byte 42 out))
         (with-open-file (in path :element-type '(unsigned-byte 8))
           (assert (equalp bytes (kiln.kernel::fasl-read-data in)))
           (assert (= (read-byte in) 42)))
         (with-open-file (out path :direction :output :if-exists :supersede
                                  :element-type '(unsigned-byte 8))
           (write-byte 6 out)
           (kiln.kernel::fasl-write-uint 20003 out)
           (write-byte 1 out))
         (with-open-file (in path :element-type '(unsigned-byte 8))
           (assert (handler-case (progn (kiln.kernel::fasl-read-data in) nil)
                     (end-of-file () t)))))
    (when (probe-file path) (delete-file path))))
(print :binary-file-chunks)
