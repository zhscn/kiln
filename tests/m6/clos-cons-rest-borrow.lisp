(defmacro exercise-rest-borrow ()
  (let ((pair (gensym "PAIR")) (item (gensym "ITEM")) (read (gensym "READ")))
    `(flet ((,read (,item &rest rest)
              (kiln.sys:%gc)
              (rplaca ,item (vector (length rest) 31))
              (car ,item)))
       (declare (notinline ,read))
       (let ((,pair (cons (vector 17) nil)))
         (declare (dynamic-extent ,pair))
         (print (svref (,read ,pair 1 2 3) 0))
         (kiln.sys:%gc)
         (print (svref (car ,pair) 1))))))
(exercise-rest-borrow)

(defmacro exercise-recursive-rest-borrow ()
  (let ((pair (gensym "PAIR")) (item (gensym "ITEM")) (read (gensym "READ")))
    `(labels ((,read (,item count &rest rest)
                (declare (ignore rest))
                (kiln.sys:%gc)
                (if (zerop count) (car ,item) (,read ,item (1- count) 7 8))))
       (declare (notinline ,read))
       (let ((,pair (cons (vector 53) nil)))
         (print (svref (,read ,pair 4 9) 0))))))
(exercise-recursive-rest-borrow)

(defmacro exercise-returned-rest-alias ()
  (let ((pair (gensym "PAIR")) (item (gensym "ITEM")) (rest (gensym "REST"))
        (alias (gensym "ALIAS")) (same (gensym "SAME")))
    `(flet ((,same (,item &rest ,rest)
              (kiln.sys:%gc) (setq ,rest ,item) ,rest))
       (declare (notinline ,same))
       (let ((,pair (cons (vector 61) nil)))
         (let ((,alias (,same ,pair 1 2)))
           (kiln.sys:%gc)
           (print (eq ,alias ,pair))
           (print (svref (car ,alias) 0)))))))
(exercise-returned-rest-alias)

(defvar *rest-borrow-saved* nil)
(defmacro escape-rest-argument (store)
  (let ((pair (gensym "PAIR")) (item (gensym "ITEM")) (save (gensym "SAVE")))
    `(flet ((,save (,item &rest rest)
              ,(if store `(rplaca rest ,item) `(identity ,item))
              (setq *rest-borrow-saved* rest)))
       (declare (notinline ,save))
       (let ((,pair (cons 71 72)))
         ,(if store `(,save ,pair nil) `(,save nil ,pair))))))
(defun escape-extra-rest () (escape-rest-argument nil))
(escape-extra-rest)
(kiln.sys:%gc)
(print (car *rest-borrow-saved*))
(defun escape-stored-rest () (escape-rest-argument t))
(escape-stored-rest)
(kiln.sys:%gc)
(print (car *rest-borrow-saved*))

(defun inspect-rest-borrow ()
  (kiln.sys:%gc)
  (let* ((frame (find-if (lambda (frame)
                           (let ((name (kiln.sys:frame-name frame)))
                             (and (consp name) (eq (first name) 'flet)
                                  (eq (second name) 'rest-visible))))
                         (kiln.sys:frame-list)))
         (pair (cdr (assoc 'item (kiln.sys:frame-variables frame)))))
    (setq *rest-borrow-saved* pair)
    (rplaca pair 91)))
(defmacro invoke-visible-rest-borrow (function)
  (let ((pair (gensym "PAIR")))
    `(let ((,pair (cons 81 82))) (,function ,pair 1 2))))
(defun exercise-visible-rest-borrow ()
  (flet ((rest-visible (item &rest rest)
           (declare (ignore rest))
           (inspect-rest-borrow)
           (car item)))
    (declare (notinline rest-visible))
    (print (invoke-visible-rest-borrow rest-visible))))
(exercise-visible-rest-borrow)
(kiln.sys:%gc)
(print *rest-borrow-saved*)
