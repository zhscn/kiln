(defun unboxed-local-probe ()
  (kiln.sys:%gc)
  (let* ((frame (find 'unboxed-local-frame (kiln.sys:frame-list) :key #'kiln.sys:frame-name))
         (names (svref (kiln.kernel::frame-debug-info frame) 4))
         (description (find-if (lambda (entry) (and (consp entry) (eq (second entry) 'value))) names)))
    (print (eq (first description) :double-bits))
    (let ((value (cdr (assoc 'value (kiln.sys:frame-variables frame)))))
      (print (= (kiln.sys:%primop :double-float-high-bits value) #x3ff40000))
      (print (= (kiln.sys:%primop :double-float-low-bits value) 5)))))
(defun unboxed-local-frame (input)
  (let ((value input))
    (declare (double-float value))
    (unboxed-local-probe)
    value))
(let ((value (unboxed-local-frame (kiln.sys:%primop :make-double-float-bits #x3ff40000 5))))
  (print (= (kiln.sys:%primop :double-float-low-bits value) 5)))

(let ((value 1d0))
  (declare (double-float value))
  (print (handler-case (setq value "bad") (type-error () 'type-error)))
  (print (= value 1d0))
  (print (= (setq value (+ value (progn (setq value 4d0) value))) 5d0))
  (print (handler-case (locally (declare (integer value)) value) (type-error () 'type-error)))
  (print (= value 5d0)))
(multiple-value-bind (a b) (values 1d0 2d0)
  (declare (double-float a b))
  (print (= (+ a b) 3d0)))
(let ((value 1d0))
  (declare (double-float value))
  (let ((observer (lambda () value)))
    (setq value (+ value 1d0))
    (print (= (funcall observer) 2d0))))
