(defun check-expt-contagion (base power promoted)
  (let ((result (expt base power)) (reference (expt promoted power)))
    (assert (typep result '(complex double-float)))
    (assert (< (/ (abs (- result reference)) (abs reference)) 2d-14))))
(check-expt-contagion 10 #c(3d0 1d0) 10d0)
(check-expt-contagion 1/3 #c(0.5d0 2d0) (/ 1d0 3d0))
(check-expt-contagion #c(2 3) 0.7d0 #c(2d0 3d0))
(check-expt-contagion -7 #c(2d0 0.3d0) -7d0)
(assert (typep (expt 10 #c(3 1)) '(complex single-float)))
(print :complex-expt-contagion)
