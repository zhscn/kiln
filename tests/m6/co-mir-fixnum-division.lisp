(defun division-floor (n)
  (declare (fixnum n) (optimize (speed 3) (safety 3)))
  (floor n 8))

(defun division-truncate (n)
  (declare (fixnum n) (optimize (speed 3) (safety 3)))
  (truncate n 8))

(defun division-primary (n)
  (declare (fixnum n) (optimize (speed 3) (safety 3)))
  (1+ (truncate n 2)))

(defun division-saved (n)
  (declare (fixnum n) (optimize (speed 3) (safety 3)))
  (multiple-value-prog1 (floor n 2) (division-truncate 19)))

(defun division-unit (n)
  (declare (fixnum n) (optimize (speed 3) (safety 3)))
  (truncate n 1))

(defun division-offset-product (n)
  (declare (fixnum n) (optimize (speed 3) (safety 3)))
  (truncate (the fixnum (* (the fixnum (+ n 9)) n)) 2))

(assert (equal '(18 0) (multiple-value-list (division-offset-product -12))))
(assert (equal '(-10 0) (multiple-value-list (division-offset-product -4))))
(assert (equal '(68 0) (multiple-value-list (division-offset-product 8))))
(assert (handler-case (progn (division-offset-product (ash 1 32)) nil)
          (type-error () t)))

(print (every (lambda (n)
                (locally (declare (notinline truncate floor))
                  (and (equal (multiple-value-list (division-floor n))
                              (multiple-value-list (floor n 8)))
                       (equal (multiple-value-list (division-truncate n))
                              (multiple-value-list (truncate n 8)))
                       (= (division-primary n) (1+ (truncate n 2)))
                       (equal (multiple-value-list (division-saved n))
                              (multiple-value-list (floor n 2)))
                       (equal (multiple-value-list (division-unit n)) (list n 0)))))
              (list most-negative-fixnum (1+ most-negative-fixnum)
                    -9 -8 -7 -1 0 1 7 8 9 most-positive-fixnum)))

(defun division-exact (n)
  (declare (fixnum n) (optimize (speed 3) (safety 3)))
  (/ n 8))

(defun division-exact-unit (n)
  (declare (fixnum n) (optimize (speed 3) (safety 3)))
  (/ n 1))

(print (every (lambda (n)
                (locally (declare (notinline /))
                  (and (equal (multiple-value-list (division-exact n)) (list (/ n 8)))
                       (eql (division-exact-unit n) n))))
              (list most-negative-fixnum (1+ most-negative-fixnum)
                    -9 -8 -7 -1 0 1 7 8 9 most-positive-fixnum)))

(defun constant-mod-1000 (n)
  (declare (fixnum n) (optimize (speed 3) (safety 3)))
  (mod n 1000))
(defun constant-mod-8 (n)
  (declare (fixnum n) (optimize (speed 3) (safety 3)))
  (mod n 8))

(dolist (n (list most-negative-fixnum -1001 -1000 -1 0 1 1001 most-positive-fixnum))
  (locally (declare (notinline mod))
    (assert (equal (multiple-value-list (constant-mod-1000 n)) (list (mod n 1000))))
    (assert (equal (multiple-value-list (constant-mod-8 n)) (list (mod n 8))))))

(defun guarded-unsigned-mod (n)
  (declare (type unsigned-byte n) (optimize (speed 3) (safety 3)))
  (mod n 1000))
(defun guarded-integer-mod (n)
  (declare (integer n) (optimize (speed 3) (safety 3)))
  (mod n 1000))

(dolist (n (list 0 999 1001 most-positive-fixnum (1+ most-positive-fixnum) (ash 1 100)))
  (locally (declare (notinline mod))
    (assert (equal (multiple-value-list (guarded-unsigned-mod n)) (list (mod n 1000))))
    (assert (equal (multiple-value-list (guarded-integer-mod (- n))) (list (mod (- n) 1000))))))
