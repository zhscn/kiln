(defun read-double-array (array)
  (declare ((simple-array double-float (2)) array)
           (optimize (speed 3) (safety 3)))
  (+ (aref array 0) (aref array 1)))

(defun read-single-array (array)
  (declare ((simple-array single-float 2) array)
           (optimize (speed 3) (safety 3)))
  (+ (aref array 0 1) (row-major-aref array 0)))

(defun read-float-with-index (array index)
  (declare ((simple-array double-float) array)
           (optimize (speed 3) (safety 3)))
  (aref array index))

(defun read-after-optional-check (array index check)
  (declare ((simple-array double-float (*)) array) (fixnum index)
           (optimize (speed 3) (safety 3)))
  (+ (if check (aref array index) 0d0) (aref array index)))

(let ((array (make-array 1 :element-type 'double-float :initial-element 2d0)))
  (assert (= 4d0 (read-after-optional-check array 0 t)))
  (assert (handler-case (progn (read-after-optional-check array 1 nil) nil)
            (type-error () t))))

(defun read-after-branch-check (array index branch)
  (declare ((simple-array double-float (*)) array) (fixnum index)
           (optimize (speed 3) (safety 3)))
  (+ (if branch (aref array index) (- (aref array index)))
     (aref array index)))

(defun read-loop-index (array index count)
  (declare ((simple-array double-float (*)) array) (fixnum index count)
           (optimize (speed 3) (safety 3)))
  (let ((sum (aref array index)))
    (dotimes (i count sum)
      (incf sum (aref array index))
      (incf index))))

(let ((array (make-array 1 :element-type 'double-float :initial-element 2d0)))
  (assert (= 4d0 (read-after-branch-check array 0 t)))
  (assert (= 0d0 (read-after-branch-check array 0 nil)))
  (assert (= 4d0 (read-loop-index array 0 1)))
  (assert (handler-case (progn (read-loop-index array 0 2) nil)
            (type-error () t))))

(defun read-after-different-length-checks (short long index branch)
  (declare ((simple-array double-float (2)) short)
           ((simple-array double-float (4)) long)
           (fixnum index) (optimize (speed 3) (safety 3)))
  (+ (if branch (+ (aref short index) (aref short 0))
         (aref long index))
     (aref long index)))

(defun read-short-after-different-length-checks (short long index branch)
  (declare ((simple-array double-float (2)) short)
           ((simple-array double-float (4)) long)
           (fixnum index) (optimize (speed 3) (safety 3)))
  (+ (if branch (aref short index) (+ (aref long index) (aref long 0)))
     (aref short index)))

(let ((short (make-array 2 :element-type 'double-float :initial-element 2d0))
      (long (make-array 4 :element-type 'double-float :initial-element 3d0)))
  (assert (= 7d0 (read-after-different-length-checks short long 1 t)))
  (assert (= 6d0 (read-after-different-length-checks short long 3 nil)))
  (assert (handler-case
              (progn (read-short-after-different-length-checks short long 3 nil) nil)
            (type-error () t))))

(defun write-float-with-index (array index value)
  (declare ((simple-array double-float) array) (double-float value)
           (optimize (speed 3) (safety 3)))
  (setf (aref array index) value))

(defun write-untyped-float-array (array index value)
  (declare ((simple-array double-float) array)
           (optimize (speed 3) (safety 3)))
  (setf (aref array index) value))

(print (= (read-double-array (make-array 2 :element-type 'double-float
                                         :initial-contents '(1d0 2d0)))
          3d0))
(print (= (read-single-array (make-array '(1 2) :element-type 'single-float
                                         :initial-contents '((2f0 4f0))))
          6f0))
(print (every (lambda (array)
                (handler-case (progn (read-double-array array) nil)
                  (type-error () t)))
              (list (make-array 3 :element-type 'double-float)
                    (make-array '(1 2) :element-type 'double-float)
                    (make-array 2 :element-type 'single-float)
                    (make-array 2 :element-type 'double-float :adjustable t))))
(let ((array (make-array 2 :element-type 'double-float)))
  (print (and (eql 3d0 (write-float-with-index array 1 3d0))
              (eql 3d0 (read-float-with-index array 1))
              (handler-case (progn (write-untyped-float-array array 0 5) nil)
                (type-error () t))
              (eql 0d0 (read-float-with-index array 0))))
  (print (every (lambda (index)
                  (and (handler-case (progn (read-float-with-index array index) nil)
                         (type-error () t))
                       (handler-case (progn (write-float-with-index array index 0d0) nil)
                         (type-error () t))))
                '(-1 2 :invalid))))
(print (handler-case (progn (read-float-with-index
                             (make-array '(1 2) :element-type 'double-float) 0)
                            nil)
         (error () t)))

(defun double-vector-of-three-p (object)
  (typep object '(vector double-float 3)))

(defun single-vector-p (object)
  (typep object '(vector single-float *)))

(let* ((backing (make-array 6 :element-type 'double-float))
       (displaced (make-array 3 :element-type 'double-float
                               :displaced-to backing :displaced-index-offset 2))
       (filled (make-array 3 :element-type 'double-float :fill-pointer 1))
       (adjustable (make-array 3 :element-type 'double-float :adjustable t)))
  (print (every #'double-vector-of-three-p (list displaced filled adjustable)))
  (adjust-array adjustable 4)
  (print (not (some #'double-vector-of-three-p
                    (list adjustable backing #(0d0 1d0 2d0)
                          (make-array '(1 3) :element-type 'double-float)
                          (make-array 3 :element-type 'single-float) 3))))
  (print (and (single-vector-p (make-array 0 :element-type 'single-float))
              (not (single-vector-p filled)))))

(let* ((backing (make-array 4 :element-type 'double-float :initial-element 2d0))
       (vector (make-array 3 :element-type 'double-float :fill-pointer 1))
       (displaced (make-array 2 :element-type 'double-float
                               :displaced-to backing :displaced-index-offset 1)))
  (print (and (eql (setf (elt vector 0) -0d0) -0d0)
              (eql (elt vector 0) -0d0)
              (handler-case (progn (elt vector 1) nil) (type-error () t))
              (handler-case (progn (setf (elt vector 0) nil) nil) (type-error () t))
              (eql (elt vector 0) -0d0)))
  (print (and (eql (elt displaced 1) 2d0)
              (eql (setf (elt displaced 0) 3d0) 3d0)
              (eql (aref backing 1) 3d0))))

(defun update-checked-single-vector (array index)
  (declare ((simple-array single-float (2)) array) (fixnum index)
           (optimize (speed 3) (safety 3)))
  (setf (aref array 0) (+ (aref array 0) 1f0))
  (kiln.sys:%gc)
  (aref array index))

(let ((array (make-array 2 :element-type 'single-float :initial-element 2f0)))
  (print (and (eql 3f0 (update-checked-single-vector array 0))
              (handler-case (progn (update-checked-single-vector array 2) nil)
                (type-error () t))
              (eql 4f0 (aref array 0)))))

(defun increment-simple-single-vector (array index)
  (declare ((simple-array single-float (*)) array)
           (optimize (speed 3) (safety 3)))
  (incf (aref array index) 1f0))

(let ((array (make-array 2 :element-type 'single-float :initial-element 2f0)))
  (assert (eql 3f0 (increment-simple-single-vector array 1)))
  (dolist (index '(-1 2 :invalid))
    (assert (handler-case (progn (increment-simple-single-vector array index) nil)
              (type-error () t))))
  (assert (eql 2f0 (aref array 0)))
  (assert (eql 3f0 (aref array 1))))

(defvar *unknown-rank-accessed* nil)

(defun read-unknown-rank-twice (array access)
  (declare ((simple-array double-float) array)
           (optimize (speed 3) (safety 3)))
  (when access
    (setf *unknown-rank-accessed* t)
    (+ (aref array 0) (aref array 1))))

(let ((matrix (make-array '(1 2) :element-type 'double-float)))
  (print (and (null (read-unknown-rank-twice matrix nil))
              (not *unknown-rank-accessed*)
              (handler-case (progn (read-unknown-rank-twice matrix t) nil)
                (error () *unknown-rank-accessed*))
              (handler-case
                  (progn
                    (read-unknown-rank-twice (make-array 0 :element-type 'double-float) t)
                    nil)
                (type-error () t))
              (eql 6d0 (read-unknown-rank-twice
                        (make-array 2 :element-type 'double-float :initial-element 3d0) t)))))

(defun fixed-array-dimensions (array)
  (declare ((simple-array single-float (2 * 4)) array)
           (optimize (speed 3) (safety 3)))
  (list (multiple-value-list (array-dimension array 0))
        (array-dimension array 1)
        (array-dimension array 2)
        (handler-case (progn (array-dimension array :invalid) nil)
          (error () t))))

(print (equal (fixed-array-dimensions
               (make-array '(2 3 4) :element-type 'single-float))
              '((2) 3 4 t)))

(let* ((array (make-array 2 :element-type 'double-float :adjustable t
                            :fill-pointer 2 :initial-contents '(1d0 -0d0)))
       (displaced (make-array 1 :element-type 'double-float
                                :displaced-to array :displaced-index-offset 1)))
  (assert (eql -0d0 (aref displaced 0)))
  (assert (= 2 (vector-push-extend 4d0 array 1)))
  (kiln.sys:%gc)
  (assert (equal (coerce array 'list) '(1d0 -0d0 4d0)))
  (setf (aref displaced 0) 2d0)
  (assert (eql 2d0 (elt array 1))))

(defun add-single-array-elements (array i j)
  (declare ((simple-array single-float (2)) array) (fixnum i j)
           (optimize (speed 3) (safety 3)))
  (+ (aref array i) (aref array j)))

(let ((array (make-array 2 :element-type 'single-float :initial-element -0f0)))
  (assert (eql (add-single-array-elements array 0 1) -0f0))
  (setf (aref array 1) 2f0)
  (kiln.sys:%gc)
  (assert (eql (add-single-array-elements array 1 1) 4f0))
  (assert (handler-case (progn (add-single-array-elements array 0 2) nil)
            (type-error () t)))
  (assert (handler-case (progn (add-single-array-elements array -1 0) nil)
            (type-error () t))))

(defun read-selected-checked-index (array i j flag)
  (declare ((simple-array double-float (*)) array) (fixnum i j)
           (optimize (speed 3) (safety 3)))
  (aref array (if flag (progn (aref array i) i) (progn (aref array j) j))))

(defun read-loop-checked-index (array index count)
  (declare ((simple-array double-float (*)) array) (fixnum index count)
           (optimize (speed 3) (safety 3)))
  (aref array index)
  (dotimes (i count (aref array index))
    (setq index (the fixnum (1+ index)))
    (aref array index)))

(let ((array (make-array 3 :element-type 'double-float :initial-contents '(1d0 2d0 3d0))))
  (assert (= 1d0 (read-selected-checked-index array 0 -1 t)))
  (assert (= 2d0 (read-selected-checked-index array -1 1 nil)))
  (assert (= 1d0 (read-loop-checked-index array 0 0)))
  (assert (= 3d0 (read-loop-checked-index array 0 2)))
  (assert (handler-case (progn (read-selected-checked-index array 0 -1 nil) nil)
            (type-error () t)))
  (assert (handler-case (progn (read-loop-checked-index array -1 0) nil)
            (type-error () t)))
  (assert (handler-case (progn (read-loop-checked-index array 0 3) nil)
            (type-error () t))))
