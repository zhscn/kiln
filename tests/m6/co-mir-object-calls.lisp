(defclass mir-cache-object () ((value :initarg :value) (other :initarg :other :initform 0)))
(defvar *mir-cache-events* nil)

(dolist (pipeline '(:hir :mir))
  (let* ((kiln.compiler::*compiler-pipeline* pipeline)
         (reader (compile nil '(lambda (object) (slot-value object 'value))))
         (writer (compile nil '(lambda (value object) (setf (slot-value object 'value) value))))
         (ordinary (compile nil '(lambda (object) (declare (notinline slot-value)) (slot-value object 'value))))
         (constructor (compile nil '(lambda (value other)
                                      (make-instance 'mir-cache-object
                                        :value (progn (push :value *mir-cache-events*) value)
                                        :other (progn (push :other *mir-cache-events*) other)))))
         (object (make-instance 'mir-cache-object :value 7)))
    (print (= (funcall reader object) 7))
    (print (and (= (funcall writer 9 object) 9) (= (funcall reader object) 9)))
    (kiln.sys:%gc)
    (print (= (funcall reader object) 9))
    (setf *mir-cache-events* nil)
    (let ((new (funcall constructor 11 12)))
      (print (and (= (funcall reader new) 11) (= (slot-value new 'other) 12)
                  (equal *mir-cache-events* '(:other :value)))))
    (eval '(defclass mir-cache-object ()
             ((padding :initform 100) (other :initarg :other :initform 0) (value :initarg :value))))
    (print (= (funcall reader object) 9))
    (let ((new (funcall constructor 13 14)))
      (print (and (= (funcall reader new) 13) (= (slot-value new 'padding) 100))))
    (eval '(defmethod initialize-instance :after ((object mir-cache-object) &key)
             (declare (ignore object)) (push :after *mir-cache-events*)))
    (setf *mir-cache-events* nil)
    (print (and (= (funcall reader (funcall constructor 15 16)) 15)
                (equal *mir-cache-events* '(:after :other :value))))
    (print (= (funcall ordinary object) 9))
    (remove-method #'initialize-instance
                   (find-method #'initialize-instance '(:after) (list (find-class 'mir-cache-object))))
    (eval '(defclass mir-cache-object () ((value :initarg :value) (other :initarg :other :initform 0))))))
