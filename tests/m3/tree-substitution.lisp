;; Tree substitutions compare whole subtrees before their children.
(print (sublis '((a . nil) (nil . end)) '(a b . a)))
(print (sublis '((1 . small) (5 . medium) (10 . large)) '(0 3 8 20)
               :test (lambda (node bound)
                       (and (numberp node) (numberp bound) (< node bound)))))
(print (sublis '((a . replaced)) '((a b) c)
               :key (lambda (node) (if (consp node) (car node) node))))
(print (subst '(a a) 'a '(a . a)))
(print (subst-if 'even (lambda (node) (and (integerp node) (evenp node)))
                 '(1 (2 . 3) 4)))
(print (subst-if-not 'atom #'consp '(a b)))

;; Copying substitutions preserve the input; destructive ones retain conses.
(let* ((tree (list 'a 'b))
       (result (subst 'x 'a tree)))
  (print tree)
  (print result)
  (print (eq tree result))
  (print (eq tree (subst 'x 'absent tree))))
(let* ((tree (list 'a (list 'b 'a)))
       (child (car (cdr tree)))
       (result (nsubst 'x 'a tree)))
  (print (eq tree result))
  (print (eq child (car (cdr result))))
  (print result))
(print (nsublis '((nil . end) (a . nil)) (list 'a 'b)))
(print (nsubst-if 'even #'evenp (list 1 2 3)
                  :key (lambda (node) (if (integerp node) node 1))))
(print (nsubst-if-not 'atom #'consp (list 'a 'b)))
