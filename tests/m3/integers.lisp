;; Integers: fixnum overflow to bignums and back, division, bit operations.
(defun fact (n) (if (= n 0) 1 (* n (fact (- n 1)))))
(print (fact 20))
(print (fact 30))
(print (- (fact 30)))
(defun fib (n)
  (let ((a 0) (b 1))
    (dotimes (i n a) (psetq a b b (+ a b)))))
(print (fib 100))
(print 4611686018427387903)            ; most-positive-fixnum
(print (+ 4611686018427387903 1))      ; first bignum
(print (- (+ 4611686018427387903 1) 1)) ; back to a fixnum
(print (- -4611686018427387904 1))
(print 123456789012345678901234567890)
(print (* 123456789012345678901234567890 -987654321098765432109876543210))
(print (= (fact 25) (* 25 (fact 24))))
(print (eql (fact 25) (fact 25)))
(print (eql (fact 25) (fact 24)))
(print (< (fact 20) (fact 21) (fact 22)))
(print (> (fact 20) (fact 21)))
(print (list (zerop (- (fact 22) (fact 22))) (plusp (fact 22)) (minusp (- (fact 22)))))
(print (max 3 (fact 21) 7))

(print (multiple-value-list (truncate 7 2)))
(print (multiple-value-list (truncate -7 2)))
(print (multiple-value-list (floor -7 2)))
(print (multiple-value-list (ceiling 7 2)))
(print (multiple-value-list (round 5 2)))
(print (multiple-value-list (round 7 2)))
(print (list (mod -7 3) (rem -7 3)))
(print (multiple-value-list (floor (fact 30) (fact 28))))

(print (list (logand 12 10) (logior 12 10) (logxor 12 10) (lognot 0)))
(print (logand (fact 30) (- (ash 1 64) 1)))
(print (ash 1 100))
(print (ash (ash 1 100) -98))
(print (ash -5 -1))
(print (list (integer-length 255) (integer-length -256) (integer-length (ash 1 100))))
(print (list (gcd 12 18) (gcd (fact 20) (fact 18)) (lcm 4 6)))
(print (expt 2 64))
(defun checked-power-of-two (exponent)
  (declare (optimize (speed 3) (safety 3)))
  (expt 2 exponent))
(defun checked-power-of-eight (exponent)
  (declare (fixnum exponent) (optimize (speed 3) (safety 3)))
  (expt 8 exponent))
(dolist (exponent '(0 1 61 62 64))
  (assert (= (checked-power-of-two exponent) (ash 1 exponent))))
(assert (= (checked-power-of-two -3) 1/8))
(assert (eql (checked-power-of-two 3f0) 8f0))
(assert (= (checked-power-of-eight 20) (ash 1 60)))
(assert (= (checked-power-of-eight 21) (ash 1 63)))
(assert (= (checked-power-of-eight -2) 1/64))
(locally (declare (notinline expt))
  (assert (= (expt -16 17) (- (ash 1 68))))
  (assert (= (expt -16 18) (ash 1 72)))
  (assert (= (expt -16 -17) (/ -1 (ash 1 68))))
  (assert (= (expt (ash 1 1024) 3) (ash 1 3072))))
(print (expt -3 3))
(print (isqrt (expt 10 40)))
(assert (= (isqrt 0) 0))
(assert (= (isqrt 1) 1))
(dolist (root (list 2 3 (1- (ash 1 31)) (ash 1 31) (1+ (ash 1 256))))
  (let ((square (* root root)))
    (assert (= (isqrt (1- square)) (1- root)))
    (assert (= (isqrt square) root))
    (assert (= (isqrt (1+ square)) root))))
(print (list (evenp (fact 30)) (oddp (+ (fact 30) 1))))
(print (abs -4611686018427387904))

;; Bignums live in the heap: they survive and move with the GC.
(let ((l (list (fact 25) (fact 26) (fact 27))))
  (%gc)
  (print l)
  (print (apply #'+ l)))

;;; Division fast paths on fixnums: signs and the one overflowing quotient.
(print (list (multiple-value-list (floor -7 2)) (multiple-value-list (floor 7 -2))
             (multiple-value-list (floor -7 -2)) (multiple-value-list (truncate -7 2))
             (multiple-value-list (truncate 7 -2)) (mod -7 2) (mod 7 -2) (mod -8 2)
             (rem -7 2) (rem 7 -2) (floor 6 3) (mod 0 5)))
(print (multiple-value-list (truncate most-negative-fixnum -1)))
(print (multiple-value-list (floor most-negative-fixnum -1)))
(print (mod most-negative-fixnum -1))
;; ASH's fixnum fast path at the edges.
(print (list (ash 1 61) (ash 1 62) (ash -1 62) (ash most-positive-fixnum 1) (ash most-negative-fixnum 1)
             (ash -7 -2) (ash 5 -63) (ash -5 -100) (ash 3 0) (ash (ash 1 61) 1) (ash 0 1000)
             (ash -1 -1) (ash 12345 -3) (ash -12345 -3) (ash 1 63) (ash 7 58)))
;; CEILING's and ROUND's fixnum fast paths.
(print (mapcar (lambda (p) (multiple-value-list (ceiling (car p) (cdr p))))
               '((7 . 2) (-7 . 2) (7 . -2) (-7 . -2) (6 . 3) (0 . 5) (5 . 1))))
(print (mapcar (lambda (p) (multiple-value-list (round (car p) (cdr p))))
               '((7 . 2) (5 . 2) (-7 . 2) (-5 . 2) (7 . -2) (-7 . -2) (8 . 3) (-8 . 3) (10 . 4) (1 . 3) (0 . 7))))
(print (list (multiple-value-list (round 7)) (multiple-value-list (ceiling -4))))

(let ((positive (ash 1 128))
      (negative (- (ash 1 128))))
  (dolist (value (list most-negative-fixnum 0 most-positive-fixnum))
    (assert (< negative value positive))
    (assert (> positive value negative))
    (assert (not (= value positive)))
    (assert (not (= negative value)))))
