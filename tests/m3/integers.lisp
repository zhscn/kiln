;; Integers: fixnum overflow to bignums and back, division, bit operations.
(defun fact (n) (if (= n 0) 1 (* n (fact (- n 1)))))
(print (fact 20))
(print (fact 30))
(print (- (fact 30)))
(defun fib (n)
  (let ((a 0) (b 1))
    (dotimes (i n a) (psetq a b b (+ a b)))))
(print (fib 100))
(print 4611686018427387903)            ; most-positive-fixnum
(print (+ 4611686018427387903 1))      ; first bignum
(print (- (+ 4611686018427387903 1) 1)) ; back to a fixnum
(print (- -4611686018427387904 1))
(print 123456789012345678901234567890)
(print (* 123456789012345678901234567890 -987654321098765432109876543210))
(print (= (fact 25) (* 25 (fact 24))))
(print (eql (fact 25) (fact 25)))
(print (eql (fact 25) (fact 24)))
(print (< (fact 20) (fact 21) (fact 22)))
(print (> (fact 20) (fact 21)))
(print (list (zerop (- (fact 22) (fact 22))) (plusp (fact 22)) (minusp (- (fact 22)))))
(print (max 3 (fact 21) 7))

(print (multiple-value-list (truncate 7 2)))
(print (multiple-value-list (truncate -7 2)))
(print (multiple-value-list (floor -7 2)))
(print (multiple-value-list (ceiling 7 2)))
(print (multiple-value-list (round 5 2)))
(print (multiple-value-list (round 7 2)))
(print (list (mod -7 3) (rem -7 3)))
(print (multiple-value-list (floor (fact 30) (fact 28))))

(print (list (logand 12 10) (logior 12 10) (logxor 12 10) (lognot 0)))
(print (logand (fact 30) (- (ash 1 64) 1)))
(print (ash 1 100))
(print (ash (ash 1 100) -98))
(print (ash -5 -1))
(print (list (integer-length 255) (integer-length -256) (integer-length (ash 1 100))))
(print (list (gcd 12 18) (gcd (fact 20) (fact 18)) (lcm 4 6)))
(print (expt 2 64))
(print (expt -3 3))
(print (isqrt (expt 10 40)))
(print (list (evenp (fact 30)) (oddp (+ (fact 30) 1))))
(print (abs -4611686018427387904))

;; Bignums live in the heap: they survive and move with the GC.
(let ((l (list (fact 25) (fact 26) (fact 27))))
  (%gc)
  (print l)
  (print (apply #'+ l)))
