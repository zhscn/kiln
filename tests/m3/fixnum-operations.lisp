(defun fixnum-operations (a b)
  (multiple-value-bind (q r) (truncate a b)
    (list q r (logand a b) (logior a b) (logxor a b)
          (ash a 2) (ash a -2) (evenp a))))
(print (fixnum-operations -19 5))
(print (fixnum-operations 19 -5))
(print (list (ash -4611686018427387904 -62) (ash 1 61)
             (ash 4611686018427387903 -61)))

(defun fixnum-right-shifts (n)
  (declare (fixnum n) (optimize (speed 3)))
  (list (ash n 0) (ash n -1) (ash n -63) (ash n -64)))
(print (fixnum-right-shifts -19))
(print (fixnum-right-shifts 19))

(defun negate-fixnum (n)
  (declare (fixnum n) (optimize (speed 3)))
  (- n))

(assert (= (negate-fixnum most-negative-fixnum) (1+ most-positive-fixnum)))
(assert (= (negate-fixnum -19) 19))
(assert (= (negate-fixnum 19) -19))

(defun reverse-indices (z)
  (declare (fixnum z) (optimize (speed 3)))
  (loop for i from 0 to (ash z -1) collect (- z i)))

(assert (null (reverse-indices most-negative-fixnum)))
(assert (equal (reverse-indices 0) '(0)))
(assert (equal (reverse-indices 7) '(7 6 5 4)))
(assert (equal (reverse-indices 8) '(8 7 6 5 4)))

(defun compare-with-half (i n)
  (declare (fixnum i n) (optimize (speed 3)))
  (values (<= i (ash n -1)) (>= (ash n -1) i)))

(dolist (n (list most-negative-fixnum (1+ most-negative-fixnum)
                 -5 -4 -1 0 1 4 5 most-positive-fixnum))
  (let ((half (ash n -1)))
    (dolist (i (list (1- half) half (1+ half) most-negative-fixnum most-positive-fixnum))
      (multiple-value-bind (forward reverse) (compare-with-half i n)
        (assert (eql forward (<= i half)))
        (assert (eql forward reverse))))))

(defun reverse-index-from-negative (z)
  (declare (fixnum z) (optimize (speed 3)))
  (loop for i from -1 to (ash z -1)
        when (= i -1) do (return (- z i))))

(assert (= (reverse-index-from-negative most-positive-fixnum) (1+ most-positive-fixnum)))

(defun bounded-counter (size)
  (declare (type (integer -100 100) size) (optimize (speed 3)))
  (dotimes (i size i)))

(defun reassigned-counter (size replacement)
  (declare (type (integer -100 100) size) (unsigned-byte replacement)
           (optimize (speed 3)))
  (dotimes (i size i)
    (setq i replacement)))

(assert (= (bounded-counter -1) (bounded-counter 0) 0))
(assert (= (bounded-counter 100) 100))
(let ((bignum (1+ most-positive-fixnum)))
  (assert (= (reassigned-counter 1 bignum) (1+ bignum))))

(defun integer-parity (n)
  (declare (optimize (speed 3) (space 1) (safety 3)))
  (if (evenp n) :even :odd))

(assert (eq (integer-parity -8) :even))
(assert (eq (integer-parity -7) :odd))
(let ((bignum (1+ most-positive-fixnum)))
  (assert (eq (integer-parity bignum) :even))
  (assert (eq (integer-parity (1+ bignum)) :odd)))
