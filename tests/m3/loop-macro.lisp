;; LOOP (Khazern, expanded at compile time).
(print (loop for x in '(1 2 3) collect (* x x)))
(print (loop for i from 0 below 10 sum i))
(print (loop for i downfrom 10 to 1 by 3 collect i))
(print (loop for x across #(1 2 3 4) when (evenp x) collect x))
(print (loop for (a . b) in '((1 . 2) (3 . 4)) append (list b a)))
(print (loop for x on '(1 2 3) collect (length x)))
(print (loop with s = 0 for i from 1 to 4 do (setq s (+ s i)) finally (return s)))
(print (loop for x = 1 then (* x 2) until (> x 100) collect x))
(print (loop for x in '(3 9 2) maximize x))
(print (loop for x in '(1 2 3) thereis (and (> x 1) x)))
(print (loop for x in '(1 2 3) always (plusp x)))
(print (loop for c across "kiln" count (char< c #\l)))
(print (loop for i from 1 to 3 for j = (* i 10) collect (list i j)))
(print (loop named outer for i from 0 do (when (= i 5) (return-from outer i))))
(print (loop for x in '(1 2 3 4) if (oddp x) collect x into odds else collect x into evens
             finally (return (list odds evens))))
(print (loop for i from 1 to 10 when (> i 3) do (loop-finish) collect i))
(print (loop repeat 3 collect 'x))
