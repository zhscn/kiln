;; Characters and strings (UTF-32).
(print #\a)
(print (list #\Space #\Newline #\λ #\A))
(print (char-code #\A))
(print (code-char 955))
(print (code-char -1))
(print (char= #\a #\a #\a))
(print (char< #\a #\b #\c))
(print (char< #\a #\c #\b))
(print (list (char-upcase #\a) (char-downcase #\Q) (char-upcase #\é)))
(print (list (digit-char-p #\7) (digit-char-p #\f 16) (digit-char-p #\g 16)))
(print (list (alpha-char-p #\x) (alpha-char-p #\3) (alphanumericp #\3)))

(print "hello")
(print "quote\"d and back\\slash")
(print "λx. ünïcödé")
(print (length "λx"))
(print (char "λx" 0))
(print (string= "abc" "abc"))
(print (string= "abc" "abd"))
(print (string= 'foo "FOO"))
(print (string-equal "HeLLo" "hello"))
(print (string< "abc" "abd"))
(print (string-upcase "Hello, World"))
(print (string-downcase 'symbol))
(print (subseq "kiln compiler" 5))
(print (subseq "kiln compiler" 0 4))
(print (reverse "stressed"))
(print (concatenate (quote string) "foo" "-" "bar"))
(print (concatenate (quote list) "ab" #(1 2) (quote (3))))
(print (string #\c))

(let ((s (make-string 5 :initial-element #\x)))
  (setf (char s 2) #\Y)
  (print s))

;; Strings are heap objects: they survive and move with the GC.
(defun make-strings (n)
  (if (= n 0) nil (cons (make-string n :initial-element (code-char (+ 96 n))) (make-strings (- n 1)))))
(let ((l (make-strings 6)))
  (%gc)
  (print l))
;; A large string goes to the large object space.
(let ((big (make-string 100000 :initial-element #\z)))
  (%gc)
  (print (length big))
  (print (char big 99999)))
