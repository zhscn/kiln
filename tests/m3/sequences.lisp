;; Vectors, lists, symbols, and kernel functions as objects.
(print #(1 2 3))
(let ((v (make-array 4 :initial-element 0)))
  (setf (svref v 1) 'one)
  (setf (aref v 3) "three")
  (print v)
  (print (length v)))
(print (vector 'a "b" #\c 4))
(print (reverse #(1 2 3)))
(print (nreverse (list 1 2 3)))
(print (subseq #(a b c d) 1 3))
(print (elt '(x y z) 2))

(print (append '(1 2) '(3) nil '(4 5)))
(print (nconc (list 1 2) (list 3)))
(print (member 3 '(1 2 3 4)))
(print (assoc 'b '((a . 1) (b . 2))))
(print (mapcar #'car '((1 2) (3 4))))
(print (mapcar #'+ '(1 2 3) '(10 20 30)))
(print (last '(1 2 3)))
(print (copy-list '(1 2 3)))
(print (equal '(1 "two" (#\3)) (list 1 "two" (list #\3))))
(print (equal "a" "b"))

;; Primitives are real functions now.
(print (funcall #'cons 1 2))
(print (apply #'+ 1 2 '(3 4)))
(print (apply #'max '(3 9 2)))
(print (funcall 'list 1 2 3))
(print (< 1 2 3 4))
(print (< 1 3 2))
(print (/= 1 2 3))
(print (/= 1 2 1))

;; Symbols.
(print (symbol-name 'kiln))
(print (keywordp :key))
(print (keywordp 'key))
(print :key)
(setf (get 'kiln 'color) 'orange)
(print (get 'kiln 'color))
(print (get 'kiln 'size 'unknown))
(setf (get 'kiln 'color) 'red)
(print (symbol-plist 'kiln))
