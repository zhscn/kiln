;; Boxed doubles and ratios move with the GC.
(let ((l (list (/ 1 7) (* 1.5d0 3) (/ (expt 10 30) 7))))
  (%gc)
  (print l))

(let* ((scale (ash 1 128))
       (a (/ 1 (* 3 scale)))
       (b (/ 1 (* 5 scale)))
       (sum (+ a b))
       (difference (- b a)))
  (assert (= (numerator sum) 1))
  (assert (= (denominator sum) (* 15 (ash 1 125))))
  (assert (= (numerator difference) -1))
  (assert (= (denominator difference) (* 15 (ash 1 127))))
  (assert (eql (- a a) 0)))

(let* ((scale (ash 1 128))
       (a (/ (* 3 scale) 7))
       (b (/ (* -5 scale) 14)))
  (assert (eql (* (/ 7 scale) (/ (- scale) 7)) -1))
  (assert (eql (/ a b) -6/5))
  (assert (eql (/ 0 b) 0)))

(let ((ratio 1) (a 1) (b 1))
  (dotimes (i 149)
    (declare (ignore i))
    (setf ratio (1+ (/ ratio)))
    (psetq a (+ a b) b a))
  (assert (= (numerator ratio) a))
  (assert (= (denominator ratio) b)))

(dolist (ratio (list 2/3 (/ (1+ (ash 1 100)) 2)))
  (assert (and (> ratio 0) (< 0 ratio) (not (= ratio 0))))
  (let ((negative (- ratio)))
    (assert (and (< negative 0) (> 0 negative) (not (= 0 negative))))))

(let ((value (- (/ 7 (ash 1 100)))))
  (assert (= (numerator (/ value)) (- (ash 1 100))))
  (assert (= (denominator (/ value)) 7))
  (assert (= (denominator (1+ value)) (ash 1 100)))
  (assert (= (numerator (- 1 value)) (+ (ash 1 100) 7))))

(let ((scale (ash 1 120)))
  (assert (eql (/ (/ 1 scale)) scale))
  (let ((result (/ (/ (+ scale 1) (+ scale 2)))))
    (assert (= (numerator result) (+ scale 2)))
    (assert (= (denominator result) (+ scale 1)))))

(let* ((denominator most-positive-fixnum)
       (ratio (/ 1 denominator))
       (integer most-negative-fixnum)
       (product (* integer denominator)))
  (assert (= (denominator (+ ratio integer)) denominator))
  (assert (= (numerator (+ ratio integer)) (1+ product)))
  (assert (= (numerator (- ratio integer)) (- 1 product)))
  (assert (= (numerator (- integer ratio)) (1- product))))

(let* ((denominator (1+ (ash 1 126)))
       (ratio (/ (1+ denominator) denominator)))
  (assert (= (numerator (- ratio 1)) 1))
  (assert (= (numerator (- 1 ratio)) -1))
  (assert (= (numerator (+ ratio 3)) (1+ (* 4 denominator))))
  (assert (= (denominator (+ ratio 3)) denominator)))

(dolist (pair '((3/2 2 -1/2) (5/2 2 1/2) (-3/2 -2 1/2) (-5/2 -2 -1/2)))
  (destructuring-bind (value quotient remainder) pair
    (assert (equal (multiple-value-list (round value)) (list quotient remainder)))))
(let* ((d (+ (ash 1 128) 1))
       (value (- (/ (+ d 1) d))))
  (assert (equal (multiple-value-list (truncate value)) (list -1 (- (/ d)))))
  (assert (equal (multiple-value-list (floor value)) (list -2 (/ (1- d) d))))
  (assert (equal (multiple-value-list (ceiling value)) (list -1 (- (/ d))))))

(let* ((tiny (/ (1+ (ash 1 2048))))
       (value (+ 7 tiny)))
  (assert (equal (multiple-value-list (truncate value -3)) (list -2 (+ 1 tiny))))
  (assert (equal (multiple-value-list (floor value -3)) (list -3 (+ -2 tiny))))
  (assert (equal (multiple-value-list (ceiling value -3)) (list -2 (+ 1 tiny))))
  (assert (equal (multiple-value-list (round value -3)) (list -2 (+ 1 tiny)))))
(assert (equal (multiple-value-list (round 3/2 3)) '(0 3/2)))
(assert (equal (multiple-value-list (round 9/2 3)) '(2 -3/2)))
