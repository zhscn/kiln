(in-package #:kiln.kir)

;;;; Indexed backend records. Program data is encoded without invoking
;;;; the Lisp printer or reader; IDs are local to this request.

(defun module-form (module)
  "The ordered declarations of MODULE, without modifying the builder."
  `(:module ,(kmodule-name module)
     (:init ,(kmodule-init module))
     ,@(when (kmodule-shared module)
         (list (cons :shared (reverse (kmodule-shared module)))))
     ,@(reverse (kmodule-imports module))
     ,@(reverse (kmodule-import-data module))
     ,@(reverse (kmodule-data module))
     ,@(reverse (kmodule-roots module))
     ,@(reverse (kmodule-funcs module))))

(defun packet-utf8 (string)
  (let ((bytes nil))
    (loop for c across string for n = (char-code c)
          do (cond ((< n #x80) (push n bytes))
                   ((< n #x800)
                    (push (logior #xc0 (ash n -6)) bytes)
                    (push (logior #x80 (logand n 63)) bytes))
                   ((or (<= #xd800 n #xdfff) (> n #x10ffff))
                    (error "Non-Unicode character in backend request."))
                   ((< n #x10000)
                    (push (logior #xe0 (ash n -12)) bytes)
                    (push (logior #x80 (logand (ash n -6) 63)) bytes)
                    (push (logior #x80 (logand n 63)) bytes))
                   (t
                    (push (logior #xf0 (ash n -18)) bytes)
                    (push (logior #x80 (logand (ash n -12) 63)) bytes)
                    (push (logior #x80 (logand (ash n -6) 63)) bytes)
                    (push (logior #x80 (logand n 63)) bytes))))
    (nreverse bytes)))

(defun encode-backend-packet (program &optional (language +packet-kir-payload+))
  "A simple vector of octets, using the backend packet's fixed-width schema."
  (let ((records nil) (record-count 0) (edges nil) (edge-count 0)
        (strings nil) (string-count 0))
    (labels ((text (string tag)
               (let* ((bytes (packet-utf8 string))
                      (length (length bytes))
                      (offset string-count))
                 (incf string-count length)
                 (dolist (byte bytes) (push byte strings))
                 (list tag offset length)))
             (node (form depth)
               (when (> depth +packet-max-depth+)
                 (error "Backend request nesting limit exceeded."))
               (let ((record
                       (cond ((null form) (list +packet-list+ edge-count 0))
                             ((integerp form)
                              (unless (<= (- (ash 1 63)) form (1- (ash 1 63)))
                                (error "Backend integer is outside signed 64-bit range."))
                              (list +packet-integer+ 0 form))
                             ((keywordp form)
                              (text (string-downcase (symbol-name form)) +packet-symbol+))
                             ((stringp form) (text form +packet-string+))
                             ((simple-vector-p form)
                              (text (kir-name (string (svref form 0)) (svref form 1))
                                    +packet-symbol+))
                             ((consp form)
                              (let* ((children (mapcar (lambda (x) (node x (1+ depth))) form))
                                     (offset edge-count))
                                (incf edge-count (length children))
                                (dolist (child children) (push child edges))
                                (list +packet-list+ offset (length children))))
                             (t (error "Unsupported backend record ~S." form)))))
                 (when (> (+ +packet-header-size+ (* +packet-record-size+ (1+ record-count))
                             (* 4 edge-count) string-count) +packet-max-bytes+)
                   (error "Backend request size limit exceeded."))
                 (push record records)
                 (prog1 record-count (incf record-count)))))
      (let* ((root (node program 1))
             (total (+ +packet-header-size+ (* +packet-record-size+ record-count)
                       (* 4 edge-count) string-count))
             (out (make-array total :initial-element 0))
             (position 0))
        (labels ((uint (value size)
                   (dotimes (i size)
                     (setf (svref out position) (ldb (byte 8 (* 8 i)) value))
                     (incf position))))
          (dolist (byte '(75 73 76 78 76 73 82 0)) (uint byte 1))
          (dolist (value (list +packet-major+ +packet-minor+ language 0)) (uint value 4))
          (uint +backend-target-fingerprint+ 8)
          (uint total 8)
          (dolist (value (list record-count edge-count string-count root)) (uint value 4))
          (uint 0 8)
          (dolist (record (nreverse records))
            (uint (first record) 4) (uint (second record) 4) (uint (third record) 8))
          (dolist (edge (nreverse edges)) (uint edge 4))
          (dolist (byte (nreverse strings)) (uint byte 1)))
        out))))

(defun module-packet (module)
  (encode-backend-packet (module-form module)))

(defun write-module-packet (module stream)
  "Writes the same bytes used by the in-memory backend entry point."
  (map nil (lambda (byte) (write-byte byte stream)) (module-packet module)))
