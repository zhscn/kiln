(in-package #:kiln.kir)

(defun module-symbol-roots (data)
  "Declare the mutable fields of a static symbol for GC and images."
  (push `(:symbol-roots ,data ,+packet-field-symbol-package+ ,+packet-field-symbol-function+
                        ,+packet-field-symbol-value+ ,+packet-field-symbol-tls-index+
                        ,+packet-field-symbol-plist+ ,+packet-field-symbol-setf-function+)
        (kmodule-roots *module*)))

(defun module-cons-car-root (data)
  "Declare the car of a static cons as a GC root."
  (push `(:field-root ,data ,+packet-field-cons-car+) (kmodule-roots *module*)))

;;;; Indexed backend records. Program data is encoded without invoking
;;;; the Lisp printer or reader; IDs are local to this request.

(defun module-form (module)
  "The ordered declarations of MODULE, without modifying the builder."
  `(:module ,(kmodule-name module)
     (:init ,(kmodule-init module))
     ,@(when (kmodule-shared module)
         (list (cons :shared (reverse (kmodule-shared module)))))
     ,@(reverse (kmodule-imports module))
     ,@(reverse (kmodule-import-data module))
     ,@(reverse (kmodule-data module))
     ,@(reverse (kmodule-roots module))
     ,@(reverse (kmodule-funcs module))))

(defun packet-utf8 (string)
  (let ((bytes nil))
    (loop for c across string for n = (char-code c)
          do (cond ((< n #x80) (push n bytes))
                   ((< n #x800)
                    (push (logior #xc0 (ash n -6)) bytes)
                    (push (logior #x80 (logand n 63)) bytes))
                   ((or (<= #xd800 n #xdfff) (> n #x10ffff))
                    (error "Non-Unicode character in backend request."))
                   ((< n #x10000)
                    (push (logior #xe0 (ash n -12)) bytes)
                    (push (logior #x80 (logand (ash n -6) 63)) bytes)
                    (push (logior #x80 (logand n 63)) bytes))
                   (t
                    (push (logior #xf0 (ash n -18)) bytes)
                    (push (logior #x80 (logand (ash n -12) 63)) bytes)
                    (push (logior #x80 (logand (ash n -6) 63)) bytes)
                    (push (logior #x80 (logand n 63)) bytes))))
    (nreverse bytes)))

(defun packet-symbol-name (symbol)
  "Backend identifiers use ASCII case normalization, independent of locale."
  (map 'string (lambda (c)
                 (let ((n (char-code c)))
                   (if (<= 65 n 90) (code-char (+ n 32)) c)))
       (symbol-name symbol)))

(defun portable-backend-packet (program &optional (language +packet-kir-payload+) stream)
  "Encodes PROGRAM to STREAM, or returns its octets in a simple vector."
  (let ((records nil) (record-count 0) (edges nil) (edge-count 0)
        (strings nil) (string-count 0) (atoms (make-hash-table :test 'equal))
        (expanded-strings 0))
    (labels ((text (string tag)
               (let* ((bytes (packet-utf8 string))
                      (length (length bytes))
                      (offset string-count))
                 (incf string-count length)
                 (dolist (byte bytes) (push byte strings))
                 (list tag offset length)))
             (node (form depth)
               (when (> depth +packet-max-depth+)
                 (error "Backend request nesting limit exceeded."))
               (let* ((tag (cond ((null form) +packet-list+) ((integerp form) +packet-integer+)
                                 ((or (symbolp form) (simple-vector-p form)) +packet-symbol+)
                                 ((stringp form) +packet-string+)))
                      (value (cond ((symbolp form) (and form (packet-symbol-name form)))
                                   ((simple-vector-p form)
                                    (kir-name (string (svref form 0)) (svref form 1)))
                                   (t form)))
                      (key (and tag (cons tag value))))
                 (when key
                   (multiple-value-bind (entry found) (gethash key atoms)
                     (when found
                       (incf expanded-strings (cdr entry))
                       (return-from node (car entry)))))
                 (let* ((record
                          (cond ((null form) (list +packet-list+ edge-count 0))
                                ((integerp form)
                                 (unless (<= (- (ash 1 63)) form (1- (ash 1 63)))
                                   (error "Backend integer is outside signed 64-bit range."))
                                 (list +packet-integer+ 0 form))
                                ((or (symbolp form) (stringp form) (simple-vector-p form))
                                 (text value tag))
                                ((consp form)
                                 (let* ((children (mapcar (lambda (x) (node x (1+ depth))) form))
                                        (offset edge-count))
                                   (incf edge-count (length children))
                                   (dolist (child children) (push child edges))
                                   (list +packet-list+ offset (length children))))
                                (t (error "Unsupported backend record ~S." form))))
                        (string-bytes (if (or (eql tag +packet-symbol+) (eql tag +packet-string+))
                                          (third record) 0)))
                   (when (> (+ +packet-header-size+ (* +packet-record-size+ (1+ record-count))
                               (* 4 edge-count) string-count) +packet-max-bytes+)
                     (error "Backend request size limit exceeded."))
                   (when key (setf (gethash key atoms) (cons record-count string-bytes)))
                   (incf expanded-strings string-bytes)
                   (push record records)
                   (prog1 record-count (incf record-count))))))
      (let* ((root (node program 1))
             (total (+ +packet-header-size+ (* +packet-record-size+ record-count)
                       (* 4 edge-count) string-count))
             (out (unless stream (make-array total :initial-element 0)))
             (position 0))
        (when (> (+ (* +packet-expansion-record-bytes+ (+ record-count edge-count))
                    string-count expanded-strings) +packet-max-expanded-bytes+)
          (error "Backend request expansion limit exceeded."))
        (labels ((uint (value size)
                   (dotimes (i size)
                     (let ((octet (ldb (byte 8 (* 8 i)) value)))
                       (if stream (write-byte octet stream) (setf (svref out position) octet)))
                     (incf position))))
          (dolist (byte '(75 73 76 78 76 73 82 0)) (uint byte 1))
          (dolist (value (list +packet-major+ +packet-minor+ language 0)) (uint value 4))
          (uint +backend-target-fingerprint+ 8)
          (uint total 8)
          (dolist (value (list record-count edge-count string-count root)) (uint value 4))
          (uint 0 8)
          (dolist (record (nreverse records))
            (uint (first record) 4) (uint (second record) 4) (uint (third record) 8))
          (dolist (edge (nreverse edges)) (uint edge 4))
          (dolist (byte (nreverse strings)) (uint byte 1)))
        out))))

(defun encode-backend-packet (program &optional (language +packet-kir-payload+))
  #+kiln
  (let ((bytes (kiln.sys:%primop :encode-packet program language)))
    (unless bytes (error "Cannot encode backend program."))
    (return-from encode-backend-packet bytes))
  #-kiln (portable-backend-packet program language))

(defun module-packet (module &optional literals)
  "Returns the independent program packet and its complete literal bindings."
  (multiple-value-bind (program bindings) (normalize-lir-module module literals)
    (values (encode-backend-packet program +packet-lir-payload+) bindings)))

(defun write-module-packet (module stream)
  "Writes the program's canonical binary encoding to STREAM."
  (multiple-value-bind (program literals) (normalize-lir-module module)
    (unless (zerop (length literals))
      (error "File module requires external literal bindings."))
    #+kiln
    (when (kiln.sys::%write-backend-packet program stream)
      (return-from write-module-packet module))
    (portable-backend-packet program +packet-lir-payload+ stream))
  module)
