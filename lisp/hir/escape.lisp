                            (member (hir-node-b node) '(:tail-funcall :tail-funcall-function)))
                   (setf tail-call t))
                 (hir-map-escape-children #'walk node)))
        (hir-map-function #'walk fun))
      (and (not tail-call)
           (hir-cons-extent-proof fun (hir-fun-body fun) (hir-cons-borrow-variables fun)
                                 rest (list 8192) nil nil nil 'list)))))

(defun hir-prepare-stack-rests (root)
  (hir-prepare-function-storage root #'hir-stack-rest-p))
