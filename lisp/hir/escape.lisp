(in-package #:kiln.compiler)

(defun hir-map-escape-children (function node)
  (case (hir-node-kind node)
    ((6 24) nil)
    (7 (when (hir-node-p (hir-node-a node)) (funcall function (hir-node-a node)))
       (loop for arg across (hir-node-b node) do (funcall function arg)))
    (13 (funcall function (hir-node-b node)))
    (otherwise (hir-map-children function node))))

(defun hir-cons-borrow-call-p (fun summary count)
  (and summary (>= count (length (hir-lambda-list-required (hir-fun-lambda-list fun))))
       (or (<= count (length summary)) (hir-lambda-list-rest (hir-fun-lambda-list fun))
           (hir-lambda-list-key-p (hir-fun-lambda-list fun)))))

(defun hir-cons-borrow-parameters (fun)
  (let* ((ll (hir-fun-lambda-list fun)) (required (hir-lambda-list-required ll))
         (optional (hir-lambda-list-optional ll)))
    (if (zerop (length optional)) required
        (concatenate 'simple-vector required
                     (map 'simple-vector (lambda (parameter) (svref parameter 0)) optional)))))

(defun hir-cons-borrow-defaults (fun)
  (let* ((ll (hir-fun-lambda-list fun)) (optional (hir-lambda-list-optional ll))
         (keys (hir-lambda-list-keys ll)))
    (if (zerop (length keys)) optional (concatenate 'simple-vector optional keys))))

(defun hir-cons-borrow-variables (fun)
  (let* ((ll (hir-fun-lambda-list fun)) (parameters (hir-cons-borrow-parameters fun))
         (key-parameters (hir-lambda-list-keys ll))
         (keys (if (zerop (length key-parameters)) #()
                   (map 'simple-vector (lambda (parameter) (svref parameter 0)) key-parameters)))
         (supplied (loop for parameter across (hir-cons-borrow-defaults fun)
                         when (svref parameter 2) collect (svref parameter 2)))
         (rest (hir-lambda-list-rest ll)))
    (if (or (plusp (length keys)) supplied rest)
        (concatenate 'simple-vector parameters keys supplied (when rest (list rest)))
        parameters)))

(defun hir-cons-extent-proof (fun body variables var budget borrows &optional binding result-mode (object-type 'cons))
  "Return success and primary aliasing; RESULT-MODE :ONLY skips escape checks.
OBJECT-TYPE selects declaration checks and identity uses: functions can be
invoked, and lists retain their identity through tail projections."
  (let ((eligible (make-hash-table :test #'eq)) (aliases (make-hash-table :test #'eq))
        (returns (make-hash-table :test #'eq)) (sources nil) (blocks nil) (visible nil) (returned nil))
    (loop for v across variables do (setf (gethash v eligible) t))
    (setf (gethash var aliases) t)
    (block proof
      (labels ((fail () (return-from proof nil))
               (tick () (when (minusp (decf (car budget))) (fail)))
               (catalog (node)
                 (tick)
                 (case (hir-node-kind node)
                   (2 (push (cons (hir-node-a node) (hir-node-b node)) sources))
                   (11 (loop for v across (hir-node-a node) for init across (hir-node-b node)
                             do (setf (gethash v eligible) t)
                                (unless (hir-node-d node) (push (cons v init) sources))))
                   (15 (push (hir-node-b node) (gethash (hir-node-a node) returns))))
                 (hir-map-escape-children #'catalog node))
               (known-cons (node)
                 (or (eq (hir-node-type node) 'cons)
                     (and (= (hir-node-kind node) 1) (eq (hir-node-a node) var)
                          (not (logtest 1 (hir-var-flags var))))))
               (tainted (node)
                 (tick)
                 (case (hir-node-kind node)
                   (1 (gethash (hir-node-a node) aliases))
                   ((2 4 23) (tainted (hir-node-b node)))
                   (9 (or (tainted (hir-node-b node)) (tainted (hir-node-c node))))
                   (10 (let ((forms (hir-node-a node)))
                         (and (plusp (length forms)) (tainted (svref forms (1- (length forms)))))))
                   ((11 12 25) (tainted (hir-node-c node)))
                   (13 (tainted (hir-node-b node)))
                   (14 (or (tainted (hir-node-b node))
                           (some #'tainted (gethash (hir-node-a node) returns))))
                   ((20 22) (tainted (hir-node-a node)))
                   (18 (tainted (hir-node-b node)))
                   (7 (let* ((name (hir-node-a node)) (args (hir-node-b node))
                             (primitive (not (eq (hir-node-d node) :notinline)))
                             (local (and borrows (hir-fun-p name) (gethash name borrows))))
                        (cond ((and primitive (member name '(rplaca rplacd values)))
                               (and (plusp (length args)) (tainted (svref args 0))))
                              ;; Field projections rely on rejecting stores of this identity below.
                              ((and primitive (eq object-type 'list) (member name '(cdr rest)))
                               (and (plusp (length args)) (tainted (svref args 0))))
                              ((and primitive (member name '(car cdr first rest consp listp atom null not eq eql cons list vector))) nil)
                              ((hir-cons-borrow-call-p name local (length args))
                               (loop for arg across args for state across local
                                     thereis (and (not (eq state :borrow)) (tainted arg))))
                              (t (some #'tainted args)))))
                   (otherwise nil)))
               (check-use (node usage)
                 (tick)
                 ;; Generic control lowering can still preserve discarded values.
                 (when (and (eq usage :effect) (not (member (hir-node-kind node) '(7 9 10 11 20 22))))
                   (setf usage :discard))
                 (when (and (member usage '(:escape :result)) (tainted node))
                   (when (eq usage :escape) (fail))
                   (when (eq usage :result) (setf returned t)))
                 (case (hir-node-kind node)
                   ((0 5) nil)
                   ((6 24) (when visible (fail)))
                   (17 (when (and visible (not (eq (hir-exit-owner (hir-node-a node)) fun))) (fail)))
                   (3 (when visible (fail)))
                   (1 (when (and visible (or (hir-node-c node)
                                             (eq (hir-node-type node) 'double-float))) (fail))
                      (when (and (gethash (hir-node-a node) aliases) (hir-node-b node)
                                 (not (hir-declaration-proven-p object-type (hir-node-b node)))) (fail)))
                   (2 (when (and visible
                                 (or (eq (hir-node-type (hir-node-b node)) 'double-float)
                                     (eq (hir-declaration-type (hir-var-type (hir-node-a node))) 'double-float))) (fail))
                      (when (and visible
                                 (not (hir-declaration-proven-p (hir-node-type (hir-node-b node))
                                                              (hir-var-type (hir-node-a node))))
                                 (not (eq (hir-var-type (hir-node-a node)) t))) (fail))
                      (check-use (hir-node-b node) (if (gethash (hir-node-a node) eligible) :flow :escape)))
                   (4 (when visible (fail)) (check-use (hir-node-b node) :escape))
                   (7
                    (let* ((name (hir-node-a node)) (args (hir-node-b node)) (count (length args))
                           (primitive (not (eq (hir-node-d node) :notinline)))
                           (borrow (and primitive (or (and (= count 1)
                                                          (member name (if (eq object-type 'function)
                                                                           '(consp listp atom null not)
                                                                           '(car cdr first rest consp listp atom null not))))
                                       (and (= count 2) (member name '(eq eql))))))
                           (mutate (and primitive (not (eq object-type 'function))
                                        (= count 2) (member name '(rplaca rplacd))))
                           (local-borrows (and borrows (hir-fun-p name) (gethash name borrows))))
                      (when (and primitive (eq name 'values))
                        ;; Other value counts may be saved in a heap list.
                        (when (and visible (/= count 1) (not (eq usage :effect))) (fail))
                        (loop for arg across args for i from 0
                              do (check-use arg (cond ((eq usage :effect) :effect)
                                                      ((and (= count 1) (zerop i)) usage)
                                                      (t :escape))))
                        (return-from check-use nil))
                      (when (and visible
                                 (not (or (and borrow (member name '(consp listp atom null not eq)))
                                          (and primitive (eq name 'eql) (= count 2)
                                               (or (member (hir-node-type (svref args 0))
                                                           '(cons symbol null character function simple-vector :native-string))
                                                   (hir-fixnum-type-p (hir-node-type (svref args 0)))))
                                          (and (or borrow mutate)
                                               (known-cons (svref args 0))))))
                        (fail))
                      (when (hir-node-p name) (check-use name (if (eq object-type 'function) :borrow :escape)))
                      (loop for arg across args for i from 0
                            do (check-use arg (if (or borrow (and mutate (zerop i))
                                                  (and (hir-cons-borrow-call-p name local-borrows count)
                                                       (< i (length local-borrows))
                                                       (svref local-borrows i))) :borrow :escape)))))
                   (8 (when visible (fail)) (loop for arg across (hir-node-a node) do (check-use arg :escape)))
                   (9 (check-use (hir-node-a node) :borrow)
                      (check-use (hir-node-b node) usage) (check-use (hir-node-c node) usage))
                   (10 (let ((forms (hir-node-a node)))
                         (loop for form across forms for i from 0
                               do (check-use form (if (= i (1- (length forms))) usage :effect)))))
                   (11 (when (and visible (some (lambda (v) (logtest 4 (hir-var-flags v))) (hir-node-a node))) (fail))
                       (loop for v across (hir-node-a node) for init across (hir-node-b node)
                             do (when (and visible (not (eq (hir-var-type v) t))
                                           (not (hir-declaration-proven-p (hir-node-type init) (hir-var-type v)))) (fail))
                                (check-use init (if (and (not (hir-node-d node)) (gethash v eligible)) :flow :escape)))
                       (check-use (hir-node-c node) usage))
                   (12 (when visible (fail)) (check-use (hir-node-b node) :escape) (check-use (hir-node-c node) usage))
                   (13 (when visible (fail)) (check-use (hir-node-b node) usage))
                   (14 (push (cons (hir-node-a node) usage) blocks)
                       (check-use (hir-node-b node) usage) (pop blocks))
                   (15 (when (and visible (not (eq (hir-exit-owner (hir-node-a node)) fun))) (fail))
                       (check-use (hir-node-b node) (or (cdr (assoc (hir-node-a node) blocks :test #'eq)) :escape)))
                   (16 (when visible (fail)) (loop for segment across (hir-node-a node) do (check-use (cdr segment) :effect)))
                   (18 (check-use (hir-node-a node) :borrow) (check-use (hir-node-b node) usage))
                   (19 (when visible (fail)) (check-use (hir-node-a node) :escape) (check-use (hir-node-b node) :escape))
                   (20 (check-use (hir-node-a node) usage) (check-use (hir-node-b node) :effect))
                   (21 (when visible (fail)) (check-use (hir-node-a node) :escape)
                       (loop for arg across (hir-node-b node) do (check-use arg :escape)))
                   (22 (check-use (hir-node-a node) usage) (check-use (hir-node-b node) :effect))
                   (23 (when (and (tainted (hir-node-b node))
                                  (not (hir-declaration-proven-p object-type (hir-node-a node)))) (fail))
                       (when (and visible (not (eq (hir-node-a node) t))
                                  (not (hir-declaration-proven-p (hir-node-type (hir-node-b node)) (hir-node-a node)))) (fail))
                       (check-use (hir-node-b node) usage))
                   (25 (when visible (fail)) (check-use (hir-node-a node) :escape) (check-use (hir-node-b node) :escape)
                       (check-use (hir-node-c node) usage))
                   (otherwise (fail)))))
        (catalog body)
        (unless binding
          (loop for parameter across (hir-cons-borrow-defaults fun)
                do (catalog (svref parameter 1))
                   (push (cons (svref parameter 0) (svref parameter 1)) sources)))
        ;; May-alias propagation includes every lexical write. A value
        ;; may leave this binding only through one of the inspected uses.
        (loop with changed = t while changed
              do (setf changed nil)
                 (dolist (source sources)
                   (when (and (tainted (cdr source)) (not (gethash (car source) aliases)))
                     (unless (or (eq result-mode :only) (gethash (car source) eligible)) (fail))
                     (setf (gethash (car source) aliases) t changed t))))
        (when (eq result-mode :only)
          (return-from proof (values t (tainted body))))
        (maphash (lambda (alias value)
                   (declare (ignore value))
                   (when (source-variable-name alias) (setf visible t))
                   (when (or (logtest 2 (hir-var-flags alias))
                             (not (or (eq (hir-var-type alias) t)
                                      (hir-declaration-proven-p object-type (hir-var-type alias)))))
                     (fail))) aliases)
        (when (and (null binding) visible)
          ;; Rest and keyword entries can allocate and poll after positional bindings.
          (when (or (hir-lambda-list-rest (hir-fun-lambda-list fun))
                    (hir-lambda-list-key-p (hir-fun-lambda-list fun))) (fail))
          (when (> (+ (length (hir-cons-borrow-parameters fun)) (length (hir-lifted-environment fun))) +reg-args+) (fail))
          (loop for v across variables
                when (or (logtest 4 (hir-var-flags v))
                         (and (not (eq v var)) (not (eq (hir-var-type v) t))))
                  do (fail)))
        (when (and binding visible)
          (loop for v across variables for init across (hir-node-b binding)
                when (or (logtest 4 (hir-var-flags v))
                         (and (not (eq (hir-var-type v) t))
                              (not (hir-declaration-proven-p (hir-node-type init) (hir-var-type v)))))
                  do (fail)))
        (unless binding
          (loop for parameter across (hir-cons-borrow-defaults fun)
                do (check-use (svref parameter 1) :flow)))
        (check-use body (if result-mode :result :escape))
        (values t returned)))))

(defun hir-stack-cons-candidates (fun &optional borrows)
  "Prove cons identities remain within the binding that creates each one."
  (let ((candidates nil) (budget (list 8192)) (tail-call nil))
    (labels ((walk (node)
               (when (and (= (hir-node-kind node) 8)
                          (member (hir-node-b node) '(:tail-funcall :tail-funcall-function)))
                 (setf tail-call t))
               (when (and (= (hir-node-kind node) 11) (not (hir-node-d node)))
                 (loop for var across (hir-node-a node) for init across (hir-node-b node)
                       when (and (plusp (car budget)) (< (length candidates) 16)
                                 (hir-policy-optimize-p (hir-node-policy init))
                                 (hir-policy-optimize-p (hir-var-policy var))
                                 (= (hir-node-kind init) 7) (eq (hir-node-a init) 'cons)
                                 (= (length (hir-node-b init)) 2)
                                 (not (eq (hir-node-d init) :notinline))
                                 (or (eq (hir-var-type var) t) (hir-declaration-proven-p 'cons (hir-var-type var)))
                                 (hir-cons-extent-proof fun (hir-node-c node) (hir-node-a node) var budget borrows node)) do (push init candidates)))
               (hir-map-escape-children #'walk node)))
      (hir-map-function #'walk fun))
    (unless tail-call (nreverse candidates))))

(defun hir-cons-borrow-summaries (functions)
  "Infer nonretaining cons parameters and their primary result aliases."
  (let ((summaries (make-hash-table :test #'eq)) (budget (list 65536)))
    (dolist (fun functions)
      (let ((ll (hir-fun-lambda-list fun)))
        (when (and ll (hir-fun-body fun) (null (hir-fun-parameter-specials fun)))
          (setf (gethash fun summaries)
                (make-array (length (hir-cons-borrow-parameters fun)) :initial-element :borrow)))))
    ;; Primary aliases grow from empty assumptions. Starting from "may return"
    ;; would lose field-only results in recursive groups.
    (loop with changed = t while changed
          do (setf changed nil)
             (dolist (fun functions)
               (let ((summary (gethash fun summaries)))
                 (when summary
                   (let ((parameters (hir-cons-borrow-parameters fun))
                         (variables (hir-cons-borrow-variables fun)))
                     (loop for var across parameters for i from 0
                           unless (eq (svref summary i) :return)
                             do (when (nth-value 1 (hir-cons-extent-proof fun (hir-fun-body fun) variables
                                                                       var budget summaries nil :only))
                                  (setf (svref summary i) :return changed t))
                           do (when (minusp (car budget)) (return-from hir-cons-borrow-summaries nil))))))))
    ;; Then retract any retaining parameter. Projections remain fixed, and no
    ;; provisional borrowing assumption is used for allocation decisions.
    (loop with changed = t while changed
          do (setf changed nil)
             (dolist (fun functions)
               (let ((summary (gethash fun summaries)))
                 (when summary
                   (let ((parameters (hir-cons-borrow-parameters fun))
                         (variables (hir-cons-borrow-variables fun)))
                     (loop for var across parameters for i from 0
                           when (svref summary i)
                             do (multiple-value-bind (safe returned)
                                    (hir-cons-extent-proof fun (hir-fun-body fun) variables
                                                          var budget summaries nil :allow)
                                  (unless (and safe (or (eq (svref summary i) :return) (not returned)))
                                    (setf (svref summary i) nil changed t)))
                           do (when (minusp (car budget)) (return-from hir-cons-borrow-summaries nil))))))))
    summaries))

(defun hir-prepare-stack-conses (root)
  (let ((plans (make-hash-table :test #'eq)) (seen (make-hash-table :test #'eq)) (functions nil)
        (cons-bindings nil) (local-calls nil) (owner nil) (repeated-depth 0)
        (cons-owners (make-hash-table :test #'eq))
        (graph-owners (make-hash-table :test #'eq)))
    (labels ((function-tree (fun)
               (unless (gethash fun seen)
                 (setf (gethash fun seen) t)
                 (push fun functions)
                 (let ((saved owner) (saved-depth repeated-depth))
                   (setf owner fun repeated-depth 0)
                   (hir-map-function #'walk fun)
                   (setf owner saved repeated-depth saved-depth))))
             (walk (node)
               (when (and (= (hir-node-kind node) 11) (not (hir-node-d node))
                          (some (lambda (init) (and (= (hir-node-kind init) 7)
                                                    (eq (hir-node-a init) 'cons)
                                                    (= (length (hir-node-b init)) 2)))
                                (hir-node-b node)))
                 (setf cons-bindings t (gethash owner cons-owners) t)
                 (when (zerop repeated-depth) (setf (gethash owner graph-owners) t)))
               (when (and (= (hir-node-kind node) 7) (hir-fun-p (hir-node-a node)))
                 (setf local-calls t))
               (case (hir-node-kind node)
                 ((6 7) (let ((owned (hir-own-function node))) (when owned (function-tree owned)))
                        (when (hir-node-p (hir-node-a node)) (walk (hir-node-a node)))
                        (when (= (hir-node-kind node) 7) (loop for arg across (hir-node-b node) do (walk arg))))
                 (13 (loop for fun across (hir-node-a node) do (function-tree fun)) (walk (hir-node-b node)))
                 (16 (incf repeated-depth) (hir-map-children #'walk node) (decf repeated-depth))
                 (24 (function-tree (hir-node-a node)))
                 (otherwise (hir-map-children #'walk node)))))
      (function-tree root))
    (unless cons-bindings (return-from hir-prepare-stack-conses plans))
    (setf functions (nreverse functions))
    (let ((borrows (and local-calls (hir-cons-borrow-summaries functions))))
      (dolist (fun functions)
        (when (and (gethash fun cons-owners) (hir-policy-optimize-p (hir-fun-policy fun)))
          (let ((graph (and (gethash fun graph-owners) (hir-stack-cons-graph fun)))
                (single (hir-stack-cons-candidates fun borrows)))
            (unless (every (lambda (node) (hir-policy-optimize-p (hir-node-policy node))) graph)
              (setf graph nil))
            (setf (gethash fun plans)
                  (append graph (remove-if (lambda (node) (member node graph :test #'eq)) single)))))))
    plans))

(defun hir-stack-cons-graph (fun)
  "Select cons graphs whose stack identities never enter a heap object."
  (let ((indices (make-hash-table :test #'eq)) (variables (make-hash-table :test #'eq))
        (returns (make-hash-table :test #'eq)) (objects nil) (owners nil)
        (node-owners (make-hash-table :test #'eq)) (seen (make-hash-table :test #'eq))
        (checked (make-hash-table :test #'eq)) (results (make-hash-table :test #'eq))
        (value-shapes (make-hash-table :test #'eq))
        (functions nil) (current fun) (repeated-depth 0)
        (budget 8192) (escaped 0) (effects nil) (changed nil) (fields nil) (mask 0))
    (block proof
      (labels ((fail () (return-from proof nil))
               (tick () (when (minusp (decf budget)) (fail)))
               (escape (value) (setf escaped (logior escaped (logand value mask))))
               (direct-values (node)
                 (and (= (hir-node-kind node) 7) (eq (hir-node-a node) 'values)
                      (not (eq (hir-node-d node) :notinline)) (hir-node-b node)))
               (values-shape-p (node)
                 (multiple-value-bind (shape found) (gethash node value-shapes)
                   (if found shape
                       (progn
                         (tick)
                         (setf (gethash node value-shapes)
                               (or (direct-values node)
                                   (case (hir-node-kind node)
                                     (9 (and (values-shape-p (hir-node-b node))
                                             (values-shape-p (hir-node-c node))))
                                     (11 (values-shape-p (hir-node-c node)))
                                     (10 (let ((forms (hir-node-a node)))
                                           (and (plusp (length forms))
                                                (values-shape-p (svref forms (1- (length forms))))))))))))))
               (callable (callee count &optional args)
                 (and (hir-fun-p callee) (not (eq callee fun))
                      (let ((ll (hir-fun-lambda-list callee)))
                        (and ll (hir-fun-body callee) (null (hir-fun-parameter-specials callee))
                             (>= count (length (hir-lambda-list-required ll)))
                             (or (hir-lambda-list-rest ll) (hir-lambda-list-key-p ll)
                                 (<= count (+ (length (hir-lambda-list-required ll))
                                              (length (hir-lambda-list-optional ll)))))
                             (or (not (hir-lambda-list-key-p ll))
                                 (let ((start (+ (length (hir-lambda-list-required ll))
                                                 (length (hir-lambda-list-optional ll)))))
                                   (or (<= count start)
                                       (and args (evenp (- count start))
                                            (loop for i from start below count by 2
                                                  for key = (svref args i)
                                                  always (and (= (hir-node-kind key) 0)
                                                              (find (hir-node-a key) (hir-lambda-list-keys ll)
                                                                    :key (lambda (p) (svref p 3)) :test #'eq)))))))))
                      (case (gethash callee checked)
                        (:yes t) (:no nil)
                        (otherwise
                         (let ((ok t))
                           (labels ((shape (node)
                                      (tick)
                                      (when (or (member (hir-node-kind node) '(21 25))
                                                (and (= (hir-node-kind node) 8)
                                                     (member (hir-node-b node) '(:tail-funcall :tail-funcall-function))))
                                        (setf ok nil))
                                      (hir-map-escape-children #'shape node)))
                             (hir-map-function #'shape callee))
                           (setf (gethash callee checked) (if ok :yes :no)) ok)))))
               (catalog-function (callee)
                 (unless (gethash callee seen)
                   (setf (gethash callee seen) t)
                   (push callee functions)
                   (unless (eq callee fun)
                     (loop for var across (hir-lambda-list-required (hir-fun-lambda-list callee))
                           do (setf (gethash var variables) (if (logtest 1 (hir-fun-flags callee)) 1 0)))
                     (loop for parameter in (append (coerce (hir-lambda-list-optional (hir-fun-lambda-list callee)) 'list)
                                                    (coerce (hir-lambda-list-keys (hir-fun-lambda-list callee)) 'list))
                           do (setf (gethash (svref parameter 0) variables)
                                    (if (logtest 1 (hir-fun-flags callee)) 1 0))
                              (when (svref parameter 2)
                                (setf (gethash (svref parameter 2) variables) 1)))
                     (let ((rest (hir-lambda-list-rest (hir-fun-lambda-list callee))))
                       (when rest (setf (gethash rest variables) 1))))
                   (let ((saved current) (saved-depth repeated-depth))
                     (setf current callee repeated-depth 0)
                     (hir-map-function #'catalog callee)
                     (setf current saved repeated-depth saved-depth))))
               (catalog (node)
                 (tick)
                 (setf (gethash node node-owners) current)
                 (case (hir-node-kind node)
                   ((21 25) (fail))
                   (8 (when (member (hir-node-b node) '(:tail-funcall :tail-funcall-function)) (fail)))
                   (11 (loop for var across (hir-node-a node) for i from 0
                             do (setf (gethash var variables)
                                      (if (and (hir-node-d node) (plusp i)
                                               (not (values-shape-p (svref (hir-node-b node) 0)))) 1 0)))
                       (when (and (eq current fun) (zerop repeated-depth) (not (hir-node-d node)))
                         (loop for var across (hir-node-a node) for init across (hir-node-b node)
                               when (and (= (hir-node-kind init) 7) (eq (hir-node-a init) 'cons)
