(defun hir-lexical-closure-initializer (node)
  (case (hir-node-kind node)
    (6 (hir-node-a node))
    (13 (let ((functions (hir-node-a node)) (value (hir-node-b node)))
          (when (and (= (length functions) 1) (= (hir-node-kind value) 6)
                     (eq (svref functions 0) (hir-node-a value)))
            (hir-node-a value))))))

(defun hir-stack-closure-candidates (fun)
  "Select lexical closure allocations whose identities stay in their binding."
  (unless (hir-policy-optimize-p (hir-fun-policy fun)) (return-from hir-stack-closure-candidates nil))
  (let ((candidates nil) (budget (list 8192)) (tail-call nil))
    (labels ((walk (node)
               (when (and (= (hir-node-kind node) 8)
                          (member (hir-node-b node) '(:tail-funcall :tail-funcall-function)))
                 (setf tail-call t))
               (when (and (= (hir-node-kind node) 11) (not (hir-node-d node)))
                 (loop for var across (hir-node-a node) for init across (hir-node-b node)
                       for closure = (hir-lexical-closure-initializer init)
                       when (and (plusp (car budget)) (< (length candidates) 16)
                                 (hir-policy-optimize-p (hir-node-policy init))
                                 (hir-policy-optimize-p (hir-var-policy var))
                                 closure
                                 (or (null (hir-fun-binding closure))
                                     (not (logtest 2 (hir-var-flags (hir-fun-binding closure)))))
                                 (plusp (length (hir-native-environment closure)))
                                 (not (hir-lifted-environment closure))
                                 (hir-cons-extent-proof fun (hir-node-c node) (hir-node-a node)
                                                       var budget nil node nil 'function))
                         do (push closure candidates)))
               (hir-map-escape-children #'walk node)))
      (hir-map-function #'walk fun))
    (unless tail-call (nreverse candidates))))

(defun hir-prepare-function-storage (root select)
  (let ((plans (make-hash-table :test #'eq)) (seen (make-hash-table :test #'eq)))
    (labels ((visit-function (fun)
               (unless (gethash fun seen)
                 (setf (gethash fun seen) t
                       (gethash fun plans) (funcall select fun))
                 (hir-map-function #'walk fun)))
             (walk (node)
               (case (hir-node-kind node)
                 ((6 7) (let ((child (hir-own-function node))) (when child (visit-function child))))
                 (13 (loop for child across (hir-node-a node) do (visit-function child)))
                 (24 (visit-function (hir-node-a node))))
               (hir-map-escape-children #'walk node)))
      (visit-function root))
    plans))

(defun hir-prepare-stack-closures (root)
  (hir-prepare-function-storage root #'hir-stack-closure-candidates))

(defun hir-stack-rest-p (fun)
  "Prove that every cons of the entry rest list stays in this invocation."
  (let* ((ll (hir-fun-lambda-list fun)) (rest (and ll (hir-lambda-list-rest ll)))
         (tail-call nil))
    (when (and rest (hir-policy-optimize-p (hir-fun-policy fun)) (not (hir-lambda-list-key-p ll))
               (null (hir-fun-parameter-specials fun)))
      (labels ((walk (node)
