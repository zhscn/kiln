(in-package #:kiln.compiler)

(defvar *hir-special-forms* (make-hash-table :test 'eq))

(defmacro define-hir-converter (name (parts environment) &body body)
  `(setf (gethash ',name *hir-special-forms*)
         (lambda (,parts ,environment) ,@body)))

(defun hir-arity (name parts min &optional (max min))
  (unless (hir-proper-list-p parts)
    (hir-error "~S requires a finite proper operand list, got ~S" name parts))
  (unless (and (>= (length parts) min) (or (null max) (<= (length parts) max)))
    (hir-error "~S expects ~D~@[ to ~D~] operands, got ~D" name min max (length parts))))

(defun hir-variable-name (form)
  (let ((name (hir-raw form)))
    (unless (and (symbolp name) name (not (eq name t)) (not (keywordp name)))
      (hir-error "Invalid variable name ~S" name))
    (when (typep (trucler:describe-variable *client* (hir-base-environment *environment*) name)
                 'trucler:constant-variable-description)
      (hir-error "Cannot bind or assign constant ~S" name))
    name))

(defun hir-function-name-p (name)
  (or (symbolp name)
      (and (consp name) (eq (car name) 'setf) (consp (cdr name))
           (symbolp (second name)) (null (cddr name)))))

(defun hir-convert-vector (forms environment)
  (map 'simple-vector (lambda (form) (hir-convert form environment)) forms))

(defun hir-progn (forms environment)
  (cond ((null forms) (hir-node 0 *hir-source* nil))
        ((null (cdr forms)) (hir-convert (car forms) environment))
        (t (hir-node 10 *hir-source* (hir-convert-vector forms environment)))))

(defun hir-convert-body (forms environment &optional documentation)
  (multiple-value-bind (body declarations) (hir-split-body forms documentation)
    (let ((*hir-policy* (hir-body-policy environment declarations))
          (*local-notinline* (append (loop for spec in declarations
                                         when (eq (car spec) 'notinline) append (cdr spec))
                                    *local-notinline*)))
      (hir-progn body (hir-declare environment declarations)))))

(defun hir-convert-symbol (name environment)
  (when (constant-symbol-p name)
    (return-from hir-convert-symbol (hir-node 0 *hir-source* name)))
  (multiple-value-bind (binding found) (hir-lookup environment name :var)
    (cond ((hir-var-p binding)
           (let ((type (hir-declared-variable-type environment binding)))
             (hir-node 1 *hir-source* (hir-note-ref binding) (unless (eq type t) type))))
          ((and found (eq (car binding) :symbol-macro))
           (hir-convert (invoke-macro-expander :symbol-macro
                           (lambda (form env) (declare (ignore form env)) (second binding))
                           name environment) environment))
          ((and found (eq (car binding) :special)) (hir-node 3 *hir-source* name))
          (t
           (let ((description (trucler:describe-variable *client* environment name)))
             (when (and (null description) (compiles-into-image-p *client*)
                        *referenced-variables* (not (gethash name *referenced-variables*)))
               (setf (gethash name *referenced-variables*) t)
               (warn 'undefined-variable-warning :name name))
             (cond ((typep description 'trucler:constant-variable-description)
                    (note-dependency :constant name)
                    (hir-node 0 *hir-source* (trucler:value description)))
                   ((typep description 'trucler:symbol-macro-description)
                    (hir-convert (invoke-macro-expander :symbol-macro
                                   (lambda (form env) (declare (ignore form env))
                                     (trucler:expansion description))
                                   name environment) environment))
                   ((or (null name) (eq name t) (keywordp name)) (hir-node 0 *hir-source* name))
                   (t (hir-node 3 *hir-source* name))))))))

(defun hir-note-form-sources (cst)
  (let ((table (make-hash-table :test 'eq))
        (seen (make-hash-table :test 'eq)))
    (labels ((walk (cst)
               (loop for tail = cst then (cst:rest tail)
                     while (cst:consp tail)
                     do (let ((raw (cst:raw tail)) (source (cst:source tail)))
                          (when (gethash raw seen) (return))
                          (setf (gethash raw seen) t)
                          (when (and (consp source) (integerp (car source))
                                     (integerp (cdr source)) (not (gethash raw table)))
                            (setf (gethash raw table)
                                  (hir-source-position *hir-file-id* (car source) (cdr source)))))
                        (walk (cst:first tail)))))
      (walk cst))
    table))

(defun hir-input-source (input)
  "The source position of INPUT, a CST or a plain form; else the enclosing one."
  (let ((source (and (typep input 'cst:cst) (cst:source input))))
    (cond ((and (consp source) (integerp (car source)) (integerp (cdr source)))
           (hir-source-position *hir-file-id* (car source) (cdr source)))
          ((consp (hir-raw input))
           (when (and (null *hir-form-sources*) *hir-top-cst*)
             (setf *hir-form-sources* (hir-note-form-sources *hir-top-cst*)))
           (or (and *hir-form-sources* (gethash (hir-raw input) *hir-form-sources*))
               *hir-source*))
          (t *hir-source*))))

(defvar *hir-step-recording* nil)
(defvar *hir-step-skip* nil)

(defun hir-convert (input environment)
  (let* ((*hir-conversion-depth* (1+ *hir-conversion-depth*))
         (*environment* environment)
         (*hir-source* (hir-input-source input))
         (form (hir-raw input)))
    (when (> *hir-conversion-depth* 10000) (hir-error "Excessive form or macro expansion nesting"))
    (when (consp form)
      (when (member (car form) '(kiln.sys::%step-body kiln.sys::%step-original kiln.sys::%step-quiet))
        (hir-arity (car form) (cdr form) 1)
        (let ((*hir-step-recording* (not (eq (car form) 'kiln.sys::%step-quiet)))
              (*hir-step-skip* (and (eq (car form) 'kiln.sys::%step-original) (second form))))
          (return-from hir-convert (hir-convert (second form) environment))))
      (when (and *hir-step-recording* (not (eq form *hir-step-skip*))
                 (not (gethash (car form) *hir-special-forms*))
                 (or (and (consp (car form)) (eq (caar form) 'lambda))
                     (and (symbolp (car form))
                          (not (typep (trucler:describe-function *client* environment (car form))
                                      '(or trucler:macro-description trucler:special-operator-description))))))
        (let ((*hir-step-recording* nil))
          (return-from hir-convert (hir-convert (step-call-form form) environment)))))
    (let ((*hir-step-skip* nil))
    (cond ((symbolp form) (hir-convert-symbol form environment))
          ((atom form) (hir-node 0 *hir-source* form))
          (t
           (let* ((parts (hir-parts input)) (op (hir-raw (first parts)))
                  (converter (gethash op *hir-special-forms*)))
             (when converter
               (return-from hir-convert (funcall converter (rest parts) environment)))
             (when (and (symbolp op) (special-operator-p op))
               (hir-error "Unsupported special operator ~S" op))
             (when (and (symbolp op) (inline-call-p *client* environment form))
               (note-dependency :inline (inline-call form))
               (return-from hir-convert
                 (hir-convert (inline-expansion form) environment)))
             (multiple-value-bind (expansion expanded) (compiler-macro-expansion *client* environment form)
               (when expanded
                 (let ((*compiler-macro-depth* (1+ *compiler-macro-depth*)))
                   (return-from hir-convert (hir-convert expansion environment)))))
             (when (and (symbolp op) (not (hir-fun-p (hir-lookup environment op :fun))))
               (multiple-value-bind (expansion expanded) (macroexpand-toplevel form)
                 (when expanded
                   (unless (nth-value 1 (hir-lookup environment op :fun)) (note-dependency :macro op))
                   (return-from hir-convert (hir-convert expansion environment)))))
             (hir-convert-call op (rest parts) environment)))))))

(defun hir-convert-call (name args environment)
  (let ((callee
          (cond ((symbolp name)
                 (or (hir-lookup environment name :fun)
                     (progn
                       (unless (or (gethash name *defined-functions*) (gethash name *primitives*)
                                   (trucler:describe-function *client* environment name))
                         (setf (gethash name *referenced-functions*) t))
                       name)))
                ((and (consp name) (eq (car name) 'lambda))
                 (hir-convert-lambda (cdr name) environment nil))
                (t (hir-error "Invalid function position ~S" name)))))
    (when (and *source-definition-calls* (symbolp callee))
      (pushnew callee (cdr *source-definition-calls*) :test #'equal))
    (when (hir-fun-p callee) (hir-note-call callee))
    (when (eq callee 'kiln.sys:%primop)
      (unless (and args (keywordp (hir-raw (first args))))
        (hir-error "%PRIMOP requires a literal keyword"))
      (unless (gethash (hir-raw (first args)) *primops*)
        (hir-error "Unknown primop ~S" (hir-raw (first args))))
      (return-from hir-convert-call
        (hir-node 8 *hir-source* (hir-convert-vector (rest args) environment) (hir-raw (first args)))))
    (let ((arguments (hir-convert-vector args environment)))
      (when (and (eq callee 'typep) (= (length arguments) 2)
                 (not (member callee *local-notinline*))
                 (= (hir-node-kind (svref arguments 1)) 0))
        (setf (hir-node-a (svref arguments 1))
              (hir-expand-type (hir-node-a (svref arguments 1)) environment)))
      (when (and (eq callee 'funcall) (plusp (length arguments)))
        (setf callee (let ((function (svref arguments 0)))
                       (if (member (hir-node-kind function) '(5 6)) (hir-node-a function) function))
              arguments (subseq arguments 1))
        (when (hir-fun-p callee)
          (decf (hir-fun-value-refs callee))
          (when (zerop (hir-fun-value-refs callee))
            (setf (hir-fun-flags callee) (logior 8 (logandc2 (hir-fun-flags callee) 1))))
          (hir-note-call callee)))
      (when (and *source-definition-calls* (hir-function-name-p callee))
        (pushnew callee (cdr *source-definition-calls*) :test #'equal))
      (let ((node (hir-node 7 *hir-source* callee arguments)))
        (when (member (if (hir-fun-p callee) (hir-fun-name callee) callee)
                      *local-notinline* :test #'equal)
          (setf (hir-node-d node) :notinline))
        (when (hir-fun-p callee) (setf (hir-fun-call-site callee) node))
        node))))

(define-hir-converter quote (parts environment)
  (declare (ignore environment))
  (hir-arity 'quote parts 1)
  (hir-node 0 *hir-source* (hir-raw (first parts))))

(define-hir-converter declare (parts environment)
  (declare (ignore parts environment))
  (hir-error "DECLARE is only valid at the beginning of a declaration scope"))

(define-hir-converter progn (parts environment) (hir-progn parts environment))

(define-hir-converter if (parts environment)
  (hir-arity 'if parts 2 3)
  (hir-node 9 *hir-source* (hir-convert (first parts) environment)
           (hir-convert (second parts) environment) (hir-convert (third parts) environment)))

(define-hir-converter setq (parts environment)
  (unless (evenp (length parts)) (hir-error "SETQ requires pairs of names and values"))
  (let ((forms (make-hir-buffer)))
    (loop for (name value) on parts by #'cddr
          for symbol = (hir-variable-name name)
          do (multiple-value-bind (expansion macro-p) (symbol-macro-expansion *client* environment symbol)
               (hir-push
                (if macro-p
                    (hir-convert `(setf ,expansion ,(hir-raw value)) environment)
                    (let ((binding (hir-lookup environment symbol :var)))
                      (if (hir-var-p binding)
                          (hir-node 2 *hir-source* (hir-note-ref binding t) (hir-convert value environment))
                          (hir-node 4 *hir-source* symbol (hir-convert value environment)))))
                forms)))
    (hir-node 10 *hir-source* (hir-vector forms))))

(defun hir-bindings (input)
  (mapcar (lambda (binding)
            (if (symbolp (hir-raw binding))
                (list (hir-variable-name binding) nil)
                (let ((parts (hir-parts binding)))
                  (hir-arity 'binding parts 1 2)
                  (list (hir-variable-name (first parts)) (second parts)))))
          (hir-parts input)))

(defun hir-convert-let (parts environment sequential &optional body-builder)
  "BODY-BUILDER receives body forms and the extended binding environment."
  (hir-arity (if sequential 'let* 'let) parts 1 nil)
  (let ((bindings (hir-bindings (first parts))))
    (unless sequential
      (let ((names (mapcar #'first bindings)))
        (unless (= (length names) (length (remove-duplicates names)))
          (hir-error "Duplicate LET binding"))))
    (multiple-value-bind (body declarations) (hir-split-body (rest parts))
      (let ((env environment) (variables (make-hir-buffer)) (initializers (make-hir-buffer))
            (specials '()))
        (dolist (binding bindings)
          (destructuring-bind (name init) binding
            (let* ((special (hir-special-binding-p name declarations environment))
                   (variable (hir-new-var (if special (gensym "SPECIAL") name)))
                   (initializer (hir-convert init (if sequential env environment))))
              (when (= (hir-node-kind initializer) 0)
                (setf (hir-var-constant variable) (hir-node-a initializer)
                      (hir-var-constant-p variable) t))
              (hir-push variable variables)
              (hir-push initializer initializers)
              (if special
                  (progn
                    (push (cons name variable) specials)
                    (setf env (hir-env env :vars (list (cons name '(:special))))))
                  (setf env (hir-env env :vars (list (cons name variable)))))
              (when sequential
                (setf env (hir-declare-binding env name declarations)
                      (hir-var-type variable) (hir-declared-variable-type env variable))))))
        ;; LET* dynamic bindings surround all subsequent initializers, so
        ;; construct their scopes as nested LET/BIND pairs.
        (let* ((*hir-policy* (hir-body-policy env declarations))
               (env (hir-declare env declarations))
               (*local-notinline* (append (loop for spec in declarations
                                               when (eq (car spec) 'notinline) append (cdr spec))
                                          *local-notinline*))
               (result (progn
                         (loop for var across (hir-vector variables)
                               do (setf (hir-var-type var) (hir-declared-variable-type env var)
                                        (hir-var-policy var) *hir-policy*))
                         (if body-builder (funcall body-builder body env) (hir-progn body env))))
               (vars (hir-vector variables)) (inits (hir-vector initializers)))
          (when (loop for var across vars for init across inits
                      thereis (and (= (hir-node-kind init) 6) (not (logtest 1 (hir-var-flags var)))))
            (hir-note-function-aliases *hir-function*))
          (if sequential
              (loop for i downfrom (1- (length vars)) to 0
                    for var = (svref vars i)
                    for special = (rassoc var specials)
                    do (when special
                         (setf result (hir-node 12 *hir-source* (car special)
                                               (hir-node 1 *hir-source* (hir-note-ref var)) result)))
                       (setf result (hir-node 11 *hir-source* (vector var) (vector (svref inits i)) result)))
              (progn
                (dolist (special specials)
                  (setf result (hir-node 12 *hir-source* (car special)
                                        (hir-node 1 *hir-source* (hir-note-ref (cdr special))) result)))
                (setf result (hir-node 11 *hir-source* vars inits result))))
          result)))))

(define-hir-converter let (parts environment) (hir-convert-let parts environment nil))
(define-hir-converter let* (parts environment) (hir-convert-let parts environment t))
(define-hir-converter locally (parts environment) (hir-convert-body parts environment))

(define-hir-converter %with-inline (parts environment)
  (let ((*inline-expanding* (cons (hir-raw (first parts)) *inline-expanding*)))
    (hir-progn (rest parts) environment)))

(defun hir-convert-lambda (parts environment name &optional existing)
  (hir-arity 'lambda parts 1 nil)
  (let* ((fun (or existing (make-hir-fun :name name :parent *hir-function* :source *hir-source*)))
         (*hir-function* fun)
         (function-exit (and name (hir-new-exit (if (consp name) (second name) name))))
         ;; The function's implicit block encloses the body, not initializers.
         (env environment)
         (specials '()) (aux '())
         (ll (make-hir-lambda-list)) (required (make-hir-buffer))
         (optional (make-hir-buffer)) (keys (make-hir-buffer)) (state :required) (names '()))
    (multiple-value-bind (body declarations) (hir-split-body (rest parts) t)
      (let ((*hir-policy* (hir-body-policy environment declarations)))
        (labels ((function-body (forms environment)
                   (let* ((env (if function-exit
                                   (hir-env environment :blocks (list (cons (hir-exit-name function-exit) function-exit)))
                                   environment))
                          (result (hir-convert-body forms env)))
                     (if function-exit (hir-wrap-block function-exit result) result)))
                 (parameter (input)
                   (let* ((name (hir-variable-name input))
                          (special (hir-special-binding-p name declarations environment))
                          (var (hir-new-var (if special (gensym "ARG") name))))
                     (when (member name names) (hir-error "Duplicate parameter ~S" name))
                     (push name names)
                     (if special
                         (progn (push (cons name var) specials)
                                (setf env (hir-env env :vars (list (cons name '(:special))))))
                         (setf env (hir-env env :vars (list (cons name var)))))
                     (setf env (hir-declare-binding env name declarations)
                           (hir-var-type var) (hir-declared-variable-type env var))
                     var)))
          (dolist (input (hir-parts (first parts)))
            (let ((item (hir-raw input)))
              (cond
                ((member item lambda-list-keywords)
                 (case item
                   (&optional (unless (eq state :required) (hir-error "Misplaced &OPTIONAL"))
                              (setf state :optional))
                   (&rest (unless (member state '(:required :optional)) (hir-error "Misplaced &REST"))
                          (setf state :rest))
                   (&key (unless (member state '(:required :optional :after-rest)) (hir-error "Misplaced &KEY"))
                         (setf state :key (hir-lambda-list-key-p ll) t))
                   (&allow-other-keys
                    (unless (eq state :key) (hir-error "Misplaced &ALLOW-OTHER-KEYS"))
                    (setf (hir-lambda-list-allow-other-keys ll) t state :after-keys))
                   (&aux (unless (member state '(:required :optional :after-rest :key :after-keys))
                           (hir-error "Misplaced &AUX"))
                         (setf state :aux))
                   (otherwise (hir-error "Invalid ordinary lambda list keyword ~S" item))))
                ((eq state :required) (hir-push (parameter input) required))
                ((eq state :rest) (setf (hir-lambda-list-rest ll) (parameter input) state :after-rest))
                ((member state '(:optional :key))
                 (let* ((spec (if (symbolp item) (list input) (hir-parts input)))
                        (head (hir-raw (first spec)))
                        (checked (progn
                                   (hir-arity 'parameter spec 1 3)
                                   (when (and (eq state :key) (consp head))
                                     (hir-arity 'keyword-parameter head 2))
                                   (unless (or (symbolp head)
                                               (and (eq state :key) (consp head)))
                                     (hir-error "Invalid parameter name ~S" head))))
                        (keyword (when (eq state :key)
                                   (if (consp head)
                                       (progn (hir-arity 'keyword-parameter head 2) (first head))
                                       (intern (symbol-name head) '#:keyword))))
                        (variable-name (if (consp head) (second head) head)))
                   (declare (ignore checked))
                   (when (and (eq state :optional) (consp head)) (hir-error "Invalid optional parameter"))
                   (unless (or (null keyword) (symbolp keyword)) (hir-error "Invalid keyword name ~S" keyword))
                   (let* ((init (hir-convert (second spec) env))
                          (var (parameter variable-name))
                          (supplied (if (= (length spec) 3) (parameter (third spec)) (hir-new-var (gensym "SUPPLIED")))))
                     (hir-push (vector var init supplied keyword) (if (eq state :key) keys optional)))))
                ((eq state :aux)
                 (let* ((spec (if (symbolp item) (list input) (hir-parts input)))
                        (name (hir-variable-name (first spec))))
                   (hir-arity 'aux-parameter spec 1 2)
                   (when (member name names) (hir-error "Duplicate parameter ~S" name))
                   (push name names)
                   (push input aux)))
                (t (hir-error "Unexpected lambda list item ~S" item)))))
          (when (eq state :rest) (hir-error "Missing parameter after &REST"))
          (setf (hir-lambda-list-required ll) (hir-vector required)
                (hir-lambda-list-optional ll) (hir-vector optional)
                (hir-lambda-list-keys ll) (hir-vector keys)
                (hir-fun-lambda-list fun) ll
                (hir-fun-policy fun) *hir-policy*)
          (let* ((*local-notinline* (append (loop for spec in declarations
                                                 when (eq (car spec) 'notinline) append (cdr spec))
                                            *local-notinline*))
                 (result (if aux
                             (hir-convert-let
                              (hir-parts `(,(mapcar #'hir-raw (nreverse aux))
                                          (declare ,@declarations) ,@(mapcar #'hir-raw body)))
                              env t (lambda (forms environment) (function-body forms environment)))
                             (function-body body (hir-declare env declarations)))))
            (setf (hir-fun-parameter-specials fun) specials
                  (hir-fun-body fun) result)))
        fun))))
(define-hir-converter function (parts environment)
  (hir-arity 'function parts 1)
  (let ((name (hir-raw (first parts))))
    (cond ((and (consp name) (eq (car name) 'lambda))
           (let ((fun (hir-convert-lambda (rest (hir-parts (first parts))) environment nil)))
             (incf (hir-fun-value-refs fun))
             (setf (hir-fun-flags fun) (logior 1 (logandc2 (hir-fun-flags fun) 8)))
             (hir-node 6 *hir-source* fun)))
          ((hir-function-name-p name)
           (let ((fun (hir-lookup environment name :fun)))
             (if (hir-fun-p fun)
                 (progn (incf (hir-fun-value-refs fun))
                        (setf (hir-fun-flags fun) (logior 1 (logandc2 (hir-fun-flags fun) 8)))
                        (hir-node 6 *hir-source* fun))
                 (progn
                   (when (or fun
                             (typep (trucler:describe-function *client* environment name)
                                    '(or trucler:macro-description trucler:special-operator-description)))
                     (hir-error "~S does not name an ordinary function" name))
                   (hir-node 5 *hir-source* name)))))
          (t (hir-error "Invalid FUNCTION argument ~S" name)))))

(defun hir-convert-local-functions (parts environment recursive)
  (hir-arity (if recursive 'labels 'flet) parts 1 nil)
  (let ((functions (make-hir-buffer)) (definitions '()) (entries '()))
    (dolist (definition (hir-parts (first parts)))
      (let* ((def (hir-parts definition)) (name (hir-raw (first def))))
        (hir-arity 'local-function def 2 nil)
        (unless (hir-function-name-p name) (hir-error "Invalid local function name ~S" name))
        (when (assoc name entries :test #'equal) (hir-error "Duplicate local function ~S" name))
        (let ((fun (make-hir-fun :name name :parent *hir-function* :source *hir-source*
                                :binding (hir-new-var (gensym "FUNCTION")))))
          (push (cons name fun) entries)
          (push (cons fun (rest def)) definitions)
          (hir-push fun functions))))
    (when (plusp (hir-buffer-count functions)) (hir-note-local-functions *hir-function*))
    (let ((env (hir-env environment :funcs entries)))
      (dolist (definition (nreverse definitions))
        (hir-convert-lambda (cdr definition) (if recursive env environment)
                           (hir-fun-name (car definition)) (car definition)))
      (hir-node 13 *hir-source* (hir-vector functions) (hir-convert-body (rest parts) env)))))

(define-hir-converter flet (parts environment) (hir-convert-local-functions parts environment nil))
(define-hir-converter labels (parts environment) (hir-convert-local-functions parts environment t))

(define-hir-converter block (parts environment)
  (hir-arity 'block parts 1 nil)
  (let* ((name (hir-raw (first parts))) (exit (hir-new-exit name)))
    (unless (symbolp name) (hir-error "Invalid BLOCK name ~S" name))
    (hir-wrap-block exit
                   (hir-progn (rest parts) (hir-env environment :blocks (list (cons name exit)))))))

(define-hir-converter return-from (parts environment)
  (hir-arity 'return-from parts 1 2)
  (let* ((name (hir-raw (first parts))) (exit (hir-lookup environment name :block)))
    (unless exit (hir-error "No lexically visible BLOCK named ~S" name))
    (setf (hir-exit-flags exit) (logior 2 (hir-exit-flags exit)))
    (unless (eq *hir-function* (hir-exit-owner exit))
      (setf (hir-exit-flags exit) (logior 1 (hir-exit-flags exit))))
    (hir-node 15 *hir-source* exit (hir-convert (second parts) environment))))

(define-hir-converter tagbody (parts environment)
  (let* ((group (hir-new-exit nil)) (segments (make-hir-buffer))
         (tags '()) (current group) (forms '()))
    (setf (hir-exit-token group) (hir-new-var (gensym "EXIT")))
    (dolist (part parts)
      (let ((raw (hir-raw part)))
        (if (or (symbolp raw) (integerp raw))
            (progn
              (hir-push (cons current (nreverse forms)) segments)
              (setf forms nil current (hir-new-exit raw group (hir-buffer-count segments)))
              (when (assoc raw tags :test #'eql) (hir-error "Duplicate TAGBODY tag ~S" raw))
              (push (cons raw current) tags))
            (push part forms))))
    (hir-push (cons current (nreverse forms)) segments)
    (let ((env (hir-env environment :tags tags)))
      (hir-node 16 *hir-source*
               (map 'simple-vector (lambda (segment) (cons (car segment) (hir-progn (cdr segment) env)))
                    (hir-vector segments)) group))))

(define-hir-converter go (parts environment)
  (hir-arity 'go parts 1)
  (let* ((name (hir-raw (first parts))) (exit (hir-lookup environment name :tag)))
    (unless exit (hir-error "No lexically visible TAGBODY tag ~S" name))
    (unless (eq *hir-function* (hir-exit-owner exit))
      (setf (hir-exit-flags (hir-exit-group exit)) 1))
    (hir-node 17 *hir-source* exit)))

(define-hir-converter catch (parts environment)
  (hir-arity 'catch parts 1 nil)
  (hir-node 18 *hir-source* (hir-convert (first parts) environment) (hir-progn (rest parts) environment)))
(define-hir-converter throw (parts environment)
  (hir-arity 'throw parts 2)
  (hir-node 19 *hir-source* (hir-convert (first parts) environment) (hir-convert (second parts) environment)))
(define-hir-converter unwind-protect (parts environment)
  (hir-arity 'unwind-protect parts 1 nil)
  (hir-node 20 *hir-source* (hir-convert (first parts) environment) (hir-progn (rest parts) environment)))
(defun hir-mv-bind-parts (parts)
  "For (MULTIPLE-VALUE-CALL (LAMBDA (&OPTIONAL V... &REST R) (DECLARE (IGNORE R)) BODY...) FORM),
as MULTIPLE-VALUE-BIND expands into: the variable inputs, FORM, and BODY."
  (when (= (length parts) 2)
    (let* ((fn (first parts)) (raw (hir-raw fn)))
      (when (and (consp raw) (eq (car raw) 'function) (consp (cdr raw)) (null (cddr raw)))
        (setf fn (second (hir-parts fn)) raw (hir-raw fn)))
      (when (and (consp raw) (eq (car raw) 'lambda) (consp (cdr raw)) (consp (cddr raw)))
        (let* ((fn-parts (hir-parts fn))
               (ll (and (listp (hir-raw (second fn-parts))) (hir-parts (second fn-parts))))
               (len (length ll)))
          (when (and (>= len 3)
                     (eq (hir-raw (first ll)) '&optional)
                     (eq (hir-raw (nth (- len 2) ll)) '&rest))
            (let ((rest-var (hir-raw (nth (1- len) ll)))
                  (vars (subseq ll 1 (- len 2))))
              (when (and (symbolp rest-var)
                         (equal (hir-raw (third fn-parts)) `(declare (ignore ,rest-var)))
                         (every (lambda (v)
                                  (let ((s (hir-raw v)))
                                    (and (symbolp s) (not (member s lambda-list-keywords)))))
                                vars))
                (values vars (second parts) (cdddr fn-parts) t)))))))))

(defun hir-convert-mv-bind (var-inputs values-form body-parts environment)
  (let ((names (mapcar #'hir-variable-name var-inputs)))
    (unless (= (length names) (length (remove-duplicates names)))
      (hir-error "Duplicate MULTIPLE-VALUE-BIND variable"))
    (multiple-value-bind (body declarations) (hir-split-body body-parts)
      (let ((init (hir-convert values-form environment))
            (env environment) (variables (make-hir-buffer)) (specials '()))
        (dolist (name names)
          (let* ((special (hir-special-binding-p name declarations environment))
                 (variable (hir-new-var (if special (gensym "SPECIAL") name))))
            (hir-push variable variables)
            (if special
                (progn
                  (push (cons name variable) specials)
                  (setf env (hir-env env :vars (list (cons name '(:special))))))
                (setf env (hir-env env :vars (list (cons name variable)))))))
        (let* ((*hir-policy* (hir-body-policy env declarations))
               (env (hir-declare env declarations))
               (*local-notinline* (append (loop for spec in declarations
                                                when (eq (car spec) 'notinline) append (cdr spec))
                                           *local-notinline*))
               (result (progn
                         (loop for var across (hir-vector variables)
                               do (setf (hir-var-type var) (hir-declared-variable-type env var)
                                        (hir-var-policy var) *hir-policy*))
                         (hir-progn body env)))
               (vars (hir-vector variables)))
          (if (zerop (length vars))
              (hir-node 10 *hir-source* (vector init result))
              (progn
                (dolist (special specials)
                  (setf result (hir-node 12 *hir-source* (car special)
                                        (hir-node 1 *hir-source* (hir-note-ref (cdr special))) result)))
                (hir-node 11 *hir-source* vars (vector init) result t))))))))

(define-hir-converter multiple-value-call (parts environment)
  (hir-arity 'multiple-value-call parts 1 nil)
  (multiple-value-bind (vars values-form body matched) (hir-mv-bind-parts parts)
    (if matched
        (hir-convert-mv-bind vars values-form body environment)
        (hir-node 21 *hir-source* (hir-convert (first parts) environment) (hir-convert-vector (rest parts) environment)))))
(define-hir-converter multiple-value-prog1 (parts environment)
  (hir-arity 'multiple-value-prog1 parts 1 nil)
  (hir-node 22 *hir-source* (hir-convert (first parts) environment) (hir-progn (rest parts) environment)))
(define-hir-converter the (parts environment)
  (hir-arity 'the parts 2)
  (hir-node 23 *hir-source* (hir-expand-declaration (hir-raw (first parts)) environment)
           (hir-convert (second parts) environment)))
(define-hir-converter progv (parts environment)
  (hir-arity 'progv parts 2 nil)
  (hir-node 25 *hir-source* (hir-convert (first parts) environment)
           (hir-convert (second parts) environment) (hir-progn (cddr parts) environment)))
(define-hir-converter eval-when (parts environment)
  (multiple-value-bind (action body) (toplevel-eval-when (cons 'eval-when parts) :eval)
    (if (eq action :execute) (hir-progn body environment) (hir-node 0 *hir-source* nil))))
(define-hir-converter load-time-value (parts environment)
  (hir-arity 'load-time-value parts 1 2)
  (let* ((outer *hir-function*)
         (fun (make-hir-fun :name '(load-time-value) :source *hir-source*
                          :lambda-list (make-hir-lambda-list)))
         (*hir-function* fun))
    (unless (member (hir-raw (second parts)) '(nil t)) (hir-error "Invalid LOAD-TIME-VALUE read-only flag"))
    (setf (hir-fun-body fun)
          (hir-convert (first parts)
                      (hir-env (make-instance 'trucler-reference:environment
                                :global-environment (trucler:global-environment *client* environment)))))
    (when (logtest 64 (hir-fun-flags fun)) (hir-note-local-functions outer))
    (when (logtest 256 (hir-fun-flags fun)) (hir-note-function-aliases outer))
    (hir-node 24 *hir-source* fun (hir-raw (second parts)))))

(define-hir-converter symbol-macrolet (parts environment)
  (hir-arity 'symbol-macrolet parts 1 nil)
  (let ((entries '()))
    (dolist (input (hir-parts (first parts)))
      (let ((pair (hir-parts input)))
        (hir-arity 'symbol-macrolet-binding pair 2)
        (let ((name (hir-variable-name (first pair))))
          (when (assoc name entries) (hir-error "Duplicate symbol macro ~S" name))
          (check-symbol-macro-name name environment)
          (push (cons name (list :symbol-macro (hir-raw (second pair)))) entries))))
    (multiple-value-bind (body declarations) (hir-split-body (rest parts))
      (when (intersection (mapcar #'car entries) (hir-special-names declarations))
        (hir-error "Cannot declare a symbol macro SPECIAL"))
      (hir-convert-body body (hir-declare (hir-env environment :vars entries) declarations)))))

(defgeneric hir-local-macro-expander (client name lambda-list body environment)
  (:documentation "The expander of the local macro NAME defined by MACROLET
in the HIR environment ENVIRONMENT. The cross client evaluates it with the
HIR evaluator (eval.lisp); both clients see only
the local macros and symbol macros of ENVIRONMENT."))

(define-hir-converter macrolet (parts environment)
  (hir-arity 'macrolet parts 1 nil)
  (let ((entries '()))
    (dolist (input (hir-parts (first parts)))
      (let* ((def (mapcar #'hir-raw (hir-parts input))) (name (first def)))
        (hir-arity 'macrolet-definition def 2 nil)
        (unless (symbolp name) (hir-error "Invalid local macro name ~S" name))
        (when (assoc name entries) (hir-error "Duplicate local macro ~S" name))
        (let ((expander (let ((*hir-step-recording* nil))
                          (hir-local-macro-expander *client* name (second def) (cddr def)
                                                   environment))))
          (push (cons name (list :macro expander)) entries))))
    (hir-convert-body (rest parts) (hir-env environment :funcs entries))))

(defun cst-to-hir (cst environment)
  (let* ((*hir-policy* (hir-policy-from-environment environment))
         (root (make-hir-fun :name '(:top-level-form) :source nil
                           :lambda-list (make-hir-lambda-list)))
         (*hir-function* root) (*hir-conversion-depth* 0)
         (*hir-file-id* (hir-source-file-number *source-file*))
         (*hir-source* (let ((source (and (not (typep cst 'cst:cst)) *macro-source*)))
                        (and source (hir-source-position *hir-file-id* (car source) (cdr source)))))
         (*hir-top-cst* (or *hir-top-cst* (and (typep cst 'cst:cst) cst))))
    (setf (hir-fun-body root) (hir-convert cst (hir-env environment)))
    (analyze-hir root)))
