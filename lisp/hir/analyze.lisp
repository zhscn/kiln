(in-package #:kiln.compiler)

(defun hir-map-function (function fun)
  "Visit the roots owned by FUN, including default parameter forms."
  (let ((ll (hir-fun-lambda-list fun)))
    (when ll
      (loop for parameter across (hir-lambda-list-optional ll)
            do (funcall function (svref parameter 1)))
      (loop for parameter across (hir-lambda-list-keys ll)
            do (funcall function (svref parameter 1)))))
  (when (hir-fun-body fun) (funcall function (hir-fun-body fun))))

(defun hir-canonical-function (fun)
  (loop while (and fun (logtest 16 (hir-fun-flags fun))) do (setf fun (hir-fun-parent fun))
        finally (return fun)))

(defun hir-inline-candidate-p (fun caller)
  (let ((ll (hir-fun-lambda-list fun)) (call (hir-fun-call-site fun)))
    (and (= (hir-fun-calls fun) 1) (not (logtest 33 (hir-fun-flags fun)))
         (eq (hir-canonical-function (hir-fun-parent fun)) caller)
         (eq (hir-canonical-function (hir-fun-caller fun)) caller)
         call (not (eq (hir-node-d call) :notinline))
         (hir-policy-optimize-p (hir-node-policy call))
         (if (hir-lambda-list-rest ll)
             (<= (length (hir-lambda-list-required ll)) (length (hir-node-b call))
                 (+ (length (hir-lambda-list-required ll)) 8))
             (= (length (hir-node-b call)) (length (hir-lambda-list-required ll))))
         (zerop (length (hir-lambda-list-optional ll)))
         (not (hir-lambda-list-key-p ll))
         (null (hir-fun-parameter-specials fun)))))

(defun hir-inline-call (node caller)
  (let ((fun (hir-node-a node)))
    (when (and (hir-fun-p fun) (hir-inline-candidate-p fun caller))
      (loop with buffer = (hir-fun-vars fun)
            with data = (hir-buffer-data buffer)
            with count = (hir-buffer-count buffer)
            for index below count
            for var = (svref data index)
            do (setf (hir-var-owner var) caller
                     (hir-var-flags var) (logandc2 (hir-var-flags var) 6))
               (hir-adopt-var var caller))
      (let* ((ll (hir-fun-lambda-list fun)) (required (hir-lambda-list-required ll))
             (rest (hir-lambda-list-rest ll)) (args (hir-node-b node)))
        (setf (hir-node-kind node) 11
              (hir-node-policy node) (hir-fun-policy fun)
              (hir-node-a node) (if rest (concatenate 'simple-vector required (vector rest)) required)
              (hir-node-b node) (if rest
                                   (concatenate 'simple-vector (subseq args 0 (length required))
                                                (vector (hir-node 7 (hir-node-source node) 'list
                                                                 (subseq args (length required)))))
                                   args)
              (hir-node-c node) (hir-fun-body fun)
              (hir-fun-body fun) nil
              (hir-fun-flags fun) (logior 16 (hir-fun-flags fun)))))))

(defun hir-specialization-cost (fun)
  (let ((ll (hir-fun-lambda-list fun)) (size 0))
    (unless (and ll (hir-fun-body fun) (not (logtest 1 (hir-fun-flags fun)))
                 (zerop (length (hir-lambda-list-optional ll)))
                 (not (hir-lambda-list-rest ll)) (not (hir-lambda-list-key-p ll))
                 (null (hir-fun-parameter-specials fun)))
      (return-from hir-specialization-cost nil))
    (labels ((small (node)
               (when (> (incf size) 16) (return-from hir-specialization-cost nil))
               (unless (member (hir-node-kind node) '(0 1 2 3 4 5 7 8 9 10 11 12 21 22 23 25))
                 (return-from hir-specialization-cost nil))
               (when (and (= (hir-node-kind node) 7) (hir-fun-p (hir-node-a node)))
                 (return-from hir-specialization-cost nil))
               (hir-map-children #'small node)))
      (small (hir-fun-body fun)))
    size))

(defun hir-copy-specialization (fun caller call)
  (let ((copy (make-hir-fun :name (hir-fun-name fun) :source (hir-fun-source fun)
                           :parent caller :caller caller :call-site call :calls 1
                           :policy (hir-fun-policy fun)))
        (variables (make-hash-table :test #'eq)))
    (loop with buffer = (hir-fun-vars fun)
          for i below (hir-buffer-count buffer)
          for var = (svref (hir-buffer-data buffer) i)
          for new = (copy-hir-var var)
          do (setf (hir-var-owner new) copy
                   (hir-var-flags new) (logandc2 (hir-var-flags new) 6)
                   (gethash var variables) new)
             (hir-adopt-var new copy))
    (labels ((variable (var)
               (or (gethash var variables)
                   (and (find var (hir-fun-free fun) :test #'eq) var)
                   (hir-error "Unmapped specialization variable")))
             (nodes (vector) (map 'simple-vector #'node vector))
             (node (old)
               (let ((new (copy-hir-node old)))
                 (setf (hir-node-type new) t (hir-node-mark new) 0)
                 (case (hir-node-kind old)
                   (1 (setf (hir-node-a new) (variable (hir-node-a old)) (hir-node-c new) nil))
                   (2 (setf (hir-node-a new) (variable (hir-node-a old))
                            (hir-node-b new) (node (hir-node-b old))))
                   ((4 23) (setf (hir-node-b new) (node (hir-node-b old))))
                   (7 (when (hir-node-p (hir-node-a old)) (setf (hir-node-a new) (node (hir-node-a old))))
                      (setf (hir-node-b new) (nodes (hir-node-b old))))
                   ((8 10) (setf (hir-node-a new) (nodes (hir-node-a old))))
                   ((9 25) (setf (hir-node-a new) (node (hir-node-a old))
                                 (hir-node-b new) (node (hir-node-b old))
                                 (hir-node-c new) (node (hir-node-c old))))
                   (11 (setf (hir-node-a new) (map 'simple-vector #'variable (hir-node-a old))
                             (hir-node-b new) (nodes (hir-node-b old))
                             (hir-node-c new) (node (hir-node-c old))))
                   (12 (setf (hir-node-b new) (node (hir-node-b old))
                             (hir-node-c new) (node (hir-node-c old))))
                   (21 (setf (hir-node-a new) (node (hir-node-a old))
                             (hir-node-b new) (nodes (hir-node-b old))))
                   (22 (setf (hir-node-a new) (node (hir-node-a old))
