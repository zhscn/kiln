                   (let* ((buffer (hir-fun-vars fun)) (data (hir-buffer-data buffer))
                          (old (hir-buffer-count buffer)) (write 0))
                     (loop for i below old for var = (svref data i)
                           unless (gethash var retired) do (setf (svref data write) var) (incf write))
                     (loop for i from write below old do (setf (svref data i) nil))
                     (setf (hir-buffer-count buffer) write))) functions)))
    changed))

(defun classify-hir-function-environments (root)
  "Mark function graphs whose captures resolve entirely to static functions."
  (let ((seen (make-hash-table :test #'eq)) (bindings (make-hash-table :test #'eq))
        (users (make-hash-table :test #'eq)) (dynamic (make-hash-table :test #'eq))
        (functions nil) (pending nil))
    (labels ((collect-function (fun)
               (unless (gethash fun seen)
                 (setf (gethash fun seen) t)
                 (push fun functions)
                 (when (hir-fun-binding fun) (setf (gethash (hir-fun-binding fun) bindings) fun))
                 (hir-map-function #'collect-node fun)))
             (collect-node (node)
               (case (hir-node-kind node)
                 ((6 7)
                  (let ((owned (hir-own-function node))) (when owned (collect-function owned)))
                  (when (hir-node-p (hir-node-a node)) (collect-node (hir-node-a node)))
                  (when (= (hir-node-kind node) 7) (loop for arg across (hir-node-b node) do (collect-node arg))))
                 (13 (loop for fun across (hir-node-a node) do (collect-function fun))
                     (collect-node (hir-node-b node)))
                 (24 (collect-function (hir-node-a node)))
                 (otherwise (hir-map-children #'collect-node node))))
             (reject (fun)
               (unless (gethash fun dynamic)
                 (setf (gethash fun dynamic) t)
                 (push fun pending))))
      (collect-function root)
      (dolist (fun functions)
        (setf (hir-fun-flags fun) (logandc2 (hir-fun-flags fun) 128))
        (loop for var across (hir-fun-free fun)
              for dependency = (gethash var bindings)
              do (if dependency (push fun (gethash dependency users)) (reject fun))))
      (loop while pending for fun = (pop pending)
            do (dolist (user (gethash fun users)) (reject user)))
      (dolist (fun functions)
        (unless (gethash fun dynamic) (setf (hir-fun-flags fun) (logior 128 (hir-fun-flags fun))))))
    root))

(defun expand-hir-list-bindings (root)
  "Expose short local list allocations to cons identity and escape analysis."
  (let ((seen (make-hash-table :test #'eq)))
    (labels ((function-tree (fun)
               (unless (gethash fun seen)
                 (setf (gethash fun seen) t)
                 (let ((budget 16))
                   (labels ((temporary ()
                              (let ((var (make-hir-var :name (gensym "LIST") :owner fun :refs 1)))
                                (hir-adopt-var var fun) var))
                            (reference (var source) (hir-node 1 source var))
                            (expand (init)
                              (when (and (hir-policy-optimize-p (hir-node-policy init))
                                         (= (hir-node-kind init) 7) (member (hir-node-a init) '(list list*))
                                         (not (eq (hir-node-d init) :notinline)))
                                (let* ((args (hir-node-b init)) (count (length args))
                                       (star (eq (hir-node-a init) 'list*))
                                       (cells (if star (1- count) count)) (source (hir-node-source init)))
                                  (when (and (<= 1 cells 8) (<= cells budget))
                                    (decf budget cells)
                                    (if (= cells 1)
                                        (setf (hir-node-a init) 'cons
                                              (hir-node-b init) (if star args (vector (svref args 0) (hir-node 0 source nil))))
                                        (let* ((arguments (map 'simple-vector (lambda (arg) (declare (ignore arg)) (temporary)) args))
                                               (objects (make-array cells)) (body nil))
                                          (dotimes (i cells) (setf (svref objects i) (temporary)))
                                          (setf body (reference (svref objects 0) source))
                                          (dotimes (i cells)
                                            (let* ((tail (cond ((< (1+ i) cells) (reference (svref objects (1+ i)) source))
                                                               (star (reference (svref arguments cells) source))
                                                               (t (hir-node 0 source nil))))
                                                   (cons (hir-node 7 source 'cons
                                                                  (vector (reference (svref arguments i) source) tail))))
                                              (setf body (hir-node 11 source (vector (svref objects i)) (vector cons) body))))
                                          (setf (hir-node-kind init) 11 (hir-node-a init) arguments
                                                (hir-node-b init) args (hir-node-c init) body (hir-node-d init) nil)))))))
                            (walk (node)
                              (when (and (= (hir-node-kind node) 11) (not (hir-node-d node)))
                                (loop for init across (hir-node-b node) do (expand init)))
                              (case (hir-node-kind node)
                                ((6 7) (let ((owned (hir-own-function node))) (when owned (function-tree owned)))
                                 (when (hir-node-p (hir-node-a node)) (walk (hir-node-a node)))
                                 (when (= (hir-node-kind node) 7) (loop for arg across (hir-node-b node) do (walk arg))))
                                (13 (loop for nested across (hir-node-a node) do (function-tree nested))
                                    (walk (hir-node-b node)))
                                (24 (function-tree (hir-node-a node)))
                                (otherwise (hir-map-children #'walk node)))))
                     (hir-map-function #'walk fun))))))
      (function-tree root))))

(defun analyze-hir (root &optional (specialize t))
  "Compute captures and exits, then specialize calls using inferred facts.
Moved bodies are analyzed again against their final lexical owners."
  (when (and (logtest 256 (hir-fun-flags root)) (not (logtest 32 (hir-fun-flags root))))
    (resolve-hir-function-aliases root))
  (when (and (logtest 64 (hir-fun-flags root)) (not (logtest 32 (hir-fun-flags root))))
    (propagate-hir-function-identities root)
    (prune-hir-local-functions root))
  (setf (hir-fun-load-time-values root) (make-hir-buffer))
  (labels
      ((analyze (fun)
         (let ((*hir-function* fun) (free (make-hir-buffer)))
           (setf (hir-fun-flags fun) (logior 32 (hir-fun-flags fun)))
           (loop with buffer = (hir-fun-vars fun)
                 with data = (hir-buffer-data buffer)
                 with count = (hir-buffer-count buffer)
                 for index below count
                 for var = (svref data index)
                 do (setf (hir-var-flags var) (logandc2 (hir-var-flags var) 6)))
           (setf (hir-fun-exits fun) (make-hir-buffer))
           (labels
               ((capture (var)
                  (unless (eq (hir-var-owner var) fun)
                    (unless (find var (hir-buffer-data free) :end (hir-buffer-count free) :test #'eq)
                      (hir-push var free))
                    (setf (hir-var-flags var) (logior 2 (hir-var-flags var)))))
                (child (nested)
                  (setf (hir-fun-parent nested) (hir-canonical-function (hir-fun-parent nested)))
                  (analyze nested)
                  (loop for var across (hir-fun-free nested) do (capture var)))
                (exit-reference (exit)
                  (unless (eq (hir-exit-owner exit) fun)
                    (let ((group (hir-exit-group exit)))
                      (setf (hir-exit-flags group) 1)
                      (capture (hir-exit-token group)))))
                (visit (node)
                  (when (= (hir-node-kind node) 7) (hir-inline-call node fun))
                  (case (hir-node-kind node)
                    ((1 2) (capture (hir-node-a node))
                           (when (= (hir-node-kind node) 2) (visit (hir-node-b node))))
                    ((6 7)
                     (let ((callee (hir-node-a node)))
                       (cond ((hir-fun-p callee)
                              (if (hir-fun-binding callee) (capture (hir-fun-binding callee)) (child callee)))
                             ((hir-node-p callee) (visit callee))))
                     (when (= (hir-node-kind node) 7)
                       (loop for arg across (hir-node-b node) do (visit arg))))
                    (13 (loop for nested across (hir-node-a node)
                              unless (hir-inline-candidate-p nested fun) do (child nested))
                        (visit (hir-node-b node))
                        (setf (hir-node-a node)
                              (coerce (loop for nested across (hir-node-a node)
                                            unless (logtest 16 (hir-fun-flags nested)) collect nested)
                                      'simple-vector))
                        (when (zerop (length (hir-node-a node)))
                          (setf (hir-node-kind node) 10 (hir-node-a node) (vector (hir-node-b node))
                                (hir-node-b node) nil)))
                    ((14 16)
                     (let ((exit (if (= (hir-node-kind node) 14) (hir-node-a node) (hir-node-b node))))
                       (setf (hir-exit-flags exit) 0 (hir-exit-owner exit) fun)
                       (when (= (hir-node-kind node) 16)
                         (loop for segment across (hir-node-a node)
                               do (setf (hir-exit-owner (car segment)) fun)))
                       (hir-map-children #'visit node)
                       (when (logtest 1 (hir-exit-flags exit)) (hir-push exit (hir-fun-exits fun)))))
                    ((15 17) (exit-reference (hir-node-a node))
                             (when (= (hir-node-kind node) 15) (visit (hir-node-b node))))
                    (24 (analyze (hir-node-a node))
                        (hir-push node (hir-fun-load-time-values root)))
                    (otherwise (hir-map-children #'visit node)))))
             (hir-map-function #'visit fun))
           (setf (hir-fun-free fun) (hir-vector free))
           (when (plusp (length (hir-fun-free fun)))
             (setf (hir-fun-flags fun) (logior 2 (hir-fun-flags fun))))
           (when (= (hir-fun-calls fun) 1)
             (setf (hir-fun-flags fun) (logior 4 (hir-fun-flags fun))))
           (loop with buffer = (hir-fun-vars fun)
                 with data = (hir-buffer-data buffer)
                 with count = (hir-buffer-count buffer)
                 for index below count
                 for var = (svref data index)
                 when (= (logand (hir-var-flags var) 3) 3)
                   do (setf (hir-var-flags var) (logior 4 (hir-var-flags var)))))))
    (analyze root))
  (when specialize (expand-hir-list-bindings root))
  (when (logtest 64 (hir-fun-flags root)) (classify-hir-function-environments root))
  (multiple-value-bind (typed local-calls conses) (infer-hir-types root)
    (declare (ignore typed))
    (when (and specialize local-calls (specialize-hir-calls root)) (analyze-hir root nil))
    (when (and specialize conses (scalar-replace-hir-conses root)) (analyze-hir root nil)))
  root)
