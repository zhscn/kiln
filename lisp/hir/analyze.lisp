                  (let ((owned (hir-own-function node))) (when owned (function-tree owned)))
                  (when (hir-node-p (hir-node-a node))
                    (visit (hir-node-a node) owner walk (when (= (hir-node-kind node) 7) node)))
                  (when (= (hir-node-kind node) 7)
                    (loop for arg across (hir-node-b node) do (funcall walk arg))))
                 (13 (loop for fun across (hir-node-a node) do (function-tree fun))
                     (funcall walk (hir-node-b node)))
