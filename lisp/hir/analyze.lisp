                                                    (or (= (hir-node-kind init) 6)
                                                        (and (= (hir-node-kind init) 1) (safe-reference-p init))))
                                           (make-hir-function-alias node owner var init index))
                             do (when entry
                                  (setf (gethash var aliases) entry any t)
                                  (push entry entries))
                                (visit init owner walk entry))
