                                                          (or (eq input t) (hir-known-subtype-p actual input))))))
                          (setf (hir-node-a node) (hir-copy-specialization callee owner node)
                                (gethash owner growth) (+ cost (gethash owner growth 0))
                                (gethash callee cloned) t changed t)
                          (decf (hir-fun-calls callee)))))
                    (cond ((hir-node-p callee) (visit callee owner))
                          ((and (hir-own-function node) (eq callee (hir-node-a node))) (function-tree callee))))
                  (when (= (hir-node-kind node) 7)
