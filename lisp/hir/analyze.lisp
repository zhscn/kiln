(defun specialize-hir-calls (root)
  (let ((costs (make-hash-table :test #'eq)) (growth (make-hash-table :test #'eq))
        (seen (make-hash-table :test #'eq)) (cloned (make-hash-table :test #'eq)) (changed nil))
    (labels ((function-tree (fun)
               (unless (gethash fun seen)
                 (setf (gethash fun seen) t)
                 (hir-map-function (lambda (node) (visit node fun)) fun)))
             (visit (node owner)
               (case (hir-node-kind node)
                 ((6 7)
                  (let ((callee (hir-node-a node)))
                    (when (and (= (hir-node-kind node) 7) (hir-fun-p callee)
                               (hir-policy-optimize-p (hir-node-policy node))
                               (not (eq (hir-node-d node) :notinline)))
                      (let* ((cost (multiple-value-bind (cost found) (gethash callee costs)
                                     (if found cost (setf (gethash callee costs) (hir-specialization-cost callee)))))
                             (args (hir-node-b node)) (inputs (hir-fun-input-types callee)))
                        (when (and cost inputs (= (length args) (length inputs))
                                   (<= cost (if (> (hir-policy-quality (hir-node-policy node) :space)
                                                  (hir-policy-quality (hir-node-policy node) :speed)) 4 16))
                                   (<= (+ cost (gethash owner growth 0)) 128)
