                            do (multiple-value-bind (ignored next-env next-write) (visit (cdr segment) base)
                                 (declare (ignore ignored next-env))
                                 (setf loop-write (or loop-write next-write))))
                      (when loop-write (setf environment base written t))))))
             (20
              ;; Cleanup can run after an early exit from any protected form.
              ;; Its entry state cannot use the protected form's final state.
              (let ((base (hir-immutable-types environment)))
                (visit (hir-node-a node) environment)
                (visit (hir-node-b node) base)
                (setf environment base written t)))
             (22
              (multiple-value-setq (type environment written) (visit (hir-node-a node) environment))
              (multiple-value-bind (ignored next-env next-write) (visit (hir-node-b node) environment)
                (declare (ignore ignored))
                (setf environment next-env written (or written next-write))))
             (23 (if previsited (setf type (hir-node-type (hir-node-b node)))
                     (multiple-value-setq (type environment written) (visit (hir-node-b node) environment))))
             (24 (function-types (hir-node-a node) nil))
             (14
              (multiple-value-bind (result state write solved) (hir-control-types node environment #'visit #'function-types)
                (if solved
                    (setf type result environment state written write)
                    (multiple-value-bind (ignored next-env next-write) (visit (hir-node-b node) environment)
                      (declare (ignore ignored next-env))
                      (multiple-value-bind (result actual-write) (hir-block-result-type node)
                        (setf type result)
                        (when (and next-write actual-write)
                          (setf environment (hir-immutable-types environment) written t)))))))
             ((15 17 18 19 25)
              (let ((base (if (= (hir-node-kind node) 17) (hir-immutable-types environment) environment)))
                (multiple-value-bind (ignored next-env next-write) (children node base)
                  (declare (ignore ignored next-env))
                  ;; RETURN/GO/THROW can bypass later assignments. The exit
                  ;; continuation only retains immutable facts.
                  (when (or next-write (member (hir-node-kind node) '(15 17 19)))
                    (setf environment (hir-immutable-types environment) written t)))))
             (otherwise (unless previsited (multiple-value-setq (type environment written) (children node environment)))))
           (setf (hir-node-type node) type)
           (values type environment written))))
        ;; Most forms contain no retained direct local call. Analyze those
        ;; once without allocating a function graph or its worklist tables.
        (function-types root nil)
        (when local-calls
          (setf simple nil)
          (multiple-value-bind (functions graph-members sites outgoing) (hir-summary-graph root)
            (setf members graph-members)
            (let* ((pending (copy-list functions)) (tail (last pending))
                   (queued (make-hash-table :test #'eq)) (captures (make-hash-table :test #'eq)))
              (dolist (fun functions)
                (setf (gethash fun queued) t (hir-fun-result-type fun) t
                      (hir-fun-input-types fun)
                      (when (hir-summary-inputs-p fun root)
                        (make-array (length (hir-lambda-list-required (hir-fun-lambda-list fun)))
                                    :initial-element t))))
              (labels
                ((enqueue (fun)
                   (unless (gethash fun queued)
                     (let ((cell (list fun)))
                       (if tail (setf (cdr tail) cell) (setf pending cell))
                       (setf tail cell (gethash fun queued) t))))
                 (update-inputs (callee)
                   (let ((types (hir-fun-input-types callee)))
                     (when types
                       (let ((joined nil) (changed nil))
                         (dolist (site (gethash callee sites))
                           (let ((args (hir-node-b (cdr site))))
                             (when (= (length args) (length types))
                               (if joined
                                   (loop for arg across args for i from 0
                                         do (setf (svref joined i) (hir-type-join (svref joined i) (hir-node-type arg))))
                                   (setf joined (map 'simple-vector #'hir-node-type args))))))
                         (when joined
                           (loop for old across types for candidate across joined for i from 0
                                 for new = (hir-summary-narrow old candidate)
                                 unless (equal old new) do (setf (svref types i) new changed t)))
                         (when changed (enqueue callee))))))
                 (analyze-function (fun)
                   (let ((environment (gethash fun captures)) (inputs (hir-fun-input-types fun)))
                     (when inputs
                       (loop for var across (hir-lambda-list-required (hir-fun-lambda-list fun))
                             for type across inputs do (setf environment (hir-bind-type var type environment))))
                     (setf capture-candidates (make-hash-table :test #'eq) capture-order nil)
                     (hir-map-function (lambda (node) (visit node environment)) fun)
                     (let* ((old (hir-fun-result-type fun))
                            (new (hir-summary-narrow old (if (hir-fun-body fun) (hir-node-type (hir-fun-body fun)) t))))
                       (unless (equal old new)
                         (setf (hir-fun-result-type fun) new)
                         (dolist (site (gethash fun sites)) (enqueue (car site)))))
                     (dolist (child (nreverse capture-order))
                       (let* ((candidate (gethash child capture-candidates))
                              (old (gethash child captures)) (new (hir-summary-environment old candidate)))
                         (unless (hir-type-environments-equal-p old new)
                           (setf (gethash child captures) new) (enqueue child))))
                     ;; A callee's input joins every static call, including callers not
                     ;; yet analyzed, whose argument nodes still conservatively say T.
                     (dolist (callee (gethash fun outgoing))
                       (when (gethash callee members) (update-inputs callee))))))
                ;; FIFO order visits every function before repeated propagation
                ;; can consume the budget. Every update is a sound narrowing.
                (loop repeat (* 8 (length functions)) while pending
                      for fun = (pop pending)
                      do (unless pending (setf tail nil))
                         (remhash fun queued)
                         (analyze-function fun))
                (dolist (fun (hir-refine-recursive-results functions outgoing))
                  (enqueue fun)
                  (dolist (site (gethash fun sites)) (enqueue (car site))))
                (loop repeat (* 8 (length functions)) while pending
                      for fun = (pop pending)
                      do (unless pending (setf tail nil))
                         (remhash fun queued)
                         (analyze-function fun)))))))
    (values root local-calls conses)))
