(in-package #:kiln.compiler)

;;; The domain is deliberately bounded: canonical value classes and finite
;;; machine-word integer intervals. T means unknown, not an assertion. Host FIXNUM
;;; bounds need not match the target's and must not determine inferred types.
(defconstant +hir-fixnum-min+ (- (ash 1 62)))
(defconstant +hir-fixnum-max+ (1- (ash 1 62)))
(defconstant +hir-bound-min+ (- (ash 1 63)))
(defconstant +hir-bound-max+ (1- (ash 1 63)))

(defun hir-integer-range (low high)
  (if (and (<= +hir-bound-min+ low) (<= high +hir-bound-max+))
      (list 'integer low high)
      'integer))

(defun hir-range-p (type)
  (and (consp type) (eq (car type) 'integer)))

(defun hir-fixnum-type-p (type)
  (or (eq type 'fixnum)
      (and (hir-range-p type) (<= +hir-fixnum-min+ (second type))
           (<= (third type) +hir-fixnum-max+))))

(defun hir-integer-type-p (type)
  (or (eq type 'integer) (eq type 'fixnum) (hir-range-p type)))

(defun hir-type-range (type)
  (cond ((hir-range-p type) type)
        ((eq type 'fixnum) (hir-integer-range +hir-fixnum-min+ +hir-fixnum-max+))))


(defun hir-type-join (a b)
  (cond ((equal a b) a)
        ((and (hir-range-p a) (hir-range-p b))
         (hir-integer-range (min (second a) (second b)) (max (third a) (third b))))
        ((and (hir-fixnum-type-p a) (hir-fixnum-type-p b)) 'fixnum)
        ((and (hir-integer-type-p a)
              (hir-integer-type-p b)) 'integer)
        ((and (member a '(null symbol)) (member b '(null symbol))) 'symbol)
        (t t)))

(defun hir-constant-type (value)
  (cond ((integerp value) (hir-integer-range value value))
        ((null value) 'null)
        ((symbolp value) 'symbol)
        ((consp value) 'cons)
        ((characterp value) 'character)
        ((stringp value) :native-string)
        ((typep value 'simple-vector) 'simple-vector)
        ((typep value 'single-float) 'single-float)
        ((typep value 'double-float) 'double-float)
        ((rationalp value) 'rational)
        ((complexp value) 'complex)
        (t t)))

(defun hir-predicate-type (name)
  (cdr (assoc name '((kiln.kernel::fixnump . fixnum) (integerp . integer) (rationalp . rational) (realp . real)
                    (numberp . number) (floatp . float) (consp . cons)
                    (symbolp . symbol) (characterp . character)
                    (simple-vector-p . simple-vector) (stringp . string)
                    (simple-string-p . simple-string) (vectorp . vector)
                    (arrayp . array) (functionp . function) (null . null)
                    (not . null) (listp . list)))))

(defun hir-type-predicate (name type)
  "Return a predicate's result and whether it is known for TYPE."
  (when (or (eq type t) (eq type 'boolean))
    (return-from hir-type-predicate (values nil nil)))
  (let* ((class (if (hir-integer-type-p type) 'integer type))
         (supers
           (case class
             (integer '(integer rational real number))
             (rational '(rational real number))
             ((single-float double-float float) '(float real number))
             (real '(real number)) (number '(number)) (complex '(number))
             (null '(null symbol list)) (symbol '(symbol)) (cons '(cons list))
             (character '(character)) (function '(function))
             (simple-vector '(simple-vector vector array))
             (:simple-array-vector '(vector array))
             (:native-string '(simple-string string vector array))
             (simple-string '(simple-string string vector array))
             (string '(string vector array)) (vector '(vector array))
             (array '(array)) (list '(list))))
         (wanted (hir-predicate-type name)))
    (cond ((null wanted) (values nil nil))
          ((or (member wanted supers)
               (and (eq wanted 'fixnum) (hir-fixnum-type-p type))) (values t t))
          ((and (eq wanted 'fixnum) (eq class 'integer)) (values nil nil))
          ;; Broad classes may overlap without containment (LIST and SYMBOL
          ;; both include NIL; ARRAY includes vectors and strings).
          ((or (member class '(number real rational float array vector :simple-array-vector string simple-string list symbol))
               (and (eq wanted 'null) (eq class 'list)))
           (values nil nil))
          (t (values nil t)))))

(defun hir-make-array-type (args)
  (let* ((count (length args)) (dimension (and (plusp count) (svref args 0)))
         (rank-one (and dimension
                        (or (hir-integer-type-p (hir-node-type dimension))
                            (and (= (hir-node-kind dimension) 0)
                                 (consp (hir-node-a dimension))
                                 (hir-proper-list-p (hir-node-a dimension))
                                 (= (length (hir-node-a dimension)) 1)))))
         (simple t) (general-elements t))
    (unless rank-one (return-from hir-make-array-type 'array))
    (unless (oddp count) (return-from hir-make-array-type 'vector))
    (loop for i from 1 below count by 2
          for key = (svref args i) for value = (svref args (1+ i))
          do (unless (= (hir-node-kind key) 0) (return-from hir-make-array-type 'vector))
             (case (hir-node-a key)
               ((:adjustable :fill-pointer :displaced-to)
                (unless (and (= (hir-node-kind value) 0) (null (hir-node-a value)))
                  (setf simple nil)))
               (:element-type
                (unless (and (= (hir-node-kind value) 0) (eq (hir-node-a value) t))
                  (setf general-elements nil)))
               ((:initial-element :initial-contents :displaced-index-offset :allow-other-keys))
               (otherwise (return-from hir-make-array-type 'vector))))
    (cond ((not simple) 'vector)
          (general-elements 'simple-vector)
          (t :simple-array-vector))))

(defun hir-call-type (name args)
  (let ((count (length args)))
    (cond
      ((hir-predicate-type name) 'boolean)
      ((member name '(< > <= >= = /= eq eql equal equalp zerop plusp minusp)) 'boolean)
      ((eq name 'cons) 'cons)
      ((eq name 'list) (if (zerop count) 'null 'cons))
      ((eq name 'vector) 'simple-vector)
      ((eq name 'make-array) (hir-make-array-type args))
      ((and (eq name 'length) (= count 1)
            (member (hir-node-type (svref args 0)) '(simple-vector :native-string)))
       (hir-integer-range 0 #xffffffff))
      ((and (= count 2)
            (or (member name '(char schar))
                (and (member name '(aref elt)) (eq (hir-node-type (svref args 0)) :native-string))))
       'character)
      ((and (= count 3) (member name '((setf aref) (setf svref) (setf char) (setf schar) (setf elt)) :test #'equal))
       (hir-node-type (svref args 0)))
      ((and (eq name 'char-code) (= count 1)) (hir-integer-range 0 #x10ffff))
      ((eq name 'values) (if (plusp count) (hir-node-type (svref args 0)) 'null))
      ((and (= count 1) (member name '(- abs 1+ 1-))
            (eq (hir-node-type (svref args 0)) 'double-float)) 'double-float)
      ((and (eq name '/) (= count 2)
            (every (lambda (arg) (eq (hir-node-type arg) 'double-float)) args)) 'double-float)
      ((and (member name '(+ - *)) (= count 2))
       (let* ((at (hir-node-type (svref args 0))) (bt (hir-node-type (svref args 1)))
              (a (or (hir-type-range at) at)) (b (or (hir-type-range bt) bt)))
         (when (and (eq at 'double-float) (eq bt 'double-float))
           (return-from hir-call-type 'double-float))
         (when (and (hir-range-p a) (hir-range-p b))
           (return-from hir-call-type
             (case name
               (+ (hir-integer-range (+ (second a) (second b)) (+ (third a) (third b))))
               (- (hir-integer-range (- (second a) (third b)) (- (third a) (second b))))
               (* (let ((products (list (* (second a) (second b)) (* (second a) (third b))
                                        (* (third a) (second b)) (* (third a) (third b)))))
                    (hir-integer-range (apply #'min products) (apply #'max products)))))))
         (if (and (hir-integer-type-p a)
                  (hir-integer-type-p b))
             'integer t)))
      ((and (member name '(1+ 1-)) (= count 1))
       (let* ((actual (hir-node-type (svref args 0))) (type (or (hir-type-range actual) actual))
              (delta (if (eq name '1+) 1 -1)))
         (cond ((hir-range-p type)
                (hir-integer-range (+ (second type) delta) (+ (third type) delta)))
               ((hir-integer-type-p type) 'integer)
               (t t))))
      ((and (member name '(logand logior logxor)) (= count 2))
       (let ((a (hir-node-type (svref args 0))) (b (hir-node-type (svref args 1))))
         (when (eq name 'logand)
           (let ((limit nil))
             (dolist (type (list a b))
               (when (and (hir-range-p type) (<= 0 (second type)))
                 (setf limit (if limit (min limit (third type)) (third type)))))
             (when limit (return-from hir-call-type (hir-integer-range 0 limit)))))
         (cond ((and (hir-range-p a) (hir-range-p b) (<= 0 (second a)) (<= 0 (second b)))
                (hir-integer-range 0 (1- (ash 1 (max (integer-length (third a))
                                                  (integer-length (third b)))))))
               ((and (hir-fixnum-type-p a) (hir-fixnum-type-p b)) 'fixnum)
               ((and (hir-integer-type-p a)
                     (hir-integer-type-p b)) 'integer)
               (t t))))
      (t t))))

(defun hir-test-type (test)
  (when (= (hir-node-kind test) 7)
    (let ((args (hir-node-b test)) (name (hir-node-a test)))
      (cond ((= (length args) 1)
             (values (svref args 0) (hir-predicate-type name)))
            ((and (eq name 'typep) (= (length args) 2)
                  (= (hir-node-kind (svref args 1)) 0)
                  (member (hir-node-a (svref args 1))
                          '(fixnum integer rational real number float cons symbol character
                            simple-vector string simple-string vector array function null list)))
             (values (svref args 0) (hir-node-a (svref args 1))))))))

(defun hir-type-intersection (a b)
  (cond ((eq b t) a)
        ((hir-known-subtype-p a b) a)
        ((and (hir-range-p a) (eq b 'fixnum))
         (hir-type-intersection a (hir-integer-range +hir-fixnum-min+ +hir-fixnum-max+)))
        ((and (eq a 'fixnum) (hir-range-p b))
         (hir-type-intersection (hir-integer-range +hir-fixnum-min+ +hir-fixnum-max+) b))
        ((and (hir-range-p a) (hir-range-p b))
         (let ((low (max (second a) (second b))) (high (min (third a) (third b))))
           ;; An empty intersection has no normal return after the check.
           ;; Keep a safe overapproximation until the domain has bottom.
           (if (<= low high) (hir-integer-range low high) b)))
        (t b)))

(defun hir-declaration-type (specifier)
  "Project supported declarations into the value domain; T is unsupported."
  (setf specifier (hir-declaration-expanded specifier))
  (cond ((member specifier '(fixnum integer rational real number float single-float double-float
                            cons symbol character simple-vector simple-string string vector array
                            function null list)) specifier)
        ((member specifier '(short-float long-float))
         (if (eq specifier 'short-float) 'single-float 'double-float))
        ((nth-value 2 (type-fixnum-bounds specifier))
         (multiple-value-bind (low high) (type-fixnum-bounds specifier)
           (hir-integer-range low high)))
        ((and (consp specifier) (hir-proper-list-p specifier))
         (case (car specifier)
           ((array simple-array)
            (if (> (length specifier) 3) t
              (let ((element (if (cdr specifier) (second specifier) '*))
                    (dimensions (if (cddr specifier) (third specifier) '*)))
                (cond ((or (eql dimensions 1)
                           (and (consp dimensions) (hir-proper-list-p dimensions)
                                (= (length dimensions) 1)))
                       (if (and (eq (car specifier) 'simple-array) (eq element t))
                           'simple-vector (if (eq (car specifier) 'simple-array) :simple-array-vector 'vector)))
                      (t 'array)))))
           (and
            (let ((type t))
              (dolist (part (cdr specifier) type)
                (let ((next (hir-declaration-type part)))
                  (when (eq next t) (return-from hir-declaration-type t))
                  (setf type (hir-type-intersection type next))))))
           (or
            (let ((parts (cdr specifier)))
              (if (null parts) t
                  (reduce #'hir-type-join (mapcar #'hir-declaration-type parts)))))
           (otherwise t)))
        (t t)))

(defun hir-known-subtype-p (actual required)
  "A proof in the finite domain, independent of user-defined type aliases."
  (cond ((eq actual t) nil)
        ((equal actual required) t)
        ((eq required :simple-array-vector)
         (member actual '(simple-vector :native-string simple-string)))
        ((hir-range-p required)
         (cond ((hir-range-p actual)
                (and (<= (second required) (second actual))
                     (<= (third actual) (third required))))
               ((eq actual 'fixnum)
                (and (<= (second required) +hir-fixnum-min+)
                     (<= +hir-fixnum-max+ (third required))))))
        (t
         (let ((predicate (case required
                            (fixnum 'kiln.kernel::fixnump) (integer 'integerp)
                            (rational 'rationalp) (real 'realp) (number 'numberp)
                            (float 'floatp) (cons 'consp) (symbol 'symbolp)
                            (character 'characterp) (simple-vector 'simple-vector-p)
                            (simple-string 'simple-string-p) (string 'stringp)
                            (vector 'vectorp) (array 'arrayp) (function 'functionp)
                            (null 'null) (list 'listp))))
           (and predicate
                (multiple-value-bind (truth known) (hir-type-predicate predicate actual)
                  (and truth known)))))))

(defun hir-declaration-proven-p (actual specifier)
  (setf specifier (hir-declaration-expanded specifier))
  (cond ((and (consp specifier) (member (car specifier) '(array simple-array)))
         ;; A projected class does not prove element or extent constraints.
         (and (equal specifier '(simple-array t (*)))
              (hir-known-subtype-p actual 'simple-vector)))
        ((and (consp specifier) (eq (car specifier) 'and))
         (every (lambda (part) (hir-declaration-proven-p actual part)) (cdr specifier)))
        ((and (consp specifier) (eq (car specifier) 'or))
         (some (lambda (part) (hir-declaration-proven-p actual part)) (cdr specifier)))
        (t (let ((required (hir-declaration-type specifier)))
             (and (not (eq required t)) (hir-known-subtype-p actual required))))))

(defun hir-trackable-type-var-p (var)
  ;; A captured writer can run from an arbitrary call or a nonlocal exit.
  (/= (logand (hir-var-flags var) 3) 3))

(defun hir-bind-type (var type environment)
  (if (or (not (hir-trackable-type-var-p var))
          (equal type (or (cdr (assoc var environment :test #'eq)) t)))
      environment
      (acons var type environment)))

(defun hir-direct-values-leaves (init)
  "Return argument vectors and whether every result path is a direct VALUES."
  (let ((leaves nil) (budget 256))
    (labels ((collect (node)
               (when (minusp (decf budget)) (return-from collect nil))
               (case (hir-node-kind node)
                 (7 (when (and (eq (hir-node-a node) 'values) (not (eq (hir-node-d node) :notinline)))
                      (push (hir-node-b node) leaves) t))
                 (9 (and (collect (hir-node-b node)) (collect (hir-node-c node))))
                 (11 (collect (hir-node-c node)))
                 ((20 22) (collect (hir-node-a node)))
                 (10 (let ((forms (hir-node-a node)))
                       (and (plusp (length forms)) (collect (svref forms (1- (length forms))))))))))
      (unless (collect init) (return-from hir-direct-values-leaves (values nil nil))))
    (values leaves t)))

(defun hir-bind-let-types (node environment)
  (let ((vars (hir-node-a node)) (inits (hir-node-b node)))
    (if (hir-node-d node)
        (multiple-value-bind (leaves complete) (hir-direct-values-leaves (svref inits 0))
          (when complete
            (loop for var across vars for i from 0
                  for type = nil
                  do (dolist (args leaves)
                       (let ((next (if (< i (length args)) (hir-node-type (svref args i)) 'null)))
                         (setf type (if type (hir-type-join type next) next))))
                     (setf environment (hir-bind-type var type environment)))))
        (loop for var across vars for init across inits
              do (setf environment (hir-bind-type var (hir-node-type init) environment))))
    environment))

(defun hir-immutable-types (environment)
  (remove-if (lambda (entry) (logtest 1 (hir-var-flags (car entry)))) environment))

(defun hir-join-type-environments (left right)
  (if (eq left right)
      left
      (let ((seen (make-hash-table :test #'eq)) (result nil))
        (dolist (entry left result)
          (let ((var (car entry)))
            (unless (gethash var seen)
              (setf (gethash var seen) t)
              (let ((type (hir-type-join (cdr entry)
                                      (or (cdr (assoc var right :test #'eq)) t))))
                (unless (eq type t) (push (cons var type) result)))))))))


(defun hir-refine-comparison (test environment positive)
  (let* ((name (hir-node-a test)) (args (hir-node-b test)))
    (unless (and (member name '(< <= > >= = /=)) (= (length args) 2)
                 ;; Evaluating the later operand must not overwrite the first.
                 (every (lambda (arg) (member (hir-node-kind arg) '(0 1))) args))
      (return-from hir-refine-comparison environment))
    (unless positive
      (setf name (case name (< '>=) (<= '>) (> '<=) (>= '<) (= '/=) (/= '=))))
    (when (eq name '/=) (return-from hir-refine-comparison environment))
    (let* ((a (svref args 0)) (b (svref args 1))
           (left (hir-type-range (hir-node-type a)))
           (right (hir-type-range (hir-node-type b))))
      (unless (and left right) (return-from hir-refine-comparison environment))
      (when (member name '(> >=))
        (rotatef a b) (rotatef left right)
        (setf name (if (eq name '>) '< '<=)))
      (let ((al (second left)) (ah (third left)) (bl (second right)) (bh (third right)))
        (if (eq name '=)
            (setf al (max al bl) ah (min ah bh) bl al bh ah)
            (let ((strict (if (eq name '<) 1 0)))
              (setf ah (min ah (- bh strict)) bl (max bl (+ al strict)))))
        ;; Impossible branches remain conservative until the domain has bottom.
        (when (or (> al ah) (> bl bh)) (return-from hir-refine-comparison environment))
        (when (= (hir-node-kind a) 1)
          (setf environment (hir-bind-type (hir-node-a a) (hir-integer-range al ah) environment)))
        (when (= (hir-node-kind b) 1)
          (setf environment (hir-bind-type (hir-node-a b) (hir-integer-range bl bh) environment)))
        environment))))

(defun hir-refine-types (test environment &optional (positive t))
  (when (and (= (hir-node-kind test) 7)
             (member (hir-node-a test) '(not null))
             (= (length (hir-node-b test)) 1)
             (= (hir-node-kind (svref (hir-node-b test) 0)) 7))
    (return-from hir-refine-types
      (hir-refine-types (svref (hir-node-b test) 0) environment (not positive))))
  (when (= (hir-node-kind test) 7)
    (setf environment (hir-refine-comparison test environment positive)))
  (unless positive (return-from hir-refine-types environment))
  (multiple-value-bind (arg type) (hir-test-type test)
    (if (and type (= (hir-node-kind arg) 1))
        (let* ((var (hir-node-a arg)) (old (cdr (assoc var environment :test #'eq))))
          (hir-bind-type var
                        (if (and (hir-fixnum-type-p old)
                                 (member type '(fixnum integer rational real number)))
                            old type)
                        environment))
        environment)))

(defun hir-type-environments-equal-p (left right)
  (flet ((same (entry)
           (let ((var (car entry)))
             (equal (or (cdr (assoc var left :test #'eq)) t)
                    (or (cdr (assoc var right :test #'eq)) t)))))
    (and (every #'same left) (every #'same right))))

(defun hir-widen-type-environment (previous joined)
  (mapcar (lambda (entry)
            (let ((old (cdr (assoc (car entry) previous :test #'eq))) (new (cdr entry)))
              (if (and (hir-range-p old) (hir-range-p new))
                  (cons (car entry)
                        (let ((lower (< (second new) (second old)))
                              (upper (> (third new) (third old))))
                          (if (or (and lower (< (second new) +hir-fixnum-min+))
                                  (and upper (> (third new) +hir-fixnum-max+)))
                              'integer
                              (hir-integer-range
                               (if lower +hir-fixnum-min+ (second new))
                               (if upper +hir-fixnum-max+ (third new))))))
                  entry))) joined))

(defun hir-control-types (node environment visit function-types)
  "Solve local control edges, including nested loops and cleanup crossings."
  (let ((size 0) (steps 0) (written nil) (go-targets nil) (blocks nil)
        (cleanups nil) (locals nil))
    (labels
        ((fail () (return-from hir-control-types (values nil nil nil nil)))
         (children (function form)
           (case (hir-node-kind form)
             ((6 24) nil)
             (7 (when (hir-node-p (hir-node-a form)) (funcall function (hir-node-a form)))
                (loop for arg across (hir-node-b form) do (funcall function arg)))
             (13 (funcall function (hir-node-b form)))
             (otherwise (hir-map-children function form))))
         (supported (form gos exits)
           (when (> (incf size) 16384) (fail))
           (case (hir-node-kind form)
             (17 (member (hir-exit-group (hir-node-a form)) gos :test #'eq))
             (15 (and (member (hir-node-a form) exits :test #'eq)
                      (supported (hir-node-b form) gos exits)))
             (14 (and (not (logtest 1 (hir-exit-flags (hir-node-a form))))
                      (supported (hir-node-b form) gos (cons (hir-node-a form) exits))))
             (16 (and (not (logtest 1 (hir-exit-flags (hir-node-b form))))
                      (<= (length (hir-node-a form)) 128)
                      (every (lambda (segment)
                               (supported (cdr segment) (cons (hir-node-b form) gos) exits))
                             (hir-node-a form))))
             (20 (and (supported (hir-node-a form) gos exits)
                      (supported (hir-node-b form) gos exits)))
             (otherwise
              (let ((ok t))
                (children (lambda (child) (unless (supported child gos exits) (setf ok nil))) form)
                ok))))
         (join (left right)
           (cond ((eq left :unreachable) right) ((eq right :unreachable) left)
                 (t (hir-join-type-environments left right))))
         (leaf (form state &optional previsited)
           (multiple-value-bind (type next write) (funcall visit form state previsited)
             (setf written (or written write))
             (values type next)))
         (drop-locals (state saved)
           (if (eq state :unreachable) state
               (let ((drop nil))
                 (loop for tail = locals then (cdr tail) until (eq tail saved)
                       do (push (car tail) drop))
                 (remove-if (lambda (entry) (member (car entry) drop :test #'eq)) state))))
         (run-cleanup (entry state)
           (let ((saved-cleanups cleanups) (saved-locals locals))
             (setf state (drop-locals state (svref entry 3))
                   cleanups (svref entry 2) locals (svref entry 3))
             (let ((next (nth-value 1 (walk (svref entry 0) state))))
               (setf cleanups saved-cleanups locals saved-locals)
               next)))
         (cleanup-annotations (entry)
           ;; A cleanup jump also overrides implicit exceptions. Analyze those
           ;; entries with unknown mutable values and offer their explicit exits.
           (run-cleanup entry (svref entry 1)))
         (cleanup-state (entry state)
           (let ((next (run-cleanup entry state)))
             (cleanup-annotations entry)
             next))
         (unwind-state (state saved-cleanups saved-locals)
           (loop for tail = cleanups then (cdr tail)
                 until (or (eq state :unreachable) (eq tail saved-cleanups))
                 do (setf state (cleanup-state (car tail) state)))
           (drop-locals state saved-locals))
         (many (forms state)
           (let ((type 'null))
             (loop for form across forms until (eq state :unreachable)
                   do (multiple-value-setq (type state) (walk form state)))
             (values type state)))
         (loop-types (form state)
           (let* ((segments (hir-node-a form)) (count (length segments))
                  (states (make-array count :initial-element :unreachable))
                  (queued (make-array count :initial-element nil)) (pending nil)
                  (exit-state :unreachable))
             (labels ((offer (index incoming)
                        (unless (eq incoming :unreachable)
                          (if (= index count)
                              (setf exit-state (join exit-state incoming))
