(in-package #:kiln.compiler)

(defvar *hir-lowering-function*)
(defvar *hir-closure-layout*)
(defvar *hir-lifted-operands* nil)

(defun hir-raw-double-variable-p (var)
  (let ((value (hir-var-lowering var)))
    (and (consp value) (eq (car value) :double-bits))))

(defun hir-box-double-bits (bits)
  (let ((bits (copy-to-var bits :raw)))
    (emit-fixed-object kiln.kir::+packet-class-double+ (list bits))))

(defun hir-static-function-binding-p (var)
  (let ((value (hir-var-lowering var)))
    (and (consp value) (eq (car value) :static-function)
         (eq (hir-fun-lowering-epoch (cadr value)) *hir-lowering-epoch*))))

(defun hir-lifted-environment (fun)
  (and *hir-lifted-environments* (gethash fun *hir-lifted-environments*)))

(defun hir-prepare-native-environments (root)
  "Solve native capture requirements for direct-only local function entries."
  (unless (logtest 64 (hir-fun-flags root))
    (return-from hir-prepare-native-environments nil))
  (let ((seen (make-hash-table :test #'eq)) (bindings (make-hash-table :test #'eq))
        (invalid (make-hash-table :test #'eq)) (lifted (make-hash-table :test #'eq))
        (users (make-hash-table :test #'eq)) (members (make-hash-table :test #'eq))
        (layouts (make-hash-table :test #'eq))
        (functions nil) (definitions nil) (calls nil) (pending nil) (budget 4096))
    (labels ((collect-function (fun)
               (unless (gethash fun seen)
                 (setf (gethash fun seen) t)
                 (push fun functions)
                 (when (hir-fun-binding fun) (setf (gethash (hir-fun-binding fun) bindings) fun))
                 (hir-map-function (lambda (node) (collect-node node fun)) fun)))
             (definition (fun owner)
               (push (cons fun owner) definitions)
               (collect-function fun))
             (collect-node (node owner)
               (case (hir-node-kind node)
                 ((6 7)
                  (let ((callee (hir-node-a node)))
                    (when (hir-own-function node) (definition callee owner))
                    (when (and (= (hir-node-kind node) 7) (hir-fun-p callee))
                      (let* ((count (length (hir-node-b node)))
                             (ll (hir-fun-lambda-list callee))
                             (required (length (hir-lambda-list-required ll)))
                             (positional (+ required (length (hir-lambda-list-optional ll)))))
                        (push (vector callee owner count) calls)
                        (unless (and (>= count required)
                                     (or (hir-lambda-list-rest ll) (hir-lambda-list-key-p ll)
                                         (<= count positional))
                                     (or (not (hir-lambda-list-key-p ll))
                                         (evenp (max 0 (- count positional)))))
                          (setf (gethash callee invalid) t))))
                    (when (hir-node-p callee) (collect-node callee owner)))
                  (when (= (hir-node-kind node) 7)
                    (loop for arg across (hir-node-b node) do (collect-node arg owner))))
                 (13 (loop for fun across (hir-node-a node) do (definition fun owner))
                     (collect-node (hir-node-b node) owner))
                 (24 (collect-function (hir-node-a node)))
                 (otherwise (hir-map-children (lambda (child) (collect-node child owner)) node))))
             (edge (source user)
               (pushnew user (gethash source users) :test #'eq))
             (capture (fun var)
               (let ((dependency (gethash var bindings)))
                 (unless (or (eq (hir-var-owner var) fun) (eq (hir-fun-binding fun) var)
                             (and dependency (or (gethash dependency lifted)
                                                 (logtest 128 (hir-fun-flags dependency)))))
                   (let ((set (or (gethash fun members)
                                  (setf (gethash fun members) (make-hash-table :test #'eq)))))
                     (unless (gethash var set)
                       (when (minusp (decf budget))
                         (return-from hir-prepare-native-environments nil))
                       (setf (gethash var set) t)
                       (push var (gethash fun layouts))
                       (push (cons fun var) pending)))))))
      (collect-function root)
      (dolist (fun functions)
        (let ((ll (hir-fun-lambda-list fun)))
          (when (and (hir-policy-optimize-p (hir-fun-policy fun))
                     (hir-fun-binding fun) ll (hir-fun-body fun)
                     (plusp (hir-fun-calls fun)) (zerop (hir-fun-value-refs fun))
                     (not (logtest 145 (hir-fun-flags fun))) (not (gethash fun invalid)))
            (setf (gethash fun lifted) t))))
      (when (zerop (hash-table-count lifted))
        (return-from hir-prepare-native-environments nil))
      (dolist (pair definitions) (edge (car pair) (cdr pair)))
      (dolist (call calls)
        (when (gethash (svref call 0) lifted) (edge (svref call 0) (svref call 1))))
      (dolist (fun functions)
        (loop for var across (hir-fun-free fun) do (capture fun var)))
      (loop while pending for pair = (pop pending)
            do (dolist (user (gethash (car pair) users))
                 (when (minusp (decf budget)) (return-from hir-prepare-native-environments nil))
                 (capture user (cdr pair))))
      (dolist (fun functions)
        (when (and (gethash fun lifted)
                   (> (+ (length (gethash fun layouts))
                         (length (hir-lambda-list-required (hir-fun-lambda-list fun)))
                         (length (hir-lambda-list-optional (hir-fun-lambda-list fun))))
                      (+ +reg-args+ +values-max+)))
          (return-from hir-prepare-native-environments nil)))
      (dolist (call calls)
        (when (and (gethash (svref call 0) lifted)
                   (> (+ (svref call 2) (length (gethash (svref call 0) layouts)))
                      (+ +reg-args+ +values-max+)))
          (return-from hir-prepare-native-environments nil)))
      (unless *hir-native-environments* (setf *hir-native-environments* (make-hash-table :test #'eq)))
      (unless *hir-lifted-environments* (setf *hir-lifted-environments* (make-hash-table :test #'eq)))
      (dolist (fun functions)
        (let ((layout (coerce (nreverse (gethash fun layouts)) 'simple-vector)))
          (setf (gethash fun *hir-native-environments*) layout)
          (when (gethash fun lifted) (setf (gethash fun *hir-lifted-environments*) layout)))))
    t))

(defun hir-native-environment (fun)
  (let ((free (hir-fun-free fun)) (binding (hir-fun-binding fun)))
    (if (or (logtest 128 (hir-fun-flags fun)) (zerop (length free)))
        #()
        (let ((cache (or *hir-native-environments*
                         (setf *hir-native-environments* (make-hash-table :test #'eq)))))
          (multiple-value-bind (layout found) (gethash fun cache)
            (if found layout
                (setf (gethash fun cache)
                      (if (or (find binding free :test #'eq)
                              (some #'hir-static-function-binding-p free))
                          (remove-if (lambda (var)
                                       (or (eq var binding) (hir-static-function-binding-p var)))
                                     free)
                          free))))))))

(defun hir-static-function-data (fun)
  (let* ((label (hir-function-label fun)) (data (kiln.kir::kir-name label "_fobj")))
    (module-data data `(:words ,+kind-function+ (:func ,label)))
    data))

(defun hir-variable-operand (var)
  (let ((parameter (assoc var *hir-lifted-operands* :test #'eq)))
    (when parameter (return-from hir-variable-operand (hir-var-lowering (cdr parameter)))))
  (when (eq var (hir-fun-binding *hir-lowering-function*))
    (return-from hir-variable-operand *self*))
  (when (hir-static-function-binding-p var)
    (return-from hir-variable-operand
      (copy-to-var `(:addr ,(cddr (hir-var-lowering var)) ,+tag-general+))))
  (if (eq (hir-var-owner var) *hir-lowering-function*)
      (let ((value (or (hir-var-lowering var) (fail "HIR variable ~S is not bound" (hir-var-name var)))))
        (if (hir-raw-double-variable-p var) (cdr value) value))
      (let ((index (position var *hir-closure-layout* :test #'eq)))
        (unless index (fail "HIR variable ~S is missing from closure layout" (hir-var-name var)))
        (copy-to-var `(:closure-ref ,*self* ,index)))))

(defun hir-variable-value (var)
  (let ((value (hir-variable-operand var)))
    (cond ((hir-raw-double-variable-p var) (hir-box-double-bits value))
          ((logtest 4 (hir-var-flags var)) (copy-to-var `(:field-load ,kiln.kir::+packet-field-cons-car+ ,value)))
          (t (copy-to-var value)))))

(defvar *hir-inferred-double-locals* nil)

(defun hir-double-local-p (var)
  (and (hir-policy-optimize-p (hir-var-policy var)) (not (logtest 6 (hir-var-flags var)))
       (or (and (hir-var-type var) (not (eq (hir-var-type var) t))
                (eq (hir-declaration-type (hir-var-type var)) 'double-float))
           (and *hir-inferred-double-locals* (gethash var *hir-inferred-double-locals*)))))

(defun hir-bind-double-bits (var bits)
  (let ((operand (copy-to-var bits :f64)))
    (setf (hir-var-lowering var) (cons :double-bits operand))
    (note-debug-var operand (source-variable-name var) nil :double-bits)
    operand))

(defun hir-bind-variable (var value &optional raw-local)
  (when (and raw-local (hir-double-local-p var))
    (return-from hir-bind-variable
      (hir-bind-double-bits var `(:load ,value ,(- 8 +tag-general+)))))
  (let* ((cell (logtest 4 (hir-var-flags var)))
         (operand (copy-to-var (if cell (emit-cons value (nil-value)) value))))
    (setf (hir-var-lowering var) operand)
    (note-debug-var operand (source-variable-name var) cell)
    operand))

(defun hir-set-variable (var value &optional (actual t) (check t))
  (when check (hir-check-declaration value (hir-var-type var) actual))
  (cond ((hir-raw-double-variable-p var)
         (emit `(:set ,(hir-variable-operand var) (:load ,value ,(- 8 +tag-general+)))))
        ((logtest 4 (hir-var-flags var))
         (emit `(:field-store ,kiln.kir::+packet-field-cons-car+ ,(hir-variable-operand var) ,value)))
        (t (emit `(:set ,(hir-variable-operand var) ,value))))
  value)

(defun hir-parameter-list (fun)
  (let ((ll (hir-fun-lambda-list fun)))
    (append (loop for var across (hir-lambda-list-required ll) collect (vector var nil nil nil))
            (coerce (hir-lambda-list-optional ll) 'list)
            (when (hir-lambda-list-rest ll) (list (vector (hir-lambda-list-rest ll) nil nil nil)))
            (coerce (hir-lambda-list-keys ll) 'list))))

(defun hir-parsed-lambda-list (fun &optional captures)
  (let ((ll (hir-fun-lambda-list fun)))
    (make-parsed-lambda-list
     :required (append (mapcar #'cdr captures) (coerce (hir-lambda-list-required ll) 'list))
     :optional (loop for param across (hir-lambda-list-optional ll)
                     collect (list (svref param 0) (svref param 2)))
     :rest (hir-lambda-list-rest ll) :key-p (hir-lambda-list-key-p ll)
     :allow-other-keys (hir-lambda-list-allow-other-keys ll)
     :keys (loop for param across (hir-lambda-list-keys ll)
                 collect (list (svref param 0) (svref param 2) (svref param 3))))))

(defun hir-with-binding (name value body)
  (let* ((sym (constant-object name)) (index (emit-tls-index sym))
         (addr (copy-to-var `(:add (:load :ctx ,+ctx-tls+) (:shl ,index 2)) :raw))
         (region (establish-entry :bind sym)) (s `(:slot ,(region-slot region)))
         (r (new-var)) (n (new-var :raw)))
    (emit `(:store ,s ,+dyn-pend-target+ ,index))
    (emit `(:store ,s ,+dyn-pend-value+ (:load ,addr 0)))
    (emit `(:store ,addr 0 ,value))
    (let ((*regions* (cons region *regions*)))
      (multiple-value-call #'set-mv r n (funcall body)))
    (emit-unbind region)
    (pop-entry region)
    (values r n)))

(defun hir-entry-defaults (parameters fun)
  (if (null parameters)
      (hir-lower-mv (hir-fun-body fun))
      (let* ((parameter (first parameters)) (var (svref parameter 0))
             (init (svref parameter 1)) (supplied (svref parameter 2))
             (special (rassoc var (hir-fun-parameter-specials fun))))
        (when supplied
          (let ((initialize (new-block)) (next (new-block)))
            (br `(:eq ,(hir-variable-value supplied) ,(nil-value)) initialize next)
            (start-block initialize)
            (hir-set-variable var (hir-lower init) t nil)
            (jump next)
            (start-block next)))
        (unless (eq (hir-declaration-type (hir-var-type var)) t)
          (let* ((inputs (hir-fun-input-types fun))
                 (index (and inputs (position var (hir-lambda-list-required (hir-fun-lambda-list fun))
                                              :test #'eq))))
            (hir-check-declaration (hir-variable-value var) (hir-var-type var)
                                  (if index (svref inputs index) t))))
        (when (and supplied (not (eq (hir-declaration-type (hir-var-type supplied)) t)))
          (hir-check-declaration (hir-variable-value supplied) (hir-var-type supplied)))
        (if special
            (hir-with-binding (car special) (hir-variable-value var)
                             (lambda () (hir-entry-defaults (rest parameters) fun)))
            (hir-entry-defaults (rest parameters) fun)))))

(defun hir-function-label (fun)
  (if (eq (hir-fun-lowering-epoch fun) *hir-lowering-epoch*)
      (hir-fun-label fun)
      (setf (hir-fun-lowering-epoch fun) *hir-lowering-epoch*
            (hir-fun-label fun)
            (fresh-label (kiln.kir::kir-name "kiln_hir_"
                                            (local-function-label-name (or (hir-fun-name fun) 'lambda)) "_")))))

(defvar *hir-stack-conses* nil)
(defvar *hir-stack-closures* nil)
(defvar *hir-stack-rests* nil)
(defvar *hir-rest-slots* nil)
(defvar *hir-stack-slots* nil)

(defun hir-establish-stack-object (size header reference-start reference-count)
  "Allocate fixed storage and register only its contiguous Lisp reference fields.
All words are initialized before the object can be observed at a safepoint.
Return the storage slot and its root region, if any."
  (let ((slot (new-slot size)))
    (emit `(:store (:slot ,slot) 0 ,header))
    (loop for offset from 8 below size by 8
          do (emit `(:store (:slot ,slot) ,offset 0)))
    (values slot
            (when (plusp reference-count)
              (let ((region (establish-entry :stack-roots)))
                (emit `(:store (:slot ,(region-slot region)) ,+dyn-pend-target+
                               (:add (:slot ,slot) ,reference-start)))
                (emit `(:store (:slot ,(region-slot region)) ,+dyn-pend-value+ ,reference-count))
                region)))))

(defun hir-with-stack-storage (fun body)
  (let ((*hir-stack-slots* nil) (*hir-rest-slots* nil) (*regions* *regions*) (roots nil))
    (when (and *hir-stack-rests* (gethash fun *hir-stack-rests*))
      (dotimes (i 8)
        (multiple-value-bind (slot region) (hir-establish-stack-object 24 +kind-cons+ 8 2)
          (push slot *hir-rest-slots*)
          (push region roots)
          (push region *regions*))))
    (dolist (closure (and *hir-stack-closures* (gethash fun *hir-stack-closures*)))
      (let ((count (length (hir-native-environment closure))))
        (multiple-value-bind (slot region)
            (hir-establish-stack-object (+ 16 (* 8 count))
                                       (logior +kind-function+ (ash count +length-shift+)) 16 count)
          (push (cons closure slot) *hir-stack-slots*)
          (when region (push region roots) (push region *regions*)))))
    (dolist (node (and *hir-stack-conses* (gethash fun *hir-stack-conses*)))
      (multiple-value-bind (slot region) (hir-establish-stack-object 24 +kind-cons+ 8 2)
        (push (cons node slot) *hir-stack-slots*)
        (when region
          (push region roots)
          (push region *regions*))))
    (multiple-value-prog1 (funcall body)
      (dolist (region roots) (pop-entry region)))))

(defun hir-compile-function (fun)
  (let ((name (hir-function-label fun)))
    (unless (gethash name (kiln.kir::kmodule-defined *module*))
      (setf (gethash name (kiln.kir::kmodule-defined *module*)) t)
      (let* ((*hir-policy* (hir-fun-policy fun))
             (*hir-lowering-function* fun) (*hir-closure-layout* (hir-native-environment fun))
             (*hir-lifted-operands*
               (loop for var across (or (hir-lifted-environment fun) #())
                     collect (cons var (make-hir-var :name (hir-var-name var) :owner fun))))
            (*regions* '())
            (*debug-vars* '()) (*debug-var-count* 0)
            (*function-name* (local-function-debug-name (or (hir-fun-name fun) (gensym "LAMBDA")))))
        (with-function (name)
          (let* ((ll (hir-parsed-lambda-list fun *hir-lifted-operands*))
                 ;; All arguments in registers: poll first, re-entering
                 ;; on the slow path (EMIT-ENTRY-POLL).
                 (early-poll (and (not (ll-rest ll)) (not (ll-key-p ll))
                                  (<= (+ (length (ll-required ll)) (length (ll-optional ll)))
                                      +reg-args+))))
            (when early-poll (emit-entry-poll))
            (multiple-value-bind (v n)
                (hir-with-stack-storage
                 fun
                 (lambda ()
                   (let ((*self* (copy-to-var :self)))
                     (let ((*hir-entry-p* t)) (emit-entry ll :rest-slots *hir-rest-slots*))
                     (dolist (capture *hir-lifted-operands*)
                       (note-debug-var (hir-var-lowering (cdr capture))
                                       (source-variable-name (car capture))
                                       (logtest 4 (hir-var-flags (car capture)))))
                     ;; Every incoming argument is rooted before boxing can allocate.
                     (dolist (parameter (hir-parameter-list fun))
                       (let ((var (svref parameter 0)) (supplied (svref parameter 2)))
                         (hir-bind-variable var (hir-var-lowering var))
                         (when supplied (hir-bind-variable supplied (hir-var-lowering supplied)))))
                     (unless early-poll (emit-poll :stack t))
                     (hir-entry-defaults (hir-parameter-list fun) fun))))
              (emit `(:return ,v ,n))))
          (set-function-debug *function-name* (hir-source-range (hir-fun-source fun))))))
    name))

(defun hir-allocate-function (fun)
  (let ((label (hir-compile-function fun)) (count (length (hir-native-environment fun))))
    (if (zerop count)
        (let ((data (kiln.kir::kir-name label "_fobj")))
          (module-data data `(:words ,+kind-function+ (:func ,label)))
          (copy-to-var `(:addr ,data ,+tag-general+)))
        (let* ((slot (cdr (assoc fun *hir-stack-slots* :test #'eq)))
               (p (if slot `(:slot ,slot)
                      (emit-alloc (+ 16 (* 8 count)) (logior +kind-function+ (ash count +length-shift+))))))
          (emit `(:store ,p 8 (:addr ,label)))
          (copy-to-var `(:add ,p ,+tag-general+))))))

(defun hir-fill-function (fun object)
  (when (logtest 128 (hir-fun-flags fun)) (return-from hir-fill-function object))
  (loop for var across (hir-native-environment fun) for index from 0
        do (emit `(:closure-set ,object ,index ,(hir-variable-operand var))))
  object)

(defun hir-lower-function (fun)
  (when (hir-lifted-environment fun)
    (return-from hir-lower-function
      (copy-to-var `(:addr ,(hir-static-function-data fun) ,+tag-general+))))
  (if (hir-fun-binding fun)
      (hir-variable-value (hir-fun-binding fun))
      (let ((object (hir-allocate-function fun))) (hir-fill-function fun object))))

(defun hir-lower-local-functions (node)
  (let ((functions (hir-node-a node)))
    (loop for fun across functions
          do (hir-function-label fun)
             (setf (hir-var-lowering (hir-fun-binding fun)) nil))
    (loop for fun across functions when (logtest 128 (hir-fun-flags fun))
          do (setf (hir-var-lowering (hir-fun-binding fun))
                   (cons :static-function (cons fun (hir-static-function-data fun)))))
    (loop for fun across functions when (or (logtest 128 (hir-fun-flags fun)) (hir-lifted-environment fun))
          do (hir-compile-function fun))
    (loop for fun across functions unless (or (logtest 128 (hir-fun-flags fun)) (hir-lifted-environment fun))
          do (hir-bind-variable (hir-fun-binding fun) (hir-allocate-function fun)))
    ;; Mutual recursion can capture any sibling's object, so fill only
    ;; after every object is allocated and rooted.
    (loop for fun across functions unless (or (logtest 128 (hir-fun-flags fun)) (hir-lifted-environment fun))
          do (hir-fill-function fun (hir-variable-operand (hir-fun-binding fun))))
    (hir-lower-mv (hir-node-b node))))

(defun hir-lower (node)
  (values (hir-lower-mv node)))

(defun hir-lower-effect (node)
  (let ((*hir-policy* (hir-node-policy node)))
    (case (hir-node-kind node)
      (2 (if (hir-raw-double-variable-p (hir-node-a node))
             (hir-lower-assignment node nil) (hir-lower node)))
      (7 (let ((*call-source* (or (hir-node-source node) *call-source*)))
           (cond ((hir-double-arithmetic-p node) (hir-lower-double-bits node))
                 ((and (eq (hir-node-a node) 'values) (not (eq (hir-node-d node) :notinline)))
                  (loop for arg across (hir-node-b node) do (hir-lower-effect arg)))
                 (t (hir-lower node)))))
      (9 (let ((*call-source* (or (hir-node-source node) *call-source*)))
           (hir-lower-if node #'hir-lower-effect)))
      (10 (loop for form across (hir-node-a node) do (hir-lower-effect form)))
      (11 (let ((*call-source* (or (hir-node-source node) *call-source*)))
            (hir-bind-let node) (hir-lower-effect (hir-node-c node))))
      (20 (hir-lower-unwind-protect node nil #'hir-lower-effect))
      (22 (hir-lower-effect (hir-node-a node)) (hir-lower-effect (hir-node-b node)))
      (otherwise (hir-lower node)))))

(defun hir-lower-sequence (nodes)
  (if (zerop (length nodes))
      (values (nil-value) 1)
      (progn (loop for i below (1- (length nodes)) do (hir-lower-effect (svref nodes i)))
             (hir-lower-mv (svref nodes (1- (length nodes)))))))

(defun hir-ref-to-p (node var)
  (and (= (hir-node-kind node) 1) (eq (hir-node-a node) var)))

(defun hir-switch-test (node)
  (when (and (= (hir-node-kind node) 7) (eq (hir-node-a node) 'eql)
             (= (length (hir-node-b node)) 2))
    (let ((args (hir-node-b node)))
      (dotimes (i 2)
        (let ((var (svref args i)) (constant (svref args (- 1 i))))
          (when (= (hir-node-kind var) 1)
            (multiple-value-bind (key found) (constant-value constant)
              (when (and found (typep key '(signed-byte 63)))
                (return-from hir-switch-test (values (hir-node-a var) (list key) var)))))))))
  ;; OR from grouped CASE keys: (LET ((TST test)) (IF TST TST rest)).
  (when (and (= (hir-node-kind node) 11) (not (hir-node-d node)) (= (length (hir-node-a node)) 1))
    (let ((var (svref (hir-node-a node) 0)) (body (hir-node-c node)))
      (when (and (= (hir-node-kind body) 9) (hir-ref-to-p (hir-node-a body) var)
                 (hir-ref-to-p (hir-node-b body) var))
        (multiple-value-bind (left keys reference) (hir-switch-test (svref (hir-node-b node) 0))
          (when left
            (multiple-value-bind (right rest) (hir-switch-test (hir-node-c body))
              (when (eq left right) (values left (append keys rest) reference)))))))))

(defun hir-or-test (node)
  "For (LET ((TMP test)) (IF TMP TMP rest)), as OR expands into, with TMP
used nowhere else: test and rest."
  (when (and (= (hir-node-kind node) 11) (not (hir-node-d node)) (= (length (hir-node-a node)) 1))
    (let ((var (svref (hir-node-a node) 0)) (body (hir-node-c node)))
      (when (and (hir-var-p var) (eq (hir-var-type var) t) (= (hir-var-refs var) 2)
                 (zerop (logand (hir-var-flags var) 3))
                 (= (hir-node-kind body) 9)
                 (hir-ref-to-p (hir-node-a body) var) (hir-ref-to-p (hir-node-b body) var))
        (values (svref (hir-node-b node) 0) (hir-node-c body))))))

(defun hir-bind-direct-values (vars init)
  (multiple-value-bind (leaves complete) (hir-direct-values-leaves init)
    (unless complete (return-from hir-bind-direct-values nil))
    (let* ((count (length vars)) (raw (make-array count)) (types (make-array count :initial-element nil)))
      (loop for var across vars for i from 0
            do (setf (svref raw i)
                     (and (hir-double-local-p var)
                          (every (lambda (args)
                                   (and (< i (length args))
                                        (eq (hir-node-type (svref args i)) 'double-float)
                                        (or (eq (hir-var-type var) t)
                                            (hir-declaration-proven-p (hir-node-type (svref args i)) (hir-var-type var)))))
                                 leaves)))
               (dolist (args leaves)
                 (setf (svref types i) (hir-type-join (svref types i)
                                                   (if (< i (length args)) (hir-node-type (svref args i)) 'null)))))
      (unless (some #'identity raw) (return-from hir-bind-direct-values nil))
      (let ((values (map 'simple-vector (lambda (bits) (new-var (if bits :f64 :obj))) raw)))
        (labels ((produce (node)
                   (case (hir-node-kind node)
                     (9 (hir-lower-if node #'produce))
                     (11 (hir-bind-let node) (produce (hir-node-c node)))
                     (20 (hir-lower-unwind-protect node nil #'produce))
                     (22 (produce (hir-node-a node)) (hir-lower-effect (hir-node-b node)))
                     (10 (let ((forms (hir-node-a node)))
                           (loop for i below (1- (length forms)) do (hir-lower-effect (svref forms i)))
                           (produce (svref forms (1- (length forms))))))
                     (7 (let ((args (hir-node-b node)))
                          ;; Snapshot every argument before binding or checking declarations.
                          (loop for arg across args for i from 0
                                do (if (< i count)
                                       (emit `(:set ,(svref values i)
                                                    ,(if (svref raw i) (hir-lower-double-bits arg) (hir-lower arg))))
                                       (hir-lower-effect arg)))
                          (loop for i from (length args) below count
                                do (emit `(:set ,(svref values i) ,(nil-value)))))))))
          (produce init))
        (loop for var across vars for value across values for bits across raw for type across types
              do (if bits (hir-bind-double-bits var value)
                     (progn (hir-check-declaration value (hir-var-type var) type)
                            (hir-bind-variable var value t)))))
      t)))

(defun hir-bind-let (node)
  (let ((vars (hir-node-a node)) (inits (hir-node-b node)))
    (when (and (hir-node-d node) (hir-bind-direct-values vars (svref inits 0)))
      (return-from hir-bind-let nil))
    (if (hir-node-d node)
        (multiple-value-bind (v0 n) (hir-lower-mv (svref inits 0))
          ;; Read every value from ctx.values into an obj variable before
          ;; HIR-BIND-VARIABLE can allocate a cell.
          (let ((values (make-array (length vars))))
            (setf (svref values 0)
                  (copy-to-var (if (integerp n)
                                   (if (plusp n) v0 (nil-value))
                                   `(:select (:eq ,n 0) ,(nil-value) ,v0))))
            (loop for i from 1 below (length vars)
                  do (setf (svref values i)
                           (copy-to-var
                            (cond ((integerp n)
                                   (if (> n i)
                                       `(:transfer-ref ,(1- i))
                                       (nil-value)))
                                  ((> i +values-max+) (nil-value))
                                  (t `(:select (:gt ,n ,i)
                                               (:transfer-ref ,(1- i))
                                               ,(nil-value)))))))
            (loop for var across vars for value across values
                  do (hir-check-declaration value (hir-var-type var))
                     (hir-bind-variable var value t))))
        (let ((values (make-array (length vars))) (raw (make-array (length vars))))
          (loop for var across vars for init across inits for i from 0
                do (setf (svref raw i)
                         (and (hir-double-local-p var)
                              (eq (hir-node-type init) 'double-float)
                              (or (eq (hir-var-type var) t)
                                  (hir-declaration-proven-p (hir-node-type init) (hir-var-type var))))
                         (svref values i)
                         (if (svref raw i) (hir-lower-double-bits init)
                             (copy-to-var (hir-lower init)))))
          (loop for var across vars for value across values for init across inits
                for bits across raw
                do (if bits (hir-bind-double-bits var value)
                       (progn (hir-check-declaration value (hir-var-type var) (hir-node-type init))
                              (hir-bind-variable var value t))))))))

(defun hir-lower-branch (node then else)
  "Lowers NODE for its truth only: a jump to THEN or ELSE. A test that is
itself a conditional (IF, AND, OR, NOT) becomes branches, so that a
predicate inside it is branched on, not made into T or NIL and compared."
  (let ((*hir-policy* (hir-node-policy node))
        (*call-source* (or (hir-node-source node) *call-source*)))
    (hir-lower-branch-1 node then else)))

(defun hir-lower-branch-1 (node then else)
  (case (hir-node-kind node)
    (0 (jump (if (hir-node-a node) then else)))
    (9 (let ((yes (new-block)) (no (new-block)))
         (hir-lower-branch (hir-node-a node) yes no)
         (start-block yes)
         (hir-lower-branch (hir-node-b node) then else)
         (start-block no)
         (hir-lower-branch (hir-node-c node) then else)))
    (10 (let ((forms (hir-node-a node)))
          (if (zerop (length forms))
              (jump else)
              (progn
                (loop for i below (1- (length forms)) do (hir-lower (svref forms i)))
                (hir-lower-branch (svref forms (1- (length forms))) then else)))))
    (11 (multiple-value-bind (test rest) (hir-or-test node)
          (if test
              (let ((no (new-block)))
                (hir-lower-branch test then no)
                (start-block no)
                (hir-lower-branch rest then else))
              (progn
                (hir-bind-let node)
                (hir-lower-branch (hir-node-c node) then else)))))
    (7 (if (and (member (hir-node-a node) '(not null))
                (= (length (hir-node-b node)) 1))
           (hir-lower-branch (svref (hir-node-b node) 0) else then)
           (branch-on-value (hir-lower node) then else)))
    (otherwise (branch-on-value (hir-lower node) then else))))

(defun hir-lower-if (node &optional consumer)
  (let ((tail node) (definition nil) (reference nil) (arms '()))
    (loop while (= (hir-node-kind tail) 9)
          do (multiple-value-bind (var keys ref) (hir-switch-test (hir-node-a tail))
               (unless (and var (or (null definition) (eq definition var))) (return))
               (setf definition var reference ref)
               (dolist (key keys)
                 (unless (assoc key arms) (push (cons key (hir-node-b tail)) arms)))
               (setf tail (hir-node-c tail))))
    (when (>= (length arms) 3)
      (return-from hir-lower-if (lower-switch-mv reference (nreverse arms) tail consumer))))
  (let ((r (and (not consumer) (new-var))) (n (and (not consumer) (new-var :raw))) (yes (new-block)) (no (new-block)) (join (new-block)))
    (hir-lower-branch (hir-node-a node) yes no)
    (start-block yes)
    (if consumer (funcall consumer (hir-node-b node))
        (multiple-value-call #'set-mv r n (hir-lower-mv (hir-node-b node))))
    (jump join)
    (start-block no)
    (if consumer (funcall consumer (hir-node-c node))
        (multiple-value-call #'set-mv r n (hir-lower-mv (hir-node-c node))))
    (jump join)
    (start-block join)
    (if consumer (values (nil-value) 1) (values r n))))

(defun hir-lower-fixnum-arithmetic (name a b bounded &optional error-on-overflow)
  (if bounded
      (copy-to-var (case name
                     (+ `(:add ,a ,b)) (- `(:sub ,a ,b))
                     (* `(:mul (:sar ,a ,+fixnum-shift+) ,b))))
      ;; Input types do not prove that the result fits. Keep the overflow
      ;; edge and its arbitrary-precision result.
      (let ((r (new-var)) (ovf (new-var :raw)) (slow (new-block)) (done (new-block)))
        (emit (case name
                (+ `(:add-ovf ,r ,ovf ,a ,b))
                (- `(:sub-ovf ,r ,ovf ,a ,b))
                (* `(:mul-ovf ,r ,ovf (:sar ,a ,+fixnum-shift+) ,b))))
        (br ovf slow done)
        (start-block slow)
        (emit `(:set ,r ,(emit-slow-call
                         (case name (+ 'kiln.kernel::two-arg-+)
                                    (- 'kiln.kernel::two-arg--)
                                    (* 'kiln.kernel::two-arg-*)) a b)))
        (when error-on-overflow
          (emit-slow-call 'kiln.kernel::%declared-type-error r (constant-object 'fixnum)))
        (jump done) (start-block done) r)))

(defun hir-lower-small-search (node)
  (let* ((args (hir-node-b node)) (pattern nil))
    (unless (and (eq (hir-node-a node) 'search) (= (length args) 2)
                 (member (hir-node-type (svref args 1)) '(simple-vector :native-string :simple-array-vector)))
      (return-from hir-lower-small-search (values nil nil)))
    (let ((needle (svref args 0)))
      (cond ((and (= (hir-node-kind needle) 0) (hir-proper-list-p (hir-node-a needle)))
             (setf pattern (hir-node-a needle)))
            ((and (= (hir-node-kind needle) 7) (eq (hir-node-a needle) 'list)
                  (every (lambda (arg) (= (hir-node-kind arg) 0)) (hir-node-b needle)))
             (setf pattern (map 'list #'hir-node-a (hir-node-b needle))))))
    (unless (and pattern (<= (length pattern) 8)
                 (every (lambda (value) (or (symbolp value) (characterp value)
                                           (and (integerp value) (<= +hir-fixnum-min+ value +hir-fixnum-max+)))) pattern))
      (return-from hir-lower-small-search (values nil nil)))
    (let* ((vals (lower-args (coerce args 'list))) (vector (second vals))
           (limit (copy-to-var `(:sub ,(emit-slow-call 'length vector) ,(* 2 (length pattern)))))
           (index (copy-to-var 0)) (result (copy-to-var (nil-value)))
           (head (new-block)) (body (new-block)) (next (new-block)) (done (new-block)))
      (jump head) (start-block head)
      (br `(:gt ,index ,limit) done body)
      (start-block body) (emit-poll)
      (loop for value in pattern for offset from 0
            for matched = (new-block)
            for item = (emit-aref-1 vector (copy-to-var `(:add ,index ,(* 2 offset))) nil)
            do (br `(:eq ,item ,(constant-object value)) matched next)
               (start-block matched))
      (emit `(:set ,result ,index)) (jump done)
      (start-block next) (emit `(:set ,index (:add ,index 2))) (jump head)
      (start-block done)
      (values result t))))

(defun hir-double-arithmetic-p (node)
  (and (= (hir-node-kind node) 7) (not (eq (hir-node-d node) :notinline))
       (let ((name (hir-node-a node)) (count (length (hir-node-b node))))
         (or (and (= count 2) (member name '(+ - * /)))
             (and (= count 1) (member name '(- abs 1+ 1-)))))
       (every (lambda (arg) (eq (hir-node-type arg) 'double-float)) (hir-node-b node))))

(defun hir-prepare-double-locals (root)
  "Select undeclared double bindings with proven writes and bounded boxing uses."
  (let ((seen (make-hash-table :test #'eq)) (candidates (make-hash-table :test #'eq))
        (bad (make-hash-table :test #'eq)) (producers (make-hash-table :test #'eq))
        (boxed (make-hash-table :test #'eq)) (loop-reads (make-hash-table :test #'eq))
        (owner nil) (depth 0) (budget 65536) (plan (make-hash-table :test #'eq)))
    (labels ((producer (var init)
               (unless (eq (hir-node-type init) 'double-float) (setf (gethash var bad) t))
               (when (hir-double-arithmetic-p init) (incf (gethash var producers 0))))
             (function-tree (fun)
               (unless (gethash fun seen)
                 (setf (gethash fun seen) t)
                 (let ((saved owner) (saved-depth depth))
                   (setf owner fun depth 0)
                   (hir-map-function (lambda (node) (walk node nil)) fun)
                   (setf owner saved depth saved-depth))))
             (walk (node raw)
               (when (minusp (decf budget)) (return-from hir-prepare-double-locals nil))
               (case (hir-node-kind node)
                 (1 (unless (eq owner (hir-var-owner (hir-node-a node))) (setf (gethash (hir-node-a node) bad) t))
                    (unless raw
                      (incf (gethash (hir-node-a node) boxed 0))
                      (when (plusp depth) (setf (gethash (hir-node-a node) loop-reads) t))))
                 (2 (let ((var (hir-node-a node)))
                      (producer var (hir-node-b node))
                      (unless (eq owner (hir-var-owner var)) (setf (gethash var bad) t))
                      (walk (hir-node-b node) nil)))
                 (9 (walk (hir-node-a node) nil) (walk (hir-node-b node) raw) (walk (hir-node-c node) raw))
                 (10 (loop with forms = (hir-node-a node) for form across forms for i from 0
                           do (walk form (and raw (= i (1- (length forms)))))))
                 (11 (if (hir-node-d node)
                         (multiple-value-bind (leaves complete)
                             (hir-direct-values-leaves (svref (hir-node-b node) 0))
                           (when complete
                             (loop for var across (hir-node-a node) for i from 0
                                   when (and (eq (hir-var-type var) t) (not (logtest 6 (hir-var-flags var))))
                                     do (setf (gethash var candidates) t)
                                        (dolist (args leaves)
                                          (if (< i (length args)) (producer var (svref args i))
                                              (setf (gethash var bad) t))))))
                         (loop for var across (hir-node-a node) for init across (hir-node-b node)
                               when (and (eq (hir-var-type var) t) (not (logtest 6 (hir-var-flags var))))
                                 do (setf (gethash var candidates) t) (producer var init)))
                     (loop for init across (hir-node-b node) do (walk init nil))
                     (walk (hir-node-c node) raw))
                 ((6 7) (let ((owned (hir-own-function node))) (when owned (function-tree owned)))
                  (when (hir-node-p (hir-node-a node)) (walk (hir-node-a node) nil))
                  (when (= (hir-node-kind node) 7)
                    (let* ((name (hir-node-a node)) (args (hir-node-b node))
                           (bits (or (hir-double-arithmetic-p node)
                                     (and (not (eq (hir-node-d node) :notinline))
                                          (or (and (= (length args) 2) (member name '(< > <= >= = /=)))
                                              (and (= (length args) 1) (member name '(zerop plusp minusp))))
                                          (every (lambda (arg) (eq (hir-node-type arg) 'double-float)) args)))))
                      (loop for arg across args do (walk arg bits)))))
                 (13 (loop for fun across (hir-node-a node) do (function-tree fun)) (walk (hir-node-b node) nil))
                 (16 (incf depth) (hir-map-children (lambda (child) (walk child nil)) node) (decf depth))
                 ((20 22) (walk (hir-node-a node) raw) (walk (hir-node-b node) nil))
                 (23 (walk (hir-node-b node) raw))
                 (24 (function-tree (hir-node-a node)))
                 (otherwise (hir-map-children (lambda (child) (walk child nil)) node)))))
      (function-tree root))
    (maphash (lambda (var ignored)
               (declare (ignore ignored))
               (when (and (not (gethash var bad)) (not (gethash var loop-reads))
                          (plusp (gethash var producers 0))
                          (<= (gethash var boxed 0) (gethash var producers 0)))
                 (setf (gethash var plan) t))) candidates)
    plan))

(defun hir-lower-double-bits (node)
  (let ((*hir-policy* (hir-node-policy node)))
    (case (hir-node-kind node)
      (2 (when (hir-raw-double-variable-p (hir-node-a node))
           (return-from hir-lower-double-bits (hir-lower-assignment node t t))))
      (7 (when (and (eq (hir-node-a node) 'values) (not (eq (hir-node-d node) :notinline))
                    (plusp (length (hir-node-b node))))
           (let* ((args (hir-node-b node)) (result (hir-lower-double-bits (svref args 0))))
             (loop for i from 1 below (length args) do (hir-lower-effect (svref args i)))
             (return-from hir-lower-double-bits result))))
      (9 (let ((result (new-var :f64)))
           (hir-lower-if node (lambda (branch)
                              (emit `(:set ,result ,(hir-lower-double-bits branch)))))
           (return-from hir-lower-double-bits result)))
      (10 (let ((forms (hir-node-a node)))
            (when (plusp (length forms))
              (loop for i below (1- (length forms)) do (hir-lower-effect (svref forms i)))
              (return-from hir-lower-double-bits
                (hir-lower-double-bits (svref forms (1- (length forms))))))))
      (11 (hir-bind-let node)
          (return-from hir-lower-double-bits (hir-lower-double-bits (hir-node-c node))))
      (14 (unless (logtest 1 (hir-exit-flags (hir-node-a node)))
            (return-from hir-lower-double-bits (hir-lower-double-block node))))
      (20 (return-from hir-lower-double-bits (hir-lower-unwind-protect node t)))
      (22 (let ((result (hir-lower-double-bits (hir-node-a node))))
            (hir-lower-effect (hir-node-b node))
            (return-from hir-lower-double-bits result)))
      (23 (return-from hir-lower-double-bits (hir-lower-double-bits (hir-node-b node)))))
    (when (and (= (hir-node-kind node) 1) (not (hir-node-c node))
               (hir-raw-double-variable-p (hir-node-a node)))
      (return-from hir-lower-double-bits (copy-to-var (hir-variable-operand (hir-node-a node)) :f64)))
    (if (hir-double-arithmetic-p node)
        (let* ((args (hir-node-b node)) (name (hir-node-a node))
               (left (hir-lower-double-bits (svref args 0))))
          (if (= (length args) 2)
              (let ((right (hir-lower-double-bits (svref args 1))))
                (when (eq name '/)
                  (let ((zero (new-block)) (divide (new-block)))
                    (br `(:eq (:and ,right #x7fffffffffffffff) 0) zero divide)
                    (start-block zero)
                    (emit-error +err-division-by-zero+ (hir-box-double-bits left))
                    (jump divide)
                    (start-block divide)))
                (copy-to-var `(,(case name (+ :f64-add) (- :f64-sub) (* :f64-mul) (/ :f64-div))
                              ,left ,right) :f64))
              (case name
                (- (copy-to-var `(:xor ,left ,(- #x8000000000000000)) :f64))
                (abs (copy-to-var `(:and ,left #x7fffffffffffffff) :f64))
                (otherwise
                 (copy-to-var `(,(if (eq name '1+) :f64-add :f64-sub)
                               ,left #x3ff0000000000000) :f64)))))
        (let ((object (hir-lower node)))
          (copy-to-var `(:load ,object ,(- 8 +tag-general+)) :f64)))))

(defun hir-lower-typed-call (node)
  "Return a primary value and a success flag without partially lowering an
unsupported call. Arguments retain their evaluation order and effects."
  (when (eq (hir-node-a node) 'search)
    (multiple-value-bind (value specialized) (hir-lower-small-search node)
      (when specialized (return-from hir-lower-typed-call (values value t)))))
  (let* ((name (hir-node-a node)) (args (hir-node-b node)) (count (length args)))
    (when (= count 1)
      (multiple-value-bind (truth known) (hir-type-predicate name (hir-node-type (svref args 0)))
        (when known
          (hir-lower (svref args 0))
          (return-from hir-lower-typed-call (values (constant-object truth) t)))))
    (when (and (= count 1) (member name '(zerop plusp minusp))
               (hir-fixnum-type-p (hir-node-type (svref args 0))))
      (let ((value (copy-to-var (hir-lower (svref args 0)))))
        (return-from hir-lower-typed-call
          (values (boolean-value `(,(case name (zerop :eq) (plusp :gt) (minusp :lt)) ,value 0)) t))))
    (when (and (= count 1) (not (eq (hir-node-d node) :notinline))
               (member name '(zerop plusp minusp))
               (eq (hir-node-type (svref args 0)) 'double-float))
      (let* ((bits (hir-lower-double-bits (svref args 0)))
             ;; Mixed comparison with integer zero maps non-finite floats to zero.
             (comparison (copy-to-var `(:select (:eq (:and ,bits #x7ff0000000000000) #x7ff0000000000000)
                                               0 (:f64-compare ,bits 0)) :raw)))
        (return-from hir-lower-typed-call
          (values (boolean-value `(,(case name (zerop :eq) (plusp :gt) (minusp :lt))
                                  ,comparison 0)) t))))
    (when (and (= count 1) (member name '(car cdr))
               (member (hir-node-type (svref args 0)) '(cons null)))
      (let ((value (copy-to-var (hir-lower (svref args 0)))))
        (return-from hir-lower-typed-call
          (values (if (eq (hir-node-type (svref args 0)) 'null) (nil-value)
                      (copy-to-var `(:field-load ,(if (eq name 'car) kiln.kir::+packet-field-cons-car+ kiln.kir::+packet-field-cons-cdr+) ,value))) t))))
    (when (and (= count 1) (eq name 'char-code)
               (eq (hir-node-type (svref args 0)) 'character))
      (let ((value (copy-to-var (hir-lower (svref args 0)))))
        (return-from hir-lower-typed-call
          (values (copy-to-var `(:shl (:shr ,value ,+character-shift+) ,+fixnum-shift+)) t))))
    (when (and (= count 1) (member name '(1+ 1-))
               (hir-fixnum-type-p (hir-node-type (svref args 0))))
      (let ((value (copy-to-var (hir-lower (svref args 0)))))
        (return-from hir-lower-typed-call
          (values (hir-lower-fixnum-arithmetic
                   (if (eq name '1+) '+ '-) value (ash 1 +fixnum-shift+)
                   (hir-fixnum-type-p (hir-node-type node))) t))))
    (when (and (= count 2) (not (eq (hir-node-d node) :notinline))
               (member name '(< > <= >= = /=))
               (every (lambda (arg) (eq (hir-node-type arg) 'double-float)) args))
      (let* ((left (hir-lower-double-bits (svref args 0)))
             (right (hir-lower-double-bits (svref args 1)))
             (comparison (copy-to-var `(:f64-compare ,left ,right) :raw)))
        (return-from hir-lower-typed-call
          (values (boolean-value `(,(case name (< :lt) (> :gt) (<= :le) (>= :ge) (= :eq) (/= :ne))
                                  ,comparison 0)) t))))
    (when (hir-double-arithmetic-p node)
      (let ((bits (hir-lower-double-bits node)))
        (return-from hir-lower-typed-call
          (values (emit-fixed-object kiln.kir::+packet-class-double+ (list bits)) t))))
    (when (and (= count 2)
               (hir-fixnum-type-p (hir-node-type (svref args 0)))
               (hir-fixnum-type-p (hir-node-type (svref args 1)))
               (member name '(+ - * < > <= >= = /= logand logior logxor)))
      (let* ((vals (lower-args (coerce args 'list))) (a (first vals)) (b (second vals)))
        (return-from hir-lower-typed-call
          (values
           (cond
             ((member name '(+ - *))
              (hir-lower-fixnum-arithmetic name a b (hir-fixnum-type-p (hir-node-type node))))
             ((member name '(logand logior logxor))
              (copy-to-var `(,(case name (logand :and) (logior :or) (logxor :xor)) ,a ,b)))
             (t (boolean-value `(,(case name (< :lt) (> :gt) (<= :le) (>= :ge) (= :eq) (/= :ne))
                                 ,a ,b))))
           t))))
    (when (and (= count 2) (member name '(aref svref elt))
               (eq (hir-node-type (svref args 0)) 'simple-vector))
      (let* ((vals (lower-args (coerce args 'list))) (v (first vals)) (i (second vals)))
        (return-from hir-lower-typed-call
          (values (emit-svref-fast-path
                   v i (lambda () `(:vector-ref ,v (:fixnum-untag ,i)))
                   (lambda () (emit-slow-call 'svref v i)) t) t))))
    (when (and (= count 3) (member name '((setf aref) (setf svref) (setf elt)) :test #'equal)
               (eq (hir-node-type (svref args 1)) 'simple-vector))
      (let* ((vals (lower-args (coerce args 'list))) (x (first vals)) (v (second vals)) (i (third vals)))
        (return-from hir-lower-typed-call
          (values (emit-svref-fast-path
                   v i (lambda () (emit `(:vector-set ,v (:fixnum-untag ,i) ,x)) x)
                   (lambda () (emit-slow-call name x v i)) t) t))))
    (when (and (= count 1) (eq name 'length)
               (member (hir-node-type (svref args 0)) '(simple-vector :native-string)))
      (let ((value (copy-to-var (hir-lower (svref args 0)))))
        (return-from hir-lower-typed-call (values (copy-to-var (vector-length value)) t))))
    (when (or (and (= count 2) (member name '(aref char schar elt))
                   (eq (hir-node-type (svref args 0)) :native-string))
              (and (= count 3) (member name '((setf aref) (setf char) (setf schar) (setf elt)) :test #'equal)
                   (eq (hir-node-type (svref args 1)) :native-string)))
      (let* ((vals (lower-args (coerce args 'list))) (store (= count 3))
             (string (if store (second vals) (first vals))) (index (if store (third vals) (second vals))))
        (return-from hir-lower-typed-call
          (values (emit-schar string index (and store (first vals)) name t) t))))
    (when (or (and (= count 2) (eq name 'elt)
                   (eq (hir-node-type (svref args 0)) :simple-array-vector))
              (and (= count 3) (equal name '(setf elt))
                   (eq (hir-node-type (svref args 1)) :simple-array-vector)))
      (let* ((vals (lower-args (coerce args 'list))) (store (= count 3)))
        (return-from hir-lower-typed-call
          (values (emit-aref-1 (if store (second vals) (first vals))
                              (if store (third vals) (second vals))
                              (and store (first vals))) t))))
    (values nil nil)))

(defun hir-lower-call (node)
  (let ((slot (cdr (assoc node *hir-stack-slots* :test #'eq))))
    (when slot
      (let ((args (lower-args (coerce (hir-node-b node) 'list))))
        (emit `(:store (:slot ,slot) 8 ,(first args)))
        (emit `(:store (:slot ,slot) 16 ,(second args)))
        (return-from hir-lower-call (values (copy-to-var `(:add (:slot ,slot) ,+tag-cons+)) 1)))))
  (multiple-value-bind (value specialized) (hir-lower-typed-call node)
    (when specialized (return-from hir-lower-call (values value 1))))
  (let ((callee (hir-node-a node)) (args (coerce (hir-node-b node) 'list)))
    (cond ((or (symbolp callee) (consp callee)) (lower-global-call callee args))
          (t
           (when (> (length args) (+ +reg-args+ +values-max+))
             (fail "HIR call has too many arguments: ~D" (length args)))
           (let* ((object (if (hir-fun-p callee) (hir-lower-function callee)
                              (copy-to-var (hir-lower callee))))
                  (arguments (lower-args args))
                  (values (append (when (hir-fun-p callee)
                                    (loop for var across (or (hir-lifted-environment callee) #())
                                          collect (hir-variable-operand var)))
                                  arguments)))
             (if (hir-node-p callee)
                 (emit-lisp-call (emit-function-designator object) values)
                 (let ((r (new-var)) (n (new-var :raw)))
                   (loop for value in (nthcdr +reg-args+ values) for i from 0
                         do (emit `(:transfer-set ,i ,value)))
                   (emit `(:call-lisp ,r ,n (:addr ,(hir-function-label callee))
                                      (:ctx ,object ,(length values)
                                            ,@(subseq values 0 (min (length values) +reg-args+)))
                                      ,(handler) ,@(call-loc)))
                   (values r n))))))))

(defun hir-check-declaration (value type &optional (actual t))
  (unless (or (zerop (hir-policy-quality *hir-policy* :safety))
              (eq (hir-declaration-type type) t) (hir-declaration-proven-p actual type))
    (let* ((bad (new-block)) (done (new-block)) (expanded (hir-declaration-expanded type))
           (test (if (inline-typep-specifier-p expanded)
                     (emit-inline-typep value expanded)
                     (emit-slow-call 'typep value (constant-object expanded)))))
      (br `(:eq ,test ,(nil-value)) bad done)
      (start-block bad)
      (emit-slow-call 'kiln.kernel::%declared-type-error value (constant-object (hir-declaration-original type)))
      (jump done) (start-block done)))
  value)

(defun hir-lower-reference (node)
  (let ((value (hir-variable-value (hir-node-a node))))
    (when (hir-node-c node) (hir-check-declaration value (hir-node-b node)))
    value))

(defun hir-lower-assignment (node &optional (value-needed t) double-primary)
  (let* ((var (hir-node-a node)) (init (hir-node-b node))
         (*call-source* (or (hir-node-source init) *call-source*)))
    (when (hir-raw-double-variable-p var)
      (let ((bits (if (or (eq (hir-var-type var) t)
                           (hir-declaration-proven-p (hir-node-type init) (hir-var-type var)))
                      (hir-lower-double-bits init)
                      (let ((value (hir-lower init)))
                        (hir-check-declaration value (hir-var-type var) (hir-node-type init))
                        (copy-to-var `(:load ,value ,(- 8 +tag-general+)) :raw)))))
        (emit `(:set ,(hir-variable-operand var) ,bits))
        (return-from hir-lower-assignment
          (cond (double-primary bits) (value-needed (hir-box-double-bits bits)) (t (nil-value))))))
    ;; A checked fixnum destination can share arithmetic's overflow edge.
    ;; Construct the full result there so TYPE-ERROR retains its datum.
    (when (and (plusp (hir-policy-quality *hir-policy* :safety))
               (eq (hir-var-type var) 'fixnum) (= (hir-node-kind init) 7))
      (let* ((name (hir-node-a init)) (args (hir-node-b init)) (count (length args)))
        (when (and (or (and (= count 1) (member name '(1+ 1-)))
                       (and (= count 2) (member name '(+ - *))))
                   (every (lambda (arg) (hir-fixnum-type-p (hir-node-type arg))) args))
          (let* ((values (lower-args (coerce args 'list)))
                 (a (first values)) (b (if (= count 1) (ash 1 +fixnum-shift+) (second values)))
                 (op (case name (1+ '+) (1- '-) (otherwise name)))
                 (value (hir-lower-fixnum-arithmetic op a b
                                                  (hir-fixnum-type-p (hir-node-type init)) t)))
            (return-from hir-lower-assignment (hir-set-variable var value 'fixnum))))))
    (hir-set-variable var (copy-to-var (hir-lower init)) (hir-node-type init))))

(defun hir-lower-mv (node)
  (let ((*hir-policy* (hir-node-policy node))
        (*call-source* (or (hir-node-source node) *call-source*)))
    (multiple-value-bind (value count)
        (case (hir-node-kind node)
          (0 (constant-object (hir-node-a node)))
          (1 (hir-lower-reference node))
          (2 (hir-lower-assignment node))
          (3 (let* ((symbol (constant-object (hir-node-a node))) (value (emit-symbol-value symbol)))
               (emit-check-bound value symbol) value))
          (4 (let ((value (copy-to-var (hir-lower (hir-node-b node)))))
               (emit-set-symbol-value (constant-object (hir-node-a node)) value) value))
          (5 (function-cell-value (hir-node-a node)))
          (6 (hir-lower-function (hir-node-a node)))
          (7 (hir-lower-call node))
          (8 (funcall (gethash (hir-node-b node) *primops*) (lower-args (coerce (hir-node-a node) 'list))))
          (9 (hir-lower-if node))
          (10 (hir-lower-sequence (hir-node-a node)))
          (11 (hir-bind-let node)
              (hir-lower-mv (hir-node-c node)))
          (12 (hir-with-binding (hir-node-a node) (copy-to-var (hir-lower (hir-node-b node)))
                               (lambda () (hir-lower-mv (hir-node-c node)))))
          (13 (hir-lower-local-functions node))
          (14 (hir-lower-block node))
          (15 (hir-lower-return node))
          (16 (hir-lower-tagbody node))
          (17 (hir-lower-go node))
          (18 (hir-lower-catch node))
          (19 (hir-lower-throw node))
          (20 (hir-lower-unwind-protect node))
          (21 (let ((callee (hir-node-a node)))
                (if (and (= (hir-node-kind callee) 5) (eq (hir-node-a callee) 'list))
                    (let ((acc (nil-value)))
                      (loop for form across (hir-node-b node)
                            do (multiple-value-bind (v n) (hir-lower-mv form)
                                 (setf acc (emit-push-values v n acc))))
                      (emit-nreverse acc))
                    (let ((function (copy-to-var (hir-lower callee))) (acc (nil-value)))
                      (loop for form across (hir-node-b node)
                            do (multiple-value-bind (v n) (hir-lower-mv form)
                                 (setf acc (emit-push-values v n acc))))
                      (emit-apply (emit-function-designator function) (emit-nreverse acc))))))
          (22 (multiple-value-bind (v n) (hir-lower-mv (hir-node-a node))
                (let ((saved (emit-save-values v n)))
                  (hir-lower-effect (hir-node-b node)) (emit-restore-values saved n))))
          (23 (hir-lower-mv (hir-node-b node)))
          (24 (copy-to-var `(:load (:addr ,(hir-node-c node)) 0)))
          (25 (hir-lower-progv node))
          (otherwise (fail "Unknown HIR kind ~S" (hir-node-kind node))))
      (values value (or count 1)))))

(defmethod lower ((node hir-node)) (hir-lower node))
(defmethod lower-mv ((node hir-node)) (hir-lower-mv node))

(defun hir-lower-block (ast)
  (let* ((def (hir-node-a ast))
         (body (list (hir-node-b ast)))
         (nonlocal (logtest 1 (hir-exit-flags def)))
         (exit (new-block)) (r (new-var)) (n (new-var :raw)))
    (setf (hir-exit-lowering def)
          (make-exit-info :func *func* :regions *regions* :exit exit :result r :count n))
    (if (not nonlocal)
        (progn
          (bind-var (hir-exit-token (hir-node-a ast)) 0 :name nil)
          (multiple-value-call #'set-mv r n (lower-progn-mv body))
          (jump exit))
        (let* ((token (emit-exit-token))
               (region (establish-entry :exit-point token))
               (land (new-block)))
          (bind-var (hir-exit-token (hir-node-a ast)) token :name nil)
          (let ((*regions* (cons region *regions*)))
            (multiple-value-call #'set-mv r n (lower-progn-mv body)))
          (pop-entry region)
          (jump exit)
          (start-dispatch region land)
          ;; The runtime has unlinked the entry.
          (start-block land)
          (multiple-value-call #'set-mv r n (emit-landed-values))
          (jump exit)))
    (start-block exit)
    (values r n)))

(defun hir-lower-double-block (node)
  (let ((def (hir-node-a node)) (exit (new-block)) (result (new-var :f64)))
    (setf (hir-exit-lowering def)
          (make-exit-info :func *func* :regions *regions* :exit exit
                          :result result :double-primary t))
    (bind-var (hir-exit-token def) 0 :name nil)
    (emit `(:set ,result ,(hir-lower-double-bits (hir-node-b node))))
    (jump exit)
    (start-block exit)
    result))

(defun hir-lower-return (ast)
  (let ((info (hir-exit-lowering (hir-node-a ast))))
    (when (and (eq (exit-info-func info) *func*) (exit-info-double-primary info))
      (let ((value (hir-lower-double-bits (hir-node-b ast))))
        (emit-local-exit (exit-info-regions info))
        (emit `(:set ,(exit-info-result info) ,value))
        (jump (exit-info-exit info)))
      (return-from hir-lower-return (nil-value)))
    (if (eq (exit-info-func info) *func*)
        (multiple-value-bind (v n) (lower-or-nil-mv (hir-node-b ast))
          (let ((r (exit-info-result info)) (rn (exit-info-count info))
                (target (exit-info-regions info)))
            (if (loop for rs on *regions*
                      until (eq rs target)
                      thereis (eq (region-kind (first rs)) :unwind-protect))
                ;; Cleanups run on the way out: keep the values safe.
                (let ((saved (emit-save-values v n)))
                  (emit-local-exit target)
                  (multiple-value-call #'set-mv r rn (emit-restore-values saved n)))
                (progn
                  (set-mv r rn v n)
                  (emit-local-exit target)))
            (jump (exit-info-exit info))))
        (multiple-value-bind (v packed)
            (multiple-value-call #'emit-unwind-values (lower-or-nil-mv (hir-node-b ast)))
          (let ((token (hir-variable-value (hir-exit-token (hir-exit-group (hir-node-a ast))))))
            (emit `(:call-rt ,(rt-exit-to) () (:ctx ,token ,v ,packed) ,(handler)))
            (emit-error +err-expired-exit+ token))))
    (nil-value)))


(defun hir-lower-catch (ast)
  (let* ((tv (lower (hir-node-a ast)))
         (r (new-var)) (n (new-var :raw)) (exit (new-block)) (land (new-block))
         (region (establish-entry :catch tv)))
    (let ((*regions* (cons region *regions*)))
      (multiple-value-call #'set-mv r n (lower-progn-mv (list (hir-node-b ast)))))
    (pop-entry region)
    (jump exit)
    (start-dispatch region land)
    ;; The runtime has unlinked the entry.
    (start-block land)
    (multiple-value-call #'set-mv r n (emit-landed-values))
    (jump exit)
    (start-block exit)
    (values r n)))

(defun hir-lower-throw (ast)
  (let ((tv (copy-to-var (lower (hir-node-a ast)))))
    (multiple-value-bind (vv packed)
        (multiple-value-call #'emit-unwind-values (lower-mv (hir-node-b ast)))
      (emit `(:call-rt ,(rt-throw) () (:ctx ,tv ,vv ,packed) ,(handler))))
    (emit-error +err-no-catch-tag+ tv)
    (nil-value)))

(defun hir-lower-unwind-protect (ast &optional double-primary producer)
  (let* ((cleanup (list (hir-node-b ast)))
         (r (and (not producer) (new-var (if double-primary :f64 :obj))))
         (n (and (not producer) (not double-primary) (new-var :raw))) (cont (new-block)) (land (new-block))
         (region (establish-entry :unwind-protect)))
    (setf (region-cleanup region) cleanup)
    (multiple-value-bind (v nv)
        (let ((*regions* (cons region *regions*)))
          (cond (producer (funcall producer (hir-node-a ast)) (values (nil-value) 1))
                (double-primary (values (hir-lower-double-bits (hir-node-a ast)) 1))
                (t (lower-mv (hir-node-a ast)))))
      (pop-entry region)
      (cond (producer (hir-lower-effect (hir-node-b ast)))
            (double-primary
             (emit `(:set ,r ,v))
             (hir-lower-effect (hir-node-b ast)))
            (cleanup
             (let ((saved (emit-save-values v nv)))
               (hir-lower-effect (hir-node-b ast))
               (multiple-value-call #'set-mv r n (emit-restore-values saved nv))))
            (t (set-mv r n v nv))))
    (jump cont)
    (start-dispatch region land)
    ;; Entered by an unwind passing through: the entry stays linked, marked
    ;; as running its cleanup, with the pending target in it. The cleanup
    ;; runs in a region that only unlinks it on a local exit; calls in it
    ;; use the outer handler.
    (start-block land)
    (let ((*regions* (cons (make-region :kind :cleanup-running :slot (region-slot region)
                                        :handler (let ((outer (find-if #'region-handler *regions*)))
                                                   (and outer (region-handler outer)))
                                        :outer *regions*)
                           *regions*)))
      (hir-lower-effect (hir-node-b ast)))
    (emit `(:call-rt ,(rt-continue-unwind) () (:ctx (:slot ,(region-slot region))) ,(handler)))
    (emit '(:trap))
    (start-block cont)
    (values (or r (nil-value)) (or n 1))))


(defun hir-lower-progv (ast)
  (let* ((symbols (copy-to-var (lower (hir-node-a ast))))
         (vals (copy-to-var (lower (hir-node-b ast))))
         (saved (copy-to-var (nil-value))))
    (emit-check-proper-list symbols)
    (emit-check-proper-list vals)
    ;; Save the old values first, then link the entry, then bind: an
    ;; unwind then always finds the complete list.
    (let ((cur (copy-to-var symbols))
          (head (new-block)) (body (new-block)) (done (new-block)))
      (jump head)
      (start-block head)
      (br `(:eq ,cur ,(nil-value)) done body)
      (start-block body)
      (let* ((sym (copy-to-var `(:field-load ,kiln.kir::+packet-field-cons-car+ ,cur)))
             (index (progn (emit-check-symbol sym) (emit-tls-index sym)))
             (old (copy-to-var `(:load (:add (:load :ctx ,+ctx-tls+) (:shl ,index 2)) 0))))
        (emit `(:set ,saved ,(emit-cons (emit-cons sym old) saved))))
      (emit `(:set ,cur (:field-load ,kiln.kir::+packet-field-cons-cdr+ ,cur)))
      (jump head)
      (start-block done))
    (let ((region (establish-entry :progv saved))
          (cur (copy-to-var symbols)) (vcur (copy-to-var vals))
          (head (new-block)) (body (new-block)) (done (new-block))
          (r (new-var)) (n (new-var :raw)))
      (jump head)
      (start-block head)
      (br `(:eq ,cur ,(nil-value)) done body)
      (start-block body)
      ;; Symbols without a value become unbound.
      (let ((v (copy-to-var `(:select (:eq ,vcur ,(nil-value)) ,+unbound+ (:field-load ,kiln.kir::+packet-field-cons-car+ ,vcur)))))
        (emit `(:store (:add (:load :ctx ,+ctx-tls+)
                             (:shl (:field-load ,kiln.kir::+packet-field-symbol-tls-index+ (:field-load ,kiln.kir::+packet-field-cons-car+ ,cur)) 2))
                       0 ,v)))
      (emit `(:set ,cur (:field-load ,kiln.kir::+packet-field-cons-cdr+ ,cur)))
      (emit `(:set ,vcur (:select (:eq ,vcur ,(nil-value)) ,vcur (:field-load ,kiln.kir::+packet-field-cons-cdr+ ,vcur))))
      (jump head)
      (start-block done)
      (let ((*regions* (cons region *regions*)))
        (multiple-value-call #'set-mv r n (lower-progn-mv (list (hir-node-c ast)))))
      (emit-unbind-progv region)
      (pop-entry region)
      (values r n))))


(defun hir-lower-tagbody (node)
  (let* ((segments (hir-node-a node)) (group (hir-node-b node))
         (nonlocal (logtest 1 (hir-exit-flags group)))
         (blocks (map 'simple-vector (lambda (s) (declare (ignore s)) (new-block)) segments))
         (exit (new-block)) (token (and nonlocal (emit-exit-token)))
         (region (and nonlocal (establish-entry :exit-point token)))
         (inner (if region (cons region *regions*) *regions*)))
    (when token (bind-var (hir-exit-token group) token :name nil))
    (loop for segment across segments for block across blocks
          do (setf (hir-exit-lowering (car segment))
                   (make-exit-info :func *func* :regions inner :block block)))
    (let ((*regions* inner))
      (jump (if (plusp (length blocks)) (svref blocks 0) exit))
      (loop for segment across segments for block across blocks for i from 0
            do (start-block block)
               (emit-poll)
               (hir-lower-effect (cdr segment))
               (jump (if (< (1+ i) (length blocks)) (svref blocks (1+ i)) exit))))
    (when region
      (let ((land (new-block)) (bad (new-block)))
        (start-dispatch region land)
        (start-block land)
        (emit `(:store :ctx ,+ctx-dynenv+ (:slot ,(region-slot region))))
        (emit `(:switch (:sar :exn1 ,+fixnum-shift+) ,(kiln.kir::kblock-name bad)
                        ,(loop for block across blocks for i from 0
                               collect (list i (kiln.kir::kblock-name block)))))
        (start-block bad)
        (emit '(:trap))))
    (start-block exit)
    (when region (pop-entry region))
    (nil-value)))

(defun hir-lower-go (node)
  (let* ((exit (hir-node-a node)) (info (hir-exit-lowering exit)))
    (if (eq (exit-info-func info) *func*)
        (progn (emit-local-exit (exit-info-regions info)) (jump (exit-info-block info)))
        (let ((token (hir-variable-value (hir-exit-token (hir-exit-group exit)))))
          (emit `(:call-rt ,(rt-exit-to) () (:ctx ,token ,(ash (hir-exit-index exit) +fixnum-shift+) 0) ,(handler)))
          (emit-error +err-expired-exit+ token)))
    (nil-value)))

(defun hir-lower-toplevel (fun)
  (hir-prepare-native-environments fun)
  (let ((*hir-lowering-function* fun) (*hir-closure-layout* (hir-native-environment fun))
        (*hir-stack-conses* (hir-prepare-stack-conses fun))
        (*hir-stack-closures* (hir-prepare-stack-closures fun))
        (*hir-stack-rests* (hir-prepare-stack-rests fun))
        (*hir-inferred-double-locals* (hir-prepare-double-locals fun)))
    (loop for ltv across (hir-vector (hir-fun-load-time-values fun))
          for cell = (fresh-label "kiln_hir_ltv_")
          do (setf (kiln.kir::kmodule-replayable-p *module*) nil)
             (setf (hir-node-c ltv) cell)
             (module-data cell '(:words 0))
             (module-root cell 0)
             (let ((function (hir-lower-function (hir-node-a ltv))))
               (emit `(:store (:addr ,cell) 0 ,(emit-lisp-call function '())))))
    (hir-with-stack-storage fun (lambda () (hir-lower (hir-fun-body fun))))))
