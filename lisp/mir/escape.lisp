(in-package #:kiln.compiler)

(defstruct mir-storage-analysis points fields (escaped 0) (stack 0) (cyclic 0))

(defun mir-cons-allocation-p (instruction)
  (and (= (mir-instruction-kind instruction) 6) (eq (mir-instruction-data instruction) 'cons)
       (= (length (mir-instruction-operands instruction)) 2)))

(defun mir-borrow-call-p (instruction)
  "Calls lowered directly to operations that cannot retain their arguments."
  (and (= (mir-instruction-kind instruction) 6) (not (mir-instruction-notinline instruction))
       (let ((name (mir-instruction-data instruction)) (count (length (mir-instruction-operands instruction))))
         (or (eq name 'values)
             (and (zerop count) (member name '(kiln.sys:%gc kiln.sys:%gc-count)))
             (and (= count 1) (member name '(identity car cdr first rest consp listp atom null not)))
             (and (= count 2) (member name '(cons rplaca rplacd eq eql)))))))

(defun mir-cyclic-blocks (function)
  (mir-analysis function :cyclic
    (lambda (function)
      (let* ((blocks (hir-vector (mir-function-blocks function)))
             (outgoing (map 'simple-vector
                            (lambda (block) (map 'list #'mir-edge-target
                                               (mir-terminator-edges (mir-block-terminator block)))) blocks))
             (cyclic 0))
        (dolist (component (mir-strong-components outgoing))
          (when (or (cdr component) (member (car component) (svref outgoing (car component))))
            (dolist (id component) (setf cyclic (logior cyclic (ash 1 id))))))
        cyclic))))

(defstruct mir-parameter-summary (required 0) (maximum 0) (borrow 0) returns effects)

(defun mir-known-borrow-call (instruction borrows identities)
  (when (and borrows identities (= (mir-instruction-kind instruction) 7))
    (let ((target (svref identities (svref (mir-instruction-operands instruction) 0))))
      (when (integerp target)
        (let ((summary (svref borrows target)))
          (when (and (<= (mir-parameter-summary-required summary)
                         (1- (length (mir-instruction-operands instruction))))
                     (or (null (mir-parameter-summary-maximum summary))
                         (<= (1- (length (mir-instruction-operands instruction)))
                             (mir-parameter-summary-maximum summary)))) summary))))))

(defun mir-storage-field (fields receivers tail)
  (let ((result (logand receivers 1)))
    (dotimes (id (length fields) result)
      (when (and (svref fields id) (logbitp (1+ id) receivers))
        (setf result (logior result (if tail (cdr (svref fields id)) (car (svref fields id)))))))))

(defun mir-storage-resolve (fields points path)
  (dolist (selector path points)
    (if (eq selector :reachable)
        (loop for before = points
              do (setf points (logior points (mir-storage-field fields points nil)
                                     (mir-storage-field fields points t)))
              until (= before points))
        (setf points (mir-storage-field fields points (eq selector :cdr))))))

(defun mir-compute-storage (function types packets &key borrows identities parameters)
  "Prove acyclic cons sites whose identities never enter heap storage."
  (let* ((instructions (hir-vector (mir-function-instructions function)))
         (blocks (hir-vector (mir-function-blocks function)))
         (points (make-array (hir-buffer-count (mir-function-values function)) :initial-element 0))
         (offset (length instructions))
         (fields (make-array (+ offset (if parameters (mir-function-positional-count function) 0)) :initial-element nil))
         (definitions (mir-value-definitions function))
         (parameter-mask 0)
         (reachable (mir-reachable-blocks function)) (cyclic (mir-cyclic-blocks function))
         (sites 0) (escaped 0) (changed t))
    (when parameters
      (dotimes (index (mir-function-positional-count function))
        (let ((bit (ash 1 (+ 1 offset index))))
          (setf (svref fields (+ offset index)) (cons bit bit)
                parameter-mask (logior parameter-mask bit)))))
    ;; Bit zero represents an object from outside this allocation graph.
    ;; Site N uses bit N+1, leaving unknown receivers distinguishable from
    ;; a union of known local objects when checking field stores.
    (loop for block across blocks when (logbitp (mir-block-id block) reachable) do
      (loop for id across (hir-vector (mir-block-instructions block))
            for instruction = (svref instructions id) when (mir-cons-allocation-p instruction) do
        (setf (svref fields id) (cons 0 0) sites (logior sites (ash 1 (1+ id))))
        (when (or (logbitp (mir-block-id block) cyclic)
                  (mir-instruction-notinline instruction)
                  (not (hir-policy-optimize-p (mir-instruction-policy instruction))))
          (setf escaped (logior escaped (ash 1 (1+ id)))))))
    (labels ((merge-points (id bits)
               (let ((joined (logior (svref points id) bits)))
                 (unless (= joined (svref points id)) (setf (svref points id) joined changed t))))
             (field-value (receivers tail) (mir-storage-field fields receivers tail))
             (store-field (receivers value tail &optional self)
               (when (and (not self) (logbitp 0 receivers)) (setf escaped (logior escaped value)))
               (dotimes (id (length fields))
                 (when (and (svref fields id) (logbitp (1+ id) receivers))
                   (let* ((pair (svref fields id)) (old (if tail (cdr pair) (car pair)))
                          (joined (logior old (if self (ash 1 (1+ id)) value))))
                     (unless (= old joined)
                       (if tail (setf (cdr pair) joined) (setf (car pair) joined))
                       (setf changed t))))))
             (local-call (instruction summary)
               (let ((args (mir-instruction-operands instruction)) (result 1))
                 (dolist (effect (mir-parameter-summary-effects summary))
                   (when (< (car (first effect)) (1- (length args)))
                     (let* ((path (first effect))
                            (receiver (mir-storage-resolve fields (svref points (svref args (1+ (car path)))) (cdr path))))
                       (store-field receiver 1 (eq (second effect) :cdr) (third effect)))))
                 (dolist (path (mir-parameter-summary-returns summary) result)
                   (when (and (< (car path) (1- (length args)))
                              (logbitp (car path) (mir-parameter-summary-borrow summary)))
                     (setf result (logior result
                                   (mir-storage-resolve fields (svref points (svref args (1+ (car path))))
                                                        (cdr path))))))))
             (transfer (instruction)
               (let* ((args (mir-instruction-operands instruction))
                      (name (mir-instruction-data instruction)))
                 (case (mir-instruction-kind instruction)
                   (0 (if (consp name) 1 0))
                   (1 (if parameters (logior 1 (ash 1 (+ 1 offset name))) 1))
                   (2 1)
                   ((4 5 12 16) 0)
                   ((3 9 10 11) (svref points (svref args 0)))
                   (14 (let ((fact (svref packets (svref args 0))))
                         (if (and (mir-values-fact-p fact) (mir-values-fact-count fact)
                                  (>= name (mir-values-fact-count fact))) 0
                             (svref points (svref args 0)))))
                   (6 (cond ((mir-cons-allocation-p instruction)
                             (let ((pair (svref fields (mir-instruction-id instruction))))
                               (let ((car (logior (car pair) (svref points (svref args 0))))
                                     (cdr (logior (cdr pair) (svref points (svref args 1)))))
                                 (unless (and (= car (car pair)) (= cdr (cdr pair)))
                                   (setf (car pair) car (cdr pair) cdr changed t))))
                             (ash 1 (1+ (mir-instruction-id instruction))))
                            ((mir-borrow-call-p instruction)
                             (case name
                               ((identity rplaca rplacd)
                                (when (member name '(rplaca rplacd))
                                  (store-field (svref points (svref args 0)) (svref points (svref args 1))
                                               (eq name 'rplacd)
                                               (= (mir-primary-origin (svref args 0) definitions)
                                                  (mir-primary-origin (svref args 1) definitions))))
                                (svref points (svref args 0)))
                               ((car cdr first rest) (field-value (svref points (svref args 0))
                                                                (member name '(cdr rest))))
                               (values (loop for arg across args with result = 0
                                             do (setf result (logior result (svref points arg)))
                                             finally (return result)))
                               (otherwise 0)))
                            (t 1)))
                   (7 (let ((summary (mir-known-borrow-call instruction borrows identities)))
                        (if summary (local-call instruction summary) 1)))
                   (otherwise 1)))))
      (loop while changed do
        (setf changed nil)
        (loop for block across blocks when (logbitp (mir-block-id block) reachable) do
          (loop for id across (hir-vector (mir-block-instructions block))
                for instruction = (svref instructions id) for result = (mir-instruction-result instruction)
                when result do (merge-points result (transfer instruction)))
          (loop for edge across (mir-terminator-edges (mir-block-terminator block)) do
            (loop for parameter across (mir-block-parameters (svref blocks (mir-edge-target edge)))
                  for argument across (mir-edge-arguments edge)
                  do (merge-points parameter (svref points argument))))))
      (loop for block across blocks when (logbitp (mir-block-id block) reachable) do
        (loop for id across (hir-vector (mir-block-instructions block))
              for instruction = (svref instructions id) for kind = (mir-instruction-kind instruction)
              do (let ((summary (mir-known-borrow-call instruction borrows identities)))
                   (cond (summary
                          (loop for index from 1 below (length (mir-instruction-operands instruction))
                                unless (logbitp (1- index) (mir-parameter-summary-borrow summary))
                                  do (setf escaped (logior escaped
                                                    (svref points (svref (mir-instruction-operands instruction) index))))))
                         ((not (or (member kind '(0 1 2 4 5 9 10 12 13 14 16))
                                   (mir-cons-allocation-p instruction) (mir-borrow-call-p instruction)
                                   (and (= kind 11) (mir-check-proven-p instruction types))))
                          (loop for arg across (mir-instruction-operands instruction)
                                do (setf escaped (logior escaped (svref points arg))))))))
        (let ((term (mir-block-terminator block)))
          (when (= (mir-terminator-kind term) 2)
            (let ((bits (svref points (svref (mir-terminator-operands term) 0))))
              (setf escaped (logior escaped (logand bits (lognot parameter-mask))))))))
      ;; Non-single bundles use heap carriers, including conversions at joins.
      ;; Their contents cannot include a stack object even when never returned.
      (dotimes (id (length points))
        (when (eq (mir-value-representation (mir-at (mir-function-values function) id)) :bundle)
          (unless (and (mir-values-fact-p (svref packets id))
                       (eql 1 (mir-values-fact-count (svref packets id))))
            (setf escaped (logior escaped (svref points id))))))
      (setf changed t)
      (loop while changed do
        (let ((before escaped))
          (dotimes (id (length fields))
            (when (and (svref fields id) (logbitp (1+ id) escaped))
              (setf escaped (logior escaped (car (svref fields id)) (cdr (svref fields id))))))
          (setf changed (/= before escaped))))
      (make-mir-storage-analysis :points points :fields fields :escaped escaped
                                 :stack (logand sites (lognot escaped)) :cyclic cyclic))))

(defun mir-infer-storage (unit)
  (mir-unit-analysis unit :storage
    (lambda (unit)
      (let ((calls (mir-infer-calls unit)) (borrows (mir-infer-borrows unit)))
        (map 'simple-vector
             (lambda (function)
               (let ((id (mir-function-id function)))
                 (mir-compute-storage function (svref (mir-call-analysis-types calls) id)
                                      (svref (mir-call-analysis-packets calls) id)
                                      :borrows borrows :identities (svref (mir-call-analysis-identities calls) id))))
             (hir-vector (mir-unit-functions unit)))))))

(defconstant +mir-borrow-path-depth+ 4)

(defun mir-compose-borrow-path (path selectors)
  (let ((result (list (car path))) (depth 0))
    (dolist (selector (append (cdr path) selectors) (nreverse result))
      (when (or (eq selector :reachable) (>= depth +mir-borrow-path-depth+))
        (push :reachable result) (return (nreverse result)))
      (push selector result) (incf depth))))

(defun mir-compute-parameter-paths (function proof summaries known packets)
  "Describe returned aliases and field writes using bounded parameter paths."
  (block analysis
    (let* ((paths (make-array (hir-buffer-count (mir-function-values function)) :initial-element nil))
           (points (mir-storage-analysis-points proof)) (fields (mir-storage-analysis-fields proof))
           (offset (hir-buffer-count (mir-function-instructions function)))
           (local-mask (1- (ash 1 (1+ offset))))
           (reachable (mir-reachable-blocks function)) (definitions (mir-value-definitions function))
           (budget 8192) (changed t) (returns nil) (effects nil))
      (labels ((tick () (when (minusp (decf budget)) (return-from analysis (values nil nil t))))
               (join (left right)
                 (dolist (path right left) (tick) (pushnew path left :test #'equal)))
               (merge-paths (id incoming)
                 (let ((joined (join (copy-list (svref paths id)) incoming)))
                   (unless (= (length joined) (length (svref paths id)))
                     (setf (svref paths id) joined changed t))))
               (fallback (bits)
                 (let ((result nil))
                   (dotimes (index (mir-function-positional-count function) result)
                     (when (logbitp (+ 1 offset index) bits)
                       (tick) (push (list index :reachable) result)))))
               (project (id selectors)
                 (let ((result nil))
                   (dolist (path (svref paths id))
                     (tick) (pushnew (mir-compose-borrow-path path selectors) result :test #'equal))
                   ;; Local containers can hide parameter references from the
                   ;; syntactic path. Their field graph supplies a conservative
                   ;; reachable path for every such reference.
                   (join result (fallback (mir-storage-resolve fields
                                            (logand (svref points id) local-mask) selectors)))))
               (transfer (instruction)
                 (let ((args (mir-instruction-operands instruction)) (name (mir-instruction-data instruction)))
                   (case (mir-instruction-kind instruction)
                     (1 (list (list name)))
                     ((3 9 10 11) (svref paths (svref args 0)))
                     (14 (let ((fact (svref packets (svref args 0))))
                           (unless (and (mir-values-fact-p fact) (mir-values-fact-count fact)
                                        (>= name (mir-values-fact-count fact)))
                             (svref paths (svref args 0)))))
                     (6 (when (mir-borrow-call-p instruction)
                          (case name
                            ((identity rplaca rplacd) (svref paths (svref args 0)))
                            ((car first) (project (svref args 0) '(:car)))
                            ((cdr rest) (project (svref args 0) '(:cdr)))
                            (values (let ((result nil))
                                      (loop for arg across args do (setf result (join result (svref paths arg))))
                                      result)))))
                     (7 (let ((summary (mir-known-borrow-call instruction summaries known)) (result nil))
                          (when summary
                            (dolist (path (mir-parameter-summary-returns summary))
                              (when (and (< (car path) (1- (length args)))
                                         (logbitp (car path) (mir-parameter-summary-borrow summary)))
                                (setf result (join result (project (svref args (1+ (car path))) (cdr path)))))))
                          result))
                     (otherwise nil)))))
        (loop while changed do
          (setf changed nil)
          (loop for block across (hir-vector (mir-function-blocks function))
                when (logbitp (mir-block-id block) reachable) do
            (loop for id across (hir-vector (mir-block-instructions block))
                  for instruction = (mir-at (mir-function-instructions function) id)
                  for result = (mir-instruction-result instruction)
                  when result do (merge-paths result (transfer instruction)))
            (loop for edge across (mir-terminator-edges (mir-block-terminator block)) do
              (loop for parameter across (mir-block-parameters (mir-at (mir-function-blocks function) (mir-edge-target edge)))
                    for argument across (mir-edge-arguments edge)
                    do (merge-paths parameter (svref paths argument))))))
        (loop for block across (hir-vector (mir-function-blocks function))
              when (logbitp (mir-block-id block) reachable) do
          (loop for id across (hir-vector (mir-block-instructions block))
                for instruction = (mir-at (mir-function-instructions function) id)
                for args = (mir-instruction-operands instruction) do
            (cond ((and (mir-borrow-call-p instruction) (member (mir-instruction-data instruction) '(rplaca rplacd)))
                   (dolist (path (svref paths (svref args 0)))
                     (tick)
                     (pushnew (list path (if (eq (mir-instruction-data instruction) 'rplaca) :car :cdr)
                                    (= (mir-primary-origin (svref args 0) definitions)
                                       (mir-primary-origin (svref args 1) definitions))) effects :test #'equal)))
                  ((mir-known-borrow-call instruction summaries known)
                   (dolist (effect (mir-parameter-summary-effects (mir-known-borrow-call instruction summaries known)))
                     (let ((path (first effect)))
                       (when (< (car path) (1- (length args)))
                         (dolist (composed (project (svref args (1+ (car path))) (cdr path)))
                           (tick) (pushnew (list composed (second effect) (third effect)) effects :test #'equal))))))))
          (let ((term (mir-block-terminator block)))
            (when (= (mir-terminator-kind term) 2)
              (setf returns (join returns (svref paths (svref (mir-terminator-operands term) 0)))))))
        (values returns effects nil)))))

(defun mir-compute-borrows (unit)
  (let* ((functions (hir-vector (mir-unit-functions unit))) (calls (mir-infer-calls unit))
         (summaries (map 'simple-vector
                         (lambda (function)
                           (make-mir-parameter-summary :required (mir-function-required function)
                                                       :maximum (mir-function-maximum function)
                                                       :borrow (1- (ash 1 (mir-function-positional-count function))))) functions))
         (changed t))
    ;; Start with a borrow assumption, then remove it whenever a member's
    ;; body disproves it. Return aliases and effects grow at the same time;
    ;; recursive callers must be checked again when either changes.
    (loop while changed do
      (setf changed nil)
      (dolist (component (mir-call-analysis-components calls))
        (dolist (id component)
          (let* ((function (svref functions id)) (old (svref summaries id))
                 (proof (mir-compute-storage function (svref (mir-call-analysis-types calls) id)
                                             (svref (mir-call-analysis-packets calls) id)
                                             :borrows summaries :identities (svref (mir-call-analysis-identities calls) id)
                                             :parameters t))
                 (borrow (mir-parameter-summary-borrow old)))
            (dotimes (index (mir-function-positional-count function))
              (when (logbitp (+ 1 (hir-buffer-count (mir-function-instructions function)) index)
                            (mir-storage-analysis-escaped proof))
                (setf borrow (logand borrow (lognot (ash 1 index))))))
            (multiple-value-bind (paths effects exhausted)
                (mir-compute-parameter-paths function proof summaries (svref (mir-call-analysis-identities calls) id)
                                             (svref (mir-call-analysis-packets calls) id))
              (when exhausted (setf borrow 0))
              (setf paths (remove-if-not (lambda (path) (logbitp (car path) borrow))
                                         (union paths (mir-parameter-summary-returns old) :test #'equal))
                    effects (remove-if-not (lambda (effect) (logbitp (car (first effect)) borrow))
                                           (union effects (mir-parameter-summary-effects old) :test #'equal)))
              (unless (and (= borrow (mir-parameter-summary-borrow old))
                           (null (set-exclusive-or paths (mir-parameter-summary-returns old) :test #'equal))
                           (null (set-exclusive-or effects (mir-parameter-summary-effects old) :test #'equal)))
                (setf (svref summaries id) (make-mir-parameter-summary :required (mir-function-required function)
                                                                     :maximum (mir-function-maximum function)
                                                                     :borrow borrow :returns paths :effects effects)
                      changed t)))))))
    summaries))

(defun mir-infer-borrows (unit)
  (mir-unit-analysis unit :borrows #'mir-compute-borrows))
