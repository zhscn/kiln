(in-package #:kiln.compiler)

(defvar *mir-unit*)
(defvar *mir-function*)
(defvar *mir-block*)
(defvar *mir-environment*)
(defvar *mir-functions*)
(defvar *mir-static-function-bindings*)
(defvar *mir-function-bindings*)
(defvar *mir-cell-variables*)
(defvar *mir-bindings*)
(defvar *mir-exits*)
(defvar *mir-source* nil)
(defvar *mir-policy* 1023)

(defun mir-unavailable (reason)
  (error 'mir-unsupported :message (format nil "MIR: ~A~@[ at ~S~]" reason (hir-source-range *mir-source*))))

(defun mir-catalog-functions (root)
  (let ((seen (make-hash-table :test 'eq)) (assigned (make-hash-table :test 'eq))
        (dynamic (make-hash-table :test 'eq)) (functions (make-hir-buffer)) (changed t))
    (labels ((visit-function (function)
               (unless (gethash function seen)
                 (setf (gethash function seen) t)
                 (hir-push function functions)
                 (when (hir-fun-binding function)
                   (setf (gethash (hir-fun-binding function) *mir-function-bindings*) function))
                 (hir-map-function #'visit function)))
             (visit (node)
               (case (hir-node-kind node)
                 (2 (setf (gethash (hir-node-a node) assigned) t) (visit (hir-node-b node)))
                 ((6 7) (let ((callee (hir-node-a node)))
                          (cond ((hir-fun-p callee) (visit-function callee))
                                ((hir-node-p callee) (visit callee))))
                        (when (= 7 (hir-node-kind node)) (loop for arg across (hir-node-b node) do (visit arg))))
                 (13 (loop for function across (hir-node-a node) do (visit-function function))
                     (visit (hir-node-b node)))
                 (24 (visit-function (hir-node-a node)))
                 (otherwise (hir-map-children #'visit node)))))
      (visit-function root))
    (loop while changed do
      (setf changed nil)
      (loop for function across (hir-vector functions) unless (gethash function dynamic) do
        (when (some (lambda (variable)
                      (let ((target (gethash variable *mir-function-bindings*)))
                        (or (null target) (gethash target dynamic) (gethash variable assigned))))
                    (hir-fun-free function))
          (setf (gethash function dynamic) t changed t))))
    (loop for function across (hir-vector functions) do
      (when (and (hir-fun-binding function) (not (gethash function dynamic)))
        (setf (gethash (hir-fun-binding function) *mir-static-function-bindings*) t))
      (loop for variable across (hir-fun-free function) when (gethash variable assigned)
            do (setf (gethash variable *mir-cell-variables*) t)))))

(defun mir-captures (function)
  (remove-if (lambda (variable) (gethash variable *mir-static-function-bindings*)) (hir-fun-free function)))

(defun mir-new-block (&optional result)
  (let* ((id (hir-buffer-count (mir-function-blocks *mir-function*)))
         (parameters (make-array (+ (length (mir-function-bindings *mir-function*)) (if result 1 0)))))
    (dotimes (i (length parameters))
      (setf (svref parameters i) (mir-add-value *mir-function*
                                  (cond ((= i (length (mir-function-bindings *mir-function*))) :bundle)
                                        ((logbitp i (mir-function-binding-cells *mir-function*)) :cell) (t :obj)) id -1)))
    (hir-push (make-mir-block :id id :parameters parameters) (mir-function-blocks *mir-function*))
    id))

(defun mir-start (id)
  (setf *mir-block* (mir-at (mir-function-blocks *mir-function*) id)
        *mir-environment* (subseq (mir-block-parameters *mir-block*) 0
                                 (length (mir-function-bindings *mir-function*)))))

(defun mir-instruction (kind representation &optional (operands #()) data notinline)
  (unless *mir-block* (mir-fail "Instruction after MIR terminator"))
  (let* ((id (hir-buffer-count (mir-function-instructions *mir-function*)))
         (position (hir-buffer-count (mir-block-instructions *mir-block*)))
         (result (and representation (mir-add-value *mir-function* representation (mir-block-id *mir-block*) position))))
    (hir-push (make-mir-instruction :id id :kind kind :operands operands :result result :data data
                                   :source *mir-source* :origin *source-origin* :notinline notinline :policy *mir-policy*
                                   :effects (svref *mir-instruction-effects* kind))
              (mir-function-instructions *mir-function*))
    (hir-push id (mir-block-instructions *mir-block*))
    result))

(defun mir-edge-to (id &optional (result nil resultp))
  (make-mir-edge :target id :arguments
                (if resultp (concatenate 'simple-vector *mir-environment* (vector result))
                    (copy-seq *mir-environment*))))

(defun mir-terminate (kind &optional (operands #()) (edges #()))
  (setf (mir-block-terminator *mir-block*)
        (make-mir-terminator :kind kind :operands operands :edges edges :source *mir-source* :origin *source-origin* :policy *mir-policy*)
        *mir-block* nil))

(defun mir-jump (id &optional (result nil resultp))
  (when *mir-block*
    (mir-terminate 0 #() (vector (if resultp (mir-edge-to id result) (mir-edge-to id))))))

(defun mir-single (value) (mir-instruction 9 :bundle (vector value)))
(defun mir-primary (node) (let ((value (mir-build-node node)))
                           (when *mir-block* (mir-instruction 10 :obj (vector value)))))

(defun mir-binding-index (variable)
  (multiple-value-bind (id found) (gethash variable *mir-bindings*)
    (unless found (mir-unavailable "captured or foreign binding")) id))

(defun mir-binding-value (variable)
  (let* ((index (mir-binding-index variable)) (value (svref *mir-environment* index)))
    (if (logbitp index (mir-function-binding-cells *mir-function*))
        (mir-instruction 20 :obj (vector value)) value)))

(defun mir-establish-binding (variable value)
  (setf (svref *mir-environment* (mir-binding-index variable))
        (if (gethash variable *mir-cell-variables*) (mir-instruction 19 :cell (vector value)) value)))

(defun mir-fill-closure (function object)
  (loop for variable across (mir-captures function) for index from 0
        do (mir-instruction 24 nil (vector object (svref *mir-environment* (mir-binding-index variable)))
                            (cons (mir-import-function function) index)))
  object)

(defun mir-function-object (function)
  (let ((id (mir-import-function function)))
    (cond ((gethash (hir-fun-binding function) *mir-static-function-bindings*) (mir-instruction 5 :obj #() id))
          ((hir-fun-binding function) (mir-binding-value (hir-fun-binding function)))
          ((zerop (length (mir-captures function))) (mir-instruction 5 :obj #() id))
          (t (mir-fill-closure function (mir-instruction 23 :obj #() id))))))

(defun mir-build-local-functions (node)
  (let ((objects nil))
    (loop for function across (hir-node-a node)
          for id = (mir-import-function function)
          for object = (mir-instruction (if (zerop (length (mir-captures function))) 5 23) :obj #() id)
          do (mir-establish-binding (hir-fun-binding function) object) (push (cons function object) objects))
    ;; Every sibling is rooted before any recursive environment is filled.
    (dolist (entry (nreverse objects)) (mir-fill-closure (car entry) (cdr entry))))
  (mir-build-node (hir-node-b node)))

(defun mir-check (value type &optional (representation :obj))
  (when (and (consp (hir-declaration-expanded type))
             (eq (car (hir-declaration-expanded type)) 'values))
    (mir-unavailable "VALUES type declaration"))
  (if (eq type t) value
      (mir-instruction 11 representation (vector value) type)))

(defun mir-build-sequence (nodes)
  (let ((result nil))
    (loop for node across nodes while *mir-block* do (setf result (mir-build-node node)))
    (when *mir-block* (or result (mir-single (mir-instruction 0 :obj #() nil))))))

(defun mir-has-predecessor-p (target)
  (loop for block across (hir-vector (mir-function-blocks *mir-function*))
        thereis (let ((term (mir-block-terminator block)))
                  (and term (find target (mir-terminator-edges term) :key #'mir-edge-target)))))

(defun mir-build-if (node)
  (let ((test (mir-primary (hir-node-a node))))
    (unless *mir-block* (return-from mir-build-if nil))
    (let ((yes (mir-new-block)) (no (mir-new-block)) (join (mir-new-block t)))
      (mir-terminate 1 (vector test) (vector (mir-edge-to yes) (mir-edge-to no)))
      (mir-start yes)
      (let ((value (mir-build-node (hir-node-b node)))) (mir-jump join value))
      (mir-start no)
      (let ((value (mir-build-node (hir-node-c node)))) (mir-jump join value))
      (when (mir-has-predecessor-p join)
        (mir-start join)
        (svref (mir-block-parameters *mir-block*) (length *mir-environment*))))))

(defun mir-build-mv-let (node)
  (let* ((variables (hir-node-a node))
         (bundle (mir-build-node (svref (hir-node-b node) 0))))
    (when *mir-block*
      (let ((values (make-array (length variables))))
        (dotimes (index (length variables))
          (setf (svref values index) (mir-instruction 14 :obj (vector bundle) index)))
        (loop for variable across variables for value across values
              do (mir-establish-binding variable (mir-check value (hir-var-type variable))))
        (mir-build-node (hir-node-c node))))))

(defun mir-build-let (node)
  (when (hir-node-d node) (return-from mir-build-let (mir-build-mv-let node)))
  (let ((variables (hir-node-a node)) (inits (hir-node-b node)) (values nil))
    (loop for variable across variables for init across inits while *mir-block*
          for value = (mir-primary init)
          do (when *mir-block* (push (mir-check value (hir-var-type variable)) values)))
    (when *mir-block*
      (loop for variable across variables for value in (nreverse values)
            do (mir-establish-binding variable value))
      (mir-build-node (hir-node-c node)))))

(defun mir-build-block (node)
  (let ((exit (hir-node-a node)) (target (mir-new-block t)))
    (when (logtest 1 (hir-exit-flags exit)) (mir-unavailable "cross-function block exit"))
    (let ((*mir-exits* (acons exit target *mir-exits*)))
      (let ((value (mir-build-node (hir-node-b node)))) (mir-jump target value)))
    (when (mir-has-predecessor-p target)
      (mir-start target)
      (svref (mir-block-parameters *mir-block*) (length *mir-environment*)))))

(defun mir-build-tagbody (node)
  (let* ((segments (hir-node-a node))
         (blocks (map 'simple-vector (lambda (segment) (declare (ignore segment)) (mir-new-block)) segments))
         (done (mir-new-block)) (*mir-exits* *mir-exits*))
    (when (logtest 1 (hir-exit-flags (hir-node-b node))) (mir-unavailable "cross-function GO"))
    (loop for segment across segments for block across blocks
          do (push (cons (car segment) block) *mir-exits*))
    (mir-jump (if (plusp (length blocks)) (svref blocks 0) done))
    (loop for segment across segments for block across blocks for i from 0
          do (mir-start block)
             (mir-build-node (cdr segment))
             (mir-jump (if (< (1+ i) (length blocks)) (svref blocks (1+ i)) done)))
    (mir-start done)
    (mir-single (mir-instruction 0 :obj #() nil))))

(defun mir-build-call (node)
  (let* ((callee (hir-node-a node))
         (global (or (symbolp callee) (and (consp callee) (eq (car callee) 'setf))))
         (object (unless global
                   (if (hir-fun-p callee) (mir-function-object callee)
                       (mir-primary callee))))
         (arguments nil))
    (loop for arg across (hir-node-b node) while *mir-block* do (push (mir-primary arg) arguments))
    (when *mir-block*
      (mir-instruction (if global 6 7) :bundle
                       (coerce (if global (nreverse arguments) (cons object (nreverse arguments))) 'simple-vector)
                       (when global callee) (eq (hir-node-d node) :notinline)))))

(defun mir-build-mv-call (node)
  (let ((function (mir-primary (hir-node-a node))) (bundles nil))
    (loop for form across (hir-node-b node) while *mir-block*
          do (push (mir-build-node form) bundles))
    (when *mir-block*
      (mir-instruction 15 :bundle (coerce (cons function (nreverse bundles)) 'simple-vector)))))

(defun mir-build-node (node)
  (unless *mir-block* (return-from mir-build-node nil))
  (let ((*mir-source* (hir-node-source node)) (*mir-policy* (hir-node-policy node))
        (*source-origin* (hir-node-origin node)))
    (case (hir-node-kind node)
      (0 (mir-single (mir-instruction 0 :obj #() (hir-node-a node))))
      (1 (let ((value (mir-binding-value (hir-node-a node))))
           (when (hir-node-c node) (setf value (mir-check value (hir-node-b node))))
           (mir-single value)))
      (2 (let ((value (mir-primary (hir-node-b node))))
           (when *mir-block*
             (setf value (mir-check value (hir-var-type (hir-node-a node))))
             (let ((index (mir-binding-index (hir-node-a node))))
               (if (logbitp index (mir-function-binding-cells *mir-function*))
                   (mir-instruction 21 nil (vector (svref *mir-environment* index) value))
                   (setf (svref *mir-environment* index) value)))
             (mir-single value))))
      (3 (mir-single (mir-instruction 2 :obj #() (hir-node-a node))))
      (4 (let ((value (mir-primary (hir-node-b node))))
           (when *mir-block* (mir-single (mir-instruction 3 :obj (vector value) (hir-node-a node))))))
      (5 (mir-single (mir-instruction 4 :obj #() (hir-node-a node))))
      (6 (mir-single (mir-function-object (hir-node-a node))))
      (7 (mir-build-call node))
      (8 (let ((args nil))
           (loop for arg across (hir-node-a node) while *mir-block* do (push (mir-primary arg) args))
           (when *mir-block* (mir-instruction 8 :bundle (coerce (nreverse args) 'simple-vector) (hir-node-b node)))))
      (9 (mir-build-if node))
      (10 (mir-build-sequence (hir-node-a node)))
      (11 (mir-build-let node))
      (13 (mir-build-local-functions node))
      (14 (mir-build-block node))
      (15 (let ((entry (assoc (hir-node-a node) *mir-exits* :test #'eq)))
            (unless entry (mir-unavailable "nonlocal RETURN-FROM"))
            (let ((value (mir-build-node (hir-node-b node)))) (mir-jump (cdr entry) value))))
      (16 (mir-build-tagbody node))
      (17 (let ((entry (assoc (hir-node-a node) *mir-exits* :test #'eq)))
            (unless entry (mir-unavailable "nonlocal GO")) (mir-jump (cdr entry))))
      (21 (mir-build-mv-call node))
      (22 (let ((value (mir-build-node (hir-node-a node))))
            (when *mir-block* (mir-build-node (hir-node-b node)))
            (when *mir-block* value)))
      (23 (let ((value (mir-build-node (hir-node-b node))))
            (when *mir-block*
              (mir-check value (hir-node-a node) :bundle))))
      (otherwise (mir-unavailable (format nil "HIR kind ~D" (hir-node-kind node)))))))

(defun mir-bind-parameter (variable value)
  (mir-establish-binding variable (mir-check value (hir-var-type variable))))

(defun mir-build-optional (parameter index count)
  (let ((provided (mir-new-block)) (missing (mir-new-block)) (join (mir-new-block)))
    (mir-terminate 1 (vector (mir-instruction 16 :obj (vector count) index))
                   (vector (mir-edge-to provided) (mir-edge-to missing)))
    (mir-start provided)
    (mir-bind-parameter (svref parameter 0) (mir-instruction 1 :obj #() index))
    (when (svref parameter 2)
      (mir-bind-parameter (svref parameter 2) (mir-instruction 0 :obj #() t)))
    (mir-jump join)
    (mir-start missing)
    (let ((value (mir-primary (svref parameter 1))))
      (when *mir-block*
        (mir-bind-parameter (svref parameter 0) value)
        (when (svref parameter 2)
          (mir-bind-parameter (svref parameter 2) (mir-instruction 0 :obj #() nil)))
        (mir-jump join)))
    (mir-start join)))

(defun mir-call-primary (name &rest arguments)
  (mir-instruction 10 :obj (vector (mir-instruction 6 :bundle (coerce arguments 'simple-vector) name))))

(defun mir-branch (test yes no)
  (mir-terminate 1 (vector test) (vector (mir-edge-to yes) (mir-edge-to no))))

(defun mir-argument-error (reason value)
  (mir-instruction 18 nil (vector value) reason)
  (mir-terminate 3))

(defun mir-key-parity (list cursor)
  (let ((head (mir-new-block)) (body (mir-new-block)) (even (mir-new-block))
        (odd (mir-new-block)) (done (mir-new-block)))
    (setf (svref *mir-environment* cursor) list)
    (mir-jump head)
    (mir-start head)
    (mir-branch (svref *mir-environment* cursor) body done)
    (mir-start body)
    (let ((tail (mir-call-primary 'cdr (svref *mir-environment* cursor))))
      (mir-branch tail even odd)
      (mir-start even)
      (setf (svref *mir-environment* cursor) (mir-call-primary 'cdr tail))
      (mir-jump head))
    (mir-start odd)
    (mir-argument-error :odd-keywords list)
    (mir-start done)))

(defun mir-find-key (list keyword cursor value supplied)
  (let ((head (mir-new-block)) (body (mir-new-block)) (hit (mir-new-block))
        (next (mir-new-block)) (done (mir-new-block)))
    (setf (svref *mir-environment* cursor) list
          (svref *mir-environment* value) (mir-instruction 0 :obj #() nil)
          (svref *mir-environment* supplied) (mir-instruction 0 :obj #() nil))
    (mir-jump head)
    (mir-start head)
    (mir-branch (svref *mir-environment* cursor) body done)
    (mir-start body)
    (let* ((current (svref *mir-environment* cursor))
           (key (mir-call-primary 'car current)) (tail (mir-call-primary 'cdr current)))
      (mir-branch (mir-call-primary 'eq key (mir-instruction 0 :obj #() keyword)) hit next)
      (mir-start hit)
      (setf (svref *mir-environment* value) (mir-call-primary 'car tail)
            (svref *mir-environment* supplied) (mir-instruction 0 :obj #() t))
      (mir-jump done)
      (mir-start next)
      (setf (svref *mir-environment* cursor) (mir-call-primary 'cdr tail))
      (mir-jump head))
    (mir-start done)))

(defun mir-check-key-names (list keywords cursor allow)
  (let ((head (mir-new-block)) (body (mir-new-block)) (next (mir-new-block)) (done (mir-new-block)))
    (setf (svref *mir-environment* cursor) list)
    (mir-branch allow done head)
    (mir-start head)
    (mir-branch (svref *mir-environment* cursor) body done)
    (mir-start body)
    (let ((key (mir-call-primary 'car (svref *mir-environment* cursor))))
      (dolist (keyword (cons :allow-other-keys keywords))
        (let ((miss (mir-new-block)))
          (mir-branch (mir-call-primary 'eq key (mir-instruction 0 :obj #() keyword)) next miss)
          (mir-start miss)))
      (mir-argument-error :unknown-keyword key))
    (mir-start next)
    (setf (svref *mir-environment* cursor)
          (mir-call-primary 'cdr (mir-call-primary 'cdr (svref *mir-environment* cursor))))
    (mir-jump head)
    (mir-start done)))

(defun mir-build-keyword (parameter value supplied)
  (let ((provided (mir-new-block)) (missing (mir-new-block)) (join (mir-new-block)))
    (mir-branch (svref *mir-environment* supplied) provided missing)
    (mir-start provided)
    (mir-bind-parameter (svref parameter 0) (svref *mir-environment* value))
    (mir-bind-parameter (svref parameter 2) (mir-instruction 0 :obj #() t))
    (mir-jump join)
    (mir-start missing)
    (let ((init (mir-primary (svref parameter 1))))
      (when *mir-block*
        (mir-bind-parameter (svref parameter 0) init)
        (mir-bind-parameter (svref parameter 2) (mir-instruction 0 :obj #() nil))
        (mir-jump join)))
    (mir-start join)))

(defun mir-import-function (hir)
  (multiple-value-bind (old found) (gethash hir *mir-functions*)
    (when found (return-from mir-import-function old)))
  (let* ((ll (hir-fun-lambda-list hir))
         (id (hir-buffer-count (mir-unit-functions *mir-unit*)))
         (bindings (hir-vector (hir-fun-vars hir)))
         (captures (mir-captures hir))
         (all-bindings (concatenate 'simple-vector bindings captures))
         (binding-count (length all-bindings))
         (keys (hir-lambda-list-keys ll))
         (scratch (if (hir-lambda-list-key-p ll) (+ 3 (* 2 (length keys))) 0))
         (*mir-function* (make-mir-function :id id :name (hir-fun-name hir) :source (hir-fun-source hir)
                                           :policy (hir-fun-policy hir) :required (length (hir-lambda-list-required ll))
                                           :optional (length (hir-lambda-list-optional ll)) :rest (not (null (hir-lambda-list-rest ll)))
                                           :key-p (hir-lambda-list-key-p ll) :keys (map 'simple-vector (lambda (parameter) (svref parameter 3)) keys)
                                           :allow-other-keys (hir-lambda-list-allow-other-keys ll)
                                           :captures (map 'simple-vector #'hir-var-name captures)
                                           :capture-functions (make-array (length captures) :initial-element nil)
                                           :binding-cells (loop for variable across all-bindings for index from 0
                                                                when (gethash variable *mir-cell-variables*) sum (ash 1 index))
                                           :capture-cells (loop for variable across captures for index from 0
                                                                when (gethash variable *mir-cell-variables*) sum (ash 1 index))
                                           :bindings (concatenate 'simple-vector (map 'simple-vector #'hir-var-name all-bindings)
                                                                  (make-array scratch :initial-element :keyword-temporary))))
         (*mir-bindings* (make-hash-table :test 'eq))
         (*mir-exits* nil) (*mir-block* nil) (*mir-environment* nil)
         (*mir-policy* (hir-fun-policy hir)) (*mir-source* (hir-fun-source hir)) (*source-origin* (hir-fun-origin hir)))
    (when (or (hir-fun-parameter-specials hir) (plusp (hir-buffer-count (hir-fun-load-time-values hir))))
      (mir-unavailable "special parameters or load-time values"))
    (hir-push *mir-function* (mir-unit-functions *mir-unit*))
    (setf (gethash hir *mir-functions*) id)
    (loop for variable across all-bindings for index from 0
          do (setf (gethash variable *mir-bindings*) index))
    (loop for variable across captures for index from 0
          for target = (gethash variable *mir-function-bindings*)
          when (and target (not (gethash variable *mir-cell-variables*)))
            do (setf (svref (mir-function-capture-functions *mir-function*) index) (mir-import-function target)))
    (let ((entry (make-mir-block :id 0)))
      (hir-push entry (mir-function-blocks *mir-function*))
      (setf *mir-block* entry)
      (let ((nil-value (mir-instruction 0 :obj #() nil)))
        (setf *mir-environment* (make-array (length (mir-function-bindings *mir-function*)) :initial-element nil-value)))
      (let ((count (mir-instruction 12 :count)) (rest nil))
        (mir-instruction 13 nil (vector count)
                         (cons (mir-function-required *mir-function*) (mir-function-maximum *mir-function*)))
        (when (mir-function-tail-p *mir-function*)
          (setf rest (mir-instruction 17 :obj (vector count) (mir-function-positional-count *mir-function*))))
        (when (plusp (mir-function-binding-cells *mir-function*))
          (let ((unbound (mir-instruction 25 :cell)))
            (dotimes (index (length *mir-environment*))
              (when (logbitp index (mir-function-binding-cells *mir-function*))
                (setf (svref *mir-environment* index) unbound)))))
        (loop for variable across captures for index from 0
              do (setf (svref *mir-environment* (mir-binding-index variable))
                       (mir-instruction 22 (if (gethash variable *mir-cell-variables*) :cell :obj) #() index)))
        ;; Snapshot every keyword before defaults can mutate the rest list.
        (when (hir-lambda-list-key-p ll)
          (let ((cursor binding-count))
            (mir-key-parity rest cursor)
            (unless (hir-lambda-list-allow-other-keys ll)
              (mir-find-key rest :allow-other-keys cursor (1+ cursor) (+ 2 cursor))
              (mir-check-key-names rest (coerce (mir-function-keys *mir-function*) 'list) cursor
                                   (svref *mir-environment* (1+ cursor))))
            (loop for parameter across keys for index from (+ cursor 3) by 2
                  do (mir-find-key rest (svref parameter 3) cursor index (1+ index)))))
        (loop for variable across (hir-lambda-list-required ll) for index from 0
              do (mir-bind-parameter variable (mir-instruction 1 :obj #() index)))
        (loop for parameter across (hir-lambda-list-optional ll)
              for index from (mir-function-required *mir-function*)
              do (mir-build-optional parameter index count))
        (when (hir-lambda-list-rest ll)
          (mir-bind-parameter (hir-lambda-list-rest ll) rest))
        (loop for parameter across keys for index from (+ binding-count 3) by 2
              do (mir-build-keyword parameter index (1+ index))))
      (let ((value (mir-build-node (hir-fun-body hir))))
        (when *mir-block* (mir-terminate 2 (vector value))))
      (loop for block across (hir-vector (mir-function-blocks *mir-function*))
            unless (mir-block-terminator block)
              do (setf (mir-block-terminator block) (make-mir-terminator :kind 3))))
    id))

(defun hir-to-mir (hir)
  (let ((*mir-unit* (make-mir-unit)) (*mir-functions* (make-hash-table :test 'eq))
        (*mir-static-function-bindings* (make-hash-table :test 'eq))
        (*mir-function-bindings* (make-hash-table :test 'eq))
        (*mir-cell-variables* (make-hash-table :test 'eq)))
    (mir-catalog-functions hir)
    (mir-import-function hir)
    (when (plusp (length (mir-function-captures (mir-at (mir-unit-functions *mir-unit*) 0))))
      (mir-unavailable "root function requires an environment"))
    (verify-mir *mir-unit*)
    *mir-unit*))
