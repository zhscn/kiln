(in-package #:kiln.compiler)

(defvar *mir-source-root*)
(defvar *mir-debug-names*)

(defun mir-source-debug-name (hir)
  "Name a function in its lexical source context before flattening the unit."
  (or (gethash hir *mir-debug-names*)
      (setf (gethash hir *mir-debug-names*)
            (if (eq hir *mir-source-root*) '(lambda)
                (let* ((parent (hir-fun-parent hir))
                       (*function-name* (and parent (not (eq parent *mir-source-root*))
                                             (mir-source-debug-name parent))))
                  (local-function-debug-name (or (hir-fun-name hir) '#:lambda)))))))

(defvar *mir-unit*)
(defvar *mir-function*)
(defvar *mir-block*)
(defvar *mir-environment*)
(defvar *mir-functions*)
(defvar *mir-load-time-indices*)
(defvar *mir-load-time-nodes*)
(defvar *mir-static-function-bindings*)
(defvar *mir-function-bindings*)
(defvar *mir-cell-variables*)
(defvar *mir-bindings*)
(defvar *mir-exits*)
(defvar *mir-dynamic-bindings*)
(defvar *mir-next-binding*)
(defvar *mir-parameter-specials*)
(defvar *mir-cleanups*)
(defvar *mir-source* nil)
(defvar *mir-policy* +default-optimization-policy+)

(defun mir-unavailable (reason)
  (error 'mir-unsupported :message (format nil "MIR: ~A~@[ at ~S~]" reason (hir-source-range *mir-source*))))

(defun mir-catalog-functions (root)
  (let ((seen (make-hash-table :test 'eq)) (assigned (make-hash-table :test 'eq))
        (dynamic (make-hash-table :test 'eq)) (landing-functions (make-hash-table :test 'eq)) (current nil) (functions (make-hir-buffer)) (changed t))
    (labels ((visit-function (function)
               (unless (gethash function seen)
                 (setf (gethash function seen) t)
                 (hir-push function functions)
                 (when (hir-fun-binding function)
                   (setf (gethash (hir-fun-binding function) *mir-function-bindings*) function))
                 (let ((previous current))
                   (setf current function)
                   (hir-map-function #'visit function)
                   (setf current previous))))
             (visit (node)
               (case (hir-node-kind node)
                 (2 (setf (gethash (hir-node-a node) assigned) t) (visit (hir-node-b node)))
                 ((6 7) (let ((callee (hir-node-a node)))
                          (cond ((hir-fun-p callee) (visit-function callee))
                                ((hir-node-p callee) (visit callee))))
                        (when (= 7 (hir-node-kind node)) (loop for arg across (hir-node-b node) do (visit arg))))
                 (13 (loop for function across (hir-node-a node) do (visit-function function))
                     (visit (hir-node-b node)))
                 ((14 16) (when (logtest 1 (hir-exit-flags (if (= 14 (hir-node-kind node)) (hir-node-a node) (hir-node-b node))))
                            (setf (gethash current landing-functions) t))
                          (hir-map-children #'visit node))
                 ((18 20) (setf (gethash current landing-functions) t) (hir-map-children #'visit node))
                 (24 (unless (gethash node *mir-load-time-indices*)
                       (visit-function (hir-node-a node))
                       (setf (gethash node *mir-load-time-indices*) (hir-buffer-count *mir-load-time-nodes*))
                       (hir-push node *mir-load-time-nodes*)))
                 (otherwise (hir-map-children #'visit node)))))
      (visit-function root))
    (loop while changed do
      (setf changed nil)
      (loop for function across (hir-buffer-view functions) unless (gethash function dynamic) do
        (when (some (lambda (variable)
                      (let ((target (gethash variable *mir-function-bindings*)))
                        (or (null target) (gethash target dynamic) (gethash variable assigned))))
                    (hir-fun-free function))
          (setf (gethash function dynamic) t changed t))))
    (loop for function across (hir-buffer-view functions) do
      (when (and (hir-fun-binding function) (not (gethash function dynamic)))
        (setf (gethash (hir-fun-binding function) *mir-static-function-bindings*) t))
      (loop for variable across (hir-buffer-view (hir-fun-vars function))
            when (and (gethash variable assigned) (source-variable-name variable))
              do (setf (gethash variable *mir-cell-variables*) t))
      (when (gethash function landing-functions)
        (loop for variable across (hir-buffer-view (hir-fun-vars function)) when (gethash variable assigned)
              do (setf (gethash variable *mir-cell-variables*) t)))
      (loop for variable across (hir-fun-free function) when (gethash variable assigned)
            do (setf (gethash variable *mir-cell-variables*) t)))))

(defun mir-captures (function)
  (remove-if (lambda (variable) (gethash variable *mir-static-function-bindings*)) (hir-fun-free function)))

(defun mir-new-block (&optional result-representation)
  (let* ((id (hir-buffer-count (mir-function-blocks *mir-function*)))
         (width (length (mir-function-bindings *mir-function*)))
         (parameters (make-array (+ width (if result-representation 1 0)))))
    ;; Negative IDs denote pending (block, binding) reads until the graph is
    ;; complete. Edge-only forwarding does not allocate an SSA value.
    (dotimes (index width)
      (setf (svref parameters index) (- -1 (+ (* id width) index))))
    (when result-representation
      (setf (svref parameters width) (mir-add-value *mir-function* result-representation id -1)))
    (hir-push (make-mir-block :id id :parameters parameters) (mir-function-blocks *mir-function*))
    id))

(defun mir-materialize-bindings (function)
  "Materialize binding parameters demanded by operations and their incoming values."
  (let* ((blocks (hir-buffer-view (mir-function-blocks function)))
         (width (length (mir-function-bindings function)))
         (incoming (make-array (length blocks) :initial-element nil))
         (work (make-hir-buffer)))
    (labels ((resolve (id)
               (if (minusp id)
                   (multiple-value-bind (block index) (floor (- -1 id) width)
                     (let* ((parameters (mir-block-parameters (svref blocks block)))
                            (parameter (svref parameters index)))
                       (when (minusp parameter)
                         (setf parameter (mir-add-value function
                                           (if (logbitp index (mir-function-binding-cells function)) :cell :obj)
                                           block -1)
                               (svref parameters index) parameter)
                         (hir-push (cons block index) work))
                       parameter))
                   id))
             (rewrite (ids)
               (dotimes (index (length ids))
                 (setf (svref ids index) (resolve (svref ids index))))))
      (loop for block across blocks for term = (mir-block-terminator block) do
        (loop for edge across (mir-terminator-edges term)
              do (push edge (svref incoming (mir-edge-target edge))))
        ;; Explicit result/cursor parameters also demand their incoming values.
        (loop for parameter across (mir-block-parameters block) for index from 0
              unless (minusp parameter) do (hir-push (cons (mir-block-id block) index) work))
        (rewrite (mir-terminator-operands term)))
      (loop for instruction across (hir-buffer-view (mir-function-instructions function))
            do (rewrite (mir-instruction-operands instruction)))
      (loop for cursor from 0 while (< cursor (hir-buffer-count work))
            for demand = (mir-at work cursor)
            do (dolist (edge (svref incoming (car demand)))
                 (let ((args (mir-edge-arguments edge)) (index (cdr demand)))
                   (setf (svref args index) (resolve (svref args index)))))))
    (mir-verify-construction-bindings function)
    ;; Keep the construction prefix until every incoming demand is resolved;
    ;; then compact targets and all their edges using the same positions.
    (loop for block across blocks for parameters = (mir-block-parameters block)
          for kept = (loop for parameter across parameters for index from 0
                           unless (minusp parameter) collect index) do
      (dolist (edge (svref incoming (mir-block-id block)))
        (setf (mir-edge-arguments edge)
              (map 'simple-vector (lambda (index) (svref (mir-edge-arguments edge) index)) kept)))
      (setf (mir-block-parameters block)
            (map 'simple-vector (lambda (index) (svref parameters index)) kept))))
  function)

(defun mir-start (id)
  (setf *mir-block* (mir-at (mir-function-blocks *mir-function*) id)
        *mir-environment* (subseq (mir-block-parameters *mir-block*) 0
                                 (length (mir-function-bindings *mir-function*)))))

(defun mir-instruction (kind representation &optional (operands #()) data notinline)
  (unless *mir-block* (mir-fail "Instruction after MIR terminator"))
  (let* ((id (hir-buffer-count (mir-function-instructions *mir-function*)))
         (position (hir-buffer-count (mir-block-instructions *mir-block*)))
         (result (and representation (mir-add-value *mir-function* representation (mir-block-id *mir-block*) position))))
    (hir-push (make-mir-instruction :id id :kind kind :operands operands :result result :data data
                                   :source *mir-source* :origin *source-origin* :notinline notinline :policy *mir-policy*
                                   :effects (svref *mir-instruction-effects* kind))
              (mir-function-instructions *mir-function*))
    (hir-push id (mir-block-instructions *mir-block*))
    result))

(defun mir-edge-to (id &optional (result nil resultp))
  (make-mir-edge :target id :arguments
                (if resultp (concatenate 'simple-vector *mir-environment* (vector result))
                    (copy-seq *mir-environment*))))

(defun mir-terminate (kind &optional (operands #()) (edges #()) region)
  (setf (mir-block-terminator *mir-block*)
        (make-mir-terminator :kind kind :operands operands :edges edges :region region :source *mir-source* :origin *source-origin* :policy *mir-policy*)
        *mir-block* nil))

(defun mir-jump (id &optional (result nil resultp))
  (when *mir-block*
    (mir-terminate 0 #() (vector (if resultp (mir-edge-to id result) (mir-edge-to id))))))

(defun mir-single (value) (mir-instruction 9 :bundle (vector value)))
(defun mir-primary (node)
  (mir-build-node node t))

(defun mir-binding-index (variable)
  (multiple-value-bind (id found) (gethash variable *mir-bindings*)
    (unless found (mir-unavailable "captured or foreign binding")) id))

(defun mir-binding-value (variable)
  (let* ((index (mir-binding-index variable)) (value (svref *mir-environment* index)))
    (if (logbitp index (mir-function-binding-cells *mir-function*))
        (mir-instruction 20 :obj (vector value)) value)))

(defun mir-debug-binding (variable value)
  "Expose a source-visible binding as an SSA use for frame inspection."
  (let ((name (source-variable-name variable)))
    (when name
      (mir-instruction 40 nil (vector value) (cons (mir-binding-index variable) name)))))

(defun mir-establish-binding (variable value)
  (let ((stored (if (gethash variable *mir-cell-variables*) (mir-instruction 19 :cell (vector value)) value)))
    (setf (svref *mir-environment* (mir-binding-index variable)) stored)
    (mir-debug-binding variable stored)
    stored))

(defun mir-fill-closure (function object)
  (loop for variable across (mir-captures function) for index from 0
        do (mir-instruction 24 nil (vector object (svref *mir-environment* (mir-binding-index variable)))
                            (cons (mir-import-function function) index)))
  object)

(defun mir-function-object (function)
  (let ((id (mir-import-function function)))
    (cond ((gethash (hir-fun-binding function) *mir-static-function-bindings*) (mir-instruction 5 :obj #() id))
          ((hir-fun-binding function) (mir-binding-value (hir-fun-binding function)))
          ((zerop (length (mir-captures function))) (mir-instruction 5 :obj #() id))
          (t (mir-fill-closure function (mir-instruction 23 :obj #() id))))))

(defun mir-build-local-functions (node)
  (let ((objects nil))
    (loop for function across (hir-node-a node)
          for id = (mir-import-function function)
          for object = (mir-instruction (if (zerop (length (mir-captures function))) 5 23) :obj #() id)
          do (mir-establish-binding (hir-fun-binding function) object) (push (cons function object) objects))
    ;; Every sibling is rooted before any recursive environment is filled.
    (dolist (entry (nreverse objects)) (mir-fill-closure (car entry) (cdr entry))))
  (mir-build-node (hir-node-b node)))

(defun mir-check (value type &optional (representation :obj))
  (when (and (consp (hir-declaration-expanded type))
             (eq (car (hir-declaration-expanded type)) 'values))
    (unless (eq representation :bundle) (mir-fail "VALUES declarations require a bundle"))
    (return-from mir-check (mir-build-values-check value (mir-parse-values-declaration type))))
  (if (eq type t) value
      (mir-instruction 11 representation (vector value) type)))

(defun mir-build-values-check (bundle declaration)
  (let ((required (mir-values-declaration-required declaration))
        (optional (mir-values-declaration-optional declaration)))
    (loop for type across required for index from 0
          do (mir-check (mir-instruction 14 :obj (vector bundle) index) type))
    (loop for type across optional for index from (length required)
          do (let ((present (mir-new-block)) (done (mir-new-block)))
               (mir-branch (mir-instruction 37 :obj (vector bundle) index) present done)
               (mir-start present)
               (mir-check (mir-instruction 14 :obj (vector bundle) index) type)
               (mir-jump done)
               (mir-start done)))
    (unless (eq (hir-declaration-expanded (mir-values-declaration-rest declaration)) t)
      (let* ((start (mir-instruction 38 :obj (vector bundle) (+ (length required) (length optional))))
             (head (mir-new-block)) (body (mir-new-block)) (done (mir-new-block))
             (cursor (mir-add-value *mir-function* :obj head -1)))
        (setf (mir-block-parameters (mir-at (mir-function-blocks *mir-function*) head))
              (concatenate 'simple-vector (mir-block-parameters (mir-at (mir-function-blocks *mir-function*) head)) (vector cursor)))
        (labels ((next (value)
                   (mir-terminate 0 #() (vector (make-mir-edge :target head
                                                  :arguments (concatenate 'simple-vector *mir-environment* (vector value)))))))
          (next start)
          (mir-start head)
          (mir-branch cursor body done)
          (mir-start body)
          (mir-check (mir-call-primary 'car cursor) (mir-values-declaration-rest declaration))
          (next (mir-call-primary 'cdr cursor)))
        (mir-start done)))
    (mir-instruction 39 :bundle (vector bundle) declaration)))

(defun mir-enter-binding (name value)
  (let ((id *mir-next-binding*))
    (incf *mir-next-binding*)
    (mir-instruction 27 nil (vector value) (cons id name))
    (push id *mir-dynamic-bindings*)))

(defun mir-leave-bindings (target)
  (let ((*mir-dynamic-bindings* *mir-dynamic-bindings*))
    (loop while (and *mir-block* (not (eq *mir-dynamic-bindings* target)))
          do (let* ((binding (pop *mir-dynamic-bindings*)) (id (mir-active-binding-id binding)))
               (mir-instruction 28 nil #() id)
               (when (and (integerp binding) (gethash id *mir-cleanups*))
                 (mir-build-node (gethash id *mir-cleanups*)))))))

(defun mir-activate-parameter (variable &optional joined)
  ;; A default and a supplied value meet in a new SSA block parameter.
  ;; Name that value directly rather than relying on incoming value labels.
  (when (and variable joined)
    (mir-debug-binding variable (svref *mir-environment* (mir-binding-index variable))))
  (let ((special (rassoc variable *mir-parameter-specials*)))
    (when special (mir-enter-binding (car special) (mir-binding-value variable)))))

(defun mir-build-special-binding (node)
  (let ((value (mir-primary (hir-node-b node))))
    (when *mir-block*
      (let ((*mir-dynamic-bindings* *mir-dynamic-bindings*))
        (let ((outer *mir-dynamic-bindings*))
          (mir-enter-binding (hir-node-a node) value)
          (let ((result (mir-build-node (hir-node-c node))))
            (when *mir-block* (mir-leave-bindings outer) result)))))))

(defun mir-validate-progv-list (list symbols-p)
  (let* ((head (mir-new-block)) (body (mir-new-block)) (nonempty (mir-new-block))
         (bad (mir-new-block)) (done (mir-new-block))
         (cursor (mir-add-value *mir-function* :obj head -1)))
    (setf (mir-block-parameters (mir-at (mir-function-blocks *mir-function*) head))
          (concatenate 'simple-vector
                       (mir-block-parameters (mir-at (mir-function-blocks *mir-function*) head)) (vector cursor)))
    (labels ((next (value)
               (mir-terminate 0 #() (vector (make-mir-edge :target head
                                              :arguments (concatenate 'simple-vector *mir-environment* (vector value)))))))
      (next list)
      (mir-start head)
      (mir-branch cursor nonempty done)
      (mir-start nonempty)
      (mir-branch (mir-call-primary 'consp cursor) body bad)
      (mir-start bad)
      (mir-argument-error :progv-list cursor)
      (mir-start body)
      (when symbols-p
        (let ((symbol (mir-call-primary 'car cursor)) (valid (mir-new-block)) (invalid (mir-new-block)))
          (mir-branch (mir-call-primary 'symbolp symbol) valid invalid)
          (mir-start invalid)
          (mir-argument-error :progv-symbol symbol)
          (mir-start valid)))
      (next (mir-call-primary 'cdr cursor)))
    (mir-start done)))

(defun mir-build-progv (node)
  (let ((symbols (mir-primary (hir-node-a node))))
    (when *mir-block*
      (let ((values (mir-primary (hir-node-b node))))
        (when *mir-block*
          (mir-validate-progv-list symbols nil)
          (mir-validate-progv-list values nil)
          (mir-validate-progv-list symbols t)
          (let ((*mir-dynamic-bindings* *mir-dynamic-bindings*) (outer *mir-dynamic-bindings*)
                (id *mir-next-binding*))
            (incf *mir-next-binding*)
            (mir-instruction 29 nil (vector symbols values) id)
            (push id *mir-dynamic-bindings*)
            (let ((result (mir-build-node (hir-node-c node))))
              (when *mir-block* (mir-leave-bindings outer) result))))))))

(defun mir-build-catch (node)
  (let ((tag (mir-primary (hir-node-a node))))
    (when *mir-block*
      (let ((body (mir-new-block)) (landing (mir-new-block)) (join (mir-new-block :bundle))
            (id *mir-next-binding*))
        (incf *mir-next-binding*)
        (mir-instruction 30 nil (vector tag) id)
        (mir-terminate 5 #() (vector (mir-edge-to body) (mir-edge-to landing)))
        (let ((*mir-dynamic-bindings* (cons id *mir-dynamic-bindings*)))
          (mir-start body)
          (let ((value (mir-build-node (hir-node-b node))))
            (when *mir-block*
              (mir-instruction 28 nil #() id)
              (mir-jump join value))))
        (mir-start landing)
        (mir-jump join (mir-instruction 31 :bundle #() id))
        (mir-start join)
        (svref (mir-block-parameters *mir-block*) (length *mir-environment*))))))

(defun mir-build-unwind-protect (node)
  (let ((body (mir-new-block)) (landing (mir-new-block)) (join (mir-new-block :bundle))
        (id *mir-next-binding*) (outer *mir-dynamic-bindings*))
    (incf *mir-next-binding*)
    (setf (gethash id *mir-cleanups*) (hir-node-b node))
    (mir-instruction 32 nil #() id)
    (mir-terminate 5 #() (vector (mir-edge-to body) (mir-edge-to landing)))
    (let ((*mir-dynamic-bindings* (cons id outer)))
      (mir-start body)
      (let ((value (mir-build-node (hir-node-a node))))
        (when *mir-block* (mir-leave-bindings outer) (mir-jump join value))))
    (mir-start landing)
    (mir-instruction 33 nil #() id)
    (let ((*mir-dynamic-bindings* (cons (cons id :cleanup) outer)))
      (mir-build-node (hir-node-b node))
      (when *mir-block* (mir-terminate 6 #() #() id)))
    (when (mir-has-predecessor-p join)
      (mir-start join)
      (svref (mir-block-parameters *mir-block*) (length *mir-environment*)))))

(defun mir-build-sequence (nodes primary-p)
  (if (zerop (length nodes))
      (let ((value (mir-instruction 0 :obj #() nil)))
        (if primary-p value (mir-single value)))
      (let ((last (1- (length nodes))))
        (loop for index below last while *mir-block*
              do (mir-build-node (svref nodes index)))
        (mir-build-node (svref nodes last) primary-p))))

(defun mir-has-predecessor-p (target)
  (loop for block across (hir-buffer-view (mir-function-blocks *mir-function*))
        thereis (let ((term (mir-block-terminator block)))
                  (and term (find target (mir-terminator-edges term) :key #'mir-edge-target)))))

(defun mir-build-if (node primary-p)
  (let ((test (mir-primary (hir-node-a node))))
    (unless *mir-block* (return-from mir-build-if nil))
    (let ((yes (mir-new-block)) (no (mir-new-block)) (join (mir-new-block (if primary-p :obj :bundle))))
      (mir-terminate 1 (vector test) (vector (mir-edge-to yes) (mir-edge-to no)))
      (mir-start yes)
      (let ((value (mir-build-node (hir-node-b node) primary-p))) (mir-jump join value))
      (mir-start no)
      (let ((value (mir-build-node (hir-node-c node) primary-p))) (mir-jump join value))
      (when (mir-has-predecessor-p join)
        (mir-start join)
        (svref (mir-block-parameters *mir-block*) (length *mir-environment*))))))

(defun mir-build-mv-let (node primary-p)
  (let* ((variables (hir-node-a node))
         (bundle (mir-build-node (svref (hir-node-b node) 0))))
    (when *mir-block*
      (let ((values (make-array (length variables))))
        (dotimes (index (length variables))
          (setf (svref values index) (mir-instruction 14 :obj (vector bundle) index)))
        (loop for variable across variables for value across values
              do (mir-establish-binding variable (mir-check value (hir-var-type variable))))
        (mir-build-node (hir-node-c node) primary-p)))))

(defun mir-build-let (node primary-p)
  (when (hir-node-d node) (return-from mir-build-let (mir-build-mv-let node primary-p)))
  (let ((variables (hir-node-a node)) (inits (hir-node-b node)) (values nil))
    (loop for variable across variables for init across inits while *mir-block*
          for value = (mir-primary init)
          do (when *mir-block* (push (mir-check value (hir-var-type variable)) values)))
    (when *mir-block*
      (loop for variable across variables for value in (nreverse values)
            do (mir-establish-binding variable value))
      (mir-build-node (hir-node-c node) primary-p))))

(defun mir-exit-token (exit)
  (let* ((empty (mir-instruction 0 :obj #() nil)) (token (mir-call-primary 'cons empty empty)))
    (mir-establish-binding (hir-exit-token exit) token)
    token))

(defun mir-build-block (node)
  (let* ((exit (hir-node-a node)) (target (mir-new-block :bundle))
         (nonlocal (logtest 1 (hir-exit-flags exit)))
         (outer *mir-dynamic-bindings*) (landing nil) (id nil))
    (when nonlocal
      (let ((token (mir-exit-token exit)) (body (mir-new-block)))
        (setf landing (mir-new-block) id *mir-next-binding*)
        (incf *mir-next-binding*)
        (mir-instruction 34 nil (vector token) id)
        (mir-terminate 5 #() (vector (mir-edge-to body) (mir-edge-to landing)))
        (mir-start body)))
    (let ((*mir-exits* (cons (list exit target outer) *mir-exits*))
          (*mir-dynamic-bindings* (if nonlocal (cons id outer) outer)))
      (let ((value (mir-build-node (hir-node-b node))))
        (when *mir-block* (when nonlocal (mir-instruction 28 nil #() id)) (mir-jump target value))))
    (when nonlocal
      (mir-start landing)
      (mir-jump target (mir-instruction 31 :bundle #() id)))
    (when (mir-has-predecessor-p target)
      (mir-start target)
      (svref (mir-block-parameters *mir-block*) (length *mir-environment*)))))

(defun mir-build-tagbody (node)
  (let* ((segments (hir-node-a node)) (group (hir-node-b node))
         (nonlocal (logtest 1 (hir-exit-flags group)))
         (blocks (map 'simple-vector (lambda (segment) (declare (ignore segment)) (mir-new-block)) segments))
         (done (mir-new-block)) (*mir-exits* *mir-exits*)
         (*mir-dynamic-bindings* *mir-dynamic-bindings*) (landing nil) (id nil))
    (when nonlocal
      (let ((token (mir-exit-token group)) (body (mir-new-block)))
        (setf landing (mir-new-block) id *mir-next-binding*)
        (incf *mir-next-binding*)
        (mir-instruction 35 nil (vector token) id)
        (mir-terminate 5 #() (vector (mir-edge-to body) (mir-edge-to landing)))
        (push id *mir-dynamic-bindings*)
        (mir-start body)))
    (loop for segment across segments for block across blocks
          do (push (list (car segment) block *mir-dynamic-bindings*) *mir-exits*))
    (mir-jump (if (plusp (length blocks)) (svref blocks 0) done))
    (loop for segment across segments for block across blocks for i from 0
          do (mir-start block)
             (mir-build-node (cdr segment))
             (mir-jump (if (< (1+ i) (length blocks)) (svref blocks (1+ i)) done)))
    (when nonlocal
      (mir-start landing)
      (let ((index (mir-instruction 36 :obj #() id)))
        (loop for block across blocks for i from 0
              do (let ((next (mir-new-block)))
                   (mir-branch (mir-call-primary 'eql index (mir-instruction 0 :obj #() i)) block next)
                   (mir-start next)))
        (mir-terminate 3)))
    (mir-start done)
    (when nonlocal (mir-instruction 28 nil #() id))
    (mir-single (mir-instruction 0 :obj #() nil))))

(defun mir-build-call (node)
  (let* ((callee (hir-node-a node))
         (global (or (symbolp callee) (and (consp callee) (eq (car callee) 'setf))))
         (object (unless global
                   (if (hir-fun-p callee) (mir-function-object callee)
                       (mir-primary callee))))
         (arguments nil))
    (loop for arg across (hir-node-b node) while *mir-block* do (push (mir-primary arg) arguments))
    (when *mir-block*
      (mir-instruction (if global 6 7) :bundle
                       (coerce (if global (nreverse arguments) (cons object (nreverse arguments))) 'simple-vector)
                       (when global callee) (eq (hir-node-d node) :notinline)))))

(defun mir-build-mv-call (node)
  (let ((function (mir-primary (hir-node-a node))) (bundles nil))
    (loop for form across (hir-node-b node) while *mir-block*
          do (push (mir-build-node form) bundles))
    (when *mir-block*
      (mir-instruction 15 :bundle (coerce (cons function (nreverse bundles)) 'simple-vector)))))

(defun mir-build-node (node &optional primary-p)
  (unless *mir-block* (return-from mir-build-node nil))
  (let ((*mir-source* (hir-node-source node)) (*mir-policy* (hir-node-policy node))
        (*source-origin* (hir-node-origin node)))
    (flet ((single (value)
             (if primary-p value (mir-single value)))
           (bundle (value)
             (when *mir-block*
               (if primary-p (mir-instruction 10 :obj (vector value)) value))))
      (case (hir-node-kind node)
        (0 (single (if (hir-node-b node)
                       (mir-instruction 2 :obj #() (hir-node-b node))
                       (mir-instruction 0 :obj #() (hir-node-a node)))))
        (1 (let ((value (mir-binding-value (hir-node-a node))))
             (when (hir-node-b node) (setf value (mir-check value (hir-node-b node))))
             (single value)))
        (2 (let ((value (mir-primary (hir-node-b node))))
             (when *mir-block*
               (setf value (mir-check value (hir-var-type (hir-node-a node))))
               (let ((index (mir-binding-index (hir-node-a node))))
                 (if (logbitp index (mir-function-binding-cells *mir-function*))
                     (mir-instruction 21 nil (vector (svref *mir-environment* index) value))
                     (setf (svref *mir-environment* index) value))
                 (mir-debug-binding (hir-node-a node) (svref *mir-environment* index)))
               (single value))))
        (3 (single (mir-instruction 2 :obj #() (hir-node-a node))))
        (4 (let ((value (mir-primary (hir-node-b node))))
             (when *mir-block* (single (mir-instruction 3 :obj (vector value) (hir-node-a node))))))
        (5 (single (mir-instruction 4 :obj #() (hir-node-a node))))
        (6 (single (mir-function-object (hir-node-a node))))
        (7 (bundle (mir-build-call node)))
        (8 (let ((args nil))
             (loop for arg across (hir-node-a node) while *mir-block* do (push (mir-primary arg) args))
             (when *mir-block* (bundle (mir-instruction 8 :bundle (coerce (nreverse args) 'simple-vector) (hir-node-b node))))))
        (9 (mir-build-if node primary-p))
        (10 (mir-build-sequence (hir-node-a node) primary-p))
        (11 (mir-build-let node primary-p))
        (12 (bundle (mir-build-special-binding node)))
        (13 (bundle (mir-build-local-functions node)))
        (14 (bundle (mir-build-block node)))
        (15 (let ((entry (assoc (hir-node-a node) *mir-exits* :test #'eq)))
              (let ((value (mir-build-node (hir-node-b node))))
                (when *mir-block*
                  (if entry (progn (mir-leave-bindings (third entry)) (mir-jump (second entry) value))
                      (mir-terminate 7 (vector (mir-binding-value (hir-exit-token (hir-exit-group (hir-node-a node)))) value)))))))
        (16 (bundle (mir-build-tagbody node)))
        (17 (let* ((exit (hir-node-a node)) (entry (assoc exit *mir-exits* :test #'eq)))
              (if entry (progn (mir-leave-bindings (third entry)) (mir-jump (second entry)))
                  (mir-terminate 7
                    (vector (mir-binding-value (hir-exit-token (hir-exit-group exit)))
                            (mir-single (mir-instruction 0 :obj #() (hir-exit-index exit))))))))
        (18 (bundle (mir-build-catch node)))
        (19 (let ((tag (mir-primary (hir-node-a node))))
              (when *mir-block*
                (let ((values (mir-build-node (hir-node-b node))))
                  (when *mir-block* (mir-terminate 4 (vector tag values)))))))
        (20 (bundle (mir-build-unwind-protect node)))
        (21 (bundle (mir-build-mv-call node)))
        (22 (let ((value (mir-build-node (hir-node-a node))))
              (when *mir-block* (mir-build-node (hir-node-b node)))
              (bundle value)))
        (23 (let ((value (mir-build-node (hir-node-b node))))
              (when *mir-block*
                (bundle (mir-check value (hir-node-a node) :bundle)))))
        (24 (single (mir-instruction 26 :obj #() (gethash node *mir-load-time-indices*))))
        (25 (bundle (mir-build-progv node)))
        (otherwise (mir-unavailable (format nil "HIR kind ~D" (hir-node-kind node))))))))

(defun mir-bind-parameter (variable value)
  (mir-establish-binding variable (mir-check value (hir-var-type variable))))

(defun mir-build-optional (parameter index count)
  (let ((provided (mir-new-block)) (missing (mir-new-block)) (join (mir-new-block)))
    (mir-terminate 1 (vector (mir-instruction 16 :obj (vector count) index))
                   (vector (mir-edge-to provided) (mir-edge-to missing)))
    (mir-start provided)
    (mir-bind-parameter (svref parameter 0) (mir-instruction 1 :obj #() index))
    (when (svref parameter 2)
      (mir-bind-parameter (svref parameter 2) (mir-instruction 0 :obj #() t)))
    (mir-jump join)
    (mir-start missing)
    (let ((value (mir-primary (svref parameter 1))))
      (when *mir-block*
        (mir-bind-parameter (svref parameter 0) value)
        (when (svref parameter 2)
          (mir-bind-parameter (svref parameter 2) (mir-instruction 0 :obj #() nil)))
        (mir-jump join)))
    (mir-start join)
    (mir-activate-parameter (svref parameter 0) t)
    (mir-activate-parameter (svref parameter 2) t)))

(defun mir-call-primary (name &rest arguments)
  (mir-instruction 10 :obj (vector (mir-instruction 6 :bundle (coerce arguments 'simple-vector) name))))

(defun mir-branch (test yes no)
  (mir-terminate 1 (vector test) (vector (mir-edge-to yes) (mir-edge-to no))))

(defun mir-argument-error (reason value)
  (mir-instruction 18 nil (vector value) reason)
  (mir-terminate 3))

(defun mir-build-keyword (parameter value supplied)
  (let ((provided (mir-new-block)) (missing (mir-new-block)) (join (mir-new-block)))
    (mir-branch (svref *mir-environment* supplied) provided missing)
    (mir-start provided)
    (mir-bind-parameter (svref parameter 0) (svref *mir-environment* value))
    (mir-bind-parameter (svref parameter 2) (mir-instruction 0 :obj #() t))
    (mir-jump join)
    (mir-start missing)
    (let ((init (mir-primary (svref parameter 1))))
      (when *mir-block*
        (mir-bind-parameter (svref parameter 0) init)
        (mir-bind-parameter (svref parameter 2) (mir-instruction 0 :obj #() nil))
        (mir-jump join)))
    (mir-start join)
    (mir-activate-parameter (svref parameter 0) t)
    (mir-activate-parameter (svref parameter 2) t)))

(defun mir-import-function (hir)
  (multiple-value-bind (old found) (gethash hir *mir-functions*)
    (when found (return-from mir-import-function old)))
  (let* ((ll (hir-fun-lambda-list hir))
         (id (hir-buffer-count (mir-unit-functions *mir-unit*)))
         (bindings (hir-buffer-view (hir-fun-vars hir)))
         (captures (mir-captures hir))
         (all-bindings (concatenate 'simple-vector bindings captures))
         (binding-count (length all-bindings))
         (keys (hir-lambda-list-keys ll))
         (scratch (if (hir-lambda-list-key-p ll) (* 2 (length keys)) 0))
         (*mir-function* (make-mir-function :id id :name (hir-fun-name hir) :debug-name (mir-source-debug-name hir) :source (hir-fun-source hir)
                                           :policy (hir-fun-policy hir) :required (length (hir-lambda-list-required ll))
                                           :optional (length (hir-lambda-list-optional ll)) :rest (not (null (hir-lambda-list-rest ll)))
                                           :key-p (hir-lambda-list-key-p ll) :keys (map 'simple-vector (lambda (parameter) (svref parameter 3)) keys)
                                           :allow-other-keys (hir-lambda-list-allow-other-keys ll)
                                           :captures (map 'simple-vector #'hir-var-name captures)
                                           :capture-functions (make-array (length captures) :initial-element nil)
                                           :binding-cells (loop for variable across all-bindings for index from 0
                                                                when (gethash variable *mir-cell-variables*) sum (ash 1 index))
                                           :capture-cells (loop for variable across captures for index from 0
                                                                when (gethash variable *mir-cell-variables*) sum (ash 1 index))
                                           :bindings (concatenate 'simple-vector (map 'simple-vector #'hir-var-name all-bindings)
                                                                  (make-array scratch :initial-element :keyword-temporary))))
         (*mir-bindings* (make-hash-table :test 'eq))
         (*mir-exits* nil) (*mir-block* nil) (*mir-environment* nil)
         (*mir-dynamic-bindings* nil) (*mir-next-binding* 0)
         (*mir-parameter-specials* (hir-fun-parameter-specials hir)) (*mir-cleanups* (make-hash-table :test 'eql))
         (*mir-policy* (hir-fun-policy hir)) (*mir-source* (hir-fun-source hir)) (*source-origin* (hir-fun-origin hir)))
    (hir-push *mir-function* (mir-unit-functions *mir-unit*))
    (setf (gethash hir *mir-functions*) id)
    (loop for variable across all-bindings for index from 0
          do (setf (gethash variable *mir-bindings*) index))
    (loop for variable across captures for index from 0
          for target = (gethash variable *mir-function-bindings*)
          when (and target (not (gethash variable *mir-cell-variables*)))
            do (setf (svref (mir-function-capture-functions *mir-function*) index) (mir-import-function target)))
    (let ((entry (make-mir-block :id 0)))
      (hir-push entry (mir-function-blocks *mir-function*))
      (setf *mir-block* entry)
      (let ((nil-value (mir-instruction 0 :obj #() nil)))
        (setf *mir-environment* (make-array (length (mir-function-bindings *mir-function*)) :initial-element nil-value)))
      (let ((count (mir-instruction 12 :count)) (rest nil))
        (mir-instruction 13 nil (vector count)
                         (cons (mir-function-required *mir-function*) (mir-function-maximum *mir-function*)))
        (when (mir-function-tail-p *mir-function*)
          (setf rest (mir-instruction 17 :obj (vector count) (mir-function-positional-count *mir-function*))))
        (when (plusp (mir-function-binding-cells *mir-function*))
          (let ((unbound (mir-instruction 25 :cell)))
            (dotimes (index (length *mir-environment*))
              (when (logbitp index (mir-function-binding-cells *mir-function*))
                (setf (svref *mir-environment* index) unbound)))))
        (loop for variable across captures for index from 0
              do (setf (svref *mir-environment* (mir-binding-index variable))
                       (mir-instruction 22 (if (gethash variable *mir-cell-variables*) :cell :obj) #() index))
                 (mir-debug-binding variable (svref *mir-environment* (mir-binding-index variable))))
        ;; Defaults can mutate the rest list. Take the snapshot before
        ;; activating parameters, then bind each key in source order.
        (when (hir-lambda-list-key-p ll)
          (let ((snapshot (mir-call-primary 'kiln.kernel::%snapshot-keywords rest
                            (mir-instruction 0 :obj #() (mir-function-keys *mir-function*))
                            (mir-instruction 0 :obj #() (hir-lambda-list-allow-other-keys ll)))))
            (dotimes (index scratch)
              (setf (svref *mir-environment* (+ binding-count index))
                    (mir-instruction 10 :obj
                      (vector (mir-instruction 8 :bundle
                                (vector snapshot (mir-instruction 0 :obj #() index)) :svref-unchecked)))))))
        (loop for variable across (hir-lambda-list-required ll) for index from 0
              do (mir-bind-parameter variable (mir-instruction 1 :obj #() index))
                 (mir-activate-parameter variable))
        (loop for parameter across (hir-lambda-list-optional ll)
              for index from (mir-function-required *mir-function*)
              do (mir-build-optional parameter index count))
        (when (hir-lambda-list-rest ll)
          (mir-bind-parameter (hir-lambda-list-rest ll) rest)
          (mir-activate-parameter (hir-lambda-list-rest ll)))
        (loop for parameter across keys for index from binding-count by 2
              do (mir-build-keyword parameter index (1+ index))))
      (let ((value (mir-build-node (hir-fun-body hir))))
        (when *mir-block* (mir-leave-bindings nil) (mir-terminate 2 (vector value))))
      (loop for block across (hir-buffer-view (mir-function-blocks *mir-function*))
            unless (mir-block-terminator block)
              do (setf (mir-block-terminator block) (make-mir-terminator :kind 3))))
    (mir-materialize-bindings *mir-function*)
    id))

(defun hir-to-mir (hir)
  (with-compilation-phase (:mir-build)
    (let ((*mir-source-root* hir) (*mir-debug-names* (make-hash-table :test 'eq)) (*mir-unit* (make-mir-unit)) (*mir-functions* (make-hash-table :test 'eq))
          (*mir-load-time-indices* (make-hash-table :test 'eq)) (*mir-load-time-nodes* (make-hir-buffer))
          (*mir-static-function-bindings* (make-hash-table :test 'eq))
          (*mir-function-bindings* (make-hash-table :test 'eq))
          (*mir-cell-variables* (make-hash-table :test 'eq)))
      (mir-catalog-functions hir)
      (mir-import-function hir)
      (setf (mir-unit-load-time-functions *mir-unit*)
            (map 'simple-vector (lambda (node) (mir-import-function (hir-node-a node)))
                 (hir-buffer-view *mir-load-time-nodes*)))
      (when (plusp (length (mir-function-captures (mir-at (mir-unit-functions *mir-unit*) 0))))
        (mir-unavailable "root function requires an environment"))
      (verify-mir *mir-unit*)
      *mir-unit*)))
