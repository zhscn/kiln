(in-package #:kiln.compiler)

(defun mir-lifting-policy-p (function)
  (and (< (hir-policy-quality (mir-function-policy function) :debug) 2)
       (every (lambda (instruction)
                (and (hir-policy-optimize-p (mir-instruction-policy instruction))
                     (< (hir-policy-quality (mir-instruction-policy instruction) :debug) 2)))
              (hir-vector (mir-function-instructions function)))))

(defun mir-lifting-widths (unit calls)
  "Prove private captured entries and source argument counts safe for lifting."
  (let* ((functions (hir-vector (mir-unit-functions unit)))
         (widths (make-array (length functions) :initial-element nil))
         (constructors (make-array (length functions) :initial-element 0))
         (uses (make-array (length functions) :initial-element 0)))
    (loop for function across functions for id from 0
          for width = (length (mir-function-captures function))
          when (and (plusp width) (zerop (mir-function-capture-cells function))
                    (every #'null (mir-function-capture-functions function))
                    (<= (+ width (mir-function-positional-count function)) kiln.kir::+backend-argument-limit+)
                    (not (logbitp id (mir-call-analysis-external calls)))
                    (mir-lifting-policy-p function))
            do (setf (svref widths id) width))
    (loop for function across functions
          for identities across (mir-call-analysis-identities calls)
          for reachable = (mir-reachable-blocks function)
          do (loop for block across (hir-vector (mir-function-blocks function))
                   when (logbitp (mir-block-id block) reachable)
                     do (loop for id across (hir-vector (mir-block-instructions block))
                              for instruction = (mir-at (mir-function-instructions function) id)
                              for kind = (mir-instruction-kind instruction)
                              for args = (mir-instruction-operands instruction)
                              for target = (cond ((= kind 23) (mir-instruction-data instruction))
                                                 ((member kind '(7 15)) (svref identities (svref args 0))))
                              when (and (integerp target) (svref widths target))
                                do (cond ((not (mir-lifting-policy-p function)) (setf (svref widths target) nil))
                                         ((= kind 23) (incf (svref constructors target)))
                                         ((and (= kind 7)
                                               (<= (mir-function-required (svref functions target)) (1- (length args)))
                                               (or (null (mir-function-maximum (svref functions target)))
                                                   (<= (1- (length args)) (mir-function-maximum (svref functions target))))
                                               (<= (+ (1- (length args)) (svref widths target)) kiln.kir::+backend-argument-limit+))
                                          (incf (svref uses target)))
                                         (t (setf (svref widths target) nil))))))
    (dotimes (id (length widths))
      (unless (and (plusp (svref constructors id)) (plusp (svref uses id)))
        (setf (svref widths id) nil)))
    widths))

(defun mir-lift-function (function widths identities)
  "Thread each lifted function value's environment through its SSA copies."
  (let* ((blocks (hir-vector (mir-function-blocks function)))
         (instructions (mir-function-instructions function))
         (original-parameters (map 'simple-vector #'mir-block-parameters blocks))
         (environments (make-array (length identities) :initial-element nil))
         (own-width (svref widths (mir-function-id function)))
         (rebuilt-instructions (make-hir-buffer))
         (nil-value nil) (nil-instruction nil))
    (labels ((width (value)
               (let ((target (svref identities value)))
                 (and (integerp target) (svref widths target))))
             (environment (value) (svref environments value)))
      ;; Block parameters are the join points for different closure instances.
      ;; Their environment fields must travel along the same incoming edges.
      (loop for block across blocks
            do (let ((extra nil))
                 (loop for parameter across (mir-block-parameters block) for count = (width parameter)
                       when count do
                         (setf (svref environments parameter)
                               (map 'simple-vector
                                    (lambda (unused)
                                      (declare (ignore unused))
                                      (let ((id (mir-add-value function :obj (mir-block-id block) -1)))
                                        (push id extra) id))
                                    (make-array count))))
                 (setf (mir-block-parameters block)
                       (concatenate 'simple-vector (mir-block-parameters block) (nreverse extra)))))
      (loop for instruction across (hir-vector instructions)
            when (and (= (mir-instruction-kind instruction) 23) (svref widths (mir-instruction-data instruction)))
              do (setf (svref environments (mir-instruction-result instruction))
                       (make-array (svref widths (mir-instruction-data instruction)) :initial-element nil)))
      (loop for instruction across (hir-vector instructions)
            when (and (= (mir-instruction-kind instruction) 24) (svref widths (car (mir-instruction-data instruction))))
              do (let* ((args (mir-instruction-operands instruction)) (fields (environment (svref args 0))))
                   (unless fields (mir-fail "Lifted closure initialization lacks its constructor"))
                   (setf (svref fields (cdr (mir-instruction-data instruction))) (svref args 1))))
      (loop with changed = t while changed do
        (setf changed nil)
        (loop for instruction across (hir-vector instructions)
              for result = (mir-instruction-result instruction)
              when (and result (width result) (not (environment result))) do
                (let* ((kind (mir-instruction-kind instruction)) (args (mir-instruction-operands instruction))
                       (source (and (plusp (length args))
                                    (or (member kind '(9 10 11))
                                        (and (= kind 14) (zerop (mir-instruction-data instruction)))
                                        (and (= kind 6) (member (mir-instruction-data instruction) '(identity values))))
                                    (svref args 0))))
                  (when (and source (environment source))
                    (setf (svref environments result) (environment source) changed t)))))
      ;; Unreachable edges still need well-formed arguments. A NIL seed is
      ;; harmless on those edges; reachable sources must have real fields.
      (when (loop for block across blocks for original across original-parameters
                  thereis (> (length (mir-block-parameters block)) (length original)))
        (setf nil-value (mir-add-value function :obj 0 0)
              nil-instruction (make-mir-instruction :kind 0 :result nil-value :policy (mir-function-policy function))))
      (when own-width
        (incf (mir-function-required function) own-width)
        (setf (mir-function-captures function) #() (mir-function-capture-cells function) 0
              (mir-function-capture-functions function) #()))
      (loop for block across blocks for rebuilt = (make-hir-buffer) do
        (labels ((append-instruction (instruction)
                   (setf (mir-instruction-id instruction) (hir-buffer-count rebuilt-instructions))
                   (when (mir-instruction-result instruction)
                     (setf (mir-value-position (mir-at (mir-function-values function) (mir-instruction-result instruction)))
                           (hir-buffer-count rebuilt)))
                   (hir-push (mir-instruction-id instruction) rebuilt)
                   (hir-push instruction rebuilt-instructions)))
          (when (and (zerop (mir-block-id block)) nil-instruction) (append-instruction nil-instruction))
          (loop for id across (hir-vector (mir-block-instructions block))
                for instruction = (mir-at instructions id)
                for kind = (mir-instruction-kind instruction)
                for args = (mir-instruction-operands instruction)
                for data = (mir-instruction-data instruction)
                unless (and (= kind 24) (svref widths (car data))) do
                  (when own-width
                    (case kind
                      ((1 16 17) (incf (mir-instruction-data instruction) own-width))
                      (22 (setf (mir-instruction-kind instruction) 1
                                (mir-instruction-effects instruction) (svref *mir-instruction-effects* 1)))
                      (13 (setf (mir-instruction-data instruction)
                                (cons (mir-function-required function) (mir-function-maximum function))))))
                  (when (and (= kind 23) (svref widths data))
                    (setf (mir-instruction-kind instruction) 5
                          (mir-instruction-effects instruction) (svref *mir-instruction-effects* 5)))
                  (when (and (= kind 7) (width (svref args 0)))
                    (let ((fields (environment (svref args 0))))
                      (unless (and fields (every #'integerp fields)) (mir-fail "Lifted call lacks its environment"))
                      (setf (mir-instruction-operands instruction)
                            (concatenate 'simple-vector (subseq args 0 1) fields (subseq args 1)))))
                  (append-instruction instruction)))
        (setf (mir-block-instructions block) rebuilt)
        (loop for edge across (mir-terminator-edges (mir-block-terminator block)) do
          (let ((extra nil))
            (loop for parameter across (svref original-parameters (mir-edge-target edge))
                  for source across (mir-edge-arguments edge)
                  for count = (width parameter)
                  when count do
                    (let ((fields (environment source)))
                      (unless (or fields (not (logbitp (mir-block-id block) (mir-reachable-blocks function))))
                        (mir-fail "Lifted edge lacks its environment"))
                      (dotimes (slot count) (push (if fields (svref fields slot) nil-value) extra))))
            (setf (mir-edge-arguments edge) (concatenate 'simple-vector (mir-edge-arguments edge) (nreverse extra))))))
      (setf (mir-function-instructions function) rebuilt-instructions)))
  function)

(defun mir-lift-local-functions (unit &key (parameter-budget 4096))
  (let* ((calls (mir-infer-calls unit)) (widths (mir-lifting-widths unit calls))
         (identities (mir-call-analysis-identities calls)))
    (unless (find-if #'identity widths) (return-from mir-lift-local-functions unit))
    (loop for function across (hir-vector (mir-unit-functions unit)) for known across identities
          for extra = (loop for block across (hir-vector (mir-function-blocks function))
                            sum (loop for parameter across (mir-block-parameters block)
                                      for target = (svref known parameter)
                                      sum (if (integerp target) (or (svref widths target) 0) 0)))
          when (> extra parameter-budget) do (return-from mir-lift-local-functions unit))
    (mir-run-unit-pass unit
      (lambda (unit)
        (loop for function across (hir-vector (mir-unit-functions unit)) for known across identities
              do (mir-lift-function function widths known)))))
  unit)
