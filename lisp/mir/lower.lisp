(defvar *compiler-stage-observer* nil
  "Optional diagnostic callback of (stage payload elapsed-ticks).
Inspect mutable payloads synchronously. The callback must not edit them.")

(defmacro observe-mir-pass (unit pass &rest options)
  `(if *compiler-stage-observer*
       (let ((start (get-internal-real-time)))
         (prog1 (,pass ,unit ,@options)
           (funcall *compiler-stage-observer* ',pass ,unit
                    (- (get-internal-real-time) start))))
       (,pass ,unit ,@options)))

(defun mir-optimize-unit (unit)
  "Optimize a verified unit through passes that preserve its verification contracts."
  (with-compilation-phase (:mir-optimize)
    (observe-mir-pass unit mir-simplify-block-parameters :preserve-refinements t)
    (let ((revision (mir-unit-revision unit)))
      (observe-mir-pass unit mir-specialize-direct-calls)
      (observe-mir-pass unit mir-fold-type-predicates)
      (observe-mir-pass unit mir-lift-local-functions)
      (observe-mir-pass unit mir-inline-local-functions)
      (observe-mir-pass unit mir-expand-list-calls)
      (when (or *compiler-stage-observer* (/= revision (mir-unit-revision unit)))
        (observe-mir-pass unit mir-specialize-direct-calls)
        (observe-mir-pass unit mir-fold-type-predicates)))
    (observe-mir-pass unit mir-scalar-replace)
    (observe-mir-pass unit mir-simplify-block-parameters)))

(defun mir-lower-toplevel (hir &optional initializer)
  (with-compilation-phase (:mir-lir)
    (when *compiler-stage-observer*
      (funcall *compiler-stage-observer* :hir hir nil))
    (let* ((initial (hir-to-mir hir))
           (unit (progn
                   (when *compiler-stage-observer*
                     (funcall *compiler-stage-observer* :initial-mir initial nil))
                   (mir-optimize-unit initial)))
           (*mir-lir-functions* (hir-buffer-view (mir-unit-functions unit)))
           (functions *mir-lir-functions*)
           (*mir-lir-packed-array-plans* (mir-packed-array-environments unit))
           (*mir-lir-load-time-cells* (map 'simple-vector
                                          (lambda (id) (declare (ignore id)) (fresh-label "kiln_mir_ltv_"))
                                          (mir-unit-load-time-functions unit)))
           (direct (and initializer (zerop (length *mir-lir-load-time-cells*))))
           (*mir-lir-labels*
             (let ((labels (make-array (length functions))))
               (dotimes (id (length functions) labels)
                 (setf (svref labels id)
                       (if (and direct (zerop id)) initializer (fresh-label "kiln_mir_")))))))
      (when *compiler-stage-observer*
        (funcall *compiler-stage-observer* :labels (cons functions *mir-lir-labels*) nil))
      (when (plusp (length *mir-lir-load-time-cells*))
        (setf (kiln.kir::kmodule-replayable-p *module*) nil)
        (loop for cell across *mir-lir-load-time-cells*
              do (kiln.kir::module-object-cell cell (nil-word))))
      (loop for function across functions for id from 0
            do (setf (gethash (svref *mir-lir-labels* id) (kiln.kir::kmodule-function-captures *module*))
                     (length (mir-function-captures function)))
               (let ((*regions* nil) (*debug-vars* nil) (*debug-var-count* 0)
                     (*function-name* (or (mir-function-debug-name function)
                                         (local-function-debug-name (or (mir-function-name function) '#:lambda)))))
                 (with-function ((svref *mir-lir-labels* id))
                   (let ((*self* (copy-to-var :self)))
                     (mir-lir-function-body function unit))
                   (set-function-debug *function-name* (hir-source-range (mir-function-source function))))))
      (loop for label across *mir-lir-labels* for function across functions
            when (zerop (length (mir-function-captures function)))
            do (module-data (kiln.kir::kir-name label "_fobj") `(:static-function ,label)))
      (unless direct
        (flet ((invoke-forms ()
                 (loop for id across (mir-unit-load-time-functions unit)
                       for cell across *mir-lir-load-time-cells*
                       for object = (copy-to-var
                                     `(:object-address ,(kiln.kir::kir-name (svref *mir-lir-labels* id) "_fobj")
                                                       :general))
                       do (emit `(:cell-set ,cell ,(emit-lisp-call object nil))))
                 (emit-lisp-call
                  (copy-to-var `(:object-address ,(kiln.kir::kir-name (svref *mir-lir-labels* 0) "_fobj")
                                                :general))
                  nil)))
          (if initializer
              (let ((*regions* nil) (*debug-vars* nil) (*debug-var-count* 0))
                (with-function (initializer)
                  (let ((*self* (copy-to-var :self)))
                    (emit-poll)
                    (invoke-forms)
                    (emit `(:return ,(nil-value) 1)))
                  (set-function-debug '(:top-level-form) nil))
                (module-data (kiln.kir::kir-name initializer "_fobj") `(:static-function ,initializer)))
              (invoke-forms)))))))
