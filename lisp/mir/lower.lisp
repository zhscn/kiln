(defun mir-lir-value (id) (svref *mir-lir-values* id))

(defun mir-lir-known-count (id)
  (let ((fact (svref *mir-lir-value-facts* id)))
    (and (mir-values-fact-p fact) (mir-values-fact-count fact))))

(defun mir-lir-single-p (id) (eql 1 (mir-lir-known-count id)))

(defun mir-lir-carrier-p (id)
  (and (svref *mir-lir-carriers* id) (not (mir-lir-single-p id))))

(defun mir-lir-transient-p (id)
  (and (svref *mir-lir-bundle-demand* id) (not (mir-lir-carrier-p id))
       (not (member (mir-lir-known-count id) '(0 1)))))

(defun mir-lir-save (id primary count)
  (let ((target (mir-lir-value id)))
    (if (mir-lir-transient-p id)
        (emit-move-values (car target) (cdr target) primary count)
        (progn
          (if (mir-lir-carrier-p id)
              (emit `(:save-values ,(car target) ,primary ,count ,(handler)))
              (unless (eq (car target) primary)
                (kiln.kir::emit-lir-assignment (car target) primary)))
          (unless (mir-lir-known-count id)
            (kiln.kir::emit-lir-assignment (cdr target) count))))))

(defun mir-lir-restore (id)
  (let ((value (mir-lir-value id)))
    (if (mir-lir-carrier-p id)
        (emit-restore-values (car value) (cdr value))
        (values (car value) (cdr value)))))

(defun mir-lir-copy-bundle (target source)
  (let ((out (mir-lir-value target)) (input (mir-lir-value source)))
    (when (mir-lir-transient-p target)
      (multiple-value-bind (primary count) (mir-lir-restore source)
        (emit-move-values (car out) (cdr out) primary count))
      (return-from mir-lir-copy-bundle))
    (if (and (mir-lir-carrier-p target) (mir-lir-carrier-p source))
        (progn (kiln.kir::emit-lir-assignment (car out) (car input))
               (unless (mir-lir-known-count target)
                 (kiln.kir::emit-lir-assignment (cdr out) (cdr input))))
        (progn
          (when (and (mir-lir-carrier-p target) (not (mir-lir-carrier-p source))
                     (not (mir-lir-single-p source)))
            (mir-fail "MIR bundle carrier demand was not propagated"))
          (multiple-value-bind (primary count) (mir-lir-restore source)
            (mir-lir-save target primary count))))))

(defun mir-lir-check (value type)
  (unless (or (zerop (hir-policy-quality *hir-policy* :safety)) (eq (hir-declaration-expanded type) t))
    (let ((bad (new-block t)) (done (new-block)))
      (br `(:eq ,(emit-typep-test value (hir-declaration-check-type type)) ,(nil-value)) bad done)
      (start-block bad)
      (emit-slow-call 'kiln.kernel::%declared-type-error value (constant-object (hir-declaration-original type)))
      (emit '(:trap))
      (start-block done))))

(defun mir-lir-typep-specialization (instruction)
  "Return a known type specifier only for optimizable two-argument TYPEP calls."
  (let ((operands (mir-instruction-operands instruction)))
    (when (and (= (mir-instruction-kind instruction) 6)
               (eq (mir-instruction-data instruction) 'typep) (= (length operands) 2)
               (hir-policy-optimize-p (mir-instruction-policy instruction))
               (not (mir-instruction-notinline instruction)))
      (let ((definition (svref *mir-lir-definitions*
                               (mir-primary-origin (svref operands 1) *mir-lir-definitions*))))
        (when (and definition (= (mir-instruction-kind definition) 0))
          (let ((type (mir-instruction-data definition)))
            (when (or (inline-typep-specifier-p type) (cached-typep-specifier-p type))
              (list type))))))))

(defun mir-lir-unit-random-p (instruction)
  (let ((operands (mir-instruction-operands instruction)))
    (and (= (mir-instruction-kind instruction) 6)
         (eq (mir-instruction-data instruction) 'random)
         (<= 1 (length operands) 2)
         (hir-policy-optimize-p (mir-instruction-policy instruction))
         (not (mir-instruction-notinline instruction))
         (let ((definition (svref *mir-lir-definitions*
                                  (mir-primary-origin (svref operands 0) *mir-lir-definitions*))))
           (and definition (= (mir-instruction-kind definition) 0)
                (eql (mir-instruction-data definition) 1d0))))))

(defun mir-lir-object-call-plan (instruction)
  "Find literal names and keys needed by guarded slot and constructor caches."
  (when (and (= (mir-instruction-kind instruction) 6)
             (hir-policy-optimize-p (mir-instruction-policy instruction))
             (not (mir-instruction-notinline instruction)))
    (let* ((name (mir-instruction-data instruction))
           (operands (mir-instruction-operands instruction)) (count (length operands)))
      (labels ((constant (index)
                 (let ((definition (svref *mir-lir-definitions*
                                          (mir-primary-origin (svref operands index) *mir-lir-definitions*))))
                   (when (and definition (= (mir-instruction-kind definition) 0))
                     (values (mir-instruction-data definition) t)))))
        (cond ((or (and (eq name 'slot-value) (= count 2))
                   (and (equal name '(setf slot-value)) (= count 3)))
               (multiple-value-bind (slot known) (constant (1- count))
                 (when (and known (symbolp slot))
                   (list (if (= count 2) :slot-read :slot-write) slot))))
              ((and (eq name 'make-instance) (oddp count) (call-site-specialization-p)
                    (<= count kiln.kir::+backend-argument-limit+))
               (multiple-value-bind (class known) (constant 0)
                 (when (and known class (symbolp class))
                   (let ((keys nil))
                     (loop for index from 1 below count by 2 do
                       (multiple-value-bind (key known) (constant index)
                         (unless (and known (symbolp key)) (return-from mir-lir-object-call-plan nil))
                         (push key keys)))
                     (list :constructor class (nreverse keys)))))))))))

(defun mir-lir-vector-search-options (instruction)
  (let ((operands (mir-instruction-operands instruction))
        (policy (mir-instruction-policy instruction)))
    (when (and (member (mir-instruction-data instruction) '(find position))
               (<= 2 (length operands) 12)
               (evenp (length operands))
               (hir-policy-optimize-p policy)
               (not (mir-instruction-notinline instruction))
               (eq (svref *mir-lir-types* (svref operands 1)) 'simple-vector)
               (>= (hir-policy-quality policy :speed) (hir-policy-quality policy :space)))
      (let ((test 'eql) (reverse-p nil) (seen nil)
            (item-type (svref *mir-lir-types* (svref operands 0))))
        (flet ((definition (index)
                 (svref *mir-lir-definitions*
                        (mir-primary-origin (svref operands index) *mir-lir-definitions*))))
          (loop for index from 2 below (length operands) by 2
                for key-def = (definition index)
                for key = (and key-def (zerop (mir-instruction-kind key-def))
                               (mir-instruction-data key-def))
                for value = (definition (1+ index))
                do (unless (and key value (not (member key seen)))
                     (return-from mir-lir-vector-search-options nil))
                   (push key seen)
                   (let ((kind (mir-instruction-kind value))
                         (data (mir-instruction-data value)))
                     (unless (case key
                               (:test (and (member kind '(0 4)) (member data '(eq eql))
                                           (setf test data)))
                               (:from-end (when (zerop kind) (setf reverse-p (not (null data))) t))
                               ((:key :end) (and (zerop kind) (null data)))
                               (:start (and (zerop kind) (eql data 0))))
                       (return-from mir-lir-vector-search-options nil)))))
        (values (if (and (eq test 'eql) (hir-fixnum-type-p item-type)) 'eq test)
                reverse-p)))))

(defun mir-lir-vector-search (name test item vector unroll reverse-p)
  (let* ((length (copy-to-var `(:vector-length ,vector) :raw))
         (index (copy-to-var (if reverse-p length 0) :raw))
         (result (new-var))
         (number-p (when (eq test 'eql) (new-var :raw)))
         (head (new-block)) (body (new-block)) (next (new-block))
         (hit (new-block)) (miss (new-block)) (done (new-block))
         (unequal (if number-p (new-block) next)))
    (flet ((position-at (offset)
             (let ((delta (if reverse-p (- -1 offset) offset)))
               (if (zerop delta) index
                   (copy-to-var `(:word-add ,index ,delta) :raw))))
           (emit-hit (element position)
             (kiln.kir::emit-lir-assignment result
               (if (eq name 'find) element `(:fixnum-tag ,position)))
             (jump done)))
      (when number-p (emit `(:heap-number-p ,number-p ,item)))
      (when unroll
        (let ((batch (new-block)) (scan (new-block)))
          (jump batch)
          (start-block batch)
          (br (if reverse-p `(:word-le 4 ,index)
                  `(:word-le (:word-add ,index 4) ,length)) scan head)
          (start-block scan)
          (emit-poll)
          (dotimes (offset 4)
            (let* ((position (position-at offset))
                   (element (copy-to-var `(:vector-ref ,vector ,position)))
                   (found (new-block)) (continue (new-block)))
              (br `(:eq ,item ,element) found continue)
              (start-block found)
              (emit-hit element position)
              (start-block continue)))
          (emit `(:set ,index (:word-add ,index ,(if reverse-p -4 4))))
          (jump batch)))
      (unless unroll (jump head))
      (start-block head)
      (br (if reverse-p `(:word-lt 0 ,index)
              `(:word-lt ,index ,length)) body miss)
      (start-block body)
      (emit-poll)
      (let* ((position (position-at 0))
             (element (copy-to-var `(:vector-ref ,vector ,position))))
        (br `(:eq ,item ,element) hit unequal)
        (when number-p
          (let ((slow (new-block t)))
            (start-block unequal)
            (br number-p slow next)
            (start-block slow)
            (let ((equal (emit-slow-call 'kiln.kernel::eql-slow item element)))
              (br `(:eq ,equal ,(nil-value)) next hit))))
        (start-block hit)
        (emit-hit element position))
      (start-block next)
      (kiln.kir::emit-lir-assignment index `(:word-add ,index ,(if reverse-p -1 1)))
      (jump head))
    (start-block miss)
    (kiln.kir::emit-lir-assignment result (nil-value))
    (jump done)
    (start-block done)
    result))

(defun mir-lir-container-call (instruction)
  (when (and (= (mir-instruction-kind instruction) 6)
             (hir-policy-optimize-p (mir-instruction-policy instruction))
             (not (mir-instruction-notinline instruction)))
    (let* ((name (mir-instruction-data instruction)) (operands (mir-instruction-operands instruction))
           (count (length operands))
           (store (and (= count 3) (member name '((setf aref) (setf svref) (setf elt) (setf char) (setf schar)) :test #'equal)))
           (type (and (plusp count) (svref *mir-lir-types* (svref operands (if store 1 0))))))
      (values
       (cond ((and (= count 2) (eq name 'array-dimension)
                   (hir-fixed-array-dimension type (svref *mir-lir-types* (svref operands 1))))
              :fixed-array-dimension)
             ((and (= count 1) (eq name 'length) (member type '(simple-vector :native-string))) :length)
             ((and (= count 1) (eq name 'length) (hir-simple-specialized-vector-p type)) :specialized-array-length)
             ((and (= count 2) (eq name 'aref) (hir-simple-specialized-array-p type)) :specialized-array-read)
             ((and store (equal name '(setf aref)) (hir-simple-specialized-array-p type)
                   (hir-known-subtype-p (svref *mir-lir-types* (svref operands 0))
                                        (hir-specialized-element-type (second type))))
              :specialized-array-write)
             ((and (= count 2) (member name '(aref svref elt)) (eq type 'simple-vector)) :vector-read)
             ((and store (member name '((setf aref) (setf svref) (setf elt)) :test #'equal)
                   (eq type 'simple-vector)) :vector-write)
             ((and (= count 2) (member name '(aref char schar elt)) (eq type :native-string)) :string-read)
             ((and store (member name '((setf aref) (setf char) (setf schar) (setf elt)) :test #'equal)
                   (eq type :native-string)) :string-write)
             ((and (= count 2) (eq name 'elt) (eq type :simple-array-vector)) :array-read)
             ((and store (equal name '(setf elt)) (eq type :simple-array-vector)) :array-write))
       type))))

(defun mir-lir-vector-contents-candidate-p (type)
  (and (hir-simple-specialized-array-p type)
       (or (eq (third type) '*) (hir-simple-specialized-vector-p type))))

(defun mir-lir-array-contents-source (value)
  ;; A declaration can first prove the representation on a copy. Stop
  ;; before any input that lacks the proof.
  (loop for definition = (svref *mir-lir-definitions* value)
        for input = (when (and definition (member (mir-instruction-kind definition) '(9 10 11 39)))
                      (svref (mir-instruction-operands definition) 0))
        while (and input (mir-lir-vector-contents-candidate-p (svref *mir-lir-types* input)))
        do (setf value input)
        finally (return value)))

(defun mir-lir-array-index-origin (id)
  (let* ((origin (mir-primary-origin id *mir-lir-definitions*))
         (instruction (svref *mir-lir-definitions* origin))
         (index (and instruction (= (mir-instruction-kind instruction) 0)
                     (mir-instruction-data instruction))))
    ;; Negative keys identify literals by value. SSA definitions have
    ;; nonnegative IDs and may denote a new index on each iteration.
    (if (and (integerp index) (<= 0 index +hir-vector-max-length+))
        (lognot index)
        origin)))

(defun mir-lir-plan-array-contents (function)
  (when (some #'mir-lir-vector-contents-candidate-p *mir-lir-types*)
    (let ((uses (make-hash-table :test #'eql))
          (sources (make-hash-table :test #'eql))
          (entry-values 0)
          (entry (mir-at (mir-function-blocks function) 0)))
      (loop for id across (hir-buffer-view (mir-block-instructions entry))
            for instruction = (mir-at (mir-function-instructions function) id)
            for result = (mir-instruction-result instruction)
            until (and result
                       (eq (mir-value-representation (mir-at (mir-function-values function) result))
                           :bundle))
            when (and result
                      (or (member (mir-instruction-kind instruction) '(1 22))
                          (and (= 11 (mir-instruction-kind instruction))
                               (logbitp (mir-primary-origin result *mir-lir-definitions*) entry-values))))
              do (setf entry-values (logior entry-values (ash 1 result))))
      (loop for instruction across (hir-buffer-view (mir-function-instructions function))
            do (multiple-value-bind (operation type) (mir-lir-container-call instruction)
                 (when (and (member operation '(:specialized-array-read :specialized-array-write))
                            (mir-lir-vector-contents-candidate-p type))
                   (let* ((array (svref (mir-instruction-operands instruction)
                                        (if (eq operation :specialized-array-write) 1 0)))
                          (source (mir-lir-array-contents-source array))
                          (definition (svref *mir-lir-definitions* source)))
                     ;; The lookup makes a Lisp call. Use the argument and
                     ;; capture setup, including its declaration checks,
                     ;; before bundles exist, or follow a call
                     ;; whose own result occupies at most the primary slot.
                     (when (or (logbitp source entry-values)
                               (and definition (= (mir-instruction-kind definition) 6)
                                    (mir-lir-single-p source)))
                       (let* ((result (mir-instruction-result instruction))
                              (block (mir-value-block (mir-at (mir-function-values function) result))))
                         (let* ((store (eq operation :specialized-array-write))
                                (index (svref (mir-instruction-operands instruction) (if store 2 1)))
                                (origin (mir-lir-array-index-origin index))
                                (dimension (and (hir-simple-specialized-vector-p type) (first (third type)))))
                           (setf (gethash result sources)
                                 (list source origin (and (integerp dimension) dimension))))
                         (incf (gethash source uses 0)
                               (if (logbitp block (mir-cyclic-blocks function)) 2 1))))))))
      (values (sort (loop for value being the hash-keys of uses using (hash-value count)
                          when (>= count 2)
                            collect value)
                    #'<)
              sources))))

(defun mir-lir-array-bound-match (fact facts)
  (find-if (lambda (other)
             (and (= (first fact) (first other))
                  (eql (second fact) (second other))))
           facts))

(defun mir-lir-add-array-bound (fact facts)
  (let ((prior (mir-lir-array-bound-match fact facts)))
    (cond ((null prior) (cons fact facts))
          ((and (third fact) (< (third fact) (third prior)))
           (substitute fact prior facts :test #'eq))
          (t facts))))

(defun mir-lir-array-bound-edge (edge target facts blocks values)
  (when facts
    (let ((result nil)
          (parameters (mir-block-parameters (svref blocks target))))
      ;; Reentering the storage owner's block can produce a different array.
      (setf facts (remove-if (lambda (fact)
                              (let ((source (second fact)))
                                (and (integerp source) (= target (mir-value-block (svref values source))))))
                            facts))
      (dolist (fact facts)
        (unless (and (not (minusp (first fact)))
                     (= target (mir-value-block (svref values (first fact)))))
          (push fact result)))
      (loop for argument across (mir-edge-arguments edge)
            for parameter across parameters
            for origin = (mir-lir-array-index-origin argument)
            do (dolist (fact facts)
                 (when (= origin (first fact))
                   (setf result
                         (mir-lir-add-array-bound (cons parameter (cdr fact)) result)))))
      result)))

(defun mir-lir-array-length-sources (sources values pairs)
  (let ((arrays (make-hash-table :test #'eql))
        (seen (make-hash-table :test #'eql)))
    (maphash
     (lambda (result access)
       (declare (ignore result))
       (let* ((source (first access))
              (definition (svref *mir-lir-definitions* source)))
         (when (and (gethash source *mir-lir-array-contents*) definition
                    (hir-simple-specialized-vector-p (svref *mir-lir-types* source))
                    (not (gethash source seen)))
           (setf (gethash source seen) t)
           (cond ((and (= (mir-instruction-kind definition) 6)
                       (eq (mir-instruction-data definition) 'make-array))
                  (let* ((length (svref (mir-instruction-operands definition) 0))
                         (origin (mir-primary-origin length *mir-lir-definitions*)))
                    (when (zerop (mir-value-block (svref values origin)))
                      (push source (gethash origin arrays)))))
                 ((and pairs (= (mir-instruction-kind definition) 1))
                  (let ((positions (loop for (array-position . size-position) in pairs
                                         when (= array-position (mir-instruction-data definition))
                                           collect size-position)))
                    (when positions
                      (loop for value across *mir-lir-definitions* for id from 0
                            when (and value (= (mir-instruction-kind value) 1)
                                      (member (mir-instruction-data value) positions))
                              do (push source (gethash id arrays))))))))))
     sources)
    arrays))

(defun mir-lir-array-length-argument (length values)
  (let ((definition (svref *mir-lir-definitions* length)))
    (when (and definition (= (mir-instruction-kind definition) 6)
               (eq (mir-instruction-data definition) 'length)
               (not (mir-instruction-notinline definition))
               (= (length (mir-instruction-operands definition)) 1))
      (let* ((argument (svref (mir-instruction-operands definition) 0))
             (source (mir-lir-array-contents-source argument)))
        (when (and (gethash source *mir-lir-array-contents*)
                   ;; LENGTH returning normally proves that a simple array
                   ;; with unspecified rank is a vector.
                   (mir-lir-vector-contents-candidate-p (svref *mir-lir-types* source))
                   (zerop (mir-value-block (svref values source))))
          source)))))

(defun mir-lir-upper-bound-length (value inclusive)
  (let* ((origin (mir-primary-origin value *mir-lir-definitions*))
         (definition (svref *mir-lir-definitions* origin)))
    (if (not inclusive) origin
        (when (and definition (= (mir-instruction-kind definition) 6)
                   (eq (mir-instruction-data definition) '-)
                   (= (length (mir-instruction-operands definition)) 2))
          (let ((args (mir-instruction-operands definition)))
            (when (mir-induction-integer-constant-p (svref args 1) 1 *mir-lir-definitions*)
              (mir-primary-origin (svref args 0) *mir-lir-definitions*)))))))

(defun mir-lir-add-length-bound (index length lengths values block dominators facts &optional (through-min t))
  (let ((definition (svref *mir-lir-definitions* length)))
    (when (and through-min definition (= (mir-instruction-kind definition) 6)
               (eq (mir-instruction-data definition) 'min)
               (not (mir-instruction-notinline definition)))
      (let ((operands (mir-instruction-operands definition)))
        (when (and (= (length operands) 2)
                   (every (lambda (operand) (hir-fixnum-type-p (svref *mir-lir-types* operand)))
                          operands))
          (loop for operand across operands
                do (setf facts (mir-lir-add-length-bound
                                index (mir-primary-origin operand *mir-lir-definitions*)
                                lengths values block dominators facts nil)))))))
  (let ((array (mir-lir-array-length-argument length values)))
    (when array
      (setf facts (mir-lir-add-array-bound (list index array nil) facts))))
  (dolist (source (gethash length lengths) facts)
    (when (mir-block-dominates-p dominators (mir-value-block (svref values source)) block)
      (setf facts (mir-lir-add-array-bound (list index source nil) facts)))))

(defun mir-lir-array-nonempty-bounds (minimum size lengths values block dominators facts)
  (let ((range (hir-type-range (svref *mir-lir-types* minimum))))
    (if (and range (plusp (second range)))
        (let ((origin (mir-primary-origin size *mir-lir-definitions*)))
          (when (gethash origin lengths)
            (setf facts (mir-lir-add-array-bound (list origin :positive nil) facts)))
          (mir-lir-add-length-bound (lognot 0) origin lengths values block dominators facts))
        facts)))

(defun mir-lir-array-branch-bounds (term block lengths values dominators facts)
  (let* ((test (svref (mir-terminator-operands term) 0))
         (definition (svref *mir-lir-definitions*
                            (mir-primary-origin test *mir-lir-definitions*))))
    (when (and definition (= (mir-instruction-kind definition) 6)
               (not (mir-instruction-notinline definition))
               (= (length (mir-instruction-operands definition)) 2)
               (member (mir-instruction-data definition) '(= <=)))
      (let ((args (mir-instruction-operands definition)))
        (setf facts (mir-lir-array-nonempty-bounds (svref args 0) (svref args 1)
                                                   lengths values block dominators facts))
        (when (eq (mir-instruction-data definition) '=)
          (return-from mir-lir-array-branch-bounds
            (values (mir-lir-array-nonempty-bounds (svref args 1) (svref args 0)
                                                  lengths values block dominators facts)
                    0)))))
    (when (and definition (= (mir-instruction-kind definition) 6)
               (member (mir-instruction-data definition) '(< >= <= >))
               (= (length (mir-instruction-operands definition)) 2))
      (let* ((name (mir-instruction-data definition))
             (accepted-edge (if (member name '(< <=)) 0 1))
             (args (mir-instruction-operands definition))
             (index (svref args 0))
             (type (svref *mir-lir-types* index))
             (length (mir-lir-upper-bound-length (svref args 1) (member name '(<= >)))))
        (when (and length (hir-nonnegative-integer-type-p type))
          (setf facts (mir-lir-add-length-bound (mir-lir-array-index-origin index) length
                                                lengths values block dominators facts)))
        (return-from mir-lir-array-branch-bounds (values facts accepted-edge))))
    (values facts nil)))

(defun mir-lir-decremented-index (origin)
  (when (and origin (not (minusp origin)))
    (let ((definition (svref *mir-lir-definitions* origin)))
      (when (and definition (= (mir-instruction-kind definition) 6)
                 (eq (mir-instruction-data definition) '-)
                 (not (mir-instruction-notinline definition))
                 (= (length (mir-instruction-operands definition)) 2))
        (let ((operands (mir-instruction-operands definition)))
          (when (mir-induction-integer-constant-p (svref operands 1) 1 *mir-lir-definitions*)
            (mir-primary-origin (svref operands 0) *mir-lir-definitions*)))))))

(defun mir-lir-array-bound-inputs (function blocks sources unit)
  (let* ((inputs (make-array (length blocks) :initial-element :unseen))
         (generated (make-array (length blocks) :initial-element nil))
         (queued (make-array (length blocks) :element-type 'bit :initial-element 0))
         (values (hir-buffer-view (mir-function-values function)))
         (pairs (and unit (plusp (mir-function-internal-prefix function))
                     (svref (mir-vector-call-lengths unit) (mir-function-id function))))
         (lengths (mir-lir-array-length-sources sources values pairs))
         (dominators (when (plusp (hash-table-count lengths))
                       (nth-value 1 (mir-cached-control-flow function))))
         (pending (list 0))
         (decremented-indices nil))
    (maphash (lambda (result access)
               (destructuring-bind (source index limit) access
                 (when (and index (gethash source *mir-lir-array-contents*))
                   (let ((operand (mir-lir-decremented-index index)))
                     (when operand (pushnew operand decremented-indices)))
                   (let* ((block (mir-value-block (svref values result)))
                          (fact (list index (unless limit source) limit)))
                     (setf (svref generated block)
                           (mir-lir-add-array-bound fact (svref generated block)))))))
             sources)
    (setf (svref inputs 0) nil
          (sbit queued 0) 1)
    ;; The first reachable edge seeds a block. Later inputs can only weaken
    ;; its proof, so a backedge cannot establish its own premise.
    (loop while pending
          for id = (pop pending)
          for term = (mir-block-terminator (svref blocks id))
          for outgoing = (when (member (mir-terminator-kind term) '(0 1))
                           (reduce #'mir-lir-add-array-bound (svref generated id)
                                   :from-end t :initial-value (svref inputs id)))
          do (setf (sbit queued id) 0)
             (multiple-value-bind (branch-bounds accepted-edge)
                 (when (= (mir-terminator-kind term) 1)
                   (mir-lir-array-branch-bounds term id lengths values dominators outgoing))
               (loop for edge across (mir-terminator-edges term)
                     for edge-index from 0
                     for target = (mir-edge-target edge)
                     for previous = (svref inputs target)
                     for candidates = (mir-lir-array-bound-edge edge target
                                                                 (if (eql edge-index accepted-edge) branch-bounds outgoing)
                                                                 blocks values)
                     for next = (if (eq previous :unseen)
                                    candidates
                                    (loop for fact in previous
                                          for other = (mir-lir-array-bound-match fact candidates)
                                          when other
                                            collect (if (and (third fact) (> (third other) (third fact)))
                                                        other fact)))
                     unless (equal next previous)
                       do (setf (svref inputs target) next)
                          (when (zerop (sbit queued target))
                            (setf (sbit queued target) 1)
                            (push target pending)))))
    ;; Positivity shares the same join and SSA invalidation rules, but it
    ;; does not prove an upper bound for an ordinary array index.
    (let ((positive-inputs nil))
      (loop for facts across inputs for id from 0
            do (let ((bounds nil))
                 (when (consp facts)
                   (dolist (fact facts)
                     (destructuring-bind (index source limit) fact
                       (if (eq source :positive)
                           (progn
                             (unless positive-inputs
                               (setf positive-inputs (make-array (length blocks) :initial-element 0)))
                             (setf (svref positive-inputs id)
                                   (logior (svref positive-inputs id) (ash 1 index))))
                           (progn
                             (unless bounds (setf bounds (make-hash-table :test #'eql)))
                             (push (cons source limit) (gethash index bounds)))))))
                 (setf (svref inputs id) bounds)))
      (values inputs decremented-indices positive-inputs lengths))))

(defun mir-lir-positive-decrement (origin)
  (when (and *mir-lir-positive-values* (plusp *mir-lir-positive-values*))
    (let ((input (mir-lir-decremented-index origin)))
      (when (and input (logbitp input *mir-lir-positive-values*))
        input))))

(defun mir-lir-emit-vector-access (vector index value index-type slow-fn &optional length doublep singlep)
  (emit-svref-fast-path
   vector index
   (lambda (result)
     (mir-lir-vector-access vector index value doublep result singlep))
   slow-fn t (hir-fixnum-type-p index-type)
   length (cond (doublep :f64) (singlep :f32) (t :obj)) *mir-lir-in-loop*))

(defun mir-lir-vector-access (vector index value doublep result &optional singlep)
  (cond ((and doublep value)
         (emit `(:lir-store :double-storage-set-fixnum ,vector ,index ,value))
         (kiln.kir::emit-lir-assignment result value))
        (doublep
         (emit `(:lir-set ,result (:double-storage-ref-fixnum ,vector ,index))))
        (singlep
         (emit `(:lir-set ,result (:single-storage-ref-fixnum ,vector ,index))))
        (value
         (emit `(:lir-store :vector-set-fixnum ,vector ,index ,value))
         (kiln.kir::emit-lir-assignment result value))
        (t (emit `(:lir-set ,result (:vector-ref-fixnum ,vector ,index))))))

(defun mir-lir-double-array-access-p (operation type)
  (and (member operation '(:specialized-array-read :specialized-array-write))
       (eq (second type) 'double-float)))

(defun mir-lir-array-index-proven-p (source limit index-type bounds)
  (or (and limit (hir-fixnum-type-p index-type) (hir-range-p index-type)
           (<= 0 (second index-type))
           (< (third index-type) limit))
      (loop for (checked-source . checked-limit) in bounds
            thereis (if checked-limit
                        (and limit (<= checked-limit limit))
                        (eql source checked-source)))))

(defun mir-lir-reverse-index-upper-bound (index result)
  (when (and *mir-lir-shift-guarded-indices* index (not (minusp index)))
    (let* ((block (mir-value-block (svref *mir-lir-value-owners* result)))
           (definition (svref *mir-lir-definitions* index))
           (subtract (and definition (= (mir-instruction-kind definition) 6)
                          (eq (mir-instruction-data definition) '-)
                          (= (length (mir-instruction-operands definition)) 2)))
           (parameter (if subtract
                          (mir-primary-origin (svref (mir-instruction-operands definition) 1)
                                              *mir-lir-definitions*)
                          index))
           (upper (gethash parameter *mir-lir-shift-guarded-indices*)))
      ;; The guard belongs to this activation of the receiving block. The
      ;; forward and reverse indices are both between zero and UPPER.
      (when (and upper (= block (mir-value-block (svref *mir-lir-value-owners* parameter)))
                 (or (not subtract)
                     (and (= block (mir-value-block (svref *mir-lir-value-owners* index)))
                          (= upper
                             (mir-primary-origin (svref (mir-instruction-operands definition) 0)
                                                 *mir-lir-definitions*)))))
        (mir-lir-array-index-origin upper)))))

(defun mir-lir-array-index-checked-p (index source limit)
  (and index
       (or (and *mir-lir-index-bounds*
                (mir-lir-array-index-proven-p source limit nil (gethash index *mir-lir-index-bounds*)))
           (and *mir-lir-inherited-index-bounds*
                (mir-lir-array-index-proven-p source limit nil
                                              (gethash index *mir-lir-inherited-index-bounds*))))))

(defun mir-lir-previous-array-index (origin)
  (when *mir-lir-positive-indices*
    (let ((index (mir-lir-decremented-index origin)))
      (when (and index (gethash index *mir-lir-positive-indices*))
        index))))

(defun mir-lir-array-access-plan (instruction)
  (when *mir-lir-array-sources*
    (let* ((access (gethash (mir-instruction-result instruction) *mir-lir-array-sources*))
           (storage (and access (gethash (first access) *mir-lir-array-contents*))))
      (values access storage))))

(defun mir-lir-direct-array-index-p (source limit origin upper index-type)
  (or (mir-lir-array-index-proven-p source limit index-type nil)
      (mir-lir-array-index-checked-p origin source limit)
      (let ((input (mir-lir-positive-decrement origin)))
        (and input (member source (gethash input *mir-lir-length-arguments*))))
      (mir-lir-array-index-checked-p (mir-lir-previous-array-index origin) source limit)
      (mir-lir-array-index-checked-p upper source limit)
      (and upper *mir-lir-versioned-bound*
           (eql upper (car *mir-lir-versioned-bound*))
           (eql source (cdr *mir-lir-versioned-bound*)))))

(defun mir-lir-container-value (operation instruction args type doublep &optional singlep)
  (let* ((store (member operation '(:vector-write :string-write :array-write :specialized-array-write)))
         (name (mir-instruction-data instruction))
         (operands (mir-instruction-operands instruction))
         (index-type (and (> (length operands) 1)
                          (svref *mir-lir-types* (svref operands (if store 2 1)))))
         (object (if store (second args) (first args)))
         (index (if store (third args) (second args)))
         (value (when store
                  (if doublep (mir-lir-double-bits (svref operands 0)) (first args))))
         (rank-one (hir-simple-specialized-vector-p type)))
    (flet ((specialized-access ()
             (cond ((and store doublep)
                    (emit-slow-call 'kiln.kernel::%set-simple-specialized-aref-1
                                    (emit-box-double-bits value) object index (constant-object rank-one))
                    value)
                   (store
                    (emit-slow-call 'kiln.kernel::%set-simple-specialized-aref-1
                                    value object index (constant-object rank-one)))
                   (t (let ((value (emit-slow-call 'kiln.kernel::%simple-specialized-aref-1
                                                   object index (constant-object rank-one))))
                        (cond (doublep (copy-to-var `(:unbox-double ,value) :f64))
                              (singlep (copy-to-var `(:unpack-single ,value) :f32))
                              (t value)))))))
      (case operation
      (:length (copy-to-var (vector-length object)))
      (:specialized-array-length
       (let ((dimension (first (third type))))
         (if (integerp dimension)
             (constant-object dimension)
             (let* ((source (mir-lir-array-contents-source (svref operands 0)))
                    (storage (and *mir-lir-array-contents*
                                  (gethash source *mir-lir-array-contents*))))
               (or (cdr storage) (emit-slow-call 'length object))))))
      (:fixed-array-dimension
       (constant-object (hir-fixed-array-dimension type index-type)))
      ((:specialized-array-read :specialized-array-write)
       (multiple-value-bind (access storage) (mir-lir-array-access-plan instruction)
         (let* ((source (first access))
                (contents (car storage))
                (limit (and contents (third access)))
                (origin (and contents (second access)))
                (upper (mir-lir-reverse-index-upper-bound origin (mir-instruction-result instruction))))
           (cond ((mir-lir-direct-array-index-p source limit origin upper index-type)
                  (let ((result (new-var (cond (doublep :f64) (singlep :f32) (t :obj)))))
                    (mir-lir-vector-access contents index value doublep result singlep)
                    result))
                 (contents
                  (prog1 (mir-lir-emit-vector-access contents index value index-type
                                                    (lambda ()
                                                      (prog1 (specialized-access)
                                                        ;; A returning fallback may change the mode.
                                                        (when *mir-lir-float-mode-cache*
                                                          (emit `(:set ,*mir-lir-float-mode-cache*
                                                                       (:ne ,(mir-lir-float-control-state)
                                                                            ,(nil-value)))))))
                                                    (cdr storage) doublep singlep)
                    ;; The fallback signals on an invalid index or rank.
                    ;; The backing store of a simple array has fixed length.
                    (when origin
                      (unless *mir-lir-index-bounds*
                        (setf *mir-lir-index-bounds* (make-hash-table :test #'eql)))
                      (push (cons source limit) (gethash origin *mir-lir-index-bounds*)))))
                 (t (specialized-access))))))
      ((:vector-read :vector-write)
       (mir-lir-emit-vector-access
        object index value index-type
        (lambda () (if store (emit-slow-call name value object index)
                       (emit-slow-call name object index)))))
      ((:string-read :string-write) (emit-schar object index value name t))
      ((:array-read :array-write) (emit-aref-1 object index value))))))

(defun mir-lir-fixed-mask-operand (instruction)
  (when (and instruction (= (mir-instruction-kind instruction) 6)
             (eq (mir-instruction-data instruction) 'logand)
             (hir-policy-optimize-p (mir-instruction-policy instruction))
             (not (mir-instruction-notinline instruction)))
    (let ((operands (mir-instruction-operands instruction)))
      (when (= (length operands) 2)
        (dotimes (position 2)
          (let* ((type (svref *mir-lir-types* (svref operands position)))
                 (other (svref operands (- 1 position))))
            (when (and (hir-range-p type) (= (second type) (third type))
                       (<= 0 (second type) +hir-fixnum-max+)
                       (not (hir-fixnum-type-p (svref *mir-lir-types* other))))
              (return other))))))))

(defun mir-lir-masked-arithmetic-plan (function masks)
  ;; Count actual references, including returns, phi edges and debug
  ;; observations. A wrapped value cannot escape its masked expression.
  (when masks
    (let ((uses (make-array (length *mir-lir-definitions*) :initial-element 0))
          (instructions (mir-function-instructions function))
          (plan (make-hash-table :test #'eql)))
      (flet ((count-use (id) (incf (svref uses id))))
        (loop for block across (hir-buffer-view (mir-function-blocks function))
              for term = (mir-block-terminator block)
              do (loop for index across (hir-buffer-view (mir-block-instructions block))
                       do (map nil #'count-use (mir-instruction-operands (mir-at instructions index))))
                 (map nil #'count-use (mir-terminator-operands term))
                 (loop for edge across (mir-terminator-edges term)
                       do (map nil #'count-use (mir-edge-arguments edge)))))
      (labels ((collect-arithmetic (id budget planned)
                 (when (hir-fixnum-type-p (svref *mir-lir-types* id))
                   (return-from collect-arithmetic (values t planned budget)))
                 (unless (and (plusp budget) (= (svref uses id) 1))
                   (return-from collect-arithmetic nil))
                 (let* ((instruction (svref *mir-lir-definitions* id))
                        (kind (and instruction (mir-instruction-kind instruction))))
                   (cond
                     ((eql kind 10)
                      (collect-arithmetic (svref (mir-instruction-operands instruction) 0)
                                          (1- budget) planned))
                     ((and (eql kind 6)
                           (hir-policy-optimize-p (mir-instruction-policy instruction))
                           (not (mir-instruction-notinline instruction))
                           (case (mir-instruction-data instruction)
                             ((+ *) (= (length (mir-instruction-operands instruction)) 2))
                             (- (<= 1 (length (mir-instruction-operands instruction)) 2))
                             ((1+ 1-) (= (length (mir-instruction-operands instruction)) 1))))
                      (push id planned)
                      (decf budget)
                      (loop for operand across (mir-instruction-operands instruction)
                            do (multiple-value-bind (proved operations remaining)
                                   (collect-arithmetic operand budget planned)
                                 (unless proved (return-from collect-arithmetic nil))
                                 (setf planned operations budget remaining)))
                      (values t planned budget))))))
        (loop for (operand . mask) in masks
              do (multiple-value-bind (proved operations)
                     (collect-arithmetic operand 16 nil)
                   (when proved
                     (setf (gethash mask plan) :mask)
                     (dolist (operation operations)
                       (setf (gethash operation plan) :wrap))))))
      (when (plusp (hash-table-count plan)) plan))))

(defun mir-lir-fixnum-call-p (instruction)
  (let ((name (mir-instruction-data instruction))
        (operands (mir-instruction-operands instruction)))
    (and (= (mir-instruction-kind instruction) 6)
         (hir-policy-optimize-p (mir-instruction-policy instruction))
         (not (mir-instruction-notinline instruction))
         (or (and (= (length operands) 2)
                  (member name '(+ - * logand logior logxor < > <= >= = /=)))
             (and (eq name 'ash) (= (length operands) 2)
                  (hir-constant-right-shift (svref *mir-lir-types* (svref operands 1))))
             (and (> (length operands) 2) (eq name '+))
             (and (= (length operands) 1) (member name '(- 1+ 1- zerop plusp minusp))))
         (every (lambda (id) (hir-fixnum-type-p (svref *mir-lir-types* id))) operands))))

(defun mir-lir-fixnum-sum (args bounded)
  (if bounded
      ;; With a proof for the final sum, modular additions give its exact
      ;; fixnum representation even if a mathematical prefix exceeds it.
      (reduce (lambda (a b) (emit-fixnum-arithmetic '+ a b t)) args)
      (let ((sum (first args)) (overflow (new-var :raw)) (slow (new-block *mir-lir-in-loop*)))
        (dolist (operand (rest args))
          (let ((result (new-var)) (next (new-block)))
            (emit-fixnum-overflow-operation '+ result overflow sum operand)
            (br overflow slow next)
            (start-block next)
            (setf sum result)))
        (let ((done (new-block)))
          (jump done)
          (start-block slow)
          (kiln.kir::emit-lir-assignment sum (apply #'emit-slow-call '+ args))
          (jump done)
          (start-block done))
        sum)))

(defun mir-lir-branch-condition (term)
  (when (= (mir-terminator-kind term) 1)
    ;; NOT and NULL invert the branch without changing evaluation of the test.
    (loop with inverted = nil
          for operand = (svref (mir-terminator-operands term) 0)
            then (svref (mir-instruction-operands instruction) 0)
          for origin = (mir-primary-origin operand *mir-lir-definitions*)
          for instruction = (svref *mir-lir-definitions* origin)
          while (and instruction
                     (= (mir-instruction-kind instruction) 6)
                     (member (mir-instruction-data instruction) '(not null))
                     (= (length (mir-instruction-operands instruction)) 1)
                     (hir-policy-optimize-p (mir-instruction-policy instruction))
                     (not (mir-instruction-notinline instruction)))
          do (setf inverted (not inverted))
          finally (return (values origin inverted)))))

(defun mir-lir-condition-value (instruction test)
  (when (eql (mir-instruction-result instruction) *mir-lir-condition-source*)
    (setf test (copy-to-var test :raw)
          *mir-lir-condition-word* test))
  (boolean-value test))

(defun mir-lir-vector-index-increment-p (instruction)
  (let* ((name (mir-instruction-data instruction))
         (operands (mir-instruction-operands instruction))
         (index (cond ((eq name '1+) (svref operands 0))
                      ((and (eq name '+) (= (length operands) 2))
                       (cond ((mir-induction-integer-constant-p (svref operands 1) 1
                                                               *mir-lir-definitions*)
                              (svref operands 0))
                             ((mir-induction-integer-constant-p (svref operands 0) 1
                                                               *mir-lir-definitions*)
                              (svref operands 1)))))))
    ;; An in-bounds index incremented by one is at most the vector length,
    ;; which fits in a fixnum on the supported targets.
    (when index
      (let ((origin (mir-lir-array-index-origin index)))
        (or (and *mir-lir-index-bounds*
                 (gethash origin *mir-lir-index-bounds*))
            (and *mir-lir-inherited-index-bounds*
                 (gethash origin *mir-lir-inherited-index-bounds*)))))))

(defun mir-lir-fixnum-halved-input (id)
  (let ((definition (svref *mir-lir-definitions*
                           (mir-primary-origin id *mir-lir-definitions*))))
    (when (and definition
               (eq (mir-instruction-data definition) 'ash)
               (mir-lir-fixnum-call-p definition))
      (let ((operands (mir-instruction-operands definition)))
        (when (eql 1 (hir-constant-right-shift (svref *mir-lir-types* (svref operands 1))))
          (mir-lir-value (svref operands 0)))))))

(defun mir-lir-fixnum-call (instruction args declared-fixnum-result-p checked-result)
  (let* ((name (mir-instruction-data instruction)) (left (first args)) (right (second args))
         (bounded (or declared-fixnum-result-p
                      (and (eq name '-) (mir-lir-positive-decrement (mir-instruction-result instruction)))
                      (hir-fixnum-type-p (svref *mir-lir-types* (mir-instruction-result instruction)))
                      (mir-lir-vector-index-increment-p instruction)))
         (check-overflow-result
           (when (and checked-result (not bounded))
             (lambda (value)
               (let ((*call-source* (mir-instruction-source checked-result)))
                 (emit-slow-call 'kiln.kernel::%declared-type-error value (constant-object 'fixnum)))))))
    (cond ((and (eq name '+) (cddr args)) (mir-lir-fixnum-sum args bounded))
          ((member name '(+ - *))
           (if right
               (emit-fixnum-arithmetic name left right bounded check-overflow-result *mir-lir-in-loop*
                                       (third *mir-lir-accumulator-copy*))
               (emit-fixnum-arithmetic '- '(:fixnum-tag 0) left bounded check-overflow-result *mir-lir-in-loop*)))
          ((member name '(1+ 1-))
           (emit-fixnum-arithmetic (if (eq name '1+) '+ '-) left '(:fixnum-tag 1) bounded
                                   check-overflow-result *mir-lir-in-loop*
                                   (third *mir-lir-accumulator-copy*)))
          ((eq name 'ash)
           (let* ((count (svref (mir-instruction-operands instruction) 1))
                  (shift (hir-constant-right-shift (svref *mir-lir-types* count))))
             (if (zerop shift)
                 left
                 (copy-to-var `(:fixnum-shift-right ,left (:fixnum-tag ,shift))))))
          ((member name '(logand logior logxor))
           (copy-to-var `(,(ecase name (logand :and) (logior :or) (logxor :xor)) ,left ,right)))
          (t (let ((halved (case name
                             (<= (mir-lir-fixnum-halved-input (svref (mir-instruction-operands instruction) 1)))
                             (>= (mir-lir-fixnum-halved-input (svref (mir-instruction-operands instruction) 0))))))
               (mir-lir-condition-value
                instruction
                (if halved
                    (if (eql *mir-lir-reverse-swap-test* (mir-instruction-result instruction))
                        `(:word-lt (:word-shift-left (:fixnum-untag ,left) 1) (:fixnum-untag ,halved))
                        `(:fixnum-le-half ,(if (eq name '<=) left right) ,halved))
                    `(,(ecase name ((< minusp) :lt) ((> plusp) :gt) (<= :le) (>= :ge)
                                  ((= zerop) :eq) (/= :ne))
                      ,left ,(or right '(:fixnum-tag 0))))))))))

(defun mir-lir-bignum-side (type)
  (cond ((hir-nonnegative-integer-type-p type) :above)
        ((hir-range-p type)
         (cond ((<= +hir-fixnum-min+ (second type)) :above)
               ((<= (third type) +hir-fixnum-max+) :below)))))

(defun mir-lir-mixed-integer-comparison (instruction args)
  (let ((operands (mir-instruction-operands instruction)))
    (when (= (length operands) 2)
      (let* ((name (mir-instruction-data instruction))
             (left (svref *mir-lir-types* (svref operands 0)))
             (right (svref *mir-lir-types* (svref operands 1)))
             (left-fixnum (hir-fixnum-type-p left))
             (other (if left-fixnum right left)))
        (when (and (or left-fixnum (hir-fixnum-type-p right))
                   (hir-integer-type-p other)
                   (not (hir-fixnum-type-p other)))
          ;; Two equal fixnums have identical bits. A bignum cannot be
          ;; equal to a fixnum, and its order is known if only one side of
          ;; the fixnum range can contain it.
          (let ((test `(,(ecase name (< :lt) (<= :le) (> :gt) (>= :ge)
                                  (= :eq) (/= :ne)) ,@args)))
            (if (member name '(= /=))
                (mir-lir-condition-value instruction test)
                (let ((side (mir-lir-bignum-side other)))
                  (when side
                    (let* ((other-value (if left-fixnum (second args) (first args)))
                           (left-smaller (if left-fixnum (eq side :above) (eq side :below)))
                           (bignum-true (if (member name '(< <=)) left-smaller (not left-smaller)))
                           (fixnump `(:test-class ,kiln.kir::+packet-class-fixnum+ ,other-value)))
                      (mir-lir-condition-value
                       instruction (if bignum-true `(:or (:eq ,fixnump 0) ,test)
                                       `(:and ,fixnump ,test)))))))))))))

(defun mir-lir-parity-call (instruction argument)
  (let* ((name (mir-instruction-data instruction))
         (type (svref *mir-lir-types* (svref (mir-instruction-operands instruction) 0)))
         (even `(:fixnum-evenp ,argument))
         (test (if (eq name 'evenp) even `(:eq ,even 0))))
    (cond ((hir-fixnum-type-p type)
           (mir-lir-condition-value instruction test))
          ((or *mir-lir-in-loop*
               (> (hir-policy-quality *hir-policy* :speed)
                  (hir-policy-quality *hir-policy* :space)))
           (let ((result (new-var :raw))
                 (fast (new-block)) (slow (new-block t)) (done (new-block)))
             (br (emit-kind-test argument kiln.kir::+packet-class-fixnum+) fast slow)
             (start-block fast)
             (kiln.kir::emit-lir-assignment result test)
             (jump done)
             (start-block slow)
             (kiln.kir::emit-lir-assignment result
               `(:ne ,(emit-slow-call name argument) ,(nil-value)))
             (jump done)
             (start-block done)
             (mir-lir-condition-value instruction result))))))

(defun mir-lir-power-of-two-divisor (instruction)
  (let ((operands (mir-instruction-operands instruction)))
    (when (and (= (mir-instruction-kind instruction) 6)
               (= (length operands) 2)
               (member (mir-instruction-data instruction) '(floor truncate /))
               (hir-policy-optimize-p (mir-instruction-policy instruction))
               (not (mir-instruction-notinline instruction)))
      (hir-fixnum-power-of-two-divisor
       (svref *mir-lir-types* (svref operands 0))
       (svref *mir-lir-types* (svref operands 1))))))

(defun mir-lir-power-of-two-expt (instruction base exponent)
  (when (and (hir-policy-optimize-p (mir-instruction-policy instruction))
             (not (mir-instruction-notinline instruction)))
    (let* ((operands (mir-instruction-operands instruction))
           (value (hir-positive-fixnum-constant (svref *mir-lir-types* (svref operands 0)))))
      (when (and value (> value 1) (zerop (logand value (1- value))))
        (let* ((factor (1- (integer-length value)))
               (exponent-type (svref *mir-lir-types* (svref operands 1)))
               (range (hir-type-range exponent-type))
               (limit (1+ (floor (1- (integer-length kiln.kir::+backend-fixnum-max+)) factor)))
               (shift `(:fixnum-untag ,exponent))
               (scaled-shift (if (= factor 1) shift `(:word-mul ,shift ,factor)))
               (power `(:fixnum-tag (:word-shift-left 1 ,scaled-shift))))
          (when (and range (<= 0 (second range)) (< (third range) limit))
            (return-from mir-lir-power-of-two-expt (copy-to-var power)))
          (let ((result (new-var)) (fast (new-block)) (done (new-block))
                (slow (new-block *mir-lir-in-loop*)))
            (unless (hir-fixnum-type-p exponent-type)
              (let ((fixnum (new-block)))
                (br (emit-kind-test exponent kiln.kir::+packet-class-fixnum+) fixnum slow)
                (start-block fixnum)))
            ;; The unsigned comparison also sends negative exponents to EXPT.
            (br `(:fixnum-uge ,exponent (:fixnum-tag ,limit)) slow fast)
            (start-block fast)
            (emit `(:set ,result ,power))
            (jump done)
            (start-block slow)
            (kiln.kir::emit-lir-assignment result (emit-slow-call 'expt base exponent))
            (jump done)
            (start-block done)
            result))))))

(defun mir-lir-fixnum-mod (instruction dividend)
  (let ((operands (mir-instruction-operands instruction)))
    (when (and (= (length operands) 2)
               (hir-policy-optimize-p (mir-instruction-policy instruction))
               (not (mir-instruction-notinline instruction)))
      (let ((type (svref *mir-lir-types* (svref operands 0)))
            (divisor (hir-positive-fixnum-constant
                      (svref *mir-lir-types* (svref operands 1)))))
        (when (and divisor (hir-integer-type-p type))
          (let ((tagged-divisor (constant-object divisor)))
            (flet ((fixnum-mod ()
                     (if (zerop (logand divisor (1- divisor)))
                         (copy-to-var `(:fixnum-logand ,dividend ,(constant-object (1- divisor))))
                         (let ((remainder
                                 (copy-to-var `(:fixnum-remainder ,dividend ,tagged-divisor))))
                           (if (hir-nonnegative-integer-type-p type)
                               remainder
                               (copy-to-var
                                `(:select (:lt ,remainder ,(constant-object 0))
                                          (:fixnum-add ,remainder ,tagged-divisor) ,remainder)))))))
              (if (hir-fixnum-type-p type)
                  (fixnum-mod)
                  (let ((fast (new-block)) (slow (new-block)) (done (new-block)) (result (new-var)))
                    (br `(:test-class ,kiln.kir::+packet-class-fixnum+ ,dividend) fast slow)
                    (start-block fast)
                    (kiln.kir::emit-lir-assignment result (fixnum-mod))
                    (jump done)
                    (start-block slow)
                    (kiln.kir::emit-lir-assignment result (emit-slow-call 'mod dividend tagged-divisor))
                    (jump done)
                    (start-block done)
                    result)))))))))

(defun mir-lir-exact-power-of-two-division (dividend divisor)
  (if (= divisor 1)
      dividend
      (let ((raw (copy-to-var `(:fixnum-untag ,dividend) :raw))
            (result (new-var)) (exact (new-block)) (ratio (new-block)) (done (new-block)))
        (br `(:eq (:and ,raw ,(1- divisor)) 0) exact ratio)
        (start-block exact)
        (emit `(:set ,result (:fixnum-tag (:sar ,raw ,(1- (integer-length divisor))))))
        (jump done)
        (start-block ratio)
        (kiln.kir::emit-lir-assignment result
          (emit-numeric-op :number-div (list dividend (constant-object divisor))))
        (jump done)
        (start-block done)
        result)))

(defun mir-lir-odd-offset-from-p (value base)
  (let ((definition (svref *mir-lir-definitions*
                          (mir-primary-origin value *mir-lir-definitions*))))
    (when (and definition (= (mir-instruction-kind definition) 6)
               (hir-policy-optimize-p (mir-instruction-policy definition))
               (not (mir-instruction-notinline definition)))
      (let ((operands (mir-instruction-operands definition)))
        (flet ((base-p (index)
                 (= base (mir-primary-origin (svref operands index) *mir-lir-definitions*)))
               (odd-constant-p (index)
                 (let ((range (hir-type-range (svref *mir-lir-types* (svref operands index)))))
                   (and range (= (second range) (third range)) (oddp (second range))))))
          (case (mir-instruction-data definition)
            ((1+ 1-) (and (= (length operands) 1) (base-p 0)))
            (+ (and (= (length operands) 2)
                    (or (and (base-p 0) (odd-constant-p 1))
                        (and (base-p 1) (odd-constant-p 0)))))
            (- (and (= (length operands) 2) (base-p 0) (odd-constant-p 1)))))))))

(defun mir-lir-even-product-p (value)
  (let ((definition (svref *mir-lir-definitions*
                          (mir-primary-origin value *mir-lir-definitions*))))
    (when (and definition (= (mir-instruction-kind definition) 6)
               (eq (mir-instruction-data definition) '*)
               (hir-policy-optimize-p (mir-instruction-policy definition))
               (not (mir-instruction-notinline definition)))
      (let ((operands (mir-instruction-operands definition)))
        (when (= (length operands) 2)
          (let ((left (svref operands 0)) (right (svref operands 1)))
            (and (hir-integer-type-p (svref *mir-lir-types* left))
                 (hir-integer-type-p (svref *mir-lir-types* right))
                 (or (mir-lir-odd-offset-from-p left (mir-primary-origin right *mir-lir-definitions*))
                     (mir-lir-odd-offset-from-p right (mir-primary-origin left *mir-lir-definitions*))))))))))

(defun mir-lir-power-of-two-division (instruction dividend divisor)
  (let* ((result (mir-instruction-result instruction))
         (dividend-id (svref (mir-instruction-operands instruction) 0))
         (remainder-needed (svref *mir-lir-bundle-demand* result)))
    (when (and (= divisor 2) (mir-lir-even-product-p dividend-id))
      (let ((primary (copy-to-var `(:fixnum-half-exact ,dividend))))
        (when remainder-needed
          (emit `(:publish-values (,primary ,(constant-object 0)))))
        (mir-lir-save result primary 2)
        (return-from mir-lir-power-of-two-division)))
    (let* ((shift (1- (integer-length divisor)))
           (mask (1- divisor))
           (raw (copy-to-var `(:fixnum-untag ,dividend) :raw))
           (type (svref *mir-lir-types* dividend-id))
           (bias-needed (and (plusp mask) (eq (mir-instruction-data instruction) 'truncate)
                             (not (hir-nonnegative-integer-type-p type))))
           ;; A signed shift rounds down. Only a negative, inexact result
           ;; needs a bias to truncate towards zero.
           (input (if bias-needed
                      (copy-to-var `(:add ,raw (:and (:sar ,raw 63) ,mask)) :raw)
                      raw))
           (quotient (copy-to-var `(:sar ,input ,shift) :raw))
           (primary (copy-to-var `(:fixnum-tag ,quotient))))
      (when remainder-needed
        (let ((remainder (copy-to-var `(:fixnum-tag (:sub ,raw (:shl ,quotient ,shift))))))
          (emit `(:publish-values (,primary ,remainder)))))
      (mir-lir-save result primary 2))))

(defun mir-lir-double-call-p (instruction)
  "Select numeric operations only with a MIR double-float proof for every operand."
  (let ((name (mir-instruction-data instruction))
        (operands (mir-instruction-operands instruction)))
    (and (= (mir-instruction-kind instruction) 6)
         (hir-policy-optimize-p (mir-instruction-policy instruction))
         (not (mir-instruction-notinline instruction))
         (or (and (>= (length operands) 2) (member name '(+ - * /)))
             (and (= (length operands) 2) (member name '(< > <= >= = /=)))
             (and (= (length operands) 1) (member name '(- / abs 1+ 1- zerop plusp minusp))))
         (every (lambda (id) (eq (svref *mir-lir-types* id) 'double-float)) operands))))

(defun mir-lir-double-conversion-p (instruction)
  (let ((operands (mir-instruction-operands instruction)))
    (and (= (mir-instruction-kind instruction) 6)
         (eq 'float (mir-instruction-data instruction))
         (hir-policy-optimize-p (mir-instruction-policy instruction))
         (not (mir-instruction-notinline instruction))
         (= (length operands) 2)
         (eq 'double-float (svref *mir-lir-types* (svref operands 1)))
         (let ((type (svref *mir-lir-types* (svref operands 0))))
           (or (eq type t) (hir-integer-type-p type))))))

(defun mir-lir-single-call-p (instruction)
  (let ((operands (mir-instruction-operands instruction)))
    (and (= (mir-instruction-kind instruction) 6)
         (hir-policy-optimize-p (mir-instruction-policy instruction))
         (not (mir-instruction-notinline instruction))
         (member (mir-instruction-data instruction) '(+ - * /))
         (= (length operands) 2)
         (every (lambda (id) (eq (svref *mir-lir-types* id) 'single-float)) operands))))

(defun mir-lir-single-forward-source (instruction)
  (when (or (member (mir-instruction-kind instruction) '(9 10))
            (and (= (mir-instruction-kind instruction) 11)
                 (mir-check-proven-p instruction *mir-lir-types*)))
    (svref (mir-instruction-operands instruction) 0)))

(defun mir-lir-single-origin (id)
  (loop for definition = (svref *mir-lir-definitions* id)
        for source = (and definition (mir-lir-single-forward-source definition))
        while source do (setf id source)
        finally (return id)))

(defun mir-lir-single-array-read-p (instruction)
  (multiple-value-bind (operation type) (mir-lir-container-call instruction)
    (and (eq operation :specialized-array-read) (eq (second type) 'single-float))))

(defun mir-lir-plan-single-scalars (function)
  (when (and (find 'single-float *mir-lir-types*)
             (< (hir-policy-quality (mir-function-policy function) :debug) 2))
    (let* ((instructions (hir-buffer-view (mir-function-instructions function)))
           (scalars (make-hash-table :test #'eql)))
      (loop for instruction across instructions
            when (and (or (mir-lir-single-call-p instruction)
                          (mir-lir-single-array-read-p instruction))
                      (< (hir-policy-quality (mir-instruction-policy instruction) :debug) 2))
              do (setf (gethash (mir-instruction-result instruction) scalars) t))
      (when (plusp (hash-table-count scalars))
        (flet ((require-object (id) (remhash (mir-lir-single-origin id) scalars)))
          (loop for instruction across instructions
                unless (or (mir-lir-single-call-p instruction)
                           (mir-lir-single-forward-source instruction))
                  do (map nil #'require-object (mir-instruction-operands instruction)))
          (loop for block across (hir-buffer-view (mir-function-blocks function))
                for terminator = (mir-block-terminator block)
                do (map nil #'require-object (mir-terminator-operands terminator))
                   (loop for edge across (mir-terminator-edges terminator)
                         do (map nil #'require-object (mir-edge-arguments edge)))))
        ;; Allocate in SSA order so host and native packets agree.
        (dotimes (id (length *mir-lir-types*))
          (when (gethash id scalars) (setf (gethash id scalars) (new-var :f32))))
        (when (plusp (hash-table-count scalars)) scalars)))))

(defun mir-lir-single-scalar (id)
  (when *mir-lir-single-scalars*
    (gethash (mir-lir-single-origin id) *mir-lir-single-scalars*)))

(defun mir-lir-double-forward-source (instruction)
  (let ((operands (mir-instruction-operands instruction)))
    (when (and (plusp (length operands))
               (or (member (mir-instruction-kind instruction) '(9 10 39))
                   (and (= (mir-instruction-kind instruction) 14) (zerop (mir-instruction-data instruction)))
                   (and (= (mir-instruction-kind instruction) 11)
                        (mir-check-proven-p instruction *mir-lir-types*))))
      (svref operands 0))))

(defun mir-lir-predecessor-index (function)
  (let* ((blocks (hir-buffer-view (mir-function-blocks function)))
         (incoming (make-array (length blocks) :initial-element nil))
         (indices (make-array (hir-buffer-count (mir-function-values function)) :initial-element nil)))
    (loop for block across blocks
          do (loop for parameter across (mir-block-parameters block) for index from 0
                   do (setf (svref indices parameter) index))
             (loop for edge across (mir-terminator-edges (mir-block-terminator block))
                   when (plusp (length (mir-edge-arguments edge)))
                     do (push edge (svref incoming (mir-edge-target edge)))))
    (cons incoming indices)))

(defun mir-lir-live-values (function predecessors)
  "Drop unused copy chains and block arguments before choosing representations."
  (let* ((values (hir-buffer-view (mir-function-values function)))
         (live (make-array (length values) :initial-element nil))
         (instructions (hir-buffer-view (mir-function-instructions function)))
         (blocks (hir-buffer-view (mir-function-blocks function)))
         (incoming (car predecessors))
         (parameter-index (cdr predecessors))
         (work (make-hir-buffer))
         (masks nil))
    (labels ((mark (id)
               (unless (svref live id)
                 (setf (svref live id) t)
                 (hir-push id work))))
      (loop for instruction across instructions
            unless (mir-lir-double-forward-source instruction)
              do (map nil #'mark (mir-instruction-operands instruction))
            when (eq (mir-instruction-data instruction) 'logand)
              do (let ((operand (mir-lir-fixed-mask-operand instruction)))
                   (when operand (push (cons operand (mir-instruction-result instruction)) masks))))
      (loop for block across blocks
            do (map nil #'mark (mir-terminator-operands (mir-block-terminator block))))
      (loop for cursor from 0 while (< cursor (hir-buffer-count work))
            for id = (svref (hir-buffer-data work) cursor)
            for index = (svref parameter-index id)
            do (if index
                   (dolist (edge (svref incoming (mir-value-block (svref values id))))
                     (mark (svref (mir-edge-arguments edge) index)))
                   (let* ((definition (svref *mir-lir-definitions* id))
                          (source (and definition (mir-lir-double-forward-source definition))))
                     (when source (mark source))))))
    (values live masks)))

(defun mir-lir-double-plan (function predecessors)
  "Keep raw SSA doubles and request boxed companions only at object uses."
  (let* ((values (hir-buffer-view (mir-function-values function)))
         (doubles (make-array (length values) :initial-element nil))
         (boxed (make-array (length values) :initial-element nil))
         (instructions (hir-buffer-view (mir-function-instructions function)))
         (blocks (hir-buffer-view (mir-function-blocks function)))
         (high-debug (or (>= (hir-policy-quality (mir-function-policy function) :debug) 2)
                         (some (lambda (instruction)
                                 (>= (hir-policy-quality (mir-instruction-policy instruction) :debug) 2))
                               instructions)))
         (observed (and high-debug (make-array (length values) :initial-element nil))))
    (when observed
      (loop for instruction across instructions when (= 40 (mir-instruction-kind instruction))
            do (setf (svref observed (mir-primary-origin (svref (mir-instruction-operands instruction) 0)
                                                       *mir-lir-definitions*)) t)))
    (when (every (lambda (instruction)
                   (hir-policy-optimize-p (mir-instruction-policy instruction))) instructions)
      (loop for value across values for id = (mir-value-id value)
            when (and (svref *mir-lir-live* id) (eq (svref *mir-lir-types* id) 'double-float)
                      (or (eq (mir-value-representation value) :obj)
                          (and (eq (mir-value-representation value) :bundle) (mir-lir-single-p id)))
                      ;; Preserve object liveness for source observations.
                      ;; At high debug, only unobserved arithmetic chains use
                      ;; raw locals; arguments and merge parameters stay boxed.
                      (or (not high-debug)
                          (let* ((origin (mir-primary-origin id *mir-lir-definitions*))
                                 (definition (svref *mir-lir-definitions* origin)))
                            (and (not (svref observed origin)) definition
                                 (or (mir-lir-double-call-p definition)
                                     (mir-lir-double-conversion-p definition))))))
              do (setf (svref doubles id) (new-var :f64))))
    (unless (some #'identity doubles) (return-from mir-lir-double-plan (values doubles boxed)))
    (let ((work (make-hir-buffer))
          (cyclic (unless high-debug (mir-cyclic-blocks function)))
          (incoming (car predecessors)) (parameter-index (cdr predecessors)))
      (labels ((require-object (id &optional (demand t))
                 (when (and (svref doubles id)
                            (or (not (svref boxed id))
                                (and (eq (svref boxed id) :deferred) (eq demand t))))
                   (setf (svref boxed id) demand)
                   (hir-push id work)))
               (forward-p (instruction)
                 (let ((source (mir-lir-double-forward-source instruction))
                       (result (mir-instruction-result instruction)))
                   (and source result (svref doubles source) (svref doubles result) source))))
        (loop for instruction across instructions
              unless (or (= 37 (mir-instruction-kind instruction))
                         (mir-lir-double-call-p instruction)
                         (mir-lir-double-conversion-p instruction) (forward-p instruction)
                         (and (mir-lir-double-forward-source instruction)
                              (not (svref *mir-lir-live* (mir-instruction-result instruction)))))
                do (let ((operands (mir-instruction-operands instruction)))
                     (multiple-value-bind (operation type) (mir-lir-container-call instruction)
                       (loop for id across operands for index from 0
                             unless (and (zerop index) (eq operation :specialized-array-write)
                                         (not (svref *mir-lir-live* (mir-instruction-result instruction)))
                                         (mir-lir-double-array-access-p operation type))
                               do (require-object id)))))
        (loop for block across blocks
              do (let ((term (mir-block-terminator block)))
                   (loop for id across (mir-terminator-operands term)
                         for origin = (and cyclic (= (mir-terminator-kind term) 2)
                                           (svref doubles id)
                                           (mir-primary-origin id *mir-lir-definitions*))
                         do (require-object
                             id (if (and origin (svref parameter-index origin)
                                         (logbitp (mir-value-block (svref values origin)) cyclic))
                                    :deferred t))))
                 (loop for id across (mir-block-parameters block)
                       when (and (svref *mir-lir-live* id) (not (svref doubles id)))
                         do (hir-push id work)))
        (loop for cursor from 0 while (< cursor (hir-buffer-count work))
              for id = (svref (hir-buffer-data work) cursor)
              for index = (svref parameter-index id)
              for demand = (or (svref boxed id) t)
              when (svref *mir-lir-live* id)
                do (if index
                       (dolist (edge (svref incoming (mir-value-block (svref values id))))
                         (require-object (svref (mir-edge-arguments edge) index) demand))
                       (let* ((definition (svref *mir-lir-definitions* id))
                              (source (and definition (forward-p definition))))
                         (when source (require-object source demand)))))))
    (values doubles boxed)))

(defun mir-lir-double-bits (id)
  (or (svref *mir-lir-doubles* id)
      (let ((value (mir-lir-value id)))
        (copy-to-var `(:field-load ,kiln.kir::+packet-field-double-bits+ ,(if (consp value) (car value) value)) :f64))))

(defun mir-lir-return-values (id)
  (multiple-value-bind (primary count) (mir-lir-restore id)
    (when (eq (svref *mir-lir-boxed* id) :deferred)
      (let ((materialize (new-block)) (done (new-block)) (value (copy-to-var primary)))
        (br `(:eq ,value ,(nil-value)) materialize done)
        (start-block materialize)
        (kiln.kir::emit-lir-assignment value (emit-box-double-bits (mir-lir-double-bits id)))
        (jump done)
        (start-block done)
        (setf primary value)))
    (values primary count)))

(defun mir-lir-float-control-state ()
  (emit-symbol-value (constant-object 'kiln.kernel::*float-control-active*)))

(defun mir-lir-nonfinite-test (precision result)
  ;; An all-ones exponent needs runtime handling even in the default mode.
  (ecase precision
    (:double `(:f64-nonfinite ,result))
    (:single
     `(:word-eq (:word-and (:single-float-bits ,result) #x7f800000) #x7f800000))))

(defun mir-lir-float-fallback (precision name left right result reciprocal)
  (ecase precision
    (:double
     (let ((value (if reciprocal
                      (emit-slow-call '/ (emit-box-double-bits right))
                      (let* ((a (emit-box-double-bits left))
                             (b (emit-box-double-bits right)))
                        (emit-slow-call 'kiln.kernel::controlled-real-arithmetic
                                        (constant-object name) a b)))))
       (emit `(:set ,result (:field-load ,kiln.kir::+packet-field-double-bits+ ,value)))))
    (:single
     (kiln.kir::emit-lir-assignment result
       (emit-slow-call 'kiln.kernel::controlled-real-arithmetic (constant-object name) left right)))))

(defun mir-lir-float-mode-cache ()
  (when *mir-lir-in-loop*
    (or *mir-lir-float-mode-cache*
        (setf *mir-lir-float-mode-cache*
              (copy-to-var `(:ne ,(mir-lir-float-control-state) ,(nil-value)) :raw)))))

(defun mir-lir-unpack-single-once (id object)
  (unless *mir-lir-single-unpacked*
    (setf *mir-lir-single-unpacked* (make-hash-table :test #'eql)))
  (let ((origin (mir-lir-single-origin id)))
    (or (gethash origin *mir-lir-single-unpacked*)
        (setf (gethash origin *mir-lir-single-unpacked*)
              (copy-to-var `(:unpack-single ,object) :f32)))))

(defun mir-lir-single-scalar-call (name left right left-raw right-raw result-raw operands)
  (let* ((a-raw (or left-raw (mir-lir-unpack-single-once (svref operands 0) left)))
         (b-raw (or right-raw (mir-lir-unpack-single-once (svref operands 1) right)))
         (mode (mir-lir-float-mode-cache))
         (fast (new-block)) (done (new-block))
         (slow (new-block *mir-lir-in-loop*))
         (raw (or result-raw (new-var :f32)))
         (result (unless result-raw (new-var)))
         (operation (ecase name (+ :f32-add) (- :f32-sub) (* :f32-mul) (/ :f32-div))))
    (br (or mode `(:ne ,(mir-lir-float-control-state) ,(nil-value))) slow fast)
    (start-block fast)
    (emit `(:set ,raw (,operation ,a-raw ,b-raw)))
    (if result
        (progn
          (emit `(:set ,result (:pack-single ,raw)))
          (br (mir-lir-nonfinite-test :single result) slow done))
        (br `(:word-eq (:word-and (:f32-bits ,raw) #x7f800000) #x7f800000) slow done))
    (start-block slow)
    (let* ((a (if left-raw (copy-to-var `(:pack-single ,left-raw)) left))
           (b (if right-raw (copy-to-var `(:pack-single ,right-raw)) right))
           (fallback (emit-slow-call 'kiln.kernel::controlled-real-arithmetic
                                     (constant-object name) a b)))
      (if result
          (kiln.kir::emit-lir-assignment result fallback)
          (emit `(:set ,raw (:unpack-single ,fallback)))))
    (when mode
      (emit `(:set ,mode (:ne ,(mir-lir-float-control-state) ,(nil-value)))))
    (jump done)
    (start-block done)
    result))

(defun mir-lir-float-chain (precision name left rights &key reciprocal finite-result zero-divisor)
  (let* ((double (eq precision :double))
         (operation (ecase name
                      (+ (if double :f64-add :single-add))
                      (- (if double :f64-sub :single-sub))
                      (* (if double :f64-mul :single-mul))
                      (/ (if double :f64-div :single-div))))
         (fast (new-block))
         (slow (new-block *mir-lir-in-loop*))
         (mode-cache (mir-lir-float-mode-cache)))
    (let ((controlled (or mode-cache `(:ne ,(mir-lir-float-control-state) ,(nil-value)))))
      (br (if zero-divisor `(:or ,controlled ,zero-divisor) controlled) slow fast))
    (loop for (right . remaining) on rights
          for result = (new-var (if double :f64 :obj))
          for next-fast = (new-block)
          for next-slow = (and remaining (new-block *mir-lir-in-loop*))
          do (start-block fast)
             (kiln.kir::emit-lir-assignment result (list operation left right))
             (if finite-result
                 (jump next-fast)
                 (br (mir-lir-nonfinite-test precision result) slow next-fast))
             (start-block slow)
             (mir-lir-float-fallback precision name left right result reciprocal)
             ;; A resumed slow call may have changed the dynamic setting.
             (let ((active (and (or mode-cache next-slow)
                                `(:ne ,(mir-lir-float-control-state) ,(nil-value)))))
               (when mode-cache (emit `(:set ,mode-cache ,active)))
               (if next-slow
                   (br (or mode-cache active) next-slow next-fast)
                   (jump next-fast)))
             (setf left result fast next-fast slow next-slow))
    (start-block fast)
    left))

(defun mir-lir-convert-double-bits (value type cache-mode-p)
  (let ((range (hir-type-range type)))
    (if (and range (<= (- (ash 1 53)) (second range) (third range) (ash 1 53)))
        (copy-to-var `(:f64-from-signed (:fixnum-untag ,value)) :f64)
        (let* ((fixnum (hir-fixnum-type-p type))
               (mode (or *mir-lir-float-mode-cache*
                         (and cache-mode-p (mir-lir-float-mode-cache))))
               (result (new-var :f64)) (fast (new-block)) (slow (new-block *mir-lir-in-loop*)) (done (new-block))
               (rounding (new-block *mir-lir-in-loop*))
               (sign-bit (- (ash 1 63))))
          (unless fixnum
            (let ((integer (new-block)))
              (br `(:test-class ,kiln.kir::+packet-class-fixnum+ ,value) integer slow)
              (start-block integer)))
          ;; An exact integer conversion produces the same result in every
          ;; rounding mode, even when the integer interval is only known at runtime.
          ;; Translate the interval to start at the minimum signed word.
          ;; Word addition wraps, leaving all other inputs above its end.
          (let ((integer (copy-to-var `(:fixnum-untag ,value) :raw)))
            (let ((exact `(:word-le (:word-add ,integer ,(+ sign-bit (ash 1 53)))
                                    ,(+ sign-bit (ash 1 54)))))
              (if mode
                  (progn
                    (br mode rounding fast)
                    (start-block rounding)
                    (br exact fast slow))
                  (progn
                    (br exact fast rounding)
                    (start-block rounding)
                    (br `(:ne ,(mir-lir-float-control-state) ,(nil-value)) slow fast))))
            (start-block fast)
            (kiln.kir::emit-lir-assignment result `(:f64-from-signed ,integer)))
          (jump done)
          (start-block slow)
          (mir-lir-load-field result kiln.kir::+packet-field-double-bits+
            (if fixnum
                (emit-slow-call 'kiln.kernel::controlled-float-conversion value (constant-object t))
                (emit-slow-call 'float value (constant-object 0d0))))
          (when mode
            (emit `(:set ,mode (:ne ,(mir-lir-float-control-state) ,(nil-value)))))
          (jump done)
          (start-block done)
          result))))

(defun mir-lir-double-fixnum-input-type (value)
  (let ((definition (svref *mir-lir-definitions*
                           (mir-primary-origin value *mir-lir-definitions*))))
    (when (and definition (mir-lir-double-conversion-p definition))
      (let ((type (svref *mir-lir-types* (svref (mir-instruction-operands definition) 0))))
        (when (hir-fixnum-type-p type) type)))))

(defun mir-lir-nonzero-fixnum-conversion-p (value)
  (let ((type (mir-lir-double-fixnum-input-type value)))
    (and (hir-range-p type)
         (or (plusp (second type)) (minusp (third type))))))

(defun mir-lir-convert-and-reciprocate (value type reciprocal)
  ;; The intervening primary projection cannot observe the rounding mode.
  ;; Keep the usual conversions on the software path, including re-reading
  ;; the mode if the conversion calls Lisp.
  (let* ((mode (mir-lir-float-mode-cache))
         (fast (new-block)) (slow (new-block t)) (done (new-block))
         (converted (new-var :f64)) (result (new-var :f64))
         (one #x3ff0000000000000))
    (br mode slow fast)
    (start-block fast)
    (emit `(:set ,converted (:f64-from-signed (:fixnum-untag ,value))))
    (emit `(:set ,result (:f64-div ,one ,converted)))
    (emit `(:set ,mode 0))
    (jump done)
    (start-block slow)
    (let ((bits (mir-lir-convert-double-bits value type t)))
      (emit `(:set ,converted ,bits))
      (emit `(:set ,result ,(mir-lir-float-chain :double '/ one (list bits)
                                               :reciprocal t :finite-result t))))
    (jump done)
    (start-block done)
    (setf *mir-lir-fused-reciprocal* (cons reciprocal result))
    converted))

(defun mir-lir-double-call (name operands)
  (let* ((bits (map 'list #'mir-lir-double-bits operands))
         (left (first bits)))
    (if (rest bits)
        (mir-lir-float-chain :double name left (rest bits)
                             ;; Two converted fixnums have magnitude at most
                             ;; 2^62. These operations stay finite in binary64.
                             :finite-result
                             (and (= (length operands) 2)
                                  (member name '(+ - *))
                                  (every #'mir-lir-double-fixnum-input-type operands)))
        (case name
          (- (copy-to-var `(:xor ,left ,(- #x8000000000000000)) :f64))
          (abs (copy-to-var `(:and ,left #x7fffffffffffffff) :f64))
          (/ (let* ((operand (svref operands 0))
                    (fixnum (mir-lir-double-fixnum-input-type operand)))
               ;; Converting a fixnum preserves zero and cannot produce NaN.
               ;; Check the divisor before the divide so the fast path does
               ;; not have to inspect the floating-point result.
               (mir-lir-float-chain
                :double '/ #x3ff0000000000000 (list left) :reciprocal t
                :finite-result fixnum
                :zero-divisor (and fixnum (not (mir-lir-nonzero-fixnum-conversion-p operand))
                                   `(:word-eq (:f64-bits ,left) 0)))))
          (1+ (mir-lir-float-chain :double '+ left '(#x3ff0000000000000)))
          (1- (mir-lir-float-chain :double '- left '(#x3ff0000000000000)))))))

(defun mir-lir-dead-pure-value-p (id)
  (let ((definition (svref *mir-lir-definitions* id)))
    (and (not (svref *mir-lir-live* id)) definition
         (member (mir-instruction-kind definition) '(0 1 12 16 37)))))

(defun mir-lir-load-field (target field object)
  (let ((source (list :field-load field object)))
    (if (and (kiln.kir::kvar-p object) (eq (svref object 2) :obj))
        (emit (list :lir-set target
                    (if (eql field kiln.kir::+packet-field-double-bits+)
                        (list :unbox-double object)
                        (list :field-ref (kiln.kir::lir-field-name field) object))
                    source))
        (emit (list :set target source)))))

(defun mir-lir-list-access (name receiver object)
  (let ((field (if (member name '(car first)) kiln.kir::+packet-field-cons-car+
                   kiln.kir::+packet-field-cons-cdr+))
        (type (svref *mir-lir-types* receiver)))
    (case type
      (cons (let ((result (new-var)))
              (mir-lir-load-field result field object)
              result))
      (null (nil-value))
      (otherwise
       (let* ((origin (mir-primary-origin receiver *mir-lir-definitions*))
              (tests (or *mir-lir-list-tests*
                         (setf *mir-lir-list-tests* (make-hash-table :test #'eql))))
              (prior (gethash origin tests))
              (test (or prior (copy-to-var
                               `(:test-class ,kiln.kir::+packet-class-cons+ ,object) :raw))))
         ;; Every returning path establishes CONS or NIL for this SSA value.
         ;; The proof stays inside the MIR block, including its emitted branches.
         (prog1 (emit-car-cdr object field test (or prior (eq type 'list)))
           (unless prior (setf (gethash origin tests) test))))))))

(defun mir-lir-constant-assignment (target word)
  (case (first word)
    ((:fixnum :character :single-float :literal) (emit (list :lir-set target word)))
    (:object-data
     (let* ((label (second word))
            (index (kiln.kir::module-data-index (kiln.kir::kmodule-defined *module*) label))
            (value (cond ((and (integerp index) (>= index 0)) (list :constant index))
                         ((equal label "kiln_nil") '(:nil))
                         ((equal label "kiln_t") '(:t)))))
       (if value
           (emit (list :lir-set target value (word-operand word)))
           (emit (list :set target (word-operand word))))))
    (otherwise (emit (list :set target (word-operand word))))))

(defun mir-lir-known-call-args (target instruction args)
  (let* ((positions (and *mir-lir-packed-array-plans*
                         (svref *mir-lir-packed-array-plans* target)))
         (ordinary (rest args)))
    (if positions
        (let* ((width (mir-function-internal-prefix (svref *mir-lir-functions* target)))
               (tail (nthcdr width ordinary)))
          (if (eql target *mir-lir-emitting-function*)
              (cons *mir-lir-packed-environment* tail)
              (let* ((operands (mir-instruction-operands instruction))
                     (backings
                       (loop for position in positions
                             for id = (svref operands (1+ position))
                             for source = (mir-lir-array-contents-source id)
                             for storage = (and *mir-lir-array-contents*
                                                (gethash source *mir-lir-array-contents*))
                             collect (or (car storage)
                                         (mir-lir-known-vector-backing (nth position ordinary)))))
                     (environment (emit-vector-object kiln.kir::+packet-class-simple-vector+
                                                      (+ width (length positions)) (nil-value))))
                (loop for value in ordinary for index from 0 below width
                      do (emit `(:vector-set-fixnum ,environment (:fixnum-tag ,index) ,value)))
                (loop for value in backings for index from width
                      do (emit `(:vector-set-fixnum ,environment (:fixnum-tag ,index) ,value)))
                (cons environment tail))))
        ordinary)))

(defun mir-lir-guard-ranked-array-layout (array slow check-element-type)
  (flet ((guard (test)
           (let ((next (new-block)))
             (br test next slow)
             (start-block next)))
         (slot (layout index)
           (copy-to-var `(:vector-ref-fixnum ,layout ,(constant-object index))))
         (field (object field)
           (let ((result (new-var)))
             (mir-lir-load-field result field object)
             result)))
    (guard (emit-kind-test array kiln.kir::+packet-class-instance+))
    (let ((layouts (copy-to-var
                    (emit-symbol-value (constant-object 'kiln.kernel::*specialized-array-storage-slots*))))
          (stamp (copy-to-var `(:instance-stamp ,array))))
      (guard (emit-kind-test layouts kiln.kir::+packet-class-simple-vector+))
      (guard `(:eq (:fixnum-uge ,stamp ,(vector-length layouts)) 0))
      (let ((layout (copy-to-var `(:vector-ref-fixnum ,layouts ,stamp))))
        (guard `(:ne ,layout ,(nil-value)))
        (let ((target (slot layout 2)) (type (slot layout 3)))
          (guard `(:eq (:instance-slot ,array (:fixnum-untag ,target)) ,(nil-value)))
          (guard `(:ne ,type ,(nil-value)))
          (guard `(:ne ,type ,(constant-object 'bit)))
          (when check-element-type
            (funcall check-element-type type layout #'guard)))
        (let* ((contents (slot layout 0)) (dimension-slot (slot layout 1))
               (storage (copy-to-var `(:instance-slot ,array (:fixnum-untag ,contents))))
               (dimensions (copy-to-var `(:instance-slot ,array (:fixnum-untag ,dimension-slot)))))
          (guard (emit-kind-test storage kiln.kir::+packet-class-simple-vector+))
          (guard (emit-kind-test dimensions kiln.kir::+packet-class-cons+))
          (let ((tail (field dimensions kiln.kir::+packet-field-cons-cdr+)))
            (guard (emit-kind-test tail kiln.kir::+packet-class-cons+))
            (guard `(:eq ,(field tail kiln.kir::+packet-field-cons-cdr+) ,(nil-value)))
            (let ((rows (field dimensions kiln.kir::+packet-field-cons-car+))
                  (columns (field tail kiln.kir::+packet-field-cons-car+)))
              (values storage rows columns))))))))

(defun mir-lir-emit-two-index-access (array i j value i-type j-type slow-function)
  (let ((slow (new-block t)) (done (new-block)) (result (new-var)))
    (flet ((guard (test)
             (let ((next (new-block)))
               (br test next slow)
               (start-block next))))
      (unless (hir-fixnum-type-p i-type)
        (guard (emit-kind-test i kiln.kir::+packet-class-fixnum+)))
      (unless (hir-fixnum-type-p j-type)
        (guard (emit-kind-test j kiln.kir::+packet-class-fixnum+)))
      (multiple-value-bind (storage rows columns)
          (mir-lir-guard-ranked-array-layout
           array slow
           (when value
             (lambda (type layout guard)
               (let ((general (new-block)) (specialized (new-block)))
                 (br `(:eq ,type ,(constant-object t)) general specialized)
                 (start-block specialized)
                 (let ((limit (copy-to-var `(:vector-ref-fixnum ,layout ,(constant-object 4)))))
                   (funcall guard (emit-kind-test limit kiln.kir::+packet-class-fixnum+))
                   (funcall guard (emit-kind-test value kiln.kir::+packet-class-fixnum+))
                   (funcall guard `(:eq (:fixnum-uge ,limit ,value) 1)))
                 (jump general)
                 (start-block general)))))
        (guard `(:eq (:fixnum-uge ,i ,rows) 0))
        (guard `(:eq (:fixnum-uge ,j ,columns) 0))
        ;; Checked subscripts establish that the row-major index
        ;; fits within the registered, non-displaced backing vector.
        (let* ((row (copy-to-var `(:fixnum-mul ,i ,columns)))
               (index (copy-to-var `(:fixnum-add ,row ,j))))
          (mir-lir-vector-access storage index value nil result))))
    (jump done)
    (start-block slow)
    (kiln.kir::emit-lir-assignment result (funcall slow-function))
    (jump done)
    (start-block done)
    result))

(defun mir-lir-cell-operand (instruction fallback)
  ;; The environment slot holds the same cell throughout recursion. Load it
  ;; at the read or write so the cell itself need not stay live across loops.
  (if *mir-lir-packed-environment*
      (let* ((id (svref (mir-instruction-operands instruction) 0))
             (definition (svref *mir-lir-definitions* (mir-primary-origin id *mir-lir-definitions*))))
        (if (and definition (= (mir-instruction-kind definition) 1)
                 (< (mir-instruction-data definition) *mir-lir-packed-width*))
            `(:vector-ref-fixnum ,*mir-lir-packed-environment*
                                (:fixnum-tag ,(mir-instruction-data definition)))
            fallback))
      fallback))

(defun mir-lir-instruction (instruction arguments argument-count
                            &optional fixnum-result-check known-fixnum-input cache-conversion-mode-p reciprocal)
  (let* ((*call-source* (mir-instruction-source instruction)) (*hir-policy* (mir-instruction-policy instruction))
         (kind (mir-instruction-kind instruction)) (result (mir-instruction-result instruction))
         (out (and result (mir-lir-value result))) (data (mir-instruction-data instruction))
         (args (map 'list #'mir-lir-value (mir-instruction-operands instruction))))
    (when (and result (mir-lir-dead-pure-value-p result)) (return-from mir-lir-instruction))
    (when (and result (not (svref *mir-lir-live* result))
               (mir-lir-double-forward-source instruction))
      (return-from mir-lir-instruction))
    (when *mir-lir-single-scalars*
      (let ((source (mir-lir-single-forward-source instruction)))
        (when (and source (mir-lir-single-scalar source))
          (return-from mir-lir-instruction))))
    (let ((specialization (mir-lir-typep-specialization instruction)))
      (when specialization
        (mir-lir-save result (emit-typep-test (first args) (first specialization)) 1)
        (return-from mir-lir-instruction)))
    (when (mir-lir-unit-random-p instruction)
      (let ((state (if (rest args)
                       (second args)
                       (let* ((symbol (constant-object '*random-state*))
                              (value (emit-symbol-value symbol)))
                         (emit-check-bound value symbol)
                         value))))
        (mir-lir-save result (emit-slow-call 'kiln.kernel::random-unit-double state) 1))
      (return-from mir-lir-instruction))
    (multiple-value-bind (test reverse-p) (mir-lir-vector-search-options instruction)
      (when test
        (let* ((policy (mir-instruction-policy instruction))
               (unroll (and (eq test 'eq)
                            (< (hir-policy-quality policy :space) (hir-policy-quality policy :speed)))))
          (mir-lir-save result
                        (mir-lir-vector-search data test (first args) (second args) unroll reverse-p)
                        1))
        (return-from mir-lir-instruction)))
    (let ((plan (mir-lir-object-call-plan instruction)))
      (when plan
        (multiple-value-bind (value count)
            (ecase (first plan)
              (:slot-read (emit-cached-slot-value (first args) (second plan)))
              (:slot-write (emit-cached-set-slot-value (first args) (second args) (second plan)))
              (:constructor (emit-constructor-call data args (second plan) (third plan))))
          (mir-lir-save result value (or count 1)))
        (return-from mir-lir-instruction)))
    (when (and (= kind 6)
               (or (eq data 'aref) (equal data '(setf aref)))
               (hir-policy-optimize-p (mir-instruction-policy instruction))
               (not (mir-instruction-notinline instruction)))
      (let* ((store (equal data '(setf aref)))
             (rank (- (length args) (if store 2 1))))
        (case rank
          (2 (let ((helper (if store 'kiln.kernel::%set-aref-2 'kiln.kernel::%aref-2)))
               (flet ((slow () (apply #'emit-slow-call helper args)))
                 (mir-lir-save result
                   (if *mir-lir-in-loop*
                       (destructuring-bind (array i j) (if store (rest args) args)
                         (let* ((operands (mir-instruction-operands instruction))
                                (offset (if store 1 0)))
                           (mir-lir-emit-two-index-access
                            array i j (and store (first args))
                            (svref *mir-lir-types* (svref operands (+ offset 1)))
                            (svref *mir-lir-types* (svref operands (+ offset 2)))
                            #'slow)))
                       (slow))
                   1)))
             (return-from mir-lir-instruction))
          (3 (destructuring-bind (array i j k) (if store (rest args) args)
               (mir-lir-save result
                 (emit-slow-call 'kiln.kernel::%ranked-aref array i j k
                                 (constant-object 3) (constant-object store)
                                 (if store (first args) (nil-value))) 1))
             (return-from mir-lir-instruction)))))
    (multiple-value-bind (operation type) (mir-lir-container-call instruction)
      (when operation
        (let* ((doublep (mir-lir-double-array-access-p operation type))
               (single (mir-lir-single-scalar result))
               (value (mir-lir-container-value operation instruction args type doublep single))
               (raw (svref *mir-lir-doubles* result)))
          (cond (single (kiln.kir::emit-lir-assignment single value))
                (doublep
                 (when raw (kiln.kir::emit-lir-assignment raw value))
                 (when (and (svref *mir-lir-live* result)
                            (or (not raw) (svref *mir-lir-boxed* result)))
                   (mir-lir-save result
                                 (if (eq operation :specialized-array-write) (first args)
                                     (emit-box-double-bits value)) 1)))
                (t
                 (mir-lir-save result value 1)
                 (when raw
                   (mir-lir-load-field raw kiln.kir::+packet-field-double-bits+ value)))))
        (return-from mir-lir-instruction)))
    (when (and (= kind 6) (member data '(evenp oddp)) (= (length args) 1)
               (hir-policy-optimize-p *hir-policy*) (not (mir-instruction-notinline instruction)))
      (let ((value (mir-lir-parity-call instruction (first args))))
        (when value
          (mir-lir-save result value 1)
          (return-from mir-lir-instruction))))
    (let ((masked (and *mir-lir-masked-arithmetic* (gethash result *mir-lir-masked-arithmetic*))))
      (when (or masked (mir-lir-fixnum-call-p instruction))
        (mir-lir-save result
                      (mir-lir-fixnum-call instruction args
                                           (or (eq fixnum-result-check :unchecked) (eq masked :wrap))
                                           (when (mir-instruction-p fixnum-result-check)
                                             fixnum-result-check)) 1)
        (return-from mir-lir-instruction)))
    (when (and (= kind 6) (member data '(< <= > >= = /=))
               (hir-policy-optimize-p *hir-policy*) (not (mir-instruction-notinline instruction)))
      (let ((value (mir-lir-mixed-integer-comparison instruction args)))
        (when value
          (mir-lir-save result value 1)
          (return-from mir-lir-instruction))))
    (when (and (= kind 6) (eq data 'mod))
      (let ((value (mir-lir-fixnum-mod instruction (first args))))
        (when value
          (mir-lir-save result value 1)
          (return-from mir-lir-instruction))))
    (let ((divisor (mir-lir-power-of-two-divisor instruction)))
      (when divisor
        (if (eq data '/)
            (mir-lir-save result (mir-lir-exact-power-of-two-division (first args) divisor) 1)
            (mir-lir-power-of-two-division instruction (first args) divisor))
        (return-from mir-lir-instruction)))
    (when (and (= kind 6) (eq data 'expt) (= (length args) 2))
      (let ((value (mir-lir-power-of-two-expt instruction (first args) (second args))))
        (when value
          (mir-lir-save result value 1)
          (return-from mir-lir-instruction))))
    (when (mir-lir-single-call-p instruction)
      (let* ((operands (mir-instruction-operands instruction))
             (left (mir-lir-single-scalar (svref operands 0)))
             (right (mir-lir-single-scalar (svref operands 1)))
             (raw (mir-lir-single-scalar result))
             (value (if (or left right raw)
                        (mir-lir-single-scalar-call data (first args) (second args) left right raw operands)
                        (mir-lir-float-chain :single data (first args) (rest args)))))
        (when value (mir-lir-save result value 1)))
      (return-from mir-lir-instruction))
    (when (and (mir-lir-double-call-p instruction) (member data '(< > <= >= = /= zerop plusp minusp)))
      (let* ((operands (mir-instruction-operands instruction))
             (left (mir-lir-double-bits (svref operands 0)))
             (unary (= (length operands) 1))
             (right (if unary 0 (mir-lir-double-bits (svref operands 1))))
             (comparison (copy-to-var `(:f64-compare ,left ,right) :raw)))
        (mir-lir-save result
                      (boolean-value
                       (case data
                         ((> plusp) `(:eq ,comparison 1))
                         (>= `(:or (:eq ,comparison 0) (:eq ,comparison 1)))
                         (t `(,(ecase data ((< minusp) :lt) (<= :le) ((= zerop) :eq) (/= :ne))
                               ,comparison 0)))) 1))
      (return-from mir-lir-instruction))
    (let ((conversion (mir-lir-double-conversion-p instruction)))
      (when (or conversion (mir-lir-double-call-p instruction))
        (let* ((operands (mir-instruction-operands instruction))
               (bits (cond ((eq instruction (car *mir-lir-fused-reciprocal*))
                            (prog1 (cdr *mir-lir-fused-reciprocal*)
                              (setf *mir-lir-fused-reciprocal* nil)))
                           (conversion
                            (let ((type (svref *mir-lir-types* (svref operands 0))))
                              (if reciprocal
                                  (mir-lir-convert-and-reciprocate (first args) type reciprocal)
                                  (mir-lir-convert-double-bits (first args) type cache-conversion-mode-p))))
                           (t (mir-lir-double-call data operands))))
               (raw (svref *mir-lir-doubles* result)))
          (when raw (emit `(:set ,raw ,bits)))
          (let ((demand (svref *mir-lir-boxed* result)))
            (when (or (not raw) demand)
              (mir-lir-save result (if (eq demand :deferred) (nil-value) (emit-box-double-bits bits)) 1))))
        (return-from mir-lir-instruction)))
    (when (and (= kind 6) (eq data '/) (<= 1 (length args) 2)
               (hir-policy-optimize-p *hir-policy*)
               (not (mir-instruction-notinline instruction)))
      (mir-lir-save result
                    (if (rest args)
                        (emit-slow-call 'kiln.kernel::two-arg-/ (first args) (second args))
                        (emit-slow-call 'kiln.kernel::two-arg-/ (constant-object 1) (first args)))
                    1)
      (return-from mir-lir-instruction))
    (let ((source (mir-lir-double-forward-source instruction)))
      (when (and result source (svref *mir-lir-doubles* result) (svref *mir-lir-doubles* source))
        (kiln.kir::emit-lir-assignment (svref *mir-lir-doubles* result) (svref *mir-lir-doubles* source))
        (when (eq (svref *mir-lir-boxed* result) :deferred)
          (let ((from (mir-lir-value source)))
            (kiln.kir::emit-lir-assignment (if (consp out) (car out) out)
                                             (if (consp from) (car from) from)))
          (return-from mir-lir-instruction))
        (unless (svref *mir-lir-boxed* result) (return-from mir-lir-instruction))))
    (case kind
      (40 (let* ((index (car data))
                 (slot (or (svref *mir-lir-debug-bindings* index)
                           (let ((variable (kiln.kir::new-var)))
                             (setf (svref *mir-lir-debug-bindings* index) variable)
                             (note-debug-var variable (cdr data) (logbitp index *mir-lir-debug-cells*))
                             variable))))
            (emit `(:set ,slot ,(first args)))))
      (0 (mir-lir-constant-assignment out (constant-word data)))
      (26 (let* ((label (svref *mir-lir-load-time-cells* data))
                 (id (kiln.kir::module-data-index (kiln.kir::kmodule-defined *module*) label)))
            (emit (list :lir-set out (list :cell-ref (- -1 id)) (list :cell-ref label)))))
      (27 (let* ((region (svref *mir-lir-bindings* (car data)))
                 (symbol (constant-object (cdr data))) (index (emit-tls-index symbol)))
            (emit-region-entry region `(:dynamic-enter ,(region-slot region) :bind ,symbol))
            (emit `(:special-bind-index ,(region-slot region) ,index ,(first args)))
            (setf (region-outer region) *regions*) (push region *regions*)))
      (28 (let ((region (svref *mir-lir-bindings* data)))
            (case (region-kind region) (:progv (emit-unbind-progv region)) (:bind (emit-unbind region)))
            (pop-entry region)
            (when (and *regions* (equalp (region-slot (first *regions*)) (region-slot region)))
              (pop *regions*))))
      (29 (let ((region (svref *mir-lir-bindings* data)))
            (emit-region-entry region `(:dynamic-enter ,(region-slot region) :progv ,(first args) ,(second args) ,(handler)))
            (setf (region-outer region) *regions*) (push region *regions*)))
      (30 (let ((region (svref *mir-lir-bindings* data)))
            (setf (region-outer region) *regions*)
            (emit-region-entry region `(:dynamic-enter ,(region-slot region) :catch ,(first args)))
            (push region *regions*)))
      (31 (multiple-value-bind (primary count) (emit-landed-values)
            (mir-lir-save result primary count)))
      (32 (let ((region (svref *mir-lir-bindings* data)))
            (setf (region-outer region) *regions*)
            (emit-region-entry region `(:dynamic-enter ,(region-slot region) :unwind-protect 0))
            (push region *regions*)))
      (33 nil)
      ((34 35) (let ((region (svref *mir-lir-bindings* data)))
                 (setf (region-outer region) *regions*)
                 (emit-region-entry region `(:dynamic-enter ,(region-slot region) :exit-point ,(first args)))
                 (push region *regions*)))
      (36 (emit `(:dynamic-relink ,(region-slot (svref *mir-lir-bindings* data))))
          (emit `(:set ,out (:landing-value))))
      (1 (kiln.kir::emit-lir-assignment out (svref arguments data)))
      (2 (let ((symbol (constant-object data)))
           (emit `(:set ,out ,(emit-symbol-value symbol)))
           (emit-check-bound out symbol)))
      (3 (emit-set-symbol-value (constant-object data) (first args))
         (emit `(:set ,out ,(first args))))
      (4 (emit `(:set ,out ,(function-cell-value data))))
      (5 (let* ((label (svref *mir-lir-labels* data)) (object (kiln.kir::kir-name label "_fobj")))
           (emit `(:set ,out (:object-address ,object :general)))))
      ((6 7)
       (multiple-value-bind (value count)
           (cond ((mir-borrow-call-p instruction)
                  (let ((slot (svref *mir-lir-stack-slots* (mir-instruction-id instruction))))
                    (cond (slot (let ((value (new-var)))
                                  (emit `(:stack-cons ,value (:slot ,slot) ,(first args) ,(second args)))
                                  (values value 1)))
                          ((eq data 'identity) (values (first args) 1))
                          ((member data '(car cdr first rest))
                           (values (mir-lir-list-access data
                                     (svref (mir-instruction-operands instruction) 0) (first args)) 1))
                          (t (funcall (gethash data *primitives*) args)))))
                 ((and (= kind 6) (equal data '(setf fdefinition)) (= (length args) 2))
                  (let* ((id (svref (mir-instruction-operands instruction) 1))
                         (definition (svref *mir-lir-definitions*
                                            (mir-primary-origin id *mir-lir-definitions*))))
                    (if (and definition (= (mir-instruction-kind definition) 0)
                             (or (symbolp (mir-instruction-data definition))
                                 (let ((name (mir-instruction-data definition)))
                                   (and (consp name) (eq (car name) 'setf)
                                        (consp (cdr name)) (symbolp (cadr name)) (null (cddr name))))))
                        (values (emit-set-constant-fdefinition (mir-instruction-data definition) (first args)) 1)
                        (emit-lisp-call (function-cell-value data) args))))
                 ((= kind 6)
                  (let* ((primitive-name
                           (cond ((and (eq data 'aref) (= (length args) 2)) 'kiln.kernel::%aref-1)
                                 ((and (equal data '(setf aref)) (= (length args) 3)) 'kiln.kernel::%set-aref-1)
                                 (t data)))
                         (primitive (and (hir-policy-optimize-p (mir-instruction-policy instruction))
                                        (not (mir-instruction-notinline instruction))
                                        (not (and (eq data 'print)
                                                  (or *image-literals* (/= (length args) 1))))
                                        (gethash primitive-name *primitives*))))
                    (if primitive (funcall primitive args)
                        (emit-lisp-call (function-cell-value data) args))))
                 (t (let* ((id (svref (mir-instruction-operands instruction) 0))
                           (target (and *mir-lir-known-functions*
                                        (hir-policy-optimize-p (mir-instruction-policy instruction))
                                        (not (mir-instruction-notinline instruction))
                                        (svref *mir-lir-known-functions* id))))
                      (if (integerp target)
                          (emit-lisp-call (first args) (mir-lir-known-call-args target instruction args)
                                          (svref *mir-lir-labels* target))
                          (emit-lisp-call (emit-function-designator (first args)) (rest args))))))
         (mir-lir-save result value (or count 1))))
      (15 (let ((acc (nil-value)))
            (loop for index from (1+ (mir-call-prefix-count instruction)) below (length (mir-instruction-operands instruction))
                  do (multiple-value-bind (primary count)
                         (mir-lir-restore (svref (mir-instruction-operands instruction) index))
                       (setf acc (emit-push-values primary count acc))))
            (multiple-value-bind (primary count)
                (emit-apply (emit-function-designator (first args)) (emit-nreverse acc)
                            (subseq args 1 (1+ (mir-call-prefix-count instruction))))
              (mir-lir-save result primary count))))
      (8 (multiple-value-bind (value count) (funcall (gethash data *primops*) args)
           (mir-lir-save result value (or count 1))))
      (9 (mir-lir-save result (first args) 1))
      (10 (multiple-value-bind (value count) (mir-lir-restore (svref (mir-instruction-operands instruction) 0))
            (declare (ignore count)) (emit `(:set ,out ,value))))
      (11 (let ((input (first args))
                (check (not (or known-fixnum-input
                                (mir-check-proven-p instruction *mir-lir-types*)))))
            (when check
              (if (consp input)
                  (multiple-value-bind (primary count)
                      (mir-lir-restore (svref (mir-instruction-operands instruction) 0))
                    (declare (ignore count))
                    (mir-lir-check primary data))
                  (mir-lir-check input data)))
            ;; Both carrier and primary/count locals survive TYPEP calls.
            (if (consp input)
                (mir-lir-copy-bundle result (svref (mir-instruction-operands instruction) 0))
                ;; Preserve the tag proof after the check so the backend can
                ;; omit this value and its copies from the GC root set.
                (emit `(:set ,out ,(if (and check (eq data 'fixnum)
                                            (plusp (hir-policy-quality *hir-policy* :safety)))
                                       `(:fixnum-tag (:fixnum-untag ,input))
                                       input))))))
      (37 (let* ((source (svref (mir-instruction-operands instruction) 0))
                 (fact (svref *mir-lir-value-facts* source))
                 (count (and (mir-values-fact-p fact) (mir-values-fact-count fact))))
            (emit `(:set ,out ,(if count (constant-object (< data count))
                                  (boolean-value `(:gt ,(cdr (first args)) ,data)))))))
      (38 (let* ((source (svref (mir-instruction-operands instruction) 0))
                 (list (if (mir-lir-single-p source)
                           (if (zerop data) (emit-cons (car (first args)) (nil-value)) (nil-value))
                           (if (zerop data) (car (first args))
                               (emit-slow-call 'nthcdr (constant-object data) (car (first args)))))))
            (emit `(:set ,out ,list))))
      (39 (mir-lir-copy-bundle result (svref (mir-instruction-operands instruction) 0)))
      (14 (let* ((source (svref (mir-instruction-operands instruction) 0))
                 (fact (svref *mir-lir-value-facts* source))
                 (known-count (and (mir-values-fact-p fact) (mir-values-fact-count fact))))
            (if (or (>= data kiln.kir::+backend-value-limit+)
                    (and known-count (>= data known-count)))
                (emit `(:set ,out ,(nil-value)))
                (multiple-value-bind (primary count) (mir-lir-restore source)
                  (emit `(:set ,out ,(if (zerop data) primary
                                        `(:select (:gt ,count ,data) (:secondary-value-ref ,data) ,(nil-value)))))))))
      (19 (let ((slot (svref *mir-lir-stack-slots* (mir-instruction-id instruction))))
            (if slot (emit `(:stack-cons ,out (:slot ,slot) ,(first args) ,(nil-value)))
                (emit `(:set ,out ,(emit-cons (first args) (nil-value)))))))
      (20 (mir-lir-load-field out kiln.kir::+packet-field-cons-car+
                               (mir-lir-cell-operand instruction (first args))))
      (21 (emit-field-store kiln.kir::+packet-field-cons-car+
                            (mir-lir-cell-operand instruction (first args)) (second args)))
      (22 (emit `(:set ,out (:closure-ref ,*self* ,data))))
      (23 (let ((slot (svref *mir-lir-stack-slots* (mir-instruction-id instruction))))
            (if slot
                (emit `(:stack-closure ,out ,slot ,(svref *mir-lir-labels* data)))
                (emit `(:alloc-closure ,out ,(svref *mir-lir-labels* data)
                                      ,(length (mir-function-captures (svref *mir-lir-functions* data))) ,(handler))))))
      (24 (emit `(:closure-set ,(first args) ,(cdr data) ,(second args))))
      (25 (emit `(:set ,out ,(nil-value))))
      (12 (kiln.kir::emit-lir-assignment out argument-count))
      (13 (emit-nargs-check (first args) (car data) (cdr data)))
      (16 (emit `(:set ,out ,(boolean-value `(:gt ,(first args) ,data)))))
      (17 (emit `(:set ,out ,(emit-rest-list data *mir-lir-rest-slots*))))
      (18 (emit-error (ecase data (:odd-keywords +err-odd-keywords+) (:unknown-keyword +err-unknown-keyword+)
                               (:progv-list +err-not-list+) (:progv-symbol +err-not-symbol+))
                      (first args))))
    (when (and result (svref *mir-lir-doubles* result))
      (mir-lir-load-field (svref *mir-lir-doubles* result)
                          kiln.kir::+packet-field-double-bits+
                          (if (consp out) (car out) out)))))

(defun mir-lir-parallel-copies (copies)
  "Assign atomic operands in parallel, using one temporary per copy cycle."
  (setf copies (delete-if (lambda (copy) (eq (car copy) (cdr copy))) copies))
  (unless copies (return-from mir-lir-parallel-copies))
  ;; Most CFG edges have very few live parameters; a bounded scan avoids
  ;; allocating dependency tables for these edges.
  (when (<= (length copies) 8)
    (loop while copies do
      (let ((ready (loop for copy in copies
                         unless (loop for reader in copies thereis (eq (car copy) (cdr reader)))
                           return copy)))
        (if ready
            (progn (kiln.kir::emit-lir-assignment (car ready) (cdr ready))
                   (setf copies (delete ready copies :test #'eq)))
            (let* ((destination (caar copies))
                   (temporary (copy-to-var destination (svref destination 2))))
              (dolist (copy copies)
                (when (eq (cdr copy) destination) (setf (cdr copy) temporary)))))))
    (return-from mir-lir-parallel-copies))
  (let ((pending (make-hash-table :test 'eq))
        (readers (make-hash-table :test 'eq))
        (uses (make-hash-table :test 'eq))
        (ready (make-hir-buffer)) (cursor 0) (remaining 0) (unresolved copies))
    (dolist (copy copies)
      (unless (eq (car copy) (cdr copy))
        (setf (gethash (car copy) pending) copy)
        (incf (gethash (cdr copy) uses 0))
        (push copy (gethash (cdr copy) readers))
        (incf remaining)))
    (dolist (copy copies)
      (when (and (gethash (car copy) pending) (zerop (gethash (car copy) uses 0)))
        (hir-push copy ready)))
    (loop while (plusp remaining) do
      (when (= cursor (hir-buffer-count ready))
        (loop while (and unresolved (not (gethash (caar unresolved) pending))) do (pop unresolved))
        (let* ((copy (first unresolved)) (destination (car copy))
               (temporary (copy-to-var destination (svref destination 2))))
          ;; Only outstanding readers need the old value. Emitted copies can
          ;; remain in the index; their destinations are no longer pending.
          (dolist (reader (gethash destination readers))
            (when (gethash (car reader) pending) (setf (cdr reader) temporary)))
          (setf (gethash temporary uses) (gethash destination uses)
                (gethash destination uses) 0)
          (hir-push copy ready)))
      (let* ((copy (mir-at ready cursor)) (destination (car copy)) (source (cdr copy)))
        (incf cursor)
        (kiln.kir::emit-lir-assignment destination source)
        (remhash destination pending)
        (decf remaining)
        (when (zerop (decf (gethash source uses)))
          (let ((next (gethash source pending)))
            (when next (hir-push next ready))))))))

(defun mir-lir-edge-needs-copies-p (function edge)
  (loop for target across (mir-block-parameters (mir-at (mir-function-blocks function)
                                                        (mir-edge-target edge)))
        for source across (mir-edge-arguments edge)
        thereis (and (/= target source) (svref *mir-lir-live* target))))

(defun mir-lir-edge-copies (function edge)
  "Prepare carrier conversions before scheduling parallel parameter assignments."
  (let ((copies nil) (view-copies nil)
        (parameters (mir-block-parameters (mir-at (mir-function-blocks function) (mir-edge-target edge)))))
    (loop for target across parameters for source across (mir-edge-arguments edge)
          for from = (mir-lir-value source) for to = (mir-lir-value target)
          when (svref *mir-lir-live* target)
          do (when (svref *mir-lir-doubles* target)
               (push (cons (svref *mir-lir-doubles* target)
                           (mir-lir-double-bits source)) copies))
             (when (or (not (svref *mir-lir-doubles* target)) (svref *mir-lir-boxed* target))
               (if (mir-lir-transient-p target)
                   (unless (= target source)
                     (let ((primary (new-var)) (count (new-var :raw)))
                       (emit-move-values primary count (car from) (cdr from))
                       (push (list (car to) (cdr to) primary count) view-copies)))
                   (if (consp to)
                 (cond ((and (mir-lir-carrier-p target) (mir-lir-carrier-p source))
                        (push (cons (car to) (car from)) copies)
                        (unless (mir-lir-known-count target)
                          (push (cons (cdr to) (cdr from)) copies)))
                       ((not (mir-lir-carrier-p target))
                        (multiple-value-bind (primary count) (mir-lir-restore source)
                          (push (cons (car to) primary) copies)
                          (unless (mir-lir-known-count target)
                            (push (cons (cdr to) count) copies))))
                       (t (unless (mir-lir-single-p source)
                            (mir-fail "MIR edge carrier demand was not propagated"))
                          (let ((saved (new-var)))
                            (emit `(:save-values ,saved ,(car from) 1 ,(handler)))
                            (push (cons (car to) saved) copies)
                            (unless (mir-lir-known-count target)
                              (push (cons (cdr to) 1) copies)))))
                 (push (cons to from) copies)))))
    (mir-lir-parallel-copies (nreverse copies))
    (dolist (copy (nreverse view-copies)) (apply #'emit-move-values copy))))

(defun mir-lir-active-regions (bindings outer)
  (if (or (eq bindings :unseen) (null bindings)) outer
      (let* ((binding (first bindings))
             (tail (mir-lir-active-regions (rest bindings) outer))
             (region (svref *mir-lir-bindings* (mir-active-binding-id binding))))
        (cons (if (consp binding)
                  (let ((handler (find-if #'region-handler tail)))
                    (make-region :kind :cleanup-running :slot (region-slot region) :outer tail
                                 :handler (and handler (region-handler handler))))
                  region) tail))))

(defun mir-lir-cleanup-regions (regions)
  (let* ((region (first regions)) (outer (rest regions)) (handler (find-if #'region-handler outer)))
    (cons (make-region :kind :cleanup-running :slot (region-slot region) :outer outer
                       :handler (and handler (region-handler handler))) outer)))

(defun mir-lir-known-vector-backing (array)
  (let ((layouts (copy-to-var
                  (emit-symbol-value (constant-object 'kiln.kernel::*specialized-array-storage-slots*)))))
    (emit-registered-array-backing
     array layouts
     (lambda () (emit-slow-call 'kiln.kernel::%simple-specialized-array-contents array)))))

(defun mir-lir-natural-loop (header incoming dominators)
  (let ((members (ash 1 header))
        (pending nil)
        (entry nil))
    (dolist (edge (svref incoming header))
      (if (mir-block-dominates-p dominators header (car edge))
          (push (car edge) pending)
          (if entry (return-from mir-lir-natural-loop nil)
              (setf entry edge))))
    (when (and entry pending)
      ;; Only the header may have a predecessor outside the loop.
      (loop while pending for block = (pop pending)
            unless (logbitp block members) do
              (unless (mir-block-dominates-p dominators header block)
                (return-from mir-lir-natural-loop nil))
              (setf members (logior members (ash 1 block)))
              (dolist (predecessor (svref incoming block))
                (push (car predecessor) pending)))
      (values members entry))))

(defun mir-lir-reverse-guard-value (upper entry members dominators)
  (flet ((available-fixnum-p (value)
           (let ((owner (mir-value-block (svref *mir-lir-value-owners* value))))
             (and (svref *mir-lir-live* value)
                  (eq (mir-value-representation (svref *mir-lir-value-owners* value)) :obj)
                  (hir-fixnum-type-p (svref *mir-lir-types* value))
                  (not (logbitp owner members))
                  (mir-block-dominates-p dominators owner entry)))))
    (if (available-fixnum-p upper) upper
        ;; The original argument may only acquire its type after a declaration check.
        (loop for value across *mir-lir-value-owners* for id = (mir-value-id value)
              when (and (available-fixnum-p id)
                        (= upper (mir-primary-origin id *mir-lir-definitions*)))
                return id))))

(defun mir-lir-copyable-loop-cost (blocks instructions members entry)
  (and (<= (logcount members) 16)
       (zerop (mir-terminator-kind (mir-block-terminator (svref blocks entry))))
       (loop with cost = 0 for block across blocks
             when (logbitp (mir-block-id block) members)
               do (incf cost (hir-buffer-count (mir-block-instructions block)))
                  ;; Region entries and landings have unique identities. Debug
                  ;; bindings update state shared by the lowering of a function.
                  (unless (and (<= cost 72)
                               (member (mir-terminator-kind (mir-block-terminator block)) '(0 1))
                               (every (lambda (id)
                                        (let ((kind (mir-instruction-kind (mir-at instructions id))))
                                          (not (or (<= 27 kind 36) (= kind 40)))))
                                      (hir-buffer-view (mir-block-instructions block))))
                    (return nil))
             finally (return cost))))

(defun mir-lir-reverse-loop-bound (block instructions bounds entry members dominators)
  (let ((accesses nil))
    (loop for id across (hir-buffer-view (mir-block-instructions block))
          for result = (mir-instruction-result (mir-at instructions id))
          for access = (gethash result *mir-lir-array-sources*)
          for (source index limit) = access
          for upper = (and source (gethash source *mir-lir-array-contents*)
                           (mir-lir-reverse-index-upper-bound index result))
          when (and upper (not (minusp upper))
                    (hir-simple-specialized-vector-p (svref *mir-lir-types* source))
                    (not (mir-lir-array-index-proven-p
                          source limit (svref *mir-lir-types* upper)
                          (when bounds (gethash upper bounds))))
                    (let ((owner (mir-value-block (svref *mir-lir-value-owners* source))))
                      (and (not (logbitp owner members))
                           (mir-block-dominates-p dominators owner entry))))
            do (let* ((pair (cons upper source))
                      (first-access (assoc pair accesses :test #'equal)))
                 (if first-access
                     (unless (eql (cdr first-access) index)
                       (let ((value (mir-lir-reverse-guard-value upper entry members dominators)))
                         (when value (return (values pair value)))))
                     (push (cons pair index) accesses))))))

(defun mir-lir-loop-predecessors (function blocks reachable)
  (mir-analysis function :loop-predecessors
    (lambda (function)
      (declare (ignore function))
      (let ((incoming (make-array (length blocks) :initial-element nil)))
        (loop for block across blocks for id = (mir-block-id block)
              when (logbitp id reachable)
                do (loop for edge across (mir-terminator-edges (mir-block-terminator block))
                         do (push (cons id edge) (svref incoming (mir-edge-target edge)))))
        incoming))))

(defun mir-lir-ranked-index-origin (id definitions)
  (let* ((id (mir-primary-origin id definitions))
         (instruction (svref definitions id)))
    (if (and instruction (= (mir-instruction-kind instruction) 20))
        (svref (mir-instruction-operands instruction) 0)
        id)))

(defun mir-lir-ranked-increment-p (id index definitions)
  (let* ((instruction (svref definitions (mir-primary-origin id definitions)))
         (operands (and instruction (mir-instruction-operands instruction))))
    (when (and instruction (= (mir-instruction-kind instruction) 6)
               (not (mir-instruction-notinline instruction)))
      (case (mir-instruction-data instruction)
        (1+ (and (= (length operands) 1)
                 (= index (mir-lir-ranked-index-origin (svref operands 0) definitions))))
        (+ (and (= (length operands) 2)
                (loop for position below 2
                      thereis (and (= index (mir-lir-ranked-index-origin
                                            (svref operands position) definitions))
                                   (mir-induction-integer-constant-p
                                    (svref operands (- 1 position)) 1 definitions)))))))))

(defun mir-lir-ranked-row-pattern (function blocks members header index body exit cell)
  (let ((definitions *mir-lir-definitions*)
        (instructions (mir-function-instructions function))
        (users (mir-value-use-blocks function))
        (arithmetic nil) (reads nil) (write nil) (operations-block nil) (checked-rows nil)
        (read-cells nil) (step-block nil))
    (labels ((origin (id)
               (mir-primary-origin id definitions))
             (argument (instruction position)
               (origin (svref (mir-instruction-operands instruction) position)))
             (index-argument (instruction position)
               (mir-lir-ranked-index-origin
                (svref (mir-instruction-operands instruction) position) definitions))
             (record-access (instruction store)
               (let ((offset (if store 1 0)))
                 (when (= (index-argument instruction (+ offset 2)) index)
                   (list (argument instruction offset)
                         (index-argument instruction (1+ offset)))))))
      (loop for block across blocks
            for id = (mir-block-id block)
            for term = (mir-block-terminator block)
            when (logbitp id members) do
              (unless (and (or (= id header) (= (mir-terminator-kind term) 0))
                           (every (lambda (edge)
                                    (or (eq edge exit)
                                        (logbitp (mir-edge-target edge) members)))
                                  (mir-terminator-edges term)))
                (return-from mir-lir-ranked-row-pattern nil))
              (loop for ordinal across (hir-buffer-view (mir-block-instructions block))
                    for instruction = (mir-at instructions ordinal)
                    for kind = (mir-instruction-kind instruction)
                    for name = (mir-instruction-data instruction)
                    for result = (mir-instruction-result instruction)
                    for operands = (mir-instruction-operands instruction)
                    do (when (and result (some (lambda (user) (not (logbitp user members)))
                                                 (svref users result)))
                         (return-from mir-lir-ranked-row-pattern nil))
                       (cond
                         ((member kind '(0 9 10)))
                         ((= kind 20)
                          (pushnew (svref operands 0) read-cells))
                         ((= kind 21)
                          (unless (and cell (not step-block) write
                                       (= (svref operands 0) index)
                                       (mir-lir-ranked-increment-p (svref operands 1) index definitions))
                            (return-from mir-lir-ranked-row-pattern nil))
                          (setf step-block id))
                         ((= kind 11)
                          (unless (mir-check-proven-p instruction *mir-lir-types*)
                            (unless (member name '(unsigned-byte fixnum))
                              (return-from mir-lir-ranked-row-pattern nil))
                            (let ((operand (argument instruction 0)))
                              (unless (or (= (index-argument instruction 0) index)
                                          (mir-lir-ranked-increment-p operand index definitions))
                                (pushnew (index-argument instruction 0) checked-rows)))))
                         ((and (= kind 6) (not (mir-instruction-notinline instruction)))
                          (cond
                            ((and (= id header) (eq name '>=)
                                  (= (origin (svref (mir-terminator-operands term) 0)) result)))
                            ((and (/= id header)
                                  (mir-lir-ranked-increment-p result index definitions)))
                            ((and (eq name 'aref) (= (length operands) 3)
                                  (null arithmetic) (null write)
                                  (or (null operations-block) (= operations-block id)))
                             (let ((access (record-access instruction nil)))
                               (unless access (return-from mir-lir-ranked-row-pattern nil))
                               (setf operations-block id)
                               (push (cons result access) reads)))
                            ((and (eq name '+) (= (length operands) 2)
                                  (eql id operations-block) (null arithmetic) (null write)
                                  (= (length reads) 2)
                                  (not (= (argument instruction 0) (argument instruction 1)))
                                  (assoc (argument instruction 0) reads)
                                  (assoc (argument instruction 1) reads))
                             (setf arithmetic result))
                            ((and (equal name '(setf aref)) (= (length operands) 4)
                                  (eql id operations-block) (null write)
                                  (eql arithmetic (argument instruction 0)))
                             (setf write (record-access instruction t))
                             (unless write (return-from mir-lir-ranked-row-pattern nil)))
                            (t (return-from mir-lir-ranked-row-pattern nil))))
                         (t (return-from mir-lir-ranked-row-pattern nil)))))
      (when (and write (= (length reads) 2)
                 (or (not cell) step-block)
                 (zerop (length (mir-edge-arguments exit)))
                 (multiple-value-bind (reachable dominators) (mir-cached-control-flow function)
                   (let ((incoming (mir-lir-loop-predecessors function blocks reachable)))
                     (and (mir-block-dominates-p dominators body operations-block)
                          (every (lambda (edge)
                                   (or (not (logbitp (car edge) members))
                                       (and (mir-block-dominates-p dominators operations-block (car edge))
                                            (or (not cell)
                                                (mir-block-dominates-p dominators step-block (car edge))))))
                                 (svref incoming header))))))
        (let ((sources (mapcar #'cdr (reverse reads))))
          (when (and (every (lambda (value) (= value (second write))) checked-rows)
                     (every (lambda (value) (or (= value index) (= value (second write)))) read-cells)
                     (every (lambda (access) (= (second access) (second write))) sources)
                     (notany (lambda (access)
                               (some (lambda (value)
                                       (logbitp (mir-value-block (svref *mir-lir-value-owners* value)) members))
                                     access))
                             (cons write sources)))
            (values (second write) (mapcar #'first sources) (first write)
                    (member (second write) read-cells))))))))

(defun mir-lir-ranked-local-cell-p (id function blocks)
  (let ((instructions (mir-function-instructions function)))
    (every (lambda (block-id)
             (let* ((block (svref blocks block-id))
                    (term (mir-block-terminator block)))
               (and (not (find id (mir-terminator-operands term)))
                    (notany (lambda (edge) (find id (mir-edge-arguments edge)))
                            (mir-terminator-edges term))
                    (every (lambda (ordinal)
                             (let* ((instruction (mir-at instructions ordinal))
                                    (operands (mir-instruction-operands instruction)))
                               (or (not (find id operands))
                                   (and (= (svref operands 0) id)
                                        (case (mir-instruction-kind instruction)
                                          (20 t)
                                          (21 (/= (svref operands 1) id)))))))
                           (hir-buffer-view (mir-block-instructions block))))))
           (svref (mir-value-use-blocks function) id))))

(defun mir-lir-plan-ranked-row-loop (function blocks)
  (multiple-value-bind (reachable dominators) (mir-cached-control-flow function)
    (let* ((instructions (mir-function-instructions function))
           (definitions *mir-lir-definitions*)
           (incoming (mir-lir-loop-predecessors function blocks reachable))
           (bindings (mir-binding-analysis-inputs (mir-binding-regions function))))
      (loop for block across blocks for header = (mir-block-id block)
            for term = (mir-block-terminator block)
            for policy = (mir-terminator-policy term)
            for parameters = (mir-block-parameters block)
            when (and (logbitp header reachable) (= (mir-terminator-kind term) 1)
                      (hir-policy-optimize-p policy)
                      (< (hir-policy-quality policy :debug) 2)
                      (<= (hir-policy-quality policy :space) (hir-policy-quality policy :speed))
                      (null (svref bindings header)))
              do (let* ((test (mir-primary-origin (svref (mir-terminator-operands term) 0)
                                                   definitions))
                        (comparison (svref definitions test))
                        (args (and comparison (mir-instruction-operands comparison))))
                   (when (and comparison (= (mir-instruction-kind comparison) 6)
                              (= (mir-value-block (svref *mir-lir-value-owners* test)) header)
                              (eq (mir-instruction-data comparison) '>=)
                              (not (mir-instruction-notinline comparison)) (= (length args) 2))
                     (let* ((index (mir-lir-ranked-index-origin (svref args 0) definitions))
                            (limit (svref args 1))
                            (exit (svref (mir-terminator-edges term) 0))
                            (body (mir-edge-target (svref (mir-terminator-edges term) 1)))
                            (definition (svref definitions index))
                            (cell (and definition (= (mir-instruction-kind definition) 19))))
                       (when (or (and cell (zerop (length parameters)))
                                 (and (= (length parameters) 1) (= index (svref parameters 0))))
                         (multiple-value-bind (members entry)
                             (mir-lir-natural-loop header incoming dominators)
                           (when (and members
                                      (mir-lir-copyable-loop-cost blocks instructions members (car entry))
                                      (not (logbitp (mir-edge-target exit) members))
                                      (mir-block-dominates-p dominators
                                        (mir-value-block (svref *mir-lir-value-owners* limit)) (car entry))
                                      (if cell
                                          (and (mir-induction-integer-constant-p
                                                (svref (mir-instruction-operands definition) 0) 0 definitions)
                                               (mir-block-dominates-p dominators
                                                 (mir-value-block (svref *mir-lir-value-owners* index))
                                                 (car entry))
                                               (mir-lir-ranked-local-cell-p index function blocks))
                                          (and (mir-induction-integer-constant-p
                                                (svref (mir-edge-arguments (cdr entry)) 0) 0 definitions)
                                               (loop for (source . edge) in (svref incoming header)
                                                     always
                                                     (or (eq edge (cdr entry))
                                                         (and (mir-block-dominates-p dominators body source)
                                                              (mir-induction-add-one-p
                                                               (svref (mir-edge-arguments edge) 0)
                                                               index definitions)))))))
                             (multiple-value-bind (row sources destination row-cell)
                                 (mir-lir-ranked-row-pattern function blocks members header index body exit cell)
                               (when row
                                 (return (list (cdr entry) exit index limit row sources destination
                                               cell row-cell))))))))))))))

(defun mir-lir-emit-ranked-row-loop (plan entry-label labels)
  (destructuring-bind (entry exit index-id limit-id row-id sources destination cell row-cell) plan
    (let ((fallback (svref labels (mir-edge-target entry)))
          (leave (svref labels (mir-edge-target exit)))
          (resume (and cell (new-block t))) (finished (and cell (new-block)))
          (pending (new-block t))
          (index (if cell (new-var) (mir-lir-value index-id)))
          (limit (mir-lir-value limit-id))
          (row (if row-cell (new-var) (mir-lir-value row-id))))
      (labels ((primary (id)
                 (let ((value (mir-lir-value id)))
                   (if (consp value) (car value) value)))
               (guard (test)
                 (let ((next (new-block)))
                   (br test next fallback)
                   (start-block next)))
               (guard-array (id bound)
                 (let ((element-limit nil))
                   (multiple-value-bind (storage rows columns)
                       (mir-lir-guard-ranked-array-layout
                        (primary id) fallback
                        (lambda (type layout guard)
                          (declare (ignore type))
                          (setf element-limit
                                (copy-to-var `(:vector-ref-fixnum ,layout ,(constant-object 4))))
                          (funcall guard (emit-kind-test element-limit kiln.kir::+packet-class-fixnum+))
                          (when bound
                            (funcall guard
                                     `(:eq (:fixnum-uge ,(constant-object bound) ,element-limit) 1)))))
                     (guard `(:eq (:fixnum-uge ,row ,rows) 0))
                     (guard `(:eq (:fixnum-uge ,columns ,limit) 1))
                     (list storage (copy-to-var `(:fixnum-mul ,row ,columns)) element-limit))))
               (row-index (array)
                 (copy-to-var `(:fixnum-add ,(second array) ,index)))
               (step-column (left right target checked)
                 (let* ((x (copy-to-var `(:vector-ref-fixnum ,(first left) ,(row-index left))))
                        (y (copy-to-var `(:vector-ref-fixnum ,(first right) ,(row-index right))))
                        (sum (copy-to-var `(:fixnum-add ,x ,y))))
                   (when checked
                     (let ((store (new-block)))
                       (br `(:fixnum-uge ,(third target) ,sum) store (or resume fallback))
                       (start-block store)))
                   (emit `(:lir-store :vector-set-fixnum ,(first target) ,(row-index target) ,sum))
                   (kiln.kir::emit-lir-assignment index `(:fixnum-add ,index (:fixnum-tag 1)))))
               (row-loop (poll left right target checked)
                 (let ((test (new-block)) (tail (new-block))
                       (group (new-block)) (body (new-block)))
                   (start-block poll)
                   (emit-poll-branch pending test)
                   (start-block test)
                   (let ((remaining (copy-to-var `(:fixnum-sub ,limit ,index))))
                     (br `(:fixnum-le (:fixnum-tag 4) ,remaining) group tail))
                   (start-block tail)
                   (br `(:fixnum-uge ,index ,limit) (or finished leave) body)
                   (start-block group)
                   (dotimes (column 4)
                     (declare (ignorable column))
                     (step-column left right target checked))
                   (jump poll)
                   (start-block body)
                   (step-column left right target checked)
                   (jump poll))))
        (start-block entry-label)
        (when cell
          (mir-lir-load-field index kiln.kir::+packet-field-cons-car+ (mir-lir-value index-id))
          (guard `(:eq ,index (:fixnum-tag 0))))
        (when row-cell
          (mir-lir-load-field row kiln.kir::+packet-field-cons-car+ (mir-lir-value row-id)))
        (guard (emit-kind-test row kiln.kir::+packet-class-fixnum+))
        (guard (emit-kind-test limit kiln.kir::+packet-class-fixnum+))
        (guard `(:fixnum-le (:fixnum-tag 1) ,limit))
        (let* ((left (guard-array (first sources) (floor +hir-fixnum-max+ 2)))
               (right (guard-array (second sources) (floor +hir-fixnum-max+ 2)))
               (target (guard-array destination nil))
               (unchecked (new-block)) (checked (new-block))
               ;; Both source limits were checked against half the fixnum
               ;; maximum, so their sum bounds every result in this row.
               (sum-limit (copy-to-var `(:fixnum-add ,(third left) ,(third right)))))
          (br `(:fixnum-uge ,(third target) ,sum-limit) unchecked checked)
          (row-loop unchecked left right target nil)
          (row-loop checked left right target t))
        (start-block pending)
        (when cell
          (emit-field-store kiln.kir::+packet-field-cons-car+ (mir-lir-value index-id) index))
        (emit-poll)
        (jump fallback)
        (when cell
          (start-block resume)
          (emit-field-store kiln.kir::+packet-field-cons-car+ (mir-lir-value index-id) index)
          (jump fallback)
          (start-block finished)
          (emit-field-store kiln.kir::+packet-field-cons-car+ (mir-lir-value index-id) index)
          (jump leave))))))


(defun mir-lir-positive-loop-indices (function blocks polls candidates)
  (when candidates
    (multiple-value-bind (reachable dominators) (mir-cached-control-flow function)
      (let ((incoming (mir-lir-loop-predecessors function blocks reachable))
            (positive nil))
        (dolist (index candidates positive)
          (let* ((id (mir-value-block (svref *mir-lir-value-owners* index)))
                 (position (and (logbitp id polls)
                                (position index (mir-block-parameters (svref blocks id))))))
            ;; Every external edge starts at one. A backedge advances this
            ;; activation's index, so the index stays positive.
            (when (and position
                       (loop with initial = nil with stepped = nil
                             for (source . edge) in (svref incoming id)
                             for input = (svref (mir-edge-arguments edge) position)
                             always
                             (if (mir-block-dominates-p dominators id source)
                                 (when (mir-induction-add-one-p input index *mir-lir-definitions*)
                                   (setf stepped t))
                                 (when (mir-induction-integer-constant-p input 1 *mir-lir-definitions*)
                                   (setf initial t)))
                             finally (return (and initial stepped))))
              (unless positive (setf positive (make-hash-table :test #'eql)))
              (setf (gethash index positive) t))))))))

(defun mir-lir-plan-reverse-loop (function blocks bound-inputs)
  (when (and *mir-lir-shift-guarded-indices*
             (plusp (hash-table-count *mir-lir-shift-guarded-indices*)))
    (multiple-value-bind (reachable dominators) (mir-cached-control-flow function)
      (let ((incoming (mir-lir-loop-predecessors function blocks reachable))
            (instructions (mir-function-instructions function)))
        (loop for block across blocks for header = (mir-block-id block)
              for policy = (mir-terminator-policy (mir-block-terminator block))
              when (and (hir-policy-optimize-p policy)
                        (< (hir-policy-quality policy :debug) 2)
                        (< (hir-policy-quality policy :space) (hir-policy-quality policy :speed))
                        (some (lambda (parameter) (gethash parameter *mir-lir-shift-guarded-indices*))
                              (mir-block-parameters block)))
                do (multiple-value-bind (members entry) (mir-lir-natural-loop header incoming dominators)
                     (let ((cost (and members
                                      (mir-lir-copyable-loop-cost blocks instructions members (car entry)))))
                       (when cost
                         (multiple-value-bind (bound value)
                             (mir-lir-reverse-loop-bound block instructions (svref bound-inputs header)
                                                         (car entry) members dominators)
                           (when bound (return (values members (cdr entry) bound value cost))))))))))))

(defun mir-lir-reverse-swap-test (blocks instructions members header bound)
  (let* ((term (mir-block-terminator (svref blocks header)))
         (parameters (mir-block-parameters (svref blocks header)))
         (definitions *mir-lir-definitions*)
         (relation (and (= (mir-terminator-kind term) 1)
                        (mir-shift-guard-relation term definitions)))
         (z (car bound))
         (array (cdr bound))
         (index (and (= (length parameters) 1) (svref parameters 0))))
    (when (and relation index (= (cdr relation) z)
               (mir-induction-add-one-p (car relation) index definitions)
               (logbitp (mir-edge-target (svref (mir-terminator-edges term) 0)) members)
               (not (logbitp (mir-edge-target (svref (mir-terminator-edges term) 1)) members))
               (eq (second (svref *mir-lir-types* array)) 'fixnum))
      (let* ((test (mir-primary-origin (svref (mir-terminator-operands term) 0) definitions))
             (comparison (svref definitions test))
             (increment (svref definitions (car relation)))
             (reads nil) (writes nil))
        (unless (and (mir-lir-fixnum-call-p comparison)
                     (mir-lir-fixnum-call-p increment)
                     (mir-lir-fixnum-call-p
                      (svref definitions
                             (mir-primary-origin
                              (svref (mir-instruction-operands comparison) 1) definitions))))
          (return-from mir-lir-reverse-swap-test nil))
        (loop for block across blocks
              for id = (mir-block-id block)
              when (logbitp id members)
                do (unless (or (= id header) (= (mir-terminator-kind (mir-block-terminator block)) 0))
                     (return-from mir-lir-reverse-swap-test nil))
                   (loop for inst-id across (hir-buffer-view (mir-block-instructions block))
                         for inst = (mir-at instructions inst-id)
                         for kind = (mir-instruction-kind inst)
                         for result = (mir-instruction-result inst)
                         for access = (gethash result *mir-lir-array-sources*)
                         do (cond ((member kind '(0 9 10)))
                                  ((and (= kind 11)
                                        (or (mir-check-proven-p inst *mir-lir-types*)
                                            ;; The guarded index is at most half of a fixnum.
                                            (and (eq (mir-instruction-data inst) 'fixnum)
                                                 (= (car relation)
                                                    (mir-primary-origin
                                                     (svref (mir-instruction-operands inst) 0)
                                                     definitions))))))
                                  ((or (eq inst comparison) (eq inst increment)))
                                  ((and (= id header) (= kind 6) (eq (mir-instruction-data inst) '-)
                                        (mir-lir-fixnum-call-p inst)
                                        (eql z (mir-lir-reverse-index-upper-bound result result))))
                                  ((and (= id header) access (eql array (first access)))
                                   (case (mir-lir-container-call inst)
                                     (:specialized-array-read
                                      (when writes (return-from mir-lir-reverse-swap-test nil))
                                      (push (cons (second access) result) reads))
                                     (:specialized-array-write
                                      (push (cons (second access)
                                                  (mir-primary-origin
                                                   (svref (mir-instruction-operands inst) 0) definitions))
                                            writes))
                                     (otherwise (return-from mir-lir-reverse-swap-test nil))))
                                  (t (return-from mir-lir-reverse-swap-test nil)))))
        (when (and (= (length reads) 2) (= (length writes) 2)
                   (let ((i (assoc index reads))
                         (k (find-if (lambda (read)
                                       (and (/= index (car read))
                                            (eql z (mir-lir-reverse-index-upper-bound (car read) (cdr read)))))
                                     reads)))
                     (and i k (equal (cdr k) (cdr (assoc index writes)))
                          (equal (cdr i) (cdr (assoc (car k) writes))))))
          ;; An omitted iteration must not change any value read outside the loop.
          (flet ((local-p (value)
                   (logbitp (mir-value-block (svref *mir-lir-value-owners* value)) members)))
            (when (loop for block across blocks
                        for local = (logbitp (mir-block-id block) members)
                        for tail = (mir-block-terminator block)
                        always (and (or local
                                        (and (notany #'local-p (mir-terminator-operands tail))
                                             (loop for id across (hir-buffer-view (mir-block-instructions block))
                                                   never (some #'local-p
                                                               (mir-instruction-operands (mir-at instructions id))))))
                                    (loop for edge across (mir-terminator-edges tail)
                                          always (or (and local (logbitp (mir-edge-target edge) members))
                                                     (notany #'local-p (mir-edge-arguments edge))))))
              test)))))))

(defun mir-lir-early-reverse-guard (function blocks entry bound value polls)
  "Locate a redundant initial comparison and the blocks it can bypass."
  (block plan
    (let* ((header (mir-edge-target entry))
           (parameters (mir-block-parameters (svref blocks header)))
           (upper (car bound))
           (definitions *mir-lir-definitions*)
           (instructions (mir-function-instructions function)))
      (unless (and (= (length parameters) 1)
                   (eq (mir-value-representation (svref *mir-lir-value-owners* (svref parameters 0))) :obj)
                   (mir-induction-integer-constant-p
                    (svref (mir-edge-arguments entry) 0) 0 definitions))
        (return-from plan nil))
      (multiple-value-bind (reachable dominators) (mir-cached-control-flow function)
        (let* ((incoming (mir-lir-loop-predecessors function blocks reachable))
               (source (car (rassoc entry (svref incoming header) :test #'eq)))
               (path 0)
               (skipped-values 0)
               (guard
                 (when source
                   (loop repeat 5
                       for block = (svref blocks source)
                       for term = (mir-block-terminator block)
                       for kind = (mir-terminator-kind term)
                       for relation = (and (= kind 1) (mir-shift-guard-relation term definitions))
                       do (when (or (zerop source) (logbitp source polls) (logbitp source path))
                            (return-from plan nil))
                          (setf path (logior path (ash 1 source)))
                          (loop for id across (hir-buffer-view (mir-block-instructions block))
                                for inst = (mir-at instructions id)
                                for result = (mir-instruction-result inst)
                                unless (and result
                                            (or (member (mir-instruction-kind inst) '(0 9 10))
                                                (and (= (mir-instruction-kind inst) 11)
                                                     (mir-check-proven-p inst *mir-lir-types*))
                                                (and relation (= (mir-instruction-kind inst) 6)
                                                     (= result (mir-primary-origin
                                                                (svref (mir-terminator-operands term) 0)
                                                                definitions))
                                                     (not (mir-instruction-notinline inst)))))
                                  do (return-from plan nil)
                                do (setf skipped-values (logior skipped-values (ash 1 result))))
                          (cond ((and relation (= (cdr relation) upper)
                                      (eq entry (svref (mir-terminator-edges term) 0))
                                      (mir-induction-integer-constant-p (car relation) 0 definitions))
                                 (return source))
                                ((and (= kind 0) (zerop (length (mir-block-parameters block)))
                                      (consp (svref incoming source)) (null (cdr (svref incoming source))))
                                 (setf entry (cdar (svref incoming source))
                                       source (caar (svref incoming source))))
                                (t (return-from plan nil)))))))
          ;; The array storage and the fixnum operand must already exist.
          ;; Skipping the path must not leave a use outside it uninitialized.
          (when (and guard
                     (loop for id in (list value (cdr bound))
                           for owner = (mir-value-block (svref *mir-lir-value-owners* id))
                           always (and (/= owner guard)
                                       (mir-block-dominates-p dominators owner guard)))
                     (loop for block across blocks for id = (mir-block-id block)
                           always (or (logbitp id path)
                                      (and (loop for index across (hir-buffer-view (mir-block-instructions block))
                                               always (notany (lambda (id) (logbitp id skipped-values))
                                                              (mir-instruction-operands (mir-at instructions index))))
                                         (let ((term (mir-block-terminator block)))
                                           (and (notany (lambda (id) (logbitp id skipped-values))
                                                        (mir-terminator-operands term))
                                                (loop for edge across (mir-terminator-edges term)
                                                      always (notany (lambda (id) (logbitp id skipped-values))
                                                                     (mir-edge-arguments edge)))))))))
            (values guard path)))))))

(defun mir-lir-copy-loop-header-p (block instructions bounds)
  (let ((policy (mir-terminator-policy (mir-block-terminator block)))
        (parameters (mir-block-parameters block)))
    (when (and (plusp (length parameters)) bounds (hir-policy-optimize-p policy)
               (< (hir-policy-quality policy :debug) 2)
               (< (hir-policy-quality policy :space) (hir-policy-quality policy :speed)))
      (flet ((checked-access-p (access index)
               (and (gethash (first access) *mir-lir-array-contents*)
                    (mir-lir-array-index-proven-p
                     (first access) (third access) nil (gethash index bounds)))))
        (loop for id across (hir-buffer-view (mir-block-instructions block))
              for store = (mir-at instructions id)
              for dest = (gethash (mir-instruction-result store) *mir-lir-array-sources*)
              thereis
              (and dest (equal (mir-instruction-data store) '(setf aref))
                   (let* ((value (mir-primary-origin (svref (mir-instruction-operands store) 0)
                                                     *mir-lir-definitions*))
                          (origin (gethash value *mir-lir-array-sources*))
                          (load (svref *mir-lir-definitions* value))
                          (index (and origin (second origin))))
                     (and origin load (eq (mir-instruction-data load) 'aref)
                          (find index parameters)
                          (or (= index (second dest))
                              (eql index (mir-lir-previous-array-index (second dest))))
                          (checked-access-p origin index)
                          (checked-access-p dest index)))))))))

(defun mir-lir-plan-copy-prefixes (function blocks bounds polls reserved)
  (let* ((instructions (mir-function-instructions function))
         (headers (loop for block across blocks for id = (mir-block-id block)
                        when (and (logbitp id polls)
                                  (mir-lir-copy-loop-header-p block instructions (svref bounds id)))
                          collect id)))
    (when headers
      (multiple-value-bind (reachable dominators) (mir-cached-control-flow function)
        (let ((incoming (mir-lir-loop-predecessors function blocks reachable))
              (plans nil))
          (dolist (header headers (nreverse plans))
            (multiple-value-bind (members entry) (mir-lir-natural-loop header incoming dominators)
              (when (and members (<= (logcount members) 3)
                         (zerop (logand members (or reserved 0))))
                (let ((cost (mir-lir-copyable-loop-cost blocks instructions members (car entry))))
                  (when (and cost (<= 1 cost 32))
                    (push (list members (cdr entry) (min 12 (floor 192 cost))) plans)
                    (setf reserved (logior members (or reserved 0))))))
              (when (= (length plans) 2)
                (return (nreverse plans))))))))))

(defun mir-lir-new-loop-labels (labels members)
  (let ((copy (copy-seq labels)))
    (loop for bits = members then (logand bits (1- bits))
          while (plusp bits)
          for id = (1- (integer-length (logand bits (- bits))))
          do (setf (svref copy id) (new-block)))
    copy))

(defun mir-lir-fixnum-result-check (instruction instructions block position)
  (when (and (= (mir-instruction-kind instruction) 6)
             (member (mir-instruction-data instruction) '(+ - * 1+ 1-)))
    ;; An immediately following declaration can share the overflow edge.
    ;; Multi-operand sums can overflow at a prefix but still fit at the end.
    (flet ((following (offset)
             (let ((index (+ position offset)))
               (when (< index (length block))
                 (mir-at instructions (svref block index))))))
      (let ((next (following 1))
            (result (mir-instruction-result instruction)))
        (when (and next (= (mir-instruction-kind next) 10)
                   (eql result (svref (mir-instruction-operands next) 0)))
          (setf result (mir-instruction-result next)
                next (following 2)))
        (and next (= (mir-instruction-kind next) 11)
             (eql result (svref (mir-instruction-operands next) 0))
             (cond ((and (zerop (hir-policy-quality (mir-instruction-policy next) :safety))
                         (zerop (hir-policy-quality (mir-instruction-policy instruction) :safety))
                         (hir-fixnum-type-p (hir-declaration-type (mir-instruction-data next))))
                    :unchecked)
                   ((and (plusp (hir-policy-quality (mir-instruction-policy next) :safety))
                         (eq (mir-instruction-data next) 'fixnum)
                         (<= (length (mir-instruction-operands instruction)) 2)
                         (mir-lir-fixnum-call-p instruction))
                    next)))))))

(defun mir-lir-double-call-follows-p (instructions block position)
  ;; Look past at most one primary-value projection in the same block.
  (loop for index from (1+ position) below (min (length block) (+ position 3))
        for instruction = (mir-at instructions (svref block index))
        unless (= (mir-instruction-kind instruction) 10)
          return (and (mir-lir-double-call-p instruction)
                      (case (mir-instruction-data instruction)
                        ((+ * / 1+ 1-) t)
                        (- (> (length (mir-instruction-operands instruction)) 1))))))

(defun mir-lir-following-reciprocal (conversion instructions block position)
  (when (and *mir-lir-in-loop*
             (mir-lir-double-conversion-p conversion)
             (< (+ position 2) (length block)))
    (let* ((result (mir-instruction-result conversion))
           (primary (mir-at instructions (svref block (1+ position))))
           (consumer (mir-at instructions (svref block (+ position 2))))
           (ops (mir-instruction-operands consumer))
           (type (svref *mir-lir-types* (svref (mir-instruction-operands conversion) 0))))
      (when (and (not (svref *mir-lir-boxed* result))
                 (= (mir-instruction-kind primary) 10)
                 (eql (svref (mir-instruction-operands primary) 0) result)
                 (eq (mir-instruction-data consumer) '/)
                 (= (length ops) 1)
                 (eql (svref ops 0) (mir-instruction-result primary))
                 (mir-lir-double-call-p consumer)
                 (hir-fixnum-type-p type)
                 (hir-range-p type)
                 (or (plusp (second type)) (minusp (third type)))
                 (or (< (second type) (- (ash 1 53))) (> (third type) (ash 1 53))))
        consumer))))

(defun mir-lir-guarded-double-chain-storage (conversion instructions block position)
  (when (and (= (mir-instruction-kind conversion) 6)
             (eq (mir-instruction-data conversion) 'float)
             *mir-lir-in-loop*
             *mir-lir-array-contents*
             (< (+ position 12) (length block)))
    (flet ((at (offset) (mir-at instructions (svref block (+ position offset))))
           (raw (instruction)
             (let ((id (mir-instruction-result instruction)))
               (and id (not (svref *mir-lir-boxed* id)) (svref *mir-lir-doubles* id))))
           (result (instruction) (mir-instruction-result instruction))
           (operand (instruction position) (svref (mir-instruction-operands instruction) position)))
      (let ((reciprocal (mir-lir-following-reciprocal conversion instructions block position))
            (first-load (at 6)) (multiply (at 8)) (last-load (at 10)) (sum (at 12)))
        (when (and reciprocal (raw conversion) (raw reciprocal)
                   (loop for offset in '(1 3 7 9 11)
                         for projection = (at offset)
                         always (and (= (mir-instruction-kind projection) 10)
                                     (raw projection)
                                     (eql (operand projection 0) (result (at (1- offset))))))
                   (loop for offset in '(4 5)
                         for check = (at offset)
                         for source = (and (mir-check-proven-p check *mir-lir-types*)
                                           (operand check 0))
                         always (and source
                                     (eq (mir-value-representation
                                          (svref *mir-lir-value-owners* source)) :obj)
                                     (loop for earlier from 0 below offset
                                           never (eql source (result (at earlier))))))
                   (loop for offset from 0 to 12
                         never (gethash (result (at offset)) *mir-lir-array-contents*))
                   (every (lambda (op) (and (eq (mir-instruction-data op) 'aref) (raw op)))
                          (list first-load last-load))
                   (mir-lir-double-call-p multiply) (eq (mir-instruction-data multiply) '*) (raw multiply)
                   (mir-lir-double-call-p sum) (eq (mir-instruction-data sum) '+) (raw sum)
                   (= (length (mir-instruction-operands multiply)) 2)
                   (= (length (mir-instruction-operands sum)) 2)
                   (eql (operand multiply 0) (result (at 3)))
                   (eql (operand multiply 1) (result (at 7)))
                   (eql (operand sum 0) (result (at 11)))
                   (eql (operand sum 1) (result (at 9))))
          (multiple-value-bind (first-access first-storage) (mir-lir-array-access-plan first-load)
            (multiple-value-bind (last-access last-storage) (mir-lir-array-access-plan last-load)
              (when (and first-access (car first-storage) (cdr first-storage) last-access (car last-storage)
                         (eql (result (at 4)) (operand first-load 0))
                         (eql (result (at 5)) (operand first-load 1))
                         (hir-fixnum-type-p (svref *mir-lir-types* (operand first-load 1)))
                         (mir-lir-direct-array-index-p
                          (first last-access) (third last-access) (second last-access)
                          (mir-lir-reverse-index-upper-bound (second last-access) (result last-load))
                          (svref *mir-lir-types* (operand last-load 1))))
                (values first-storage last-access)))))))))

(defun mir-lir-emit-guarded-double-chain (conversion instructions block position arguments count)
  (let ((first-storage (mir-lir-guarded-double-chain-storage conversion instructions block position)))
    (when first-storage
      (flet ((at (offset) (mir-at instructions (svref block (+ position offset))))
             (raw (instruction) (svref *mir-lir-doubles* (mir-instruction-result instruction))))
        (let* ((first-load (mir-at instructions (svref block (+ position 6))))
              (reciprocal (mir-at instructions (svref block (+ position 2))))
              (multiply (mir-at instructions (svref block (+ position 8))))
              (sum (mir-at instructions (svref block (+ position 12))))
              (index (mir-lir-value (svref (mir-instruction-operands first-load) 1)))
              (input (mir-lir-value (svref (mir-instruction-operands conversion) 0)))
              (mode (mir-lir-float-mode-cache))
              (accumulator (and *mir-lir-accumulator-copy*
                                (eql (mir-instruction-result sum) (first *mir-lir-accumulator-copy*))
                                (second *mir-lir-accumulator-copy*)))
              (fast (new-block))
              (slow (if accumulator (third *mir-lir-accumulator-copy*) (new-block t)))
              (done (new-block)))
          (mir-lir-instruction (at 4) arguments count)
          (mir-lir-instruction (at 5) arguments count)
          ;; The default reciprocal is finite and cannot signal. A
          ;; failed bounds guard must still replay it before AREF.
          (br `(:or ,mode (:fixnum-uge ,index ,(cdr first-storage))) slow fast)
          (start-block fast)
          (mir-lir-vector-access (car first-storage) index nil t (raw first-load))
          (emit `(:set ,(raw conversion) (:f64-from-signed (:fixnum-untag ,input))))
          (mir-lir-instruction (at 1) arguments count)
          (emit `(:set ,(raw reciprocal) (:f64-div #x3ff0000000000000 ,(raw conversion))))
          (dolist (i '(3 7)) (mir-lir-instruction (at i) arguments count))
          (emit `(:set ,(raw multiply) (:f64-mul ,(raw (at 3)) ,(raw (at 7)))))
          (mir-lir-instruction (at 9) arguments count)
          (if accumulator
              (kiln.kir::emit-lir-assignment (raw (at 10)) accumulator)
              (mir-lir-instruction (at 10) arguments count))
          (mir-lir-instruction (at 11) arguments count)
          (emit `(:set ,(raw sum) (:f64-add ,(raw (at 11)) ,(raw (at 9)))))
          ;; Addition cannot hide a nonfinite product.
          (br (mir-lir-nonfinite-test :double (raw sum)) slow done)
          (unless accumulator
            (start-block slow)
            (dolist (i '(0 1 2 3 6 7 8 9 10 11 12))
              (mir-lir-instruction (at i) arguments count))
            (jump done))
          (start-block done)
          t)))))

(defun mir-lir-find-accumulator-site (function bounds)
  (let ((instructions (mir-function-instructions function)))
    (loop for block across (hir-buffer-view (mir-function-blocks function))
          for id = (mir-block-id block)
          for input = (svref bounds id)
          when input do
            (let ((*mir-lir-in-loop* t)
                  (*mir-lir-inherited-index-bounds* input)
                  (body (hir-buffer-view (mir-block-instructions block))))
              (loop for position below (- (length body) 14)
                    for conversion = (mir-at instructions (svref body position))
                    when (eq (mir-instruction-data conversion) 'float)
                      do (multiple-value-bind (storage access)
                             (mir-lir-guarded-double-chain-storage conversion instructions body position)
                           (when storage
                             (let* ((sum (mir-at instructions (svref body (+ position 12))))
                                    (primary (mir-at instructions (svref body (+ position 13))))
                                    (store (mir-at instructions (svref body (+ position 14))))
                                    (write (gethash (mir-instruction-result store) *mir-lir-array-sources*)))
                               (when (and (equal (mir-instruction-data store) '(setf aref))
                                          (equal write access)
                                          (second access)
                                          (not (minusp (second access)))
                                          (not (svref *mir-lir-live* (mir-instruction-result store)))
                                          (= (mir-instruction-kind primary) 10)
                                          (eql (svref (mir-instruction-operands primary) 0)
                                               (mir-instruction-result sum))
                                          (eql (svref (mir-instruction-operands store) 0)
                                               (mir-instruction-result primary)))
                                 (return-from mir-lir-find-accumulator-site
                                   (values id access storage (mir-instruction-result sum)
                                           (mir-instruction-result store))))))))))))

(defun mir-lir-plan-accumulator-copy (function blocks bounds polls)
  (multiple-value-bind (site access input sum store)
      (mir-lir-find-accumulator-site function bounds)
    (when site
      (multiple-value-bind (reachable dominators) (mir-cached-control-flow function)
        (let ((incoming (mir-lir-loop-predecessors function blocks reachable))
              (instructions (mir-function-instructions function))
              (bindings (mir-binding-analysis-inputs (mir-binding-regions function))))
          (destructuring-bind (source index limit) access
            (loop for block across blocks for header = (mir-block-id block)
                  for policy = (mir-terminator-policy (mir-block-terminator block))
                  for facts = (svref bounds header)
                  when (and (logbitp header polls) (null (svref bindings header))
                            (hir-policy-optimize-p policy)
                            (< (hir-policy-quality policy :debug) 2)
                            (<= (hir-policy-quality policy :space)
                                (hir-policy-quality policy :speed))
                            (hir-fixnum-type-p (svref *mir-lir-types* index))
                            (mir-lir-array-index-proven-p
                             source limit (svref *mir-lir-types* index)
                             (and facts (gethash index facts))))
                    do (multiple-value-bind (members entry)
                           (mir-lir-natural-loop header incoming dominators)
                         (when (and members (logbitp site members)
                                    (mir-lir-copyable-loop-cost blocks instructions members (car entry))
                                    (mir-lir-accumulator-copy-operations-p blocks instructions members)
                                    (loop for value in (list source index)
                                          for owner = (mir-value-block (svref *mir-lir-value-owners* value))
                                          always (and (not (logbitp owner members))
                                                      (mir-block-dominates-p dominators owner (car entry)))))
                           (let ((exits
                                   (loop for member across blocks
                                         when (logbitp (mir-block-id member) members)
                                           append (loop for edge across (mir-terminator-edges (mir-block-terminator member))
                                                        unless (logbitp (mir-edge-target edge) members)
                                                          collect edge))))
                             (when (and (consp exits) (null (cdr exits)))
                               (return (list members (cdr entry) (car exits) source index input sum store)))))))))))))

(defun mir-lir-accumulator-copy-operations-p (blocks instructions members)
  ;; The guarded chain accounts for both reads and the only write. Other
  ;; accesses could see deferred writes through an alias.
  (loop with reads = 0 with writes = 0
        for block across blocks
        when (logbitp (mir-block-id block) members)
          do (loop for id across (hir-buffer-view (mir-block-instructions block))
                   for instruction = (mir-at instructions id)
                   for kind = (mir-instruction-kind instruction)
                   for op = (mir-instruction-data instruction)
                   unless (and (< (hir-policy-quality (mir-instruction-policy instruction) :debug) 2)
                               (or (member kind '(0 9 10 11))
                                   (and (= kind 6)
                                        (cond ((eq op 'aref) (<= (incf reads) 2))
                                              ((equal op '(setf aref)) (= (incf writes) 1))
                                              (t (member op '(+ - * / 1+ 1- truncate float < <= > >=)))))))
                     do (return-from mir-lir-accumulator-copy-operations-p nil))
        finally (return (and (= reads 2) (= writes 1)))))

(defun mir-lir-accumulator-copy-safe-p (blocks header backedge accumulator bailout exit)
  ;; The first pass through a row may exit before doing any work. A
  ;; backedge must complete one update, and a bailout must precede it.
  (let ((names (make-hash-table :test #'eq))
        (active (make-hash-table :test #'eq))
        (complete (make-hash-table :test #'eq)))
    (dolist (block blocks)
      (setf (gethash (bname block) names) block))
    (labels ((visit (label updated)
               (cond ((eq label (bname backedge)) updated)
                     ((eq label (bname bailout)) (not updated))
                     ((eq label (bname exit)) (not updated))
                     (t (visit-block (gethash label names) updated))))
             (visit-block (block updated)
               (when (and block (not (gethash block active)))
                 (let ((flag (if updated 2 1)))
                   (when (logtest flag (gethash block complete 0))
                     (return-from visit-block t))
                   (setf (gethash block active) t)
                   (loop for statement in (reverse (kiln.kir::kblock-stmts block))
                         for op = (first statement)
                         unless (member op '(:set :lir-set :fixnum-add-ovf :fixnum-sub-ovf
                                              :fixnum-mul-ovf :special-ref :br :jump))
                           do (return-from visit-block nil)
                         when (and (member op '(:set :lir-set)) (eq (second statement) accumulator))
                           do (when updated (return-from visit-block nil)) (setf updated t))
                   (let* ((term (first (kiln.kir::kblock-stmts block)))
                          (safe (case (first term)
                                  (:jump (visit (second term) updated))
                                  (:br (and (visit (third term) updated)
                                            (visit (fourth term) updated))))))
                     (remhash block active)
                     (when safe
                       (setf (gethash block complete) (logior flag (gethash block complete 0))))
                     safe)))))
      (visit-block header nil))))

(defun mir-lir-emit-double-multiply-add (mul instructions block position arguments count)
  (when (and *mir-lir-in-loop*
             (eq (mir-instruction-data mul) '*)
             (= (length (mir-instruction-operands mul)) 2)
             (mir-lir-double-call-p mul)
             (< (+ position 4) (length block)))
    (flet ((at (offset) (mir-at instructions (svref block (+ position offset))))
           (raw-only (instruction)
             (let ((id (mir-instruction-result instruction)))
               (and id (not (svref *mir-lir-boxed* id)) (svref *mir-lir-doubles* id))))
           (projects (primary definition)
             (and (= (mir-instruction-kind primary) 10)
                  (eql (svref (mir-instruction-operands primary) 0)
                       (mir-instruction-result definition)))))
      (let* ((product (at 1)) (load (at 2)) (element (at 3)) (add (at 4))
             (mul-args (mir-instruction-operands mul))
             (add-args (mir-instruction-operands add)))
        (when (and (raw-only mul)
                   (projects product mul) (raw-only product)
                   (eq (mir-instruction-data load) 'aref)
                   (projects element load) (raw-only load) (raw-only element)
                   (eq (mir-instruction-data add) '+) (= (length add-args) 2)
                   (mir-lir-double-call-p add) (raw-only add)
                   (eql (svref add-args 0) (mir-instruction-result element))
                   (eql (svref add-args 1) (mir-instruction-result product)))
          (multiple-value-bind (access storage) (mir-lir-array-access-plan load)
            (when (and (car storage)
                       (mir-lir-direct-array-index-p
                        (first access) (third access) (second access)
                        (mir-lir-reverse-index-upper-bound (second access)
                                                           (mir-instruction-result load))
                        (svref *mir-lir-types* (svref (mir-instruction-operands load) 1))))
              (let ((mode (mir-lir-float-mode-cache))
                    (fast (new-block)) (slow (new-block t)) (done (new-block)))
                (br mode slow fast)
                (start-block fast)
                (emit `(:set ,(raw-only mul)
                             (:f64-mul ,(mir-lir-double-bits (svref mul-args 0))
                                       ,(mir-lir-double-bits (svref mul-args 1)))))
                (dolist (instruction (list product load element))
                  (mir-lir-instruction instruction arguments count))
                (let ((sum (raw-only add)))
                  (emit `(:set ,sum (:f64-add ,(raw-only element) ,(raw-only product))))
                  ;; Adding a nonfinite product cannot produce a finite sum.
                  (br (mir-lir-nonfinite-test :double sum) slow done))
                (start-block slow)
                (dolist (instruction (list mul product load element add))
                  (mir-lir-instruction instruction arguments count))
                (jump done)
                (start-block done)
                t))))))))

(defun mir-lir-function-body (function &optional unit)
  (setf (kiln.kir::kfunc-direct-regions-p kiln.kir::*func*) t)
  (let* ((*mir-lir-debug-bindings* (make-array (length (mir-function-bindings function)) :initial-element nil))
         (*mir-lir-condition-source* nil) (*mir-lir-condition-word* nil)
         (*mir-lir-condition-inverted* nil)
         (*mir-lir-debug-cells* (mir-function-binding-cells function))
         (*regions* *regions*)
         (*mir-lir-stack-regions* nil) (*mir-lir-rest-slots* nil)
         (*mir-lir-bindings*
           (map 'simple-vector
                (lambda (instruction)
                  (let ((kind (case (mir-instruction-kind instruction) (29 :progv) (30 :catch) (32 :unwind-protect) ((34 35) :exit-point) (otherwise :bind))))
                    (make-region :kind kind :slot (new-slot (list :dynamic-entry kind))
                                 :handler (and (member kind '(:catch :unwind-protect :exit-point)) (new-block)))))
                (mir-binding-analysis-entries (mir-binding-regions function))))
         (*mir-lir-stack-slots* (make-array (hir-buffer-count (mir-function-instructions function)) :initial-element nil))
         (local-only (mir-local-analysis-only-p unit function))
         (type-unit (unless local-only unit))
         (*mir-lir-types* (mir-infer-types function type-unit))
         (*mir-lir-known-functions*
           (when type-unit
             (svref (mir-function-flow-identities (mir-infer-function-flow type-unit))
                    (mir-function-id function))))
         (*mir-lir-definitions* (mir-value-definitions function))
         (*mir-lir-value-owners* (hir-buffer-view (mir-function-values function)))
         (*mir-lir-shift-guarded-indices* nil)
         (*mir-lir-positive-indices* nil)
         (*mir-lir-versioned-bound* nil)
         (*mir-lir-reverse-swap-test* nil)
         (*mir-lir-value-facts* (mir-infer-value-facts function type-unit))
         (recursive-private-entry
           (and unit (plusp (mir-function-internal-prefix function))
                (let* ((id (mir-function-id function))
                       (flow (mir-infer-function-flow unit)))
                  (member id (svref (mir-function-flow-outgoing flow) id)))))
         (storage (when (and unit (mir-storage-candidate-p function))
                    (if (and local-only (notany (lambda (instruction) (= (mir-instruction-kind instruction) 19))
                                  (hir-buffer-view (mir-function-instructions function))))
                        (mir-compute-storage function *mir-lir-types* *mir-lir-value-facts*
                                             :functions *mir-lir-functions*)
                        (svref (mir-infer-storage unit) (mir-function-id function)))))
         (*mir-lir-carriers* (mir-bundle-carriers function))
         (*mir-lir-bundle-demand* (mir-bundle-plan-demand (mir-bundle-plan function)))
         (predecessors (mir-lir-predecessor-index function))
         (mask-candidates nil)
         (*mir-lir-live*
           (multiple-value-bind (live masks) (mir-lir-live-values function predecessors)
             (setf mask-candidates masks)
             live))
         (*mir-lir-masked-arithmetic* (mir-lir-masked-arithmetic-plan function mask-candidates))
         (*mir-lir-single-scalars* (mir-lir-plan-single-scalars function))
         (*mir-lir-doubles* nil) (*mir-lir-boxed* nil)
         (*mir-lir-array-contents* nil)
         (*mir-lir-array-sources* nil)
         (*mir-lir-values*
           (let* ((values (hir-buffer-view (mir-function-values function)))
