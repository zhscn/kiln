(in-package #:kiln.compiler)

(defvar *mir-lir-values*)
(defvar *mir-lir-doubles*)
(defvar *mir-lir-boxed*)
(defvar *mir-lir-live*)
(defvar *mir-lir-labels*)
(defvar *mir-lir-functions*)
(defvar *mir-lir-types*)
(defvar *mir-lir-value-facts*)
(defvar *mir-lir-stack-slots*)
(defvar *mir-lir-stack-regions*)
(defvar *mir-lir-rest-slots*)

(defun mir-lir-value (id) (svref *mir-lir-values* id))

(defun mir-lir-single-p (id)
  (let ((fact (svref *mir-lir-value-facts* id)))
    (and (mir-values-fact-p fact) (eql 1 (mir-values-fact-count fact)))))

(defun mir-lir-save (id primary count)
  (let ((target (mir-lir-value id)))
    (if (mir-lir-single-p id)
        (progn (emit `(:set ,(car target) ,primary)) (emit `(:set ,(cdr target) 1)))
        (progn (emit `(:save-values ,(car target) ,primary ,count ,(handler)))
               (emit `(:set ,(cdr target) ,count))))))

(defun mir-lir-restore (id)
  (let ((value (mir-lir-value id)))
    (if (mir-lir-single-p id) (values (car value) 1)
        (emit-restore-values (car value) (cdr value)))))

(defun mir-lir-check (value type)
  (unless (or (zerop (hir-policy-quality *hir-policy* :safety)) (eq (hir-declaration-expanded type) t))
    (let ((bad (new-block)) (done (new-block)))
      (br `(:eq ,(emit-slow-call 'typep value (constant-object (hir-declaration-expanded type))) ,(nil-value)) bad done)
      (start-block bad)
      (emit-slow-call 'kiln.kernel::%declared-type-error value (constant-object (hir-declaration-original type)))
      (jump done) (start-block done))))

(defun mir-lir-container-call (instruction)
  (when (and (= (mir-instruction-kind instruction) 6)
             (hir-policy-optimize-p (mir-instruction-policy instruction))
             (not (mir-instruction-notinline instruction)))
    (let* ((name (mir-instruction-data instruction)) (operands (mir-instruction-operands instruction))
           (count (length operands))
           (store (and (= count 3) (member name '((setf aref) (setf svref) (setf elt) (setf char) (setf schar)) :test #'equal)))
           (type (and (plusp count) (svref *mir-lir-types* (svref operands (if store 1 0))))))
      (cond ((and (= count 1) (eq name 'length) (member type '(simple-vector :native-string))) :length)
            ((and (= count 2) (member name '(aref svref elt)) (eq type 'simple-vector)) :vector-read)
            ((and store (member name '((setf aref) (setf svref) (setf elt)) :test #'equal)
                  (eq type 'simple-vector)) :vector-write)
            ((and (= count 2) (member name '(aref char schar elt)) (eq type :native-string)) :string-read)
            ((and store (member name '((setf aref) (setf char) (setf schar) (setf elt)) :test #'equal)
                  (eq type :native-string)) :string-write)
            ((and (= count 2) (eq name 'elt) (eq type :simple-array-vector)) :array-read)
            ((and store (equal name '(setf elt)) (eq type :simple-array-vector)) :array-write)))))

(defun mir-lir-container-value (operation name args)
  (let* ((store (member operation '(:vector-write :string-write :array-write)))
         (object (if store (second args) (first args)))
         (index (if store (third args) (second args))) (value (and store (first args))))
    (case operation
      (:length (copy-to-var (vector-length object)))
      ((:vector-read :vector-write)
       (emit-svref-fast-path
        object index
        (lambda () (if store
                       (progn (emit `(:vector-set ,object (:fixnum-untag ,index) ,value)) value)
                       `(:vector-ref ,object (:fixnum-untag ,index))))
        (lambda () (if store (emit-slow-call name value object index)
                       (emit-slow-call name object index))) t))
      ((:string-read :string-write) (emit-schar object index value name t))
      ((:array-read :array-write) (emit-aref-1 object index value)))))

(defun mir-lir-fixnum-call-p (instruction)
  (let ((name (mir-instruction-data instruction))
        (operands (mir-instruction-operands instruction)))
    (and (= (mir-instruction-kind instruction) 6)
         (hir-policy-optimize-p (mir-instruction-policy instruction))
         (not (mir-instruction-notinline instruction))
         (or (and (= (length operands) 2)
                  (member name '(+ - * logand logior logxor < > <= >= = /=)))
             (and (= (length operands) 1) (member name '(1+ 1- zerop plusp minusp))))
         (every (lambda (id) (hir-fixnum-type-p (svref *mir-lir-types* id))) operands))))

(defun mir-lir-fixnum-call (instruction args)
  (let* ((name (mir-instruction-data instruction)) (left (first args)) (right (second args))
         (bounded (hir-fixnum-type-p (svref *mir-lir-types* (mir-instruction-result instruction)))))
    (cond ((member name '(+ - *)) (emit-fixnum-arithmetic name left right bounded))
          ((member name '(1+ 1-))
           (emit-fixnum-arithmetic (if (eq name '1+) '+ '-) left '(:fixnum-tag 1) bounded))
          ((member name '(logand logior logxor))
           (copy-to-var `(,(ecase name (logand :and) (logior :or) (logxor :xor)) ,left ,right)))
          (t (boolean-value `(,(ecase name ((< minusp) :lt) ((> plusp) :gt) (<= :le) (>= :ge) ((= zerop) :eq) (/= :ne))
                              ,left ,(or right '(:fixnum-tag 0))))))))

(defun mir-lir-double-call-p (instruction)
  "Select numeric operations only with a MIR double-float proof for every operand."
  (let ((name (mir-instruction-data instruction))
        (operands (mir-instruction-operands instruction)))
    (and (= (mir-instruction-kind instruction) 6)
         (hir-policy-optimize-p (mir-instruction-policy instruction))
         (not (mir-instruction-notinline instruction))
         (or (and (= (length operands) 2) (member name '(+ - * / < > <= >= = /=)))
             (and (= (length operands) 1) (member name '(- abs 1+ 1- zerop plusp minusp))))
         (every (lambda (id) (eq (svref *mir-lir-types* id) 'double-float)) operands))))

(defun mir-lir-double-forward-source (instruction)
  (let ((operands (mir-instruction-operands instruction)))
    (when (and (plusp (length operands))
               (or (member (mir-instruction-kind instruction) '(9 10))
                   (and (= (mir-instruction-kind instruction) 14) (zerop (mir-instruction-data instruction)))
                   (and (= (mir-instruction-kind instruction) 11)
                        (mir-check-proven-p instruction *mir-lir-types*))))
      (svref operands 0))))

(defun mir-lir-live-values (function)
  "Drop unused copy chains and block arguments before choosing representations."
  (let ((live (make-array (hir-buffer-count (mir-function-values function)) :initial-element nil))
        (instructions (hir-vector (mir-function-instructions function)))
        (blocks (hir-vector (mir-function-blocks function))))
    (labels ((mark (id) (unless (svref live id) (setf (svref live id) t))))
      (loop for instruction across instructions
            unless (mir-lir-double-forward-source instruction)
              do (map nil #'mark (mir-instruction-operands instruction)))
      (loop for block across blocks
            do (map nil #'mark (mir-terminator-operands (mir-block-terminator block))))
      (loop with changed = t while changed
            do (setf changed nil)
               (loop for instruction across instructions
                     for source = (mir-lir-double-forward-source instruction)
                     for result = (mir-instruction-result instruction)
                     when (and source result (svref live result) (mark source)) do (setf changed t))
               (loop for block across blocks
                     do (loop for edge across (mir-terminator-edges (mir-block-terminator block))
                              for parameters = (mir-block-parameters (mir-at (mir-function-blocks function) (mir-edge-target edge)))
                              do (loop for source across (mir-edge-arguments edge) for target across parameters
                                       when (and (svref live target) (mark source)) do (setf changed t))))))
    live))

(defun mir-lir-double-plan (function)
  "Keep raw SSA doubles and request boxed companions only at object uses."
  (let* ((values (hir-vector (mir-function-values function)))
         (doubles (make-array (length values) :initial-element nil))
         (boxed (make-array (length values) :initial-element nil))
         (instructions (hir-vector (mir-function-instructions function)))
         (blocks (hir-vector (mir-function-blocks function))))
    (when (and (< (hir-policy-quality (mir-function-policy function) :debug) 2)
               (every (lambda (instruction)
                        (and (hir-policy-optimize-p (mir-instruction-policy instruction))
                             (< (hir-policy-quality (mir-instruction-policy instruction) :debug) 2))) instructions))
      (loop for value across values for id = (mir-value-id value)
            when (and (svref *mir-lir-live* id) (eq (svref *mir-lir-types* id) 'double-float)
                      (or (eq (mir-value-representation value) :obj)
                          (and (eq (mir-value-representation value) :bundle) (mir-lir-single-p id))))
              do (setf (svref doubles id) (new-var :f64))))
    (labels ((require-object (id)
               (when (and (svref doubles id) (not (svref boxed id)))
                 (setf (svref boxed id) t)))
             (forward-p (instruction)
               (let ((source (mir-lir-double-forward-source instruction))
                     (result (mir-instruction-result instruction)))
                 (and source result (svref doubles source) (svref doubles result) source))))
      (loop for instruction across instructions
            unless (or (mir-lir-double-call-p instruction) (forward-p instruction)
                       (and (mir-lir-double-forward-source instruction)
                            (not (svref *mir-lir-live* (mir-instruction-result instruction)))))
              do (map nil #'require-object (mir-instruction-operands instruction)))
      (loop for block across blocks
            do (map nil #'require-object (mir-terminator-operands (mir-block-terminator block))))
      ;; Object requirements follow the same copies as raw bits. Iterate for
      ;; loop-carried bindings, including cycles with several block parameters.
      (loop with changed = t while changed
            do (setf changed nil)
               (flet ((propagate (source target)
                        (when (and (svref *mir-lir-live* target)
                                   (or (not (svref doubles target)) (svref boxed target))
                                   (require-object source))
                          (setf changed t))))
                 (loop for instruction across instructions for source = (forward-p instruction)
                       when source do (propagate source (mir-instruction-result instruction)))
                 (loop for block across blocks
                       do (loop for edge across (mir-terminator-edges (mir-block-terminator block))
                                for parameters = (mir-block-parameters (mir-at (mir-function-blocks function) (mir-edge-target edge)))
                                do (loop for source across (mir-edge-arguments edge) for target across parameters
                                         do (propagate source target)))))))
    (values doubles boxed)))

(defun mir-lir-double-bits (id)
  (or (svref *mir-lir-doubles* id)
      (let ((value (mir-lir-value id)))
        (copy-to-var `(:field-load ,kiln.kir::+packet-field-double-bits+ ,(if (consp value) (car value) value)) :f64))))

(defun mir-lir-double-call (name operands)
  (let* ((bits (map 'list #'mir-lir-double-bits operands))
         (left (first bits)) (right (second bits)))
    (when (and right (eq name '/))
      (let ((zero (new-block)) (divide (new-block)))
        (br `(:eq (:and ,right #x7fffffffffffffff) 0) zero divide)
        (start-block zero)
        (emit-error +err-division-by-zero+ (hir-box-double-bits left))
        (jump divide) (start-block divide)))
    (copy-to-var
     (if right
         `(,(ecase name (+ :f64-add) (- :f64-sub) (* :f64-mul) (/ :f64-div)) ,left ,right)
         (ecase name
           (- `(:xor ,left ,(- #x8000000000000000)))
           (abs `(:and ,left #x7fffffffffffffff))
           (1+ `(:f64-add ,left #x3ff0000000000000))
           (1- `(:f64-sub ,left #x3ff0000000000000))))
     :f64)))

(defun mir-lir-instruction (instruction arguments argument-count)
  (let* ((*call-source* (mir-instruction-source instruction)) (*hir-policy* (mir-instruction-policy instruction))
         (kind (mir-instruction-kind instruction)) (result (mir-instruction-result instruction))
         (out (and result (mir-lir-value result))) (data (mir-instruction-data instruction))
         (args (map 'list #'mir-lir-value (mir-instruction-operands instruction))))
    (when (and result (not (svref *mir-lir-live* result))
               (mir-lir-double-forward-source instruction))
      (return-from mir-lir-instruction))
    (let ((operation (mir-lir-container-call instruction)))
      (when operation
        (mir-lir-save result (mir-lir-container-value operation data args) 1)
        (return-from mir-lir-instruction)))
    (when (mir-lir-fixnum-call-p instruction)
      (mir-lir-save result (mir-lir-fixnum-call instruction args) 1)
      (return-from mir-lir-instruction))
    (when (and (mir-lir-double-call-p instruction) (member data '(< > <= >= = /= zerop plusp minusp)))
      (let* ((operands (mir-instruction-operands instruction))
             (left (mir-lir-double-bits (svref operands 0)))
             (unary (= (length operands) 1))
             (right (if unary 0 (mir-lir-double-bits (svref operands 1))))
             ;; Unary predicates compare against integer zero. Keep the
             ;; runtime's mixed-number comparison for non-finite doubles.
             (comparison (copy-to-var
                          (if unary
                              `(:select (:eq (:and ,left #x7ff0000000000000) #x7ff0000000000000)
                                        0 (:f64-compare ,left ,right))
                              `(:f64-compare ,left ,right)) :raw)))
        (mir-lir-save result
                      (boolean-value `(,(ecase data ((< minusp) :lt) ((> plusp) :gt) (<= :le) (>= :ge) ((= zerop) :eq) (/= :ne))
                                       ,comparison 0)) 1))
      (return-from mir-lir-instruction))
    (when (mir-lir-double-call-p instruction)
      (let ((bits (mir-lir-double-call data (mir-instruction-operands instruction)))
            (raw (svref *mir-lir-doubles* result)))
        (when raw (emit `(:set ,raw ,bits)))
        (when (or (not raw) (svref *mir-lir-boxed* result))
          (mir-lir-save result (hir-box-double-bits bits) 1)))
      (return-from mir-lir-instruction))
    (let ((source (mir-lir-double-forward-source instruction)))
      (when (and result source (svref *mir-lir-doubles* result) (svref *mir-lir-doubles* source))
        (emit `(:set ,(svref *mir-lir-doubles* result) ,(svref *mir-lir-doubles* source)))
        (unless (svref *mir-lir-boxed* result) (return-from mir-lir-instruction))))
    (case kind
      (0 (emit `(:set ,out ,(constant-object data))))
      (1 (emit `(:set ,out ,(svref arguments data))))
      (2 (let ((symbol (constant-object data)))
           (emit `(:set ,out ,(emit-symbol-value symbol)))
           (emit-check-bound out symbol)))
      (3 (emit-set-symbol-value (constant-object data) (first args))
         (emit `(:set ,out ,(first args))))
      (4 (emit `(:set ,out ,(function-cell-value data))))
      (5 (let* ((label (svref *mir-lir-labels* data)) (object (kiln.kir::kir-name label "_fobj")))
           (emit `(:set ,out (:object-address ,object :general)))))
      ((6 7)
       (multiple-value-bind (value count)
           (cond ((mir-borrow-call-p instruction)
                  (let ((slot (svref *mir-lir-stack-slots* (mir-instruction-id instruction))))
                    (cond (slot (let ((value (new-var)))
                                  (emit `(:stack-cons ,value (:slot ,slot) ,(first args) ,(second args)))
                                  (values value 1)))
                          ((eq data 'identity) (values (first args) 1))
                          (t (funcall (gethash data *primitives*) args)))))
                 ((= kind 6) (emit-lisp-call (function-cell-value data) args))
                 (t (emit-lisp-call (emit-function-designator (first args)) (rest args))))
         (mir-lir-save result value (or count 1))))
      (15 (let ((acc (nil-value)))
            (loop for index from 1 below (length (mir-instruction-operands instruction))
                  do (multiple-value-bind (primary count)
                         (mir-lir-restore (svref (mir-instruction-operands instruction) index))
                       (setf acc (emit-push-values primary count acc))))
            (multiple-value-bind (primary count)
                (emit-apply (emit-function-designator (first args)) (emit-nreverse acc))
              (mir-lir-save result primary count))))
      (8 (multiple-value-bind (value count) (funcall (gethash data *primops*) args)
           (mir-lir-save result value (or count 1))))
      (9 (mir-lir-save result (first args) 1))
      (10 (multiple-value-bind (value count) (mir-lir-restore (svref (mir-instruction-operands instruction) 0))
            (declare (ignore count)) (emit `(:set ,out ,value))))
      (11 (let ((input (first args)))
            (unless (mir-check-proven-p instruction *mir-lir-types*)
              (if (consp input)
                  (multiple-value-bind (primary count)
                      (mir-lir-restore (svref (mir-instruction-operands instruction) 0))
                    (declare (ignore count))
                    (mir-lir-check primary data))
                  (mir-lir-check input data)))
            ;; The saved carrier is stable across the TYPEP call. Copy it
            ;; rather than relying on the borrowed multiple-value area.
            (if (consp input)
                (progn (emit `(:set ,(car out) ,(car input)))
                       (emit `(:set ,(cdr out) ,(cdr input))))
                (emit `(:set ,out ,input)))))
      (14 (let* ((source (svref (mir-instruction-operands instruction) 0))
                 (fact (svref *mir-lir-value-facts* source))
                 (known-count (and (mir-values-fact-p fact) (mir-values-fact-count fact))))
            (if (or (>= data kiln.kir::+backend-value-limit+)
                    (and known-count (>= data known-count)))
                (emit `(:set ,out ,(nil-value)))
                (multiple-value-bind (primary count) (mir-lir-restore source)
                  (emit `(:set ,out ,(if (zerop data) primary
                                        `(:select (:gt ,count ,data) (:secondary-value-ref ,data) ,(nil-value)))))))))
      (19 (let ((slot (svref *mir-lir-stack-slots* (mir-instruction-id instruction))))
            (if slot (emit `(:stack-cons ,out (:slot ,slot) ,(first args) ,(nil-value)))
                (emit `(:set ,out ,(emit-cons (first args) (nil-value)))))))
      (20 (emit `(:set ,out (:field-load ,kiln.kir::+packet-field-cons-car+ ,(first args)))))
      (21 (emit `(:field-store ,kiln.kir::+packet-field-cons-car+ ,(first args) ,(second args))))
      (22 (emit `(:set ,out (:closure-ref ,*self* ,data))))
      (23 (let ((slot (svref *mir-lir-stack-slots* (mir-instruction-id instruction))))
            (if slot
                (emit `(:stack-closure ,out ,slot ,(svref *mir-lir-labels* data)))
                (emit `(:alloc-closure ,out ,(svref *mir-lir-labels* data)
                                      ,(length (mir-function-captures (svref *mir-lir-functions* data))) ,(handler))))))
      (24 (emit `(:closure-set ,(first args) ,(cdr data) ,(second args))))
      (25 (emit `(:set ,out ,(nil-value))))
      (12 (emit `(:set ,out ,argument-count)))
      (13 (emit-nargs-check (first args) (car data) (cdr data)))
      (16 (emit `(:set ,out ,(boolean-value `(:gt ,(first args) ,data)))))
      (17 (emit `(:set ,out ,(emit-rest-list data *mir-lir-rest-slots*))))
      (18 (emit-error (ecase data (:odd-keywords +err-odd-keywords+) (:unknown-keyword +err-unknown-keyword+))
                      (first args))))
    (when (and result (svref *mir-lir-doubles* result))
      (emit `(:set ,(svref *mir-lir-doubles* result)
                   (:field-load ,kiln.kir::+packet-field-double-bits+ ,(if (consp out) (car out) out)))))))

(defun mir-lir-edge-copies (function edge)
  "Snapshot every source before assigning block parameters, including copy cycles."
  (let ((copies nil)
        (parameters (mir-block-parameters (mir-at (mir-function-blocks function) (mir-edge-target edge)))))
    (loop for target across parameters for source across (mir-edge-arguments edge)
          for from = (mir-lir-value source) for to = (mir-lir-value target)
          when (svref *mir-lir-live* target)
          do (when (svref *mir-lir-doubles* target)
               (push (cons (svref *mir-lir-doubles* target)
                           (copy-to-var (mir-lir-double-bits source) :f64)) copies))
             (when (or (not (svref *mir-lir-doubles* target)) (svref *mir-lir-boxed* target))
               (if (consp to)
                 (cond ((eq (mir-lir-single-p target) (mir-lir-single-p source))
                        (push (cons (car to) (copy-to-var (car from))) copies)
                        (push (cons (cdr to) (copy-to-var (cdr from) :raw)) copies))
                       ((mir-lir-single-p target)
                        (multiple-value-bind (primary count) (mir-lir-restore source)
                          (declare (ignore count))
                          (push (cons (car to) (copy-to-var primary)) copies)
                          (push (cons (cdr to) 1) copies)))
                       (t (let ((saved (new-var)))
                            (emit `(:save-values ,saved ,(car from) 1 ,(handler)))
                            (push (cons (car to) saved) copies)
                            (push (cons (cdr to) 1) copies))))
                 (push (cons to (copy-to-var from
                                  (if (eq (mir-value-representation (mir-at (mir-function-values function) target)) :count)
                                      :raw :obj))) copies))))
    (dolist (copy (nreverse copies)) (emit `(:set ,(car copy) ,(cdr copy))))))

(defun mir-lir-function-body (function &optional unit)
  (let* ((*regions* *regions*)
         (*mir-lir-stack-regions* nil) (*mir-lir-rest-slots* nil)
         (*mir-lir-stack-slots* (make-array (hir-buffer-count (mir-function-instructions function)) :initial-element nil))
         (storage (and unit (svref (mir-infer-storage unit) (mir-function-id function))))
         (*mir-lir-types* (mir-infer-types function unit))
         (*mir-lir-value-facts* (mir-infer-value-facts function unit))
         (*mir-lir-live* (mir-lir-live-values function))
         (*mir-lir-doubles* nil) (*mir-lir-boxed* nil)
         (*mir-lir-values*
           (map 'simple-vector
                (lambda (value)
                  (case (mir-value-representation value)
                    (:bundle (cons (new-var) (new-var :raw)))
                    (:count (new-var :raw)) (otherwise (new-var))))
                (hir-vector (mir-function-values function))))
         (blocks (hir-vector (mir-function-blocks function)))
         (labels (map 'simple-vector (lambda (block) (declare (ignore block)) (new-block)) blocks))
         (edge-blocks nil)
         (arguments (make-array (mir-function-positional-count function))) (count (new-var :raw)))
    (multiple-value-setq (*mir-lir-doubles* *mir-lir-boxed*) (mir-lir-double-plan function))
    (dotimes (i (length arguments)) (setf (svref arguments i) (new-var)))
    (emit `(:receive-prefix ,(coerce arguments 'list) ,count))
    (when (and storage (not (zerop (mir-storage-analysis-rest storage))))
      (dotimes (index 8)
        (multiple-value-bind (slot region) (hir-establish-stack-object kiln.kir::+packet-class-cons+ 2)
          (push slot *mir-lir-rest-slots*)
          (push region *mir-lir-stack-regions*) (push region *regions*))))
    (when storage
      (dotimes (id (length *mir-lir-stack-slots*))
        (when (logbitp (1+ id) (logior (mir-storage-analysis-stack storage) (mir-storage-analysis-closures storage) (mir-storage-analysis-cells storage)))
          (let* ((instruction (mir-at (mir-function-instructions function) id))
                 (closure (= (mir-instruction-kind instruction) 23))
                 (class (if closure kiln.kir::+packet-class-function+ kiln.kir::+packet-class-cons+))
                 (count (if closure (length (mir-function-captures (svref *mir-lir-functions* (mir-instruction-data instruction)))) 2)))
            (multiple-value-bind (slot region) (hir-establish-stack-object class count)
              (setf (svref *mir-lir-stack-slots* id) slot)
              (push region *mir-lir-stack-regions*) (push region *regions*))))))
    (jump (svref labels 0))
    (loop for block across blocks for label across labels
          do (start-block label)
             (emit-poll :stack (zerop (mir-block-id block)))
             (loop for id across (hir-vector (mir-block-instructions block))
                   do (mir-lir-instruction (mir-at (mir-function-instructions function) id) arguments count))
             (let* ((term (mir-block-terminator block))
                    (*call-source* (mir-terminator-source term))
                    (targets (map 'simple-vector
                                  (lambda (edge)
                                    (let ((label (new-block)))
                                      (push (cons label edge) edge-blocks) label))
                                  (mir-terminator-edges term))))
               (case (mir-terminator-kind term)
                 (0 (jump (svref targets 0)))
                 (1 (br `(:eq ,(mir-lir-value (svref (mir-terminator-operands term) 0)) ,(nil-value))
                        (svref targets 1) (svref targets 0)))
                 (2 (multiple-value-bind (primary n)
                        (mir-lir-restore (svref (mir-terminator-operands term) 0))
                      (dolist (region *mir-lir-stack-regions*) (pop-entry region))
                      (emit `(:return ,primary ,n))))
                 (3 (emit '(:trap))))))
    (dolist (entry (nreverse edge-blocks))
      (start-block (car entry))
      (mir-lir-edge-copies function (cdr entry))
      (jump (svref labels (mir-edge-target (cdr entry)))))))

(defun mir-lower-toplevel (hir)
  (let* ((unit (mir-scalar-replace (mir-lift-local-functions (mir-fold-type-predicates (hir-to-mir hir))))) (*mir-lir-functions* (hir-vector (mir-unit-functions unit)))
         (functions *mir-lir-functions*)
         (*mir-lir-labels* (map 'simple-vector (lambda (function) (declare (ignore function))
                                                (fresh-label "kiln_mir_")) functions)))
    (verify-mir unit)
    (loop for function across functions for id from 0
          do (let ((*regions* nil) (*debug-vars* nil) (*debug-var-count* 0)
                   (*function-name* (local-function-debug-name (or (mir-function-name function) 'lambda))))
               (with-function ((svref *mir-lir-labels* id))
                 (let ((*self* (copy-to-var :self)))
                   (mir-lir-function-body function unit))
                 (set-function-debug *function-name* (hir-source-range (mir-function-source function))))))
    (loop for label across *mir-lir-labels* for function across functions
          when (zerop (length (mir-function-captures function)))
          do (module-data (kiln.kir::kir-name label "_fobj") `(:static-function ,label)))
    (emit-lisp-call (copy-to-var `(:object-address ,(kiln.kir::kir-name (svref *mir-lir-labels* 0) "_fobj") :general)) nil)))
