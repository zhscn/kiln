(in-package #:kiln.compiler)

(defun mir-control-flow (function)
  "Return reachable blocks and dominator bitsets, including loop back edges."
  (let* ((blocks (mir-function-blocks function)) (count (hir-buffer-count blocks))
         (predecessors (make-array count :initial-element nil))
         (dominators (make-array count :initial-element 0))
         (work (make-hir-buffer)) (reachable 0))
    (when (zerop count) (mir-fail "MIR function has no entry block"))
    (dotimes (i count)
      (let ((term (mir-block-terminator (mir-at blocks i))))
        (unless (mir-terminator-p term) (mir-fail "MIR block ~D has no terminator" i))
        (loop for edge across (mir-terminator-edges term)
              do (unless (mir-edge-p edge) (mir-fail "Invalid MIR edge"))
                 (mir-at blocks (mir-edge-target edge))
                 (pushnew i (svref predecessors (mir-edge-target edge))))))
    (hir-push 0 work)
    (loop for index from 0
          while (< index (hir-buffer-count work))
          for id = (mir-at work index)
          unless (logbitp id reachable)
            do (setf reachable (logior reachable (ash 1 id)))
               (loop for edge across (mir-terminator-edges (mir-block-terminator (mir-at blocks id)))
                     do (hir-push (mir-edge-target edge) work)))
    (dotimes (i count) (setf (svref dominators i) (if (zerop i) 1 reachable)))
    (loop with changed = t while changed
          do (setf changed nil)
             (loop for i from 1 below count when (logbitp i reachable)
                   do (let ((value reachable))
                        (dolist (pred (svref predecessors i))
                          (when (logbitp pred reachable)
                            (setf value (logand value (svref dominators pred)))))
                        (setf value (logior value (ash 1 i)))
                        (unless (= value (svref dominators i))
                          (setf (svref dominators i) value changed t)))))
    (values reachable dominators)))

(defun verify-mir-function (unit function)
  (let* ((blocks (mir-function-blocks function)) (instructions (mir-function-instructions function))
         (values (mir-function-values function))
         (seen-instructions (make-array (hir-buffer-count instructions) :initial-element nil))
         (seen-values (make-array (hir-buffer-count values) :initial-element nil)))
    (unless (eq function (mir-at (mir-unit-functions unit) (mir-function-id function)))
      (mir-fail "MIR function belongs to another unit"))
    (unless (and (integerp (mir-function-required function))
                 (<= 0 (mir-function-required function) kiln.kir::+backend-argument-limit+))
      (mir-fail "Invalid MIR argument count"))
    (labels ((definition (id block position)
               (let ((value (mir-at values id)))
                 (unless (and (mir-value-p value) (= id (mir-value-id value))
                              (member (mir-value-representation value) '(:obj :bundle :count))
                              (= block (mir-value-block value)) (= position (mir-value-position value))
                              (not (svref seen-values id)))
                   (mir-fail "Invalid or duplicate MIR definition ~S" id))
                 (setf (svref seen-values id) t)))
             (representation (id) (mir-value-representation (mir-at values id)))
             (expect-operands (ids types)
               (unless (= (length ids) (length types)) (mir-fail "MIR operand arity mismatch"))
               (loop for id across ids for type in types
                     unless (eq (representation id) type) do (mir-fail "MIR operand representation mismatch")))
             (objects (ids) (expect-operands ids (make-list (length ids) :initial-element :obj))))
      (dotimes (i (hir-buffer-count blocks))
        (let* ((block (mir-at blocks i)) (term (mir-block-terminator block)))
          (unless (and (mir-block-p block) (= (mir-block-id block) i)) (mir-fail "Invalid MIR block ID"))
          (when (and (zerop i) (plusp (length (mir-block-parameters block))))
            (mir-fail "MIR entry block cannot have edge parameters"))
          (loop for id across (mir-block-parameters block) do (definition id i -1))
          (loop for id across (hir-vector (mir-block-instructions block)) for position from 0
                for instruction = (mir-at instructions id)
                do (unless (and (mir-instruction-p instruction) (= (mir-instruction-id instruction) id)
                                (not (svref seen-instructions id))) (mir-fail "Invalid MIR instruction ID"))
                   (setf (svref seen-instructions id) t)
                   (let* ((kind (mir-instruction-kind instruction)) (args (mir-instruction-operands instruction))
                          (result (mir-instruction-result instruction)) (data (mir-instruction-data instruction)))
                     (unless (and (integerp kind) (<= 0 kind) (< kind (length *mir-instruction-effects*))
                                  (integerp (mir-instruction-policy instruction))
                                  (<= 0 (mir-instruction-policy instruction) 1023))
                       (mir-fail "Invalid MIR instruction kind or policy"))
                     (unless (and (integerp (mir-instruction-effects instruction))
                                  (<= 0 (mir-instruction-effects instruction)))
                       (mir-fail "Invalid MIR effect mask"))
                     (unless (= (logand (mir-instruction-effects instruction) (svref *mir-instruction-effects* kind))
                                (svref *mir-instruction-effects* kind))
                       (mir-fail "MIR operation understates its effects"))
                     (when result (definition result i position))
                     (let ((expected (case kind ((6 7 8 9) :bundle) (12 :count) ((11 13) nil) (otherwise :obj))))
                       (unless (if expected (and result (eq (representation result) expected)) (null result))
                         (mir-fail "Invalid MIR result representation")))
                     (case kind
                       ((0 1 2 4 5 12) (expect-operands args nil))
                       ((3 11) (expect-operands args '(:obj)))
                       (9 (expect-operands args '(:obj)))
                       (10 (expect-operands args '(:bundle)))
                       (13 (expect-operands args '(:count)))
                       ((6 8) (objects args))
                       (7 (when (zerop (length args)) (mir-fail "MIR indirect call lacks a callee")) (objects args)))
                     (case kind
                       (1 (unless (and (integerp data) (<= 0 data) (< data (mir-function-required function)))
                            (mir-fail "Invalid MIR argument index")))
                       ((2 3) (unless (symbolp data) (mir-fail "Invalid MIR global variable")))
                       ((4 6) (unless (hir-function-name-p data) (mir-fail "Invalid MIR global function")))
                       (5 (mir-at (mir-unit-functions unit) data))
                       (8 (unless (gethash data *primops*) (mir-fail "Unknown MIR primop ~S" data)))
                       (13 (unless (eql data (mir-function-required function)) (mir-fail "MIR arity check disagrees with signature"))))))
          (unless (mir-terminator-p term) (mir-fail "MIR block lacks a terminator"))
          (unless (and (integerp (mir-terminator-policy term)) (<= 0 (mir-terminator-policy term) 1023))
            (mir-fail "Invalid MIR terminator policy"))
          (let ((kind (mir-terminator-kind term)) (args (mir-terminator-operands term))
                (edges (mir-terminator-edges term)))
            (unless (member kind '(0 1 2 3)) (mir-fail "Unknown MIR terminator"))
            (expect-operands args (case kind (1 '(:obj)) (2 '(:bundle))))
            (unless (= (length edges) (case kind (0 1) (1 2) (otherwise 0)))
              (mir-fail "Invalid MIR successor count"))
            (loop for edge across edges
                  do (unless (mir-edge-p edge) (mir-fail "Invalid MIR edge"))
                     (let ((parameters (mir-block-parameters (mir-at blocks (mir-edge-target edge))))
                           (actual (mir-edge-arguments edge)))
                       (unless (= (length parameters) (length actual)) (mir-fail "MIR edge arity mismatch"))
                       (loop for parameter across parameters for argument across actual
                             unless (eq (representation parameter) (representation argument))
                               do (mir-fail "MIR edge representation mismatch")))))))
      (let ((checks 0) (checked nil))
        (loop for id across (hir-vector (mir-block-instructions (mir-at blocks 0)))
              for instruction = (mir-at instructions id)
              do (case (mir-instruction-kind instruction)
                   (13 (incf checks) (setf checked t))
                   (1 (unless checked (mir-fail "MIR argument read precedes arity check")))))
        (unless (= checks 1) (mir-fail "MIR entry requires one arity check")))
      (unless (every #'identity seen-instructions) (mir-fail "Unowned MIR instruction"))
      (unless (every #'identity seen-values) (mir-fail "Unowned MIR value"))
      (multiple-value-bind (reachable dominators) (mir-control-flow function)
        (labels ((use (id block position)
                   (let* ((value (mir-at values id)) (owner (mir-value-block value)))
                     (when (logbitp block reachable)
                       (unless (and (logbitp owner (svref dominators block))
                                    (or (/= owner block) (< (mir-value-position value) position)))
                         (mir-fail "MIR value ~D does not dominate its use in block ~D" id block))))))
          (dotimes (i (hir-buffer-count blocks))
            (let* ((block (mir-at blocks i)) (body (hir-vector (mir-block-instructions block)))
                   (term (mir-block-terminator block)))
              (loop for id across body for position from 0
                    do (loop for operand across (mir-instruction-operands (mir-at instructions id))
                             do (use operand i position)))
              (loop for operand across (mir-terminator-operands term) do (use operand i (length body)))
              (loop for edge across (mir-terminator-edges term)
                    do (loop for operand across (mir-edge-arguments edge) do (use operand i (length body)))))))))
    function))

(defun verify-mir (unit)
  (when (zerop (hir-buffer-count (mir-unit-functions unit))) (mir-fail "Empty MIR unit"))
  (loop for function across (hir-vector (mir-unit-functions unit)) for id from 0
        do (unless (= id (mir-function-id function)) (mir-fail "Invalid MIR function ID"))
           (verify-mir-function unit function))
  unit)
