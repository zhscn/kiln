(in-package #:kiln.compiler)

(defun mir-control-flow (function)
  "Return reachable blocks and dominator bitsets, including loop back edges."
  (let* ((blocks (mir-function-blocks function)) (count (hir-buffer-count blocks))
         (predecessors (make-array count :initial-element nil))
         (dominators (make-array count :initial-element 0))
         (work (make-hir-buffer)) (reachable 0))
    (when (zerop count) (mir-fail "MIR function has no entry block"))
    (dotimes (i count)
      (let ((term (mir-block-terminator (mir-at blocks i))))
        (unless (mir-terminator-p term) (mir-fail "MIR block ~D has no terminator" i))
        (loop for edge across (mir-terminator-edges term)
              do (unless (mir-edge-p edge) (mir-fail "Invalid MIR edge"))
                     (when (eql (mir-edge-target edge) 0) (mir-fail "MIR function entry cannot have predecessors"))
                 (mir-at blocks (mir-edge-target edge))
                 (pushnew i (svref predecessors (mir-edge-target edge))))))
    (hir-push 0 work)
    (loop for index from 0
          while (< index (hir-buffer-count work))
          for id = (mir-at work index)
          unless (logbitp id reachable)
            do (setf reachable (logior reachable (ash 1 id)))
               (loop for edge across (mir-terminator-edges (mir-block-terminator (mir-at blocks id)))
                     do (hir-push (mir-edge-target edge) work)))
    (dotimes (i count) (setf (svref dominators i) (if (zerop i) 1 reachable)))
    (loop with changed = t while changed
          do (setf changed nil)
             (loop for i from 1 below count when (logbitp i reachable)
                   do (let ((value reachable))
                        (dolist (pred (svref predecessors i))
                          (when (logbitp pred reachable)
                            (setf value (logand value (svref dominators pred)))))
                        (setf value (logior value (ash 1 i)))
                        (unless (= value (svref dominators i))
                          (setf (svref dominators i) value changed t)))))
    (values reachable dominators)))

(defun mir-reachable-blocks (function)
  "Cache the reachable block bitset at the function's current revision."
  (mir-analysis function :reachable #'mir-control-flow))

(defun mir-verify-closure-initialization (unit function)
  (let* ((instructions (hir-vector (mir-function-instructions function)))
         (definitions (make-array (hir-buffer-count (mir-function-values function)) :initial-element nil))
         (fields (make-array (length instructions) :initial-element 0))
         (last-write (make-array (length instructions) :initial-element -1))
         (dependencies (make-array (length instructions) :initial-element nil)))
    (loop for instruction across instructions for result = (mir-instruction-result instruction)
          when result do (setf (svref definitions result) instruction))
    (loop for block across (hir-vector (mir-function-blocks function)) do
      (loop for id across (hir-vector (mir-block-instructions block)) for position from 0
            for instruction = (svref instructions id) when (= (mir-instruction-kind instruction) 24) do
        (let* ((receiver (svref (mir-instruction-operands instruction) 0))
               (allocation (svref definitions receiver)) (value (mir-at (mir-function-values function) receiver))
               (data (mir-instruction-data instruction)))
          (unless (and allocation (= (mir-instruction-kind allocation) 23)
                       (= (mir-instruction-data allocation) (car data))
                       (= (mir-value-block value) (mir-block-id block)) (< (mir-value-position value) position))
            (mir-fail "MIR closure field must initialize its allocation in the same block"))
          (let ((site (mir-instruction-id allocation)))
            (when (logbitp (cdr data) (svref fields site)) (mir-fail "Duplicate MIR closure field initialization"))
            (setf (svref fields site) (logior (svref fields site) (ash 1 (cdr data)))
                  (svref last-write site) position)
            (let* ((stored (svref (mir-instruction-operands instruction) 1))
                   (source (svref definitions stored)))
              (when (and source (= (mir-instruction-kind source) 23)
                         (= (mir-value-block (mir-at (mir-function-values function) stored)) (mir-block-id block)))
                (pushnew (mir-instruction-id source) (svref dependencies site))))))))
    (loop for instruction across instructions when (= (mir-instruction-kind instruction) 23) do
      (let* ((site (mir-instruction-id instruction)) (bits (svref fields site)))
        (unless (and (plusp bits) (= bits (1- (ash 1 (length (mir-function-captures (mir-at (mir-unit-functions unit) (mir-instruction-data instruction))))))))
          (mir-fail "MIR closure environment is not completely initialized"))))
    ;; Observing one member can expose every peer reachable through its fields.
    (loop with changed = t while changed do
      (setf changed nil)
      (dotimes (site (length dependencies))
        (dolist (source (svref dependencies site))
          (when (< (svref last-write site) (svref last-write source))
            (setf (svref last-write site) (svref last-write source) changed t)))))
    (loop for block across (hir-vector (mir-function-blocks function)) do
      (loop for id across (hir-vector (mir-block-instructions block)) for position from 0
            for instruction = (svref instructions id) unless (= (mir-instruction-kind instruction) 24) do
        (loop for arg across (mir-instruction-operands instruction) for definition = (svref definitions arg)
              when (and definition (= (mir-instruction-kind definition) 23)
                        (= (mir-value-block (mir-at (mir-function-values function) arg)) (mir-block-id block))
                        (< position (svref last-write (mir-instruction-id definition))))
                do (mir-fail "MIR closure is observed before its environment is initialized")))))

  (let ((known (and (find 24 (hir-vector (mir-function-instructions function)) :key #'mir-instruction-kind)
                    (mir-compute-function-identities function))))
    (loop for instruction across (hir-vector (mir-function-instructions function))
          when (= (mir-instruction-kind instruction) 24) do
      (let* ((data (mir-instruction-data instruction))
             (target (svref (mir-function-capture-functions (mir-at (mir-unit-functions unit) (car data))) (cdr data))))
        (when (and target (not (eql target (svref known (svref (mir-instruction-operands instruction) 1)))))
          (mir-fail "MIR function capture disagrees with its fixed target"))))))

(defun mir-verify-cells (function)
  (let ((unbound 0) (changed t) (reachable (mir-reachable-blocks function))
        (blocks (hir-vector (mir-function-blocks function))))
    (loop for instruction across (hir-vector (mir-function-instructions function))
          when (= (mir-instruction-kind instruction) 25)
            do (setf unbound (logior unbound (ash 1 (mir-instruction-result instruction)))))
    (loop while changed do
      (setf changed nil)
      (loop for block across blocks when (logbitp (mir-block-id block) reachable) do
        (loop for edge across (mir-terminator-edges (mir-block-terminator block)) do
          (loop for parameter across (mir-block-parameters (svref blocks (mir-edge-target edge)))
                for arg across (mir-edge-arguments edge)
                when (and (logbitp arg unbound) (not (logbitp parameter unbound)))
                  do (setf unbound (logior unbound (ash 1 parameter)) changed t)))))
    (loop for block across blocks when (logbitp (mir-block-id block) reachable) do
      (loop for id across (hir-vector (mir-block-instructions block))
            for instruction = (mir-at (mir-function-instructions function) id)
            for kind = (mir-instruction-kind instruction)
            when (member kind '(7 15 20 21 24)) do
        (let* ((args (mir-instruction-operands instruction))
               (uses (if (member kind '(7 15)) args (vector (svref args (if (= kind 24) 1 0))))))
          (loop for id across uses
                when (and (eq (mir-value-representation (mir-at (mir-function-values function) id)) :cell) (logbitp id unbound))
                  do (mir-fail "MIR cell is used before its binding is initialized")))))))

(defun mir-verify-function-layout (unit function)
  (unless (eq function (mir-at (mir-unit-functions unit) (mir-function-id function)))
    (mir-fail "MIR function belongs to another unit"))
  (unless (and (integerp (mir-function-required function))
               (integerp (mir-function-optional function))
               (member (mir-function-rest function) '(nil t))
               (member (mir-function-key-p function) '(nil t))
               (member (mir-function-allow-other-keys function) '(nil t))
               (typep (mir-function-keys function) 'simple-vector)
               (every #'symbolp (mir-function-keys function))
               (or (mir-function-key-p function)
                   (and (zerop (length (mir-function-keys function))) (not (mir-function-allow-other-keys function))))
               (<= 0 (mir-function-required function)) (<= 0 (mir-function-optional function))
               (<= (mir-function-positional-count function) kiln.kir::+backend-argument-limit+))
    (mir-fail "Invalid MIR argument count"))
  (unless (and (integerp (mir-function-internal-prefix function))
               (<= 0 (mir-function-internal-prefix function) (mir-function-required function))
               (integerp (mir-function-argument-cells function))
               (<= 0 (mir-function-argument-cells function))
               (< (mir-function-argument-cells function) (ash 1 (mir-function-internal-prefix function)))
               (or (zerop (mir-function-internal-prefix function))
                   (and (typep (mir-function-captures function) 'simple-vector)
                        (zerop (length (mir-function-captures function))))))
    (mir-fail "Invalid MIR private prefix layout"))
  (unless (and (typep (mir-function-captures function) 'simple-vector)
               (typep (mir-function-capture-functions function) 'simple-vector)
               (= (length (mir-function-captures function)) (length (mir-function-capture-functions function)))
               (integerp (mir-function-binding-cells function))
               (<= 0 (mir-function-binding-cells function))
               (< (mir-function-binding-cells function) (ash 1 (length (mir-function-bindings function))))
               (integerp (mir-function-capture-cells function))
               (<= 0 (mir-function-capture-cells function))
               (< (mir-function-capture-cells function) (ash 1 (length (mir-function-captures function)))))
    (mir-fail "Invalid MIR capture layout"))
  (loop for target across (mir-function-capture-functions function) for index from 0 when target
        do (mir-at (mir-unit-functions unit) target)
           (when (logbitp index (mir-function-capture-cells function))
             (mir-fail "Mutable capture cannot have a fixed function identity")))
  function)

(defun mir-verify-private-entries (unit)
  (let ((functions (hir-vector (mir-unit-functions unit))))
    (when (some (lambda (function) (plusp (mir-function-internal-prefix function))) functions)
      (let* ((identities (map 'simple-vector #'mir-compute-function-identities functions))
             (external (mir-external-functions functions identities (mir-unit-load-time-functions unit))))
        (loop for function across functions for id from 0
              when (and (plusp (mir-function-internal-prefix function)) (logbitp id external))
                do (mir-fail "MIR private entry function object escapes its known calls")))))
  unit)

(defun mir-verify-internal-calls (unit function)
  (let ((known (mir-compute-function-identities function)))
    (loop for instruction across (hir-vector (mir-function-instructions function))
          for kind = (mir-instruction-kind instruction)
          when (member kind '(7 15)) do
            (let* ((args (mir-instruction-operands instruction))
                   (id (svref known (svref args 0)))
                   (target (and (integerp id) (mir-at (mir-unit-functions unit) id)))
                   (prefix (mir-call-prefix-count instruction))
                   (cells (if target (mir-function-argument-cells target) 0)))
              (when (plusp prefix)
                (unless (and target (= prefix (mir-function-internal-prefix target)))
                  (mir-fail "MIR multiple-value prefix lacks a matching private entry")))
              (when (and (= kind 15) (plusp cells) (zerop prefix))
                (mir-fail "MIR cell entry requires a direct multiple-value prefix"))
              (when (and (= kind 7) target (< (1- (length args)) (mir-function-internal-prefix target)))
                (mir-fail "MIR call omits private prefix arguments"))
              (loop for index from 1 below (if (= kind 7) (length args) (1+ prefix))
                    for value = (mir-at (mir-function-values function) (svref args index))
                    unless (eq (mir-value-representation value) (if (logbitp (1- index) cells) :cell :obj))
                      do (mir-fail "MIR call disagrees with its private cell prefix"))))))

(defun verify-mir-function (unit function)
  (let* ((blocks (mir-function-blocks function)) (instructions (mir-function-instructions function))
         (values (mir-function-values function))
         (seen-instructions (make-array (hir-buffer-count instructions) :initial-element nil))
         (seen-values (make-array (hir-buffer-count values) :initial-element nil)))
    (mir-verify-function-layout unit function)
    (labels ((definition (id block position)
               (let ((value (mir-at values id)))
                 (unless (and (mir-value-p value) (= id (mir-value-id value))
                              (member (mir-value-representation value) '(:obj :bundle :count :cell))
                              (= block (mir-value-block value)) (= position (mir-value-position value))
                              (not (svref seen-values id)))
                   (mir-fail "Invalid or duplicate MIR definition ~S" id))
                 (setf (svref seen-values id) t)))
             (representation (id) (mir-value-representation (mir-at values id)))
             (expect-operands (ids types)
               (unless (= (length ids) (length types)) (mir-fail "MIR operand arity mismatch"))
               (loop for id across ids for type in types
                     unless (eq (representation id) type) do (mir-fail "MIR operand representation mismatch")))
             (objects (ids) (expect-operands ids (make-list (length ids) :initial-element :obj))))
      (dotimes (i (hir-buffer-count blocks))
        (let* ((block (mir-at blocks i)) (term (mir-block-terminator block)))
          (unless (and (mir-block-p block) (= (mir-block-id block) i)) (mir-fail "Invalid MIR block ID"))
          (when (and (zerop i) (plusp (length (mir-block-parameters block))))
            (mir-fail "MIR entry block cannot have edge parameters"))
          (unless (zerop i)
            (unless (>= (length (mir-block-parameters block)) (length (mir-function-bindings function)))
              (mir-fail "MIR block is missing binding parameters"))
            (loop for index below (length (mir-function-bindings function))
                  unless (eq (representation (svref (mir-block-parameters block) index))
                             (if (logbitp index (mir-function-binding-cells function)) :cell :obj))
                    do (mir-fail "MIR binding parameter disagrees with its cell layout")))
          (loop for id across (mir-block-parameters block) do (definition id i -1))
          (loop for id across (hir-vector (mir-block-instructions block)) for position from 0
                for instruction = (mir-at instructions id)
                do (unless (and (mir-instruction-p instruction) (= (mir-instruction-id instruction) id)
                                (not (svref seen-instructions id))) (mir-fail "Invalid MIR instruction ID"))
                   (setf (svref seen-instructions id) t)
                   (let* ((kind (mir-instruction-kind instruction)) (args (mir-instruction-operands instruction))
                          (result (mir-instruction-result instruction)) (data (mir-instruction-data instruction)))
                     (unless (and (integerp kind) (<= 0 kind) (< kind (length *mir-instruction-effects*))
                                  (member (mir-instruction-notinline instruction) '(nil t))
                                  (integerp (mir-instruction-policy instruction))
                                  (<= 0 (mir-instruction-policy instruction) 1023))
                       (mir-fail "Invalid MIR instruction kind or policy"))
                     (unless (and (integerp (mir-instruction-effects instruction))
                                  (<= 0 (mir-instruction-effects instruction)))
                       (mir-fail "Invalid MIR effect mask"))
                     (unless (= (logand (mir-instruction-effects instruction) (svref *mir-instruction-effects* kind))
                                (svref *mir-instruction-effects* kind))
                       (mir-fail "MIR operation understates its effects"))
                     (when result (definition result i position))
                     (let ((expected (case kind
                                       ((6 7 8 9 15) :bundle)
                                       (1 (if (and (integerp data) (<= 0 data) (logbitp data (mir-function-argument-cells function))) :cell :obj))
                                       (12 :count)
                                       (11 (and (= (length args) 1) (representation (svref args 0))))
                                       ((13 18 21 24) nil)
                                       ((19 25) :cell)
                                       (22 (if (and (integerp data) (<= 0 data) (< data (length (mir-function-captures function))))
                                               (if (logbitp data (mir-function-capture-cells function)) :cell :obj)
                                               (mir-fail "Invalid MIR capture index")))
                                       (otherwise :obj))))
                       (unless (if expected (and result (eq (representation result) expected)) (null result))
                         (mir-fail "Invalid MIR result representation")))
                     (case kind
                       ((0 1 2 4 5 12 22 23 25 26) (expect-operands args nil))
                       (19 (expect-operands args '(:obj)))
                       (20 (expect-operands args '(:cell)))
                       (21 (expect-operands args '(:cell :obj)))
                       (24 (unless (and (consp data) (integerp (car data)) (integerp (cdr data)) (<= 0 (cdr data)))
                             (mir-fail "Invalid MIR closure field"))
                           (let ((target (mir-at (mir-unit-functions unit) (car data))))
                             (unless (< (cdr data) (length (mir-function-captures target)))
                               (mir-fail "MIR closure field is outside its layout"))
                             (expect-operands args (list :obj (if (logbitp (cdr data) (mir-function-capture-cells target)) :cell :obj)))))
                       ((3 18) (expect-operands args '(:obj)))
                       (11 (unless (and (= (length args) 1)
                                        (member (representation (svref args 0)) '(:obj :bundle)))
                             (mir-fail "Invalid MIR declaration-check operand")))
                       (9 (expect-operands args '(:obj)))
                       ((10 14) (expect-operands args '(:bundle)))
                       ((13 16 17) (expect-operands args '(:count)))
                       ((6 8) (objects args))
                       (15 (when (zerop (length args)) (mir-fail "MIR multiple-value call lacks a callee"))
                           (unless (or (null data) (and (integerp data) (<= 0 data (1- (length args)))))
                             (mir-fail "Invalid MIR multiple-value prefix"))
                           (expect-operands (subseq args 0 1) '(:obj))
                           (loop for index from 1 to (mir-call-prefix-count instruction)
                                 unless (member (representation (svref args index)) '(:obj :cell))
                                   do (mir-fail "Invalid MIR direct prefix operand"))
                           (expect-operands (subseq args (1+ (mir-call-prefix-count instruction)))
                                            (make-list (- (length args) 1 (mir-call-prefix-count instruction)) :initial-element :bundle)))
                       (7 (when (zerop (length args)) (mir-fail "MIR indirect call lacks a callee"))
                          (expect-operands (subseq args 0 1) '(:obj))
                          (loop for index from 1 below (length args)
                                unless (member (representation (svref args index)) '(:obj :cell))
                                  do (mir-fail "Invalid MIR call operand"))))
                     (case kind
                       (1 (unless (and (integerp data) (<= 0 data) (< data (mir-function-positional-count function)))
                            (mir-fail "Invalid MIR argument index")))
                       ((2 3) (unless (symbolp data) (mir-fail "Invalid MIR global variable")))
                       ((4 6) (unless (hir-function-name-p data) (mir-fail "Invalid MIR global function")))
                       ((5 23) (let ((target (mir-at (mir-unit-functions unit) data)))
                                 (unless (eq (zerop (length (mir-function-captures target))) (= kind 5))
                                   (mir-fail "MIR function object disagrees with capture layout"))))
                       (8 (unless (gethash data *primops*) (mir-fail "Unknown MIR primop ~S" data)))
                       (26 (unless (and (integerp data) (<= 0 data)
                                        (< data (length (mir-unit-load-time-functions unit))))
                             (mir-fail "Invalid MIR load-time value index")))
                       (14 (unless (and (integerp data) (<= 0 data))
                             (mir-fail "Invalid MIR value index")))
                       (16 (unless (and (integerp data) (<= 0 data) (< data (mir-function-positional-count function)))
                             (mir-fail "Invalid MIR argument presence index")))
                       (17 (unless (and (mir-function-tail-p function) (eql data (mir-function-positional-count function)) (zerop i))
                             (mir-fail "Invalid MIR rest-list entry")))
                       (18 (unless (member data '(:odd-keywords :unknown-keyword))
                             (mir-fail "Invalid MIR argument error")))
                       (13 (unless (equal data (cons (mir-function-required function) (mir-function-maximum function)))
                             (mir-fail "MIR arity check disagrees with signature"))))))
          (unless (mir-terminator-p term) (mir-fail "MIR block lacks a terminator"))
          (unless (and (integerp (mir-terminator-policy term)) (<= 0 (mir-terminator-policy term) 1023))
            (mir-fail "Invalid MIR terminator policy"))
          (let ((kind (mir-terminator-kind term)) (args (mir-terminator-operands term))
                (edges (mir-terminator-edges term)))
            (unless (member kind '(0 1 2 3)) (mir-fail "Unknown MIR terminator"))
            (expect-operands args (case kind (1 '(:obj)) (2 '(:bundle))))
            (unless (= (length edges) (case kind (0 1) (1 2) (otherwise 0)))
              (mir-fail "Invalid MIR successor count"))
            (loop for edge across edges
                  do (unless (mir-edge-p edge) (mir-fail "Invalid MIR edge"))
                     (when (eql (mir-edge-target edge) 0) (mir-fail "MIR function entry cannot have predecessors"))
                     (let ((parameters (mir-block-parameters (mir-at blocks (mir-edge-target edge))))
                           (actual (mir-edge-arguments edge)))
                       (unless (= (length parameters) (length actual)) (mir-fail "MIR edge arity mismatch"))
                       (loop for parameter across parameters for argument across actual
                             unless (eq (representation parameter) (representation argument))
                               do (mir-fail "MIR edge representation mismatch")))))))
      (let ((checks 0) (checked nil) (rest-lists 0) (calls nil))
        (loop for id across (hir-vector (mir-block-instructions (mir-at blocks 0)))
              for instruction = (mir-at instructions id)
              do (case (mir-instruction-kind instruction)
                   (13 (incf checks) (setf checked t))
                   (1 (unless checked (mir-fail "MIR argument read precedes arity check")))
                   (17 (incf rest-lists)
                       (unless (and checked (not calls)) (mir-fail "MIR rest-list must precede calls after arity check"))))
                 (when (and (/= (mir-instruction-kind instruction) 17)
                            (logtest (mir-instruction-effects instruction) (+ 8 16 64)))
                   (setf calls t)))
        (unless (= rest-lists (if (mir-function-tail-p function) 1 0))
          (mir-fail "MIR entry rest-list disagrees with signature"))
        (unless (= checks 1) (mir-fail "MIR entry requires one arity check")))
      (mir-verify-closure-initialization unit function)
      (mir-verify-cells function)
      (mir-verify-internal-calls unit function)
      (unless (every #'identity seen-instructions) (mir-fail "Unowned MIR instruction"))
      (unless (every #'identity seen-values) (mir-fail "Unowned MIR value"))
      (multiple-value-bind (reachable dominators) (mir-control-flow function)
        (labels ((use (id block position)
                   (let* ((value (mir-at values id)) (owner (mir-value-block value)))
                     (when (logbitp block reachable)
                       (unless (and (logbitp owner (svref dominators block))
                                    (or (/= owner block) (< (mir-value-position value) position)))
                         (mir-fail "MIR value ~D does not dominate its use in block ~D" id block))))))
          (dotimes (i (hir-buffer-count blocks))
            (let* ((block (mir-at blocks i)) (body (hir-vector (mir-block-instructions block)))
                   (term (mir-block-terminator block)))
              (loop for id across body for position from 0
                    do (loop for operand across (mir-instruction-operands (mir-at instructions id))
                             do (use operand i position)))
              (loop for operand across (mir-terminator-operands term) do (use operand i (length body)))
              (loop for edge across (mir-terminator-edges term)
                    do (loop for operand across (mir-edge-arguments edge) do (use operand i (length body)))))))))
    function))

(defun mir-verify-load-time-functions (unit)
  (unless (typep (mir-unit-load-time-functions unit) 'simple-vector)
    (mir-fail "Invalid MIR load-time function table"))
  (loop for id across (mir-unit-load-time-functions unit)
        do (unless (and (integerp id) (< 0 id) (< id (hir-buffer-count (mir-unit-functions unit))))
             (mir-fail "Invalid MIR load-time function ID"))
           (let ((function (mir-at (mir-unit-functions unit) id)))
             (unless (and (zerop (mir-function-required function))
                          (eql 0 (mir-function-maximum function))
                          (zerop (length (mir-function-captures function)))
                          (zerop (mir-function-internal-prefix function)))
               (mir-fail "MIR load-time functions require a closed zero-argument entry"))))
  unit)

(defun verify-mir (unit)
  (when (zerop (hir-buffer-count (mir-unit-functions unit))) (mir-fail "Empty MIR unit"))
  ;; Call validation reads callee layouts. Check every layout before any
  ;; function body so malformed later entries cannot reach those reads.
  (loop for function across (hir-vector (mir-unit-functions unit)) for id from 0
        do (unless (and (mir-function-p function) (eql id (mir-function-id function)))
             (mir-fail "Invalid MIR function ID"))
           (mir-verify-function-layout unit function))
  (mir-verify-load-time-functions unit)
  (unless (zerop (length (mir-function-captures (mir-at (mir-unit-functions unit) 0))))
    (mir-fail "MIR unit entry cannot require a closure environment"))
  (unless (eql 0 (mir-function-internal-prefix (mir-at (mir-unit-functions unit) 0)))
    (mir-fail "MIR unit entry cannot require a private prefix"))
  (loop for function across (hir-vector (mir-unit-functions unit)) do (verify-mir-function unit function))
  (mir-verify-private-entries unit)
  unit)
