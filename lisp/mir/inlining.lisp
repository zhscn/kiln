(in-package #:kiln.compiler)

(defun mir-inlining-cost (function &optional (argument-count (mir-function-required function)))
  "Bound body growth for an entry whose arguments can be substituted directly."
  (when (or (plusp (length (mir-function-captures function)))
            (not (mir-lifting-policy-p function)))
    (return-from mir-inlining-cost nil))
  (loop for block across (hir-vector (mir-function-blocks function))
        for term = (mir-block-terminator block)
        unless (and (member (mir-terminator-kind term) '(0 1 2 3 4))
                    (null (mir-terminator-region term))
                    (hir-policy-optimize-p (mir-terminator-policy term))
                    (< (hir-policy-quality (mir-terminator-policy term) :debug) 2))
          do (return-from mir-inlining-cost nil))
  (loop for instruction across (hir-vector (mir-function-instructions function))
        for kind = (mir-instruction-kind instruction)
        when (or (= kind 22)
                 (and (>= kind 27) (< kind 37)))
          do (return-from mir-inlining-cost nil))
  (+ 2 (if (or (mir-function-tail-p function)
               (< argument-count (mir-function-positional-count function))) 1 0)
     (if (mir-function-tail-p function)
         (* 2 (max 0 (- argument-count (mir-function-positional-count function)))) 0)
     (hir-buffer-count (mir-function-blocks function))
     (loop for block across (hir-vector (mir-function-blocks function))
           sum (length (mir-block-parameters block)))
     (count-if (lambda (instruction) (not (member (mir-instruction-kind instruction) '(1 12 13 17))))
               (hir-vector (mir-function-instructions function)))))

(defun mir-inline-call (caller block call callee)
  "Split a caller at CALL, substitute parameters, and join returned bundles."
  (let* ((blocks (mir-function-blocks caller))
         (instructions (mir-function-instructions caller))
         (source-blocks (hir-vector (mir-function-blocks callee)))
         (source-values (hir-vector (mir-function-values callee)))
         (block-map (make-array (length source-blocks)))
         (value-map (make-array (length source-values) :initial-element nil))
         (args (subseq (mir-instruction-operands call) 1))
         (result (mir-instruction-result call))
         (nil-value nil)
         (old-body (hir-vector (mir-block-instructions block)))
         (call-position (position (mir-instruction-id call) old-body))
         (continuation (make-mir-block :id (hir-buffer-count blocks)
                                       :parameters (vector result)
                                       :terminator (mir-block-terminator block))))
    (hir-push continuation blocks)
    (loop for source across source-blocks for id from 0
          for clone = (make-mir-block :id (hir-buffer-count blocks))
          do (setf (svref block-map id) (mir-block-id clone)) (hir-push clone blocks))
    (labels ((value (id)
               (or (svref value-map id) (mir-fail "Unmapped inlined value ~D" id)))
             (values-vector (ids) (map 'simple-vector #'value ids))
             (append-instruction (target instruction)
               (let* ((id (hir-buffer-count instructions))
                      (position (hir-buffer-count (mir-block-instructions target)))
                      (result (mir-instruction-result instruction)))
                 (setf (mir-instruction-id instruction) id)
                 (when result
                   (let ((definition (mir-at (mir-function-values caller) result)))
                     (setf (mir-value-block definition) (mir-block-id target)
                           (mir-value-position definition) position)))
                 (hir-push instruction instructions)
                 (hir-push id (mir-block-instructions target)))))
      ;; An absent optional's argument read is unreachable after its presence
      ;; branch folds. A dominating NIL keeps SSA valid before simplification.
      (when (or (mir-function-tail-p callee)
                (< (length args) (mir-function-positional-count callee)))
        (setf nil-value (mir-add-value caller :obj (svref block-map 0) 0))
        (append-instruction (mir-at blocks (svref block-map 0))
                            (make-mir-instruction :kind 0 :result nil-value :data nil
                                                  :source (mir-instruction-source call)
                                                  :origin (mir-instruction-origin call)
                                                  :policy (mir-instruction-policy call))))
      ;; Allocate every definition first, including loop-carried parameters.
      (loop for source across source-blocks
            for target = (mir-at blocks (svref block-map (mir-block-id source)))
            do (setf (mir-block-parameters target)
                     (map 'simple-vector
                          (lambda (id)
                            (setf (svref value-map id)
                                  (mir-add-value caller (mir-value-representation (svref source-values id))
                                                 (mir-block-id target) -1)))
                          (mir-block-parameters source)))
               (loop for id across (hir-vector (mir-block-instructions source))
                     for instruction = (mir-at (mir-function-instructions callee) id)
                     for kind = (mir-instruction-kind instruction)
                     for result = (mir-instruction-result instruction)
                     do (cond ((= kind 1)
                               (setf (svref value-map result)
                                     (if (< (mir-instruction-data instruction) (length args))
                                         (svref args (mir-instruction-data instruction)) nil-value)))
                              ((and (= kind 17) (<= (length args) (mir-instruction-data instruction)))
                               (setf (svref value-map result) nil-value))
                              ((and result (/= kind 12))
                               (setf (svref value-map result)
                                     (mir-add-value caller (mir-value-representation (svref source-values result))
                                                    (mir-block-id target) 0))))))
      (loop for source across source-blocks
            for target = (mir-at blocks (svref block-map (mir-block-id source)))
            for term = (mir-block-terminator source)
            do (loop for id across (hir-vector (mir-block-instructions source))
                     for instruction = (mir-at (mir-function-instructions callee) id)
                     for kind = (mir-instruction-kind instruction)
                     do (cond
                          ((= kind 17)
                           ;; Keep entry allocation before defaults and the
                           ;; keyword snapshot, using already evaluated arguments.
                           (let ((tail nil-value) (start (mir-instruction-data instruction)))
                             (loop for index downfrom (1- (length args)) to start
                                   for bundle = (mir-add-value caller :bundle (mir-block-id target) 0)
                                   for out = (if (= index start) (value (mir-instruction-result instruction))
                                                 (mir-add-value caller :obj (mir-block-id target) 0))
                                   do (let ((cons (copy-mir-instruction instruction))
                                            (primary (copy-mir-instruction instruction)))
                                        (setf (mir-instruction-kind cons) 6
                                              (mir-instruction-operands cons) (vector (svref args index) tail)
                                              (mir-instruction-result cons) bundle
                                              (mir-instruction-data cons) 'cons
                                              (mir-instruction-effects cons) (svref *mir-instruction-effects* 6)
                                              (mir-instruction-kind primary) 10
                                              (mir-instruction-operands primary) (vector bundle)
                                              (mir-instruction-result primary) out
                                              (mir-instruction-data primary) nil
                                              (mir-instruction-effects primary) (svref *mir-instruction-effects* 10))
                                        (append-instruction target cons)
                                        (append-instruction target primary)
                                        (setf tail out)))))
                          ((= kind 16)
                           (let ((clone (copy-mir-instruction instruction)))
                             (setf (mir-instruction-kind clone) 0
                                   (mir-instruction-operands clone) #()
                                   (mir-instruction-result clone) (value (mir-instruction-result instruction))
                                   (mir-instruction-data clone) (< (mir-instruction-data instruction) (length args))
                                   (mir-instruction-effects clone) 0)
                             (append-instruction target clone)))
                          ((not (member kind '(1 12 13)))
                           (let ((clone (copy-mir-instruction instruction)))
                             (setf (mir-instruction-operands clone) (values-vector (mir-instruction-operands instruction))
                                   (mir-instruction-result clone)
                                   (and (mir-instruction-result instruction) (value (mir-instruction-result instruction))))
                             (append-instruction target clone)))))
               (let ((clone (copy-mir-terminator term)))
                 (if (= (mir-terminator-kind term) 2)
                     (setf (mir-terminator-kind clone) 0
                           (mir-terminator-operands clone) #()
                           (mir-terminator-edges clone)
                           (vector (make-mir-edge :target (mir-block-id continuation)
                                                  :arguments (values-vector (mir-terminator-operands term)))))
                     (setf (mir-terminator-operands clone) (values-vector (mir-terminator-operands term))
                           (mir-terminator-edges clone)
                           (map 'simple-vector
                                (lambda (edge)
                                  (make-mir-edge :target (svref block-map (mir-edge-target edge))
                                                 :arguments (values-vector (mir-edge-arguments edge))))
                                (mir-terminator-edges term))))
                 (setf (mir-block-terminator target) clone)))
      (let ((before (make-hir-buffer)) (after (make-hir-buffer)))
        (loop for id across old-body for position from 0
              do (cond ((< position call-position) (hir-push id before))
                       ((> position call-position) (hir-push id after))))
        (setf (mir-block-instructions block) before
              (mir-block-instructions continuation) after
              (mir-block-terminator block)
              (make-mir-terminator :kind 0
                                   :edges (vector (make-mir-edge :target (svref block-map 0)))
                                   :source (mir-instruction-source call) :origin (mir-instruction-origin call)
                                   :policy (mir-instruction-policy call)))
        (let ((definition (mir-at (mir-function-values caller) result)))
          (setf (mir-value-block definition) (mir-block-id continuation)
                (mir-value-position definition) -1)))
      ;; Removing CALL leaves an instruction-ID hole; compact all owned bodies.
      (let ((rebuilt (make-hir-buffer)))
        (loop for target across (hir-vector blocks)
              for body = (make-hir-buffer)
              do (loop for id across (hir-vector (mir-block-instructions target))
                       for instruction = (mir-at instructions id)
                       for result = (mir-instruction-result instruction)
                       do (when result
                            (let ((definition (mir-at (mir-function-values caller) result)))
                              (setf (mir-value-block definition) (mir-block-id target)
                                    (mir-value-position definition) (hir-buffer-count body))))
                          (setf (mir-instruction-id instruction) (hir-buffer-count rebuilt))
                          (hir-push (hir-buffer-count rebuilt) body)
                          (hir-push instruction rebuilt))
                 (setf (mir-block-instructions target) body))
        (setf (mir-function-instructions caller) rebuilt))))
  caller)

(defun mir-inline-local-functions (unit &key (body-budget 48) (growth-budget 256))
  (let* ((functions (hir-vector (mir-unit-functions unit)))
         (outgoing (mir-known-call-graph functions (map 'simple-vector #'mir-function-identities functions)))
         (recursive 0))
    (dolist (component (mir-strong-components outgoing))
      (when (or (cdr component)
                (member (first component) (svref outgoing (first component))))
        (dolist (id component) (setf recursive (logior recursive (ash 1 id))))))
    (loop for caller across functions do
      (let ((growth 0))
        (loop
          (let ((known (mir-function-identities caller))
                (reachable (mir-reachable-blocks caller)) (selected nil))
            (loop for block across (hir-vector (mir-function-blocks caller))
                  when (logbitp (mir-block-id block) reachable) do
                    (loop for id across (hir-vector (mir-block-instructions block))
                          for instruction = (mir-at (mir-function-instructions caller) id)
                          when (and (= (mir-instruction-kind instruction) 7)
                                    (not (mir-instruction-notinline instruction))
                                    (hir-policy-optimize-p (mir-instruction-policy instruction))
                                    (< (hir-policy-quality (mir-function-policy caller) :debug) 2)
                                    (< (hir-policy-quality (mir-instruction-policy instruction) :debug) 2))
                            do (let* ((target (svref known (svref (mir-instruction-operands instruction) 0)))
                                      (callee (and (integerp target) (svref functions target)))
                                      (argument-count (1- (length (mir-instruction-operands instruction))))
                                      (cost (and callee (not (eq caller callee))
                                                 (not (logbitp target recursive))
                                                 (<= (mir-function-required callee) argument-count)
                                                 (or (null (mir-function-maximum callee))
                                                     (<= argument-count (mir-function-maximum callee)))
                                                 (mir-inlining-cost callee argument-count))))
                                 (when (and cost (<= cost body-budget) (<= (+ growth cost) growth-budget))
                                   (setf selected (list block instruction callee cost))
                                   (return))))
                  when selected do (return))
            (unless selected (return))
            (destructuring-bind (block call callee cost) selected
              (incf growth cost)
              (mir-run-pass unit caller (lambda (caller) (mir-inline-call caller block call callee)))))))))
  unit)
