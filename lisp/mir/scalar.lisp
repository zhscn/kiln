(in-package #:kiln.compiler)

(defun mir-cons-origins (function packets)
  "Track a definite cons site; possible-object sets alone cannot exclude NIL."
  (let* ((origins (make-array (hir-buffer-count (mir-function-values function)) :initial-element :unseen))
         (blocks (hir-vector (mir-function-blocks function)))
         (reachable (mir-reachable-blocks function)) (changed t))
    (labels ((merge-origin (id origin)
               (let ((joined (mir-function-identity-join (svref origins id) origin)))
                 (unless (eql joined (svref origins id))
                   (setf (svref origins id) joined changed t))))
             (single-p (id)
               (let ((fact (svref packets id)))
                 (and (mir-values-fact-p fact) (eql 1 (mir-values-fact-count fact)))))
             (transfer (instruction)
               (let ((args (mir-instruction-operands instruction)))
                 (case (mir-instruction-kind instruction)
                   ((9 11) (svref origins (svref args 0)))
                   ((10 14) (if (and (single-p (svref args 0))
                                    (or (= 10 (mir-instruction-kind instruction))
                                        (zerop (mir-instruction-data instruction))))
                                (svref origins (svref args 0)) :unknown))
                   (6 (cond ((mir-cons-allocation-p instruction) (mir-instruction-id instruction))
                            ((and (mir-borrow-call-p instruction)
                                  (or (and (= 1 (length args)) (member (mir-instruction-data instruction) '(identity values)))
                                      (member (mir-instruction-data instruction) '(rplaca rplacd))))
                             (svref origins (svref args 0)))
                            (t :unknown)))
                   (otherwise :unknown)))))
      (loop while changed do
        (setf changed nil)
        (loop for block across blocks when (logbitp (mir-block-id block) reachable) do
          (loop for id across (hir-vector (mir-block-instructions block))
                for instruction = (mir-at (mir-function-instructions function) id)
                when (mir-instruction-result instruction)
                  do (merge-origin (mir-instruction-result instruction) (transfer instruction)))
          (loop for edge across (mir-terminator-edges (mir-block-terminator block)) do
            (loop for parameter across (mir-block-parameters (svref blocks (mir-edge-target edge)))
                  for argument across (mir-edge-arguments edge)
                  do (merge-origin parameter (svref origins argument)))))))
    origins))

(defun mir-scalar-policy-p (function)
  (and (< (hir-policy-quality (mir-function-policy function) :debug) 2)
       (every (lambda (instruction) (< (hir-policy-quality (mir-instruction-policy instruction) :debug) 2))
              (hir-vector (mir-function-instructions function)))))

(defun mir-scalar-candidates (function proof origins types packets)
  "Require every use to forward a virtual object or access its definite fields."
  (unless (mir-scalar-policy-p function) (return-from mir-scalar-candidates nil))
  (let ((candidates (mir-storage-analysis-stack proof))
        (points (mir-storage-analysis-points proof)))
    (labels ((allowed (instruction index origin)
               (let ((kind (mir-instruction-kind instruction)) (args (mir-instruction-operands instruction)))
                 (case kind
                   ((9 10) t)
                   (11 (and (integerp origin)
                            (= (svref points (svref args 0)) (ash 1 (1+ origin)))
                            (mir-check-proven-p instruction types)))
                   (14 (let ((fact (svref packets (svref args 0))))
                         (and (mir-values-fact-p fact) (eql 1 (mir-values-fact-count fact)))))
                   (6 (and (mir-borrow-call-p instruction)
                           (let ((name (mir-instruction-data instruction)))
                             (or (and (= 1 (length args)) (member name '(identity values)))
                                 (and (zerop index) (member name '(car cdr first rest rplaca rplacd))
                                      (integerp origin)
                                      (= (svref points (svref args 0)) (ash 1 (1+ origin))))))))
                   (otherwise nil)))))
      (loop for block across (hir-vector (mir-function-blocks function)) do
        (loop for id across (hir-vector (mir-block-instructions block))
              for instruction = (mir-at (mir-function-instructions function) id) do
          (loop for argument across (mir-instruction-operands instruction) for index from 0
                for bits = (logand candidates (svref points argument))
                when (not (zerop bits)) do
                  (unless (allowed instruction index (svref origins argument))
                    (setf candidates (logand candidates (lognot bits))))))
        (loop for argument across (mir-terminator-operands (mir-block-terminator block))
              do (setf candidates (logand candidates (lognot (svref points argument)))))))
    ;; Bound the extra SSA parameters and edge arguments before changing CFG.
    (let ((limit (min 32 (floor 4096 (max 1 (* 2 (hir-buffer-count (mir-function-blocks function)))))))
          (result nil))
      (dotimes (id (hir-buffer-count (mir-function-instructions function)))
        (when (and (plusp limit) (logbitp (1+ id) candidates))
          (push id result) (decf limit)))
      (nreverse result))))

(defun mir-promote-cons-fields (function candidates origins)
  "Append field SSA parameters and replace accesses using each block's state."
  (let* ((instructions (mir-function-instructions function))
         (blocks (hir-vector (mir-function-blocks function)))
         (indices (make-array (hir-buffer-count instructions) :initial-element nil))
         (width (* 2 (length candidates)))
         (nil-id (mir-add-value function :obj 0 0))
         (nil-instruction (hir-buffer-count instructions)))
    (loop for site in candidates for index from 0 by 2 do (setf (svref indices site) index))
    (hir-push (make-mir-instruction :id nil-instruction :kind 0 :result nil-id :data nil :policy (mir-function-policy function)) instructions)
    (loop for block across blocks unless (zerop (mir-block-id block)) do
      (setf (mir-block-parameters block)
            (concatenate 'simple-vector (mir-block-parameters block)
                         (map 'simple-vector (lambda (unused)
                                               (declare (ignore unused))
                                               (mir-add-value function :obj (mir-block-id block) -1))
                              (make-array width)))))
    (labels ((replace-operation (instruction kind args)
               (setf (mir-instruction-kind instruction) kind (mir-instruction-operands instruction) args
                     (mir-instruction-data instruction) nil (mir-instruction-notinline instruction) nil
                     (mir-instruction-effects instruction) (svref *mir-instruction-effects* kind))))
      (loop for block across blocks
            for state = (if (zerop (mir-block-id block)) (make-array width :initial-element nil-id)
                            (subseq (mir-block-parameters block) (- (length (mir-block-parameters block)) width)))
            for body = (hir-vector (mir-block-instructions block))
            for rebuilt = (make-hir-buffer) do
        (when (zerop (mir-block-id block)) (hir-push nil-instruction rebuilt))
        (loop for id across body for instruction = (mir-at instructions id)
              for kind = (mir-instruction-kind instruction) for args = (mir-instruction-operands instruction)
              for site = (and (plusp (length args)) (svref origins (svref args 0)))
              for index = (and (integerp site) (svref indices site)) do
          (cond ((svref indices id)
                 (let ((offset (svref indices id)))
                   (setf (svref state offset) (svref args 0) (svref state (1+ offset)) (svref args 1)))
                 (replace-operation instruction 9 (vector nil-id)))
                ((and index (= kind 6) (member (mir-instruction-data instruction) '(car cdr first rest)))
                 (replace-operation instruction 9
                                    (vector (svref state (+ index (if (member (mir-instruction-data instruction) '(cdr rest)) 1 0))))))
                ((and index (= kind 6) (member (mir-instruction-data instruction) '(rplaca rplacd)))
                 (setf (svref state (+ index (if (eq (mir-instruction-data instruction) 'rplacd) 1 0))) (svref args 1))
                 (replace-operation instruction 9 (vector (svref args 0))))
                ((and index (= kind 11))
                 (if (eq (mir-value-representation (mir-at (mir-function-values function) (mir-instruction-result instruction))) :obj)
                     (replace-operation instruction 0 #())
                     (replace-operation instruction 9 (vector nil-id)))))
          (hir-push id rebuilt))
        (loop for id across (hir-vector rebuilt) for position from 0
              for result = (mir-instruction-result (mir-at instructions id))
              when result do (setf (mir-value-position (mir-at (mir-function-values function) result)) position))
        (setf (mir-block-instructions block) rebuilt)
        (loop for edge across (mir-terminator-edges (mir-block-terminator block))
              do (setf (mir-edge-arguments edge) (concatenate 'simple-vector (mir-edge-arguments edge) state)))))
    function))

(defun mir-scalar-replace (unit)
  (loop for function across (hir-vector (mir-unit-functions unit)) when (mir-scalar-policy-p function) do
    (let* ((calls (mir-infer-calls unit)) (id (mir-function-id function))
           (packets (svref (mir-call-analysis-packets calls) id))
           (origins (mir-cons-origins function packets))
           (candidates (mir-scalar-candidates function (svref (mir-infer-storage unit) id) origins
                                              (svref (mir-call-analysis-types calls) id) packets)))
      (when candidates
        (mir-run-pass unit function (lambda (function) (mir-promote-cons-fields function candidates origins))))))
  unit)
