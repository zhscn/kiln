(in-package #:kiln.compiler)

(defstruct mir-call-analysis identities outgoing components external inputs capture-inputs cell-types cell-aliases summaries value-summaries types packets)

(defun mir-function-identity-join (old new)
  (cond ((eq old :unseen) new) ((eq new :unseen) old)
        ((eql old new) old) (t :unknown)))

(defun mir-compute-function-identities (function &key inputs summaries (finalize t) (trust-captures t))
  "Track one local function ID, or :UNKNOWN, through primary values."
  (let* ((identities (make-array (hir-buffer-count (mir-function-values function))
                                 :initial-element :unseen))
         (blocks (hir-buffer-view (mir-function-blocks function)))
         (reachable (mir-reachable-blocks function))
         (users (mir-value-use-blocks function))
         (queued (make-array (length blocks) :initial-element nil))
         (work (make-hir-buffer)))
    (labels ((enqueue (id)
               (unless (svref queued id)
                 (setf (svref queued id) t)
                 (hir-push id work)))
             (merge-identity (id identity)
               (let ((joined (mir-function-identity-join (svref identities id) identity)))
                 (unless (eql joined (svref identities id))
                   (setf (svref identities id) joined)
                   (dolist (block (svref users id)) (enqueue block)))))
             (transfer (instruction)
               (let ((args (mir-instruction-operands instruction)))
                 (case (mir-instruction-kind instruction)
                   ((5 23) (mir-instruction-data instruction))
                   (1 (let ((index (mir-instruction-data instruction)))
                        (if (and inputs (< index (length inputs))) (svref inputs index) :unknown)))
                   ((7 15) (let ((target (svref identities (svref args 0))))
                             (cond ((eq target :unseen) :unseen)
                                   ((and summaries (integerp target)) (svref summaries target))
                                   (t :unknown))))
                   (22 (or (and trust-captures
                                (svref (mir-function-capture-functions function) (mir-instruction-data instruction)))
                           :unknown))
                   ((3 9 10 11 39) (svref identities (svref args 0)))
                   (14 (if (zerop (mir-instruction-data instruction))
                           (svref identities (svref args 0)) :unknown))
                   (6 (if (and (member (mir-instruction-data instruction) '(identity values))
                               (plusp (length args)))
                          (svref identities (svref args 0)) :unknown))
                   (otherwise :unknown)))))
      (loop for block across blocks when (logbitp (mir-block-id block) reachable)
            do (enqueue (mir-block-id block)))
      (loop for cursor from 0 while (< cursor (hir-buffer-count work))
            for block-id = (mir-at work cursor) for block = (svref blocks block-id) do
        (setf (svref queued block-id) nil)
        (loop for id across (hir-buffer-view (mir-block-instructions block))
              for instruction = (mir-at (mir-function-instructions function) id)
              for result = (mir-instruction-result instruction)
              when result do (merge-identity result (transfer instruction)))
        (loop for edge across (mir-terminator-edges (mir-block-terminator block)) do
          (loop for parameter across (mir-block-parameters (svref blocks (mir-edge-target edge)))
                for argument across (mir-edge-arguments edge)
                do (merge-identity parameter (svref identities argument))))))
    (when finalize
      (dotimes (id (length identities))
        (when (eq (svref identities id) :unseen) (setf (svref identities id) :unknown))))
    identities))

(defun mir-function-identities (function)
  (mir-analysis function :functions #'mir-compute-function-identities))

(defun mir-strong-components (outgoing)
  "Return integer-indexed graph SCCs with successors before predecessors."
  (let* ((count (length outgoing)) (indices (make-array count :initial-element -1))
         (low (make-array count :initial-element 0)) (active (make-array count :initial-element nil))
         (stack nil) (next 0) (components nil))
    (labels ((visit (id)
               (setf (svref indices id) next (svref low id) next (svref active id) t)
               (incf next) (push id stack)
               (dolist (callee (svref outgoing id))
                 (cond ((minusp (svref indices callee))
                        (visit callee) (setf (svref low id) (min (svref low id) (svref low callee))))
                       ((svref active callee)
                        (setf (svref low id) (min (svref low id) (svref indices callee))))))
               (when (= (svref low id) (svref indices id))
                 (let ((component nil))
                   (loop for member = (pop stack)
                         do (setf (svref active member) nil) (push member component)
                         until (= member id))
                   (push component components)))))
      (dotimes (id count) (when (minusp (svref indices id)) (visit id))))
    (nreverse components)))

(defun mir-return-type (function types)
  (let ((result :unseen) (reachable (mir-reachable-blocks function)))
    (loop for block across (hir-buffer-view (mir-function-blocks function))
          for term = (mir-block-terminator block)
          when (and (logbitp (mir-block-id block) reachable) (= (mir-terminator-kind term) 2))
            do (setf result (mir-type-join result (svref types (svref (mir-terminator-operands term) 0)))))
    result))

(defun mir-return-values (function packets)
  (let ((result :unseen) (reachable (mir-reachable-blocks function))
        (expansions (make-array +mir-values-prefix-limit+ :initial-element 0)))
    (loop for block across (hir-buffer-view (mir-function-blocks function))
          for term = (mir-block-terminator block)
          when (and (logbitp (mir-block-id block) reachable) (= (mir-terminator-kind term) 2))
            do (setf result (mir-join-values result
                             (svref packets (svref (mir-terminator-operands term) 0)) expansions)))
    result))

(defun mir-compute-contained-functions (function)
  "Overapproximate local functions carried by each scalar or saved bundle."
  (let* ((sets (make-array (hir-buffer-count (mir-function-values function)) :initial-element 0))
         (blocks (hir-buffer-view (mir-function-blocks function)))
         (reachable (mir-reachable-blocks function))
         (users (mir-value-use-blocks function))
         (queued (make-array (length blocks) :initial-element nil))
         (work (make-hir-buffer)))
    (labels ((enqueue (id)
               (unless (svref queued id)
                 (setf (svref queued id) t)
                 (hir-push id work)))
             (merge-set (id bits)
               (let ((old (svref sets id)))
                 (unless (or (zerop bits) (= old bits))
                   (let ((joined (logior old bits)))
                     (unless (= joined old)
                       (setf (svref sets id) joined)
                       (dolist (block (svref users id)) (enqueue block)))))))
             (transfer (instruction)
               (let ((args (mir-instruction-operands instruction)))
                 (case (mir-instruction-kind instruction)
                   ((5 23) (ash 1 (mir-instruction-data instruction)))
                   (22 (let ((target (svref (mir-function-capture-functions function) (mir-instruction-data instruction))))
                         (if target (ash 1 target) 0)))
                   ((3 9 10 11 14 39) (svref sets (svref args 0)))
                   (6 (case (mir-instruction-data instruction)
                        (identity (if (plusp (length args)) (svref sets (svref args 0)) 0))
                        (values (loop for arg across args for bits = (svref sets arg)
                                      with result = 0 do (setf result (logior result bits))
                                      finally (return result)))
                        (otherwise 0)))
                   (otherwise 0)))))
      (loop for block across blocks when (logbitp (mir-block-id block) reachable)
            do (enqueue (mir-block-id block)))
      (loop for cursor from 0 while (< cursor (hir-buffer-count work))
            for block-id = (mir-at work cursor) for block = (svref blocks block-id) do
        (setf (svref queued block-id) nil)
        (loop for id across (hir-buffer-view (mir-block-instructions block))
              for instruction = (mir-at (mir-function-instructions function) id)
              for result = (mir-instruction-result instruction)
              when result do (merge-set result (transfer instruction)))
        (loop for edge across (mir-terminator-edges (mir-block-terminator block)) do
          (loop for parameter across (mir-block-parameters (svref blocks (mir-edge-target edge)))
                for argument across (mir-edge-arguments edge)
                do (merge-set parameter (svref sets argument))))))
    sets))

(defun mir-contained-functions (function)
  ;; This result depends on the body and capture layout, not call summaries.
  (if *mir-verification-identities*
      (mir-compute-contained-functions function)
      (mir-analysis function :contained-functions #'mir-compute-contained-functions)))

(defun mir-external-functions (functions identities &optional (entries #()))
  "Find functions that may be invoked outside the known local call sites."
  (let ((external 1))
    (loop for id across entries do (setf external (logior external (ash 1 id))))
    (loop for function across functions for known across identities
          for sets = (mir-contained-functions function)
          for reachable = (mir-reachable-blocks function) do
      ;; Unconstructed bodies still read captured functions through their public ABI.
      (loop for target across (mir-function-capture-functions function) when target
            do (setf external (logior external (ash 1 target))))
      (loop for block across (hir-buffer-view (mir-function-blocks function))
            when (logbitp (mir-block-id block) reachable) do
        (loop for id across (hir-buffer-view (mir-block-instructions block))
              for instruction = (mir-at (mir-function-instructions function) id)
              for kind = (mir-instruction-kind instruction)
              for args = (mir-instruction-operands instruction) do
          ;; A known code identity does not carry the actual closure environment
          ;; needed by a private entry. Passed function values retain public entries.
          (unless (or (member kind '(0 1 2 4 5 9 10 12 13 14 16 22 23 25 37 39))
                      (and (= kind 6) (member (mir-instruction-data instruction) '(identity values))))
            (loop for arg across args for index from 0
                  unless (and (zerop index) (or (= kind 24) (and (member kind '(7 15)) (integerp (svref known arg)))))
                    do (setf external (logior external (svref sets arg))))))
        (let ((term (mir-block-terminator block)))
          (when (member (mir-terminator-kind term) '(2 4 7))
            (loop for argument across (mir-terminator-operands term)
                  do (setf external (logior external (svref sets argument))))))))
    external))

(defstruct mir-function-flow identities external inputs summaries outgoing recursive)

(defun mir-compute-function-flow (unit)
  "Propagate local code identities through closed positional inputs and primary returns."
  ;; Preserve the local escape analysis as an independent upper bound. In
  ;; particular, passing a function object still exposes its public entry.
  (let* ((functions (hir-buffer-view (mir-unit-functions unit)))
         (count (length functions))
         (external (mir-external-functions functions (map 'simple-vector #'mir-function-identities functions)
                                           (mir-unit-load-time-functions unit)))
         (inputs (map 'simple-vector (lambda (function)
                                      (make-array (mir-function-positional-count function)
                                                  :initial-element (if (logbitp (mir-function-id function) external)
                                                                       :unknown :unseen))) functions))
         (summaries (make-array count :initial-element :unseen))
         (identities (make-array count))
         (callers (make-array count :initial-element 0))
         (queued (make-array count :initial-element nil))
         (work (make-hir-buffer)) (cursor 0))
    (labels ((enqueue (id)
               (unless (svref queued id)
                 (setf (svref queued id) t)
                 (hir-push id work)))
             (notify-callers (id)
               (loop with bits = (svref callers id) while (plusp bits)
                     for caller = (1- (integer-length (logand bits (- bits))))
                     do (enqueue caller) (setf bits (logand bits (1- bits)))))
             (merge-identity (row index value)
               (let ((joined (mir-function-identity-join (svref row index) value)))
                 (unless (eql joined (svref row index))
                   (setf (svref row index) joined) t)))
             (solve ()
               (loop while (< cursor (hir-buffer-count work))
                     for id = (mir-at work cursor)
                     for function = (svref functions id) do
                 (incf cursor)
                 (setf (svref queued id) nil)
                 (let ((known (mir-compute-function-identities function :inputs (svref inputs id)
                                                                       :summaries summaries :finalize nil))
                       (reachable (mir-reachable-blocks function)))
                   (setf (svref identities id) known)
                   (loop for block across (hir-buffer-view (mir-function-blocks function))
                         when (logbitp (mir-block-id block) reachable) do
                     (loop for index across (hir-buffer-view (mir-block-instructions block))
                           for instruction = (mir-at (mir-function-instructions function) index)
                           for kind = (mir-instruction-kind instruction)
                           for args = (mir-instruction-operands instruction)
                           when (member kind '(7 15)) do
                       (let* ((target (svref known (svref args 0)))
                              (callee (and (integerp target) (svref functions target)))
                              (argc (1- (length args))))
                         (when callee
                           ;; Returned identities depend on this summary even
                           ;; when no positional input can be propagated.
                           (setf (svref callers target) (logior (svref callers target) (ash 1 id)))
                           (when (or (= kind 15)
                                     (and (<= (mir-function-required callee) argc)
                                          (or (null (mir-function-maximum callee))
                                              (<= argc (mir-function-maximum callee)))))
                             (let ((row (svref inputs target)))
                               (dotimes (slot (length row))
                                 (when (merge-identity row slot
                                          (if (and (= kind 7) (< slot argc))
                                              (svref known (svref args (1+ slot))) :unknown))
                                   (enqueue target))))))))
                     (let ((term (mir-block-terminator block)))
                       (when (and (= (mir-terminator-kind term) 2)
                                  (merge-identity summaries id (svref known (svref (mir-terminator-operands term) 0))))
                         (notify-callers id))))))))
      (dotimes (id count) (enqueue id))
      (solve)
      ;; Uncalled functions and unseeded recursive groups need public-safe
      ;; code too. Only consumers of newly unknown facts need another visit.
      (loop for row across inputs for id from 0 do
        (dotimes (index (length row))
          (when (eq (svref row index) :unseen)
            (setf (svref row index) :unknown) (enqueue id))))
      (dotimes (id count)
        (when (eq (svref summaries id) :unseen)
          (setf (svref summaries id) :unknown) (notify-callers id)))
      (solve)
      (loop for row across identities do
        (dotimes (index (length row))
          (when (eq (svref row index) :unseen) (setf (svref row index) :unknown))))
      (let ((outgoing (mir-known-call-graph functions identities)) (recursive 0))
        (dolist (component (mir-strong-components outgoing))
          (when (or (cdr component)
                    (member (first component) (svref outgoing (first component))))
            (dolist (id component) (setf recursive (logior recursive (ash 1 id))))))
        (make-mir-function-flow :identities identities :external external :inputs inputs
                                :summaries summaries :outgoing outgoing :recursive recursive)))))

(defun mir-infer-function-flow (unit)
  (mir-unit-analysis unit :function-flow #'mir-compute-function-flow))


(defun mir-widen-summary (old candidate expansions)
  (let ((joined (mir-type-join old candidate)))
    (when (and (hir-range-p old) (hir-range-p joined) (not (equal old joined)))
      (incf expansions)
      (when (>= expansions 2) (setf joined (hir-widen-integer-type joined))))
    (values joined expansions)))

(defun mir-entry-vector-dimension-checks (function)
  (mir-analysis function :entry-vector-dimension-checks
    (lambda (function)
      (let ((entry (mir-at (mir-function-blocks function) 0))
            (definitions (mir-value-definitions function))
            (checks nil))
        (loop for id across (hir-buffer-view (mir-block-instructions entry))
              for position from 0
              for instruction = (mir-at (mir-function-instructions function) id)
              ;; A handler can leave the entry before a constructor returns.
              when (member (mir-instruction-kind instruction) '(30 32 34 35))
                return nil
              do (let ((origin (mir-checked-vector-dimension instruction definitions)))
                   (when (and origin (not (assoc origin checks)))
                     (push (cons origin position) checks)))
              finally (return checks))))))

(defun mir-checked-call-argument-type (id facts checks definitions prior)
  (let ((type (svref facts id)))
    (if (and checks (not (eq type :unseen))
             (let ((check (assoc (mir-primary-origin id definitions) checks)))
               (and check (or (null prior) (< (cdr check) prior)))))
        (hir-type-intersection type (hir-integer-range 0 +hir-vector-max-length+))
        type)))

(defun mir-call-argument-types (instruction facts packets required
                                &optional (maximum required) checks definitions prior)
  "Flatten call facts, or return :UNSEEN, :UNKNOWN or :WRONG-ARITY.
:UNKNOWN also returns the fixed leading argument types as a second value."
  (let* ((args (mir-instruction-operands instruction)) (prefix (mir-call-prefix-count instruction)))
    (if (= (mir-instruction-kind instruction) 7)
        (if (and (<= required (1- (length args))) (or (null maximum) (<= (1- (length args)) maximum)))
            (map 'simple-vector
                 (lambda (id) (mir-checked-call-argument-type id facts checks definitions prior))
                 (subseq args 1))
            :wrong-arity)
        (let ((count prefix) (unknown nil))
          (loop for index from (1+ prefix) below (length args) for packet = (svref packets (svref args index))
                do (when (eq packet :unseen) (return-from mir-call-argument-types :unseen))
                   (if (mir-values-fact-count packet) (incf count (mir-values-fact-count packet))
                       (setf unknown t)))
          (when unknown
            (let ((leading nil))
              (loop for index from 1 to prefix do (push (svref facts (svref args index)) leading))
              (loop for index from (1+ prefix) below (length args) for packet = (svref packets (svref args index))
                    for count = (mir-values-fact-count packet)
                    while count do (dotimes (slot count) (push (mir-values-ref-type packet slot) leading)))
              (return-from mir-call-argument-types (values :unknown (coerce (nreverse leading) 'simple-vector)))))
          (unless (and (<= required count) (or (null maximum) (<= count maximum))) (return-from mir-call-argument-types :wrong-arity))
          (let ((result (make-array count)) (position prefix))
            (loop for index from 1 to prefix do (setf (svref result (1- index)) (svref facts (svref args index))))
            (loop for index from (1+ prefix) below (length args) for packet = (svref packets (svref args index))
                  do (dotimes (slot (mir-values-fact-count packet))
                       (setf (svref result position) (mir-values-ref-type packet slot)) (incf position)))
            result)))))

(defstruct mir-cell-aliases sites points captures arguments (count 0))

(defun mir-propagate-cell-aliases (functions sites points captures arguments identities)
  (let ((changed nil))
    (labels ((merge-bits (row index bits)
               (let ((joined (logior (svref row index) bits)))
                 (unless (= joined (svref row index)) (setf (svref row index) joined changed t)))))
      (loop for function across functions for id from 0 for row across points
            for known across identities
            for reachable = (mir-reachable-blocks function) do
        (loop for block across (hir-buffer-view (mir-function-blocks function))
              when (logbitp (mir-block-id block) reachable) do
          (loop for index across (hir-buffer-view (mir-block-instructions block))
                for instruction = (mir-at (mir-function-instructions function) index)
                for args = (mir-instruction-operands instruction) do
            (case (mir-instruction-kind instruction)
              (1 (let ((slot (mir-instruction-data instruction)))
                   (when (logbitp slot (mir-function-argument-cells function))
                     (merge-bits row (mir-instruction-result instruction) (svref (svref arguments id) slot)))))
              ((7 15)
               (let ((target (svref known (svref args 0))))
                 (when (integerp target)
                   (dotimes (slot (mir-function-internal-prefix (svref functions target)))
                     (when (logbitp slot (mir-function-argument-cells (svref functions target)))
                       (merge-bits (svref arguments target) slot (svref row (svref args (1+ slot)))))))))
              (19 (merge-bits row (mir-instruction-result instruction) (ash 1 (1+ (svref (svref sites id) index)))))
              (22 (let ((slot (mir-instruction-data instruction)))
                    (when (logbitp slot (mir-function-capture-cells function))
                      (merge-bits row (mir-instruction-result instruction) (svref (svref captures id) slot)))))
              (24 (let* ((data (mir-instruction-data instruction)) (target (svref functions (car data))))
                    (when (logbitp (cdr data) (mir-function-capture-cells target))
                      (merge-bits (svref captures (car data)) (cdr data) (svref row (svref args 1))))))))
          (loop for edge across (mir-terminator-edges (mir-block-terminator block)) do
            (loop for parameter across (mir-block-parameters (mir-at (mir-function-blocks function) (mir-edge-target edge)))
                  for arg across (mir-edge-arguments edge) do (merge-bits row parameter (svref row arg)))))))
    changed))

(defun mir-compute-cell-aliases (unit)
  "Track opaque cell identities through SSA and closure environment slots."
  (let* ((functions (hir-buffer-view (mir-unit-functions unit))) (count 0)
         (sites (map 'simple-vector (lambda (function)
                                     (make-array (hir-buffer-count (mir-function-instructions function)) :initial-element nil)) functions))
         (points (map 'simple-vector (lambda (function)
                                      (make-array (hir-buffer-count (mir-function-values function)) :initial-element 0)) functions))
         (captures (map 'simple-vector (lambda (function) (make-array (length (mir-function-captures function)) :initial-element 0)) functions))
         (arguments (map 'simple-vector (lambda (function) (make-array (mir-function-internal-prefix function) :initial-element 0)) functions))
         (identities (map 'simple-vector #'mir-function-identities functions)))
    (loop for function across functions for row across sites do
      (loop for instruction across (hir-buffer-view (mir-function-instructions function))
            when (= 19 (mir-instruction-kind instruction))
              do (setf (svref row (mir-instruction-id instruction)) count) (incf count)))
    (loop while (mir-propagate-cell-aliases functions sites points captures arguments identities))
    ;; Unseeded environments may denote cells outside the known site set.
    (loop for function across functions for row across captures do
      (dotimes (slot (length row))
        (when (and (logbitp slot (mir-function-capture-cells function)) (zerop (svref row slot)))
          (setf (svref row slot) 1))))
    (loop for function across functions for row across arguments do
      (dotimes (slot (length row))
        (when (and (logbitp slot (mir-function-argument-cells function)) (zerop (svref row slot)))
          (setf (svref row slot) 1))))
    (loop while (mir-propagate-cell-aliases functions sites points captures arguments identities))
    (make-mir-cell-aliases :sites sites :points points :captures captures :arguments arguments :count count)))

(defun mir-infer-cell-aliases (unit)
  (mir-unit-analysis unit :cell-aliases #'mir-compute-cell-aliases))

(defun mir-known-call-graph (functions identities)
  "Collect reachable local-call edges from SSA function identities."
  (let ((outgoing (make-array (length functions) :initial-element nil)))
    (loop for function across functions for known across identities
          for id = (mir-function-id function) for reachable = (mir-reachable-blocks function)
          do (loop for block across (hir-buffer-view (mir-function-blocks function))
                   when (logbitp (mir-block-id block) reachable) do
                     (loop for index across (hir-buffer-view (mir-block-instructions block))
                           for instruction = (mir-at (mir-function-instructions function) index)
                           when (member (mir-instruction-kind instruction) '(7 15)) do
                             (let ((target (svref known (svref (mir-instruction-operands instruction) 0))))
                               (when (integerp target) (pushnew target (svref outgoing id)))))))
    outgoing))

(defun mir-compute-calls (unit)
  (let* ((functions (hir-buffer-view (mir-unit-functions unit))) (count (length functions))
         (flow (mir-infer-function-flow unit))
         (identities (mir-function-flow-identities flow))
         (external (mir-function-flow-external flow))
         (outgoing (make-array count :initial-element nil))
         (summaries (make-array count :initial-element :unseen))
         (changes (make-array count :initial-element 0))
         (value-summaries (make-array count :initial-element :unseen))
         (value-changes (map 'simple-vector
                             (lambda (function) (declare (ignore function))
                               (make-array +mir-values-prefix-limit+ :initial-element 0)) functions))
         (inputs (map 'simple-vector
                      (lambda (function)
                        (make-array (mir-function-positional-count function)
                                    :initial-element (if (logbitp (mir-function-id function) external) t :unseen)))
                      functions))
         (input-changes (map 'simple-vector
                             (lambda (function) (make-array (mir-function-positional-count function) :initial-element 0))
                             functions))
         (capture-inputs (map 'simple-vector
                              (lambda (function)
                                (let ((row (make-array (length (mir-function-captures function)) :initial-element :unseen)))
                                  (dotimes (slot (length row) row)
                                    (cond ((logbitp slot (mir-function-capture-cells function)) (setf (svref row slot) t))
                                          ((svref (mir-function-capture-functions function) slot)
                                           (setf (svref row slot) 'function))))))
                              functions))
         (capture-changes (map 'simple-vector (lambda (row) (make-array (length row) :initial-element 0)) capture-inputs))
         (cell-aliases (mir-infer-cell-aliases unit))
         (cell-types (make-array (mir-cell-aliases-count cell-aliases) :initial-element :unseen))
         (cell-changes (make-array (length cell-types) :initial-element 0))
         (types (make-array count)) (packets (make-array count)))
    (setf outgoing (mir-function-flow-outgoing flow))
    (let ((components (mir-strong-components outgoing))
          (callers (make-array count :initial-element 0))
          (cell-readers (make-array (length cell-types) :initial-element 0))
          (queued (make-array count :initial-element nil))
          (work (make-hir-buffer)) (cursor 0))
      (loop for targets across outgoing for caller from 0 do
        (dolist (target targets)
          (setf (svref callers target) (logior (svref callers target) (ash 1 caller)))))
      (loop for function across functions for id from 0
            for points = (svref (mir-cell-aliases-points cell-aliases) id) do
        (loop for instruction across (hir-buffer-view (mir-function-instructions function))
              when (= 20 (mir-instruction-kind instruction)) do
          (let ((bits (svref points (svref (mir-instruction-operands instruction) 0))))
            (dotimes (site (length cell-types))
              (when (or (logbitp 0 bits) (logbitp (1+ site) bits))
                (setf (svref cell-readers site) (logior (svref cell-readers site) (ash 1 id))))))))
      (labels ((enqueue (id)
                 (unless (svref queued id)
                   (setf (svref queued id) t)
                   (hir-push id work)))
               (enqueue-users (bits)
                 (loop while (plusp bits)
                       for id = (1- (integer-length (logand bits (- bits))))
                       do (enqueue id) (setf bits (logand bits (1- bits)))))
               (merge-fact (row counts position candidate consumers)
                 (let ((old (svref row position)))
                   (multiple-value-bind (joined expansions)
                       (mir-widen-summary old candidate (svref counts position))
                     (setf (svref counts position) expansions)
                     (unless (equal old joined)
                       (setf (svref row position) joined)
                       (enqueue-users consumers)))))
               (merge-inputs (function facts packets known)
                 (let* ((id (mir-function-id function)) (reachable (mir-reachable-blocks function))
                        (cell-points (svref (mir-cell-aliases-points cell-aliases) id))
                        (checks (and (svref outgoing id) (mir-entry-vector-dimension-checks function)))
                        (definitions (and checks (mir-value-definitions function))))
                   (loop for block across (hir-buffer-view (mir-function-blocks function))
                         when (logbitp (mir-block-id block) reachable) do
                     (loop for index across (hir-buffer-view (mir-block-instructions block))
                           for instruction-position from 0
                           for instruction = (mir-at (mir-function-instructions function) index)
                           for args = (mir-instruction-operands instruction) do
                       (case (mir-instruction-kind instruction)
                         ((7 15)
                          (let ((target (svref known (svref args 0))))
                            (when (integerp target)
                              (let ((row (svref inputs target)) (counts (svref input-changes target)))
                                (multiple-value-bind (arguments prefix)
                                    (mir-call-argument-types instruction facts packets
                                                             (mir-function-required (svref functions target))
                                                             (mir-function-maximum (svref functions target))
                                                             checks definitions
                                                             (and (zerop (mir-block-id block)) instruction-position))
                                  (when (or (vectorp arguments) (eq arguments :unknown))
                                    (dotimes (position (length row))
                                      (merge-fact row counts position
                                                  (cond ((eq arguments :unknown)
                                                         (if (< position (length prefix)) (svref prefix position) t))
                                                        ((< position (length arguments)) (svref arguments position))
                                                        (t 'null)) (ash 1 target)))))))))
                         (24 (let* ((data (mir-instruction-data instruction)) (target (car data)) (slot (cdr data)))
                               (unless (logbitp slot (mir-function-capture-cells (svref functions target)))
                                 (merge-fact (svref capture-inputs target) (svref capture-changes target) slot
                                             (svref facts (svref args 1)) (ash 1 target)))))
                         (19 (let ((site (svref (svref (mir-cell-aliases-sites cell-aliases) id) index)))
                               (merge-fact cell-types cell-changes site
                                           (svref facts (svref args 0)) (svref cell-readers site))))
                         (21 (let ((bits (svref cell-points (svref args 0))))
                               (dotimes (site (length cell-types))
                                 (when (or (logbitp 0 bits) (logbitp (1+ site) bits))
                                   (merge-fact cell-types cell-changes site (svref facts (svref args 1))
                                               (svref cell-readers site)))))))))))
               (solve ()
                 (loop while (< cursor (hir-buffer-count work))
                       for id = (mir-at work cursor)
                       for function = (svref functions id) do
                   (incf cursor)
                   (setf (svref queued id) nil)
                   (multiple-value-bind (facts packet-facts)
                       (mir-compute-types function :summaries summaries :value-summaries value-summaries
                                          :functions (svref identities id)
                                          :inputs (svref inputs id) :captures (svref capture-inputs id)
                                          :cell-types cell-types :cell-points (svref (mir-cell-aliases-points cell-aliases) id)
                                          :finalize nil)
                     (setf (svref types id) facts (svref packets id) packet-facts)
                     (let ((old (svref summaries id)))
                       (multiple-value-bind (joined expansions)
                           (mir-widen-summary old (mir-return-type function facts) (svref changes id))
                         (setf (svref changes id) expansions)
                         (unless (equal old joined)
                           (setf (svref summaries id) joined)
                           (enqueue-users (svref callers id)))))
                     (let* ((old (svref value-summaries id))
                            (joined (mir-join-values old (mir-return-values function packet-facts)
                                                    (svref value-changes id))))
                       (unless (equalp old joined)
                         (setf (svref value-summaries id) joined)
                         (enqueue-users (svref callers id))))
                     (merge-inputs function facts packet-facts (svref identities id))))))
        (dolist (component components) (dolist (id component) (enqueue id)))
        (solve)
        ;; Public-safe fallback also follows the same dependency edges.
        (dotimes (id count)
          (when (eq (svref summaries id) :unseen)
            (setf (svref summaries id) t) (enqueue-users (svref callers id)))
          (when (eq (svref value-summaries id) :unseen)
            (setf (svref value-summaries id) (mir-unknown-values (svref summaries id)))
            (enqueue-users (svref callers id)))
          (dotimes (position (length (svref inputs id)))
            (when (eq (svref (svref inputs id) position) :unseen)
              (setf (svref (svref inputs id) position) t) (enqueue id)))
          (dotimes (slot (length (svref capture-inputs id)))
            (when (eq (svref (svref capture-inputs id) slot) :unseen)
              (setf (svref (svref capture-inputs id) slot) t) (enqueue id))))
        (dotimes (site (length cell-types))
          (when (eq (svref cell-types site) :unseen)
            (setf (svref cell-types site) t) (enqueue-users (svref cell-readers site))))
        (solve)
        ;; Every changed input has notified its consumers before the queue
        ;; empties. Keep those solved rows; only unseeded local values need
        ;; the public-safe finalization performed by the local solver.
        (loop for row across types do
          (dotimes (id (length row))
            (when (eq (svref row id) :unseen) (setf (svref row id) t))))
        (make-mir-call-analysis :identities identities :outgoing outgoing :components components
                                :external external :inputs inputs :capture-inputs capture-inputs :cell-types cell-types :cell-aliases cell-aliases
                                :summaries summaries :value-summaries value-summaries
                                :types types :packets packets)))))

(defun mir-infer-calls (unit)
  (mir-unit-analysis unit :calls #'mir-compute-calls))
