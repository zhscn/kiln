(in-package #:kiln.compiler)

(defun mir-refinement-parameters (function aliases reachable)
  "Protect parameters carrying a tested value or its predicate operands."
  (let* ((blocks (hir-vector (mir-function-blocks function)))
         (definitions (mir-value-definitions function))
         (origins (make-array (length aliases) :initial-element nil))
         (protected (make-array (length aliases) :initial-element nil)))
    (labels ((origin (id)
               (or (svref origins id)
                   (setf (svref origins id)
                         (loop for value = id then next
                               for next = (svref aliases (mir-primary-origin value definitions))
                               when (= value next) return value)))))
      (loop for block across blocks for term = (mir-block-terminator block)
            when (and (logbitp (mir-block-id block) reachable) (= 1 (mir-terminator-kind term))) do
        (let* ((test (origin (svref (mir-terminator-operands term) 0)))
               (predicate (svref definitions test))
               (sources (cons test (and predicate (map 'list #'origin (mir-instruction-operands predicate))))))
          (loop for edge across (mir-terminator-edges term) do
            (loop for parameter across (mir-block-parameters (svref blocks (mir-edge-target edge)))
                  for argument across (mir-edge-arguments edge)
                  when (member (origin argument) sources)
                    do (setf (svref protected parameter) t))))))
    protected))

(defun mir-block-parameter-plan (function &key preserve-refinements)
  "Find dominating replacements and parameters needed by actual operations."
  (let* ((blocks (hir-vector (mir-function-blocks function)))
         (values (hir-vector (mir-function-values function)))
         (aliases (map 'simple-vector #'mir-value-id values))
         (incoming (make-array (length blocks) :initial-element nil))
         (live (make-array (length values) :initial-element nil)))
    (multiple-value-bind (reachable dominators) (mir-control-flow function)
      (loop for block across blocks when (logbitp (mir-block-id block) reachable)
            do (loop for edge across (mir-terminator-edges (mir-block-terminator block))
                     do (push edge (svref incoming (mir-edge-target edge)))))
      (labels ((root (id)
                 ;; Compress forwarding chains as they are queried: long
                 ;; sequences of joins otherwise retrace the same suffix.
                 (loop for next = (svref aliases id) while (/= id next)
                       do (setf (svref aliases id) (svref aliases next)
                                id next)
                       finally (return id)))
               (mark (id)
                 (let ((id (root id)))
                   (unless (svref live id) (setf (svref live id) t))))
               (find-aliases (protected)
                 ;; Watch incoming values rather than rescanning every join
                 ;; after one alias changes. Watchers move to the new root.
                 (let ((users (make-array (length values) :initial-element nil))
                       (positions (make-array (length values) :initial-element nil))
                       (queued (make-array (length values) :initial-element nil))
                       (work (make-hir-buffer)))
                   (labels ((enqueue (id)
                              (unless (svref queued id)
                                (setf (svref queued id) t)
                                (hir-push id work))))
                     (loop for block across blocks for id = (mir-block-id block)
                           when (logbitp id reachable) do
                       (loop for parameter across (mir-block-parameters block) for index from 0
                             unless (and protected (svref protected parameter)) do
                         (setf (svref positions parameter) index)
                         (enqueue parameter)
                         (dolist (edge (svref incoming id))
                           (push parameter (svref users (svref (mir-edge-arguments edge) index))))))
                     (loop for cursor from 0 while (< cursor (hir-buffer-count work))
                           for parameter = (mir-at work cursor)
                           for id = (mir-value-block (svref values parameter))
                           for index = (svref positions parameter) do
                       (setf (svref queued parameter) nil)
                       (when (= parameter (root parameter))
                         (let ((candidate nil) (conflict nil))
                           (dolist (edge (svref incoming id))
                             (let ((argument (root (svref (mir-edge-arguments edge) index))))
                               (unless (= argument parameter)
                                 (cond ((null candidate) (setf candidate argument))
                                       ((/= argument candidate) (setf conflict t))))))
                           (when (and candidate (not conflict)
                                      (logbitp (mir-value-block (svref values candidate)) (svref dominators id)))
                             (setf (svref aliases parameter) candidate)
                             (let ((watchers (svref users parameter)))
                               (dolist (user watchers) (enqueue user))
                               (setf (svref users parameter) nil
                                     (svref users candidate) (nconc watchers (svref users candidate))))))))))
                 (dotimes (id (length aliases)) (setf (svref aliases id) (root id)))))
        (find-aliases nil)
        (when preserve-refinements
          ;; Resolve copies first so predicates defined in an earlier block
          ;; still protect the corresponding values on a later branch.
          (let ((protected (mir-refinement-parameters function aliases reachable)))
            (when (find t protected)
              (dotimes (id (length aliases)) (setf (svref aliases id) id))
              (find-aliases protected))))
        ;; Edge arguments count as uses only if their destination is needed.
        ;; Instructions remain intact: effects and declaration checks are kept.
        (loop for instruction across (hir-vector (mir-function-instructions function))
              do (map nil #'mark (mir-instruction-operands instruction)))
        (loop for block across blocks
              do (map nil #'mark (mir-terminator-operands (mir-block-terminator block))))
        (loop with changed = t while changed do
          (setf changed nil)
          (loop for block across blocks
                do (loop for edge across (mir-terminator-edges (mir-block-terminator block))
                         for parameters = (mir-block-parameters (svref blocks (mir-edge-target edge)))
                         do (loop for parameter across parameters for argument across (mir-edge-arguments edge)
                                  when (and (= parameter (svref aliases parameter))
                                            (svref live parameter) (mark argument))
                                    do (setf changed t)))))))
    (values aliases live)))

(defun mir-rewrite-block-parameters (function aliases live)
  "Remove redundant parameters and densely renumber the remaining SSA values."
  (let* ((blocks (hir-vector (mir-function-blocks function)))
         (old-values (hir-vector (mir-function-values function)))
         (parameters (map 'simple-vector #'mir-block-parameters blocks))
         (keep (make-array (length old-values) :initial-element nil))
         (numbers (make-array (length old-values) :initial-element nil))
         (values (make-hir-buffer)))
    (loop for value across old-values for id from 0
          when (or (>= (mir-value-position value) 0)
                   (and (= id (svref aliases id)) (svref live id)))
            do (setf (svref keep id) t
                     (svref numbers id) (hir-buffer-count values))
               (hir-push value values))
    (labels ((number (id)
               (or (svref numbers (svref aliases id))
                   (mir-fail "Removed MIR parameter ~D still has a use" id)))
             (rewrite (ids) (map 'simple-vector #'number ids)))
      (loop for value across (hir-vector values) for id from 0 do (setf (mir-value-id value) id))
      (loop for instruction across (hir-vector (mir-function-instructions function))
            do (setf (mir-instruction-operands instruction) (rewrite (mir-instruction-operands instruction)))
               (when (mir-instruction-result instruction)
                 (setf (mir-instruction-result instruction) (number (mir-instruction-result instruction)))))
      (loop for block across blocks for term = (mir-block-terminator block)
            do (setf (mir-block-parameters block)
                     (rewrite (remove-if-not (lambda (id) (svref keep id))
                                             (svref parameters (mir-block-id block))))
                     (mir-terminator-operands term) (rewrite (mir-terminator-operands term)))
               (loop for edge across (mir-terminator-edges term)
                     do (setf (mir-edge-arguments edge)
                              (map 'simple-vector #'number
                                   (loop for parameter across (svref parameters (mir-edge-target edge))
                                         for argument across (mir-edge-arguments edge)
                                         when (svref keep parameter) collect argument)))))
      (setf (mir-function-values function) values))
    function))

(defun mir-simplify-block-parameters (unit &key preserve-refinements)
  (let ((transformations nil))
    (loop for function across (hir-vector (mir-unit-functions unit))
          do (multiple-value-bind (aliases live) (mir-block-parameter-plan function :preserve-refinements preserve-refinements)
               (when (loop for value across (hir-vector (mir-function-values function)) for id from 0
                           thereis (and (= -1 (mir-value-position value))
                                        (or (/= id (svref aliases id)) (not (svref live id)))))
                 (push (cons function (lambda (function) (mir-rewrite-block-parameters function aliases live)))
                       transformations))))
    (mir-run-passes unit (nreverse transformations)))
  unit)

(defun mir-prune-unreachable-blocks (unit function)
  "Remove dead CFG bodies and compact their block, value, instruction and region IDs."
  (let* ((blocks (hir-vector (mir-function-blocks function)))
         (instructions (mir-function-instructions function))
         (values (hir-vector (mir-function-values function)))
         (live (make-array (length blocks) :initial-element nil))
         (work (make-hir-buffer)) (count 0))
    (hir-push 0 work)
    (loop for cursor from 0 while (< cursor (hir-buffer-count work))
          for id = (mir-at work cursor) unless (svref live id) do
            (setf (svref live id) t) (incf count)
            (loop for edge across (mir-terminator-edges (mir-block-terminator (svref blocks id)))
                  do (hir-push (mir-edge-target edge) work)))
    (when (= count (length blocks)) (return-from mir-prune-unreachable-blocks nil))
    (let ((block-map (make-array (length blocks) :initial-element nil))
          (value-map (make-array (length values) :initial-element nil))
          (regions (make-hash-table))
          (new-blocks (make-hir-buffer)) (new-values (make-hir-buffer)) (new-instructions (make-hir-buffer)))
      (loop for block across blocks for old from 0 when (svref live old) do
        (setf (svref block-map old) (hir-buffer-count new-blocks))
        (hir-push block new-blocks)
        (loop for id across (hir-vector (mir-block-instructions block))
              for instruction = (mir-at instructions id)
              when (member (mir-instruction-kind instruction) '(27 29 30 32 34 35))
                do (setf (gethash (mir-binding-entry-id instruction) regions) (hash-table-count regions))))
      (loop for value across values for old from 0 when (svref live (mir-value-block value)) do
        (setf (svref value-map old) (hir-buffer-count new-values)
              (mir-value-id value) (hir-buffer-count new-values)
              (mir-value-block value) (svref block-map (mir-value-block value)))
        (hir-push value new-values))
      (labels ((value (id) (or (svref value-map id) (mir-fail "Live MIR use lost its definition")))
               (value-vector (ids) (map 'simple-vector #'value ids))
               (region (id) (or (gethash id regions) (mir-fail "Live MIR region lost its entry"))))
        (loop for block across (hir-vector new-blocks) for id from 0
              for body = (make-hir-buffer) for term = (mir-block-terminator block) do
          (setf (mir-block-id block) id
                (mir-block-parameters block) (value-vector (mir-block-parameters block)))
          (loop for old across (hir-vector (mir-block-instructions block))
                for instruction = (mir-at instructions old) for kind = (mir-instruction-kind instruction) do
                  (setf (mir-instruction-id instruction) (hir-buffer-count new-instructions)
                        (mir-instruction-operands instruction) (value-vector (mir-instruction-operands instruction)))
                  (when (mir-instruction-result instruction)
                    (setf (mir-instruction-result instruction) (value (mir-instruction-result instruction))))
                  (when (<= 27 kind 36)
                    (setf (mir-instruction-data instruction)
                          (if (= kind 27)
                              (cons (region (car (mir-instruction-data instruction))) (cdr (mir-instruction-data instruction)))
                              (region (mir-instruction-data instruction)))))
                  (hir-push (mir-instruction-id instruction) body)
                  (hir-push instruction new-instructions))
          (setf (mir-block-instructions block) body
                (mir-terminator-operands term) (value-vector (mir-terminator-operands term)))
          (when (mir-terminator-region term) (setf (mir-terminator-region term) (region (mir-terminator-region term))))
          (loop for edge across (mir-terminator-edges term) do
            (setf (mir-edge-target edge) (or (svref block-map (mir-edge-target edge)) (mir-fail "Live MIR edge targets dead block"))
                  (mir-edge-arguments edge) (value-vector (mir-edge-arguments edge))))))
      (setf (mir-function-blocks function) new-blocks (mir-function-values function) new-values
            (mir-function-instructions function) new-instructions)
      (clrhash (mir-function-analyses function))
      (clrhash (mir-unit-analyses unit))
      t)))
