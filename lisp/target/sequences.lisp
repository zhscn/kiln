;;;; Sequence and list functions with the usual keyword arguments.
;;;;
;;;; Simple versions on lists, simple vectors and strings, for bootstrapping
;;;; until Consecution (which needs CLOS, M4) takes over sequences.

(in-package #:kiln.kernel)

(defun satisfies-test (item x test test-not key)
  (let ((k (if key (funcall key x) x)))
    (cond (test-not (not (funcall test-not item k)))
          (test (funcall test item k))
          (t (eql item k)))))

;;; EQ or EQL if the test compares the elements themselves with that
;;; function: the common case, done without calls (the compiler on kiln).
(defun simple-test (test test-not key)
  (and (null key) (null test-not)
       (cond ((or (null test) (eq test #'eql) (eq test 'eql)) 'eql)
             ((or (eq test #'eq) (eq test 'eq)) 'eq))))

(defun seq-list (seq start end)
  "The elements of SEQ from START below END (NIL: the end) as a fresh list."
  (let ((result nil) (i 0))
    (if (listp seq)
        (dolist (x seq)
          (when (and end (>= i end)) (return))
          (when (>= i start) (push x result))
          (setq i (+ i 1)))
        (do ((j start (+ j 1)))
            ((>= j (or end (length seq))))
          (push (aref seq j) result)))
    (nreverse result)))

(defun like-seq (seq list)
  "LIST as a sequence of the same kind as SEQ."
  (cond ((listp seq) list)
        ((stringp seq) (coerce list 'string))
        ((simple-vector-p seq) (coerce list 'vector))
        (t (let ((new (make-sequence-like seq (length list))) (i 0))
             (dolist (x list new) (setf (aref new i) x) (setq i (+ i 1)))))))

;;; Membership and association

(defun member (item list &key test test-not key)
  (case (simple-test test test-not key)
    (eq (do ((l list (cdr l)))
            ((null l) nil)
          (when (eq item (car l)) (return l))))
    (eql (do ((l list (cdr l)))
             ((null l) nil)
           (when (eql item (car l)) (return l))))
    (t (do ((l list (cdr l)))
           ((null l) nil)
         (when (satisfies-test item (car l) test test-not key) (return l))))))
(defun member-if (pred list &key key)
  (do ((l list (cdr l)))
      ((null l) nil)
    (when (funcall pred (if key (funcall key (car l)) (car l))) (return l))))
(defun assoc (item alist &key test test-not key)
  (case (simple-test test test-not key)
    (eq (dolist (pair alist nil)
          (when (and pair (eq item (car pair))) (return pair))))
    (eql (dolist (pair alist nil)
           (when (and pair (eql item (car pair))) (return pair))))
    (t (dolist (pair alist nil)
         (when (and pair (satisfies-test item (car pair) test test-not key)) (return pair))))))
(defun assoc-if (pred alist &key key)
  (dolist (pair alist nil)
    (when (and pair (funcall pred (if key (funcall key (car pair)) (car pair)))) (return pair))))
(defun rassoc (item alist &key test test-not key)
  (dolist (pair alist nil)
    (when (and pair (satisfies-test item (cdr pair) test test-not key)) (return pair))))
(defun acons (key datum alist) (cons (cons key datum) alist))
(defun pairlis (keys data &optional alist)
  (if (null keys) alist (acons (car keys) (car data) (pairlis (cdr keys) (cdr data) alist))))
(defun adjoin (item list &key test test-not key)
  (if (member (if key (funcall key item) item) list :test test :test-not test-not :key key)
      list
      (cons item list)))
;;; The set functions return their elements in the order SBCL's do (its
;;; src/code/list.lisp): CLHS leaves it open, but code evaluated at compile
;;; time calls the host's in a cross compilation, and kiln compiling kiln
;;; must make SBCL's constants.
(defun set-member (x list test test-not key swapped)
  "X (an element of the other list) in LIST; SWAPPED: X is from the
second list argument, so the test gets it second."
  (let ((item (if key (funcall key x) x)))
    (cond ((and swapped test)
           (member item list :test (lambda (a b) (funcall test b a)) :key key))
          ((and swapped test-not)
           (member item list :test-not (lambda (a b) (funcall test-not b a)) :key key))
          (t (member item list :test test :test-not test-not :key key)))))
(defun shorter-list (a b)
  "SBCL's SHORTER-LIST-LENGTH: the shorter list (A if as long), the
other, the shorter's length and the rest of the longer after it."
  (let ((n 0) (x a) (y b))
    (loop (cond ((null x) (return (values a b n y)))
                ((null y) (return (values b a n x))))
          (setq x (cdr x) y (cdr y) n (+ n 1)))))
(defun set-hashing-p (test test-not short-length long-rest)
  "Whether SBCL's UNION and INTERSECTION would use a hash table."
  (and (null test-not)
       (or (> short-length 20)
           (and (>= short-length 3) (nthcdr (- 99 short-length) long-rest)))
       (member (or test #'eql)
               (list #'eq #'eql #'equal #'equalp #'string= #'string-equal #'=))
       t))
(defun union (a b &key test test-not key)
  (cond ((null a) b)
        ((null b) a)
        (t (multiple-value-bind (short long) (shorter-list a b)
             ;; The elements of the longer list are looked up in the shorter.
             (let ((result short) (swapped (eq long b)))
               (dolist (x long result)
                 (unless (set-member x short test test-not key swapped)
                   (push x result))))))))
(defun nunion (a b &rest args) (apply #'union a b args))
(defun intersection (a b &key test test-not key)
  (when (and a b)
    (multiple-value-bind (short long n rest) (shorter-list a b)
      (let ((result nil))
        (if (set-hashing-p test test-not n rest)
            (dolist (x long)
              (when (set-member x short test test-not key (eq long b))
                (push x result)))
            (dolist (x short)
              (when (set-member x long test test-not key (eq short b))
                (push x result))))
        result))))
(defun nintersection (a b &key test test-not key)
  (let ((result nil))
    (when b
      (dolist (x a)
        (when (set-member x b test test-not key nil)
          (push x result))))
    result))
(defun set-difference (a b &key test test-not key)
  (if b
      (let ((result nil))
        (dolist (x a result)
          (unless (set-member x b test test-not key nil)
            (push x result))))
      a))
(defun nset-difference (a b &rest args) (apply #'set-difference a b args))
(defun set-exclusive-or (a b &key test test-not key)
  (cond ((null a) b)
        ((null b) a)
        (t (let ((result nil))
             (dolist (x a)
               (unless (set-member x b test test-not key nil)
                 (push x result)))
             (dolist (x b result)
               (unless (set-member x a test test-not key t)
                 (push x result)))))))
(defun nset-exclusive-or (a b &rest args) (apply #'set-exclusive-or a b args))
(defun subsetp (a b &key test test-not key)
  (dolist (x a t)
    (unless (member (if key (funcall key x) x) b :test test :test-not test-not :key key)
      (return nil))))

;;; Lists

(defun list-length (l)
  ;; NIL for a circular list.
  (do ((n 0 (+ n 2)) (fast l (cddr fast)) (slow l (cdr slow)))
      (nil)
    (when (endp fast) (return n))
    (when (endp (cdr fast)) (return (+ n 1)))
    (when (and (> n 0) (eq fast slow)) (return nil))))
(defun list-cons-count (l)
  (unless (listp l) (error 'type-error :datum l :expected-type 'list))
  (let ((count 0))
    (do ((tail l (cdr tail))) ((atom tail) count)
      (setq count (+ count 1)))))

(defun check-list-count (n)
  (unless (and (integerp n) (>= n 0))
    (error 'type-error :datum n :expected-type 'unsigned-byte)))

(defun butlast (l &optional (n 1))
  (check-list-count n)
  (let ((count (list-cons-count l)))
    (if (zerop n)
        (copy-list l)
        (let ((result nil))
          (dotimes (i (max 0 (- count n)) (nreverse result))
            (push (car l) result)
            (setq l (cdr l)))))))

(defun nbutlast (l &optional (n 1))
  (check-list-count n)
  (let ((count (list-cons-count l)))
    (cond ((zerop n) l)
          ((<= count n) nil)
          (t (setf (cdr (nthcdr (- count n 1) l)) nil) l))))

(defun ldiff (l object)
  (unless (listp l) (error 'type-error :datum l :expected-type 'list))
  (let* ((head (cons nil nil)) (tail head))
    (loop (when (eql l object) (return (cdr head)))
          (when (atom l)
            (setf (cdr tail) l)
            (return (cdr head)))
          (setf (cdr tail) (cons (car l) nil)
                tail (cdr tail)
                l (cdr l)))))

(defun tailp (object l)
  (unless (listp l) (error 'type-error :datum l :expected-type 'list))
  (loop (when (eql object l) (return t))
        (when (atom l) (return nil))
        (setq l (cdr l))))

(defun copy-alist (alist)
  (let ((result nil))
    (dolist (pair alist (nreverse result))
      (push (if (consp pair) (cons (car pair) (cdr pair)) pair) result))))

(defun third (l) (car (cddr l)))
(defun fourth (l) (car (cdr (cddr l))))
(defun fifth (l) (car (cddr (cddr l))))
(defun sixth (l) (nth 5 l))
(defun seventh (l) (nth 6 l))
(defun eighth (l) (nth 7 l))
(defun ninth (l) (nth 8 l))
(defun tenth (l) (nth 9 l))
(defun caar (l) (car (car l)))
(defun cdar (l) (cdr (car l)))
(defun caddr (l) (car (cddr l)))
(defun cdddr (l) (cdr (cddr l)))
(defun make-list (n &key initial-element)
  (check-list-count n)
  (let ((l nil)) (dotimes (i n l) (push initial-element l))))
(defun revappend (a b)
  (dolist (x a b) (push x b)))
(defun nreconc (a b) (revappend a b))
(defun tree-equal (a b &key test test-not)
  (cond ((and (consp a) (consp b))
         (and (tree-equal (car a) (car b) :test test :test-not test-not)
              (tree-equal (cdr a) (cdr b) :test test :test-not test-not)))
        ((or (consp a) (consp b)) nil)
        (t (values (satisfies-test a b test test-not nil)))))
(defun copy-tree (x)
  (if (consp x) (cons (copy-tree (car x)) (copy-tree (cdr x))) x))
(defun substitute-tree (tree replacement destructive)
  ;; REPLACEMENT returns the new value and whether this subtree matched.
  ;; Test before descending so replacement trees are never traversed.
  (labels ((walk (node)
             (multiple-value-bind (value matched) (funcall replacement node)
               (cond (matched value)
                     ((atom node) node)
                     (t (let ((head (walk (car node)))
                              (tail (walk (cdr node))))
                          (cond (destructive
                                 (rplaca node head)
                                 (rplacd node tail)
                                 node)
                                ((and (eq head (car node))
                                      (eq tail (cdr node))) node)
                                (t (cons head tail)))))))))
    (walk tree)))

(defun subst (new old tree &key test test-not key)
  (substitute-tree tree
                   (lambda (node)
                     (values new (satisfies-test old node test test-not key)))
                   nil))

(defun nsubst (new old tree &key test test-not key)
  (substitute-tree tree
                   (lambda (node)
                     (values new (satisfies-test old node test test-not key)))
                   t))

(defun subst-if (new predicate tree &key key)
  (substitute-tree tree
                   (lambda (node)
                     (values new (funcall predicate (if key (funcall key node) node))))
                   nil))

(defun subst-if-not (new predicate tree &key key)
  (substitute-tree tree
                   (lambda (node)
                     (values new (not (funcall predicate (if key (funcall key node) node)))))
                   nil))

(defun nsubst-if (new predicate tree &key key)
  (substitute-tree tree
                   (lambda (node)
                     (values new (funcall predicate (if key (funcall key node) node))))
                   t))

(defun nsubst-if-not (new predicate tree &key key)
  (substitute-tree tree
                   (lambda (node)
                     (values new (not (funcall predicate (if key (funcall key node) node)))))
                   t))

(defun sublis (alist tree &key test test-not key)
  (substitute-tree tree
                   (lambda (node)
                     (let ((pair (assoc (if key (funcall key node) node) alist
                                        :test test :test-not test-not)))
                       (values (cdr pair) pair)))
                   nil))

(defun nsublis (alist tree &key test test-not key)
  (substitute-tree tree
                   (lambda (node)
                     (let ((pair (assoc (if key (funcall key node) node) alist
                                        :test test :test-not test-not)))
                       (values (cdr pair) pair)))
                   t))

(defun map-tails (f lists collect)
  (let ((result nil))
    (loop (dolist (tail lists)
            (when (endp tail) (return-from map-tails (nreverse result))))
          (let ((value (apply f lists)))
            (when collect (push value result)))
          (do ((p lists (cdr p))) ((null p))
            (setf (car p) (cdr (car p)))))))

(defun maplist (f list &rest lists)
  (map-tails f (cons list lists) t))
(defun mapcan (f list &rest lists)
  (apply #'nconc (apply #'mapcar f list lists)))
(defun mapcon (f list &rest lists)
  (apply #'nconc (map-tails f (cons list lists) t)))
(defun mapc (f list &rest lists)
  (apply #'mapcar f list lists)
  list)
(defun mapl (f list &rest lists)
  (map-tails f (cons list lists) nil)
  list)

;;; Searching

(defun find (item seq &key test test-not key (start 0) end from-end)
  (cond ((and (listp seq) (null from-end))
         (let ((l (nthcdr start seq)) (end (and end (- end start))))
           (if (null end)
               (case (simple-test test test-not key)
                 (eq (dolist (x l nil) (when (eq item x) (return x))))
                 (eql (dolist (x l nil) (when (eql item x) (return x))))
                 (t (dolist (x l nil) (when (satisfies-test item x test test-not key) (return x)))))
               (do ((i 0 (+ i 1))) ((or (null l) (>= i end)) nil)
                 (when (satisfies-test item (car l) test test-not key) (return (car l)))
                 (setq l (cdr l))))))
        ((not (listp seq))
         (let ((end (or end (length seq))))
           (if from-end
               (do ((i (- end 1) (- i 1))) ((< i start) nil)
                 (let ((x (aref seq i)))
                   (when (satisfies-test item x test test-not key) (return x))))
               (do ((i start (+ i 1))) ((>= i end) nil)
                 (let ((x (aref seq i)))
                   (when (satisfies-test item x test test-not key) (return x)))))))
        (t
         (dolist (x (nreverse (seq-list seq start end)) nil)
           (when (satisfies-test item x test test-not key) (return x))))))

(defun find-if (pred seq &key key (start 0) end from-end)
  (cond ((and (listp seq) (null from-end))
         (do ((l (nthcdr start seq) (cdr l)) (i start (+ i 1)))
             ((or (null l) (and end (>= i end))) nil)
           (let ((x (car l)))
             (when (funcall pred (if key (funcall key x) x)) (return x)))))
        ((not (listp seq))
         (let ((end (or end (length seq))))
           (if from-end
               (do ((i (- end 1) (- i 1))) ((< i start) nil)
                 (let ((x (aref seq i)))
                   (when (funcall pred (if key (funcall key x) x)) (return x))))
               (do ((i start (+ i 1))) ((>= i end) nil)
                 (let ((x (aref seq i)))
                   (when (funcall pred (if key (funcall key x) x)) (return x)))))))
        (t
         (dolist (x (nreverse (seq-list seq start end)) nil)
           (when (funcall pred (if key (funcall key x) x)) (return x))))))

(defun find-if-not (pred seq &rest args)
  (apply #'find-if (complement pred) seq args))

(defun position (item seq &key test test-not key (start 0) end from-end)
  (if (listp seq)
      (do ((l (nthcdr start seq) (cdr l)) (i start (+ i 1)) (found nil))
          ((or (null l) (and end (>= i end))) found)
        (when (satisfies-test item (car l) test test-not key)
          (unless from-end (return i))
          (setq found i)))
      (let ((end (or end (length seq))))
        (if from-end
            (do ((i (- end 1) (- i 1))) ((< i start) nil)
              (when (satisfies-test item (aref seq i) test test-not key) (return i)))
            (do ((i start (+ i 1))) ((>= i end) nil)
              (when (satisfies-test item (aref seq i) test test-not key) (return i)))))))

(defun position-if (pred seq &key key (start 0) end from-end)
  (if (listp seq)
      (do ((l (nthcdr start seq) (cdr l)) (i start (+ i 1)) (found nil))
          ((or (null l) (and end (>= i end))) found)
        (let ((x (car l)))
          (when (funcall pred (if key (funcall key x) x))
            (unless from-end (return i))
            (setq found i))))
      (let ((end (or end (length seq))))
        (if from-end
            (do ((i (- end 1) (- i 1))) ((< i start) nil)
              (let ((x (aref seq i)))
                (when (funcall pred (if key (funcall key x) x)) (return i))))
            (do ((i start (+ i 1))) ((>= i end) nil)
              (let ((x (aref seq i)))
                (when (funcall pred (if key (funcall key x) x)) (return i))))))))

(defun count-if (pred seq &key key (start 0) end from-end)
  (let ((elements (seq-list seq start end)) (n 0))
    (dolist (x (if from-end (nreverse elements) elements) n)
      (when (funcall pred (if key (funcall key x) x))
        (incf n)))))
(defun count (item seq &key test test-not key (start 0) end from-end)
  (count-if (lambda (x) (satisfies-test item x test test-not nil)) seq
            :key key :start start :end end :from-end from-end))

(defun mismatch (a b &key from-end test test-not key (start1 0) end1 (start2 0) end2)
  (let ((end1 (or end1 (length a))) (end2 (or end2 (length b))))
    (flet ((same (i j)
             (satisfies-test (if key (funcall key (elt a i)) (elt a i))
                             (if key (funcall key (elt b j)) (elt b j))
                             test test-not nil)))
      (if from-end
          (do ((i (- end1 1) (- i 1)) (j (- end2 1) (- j 1)))
              ((or (< i start1) (< j start2))
               (if (and (< i start1) (< j start2)) nil (+ i 1)))
            (unless (same i j) (return (+ i 1))))
          (do ((i start1 (+ i 1)) (j start2 (+ j 1)))
              ((or (>= i end1) (>= j end2))
               (if (and (>= i end1) (>= j end2)) nil i))
            (unless (same i j) (return i)))))))
(defun search (needle haystack &key from-end test test-not key
                                    (start1 0) end1 (start2 0) end2)
  (let* ((end1 (or end1 (length needle)))
         (end2 (or end2 (length haystack)))
         (n (- end1 start1))
         (result nil))
    (do ((i start2 (+ i 1)))
        ((> (+ i n) end2) result)
      (when (do ((k 0 (+ k 1)))
                ((>= k n) t)
              (let ((x (elt needle (+ start1 k))) (y (elt haystack (+ i k))))
                (unless (satisfies-test (if key (funcall key x) x) (if key (funcall key y) y)
                                        test test-not nil)
                  (return nil))))
        (setq result i)
        (unless from-end (return i))))))

;;; Filtering

(defun remove-if (pred seq &key key (start 0) end count from-end)
  (let* ((elements (seq-list seq 0 nil))
         (n (length elements))
         (end (or end n))
         (i (if from-end (1- n) 0))
         (step (if from-end -1 1))
         (removed 0)
         (result nil))
    (dolist (x (if from-end (nreverse elements) elements))
      (if (and (<= start i) (< i end)
               (or (null count) (< removed count))
               (funcall pred (if key (funcall key x) x)))
          (incf removed)
          (push x result))
      (incf i step))
    (like-seq seq (if from-end result (nreverse result)))))
(defun remove (item seq &key test test-not key (start 0) end count from-end)
  (remove-if (lambda (x) (satisfies-test item x test test-not nil)) seq
             :key key :start start :end end :count count :from-end from-end))

(defun remove-if-not (pred seq &rest args)
  (apply #'remove-if (complement pred) seq args))
(defun delete (item seq &rest args) (apply #'remove item seq args))
(defun delete-if (pred seq &rest args) (apply #'remove-if pred seq args))
(defun delete-if-not (pred seq &rest args) (apply #'remove-if-not pred seq args))
(defun remove-duplicates (seq &key test test-not key from-end (start 0) end)
  (let* ((end (or end (length seq)))
         (region (seq-list seq start end))
         (result nil))
    (if from-end
        (dolist (x region)
          (unless (member (if key (funcall key x) x) result
                          :test (and test (lambda (a b) (funcall test b a)))
                          :test-not (and test-not (lambda (a b) (funcall test-not b a)))
                          :key key)
            (push x result)))
        (do ((rest region (cdr rest))) ((null rest))
          (unless (member (if key (funcall key (car rest)) (car rest)) (cdr rest)
                          :test test :test-not test-not :key key)
            (push (car rest) result))))
    (like-seq seq (nconc (seq-list seq 0 start) (nreverse result)
                         (seq-list seq end nil)))))

(defun delete-duplicates (seq &rest args) (apply #'remove-duplicates seq args))
(defun nsubstitute-if (new pred seq &key key (start 0) end count from-end)
  (let* ((end (or end (length seq)))
         (replaced 0))
    (flet ((match (x)
             (and (or (null count) (< replaced count))
                  (funcall pred (if key (funcall key x) x)))))
      (cond ((and (listp seq) (not from-end))
             (do ((tail (nthcdr start seq) (cdr tail)) (i start (1+ i)))
                 ((or (null tail) (>= i end)))
               (when (match (car tail))
                 (setf (car tail) new)
                 (incf replaced))))
            (t (let ((i (if from-end (1- end) start))
                     (step (if from-end -1 1)))
                 (loop while (and (<= start i) (< i end))
                       do (when (match (elt seq i))
                            (setf (elt seq i) new)
                            (incf replaced))
                          (incf i step))))))
    seq))
(defun substitute-if (new pred seq &rest args)
  (apply #'nsubstitute-if new pred (copy-seq seq) args))
(defun substitute (new old seq &key test test-not key (start 0) end count from-end)
  (substitute-if new (lambda (x) (satisfies-test old x test test-not nil)) seq
                 :key key :start start :end end :count count :from-end from-end))
(defun substitute-if-not (new pred seq &rest args)
  (apply #'substitute-if new (complement pred) seq args))
(defun nsubstitute (new old seq &key test test-not key (start 0) end count from-end)
  (nsubstitute-if new (lambda (x) (satisfies-test old x test test-not nil)) seq
                  :key key :start start :end end :count count :from-end from-end))

;;; Mapping and reducing

(defun complement (f) (lambda (&rest args) (not (apply f args))))
(defun constantly (value) (lambda (&rest args) (declare (ignore args)) value))
(defun identity (x) x)

;;; The -IF-NOT functions not defined above (deprecated, but standard).
(defun member-if-not (pred list &rest args) (apply #'member-if (complement pred) list args))
(defun assoc-if-not (pred alist &rest args) (apply #'assoc-if (complement pred) alist args))
(defun rassoc-if (pred alist &key key)
  (dolist (pair alist nil)
    (when (and pair (funcall pred (if key (funcall key (cdr pair)) (cdr pair)))) (return pair))))
(defun rassoc-if-not (pred alist &rest args) (apply #'rassoc-if (complement pred) alist args))
(defun position-if-not (pred seq &rest args) (apply #'position-if (complement pred) seq args))
(defun count-if-not (pred seq &rest args) (apply #'count-if (complement pred) seq args))
(defun nsubstitute-if-not (new pred seq &rest args)
  (apply #'nsubstitute-if new (complement pred) seq args))

(defun every (pred seq &rest seqs)
  (cond ((null seqs)
         (cond ((listp seq)
                (dolist (x seq t) (unless (funcall pred x) (return nil))))
               ((%primop :simple-vector-p seq)
                (dotimes (i (%primop :length seq) t)
                  (unless (funcall pred (svref seq i)) (return nil))))
               (t
                (dotimes (i (length seq) t)
                  (unless (funcall pred (aref seq i)) (return nil))))))
        ((and (null (cdr seqs)) (listp seq) (listp (car seqs)))
         (do ((a seq (cdr a)) (b (car seqs) (cdr b)))
             ((or (null a) (null b)) t)
           (unless (funcall pred (car a) (car b)) (return nil))))
        (t
         (let ((lists (mapcar #'map-arg-list (cons seq seqs))))
           (do () ((dolist (l lists nil) (when (null l) (return t))) t)
             (unless (apply pred (mapcar #'car lists)) (return nil))
             (setq lists (mapcar #'cdr lists)))))))

(defun some (pred seq &rest seqs)
  (cond ((null seqs)
         (cond ((listp seq)
                (dolist (x seq nil)
                  (let ((v (funcall pred x))) (when v (return v)))))
               ((%primop :simple-vector-p seq)
                (dotimes (i (%primop :length seq) nil)
                  (let ((v (funcall pred (svref seq i)))) (when v (return v)))))
               (t
                (dotimes (i (length seq) nil)
                  (let ((v (funcall pred (aref seq i)))) (when v (return v)))))))
        ((and (null (cdr seqs)) (listp seq) (listp (car seqs)))
         (do ((a seq (cdr a)) (b (car seqs) (cdr b)))
             ((or (null a) (null b)) nil)
           (let ((v (funcall pred (car a) (car b)))) (when v (return v)))))
        (t
         (let ((lists (mapcar #'map-arg-list (cons seq seqs))))
           (do () ((dolist (l lists nil) (when (null l) (return t))) nil)
             (let ((v (apply pred (mapcar #'car lists))))
               (when v (return v)))
             (setq lists (mapcar #'cdr lists)))))))

(defun notany (pred seq &rest seqs)
  (if (null seqs) (not (some pred seq)) (not (apply #'some pred seq seqs))))
(defun notevery (pred seq &rest seqs)
  (if (null seqs) (not (every pred seq)) (not (apply #'every pred seq seqs))))

;;; Lists are not copied: MAP stops at the shortest sequence, and a list
;;; can be circular (architecture.builder-protocol passes one).
(defun map-arg-list (seq)
  (if (listp seq) seq (seq-list seq 0 nil)))

(defun map (result-type f seq &rest seqs)
  (when (and result-type (not (sequence-result-type-p result-type)))
    (error 'type-error :datum result-type :expected-type '(satisfies sequence-result-type-p)))
  (if (null seqs)
      (cond ((null result-type)
             (if (listp seq)
                 (dolist (x seq nil) (funcall f x))
                 (dotimes (i (length seq) nil) (funcall f (aref seq i)))))
            ((eq result-type 'list)
             (if (listp seq)
                 (mapcar f seq)
                 (let ((head nil) (tail nil))
                   (dotimes (i (length seq) head)
                     (let ((cell (cons (funcall f (aref seq i)) nil)))
                       (if tail (setf (cdr tail) cell) (setf head cell))
                       (setf tail cell))))))
            ((or (eq result-type 'vector) (eq result-type 'simple-vector))
             (let* ((n (length seq))
                    (v (make-simple-vector n nil)))
               (cond ((listp seq)
                      (let ((i 0))
                        (dolist (x seq v)
                          (setf (svref v i) (funcall f x) i (+ i 1)))))
                     ((%primop :simple-vector-p seq)
                      (dotimes (i n v) (setf (svref v i) (funcall f (svref seq i)))))
                     (t
                      (dotimes (i n v) (setf (svref v i) (funcall f (aref seq i))))))))
            (t
             (let* ((elements (if (listp seq)
                                  (mapcar f seq)
                                  (let ((r nil))
                                    (dotimes (i (length seq) (nreverse r))
                                      (push (funcall f (aref seq i)) r)))))
                    (result (make-sequence result-type (length elements))))
               (replace result elements))))
      (let ((results (apply #'mapcar f (map-arg-list seq) (mapcar #'map-arg-list seqs))))
        (if (null result-type) nil
            (replace (make-sequence result-type (length results)) results)))))

(defun map-into (target f &rest seqs)
  (let ((lists (mapcar #'map-arg-list seqs))
        (n (if (listp target) (length target) (array-dimension target 0)))
        (written 0))
    (if (listp target)
        (do ((tail target (cdr tail)))
            ((or (null tail) (dolist (x lists nil) (when (null x) (return t)))))
          (setf (car tail) (apply f (mapcar #'car lists)))
          (setq lists (mapcar #'cdr lists)))
        (progn
          (do ((i 0 (1+ i)))
              ((or (>= i n) (dolist (x lists nil) (when (null x) (return t)))))
            (setf (aref target i) (apply f (mapcar #'car lists)))
            (incf written)
            (setq lists (mapcar #'cdr lists)))
          (when (array-has-fill-pointer-p target)
            (setf (fill-pointer target) written))))
    target))

(defun reduce (f seq &key key from-end (start 0) end (initial-value nil initial-value-p))
  (let ((l (seq-list seq start end)))
    (when key (setq l (mapcar key l)))
    (when from-end (setq l (reverse l)))
    (cond ((and (null l) initial-value-p) initial-value)
          ((null l) (funcall f))
          (t (let ((acc (if initial-value-p initial-value (pop l))))
               (dolist (x l acc)
                 (setq acc (if from-end (funcall f x acc) (funcall f acc x)))))))))

(defun sequence-end (seq start end)
  (let* ((n (length seq)) (end (or end n)))
    (unless (and (integerp start) (<= 0 start n))
      (error 'type-error :datum start :expected-type `(integer 0 ,n)))
    (unless (and (integerp end) (<= start end n))
      (error 'type-error :datum end :expected-type `(integer ,start ,n)))
    end))

(defun fill (seq item &key (start 0) end)
  (setq end (sequence-end seq start end))
  (if (listp seq)
      (let ((i 0))
        (do ((l seq (cdr l))) ((or (null l) (and end (>= i end))) seq)
          (when (>= i start) (setf (car l) item))
          (setq i (+ i 1))))
      (do ((i start (+ i 1))) ((>= i (or end (length seq))) seq)
        (setf (aref seq i) item))))

(defun replace (target source &key (start1 0) end1 (start2 0) end2)
  (let* ((end1 (sequence-end target start1 end1))
         (end2 (sequence-end source start2 end2))
         (n (min (- end1 start1) (- end2 start2))))
    (cond ((<= n 0) target)
          ((and (vectorp target) (vectorp source)
                (or (eq (array-element-type target) t)
                    (equal (array-element-type target) (array-element-type source)))
                (or (not (native-vector-p target)) (not (native-vector-p source)))
                (or (native-vector-p target) (complex-array-op :native-storage target))
                (or (native-vector-p source) (complex-array-op :native-storage source)))
           ;; An adjustable vector or one with a fill pointer: its native
           ;; storage, as the elements are at the same indices.
           (replace (if (native-vector-p target) target (complex-array-op :native-storage target))
                    (if (native-vector-p source) source (complex-array-op :native-storage source))
                    :start1 start1 :end1 (+ start1 n) :start2 start2 :end2 (+ start2 n))
           target)
          ((and (vectorp target) (vectorp source))
           (if (and (simple-vector-p target) (simple-vector-p source))
               ;; The same vector with the target after the source: copy
               ;; backwards, as if the source were copied first.
               (if (and (eq target source) (> start1 start2))
                   (do ((i (- n 1) (- i 1))) ((< i 0) target)
                     (setf (svref target (+ start1 i)) (svref source (+ start2 i))))
                   (dotimes (i n target)
                     (setf (svref target (+ start1 i)) (svref source (+ start2 i)))))
               (if (and (eq target source) (> start1 start2))
                   (do ((i (- n 1) (- i 1))) ((< i 0) target)
                     (setf (aref target (+ start1 i)) (aref source (+ start2 i))))
                   (dotimes (i n target)
                     (setf (aref target (+ start1 i)) (aref source (+ start2 i)))))))
          (t
           ;; A list on either side: the source's elements first (they may
           ;; be the target's).
           (let ((items (seq-list source start2 (+ start2 n))))
             (if (listp target)
                 (let ((tail (nthcdr start1 target)))
                   (dolist (x items target)
                     (setf (car tail) x tail (cdr tail))))
                 (let ((i start1))
                   (dolist (x items target)
                     (setf (aref target i) x)
                     (setq i (+ i 1))))))))))

;;; Sorting: a stable merge sort on lists.

(defun merge-lists (a b pred key)
  (let ((result nil))
    (do () ((or (null a) (null b)) (nconc (nreverse result) (or a b)))
      (if (funcall pred (if key (funcall key (car b)) (car b))
                   (if key (funcall key (car a)) (car a)))
          (push (pop b) result)
          (push (pop a) result)))))

(defun merge-sort (list pred key)
  (let ((n (length list)))
    (if (< n 2)
        list
        (let* ((half (ash n -1))
               (tail (nthcdr half list))
               (head (subseq list 0 half)))
          (merge-lists (merge-sort head pred key) (merge-sort tail pred key) pred key)))))

(defun sort (seq pred &key key)
  (let ((sorted (merge-sort (seq-list seq 0 nil) pred key)))
    (if (listp seq) sorted (replace seq sorted))))
(defun stable-sort (seq pred &key key) (sort seq pred :key key))
(defun merge (result-type a b pred &key key)
  (let ((elements (merge-lists (seq-list a 0 nil) (seq-list b 0 nil) pred key)))
    (replace (make-sequence result-type (length elements)) elements)))

;;; Strings with bounds

(defun string-trim (bag s)
  (string-left-trim bag (string-right-trim bag s)))
(defun string-left-trim (bag s)
  (let* ((s (string s)) (i 0))
    (do () ((or (>= i (length s)) (not (find (schar s i) bag))))
      (setq i (+ i 1)))
    (subseq s i)))
(defun string-right-trim (bag s)
  (let* ((s (string s)) (i (length s)))
    (do () ((or (<= i 0) (not (find (schar s (- i 1)) bag))))
      (setq i (- i 1)))
    (subseq s 0 i)))
(defun nstring-capitalize (string &key (start 0) end)
  (let ((word-start t))
    (do ((i start (+ i 1)) (end (or end (length string))))
        ((>= i end) string)
      (let ((c (char string i)))
        (cond ((alphanumericp c)
               (setf (char string i) (if word-start (char-upcase c) (char-downcase c)))
               (setq word-start nil))
              (t (setq word-start t)))))))
(defun string-capitalize (s &key (start 0) end)
  (nstring-capitalize (copy-seq (string s)) :start start :end end))

(defun parse-integer (string &key (start 0) end (radix 10) junk-allowed)
  (let* ((string (string string))
         (end (or end (length string)))
         (i start)
         (sign 1)
         (value 0)
         (digits nil))
    (flet ((whitespacep (c) (member c '(#\Space #\Tab #\Newline #\Return #\Page))))
      (do () ((or (>= i end) (not (whitespacep (char string i)))))
        (setq i (+ i 1)))
      (when (and (< i end) (member (char string i) '(#\+ #\-)))
        (when (char= (char string i) #\-) (setq sign -1))
        (setq i (+ i 1)))
      (do () ((>= i end))
        (let ((d (digit-char-p (char string i) radix)))
          (if d
              (setq value (+ (* value radix) d) digits t i (+ i 1))
              (return))))
      (unless junk-allowed
        (do () ((or (>= i end) (not (whitespacep (char string i)))))
          (setq i (+ i 1)))
        (when (or (not digits) (< i end))
          (error 'parse-error)))
      (values (if digits (* sign value) nil) i))))
