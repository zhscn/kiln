;;;; Native file object graphs. Creation and initialization are separate
;;;; operations, so containers can refer to themselves and to later creators.

(in-package #:kiln.kernel)

(define-condition fasl-creation-cycle (program-error) ())
(defvar *fasl-ids*)
(defvar *fasl-ready*)
(defvar *fasl-count*)
(defvar *fasl-records*)
(defvar *fasl-pending*)
(defvar *fasl-creating*)
(defvar *fasl-creation-p* nil)
(defvar *fasl-load-objects*)

(defun fasl-reference (index)
  (svref *fasl-load-objects* index))

(defun fasl-emit (operation dependencies tokens)
  (if (every (lambda (token) (gethash token *fasl-ready*)) dependencies)
      (progn
        (push operation *fasl-records*)
        (dolist (token tokens) (setf (gethash token *fasl-ready*) t)))
      (push (list operation dependencies tokens) *fasl-pending*)))

(defun fasl-flush ()
  (loop with progress = t while (and progress *fasl-pending*)
        do (setf progress nil)
           (let ((pending (nreverse *fasl-pending*)))
             (setf *fasl-pending* nil)
             (dolist (entry pending)
               (if (every (lambda (token) (gethash token *fasl-ready*)) (second entry))
                   (progn
                     (setf progress t)
                     (fasl-emit (first entry) nil (third entry)))
                   (push entry *fasl-pending*))))))

(defun fasl-literal-dependencies (object)
  (let ((seen (make-hash-table :test 'eq)) (dependencies nil))
    (labels ((walk (object)
               (unless (gethash object seen)
                 (setf (gethash object seen) t)
                 (let ((index (fasl-intern object)))
                   (pushnew (+ (* index 2)
                               (if (or (consp object) (arrayp object) (hash-table-p object)) 1 0))
                            dependencies))
                 (cond ((consp object) (walk (car object)) (walk (cdr object)))
                       ((and (arrayp object) (not (stringp object)))
                        (dotimes (i (array-total-size object)) (walk (row-major-aref object i))))
                       ((hash-table-p object)
                        (maphash (lambda (key value) (walk key) (walk value)) object))))))
      (walk object))
    dependencies))

(defun fasl-load-form (form)
  (let ((dependencies nil))
    (labels ((walk (form)
               (cond ((and (consp form) (eq (car form) 'quote))
                      (setf dependencies (union (fasl-literal-dependencies (second form)) dependencies))
                      `(fasl-reference ,(fasl-intern (second form))))
                     ((consp form) (mapcar #'walk form))
                     ((or (symbolp form) (integerp form) (characterp form)) form)
                     (t
                      (setf dependencies (union (fasl-literal-dependencies form) dependencies))
                      `(fasl-reference ,(fasl-intern form))))))
      (values (walk form) dependencies))))

(defun fasl-intern (object)
  (multiple-value-bind (old found) (gethash object *fasl-ids*)
    (when found
      (when (and *fasl-creation-p* (gethash object *fasl-creating*))
        (error 'fasl-creation-cycle))
      (return-from fasl-intern old)))
  (let* ((index (prog1 *fasl-count* (incf *fasl-count*)))
         (allocated (* index 2)) (complete (1+ allocated)))
    (setf (gethash object *fasl-ids*) index)
    (flet ((value (kind &rest fields)
             (fasl-emit (list* kind index fields) nil (list allocated complete))))
      (cond
        ((symbolp object)
         (value :symbol (symbol-name object)
                (and (symbol-package object) (package-name (symbol-package object)))))
        ((integerp object) (value :integer object))
        ((characterp object) (value :character (char-code object)))
        ((floatp object)
         (multiple-value-bind (mantissa exponent sign) (integer-decode-float object)
           (value :float mantissa exponent sign (typep object 'double-float))))
        ((ratiop object) (value :ratio (numerator object) (denominator object)))
        ((complexp object)
         (let ((real (fasl-intern (realpart object))) (imag (fasl-intern (imagpart object))))
           (fasl-emit (list :complex index real imag) (list (* real 2) (* imag 2))
                      (list allocated complete))))
        ((packagep object) (value :package (package-name object)))
        ((pathnamep object)
         (value :pathname (namestring object)))
        ((stringp object) (value :string object))
        ((consp object)
         (fasl-emit (list :cons index) nil (list allocated))
         (let ((a (fasl-intern (car object))) (d (fasl-intern (cdr object))))
           (fasl-emit (list :set-cons index a d) (list (* a 2) (* d 2)) (list complete))))
        ((arrayp object)
         (multiple-value-bind (target offset) (array-displacement object)
           (let ((target-id (and target (fasl-intern target))))
             (fasl-emit (list :array index (array-dimensions object) (array-element-type object)
                              (adjustable-array-p object)
                              (and (array-has-fill-pointer-p object) (fill-pointer object))
                              target-id offset)
                        (and target-id (list (* target-id 2))) (list allocated))))
         (let ((elements (loop for i below (array-total-size object)
                               collect (fasl-intern (row-major-aref object i)))))
           (fasl-emit (list :set-array index elements)
                      (mapcar (lambda (id) (* id 2)) elements) (list complete))))
        ((hash-table-p object)
         (let* ((test (hash-table-test object))
                (name (cond ((or (eq test 'eq) (eq test #'eq)) 'eq)
                            ((or (eq test 'eql) (eq test #'eql)) 'eql)
                            ((or (eq test 'equal) (eq test #'equal)) 'equal)
                            ((or (eq test 'equalp) (eq test #'equalp)) 'equalp)
                            (t (error "Unsupported FASL hash-table test ~S." test)))))
           (fasl-emit (list :hash-table index name (hash-table-count object)) nil (list allocated))
           (let ((entries nil))
             (maphash (lambda (key value) (push (list (fasl-intern key) (fasl-intern value)) entries)) object)
             (fasl-emit (list :set-hash-table index entries)
                        (loop for (key value) in entries append (list (* key 2) (* value 2)))
                        (list complete)))))
        (t
         (setf (gethash object *fasl-creating*) t)
         (multiple-value-bind (creation initialization) (make-load-form object)
           (multiple-value-bind (form dependencies)
               (let ((*fasl-creation-p* t)) (fasl-load-form creation))
             (fasl-emit (list :create index form) dependencies (list allocated complete)))
           (remhash object *fasl-creating*)
           (when initialization
             (multiple-value-bind (form dependencies)
                 (let ((*fasl-creation-p* nil)) (fasl-load-form initialization))
               (fasl-emit (list :initialize form) (cons allocated dependencies) nil))))
         (fasl-flush))))
    index))

(defun fasl-add-module (kir literals)
  (let ((index (fasl-intern literals)))
    (fasl-flush)
    (when *fasl-pending* (error 'fasl-creation-cycle))
    (fasl-emit (list :run kir index) nil nil)))

;;; The binary envelope only encodes record data: integers, characters,
;;; strings, symbols and lists. Arbitrary objects use indexed graph records.

(defun fasl-write-uint (integer stream)
  (loop while (>= integer 128)
        do (write-byte (logior 128 (logand integer 127)) stream)
           (setf integer (ash integer -7)))
  (write-byte integer stream))

(defun fasl-read-uint (stream)
  (loop for shift from 0 by 7 for byte = (read-byte stream)
        sum (ash (logand byte 127) shift) into result
        when (< byte 128) return result))

(defun fasl-write-data (object stream)
  (cond ((null object) (write-byte 0 stream))
        ((integerp object)
         (write-byte 1 stream)
         (fasl-write-uint (if (minusp object) (1- (* -2 object)) (* 2 object)) stream))
        ((stringp object)
         (write-byte 2 stream) (fasl-write-uint (length object) stream)
         (loop for char across object do (fasl-write-uint (char-code char) stream)))
        ((symbolp object)
         (write-byte 3 stream)
         (fasl-write-data (symbol-name object) stream)
         (fasl-write-data (and (symbol-package object) (package-name (symbol-package object))) stream))
        ((consp object)
         (write-byte 4 stream) (fasl-write-data (car object) stream) (fasl-write-data (cdr object) stream))
        ((characterp object) (write-byte 5 stream) (fasl-write-uint (char-code object) stream))
        (t (error "Unsupported FASL record datum ~S." object))))

(defun fasl-intern-symbol (name package)
  (if package
      (intern name (or (find-package package) (error "Missing FASL package ~S." package)))
      (make-symbol name)))

(defun fasl-read-data (stream)
  (case (read-byte stream)
    (0 nil)
    (1 (let ((value (fasl-read-uint stream)))
         (if (oddp value) (- (ash (1+ value) -1)) (ash value -1))))
    (2 (let ((string (make-string (fasl-read-uint stream))))
         (dotimes (i (length string) string)
           (setf (schar string i) (code-char (fasl-read-uint stream))))))
    (3 (let ((name (fasl-read-data stream)))
         (fasl-intern-symbol name (fasl-read-data stream))))
    (4 (let ((head (fasl-read-data stream))) (cons head (fasl-read-data stream))))
    (5 (code-char (fasl-read-uint stream)))
    (t (error "Invalid FASL record encoding."))))

(defun write-native-fasl (unit stream)
  (dolist (byte '(75 70 65 83 1)) (write-byte byte stream))
  (fasl-write-uint (first unit) stream)
  (fasl-write-uint (length (second unit)) stream)
  (dolist (record (second unit)) (fasl-write-data record stream)))

(defun execute-fasl-record (record)
  (let* ((kind (first record)) (index (second record)) (fields (cddr record)))
    (case kind
      (:symbol (setf (svref *fasl-load-objects* index) (apply #'fasl-intern-symbol fields)))
      (:integer (setf (svref *fasl-load-objects* index) (first fields)))
      (:character (setf (svref *fasl-load-objects* index) (code-char (first fields))))
      (:float (destructuring-bind (mantissa exponent sign doublep) fields
                (setf (svref *fasl-load-objects* index)
                      (* sign (scale-float (float mantissa (if doublep 1d0 1f0)) exponent)))))
      (:ratio (setf (svref *fasl-load-objects* index) (/ (first fields) (second fields))))
      (:complex (setf (svref *fasl-load-objects* index)
                      (complex (fasl-reference (first fields)) (fasl-reference (second fields)))))
      (:package (setf (svref *fasl-load-objects* index)
                      (or (find-package (first fields)) (error "Missing FASL package ~S." (first fields)))))
      (:pathname (setf (svref *fasl-load-objects* index) (parse-namestring (first fields))))
      (:string (setf (svref *fasl-load-objects* index) (first fields)))
      (:cons (setf (svref *fasl-load-objects* index) (cons nil nil)))
      (:set-cons (setf (car (fasl-reference index)) (fasl-reference (first fields))
                       (cdr (fasl-reference index)) (fasl-reference (second fields))))
      (:array (destructuring-bind (dimensions type adjustable fill target offset) fields
                (setf (svref *fasl-load-objects* index)
                      (make-array dimensions :element-type type :adjustable adjustable
                                  :fill-pointer fill :displaced-to (and target (fasl-reference target))
                                  :displaced-index-offset offset))))
      (:set-array (loop for element in (first fields) for i from 0
                        do (setf (row-major-aref (fasl-reference index) i) (fasl-reference element))))
      (:hash-table (setf (svref *fasl-load-objects* index)
                         (make-hash-table :test (first fields) :size (max 1 (second fields)))))
      (:set-hash-table (dolist (entry (first fields))
                         (setf (gethash (fasl-reference (first entry)) (fasl-reference index))
                               (fasl-reference (second entry)))))
      (:create (setf (svref *fasl-load-objects* index) (eval (first fields))))
      (:initialize (eval index))
      (:run (funcall 'kiln.compiler::load-native-file index (fasl-reference (first fields))))
      (t (error "Unknown FASL operation ~S." kind)))))

(defun load-native-fasl (stream &key verbose)
  (declare (ignore verbose))
  (dolist (byte '(75 70 65 83 1))
    (unless (= (read-byte stream) byte) (error "Unsupported native FASL header or version.")))
  (let ((*fasl-load-objects* (make-array (fasl-read-uint stream))))
    (dotimes (i (fasl-read-uint stream))
      (execute-fasl-record (fasl-read-data stream))))
  t)
