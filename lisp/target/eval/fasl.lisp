;;;; Native file object graphs. Creation and initialization are separate
;;;; operations, so containers can refer to themselves and to later creators.

(in-package #:kiln.kernel)

(define-condition fasl-creation-cycle (program-error) ())
(defvar *fasl-ids*)
(defvar *fasl-ready*)
(defvar *fasl-count*)
(defvar *fasl-records*)
(defvar *fasl-pending*)
(defvar *fasl-creating*)
(defvar *fasl-creation-p* nil)
(defvar *fasl-load-objects*)

(defun fasl-reference (index)
  (svref *fasl-load-objects* index))

(defun fasl-emit (operation dependencies tokens)
  (if (every (lambda (token) (gethash token *fasl-ready*)) dependencies)
      (progn
        (push operation *fasl-records*)
        (dolist (token tokens) (setf (gethash token *fasl-ready*) t)))
      (push (list operation dependencies tokens) *fasl-pending*)))

(defun fasl-flush ()
  (loop with progress = t while (and progress *fasl-pending*)
        do (setf progress nil)
           (let ((pending *fasl-pending*))
             (setf *fasl-pending* nil)
             (dolist (entry pending)
               (if (every (lambda (token) (gethash token *fasl-ready*)) (second entry))
                   (progn
                     (setf progress t)
                     (fasl-emit (first entry) nil (third entry)))
                   (push entry *fasl-pending*)))
             (setf *fasl-pending* (nreverse *fasl-pending*)))))

(defun fasl-literal-dependencies (object)
  (let ((seen (make-hash-table :test 'eq)) (dependencies nil))
    (labels ((walk (object)
               (unless (gethash object seen)
                 (setf (gethash object seen) t)
                 (let ((index (fasl-intern object)))
                   (pushnew (+ (* index 2)
                               (if (or (consp object) (arrayp object) (hash-table-p object)) 1 0))
                            dependencies))
                 (cond ((consp object) (walk (car object)) (walk (cdr object)))
                       ((and (arrayp object) (not (stringp object)))
                        (dotimes (i (array-total-size object)) (walk (row-major-aref object i))))
                       ((hash-table-p object)
                        (maphash (lambda (key value) (walk key) (walk value)) object))))))
      (walk object))
    dependencies))

(defun fasl-load-form (form)
  (let ((dependencies nil))
    (labels ((walk (form)
               (cond ((and (consp form) (eq (car form) 'quote))
                      (setf dependencies (union (fasl-literal-dependencies (second form)) dependencies))
                      `(fasl-reference ,(fasl-intern (second form))))
                     ((consp form) (mapcar #'walk form))
                     ((or (symbolp form) (integerp form) (characterp form)) form)
                     (t
                      (setf dependencies (union (fasl-literal-dependencies form) dependencies))
                      `(fasl-reference ,(fasl-intern form))))))
      (values (walk form) dependencies))))

(defun fasl-intern (object)
  (multiple-value-bind (old found) (gethash object *fasl-ids*)
    (when found
      (when (and *fasl-creation-p* (gethash object *fasl-creating*))
        (error 'fasl-creation-cycle))
      (return-from fasl-intern old)))
  (let* ((index (prog1 *fasl-count* (incf *fasl-count*)))
         (allocated (* index 2)) (complete (1+ allocated)))
    (setf (gethash object *fasl-ids*) index)
    (flet ((value (kind &rest fields)
             (fasl-emit (list* kind index fields) nil (list allocated complete))))
      (cond
        ((symbolp object)
         (value :symbol (symbol-name object)
                (and (symbol-package object) (package-name (symbol-package object)))))
        ((integerp object) (value :integer object))
        ((characterp object) (value :character (char-code object)))
        ((floatp object)
         (if (typep object 'double-float)
             (value :double-bits (%primop :double-float-high-bits object)
                                 (%primop :double-float-low-bits object))
             (value :single-bits (%primop :single-float-bits object))))
        ((ratiop object) (value :ratio (numerator object) (denominator object)))
        ((complexp object)
         (let ((real (fasl-intern (realpart object))) (imag (fasl-intern (imagpart object))))
           (fasl-emit (list :complex index real imag) (list (* real 2) (* imag 2))
                      (list allocated complete))))
        ((packagep object) (value :package (package-name object)))
        ((pathnamep object)
         (value :pathname (namestring object)))
        ((consp object)
         (fasl-emit (list :cons index) nil (list allocated))
         (let ((a (fasl-intern (car object))) (d (fasl-intern (cdr object))))
           (fasl-emit (list :set-cons index a d) (list (* a 2) (* d 2)) (list complete))))
        ((arrayp object)
         (multiple-value-bind (target offset) (array-displacement object)
           (let ((target-id (and target (fasl-intern target))))
             (fasl-emit (list :array index (array-dimensions object) (array-element-type object)
                              (adjustable-array-p object)
                              (and (array-has-fill-pointer-p object) (fill-pointer object))
                              target-id offset)
                        (and target-id (list (* target-id 2))) (list allocated))))
         (let ((elements (loop for i below (array-total-size object)
                               collect (fasl-intern (row-major-aref object i)))))
           (fasl-emit (list :set-array index elements)
                      (mapcar (lambda (id) (* id 2)) elements) (list complete))))
        ((hash-table-p object)
         (let* ((test (hash-table-test object))
                (name (cond ((or (eq test 'eq) (eq test #'eq)) 'eq)
                            ((or (eq test 'eql) (eq test #'eql)) 'eql)
                            ((or (eq test 'equal) (eq test #'equal)) 'equal)
                            ((or (eq test 'equalp) (eq test #'equalp)) 'equalp)
                            (t (error "Unsupported FASL hash-table test ~S." test)))))
           (fasl-emit (list :hash-table index name (hash-table-count object)) nil (list allocated))
           (let ((entries nil))
             (maphash (lambda (key value) (push (list (fasl-intern key) (fasl-intern value)) entries)) object)
             (fasl-emit (list :set-hash-table index entries)
                        (loop for (key value) in entries append (list (* key 2) (* value 2)))
                        (list complete)))))
        (t
         (setf (gethash object *fasl-creating*) t)
         (multiple-value-bind (creation initialization) (make-load-form object)
           (multiple-value-bind (form dependencies)
               (let ((*fasl-creation-p* t)) (fasl-load-form creation))
             (fasl-emit (list :create index form) dependencies (list allocated complete)))
           (remhash object *fasl-creating*)
           (when initialization
             (multiple-value-bind (form dependencies)
                 (let ((*fasl-creation-p* nil)) (fasl-load-form initialization))
               (fasl-emit (list :initialize form) (cons allocated dependencies) nil))))
         (fasl-flush))))
    index))

(defun fasl-add-module (kir literals)
  (let ((index (fasl-intern literals)))
    (fasl-flush)
    (when *fasl-pending* (error 'fasl-creation-cycle))
    (fasl-emit (list :run kir index) nil nil)))

;;; The binary envelope only encodes record data: integers, characters,
;;; strings, symbols and lists. Arbitrary objects use indexed graph records.

(defconstant +fasl-output-chunk-size+ 4096)

(defstruct fasl-output
  stream
  (bytes (make-simple-vector +fasl-output-chunk-size+))
  (count 0 :type fixnum))

(defun fasl-binary-file-stream-p (stream)
  (and (typep stream 'cyclosis::kiln-file-stream)
       (equal (stream-element-type stream) '(unsigned-byte 8))))

(defun fasl-flush-output (output)
  (let ((count (fasl-output-count output)))
    (unless (zerop count)
      (cyclosis:stream-write-octets (fasl-output-stream output)
                                    (fasl-output-bytes output) 0 count)
      (setf (fasl-output-count output) 0))))

(declaim (inline fasl-write-octet))
(defun fasl-write-octet (byte output)
  (if (typep output 'fasl-output)
      (let ((count (fasl-output-count output)))
        (when (= count +fasl-output-chunk-size+)
          (fasl-flush-output output)
          (setf count 0))
        (%primop :set-svref-unchecked (fasl-output-bytes output) count byte)
        (setf (fasl-output-count output) (%primop :fixnum+ count 1)))
      (write-byte byte output)))

(defun fasl-write-octet-vector (bytes output)
  (cond ((typep output 'fasl-output)
         (fasl-flush-output output)
         (cyclosis:stream-write-octets (fasl-output-stream output) bytes))
        ((fasl-binary-file-stream-p output)
         (cyclosis:stream-write-octets output bytes))
        (t (write-sequence bytes output))))

(defun fasl-write-uint (integer stream)
  (loop while (>= integer 128)
        do (fasl-write-octet (logior 128 (logand integer 127)) stream)
           (setf integer (ash integer -7)))
  (fasl-write-octet integer stream))

(defstruct fasl-input
  stream
  buffer-state)

(declaim (inline fasl-read-octet))
(defun fasl-read-octet (input)
  (if (typep input 'fasl-input)
      (let* ((state (fasl-input-buffer-state input))
             (start (cyclosis::buffer-state-in-start state))
             (end (cyclosis::buffer-state-in-end state)))
        (if (and (%primop :fixnum-index-below start end)
                 (eql 0 (cyclosis::buffer-state-out-end state)))
            (prog1 (%primop :svref-unchecked (cyclosis::buffer-state-buffer state) start)
              (setf (cyclosis::buffer-state-in-start state) (%primop :fixnum+ start 1)))
            (read-byte (fasl-input-stream input))))
      (read-byte input)))

(defun fasl-input-stream-or-self (input)
  (if (typep input 'fasl-input) (fasl-input-stream input) input))

(defun fasl-read-uint (stream)
  (let ((first (fasl-read-octet stream)))
    (if (< first 128)
        first
        (loop with result = (logand first 127)
              for shift from 7 by 7 for byte = (fasl-read-octet stream)
              do (incf result (ash (logand byte 127) shift))
              when (< byte 128) return result))))

(defun fasl-write-data (object stream &optional (pending (make-simple-vector 64)))
  (declare (simple-vector pending))
  (let ((top 0))
    (declare (fixnum top))
    (macrolet ((push-value (value)
                 `(progn
                    (when (= top (%primop :length pending))
                      (let ((larger (make-simple-vector (* 2 top))))
                        (replace larger pending)
                        (setf pending larger)))
                    (%primop :set-svref-unchecked pending top ,value)
                    (incf top))))
      (push-value object)
      (loop while (plusp top)
            for object = (progn
                           (decf top)
                           (prog1 (%primop :svref-unchecked pending top)
                             (%primop :set-svref-unchecked pending top nil)))
            do (cond ((null object) (fasl-write-octet 0 stream))
                     ((integerp object)
                      (fasl-write-octet 1 stream)
                      (fasl-write-uint (if (minusp object) (1- (* -2 object)) (* 2 object)) stream))
                     ((stringp object)
                      (fasl-write-octet 2 stream) (fasl-write-uint (length object) stream)
                      (loop for char across object do (fasl-write-uint (char-code char) stream)))
                     ((symbolp object)
                      (fasl-write-octet 3 stream)
                      (push-value (and (symbol-package object) (package-name (symbol-package object))))
                      (push-value (symbol-name object)))
                     ((consp object)
                      (fasl-write-octet 4 stream)
                      (push-value (cdr object))
                      (push-value (car object)))
                     ((characterp object) (fasl-write-octet 5 stream) (fasl-write-uint (char-code object) stream))
                     ((simple-vector-p object)
                      (fasl-write-octet 6 stream) (fasl-write-uint (length object) stream)
                      (loop for index of-type fixnum below (the fixnum (%primop :length object))
                            for octet = (%primop :svref-unchecked object index)
                            unless (and (%primop :fixnump octet)
                                        (%primop :fixnum-index-below octet 256))
                              do (error "Invalid packet octet."))
                      (fasl-write-octet-vector object stream))
                     (t (error "Unsupported FASL record datum ~S." object)))))))

(defun fasl-intern-symbol (name package)
  (if package
      (intern name (or (find-package package) (error "Missing FASL package ~S." package)))
      (make-symbol name)))

(defun fasl-read-record (stream frames)
  (declare (simple-vector frames))
  ;; Each pending pair takes two slots. A negative tag means its first
  ;; value has been read and is stored in the second slot.
  (let ((top 0) (need-value t) (value nil))
    (declare (fixnum top))
    (loop
      (when need-value
        (setf need-value nil)
        (let ((tag (fasl-read-octet stream)))
          (setf value
                (case tag
                  (0 nil)
                  (1 (let ((integer (fasl-read-uint stream)))
                       (if (oddp integer) (- (ash (1+ integer) -1)) (ash integer -1))))
                  (2 (let ((string (make-string (fasl-read-uint stream))))
                       (dotimes (index (length string) string)
                         (setf (schar string index) (code-char (fasl-read-uint stream))))))
                  ((3 4)
                   (when (= top (length frames))
                     (let ((larger (make-simple-vector (* 2 top))))
                       (replace larger frames)
                       (setf frames larger)))
                   (setf (svref frames top) tag need-value t)
                   (incf top 2)
                   nil)
                  (5 (code-char (fasl-read-uint stream)))
                  (6 (let ((bytes (make-array (fasl-read-uint stream)))
                           (input (fasl-input-stream-or-self stream)))
                       (unless (= (read-sequence bytes input) (length bytes))
                         (error 'end-of-file :stream input))
                       bytes))
                  (t (error "Invalid FASL record encoding."))))))
      (unless need-value
        (when (zerop top) (return (values value frames)))
        (let* ((tag-index (- top 2))
               (value-index (1- top))
               (tag (the fixnum (svref frames tag-index))))
          (if (minusp tag)
              (let ((first (svref frames value-index)))
                (setf top tag-index
                      (svref frames value-index) nil
                      value (if (= tag -3) (fasl-intern-symbol first value)
                                (cons first value))))
              (setf (svref frames tag-index) (- tag)
                    (svref frames value-index) value need-value t)))))))

(defun fasl-read-data (stream)
  (values (fasl-read-record stream (make-simple-vector 128))))

;; Starting with version 3, the format assigns the record kinds their positions in this table.
(defvar *fasl-record-kinds*
  #(:symbol :integer :character :single-bits :double-bits :float :ratio :complex
    :package :pathname :string :cons :set-cons :array :set-array :hash-table
    :set-hash-table :create :initialize :run))

(defun fasl-write-records (unit stream)
  (dolist (byte '(137 75 70 65 83 4)) (fasl-write-octet byte stream))
  (fasl-write-uint (first unit) stream)
  (fasl-write-uint (length (second unit)) stream)
  (let ((pending (make-simple-vector 64)))
    (dolist (record (second unit))
      (fasl-write-octet (or (position (car record) *fasl-record-kinds* :test #'eq)
                           (error "Unknown FASL operation ~S." (car record)))
                        stream)
      (case (car record)
        ((:cons :set-cons)
         (dolist (index (cdr record)) (fasl-write-uint index stream)))
        (otherwise (fasl-write-data (cdr record) stream pending))))))

(defun write-native-fasl (unit stream)
  (if (fasl-binary-file-stream-p stream)
      (let ((output (make-fasl-output :stream stream)))
        (fasl-write-records unit output)
        (fasl-flush-output output))
      (fasl-write-records unit stream)))

(defun fasl-read-header (stream)
  (dolist (byte '(137 75 70 65 83))
    (unless (= (fasl-read-octet stream) byte) (error "Invalid native FASL header.")))
  (let ((version (fasl-read-octet stream)))
    (unless (member version '(2 3 4))
      (error "Unsupported native FASL version ~D." version))
    version))

(declaim (inline fasl-read-kind))
(defun fasl-read-kind (stream)
  (let ((code (fasl-read-octet stream)))
    (unless (<= 0 code (1- (length *fasl-record-kinds*)))
      (error "Unknown FASL opcode ~D." code))
    (svref *fasl-record-kinds* code)))

(defun fasl-read-tagged-record (kind stream frames)
  (multiple-value-bind (fields storage) (fasl-read-record stream frames)
    (values (cons kind fields) storage)))

(defun fasl-read-file-record (stream frames version)
  (if (= version 2)
      (fasl-read-record stream frames)
      (let ((kind (fasl-read-kind stream)))
        (if (= version 3)
            (fasl-read-tagged-record kind stream frames)
            (case kind
              (:cons (values (list :cons (fasl-read-uint stream)) frames))
              (:set-cons
               (values (list :set-cons (fasl-read-uint stream) (fasl-read-uint stream)
                             (fasl-read-uint stream))
                       frames))
              (otherwise (fasl-read-tagged-record kind stream frames)))))))

(defun fasl-allocate-cons (index)
  (setf (svref *fasl-load-objects* index) (cons nil nil)))

(defun fasl-initialize-cons (index head tail)
  (let ((object (fasl-reference index)))
    (setf (car object) (fasl-reference head)
          (cdr object) (fasl-reference tail))))

(defun execute-fasl-record (record)
  (let* ((kind (first record)) (index (second record)) (fields (cddr record)))
    (case kind
      (:symbol (setf (svref *fasl-load-objects* index) (apply #'fasl-intern-symbol fields)))
      (:integer (setf (svref *fasl-load-objects* index) (first fields)))
      (:character (setf (svref *fasl-load-objects* index) (code-char (first fields))))
      (:single-bits (setf (svref *fasl-load-objects* index)
                          (%primop :make-single-float-bits (first fields))))
      (:double-bits (setf (svref *fasl-load-objects* index)
                          (%primop :make-double-float-bits (first fields) (second fields))))
      (:float (destructuring-bind (mantissa exponent sign doublep) fields
                (setf (svref *fasl-load-objects* index)
                      (* sign (scale-float (float mantissa (if doublep 1d0 1f0)) exponent)))))
      (:ratio (setf (svref *fasl-load-objects* index) (/ (first fields) (second fields))))
      (:complex (setf (svref *fasl-load-objects* index)
                      (complex (fasl-reference (first fields)) (fasl-reference (second fields)))))
      (:package (setf (svref *fasl-load-objects* index)
                      (or (find-package (first fields)) (error "Missing FASL package ~S." (first fields)))))
      (:pathname (setf (svref *fasl-load-objects* index) (parse-namestring (first fields))))
      (:string (setf (svref *fasl-load-objects* index) (first fields)))
      (:cons (fasl-allocate-cons index))
      (:set-cons (fasl-initialize-cons index (first fields) (second fields)))
      (:array (destructuring-bind (dimensions type adjustable fill target offset) fields
                (setf (svref *fasl-load-objects* index)
                      (make-array dimensions :element-type type :adjustable adjustable
                                  :fill-pointer fill :displaced-to (and target (fasl-reference target))
                                  :displaced-index-offset offset))))
      (:set-array (loop for element in (first fields) for i from 0
                        do (setf (row-major-aref (fasl-reference index) i) (fasl-reference element))))
      (:hash-table (setf (svref *fasl-load-objects* index)
                         (make-hash-table :test (first fields) :size (max 1 (second fields)))))
      (:set-hash-table (dolist (entry (first fields))
                         (setf (gethash (fasl-reference (first entry)) (fasl-reference index))
                               (fasl-reference (second entry)))))
      (:create (setf (svref *fasl-load-objects* index) (eval (first fields))))
      (:initialize (eval index))
      (:run (funcall 'kiln.compiler::load-native-file index (fasl-reference (first fields))))
      (t (error "Unknown FASL operation ~S." kind)))))

(defun load-native-fasl (stream &key verbose owned-stream)
  (declare (ignore verbose))
  (let* ((stream (if (and owned-stream (fasl-binary-file-stream-p stream))
                     (make-fasl-input :stream stream :buffer-state (cyclosis::file-state stream))
                     stream))
         (version (fasl-read-header stream))
         (*fasl-load-objects* (make-array (fasl-read-uint stream)))
        (frames (make-simple-vector 128)))
    (dotimes (i (fasl-read-uint stream))
      (if (= version 4)
          (let ((kind (fasl-read-kind stream)))
            (case kind
              (:cons (fasl-allocate-cons (fasl-read-uint stream)))
              (:set-cons
               (fasl-initialize-cons (fasl-read-uint stream) (fasl-read-uint stream)
                                     (fasl-read-uint stream)))
              (otherwise
               (multiple-value-bind (record storage) (fasl-read-tagged-record kind stream frames)
                 (setf frames storage)
                 (execute-fasl-record record)))))
          (multiple-value-bind (record storage) (fasl-read-file-record stream frames version)
            (setf frames storage)
            (execute-fasl-record record)))))
  t)
