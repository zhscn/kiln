(in-package #:kiln.compiler)

(defvar *ir-special-forms* (make-hash-table :test 'eq))

(defmacro define-ir-converter (name (parts environment) &body body)
  `(setf (gethash ',name *ir-special-forms*)
         (lambda (,parts ,environment) ,@body)))

(defun ir-arity (name parts min &optional (max min))
  (unless (and (>= (length parts) min) (or (null max) (<= (length parts) max)))
    (ir-error "~S expects ~D~@[ to ~D~] operands, got ~D" name min max (length parts))))

(defun ir-variable-name (form)
  (let ((name (ir-raw form)))
    (unless (and (symbolp name) name (not (eq name t)) (not (keywordp name))
                 (not (member name lambda-list-keywords)))
      (ir-error "Invalid variable name ~S" name))
    (when (typep (trucler:describe-variable *client* (ir-base-environment *environment*) name)
                 'trucler:constant-variable-description)
      (ir-error "Cannot bind or assign constant ~S" name))
    name))

(defun ir-function-name-p (name)
  (or (and (symbolp name) name)
      (and (consp name) (eq (car name) 'setf) (consp (cdr name))
           (symbolp (second name)) (null (cddr name)))))

(defun ir-convert-vector (forms environment)
  (map 'simple-vector (lambda (form) (ir-convert form environment)) forms))

(defun ir-progn (forms environment)
  (cond ((null forms) (ir-node 0 *ir-source* nil))
        ((null (cdr forms)) (ir-convert (car forms) environment))
        (t (ir-node 10 *ir-source* (ir-convert-vector forms environment)))))

(defun ir-convert-body (forms environment &optional documentation)
  (multiple-value-bind (body declarations) (ir-split-body forms documentation)
    (let ((*local-notinline* (append (loop for spec in declarations
                                         when (eq (car spec) 'notinline) append (cdr spec))
                                    *local-notinline*)))
      (ir-progn body (ir-declare environment declarations)))))

(defun ir-convert-symbol (name environment)
  (when (constant-symbol-p name)
    (return-from ir-convert-symbol (ir-node 0 *ir-source* name)))
  (multiple-value-bind (binding found) (ir-lookup environment name :var)
    (cond ((ir-var-p binding)
           (let ((type (ir-declared-variable-type environment binding)))
             (ir-node 1 *ir-source* (ir-note-ref binding) (unless (eq type t) type))))
          ((and found (eq (car binding) :symbol-macro))
           (ir-convert (second binding) environment))
          ((and found (eq (car binding) :special)) (ir-node 3 *ir-source* name))
          (t
           (let ((description (trucler:describe-variable *client* environment name)))
             (cond ((typep description 'trucler:constant-variable-description)
                    (note-dependency :constant name)
                    (ir-node 0 *ir-source* (trucler:value description)))
                   ((typep description 'trucler:symbol-macro-description)
                    (ir-convert (trucler:expansion description) environment))
                   ((or (null name) (eq name t) (keywordp name)) (ir-node 0 *ir-source* name))
                   (t (ir-node 3 *ir-source* name))))))))

(defun ir-note-form-sources (cst)
  (let ((table (make-hash-table :test 'eq))
        (seen (make-hash-table :test 'eq)))
    (labels ((walk (cst)
               (loop for tail = cst then (cst:rest tail)
                     while (cst:consp tail)
                     do (let ((raw (cst:raw tail)) (source (cst:source tail)))
                          (when (gethash raw seen) (return))
                          (setf (gethash raw seen) t)
                          (when (and (consp source) (integerp (car source))
                                     (integerp (cdr source)) (not (gethash raw table)))
                            (setf (gethash raw table)
                                  (ir-source-position *ir-file-id* (car source) (cdr source)))))
                        (walk (cst:first tail)))))
      (walk cst))
    table))

(defun ir-input-source (input)
  "The source position of INPUT, a CST or a plain form; else the enclosing one."
  (let ((source (and (typep input 'cst:cst) (cst:source input))))
    (cond ((and (consp source) (integerp (car source)) (integerp (cdr source)))
           (ir-source-position *ir-file-id* (car source) (cdr source)))
          ((consp (ir-raw input))
           (when (and (null *ir-form-sources*) *ir-top-cst*)
             (setf *ir-form-sources* (ir-note-form-sources *ir-top-cst*)))
           (or (and *ir-form-sources* (gethash (ir-raw input) *ir-form-sources*))
               *ir-source*))
          (t *ir-source*))))

(defvar *ir-step-recording* nil)
(defvar *ir-step-skip* nil)

(defun ir-convert (input environment)
  (let* ((*ir-conversion-depth* (1+ *ir-conversion-depth*))
         (*environment* environment)
         (*ir-source* (ir-input-source input))
         (form (ir-raw input)))
    (when (> *ir-conversion-depth* 10000) (ir-error "Excessive form or macro expansion nesting"))
    (when (consp form)
      (when (member (car form) '(kiln.sys::%step-body kiln.sys::%step-original kiln.sys::%step-quiet))
        (ir-arity (car form) (cdr form) 1)
        (let ((*ir-step-recording* (not (eq (car form) 'kiln.sys::%step-quiet)))
              (*ir-step-skip* (and (eq (car form) 'kiln.sys::%step-original) (second form))))
          (return-from ir-convert (ir-convert (second form) environment))))
      (when (and *ir-step-recording* (not (eq form *ir-step-skip*))
                 (not (gethash (car form) *ir-special-forms*))
                 (or (and (consp (car form)) (eq (caar form) 'lambda))
                     (and (symbolp (car form))
                          (not (typep (trucler:describe-function *client* environment (car form))
                                      '(or trucler:macro-description trucler:special-operator-description))))))
        (let ((*ir-step-recording* nil))
          (return-from ir-convert (ir-convert (step-call-form form) environment)))))
    (let ((*ir-step-skip* nil))
    (cond ((symbolp form) (ir-convert-symbol form environment))
          ((atom form) (ir-node 0 *ir-source* form))
          (t
           (let* ((parts (ir-parts input)) (op (ir-raw (first parts)))
                  (converter (gethash op *ir-special-forms*)))
             (when converter
               (return-from ir-convert (funcall converter (rest parts) environment)))
             (when (and (symbolp op) (special-operator-p op))
               (ir-error "Unsupported special operator ~S" op))
             (when (and (symbolp op) (inline-call-p *client* environment form))
               (note-dependency :inline (inline-call form))
               (return-from ir-convert
                 (ir-convert (inline-expansion form) environment)))
             (let ((expansion (compiler-macro-expansion *client* environment form)))
               (when expansion (return-from ir-convert (ir-convert expansion environment))))
             (when (and (symbolp op) (not (ir-fun-p (ir-lookup environment op :fun))))
               (multiple-value-bind (expansion expanded) (macroexpand-toplevel form)
                 (when expanded
                   (unless (nth-value 1 (ir-lookup environment op :fun)) (note-dependency :macro op))
                   (return-from ir-convert (ir-convert expansion environment)))))
             (ir-convert-call op (rest parts) environment)))))))

(defun ir-convert-call (name args environment)
  (let ((callee
          (cond ((symbolp name)
                 (or (ir-lookup environment name :fun)
                     (progn
                       (unless (or (gethash name *defined-functions*) (gethash name *primitives*)
                                   (trucler:describe-function *client* environment name))
                         (setf (gethash name *referenced-functions*) t))
                       name)))
                ((and (consp name) (eq (car name) 'lambda))
                 (ir-convert-lambda (cdr name) environment nil))
                (t (ir-error "Invalid function position ~S" name)))))
    (when (ir-fun-p callee) (ir-note-call callee))
    (when (eq callee 'kiln.sys:%primop)
      (unless (and args (keywordp (ir-raw (first args))))
        (ir-error "%PRIMOP requires a literal keyword"))
      (unless (gethash (ir-raw (first args)) *primops*)
        (ir-error "Unknown primop ~S" (ir-raw (first args))))
      (return-from ir-convert-call
        (ir-node 8 *ir-source* (ir-convert-vector (rest args) environment) (ir-raw (first args)))))
    (let ((arguments (ir-convert-vector args environment)))
      (when (and (eq callee 'funcall) (plusp (length arguments)))
        (setf callee (let ((function (svref arguments 0)))
                       (if (member (ir-node-kind function) '(5 6)) (ir-node-a function) function))
              arguments (subseq arguments 1))
        (when (ir-fun-p callee)
          (decf (ir-fun-value-refs callee))
          (when (zerop (ir-fun-value-refs callee))
            (setf (ir-fun-flags callee) (logior 8 (logandc2 (ir-fun-flags callee) 1))))
          (ir-note-call callee)))
      (let ((node (ir-node 7 *ir-source* callee arguments)))
        (when (ir-fun-p callee) (setf (ir-fun-call-site callee) node))
        node))))

(define-ir-converter quote (parts environment)
  (declare (ignore environment))
  (ir-arity 'quote parts 1)
  (ir-node 0 *ir-source* (ir-raw (first parts))))

(define-ir-converter declare (parts environment)
  (declare (ignore parts environment))
  (ir-error "DECLARE is only valid at the beginning of a declaration scope"))

(define-ir-converter progn (parts environment) (ir-progn parts environment))

(define-ir-converter if (parts environment)
  (ir-arity 'if parts 2 3)
  (ir-node 9 *ir-source* (ir-convert (first parts) environment)
           (ir-convert (second parts) environment) (ir-convert (third parts) environment)))

(define-ir-converter setq (parts environment)
  (unless (evenp (length parts)) (ir-error "SETQ requires pairs of names and values"))
  (let ((forms (make-ir-buffer)))
    (loop for (name value) on parts by #'cddr
          for symbol = (ir-variable-name name)
          do (multiple-value-bind (expansion macro-p) (symbol-macro-expansion *client* environment symbol)
               (ir-push
                (if macro-p
                    (ir-convert `(setf ,expansion ,(ir-raw value)) environment)
                    (let ((binding (ir-lookup environment symbol :var)))
                      (if (ir-var-p binding)
                          (ir-node 2 *ir-source* (ir-note-ref binding t) (ir-convert value environment))
                          (ir-node 4 *ir-source* symbol (ir-convert value environment)))))
                forms)))
    (ir-node 10 *ir-source* (ir-vector forms))))

(defun ir-bindings (input)
  (mapcar (lambda (binding)
            (if (symbolp (ir-raw binding))
                (list (ir-variable-name binding) nil)
                (let ((parts (ir-parts binding)))
                  (ir-arity 'binding parts 1 2)
                  (list (ir-variable-name (first parts)) (second parts)))))
          (ir-parts input)))

(defun ir-convert-let (parts environment sequential)
  (ir-arity (if sequential 'let* 'let) parts 1 nil)
  (let ((bindings (ir-bindings (first parts))))
    (unless sequential
      (let ((names (mapcar #'first bindings)))
        (unless (= (length names) (length (remove-duplicates names)))
          (ir-error "Duplicate LET binding"))))
    (multiple-value-bind (body declarations) (ir-split-body (rest parts))
      (let ((env environment) (variables (make-ir-buffer)) (initializers (make-ir-buffer))
            (specials '()))
        (dolist (binding bindings)
          (destructuring-bind (name init) binding
            (let* ((special (ir-special-binding-p name declarations environment))
                   (variable (ir-new-var (if special (gensym "SPECIAL") name)))
                   (initializer (ir-convert init (if sequential env environment))))
              (when (= (ir-node-kind initializer) 0)
                (setf (ir-var-constant variable) (ir-node-a initializer)
                      (ir-var-constant-p variable) t))
              (ir-push variable variables)
              (ir-push initializer initializers)
              (if special
                  (progn
                    (push (cons name variable) specials)
                    (setf env (ir-env env :vars (list (cons name '(:special))))))
                  (setf env (ir-env env :vars (list (cons name variable)))))
              (when sequential
                (setf env (ir-declare-binding env name declarations)
                      (ir-var-type variable) (ir-declared-variable-type env variable))))))
        ;; LET* dynamic bindings surround all subsequent initializers, so
        ;; construct their scopes as nested LET/BIND pairs.
        (let* ((env (ir-declare env declarations))
               (*local-notinline* (append (loop for spec in declarations
                                               when (eq (car spec) 'notinline) append (cdr spec))
                                          *local-notinline*))
               (result (progn
                         (loop for var across (ir-vector variables)
                               do (setf (ir-var-type var) (ir-declared-variable-type env var)))
                         (ir-progn body env)))
               (vars (ir-vector variables)) (inits (ir-vector initializers)))
          (if sequential
              (loop for i downfrom (1- (length vars)) to 0
                    for var = (svref vars i)
                    for special = (rassoc var specials)
                    do (when special
                         (setf result (ir-node 12 *ir-source* (car special)
                                               (ir-node 1 *ir-source* (ir-note-ref var)) result)))
                       (setf result (ir-node 11 *ir-source* (vector var) (vector (svref inits i)) result)))
              (progn
                (dolist (special specials)
                  (setf result (ir-node 12 *ir-source* (car special)
                                        (ir-node 1 *ir-source* (ir-note-ref (cdr special))) result)))
                (setf result (ir-node 11 *ir-source* vars inits result))))
          result)))))

(define-ir-converter let (parts environment) (ir-convert-let parts environment nil))
(define-ir-converter let* (parts environment) (ir-convert-let parts environment t))
(define-ir-converter locally (parts environment) (ir-convert-body parts environment))

(define-ir-converter %with-inline (parts environment)
  (let ((*inline-expanding* (cons (ir-raw (first parts)) *inline-expanding*)))
    (ir-progn (rest parts) environment)))

(defun ir-convert-lambda (parts environment name &optional existing)
  (ir-arity 'lambda parts 1 nil)
  (let* ((fun (or existing (make-ir-fun :name name :parent *ir-function* :source *ir-source*)))
         (*ir-function* fun)
         (function-exit (and name (ir-new-exit (if (consp name) (second name) name))))
         (env (if function-exit
                  (ir-env environment :blocks (list (cons (ir-exit-name function-exit) function-exit)))
                  environment))
         (specials '()) (aux '())
         (ll (make-ir-lambda-list)) (required (make-ir-buffer))
         (optional (make-ir-buffer)) (keys (make-ir-buffer)) (state :required) (names '()))
    (multiple-value-bind (body declarations) (ir-split-body (rest parts) t)
      (labels ((parameter (input)
                 (let* ((name (ir-variable-name input))
                        (special (ir-special-binding-p name declarations environment))
                        (var (ir-new-var (if special (gensym "ARG") name))))
                   (when (member name names) (ir-error "Duplicate parameter ~S" name))
                   (push name names)
                   (if special
                       (progn (push (cons name var) specials)
                              (setf env (ir-env env :vars (list (cons name '(:special))))))
                       (setf env (ir-env env :vars (list (cons name var)))))
                   (setf env (ir-declare-binding env name declarations)
                         (ir-var-type var) (ir-declared-variable-type env var))
                   var)))
        (dolist (input (ir-parts (first parts)))
          (let ((item (ir-raw input)))
            (cond
              ((member item lambda-list-keywords)
               (case item
                 (&optional (unless (eq state :required) (ir-error "Misplaced &OPTIONAL"))
                            (setf state :optional))
                 (&rest (unless (member state '(:required :optional)) (ir-error "Misplaced &REST"))
                        (setf state :rest))
                 (&key (unless (member state '(:required :optional :after-rest)) (ir-error "Misplaced &KEY"))
                       (setf state :key (ir-lambda-list-key-p ll) t))
                 (&allow-other-keys
                  (unless (eq state :key) (ir-error "Misplaced &ALLOW-OTHER-KEYS"))
                  (setf (ir-lambda-list-allow-other-keys ll) t state :after-keys))
                 (&aux (unless (member state '(:required :optional :after-rest :key :after-keys))
                         (ir-error "Misplaced &AUX"))
                       (setf state :aux))
                 (otherwise (ir-error "Invalid ordinary lambda list keyword ~S" item))))
              ((eq state :required) (ir-push (parameter input) required))
              ((eq state :rest) (setf (ir-lambda-list-rest ll) (parameter input) state :after-rest))
              ((member state '(:optional :key))
               (let* ((spec (if (symbolp item) (list input) (ir-parts input)))
                      (head (ir-raw (first spec)))
                      (keyword (when (eq state :key)
                                 (if (consp head)
                                     (progn (ir-arity 'keyword-parameter head 2) (first head))
                                     (intern (symbol-name head) '#:keyword))))
                      (variable-name (if (consp head) (second head) head)))
                 (ir-arity 'parameter spec 1 3)
                 (when (and (eq state :optional) (consp head)) (ir-error "Invalid optional parameter"))
                 (unless (or (null keyword) (symbolp keyword)) (ir-error "Invalid keyword name ~S" keyword))
                 (let* ((init (ir-convert (second spec) env))
                        (var (parameter variable-name))
                        (supplied (if (third spec) (parameter (third spec)) (ir-new-var (gensym "SUPPLIED")))))
                   (ir-push (vector var init supplied keyword) (if (eq state :key) keys optional)))))
              ((eq state :aux)
               (let* ((spec (if (symbolp item) (list input) (ir-parts input)))
                      (name (ir-variable-name (first spec))))
                 (ir-arity 'aux-parameter spec 1 2)
                 (when (member name names) (ir-error "Duplicate parameter ~S" name))
                 (push name names)
                 (push input aux)))
              (t (ir-error "Unexpected lambda list item ~S" item)))))
        (when (eq state :rest) (ir-error "Missing parameter after &REST"))
        (setf (ir-lambda-list-required ll) (ir-vector required)
              (ir-lambda-list-optional ll) (ir-vector optional)
              (ir-lambda-list-keys ll) (ir-vector keys)
              (ir-fun-lambda-list fun) ll
              (ir-fun-policy fun) (trucler:describe-optimize *client* (ir-declare env declarations)))
        (let ((result (if aux
                          (ir-convert `(let* ,(mapcar #'ir-raw (nreverse aux))
                                         (declare ,@declarations)
                                         ,@(mapcar #'ir-raw body))
                                      env)
                          (ir-convert-body body (ir-declare env declarations)))))
          (setf (ir-fun-parameter-specials fun) specials)
          (setf (ir-fun-body fun)
                (if function-exit (ir-wrap-block function-exit result) result))))
      fun)))

(define-ir-converter function (parts environment)
  (ir-arity 'function parts 1)
  (let ((name (ir-raw (first parts))))
    (cond ((and (consp name) (eq (car name) 'lambda))
           (let ((fun (ir-convert-lambda (rest (ir-parts (first parts))) environment nil)))
             (incf (ir-fun-value-refs fun))
             (setf (ir-fun-flags fun) (logior 1 (logandc2 (ir-fun-flags fun) 8)))
             (ir-node 6 *ir-source* fun)))
          ((ir-function-name-p name)
           (let ((fun (ir-lookup environment name :fun)))
             (if (ir-fun-p fun)
                 (progn (incf (ir-fun-value-refs fun))
                        (setf (ir-fun-flags fun) (logior 1 (logandc2 (ir-fun-flags fun) 8)))
                        (ir-node 6 *ir-source* fun))
                 (progn
                   (when (or fun
                             (typep (trucler:describe-function *client* environment name)
                                    '(or trucler:macro-description trucler:special-operator-description)))
                     (ir-error "~S does not name an ordinary function" name))
                   (ir-node 5 *ir-source* name)))))
          (t (ir-error "Invalid FUNCTION argument ~S" name)))))

(defun ir-convert-local-functions (parts environment recursive)
  (ir-arity (if recursive 'labels 'flet) parts 1 nil)
  (let ((functions (make-ir-buffer)) (definitions '()) (entries '()))
    (dolist (definition (ir-parts (first parts)))
      (let* ((def (ir-parts definition)) (name (ir-raw (first def))))
        (ir-arity 'local-function def 2 nil)
        (unless (ir-function-name-p name) (ir-error "Invalid local function name ~S" name))
        (when (assoc name entries :test #'equal) (ir-error "Duplicate local function ~S" name))
        (let ((fun (make-ir-fun :name name :parent *ir-function* :source *ir-source*
                                :binding (ir-new-var (gensym "FUNCTION")))))
          (push (cons name fun) entries)
          (push (cons fun (rest def)) definitions)
          (ir-push fun functions))))
    (let ((env (ir-env environment :funcs entries)))
      (dolist (definition (nreverse definitions))
        (ir-convert-lambda (cdr definition) (if recursive env environment)
                           (ir-fun-name (car definition)) (car definition)))
      (ir-node 13 *ir-source* (ir-vector functions) (ir-convert-body (rest parts) env)))))

(define-ir-converter flet (parts environment) (ir-convert-local-functions parts environment nil))
(define-ir-converter labels (parts environment) (ir-convert-local-functions parts environment t))

(define-ir-converter block (parts environment)
  (ir-arity 'block parts 1 nil)
  (let* ((name (ir-raw (first parts))) (exit (ir-new-exit name)))
    (unless (symbolp name) (ir-error "Invalid BLOCK name ~S" name))
    (ir-wrap-block exit
                   (ir-progn (rest parts) (ir-env environment :blocks (list (cons name exit)))))))

(define-ir-converter return-from (parts environment)
  (ir-arity 'return-from parts 1 2)
  (let* ((name (ir-raw (first parts))) (exit (ir-lookup environment name :block)))
    (unless exit (ir-error "No lexically visible BLOCK named ~S" name))
    (setf (ir-exit-flags exit) (logior 2 (ir-exit-flags exit)))
    (unless (eq *ir-function* (ir-exit-owner exit))
      (setf (ir-exit-flags exit) (logior 1 (ir-exit-flags exit))))
    (ir-node 15 *ir-source* exit (ir-convert (second parts) environment))))

(define-ir-converter tagbody (parts environment)
  (let* ((group (ir-new-exit nil)) (segments (make-ir-buffer))
         (tags '()) (current group) (forms '()))
    (setf (ir-exit-token group) (ir-new-var (gensym "EXIT")))
    (dolist (part parts)
      (let ((raw (ir-raw part)))
        (if (or (symbolp raw) (integerp raw))
            (progn
              (ir-push (cons current (nreverse forms)) segments)
              (setf forms nil current (ir-new-exit raw group (ir-buffer-count segments)))
              (when (assoc raw tags :test #'eql) (ir-error "Duplicate TAGBODY tag ~S" raw))
              (push (cons raw current) tags))
            (push part forms))))
    (ir-push (cons current (nreverse forms)) segments)
    (let ((env (ir-env environment :tags tags)))
      (ir-node 16 *ir-source*
               (map 'simple-vector (lambda (segment) (cons (car segment) (ir-progn (cdr segment) env)))
                    (ir-vector segments)) group))))

(define-ir-converter go (parts environment)
  (ir-arity 'go parts 1)
  (let* ((name (ir-raw (first parts))) (exit (ir-lookup environment name :tag)))
    (unless exit (ir-error "No lexically visible TAGBODY tag ~S" name))
    (unless (eq *ir-function* (ir-exit-owner exit))
      (setf (ir-exit-flags (ir-exit-group exit)) 1))
    (ir-node 17 *ir-source* exit)))

(define-ir-converter catch (parts environment)
  (ir-arity 'catch parts 1 nil)
  (ir-node 18 *ir-source* (ir-convert (first parts) environment) (ir-progn (rest parts) environment)))
(define-ir-converter throw (parts environment)
  (ir-arity 'throw parts 2)
  (ir-node 19 *ir-source* (ir-convert (first parts) environment) (ir-convert (second parts) environment)))
(define-ir-converter unwind-protect (parts environment)
  (ir-arity 'unwind-protect parts 1 nil)
  (ir-node 20 *ir-source* (ir-convert (first parts) environment) (ir-progn (rest parts) environment)))
(defun ir-mv-bind-parts (parts)
  "For (MULTIPLE-VALUE-CALL (LAMBDA (&OPTIONAL V... &REST R) (DECLARE (IGNORE R)) BODY...) FORM),
as MULTIPLE-VALUE-BIND expands into: the variable inputs, FORM, and BODY."
  (when (= (length parts) 2)
    (let* ((fn (first parts)) (raw (ir-raw fn)))
      (when (and (consp raw) (eq (car raw) 'function) (consp (cdr raw)) (null (cddr raw)))
        (setf fn (second (ir-parts fn)) raw (ir-raw fn)))
      (when (and (consp raw) (eq (car raw) 'lambda) (consp (cdr raw)) (consp (cddr raw)))
        (let* ((fn-parts (ir-parts fn))
               (ll (and (listp (ir-raw (second fn-parts))) (ir-parts (second fn-parts))))
               (len (length ll)))
          (when (and (>= len 3)
                     (eq (ir-raw (first ll)) '&optional)
                     (eq (ir-raw (nth (- len 2) ll)) '&rest))
            (let ((rest-var (ir-raw (nth (1- len) ll)))
                  (vars (subseq ll 1 (- len 2))))
              (when (and (symbolp rest-var)
                         (equal (ir-raw (third fn-parts)) `(declare (ignore ,rest-var)))
                         (every (lambda (v)
                                  (let ((s (ir-raw v)))
                                    (and (symbolp s) (not (member s lambda-list-keywords)))))
                                vars))
                (values vars (second parts) (cdddr fn-parts) t)))))))))

(defun ir-convert-mv-bind (var-inputs values-form body-parts environment)
  (let ((names (mapcar #'ir-variable-name var-inputs)))
    (unless (= (length names) (length (remove-duplicates names)))
      (ir-error "Duplicate MULTIPLE-VALUE-BIND variable"))
    (multiple-value-bind (body declarations) (ir-split-body body-parts)
      (let ((init (ir-convert values-form environment))
            (env environment) (variables (make-ir-buffer)) (specials '()))
        (dolist (name names)
          (let* ((special (ir-special-binding-p name declarations environment))
                 (variable (ir-new-var (if special (gensym "SPECIAL") name))))
            (ir-push variable variables)
            (if special
                (progn
                  (push (cons name variable) specials)
                  (setf env (ir-env env :vars (list (cons name '(:special))))))
                (setf env (ir-env env :vars (list (cons name variable)))))))
        (let* ((env (ir-declare env declarations))
               (*local-notinline* (append (loop for spec in declarations
                                                when (eq (car spec) 'notinline) append (cdr spec))
                                           *local-notinline*))
               (result (progn
                         (loop for var across (ir-vector variables)
                               do (setf (ir-var-type var) (ir-declared-variable-type env var)))
                         (ir-progn body env)))
               (vars (ir-vector variables)))
          (if (zerop (length vars))
              (ir-node 10 *ir-source* (vector init result))
              (progn
                (dolist (special specials)
                  (setf result (ir-node 12 *ir-source* (car special)
                                        (ir-node 1 *ir-source* (ir-note-ref (cdr special))) result)))
                (ir-node 11 *ir-source* vars (vector init) result t))))))))

(define-ir-converter multiple-value-call (parts environment)
  (ir-arity 'multiple-value-call parts 1 nil)
  (multiple-value-bind (vars values-form body matched) (ir-mv-bind-parts parts)
    (if matched
        (ir-convert-mv-bind vars values-form body environment)
        (ir-node 21 *ir-source* (ir-convert (first parts) environment) (ir-convert-vector (rest parts) environment)))))
(define-ir-converter multiple-value-prog1 (parts environment)
  (ir-arity 'multiple-value-prog1 parts 1 nil)
  (ir-node 22 *ir-source* (ir-convert (first parts) environment) (ir-progn (rest parts) environment)))
(define-ir-converter the (parts environment)
  (ir-arity 'the parts 2)
  (ir-node 23 *ir-source* (ir-raw (first parts)) (ir-convert (second parts) environment)))
(define-ir-converter progv (parts environment)
  (ir-arity 'progv parts 2 nil)
  (ir-node 25 *ir-source* (ir-convert (first parts) environment)
           (ir-convert (second parts) environment) (ir-progn (cddr parts) environment)))
(define-ir-converter eval-when (parts environment)
  (ir-arity 'eval-when parts 1 nil)
  (let ((situations (mapcar #'ir-raw (ir-parts (first parts)))))
    (unless (every (lambda (s) (member s '(:compile-toplevel :load-toplevel :execute compile load eval))) situations)
      (ir-error "Invalid EVAL-WHEN situations ~S" situations))
    (if (intersection situations '(:execute eval)) (ir-progn (rest parts) environment)
        (ir-node 0 *ir-source* nil))))
(define-ir-converter load-time-value (parts environment)
  (ir-arity 'load-time-value parts 1 2)
  (let* ((fun (make-ir-fun :name '(load-time-value) :source *ir-source*
                          :lambda-list (make-ir-lambda-list)))
         (*ir-function* fun))
    (unless (member (ir-raw (second parts)) '(nil t)) (ir-error "Invalid LOAD-TIME-VALUE read-only flag"))
    (setf (ir-fun-body fun)
          (ir-convert (first parts)
                      (ir-env (make-instance 'trucler-reference:environment
                                :global-environment (trucler:global-environment *client* environment)))))
    (ir-node 24 *ir-source* fun (ir-raw (second parts)))))

(define-ir-converter symbol-macrolet (parts environment)
  (ir-arity 'symbol-macrolet parts 1 nil)
  (let ((entries '()))
    (dolist (input (ir-parts (first parts)))
      (let ((pair (ir-parts input)))
        (ir-arity 'symbol-macrolet-binding pair 2)
        (let ((name (ir-variable-name (first pair))))
          (when (assoc name entries) (ir-error "Duplicate symbol macro ~S" name))
          (check-symbol-macro-name name environment)
          (push (cons name (list :symbol-macro (ir-raw (second pair)))) entries))))
    (multiple-value-bind (body declarations) (ir-split-body (rest parts))
      (when (intersection (mapcar #'car entries) (ir-special-names declarations))
        (ir-error "Cannot declare a symbol macro SPECIAL"))
      (ir-convert-body body (ir-declare (ir-env environment :vars entries) declarations)))))

(defgeneric ir-local-macro-expander (client name lambda-list body environment)
  (:documentation "The expander of the local macro NAME defined by MACROLET
in the IR environment ENVIRONMENT. The cross client evaluates it with the
IR evaluator (eval.lisp), the image client with Maclina; either sees only
the local macros and symbol macros of ENVIRONMENT."))

(define-ir-converter macrolet (parts environment)
  (ir-arity 'macrolet parts 1 nil)
  (let ((entries '()))
    (dolist (input (ir-parts (first parts)))
      (let* ((def (mapcar #'ir-raw (ir-parts input))) (name (first def)))
        (ir-arity 'macrolet-definition def 2 nil)
        (unless (and (symbolp name) name) (ir-error "Invalid local macro name ~S" name))
        (when (assoc name entries) (ir-error "Duplicate local macro ~S" name))
        (let ((expander (let ((*ir-step-recording* nil))
                          (ir-local-macro-expander *client* name (second def) (cddr def)
                                                   environment))))
          (push (cons name (list :macro expander)) entries))))
    (ir-convert-body (rest parts) (ir-env environment :funcs entries))))

(defun cst-to-ir (cst environment)
  (let* ((root (make-ir-fun :name '(:top-level-form) :source nil
                           :lambda-list (make-ir-lambda-list)))
         (*ir-function* root) (*ir-conversion-depth* 0)
         (*ir-file-id* (ir-source-file-number *source-file*))
         (*ir-source* (let ((source (and (not (typep cst 'cst:cst)) *macro-source*)))
                        (and source (ir-source-position *ir-file-id* (car source) (cdr source)))))
         (*ir-top-cst* (or *ir-top-cst* (and (typep cst 'cst:cst) cst))))
    (setf (ir-fun-body root) (ir-convert cst (ir-env environment)))
    (analyze-ir root)))
