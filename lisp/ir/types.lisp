(in-package #:kiln.compiler)

;;; The domain is deliberately bounded: canonical value classes and finite
;;; machine-word integer intervals. T means unknown, not an assertion. Host FIXNUM
;;; bounds need not match the target's and must not determine inferred types.
(defconstant +ir-fixnum-min+ (- (ash 1 62)))
(defconstant +ir-fixnum-max+ (1- (ash 1 62)))
(defconstant +ir-bound-min+ (- (ash 1 63)))
(defconstant +ir-bound-max+ (1- (ash 1 63)))

(defun ir-integer-range (low high)
  (if (and (<= +ir-bound-min+ low) (<= high +ir-bound-max+))
      (list 'integer low high)
      'integer))

(defun ir-range-p (type)
  (and (consp type) (eq (car type) 'integer)))

(defun ir-fixnum-type-p (type)
  (or (eq type 'fixnum)
      (and (ir-range-p type) (<= +ir-fixnum-min+ (second type))
           (<= (third type) +ir-fixnum-max+))))

(defun ir-integer-type-p (type)
  (or (eq type 'integer) (eq type 'fixnum) (ir-range-p type)))

(defun ir-type-range (type)
  (cond ((ir-range-p type) type)
        ((eq type 'fixnum) (ir-integer-range +ir-fixnum-min+ +ir-fixnum-max+))))


(defun ir-type-join (a b)
  (cond ((equal a b) a)
        ((and (ir-range-p a) (ir-range-p b))
         (ir-integer-range (min (second a) (second b)) (max (third a) (third b))))
        ((and (ir-fixnum-type-p a) (ir-fixnum-type-p b)) 'fixnum)
        ((and (ir-integer-type-p a)
              (ir-integer-type-p b)) 'integer)
        ((and (member a '(null symbol)) (member b '(null symbol))) 'symbol)
        (t t)))

(defun ir-constant-type (value)
  (cond ((integerp value) (ir-integer-range value value))
        ((null value) 'null)
        ((symbolp value) 'symbol)
        ((consp value) 'cons)
        ((characterp value) 'character)
        ((stringp value) :native-string)
        ((typep value 'simple-vector) 'simple-vector)
        ((typep value 'single-float) 'single-float)
        ((typep value 'double-float) 'double-float)
        ((rationalp value) 'rational)
        ((complexp value) 'complex)
        (t t)))

(defun ir-predicate-type (name)
  (cdr (assoc name '((kiln.kernel::fixnump . fixnum) (integerp . integer) (rationalp . rational) (realp . real)
                    (numberp . number) (floatp . float) (consp . cons)
                    (symbolp . symbol) (characterp . character)
                    (simple-vector-p . simple-vector) (stringp . string)
                    (simple-string-p . simple-string) (vectorp . vector)
                    (arrayp . array) (functionp . function) (null . null)
                    (not . null) (listp . list)))))

(defun ir-type-predicate (name type)
  "Return a predicate's result and whether it is known for TYPE."
  (when (or (eq type t) (eq type 'boolean))
    (return-from ir-type-predicate (values nil nil)))
  (let* ((class (if (ir-integer-type-p type) 'integer type))
         (supers
           (case class
             (integer '(integer rational real number))
             (rational '(rational real number))
             ((single-float double-float float) '(float real number))
             (real '(real number)) (number '(number)) (complex '(number))
             (null '(null symbol list)) (symbol '(symbol)) (cons '(cons list))
             (character '(character)) (function '(function))
             (simple-vector '(simple-vector vector array))
             (:simple-array-vector '(vector array))
             (:native-string '(simple-string string vector array))
             (simple-string '(simple-string string vector array))
             (string '(string vector array)) (vector '(vector array))
             (array '(array)) (list '(list))))
         (wanted (ir-predicate-type name)))
    (cond ((null wanted) (values nil nil))
          ((or (member wanted supers)
               (and (eq wanted 'fixnum) (ir-fixnum-type-p type))) (values t t))
          ((and (eq wanted 'fixnum) (eq class 'integer)) (values nil nil))
          ;; Broad classes may overlap without containment (LIST and SYMBOL
          ;; both include NIL; ARRAY includes vectors and strings).
          ((or (member class '(number real rational float array vector :simple-array-vector string simple-string list symbol))
               (and (eq wanted 'null) (eq class 'list)))
           (values nil nil))
          (t (values nil t)))))

(defun ir-make-array-type (args)
  (let* ((count (length args)) (dimension (and (plusp count) (svref args 0)))
         (rank-one (and dimension
                        (or (ir-integer-type-p (ir-node-type dimension))
                            (and (= (ir-node-kind dimension) 0)
                                 (consp (ir-node-a dimension))
                                 (ir-proper-list-p (ir-node-a dimension))
                                 (= (length (ir-node-a dimension)) 1)))))
         (simple t) (general-elements t))
    (unless rank-one (return-from ir-make-array-type 'array))
    (unless (oddp count) (return-from ir-make-array-type 'vector))
    (loop for i from 1 below count by 2
          for key = (svref args i) for value = (svref args (1+ i))
          do (unless (= (ir-node-kind key) 0) (return-from ir-make-array-type 'vector))
             (case (ir-node-a key)
               ((:adjustable :fill-pointer :displaced-to)
                (unless (and (= (ir-node-kind value) 0) (null (ir-node-a value)))
                  (setf simple nil)))
               (:element-type
                (unless (and (= (ir-node-kind value) 0) (eq (ir-node-a value) t))
                  (setf general-elements nil)))
               ((:initial-element :initial-contents :displaced-index-offset :allow-other-keys))
               (otherwise (return-from ir-make-array-type 'vector))))
    (cond ((not simple) 'vector)
          (general-elements 'simple-vector)
          (t :simple-array-vector))))

(defun ir-call-type (name args)
  (let ((count (length args)))
    (cond
      ((ir-predicate-type name) 'boolean)
      ((member name '(< > <= >= = /= eq eql equal equalp zerop plusp minusp)) 'boolean)
      ((eq name 'cons) 'cons)
      ((eq name 'list) (if (zerop count) 'null 'cons))
      ((eq name 'vector) 'simple-vector)
      ((eq name 'make-array) (ir-make-array-type args))
      ((and (eq name 'length) (= count 1)
            (member (ir-node-type (svref args 0)) '(simple-vector :native-string)))
       (ir-integer-range 0 #xffffffff))
      ((and (= count 2)
            (or (member name '(char schar))
                (and (member name '(aref elt)) (eq (ir-node-type (svref args 0)) :native-string))))
       'character)
      ((and (= count 3) (member name '((setf aref) (setf svref) (setf char) (setf schar) (setf elt)) :test #'equal))
       (ir-node-type (svref args 0)))
      ((and (eq name 'char-code) (= count 1)) (ir-integer-range 0 #x10ffff))
      ((eq name 'values) (if (plusp count) (ir-node-type (svref args 0)) 'null))
      ((and (member name '(+ - *)) (= count 2))
       (let* ((at (ir-node-type (svref args 0))) (bt (ir-node-type (svref args 1)))
              (a (or (ir-type-range at) at)) (b (or (ir-type-range bt) bt)))
         (when (and (eq at 'double-float) (eq bt 'double-float))
           (return-from ir-call-type 'double-float))
         (when (and (ir-range-p a) (ir-range-p b))
           (return-from ir-call-type
             (case name
               (+ (ir-integer-range (+ (second a) (second b)) (+ (third a) (third b))))
               (- (ir-integer-range (- (second a) (third b)) (- (third a) (second b))))
               (* (let ((products (list (* (second a) (second b)) (* (second a) (third b))
                                        (* (third a) (second b)) (* (third a) (third b)))))
                    (ir-integer-range (apply #'min products) (apply #'max products)))))))
         (if (and (ir-integer-type-p a)
                  (ir-integer-type-p b))
             'integer t)))
      ((and (member name '(1+ 1-)) (= count 1))
       (let* ((actual (ir-node-type (svref args 0))) (type (or (ir-type-range actual) actual))
              (delta (if (eq name '1+) 1 -1)))
         (cond ((ir-range-p type)
                (ir-integer-range (+ (second type) delta) (+ (third type) delta)))
               ((ir-integer-type-p type) 'integer)
               (t t))))
      ((and (member name '(logand logior logxor)) (= count 2))
       (let ((a (ir-node-type (svref args 0))) (b (ir-node-type (svref args 1))))
         (when (eq name 'logand)
           (let ((limit nil))
             (dolist (type (list a b))
               (when (and (ir-range-p type) (<= 0 (second type)))
                 (setf limit (if limit (min limit (third type)) (third type)))))
             (when limit (return-from ir-call-type (ir-integer-range 0 limit)))))
         (cond ((and (ir-range-p a) (ir-range-p b) (<= 0 (second a)) (<= 0 (second b)))
                (ir-integer-range 0 (1- (ash 1 (max (integer-length (third a))
                                                  (integer-length (third b)))))))
               ((and (ir-fixnum-type-p a) (ir-fixnum-type-p b)) 'fixnum)
               ((and (ir-integer-type-p a)
                     (ir-integer-type-p b)) 'integer)
               (t t))))
      (t t))))

(defun ir-test-type (test)
  (when (= (ir-node-kind test) 7)
    (let ((args (ir-node-b test)) (name (ir-node-a test)))
      (cond ((= (length args) 1)
             (values (svref args 0) (ir-predicate-type name)))
            ((and (eq name 'typep) (= (length args) 2)
                  (= (ir-node-kind (svref args 1)) 0)
                  (member (ir-node-a (svref args 1))
                          '(fixnum integer rational real number float cons symbol character
                            simple-vector string simple-string vector array function null list)))
             (values (svref args 0) (ir-node-a (svref args 1))))))))

(defun ir-type-intersection (a b)
  (cond ((eq b t) a)
        ((ir-known-subtype-p a b) a)
        ((and (ir-range-p a) (eq b 'fixnum))
         (ir-type-intersection a (ir-integer-range +ir-fixnum-min+ +ir-fixnum-max+)))
        ((and (eq a 'fixnum) (ir-range-p b))
         (ir-type-intersection (ir-integer-range +ir-fixnum-min+ +ir-fixnum-max+) b))
        ((and (ir-range-p a) (ir-range-p b))
         (let ((low (max (second a) (second b))) (high (min (third a) (third b))))
           ;; An empty intersection has no normal return after the check.
           ;; Keep a safe overapproximation until the domain has bottom.
           (if (<= low high) (ir-integer-range low high) b)))
        (t b)))

(defun ir-declaration-type (specifier)
  "Project supported declarations into the value domain; T is unsupported."
  (cond ((member specifier '(fixnum integer rational real number float single-float double-float
                            cons symbol character simple-vector simple-string string vector array
                            function null list)) specifier)
        ((member specifier '(short-float long-float))
         (if (eq specifier 'short-float) 'single-float 'double-float))
        ((nth-value 2 (type-fixnum-bounds specifier))
         (multiple-value-bind (low high) (type-fixnum-bounds specifier)
           (ir-integer-range low high)))
        ((and (consp specifier) (ir-proper-list-p specifier))
         (case (car specifier)
           ((array simple-array)
            (if (> (length specifier) 3) t
              (let ((element (if (cdr specifier) (second specifier) '*))
                    (dimensions (if (cddr specifier) (third specifier) '*)))
                (cond ((or (eql dimensions 1)
                           (and (consp dimensions) (ir-proper-list-p dimensions)
                                (= (length dimensions) 1)))
                       (if (and (eq (car specifier) 'simple-array) (eq element t))
                           'simple-vector (if (eq (car specifier) 'simple-array) :simple-array-vector 'vector)))
                      (t 'array)))))
           (and
            (let ((type t))
              (dolist (part (cdr specifier) type)
                (let ((next (ir-declaration-type part)))
                  (when (eq next t) (return-from ir-declaration-type t))
                  (setf type (ir-type-intersection type next))))))
           (or
            (let ((parts (cdr specifier)))
              (if (null parts) t
                  (reduce #'ir-type-join (mapcar #'ir-declaration-type parts)))))
           (otherwise t)))
        (t t)))

(defun ir-known-subtype-p (actual required)
  "A proof in the finite domain, independent of user-defined type aliases."
  (cond ((eq actual t) nil)
        ((equal actual required) t)
        ((eq required :simple-array-vector)
         (member actual '(simple-vector :native-string simple-string)))
        ((ir-range-p required)
         (cond ((ir-range-p actual)
                (and (<= (second required) (second actual))
                     (<= (third actual) (third required))))
               ((eq actual 'fixnum)
                (and (<= (second required) +ir-fixnum-min+)
                     (<= +ir-fixnum-max+ (third required))))))
        (t
         (let ((predicate (case required
                            (fixnum 'kiln.kernel::fixnump) (integer 'integerp)
                            (rational 'rationalp) (real 'realp) (number 'numberp)
                            (float 'floatp) (cons 'consp) (symbol 'symbolp)
                            (character 'characterp) (simple-vector 'simple-vector-p)
                            (simple-string 'simple-string-p) (string 'stringp)
                            (vector 'vectorp) (array 'arrayp) (function 'functionp)
                            (null 'null) (list 'listp))))
           (and predicate
                (multiple-value-bind (truth known) (ir-type-predicate predicate actual)
                  (and truth known)))))))

(defun ir-declaration-proven-p (actual specifier)
  (cond ((and (consp specifier) (member (car specifier) '(array simple-array)))
         ;; A projected class does not prove element or extent constraints.
         (and (equal specifier '(simple-array t (*)))
              (ir-known-subtype-p actual 'simple-vector)))
        ((and (consp specifier) (eq (car specifier) 'and))
         (every (lambda (part) (ir-declaration-proven-p actual part)) (cdr specifier)))
        ((and (consp specifier) (eq (car specifier) 'or))
         (some (lambda (part) (ir-declaration-proven-p actual part)) (cdr specifier)))
        (t (let ((required (ir-declaration-type specifier)))
             (and (not (eq required t)) (ir-known-subtype-p actual required))))))

(defun ir-trackable-type-var-p (var)
  ;; A captured writer can run from an arbitrary call or a nonlocal exit.
  (/= (logand (ir-var-flags var) 3) 3))

(defun ir-bind-type (var type environment)
  (if (or (not (ir-trackable-type-var-p var))
          (equal type (or (cdr (assoc var environment :test #'eq)) t)))
      environment
      (acons var type environment)))

(defun ir-immutable-types (environment)
  (remove-if (lambda (entry) (logtest 1 (ir-var-flags (car entry)))) environment))

(defun ir-join-type-environments (left right)
  (if (eq left right)
      left
      (let ((seen (make-hash-table :test #'eq)) (result nil))
        (dolist (entry left result)
          (let ((var (car entry)))
            (unless (gethash var seen)
              (setf (gethash var seen) t)
              (let ((type (ir-type-join (cdr entry)
                                      (or (cdr (assoc var right :test #'eq)) t))))
                (unless (eq type t) (push (cons var type) result)))))))))


(defun ir-refine-comparison (test environment positive)
  (let* ((name (ir-node-a test)) (args (ir-node-b test)))
    (unless (and (member name '(< <= > >= = /=)) (= (length args) 2)
                 ;; Evaluating the later operand must not overwrite the first.
                 (every (lambda (arg) (member (ir-node-kind arg) '(0 1))) args))
      (return-from ir-refine-comparison environment))
    (unless positive
      (setf name (case name (< '>=) (<= '>) (> '<=) (>= '<) (= '/=) (/= '=))))
    (when (eq name '/=) (return-from ir-refine-comparison environment))
    (let* ((a (svref args 0)) (b (svref args 1))
           (left (ir-type-range (ir-node-type a)))
           (right (ir-type-range (ir-node-type b))))
      (unless (and left right) (return-from ir-refine-comparison environment))
      (when (member name '(> >=))
        (rotatef a b) (rotatef left right)
        (setf name (if (eq name '>) '< '<=)))
      (let ((al (second left)) (ah (third left)) (bl (second right)) (bh (third right)))
        (if (eq name '=)
            (setf al (max al bl) ah (min ah bh) bl al bh ah)
            (let ((strict (if (eq name '<) 1 0)))
              (setf ah (min ah (- bh strict)) bl (max bl (+ al strict)))))
        ;; Impossible branches remain conservative until the domain has bottom.
        (when (or (> al ah) (> bl bh)) (return-from ir-refine-comparison environment))
        (when (= (ir-node-kind a) 1)
          (setf environment (ir-bind-type (ir-node-a a) (ir-integer-range al ah) environment)))
        (when (= (ir-node-kind b) 1)
          (setf environment (ir-bind-type (ir-node-a b) (ir-integer-range bl bh) environment)))
        environment))))

(defun ir-refine-types (test environment &optional (positive t))
  (when (and (= (ir-node-kind test) 7)
             (member (ir-node-a test) '(not null))
             (= (length (ir-node-b test)) 1)
             (= (ir-node-kind (svref (ir-node-b test) 0)) 7))
    (return-from ir-refine-types
      (ir-refine-types (svref (ir-node-b test) 0) environment (not positive))))
  (when (= (ir-node-kind test) 7)
    (setf environment (ir-refine-comparison test environment positive)))
  (unless positive (return-from ir-refine-types environment))
  (multiple-value-bind (arg type) (ir-test-type test)
    (if (and type (= (ir-node-kind arg) 1))
        (let* ((var (ir-node-a arg)) (old (cdr (assoc var environment :test #'eq))))
          (ir-bind-type var
                        (if (and (ir-fixnum-type-p old)
                                 (member type '(fixnum integer rational real number)))
                            old type)
                        environment))
        environment)))

(defun ir-type-environments-equal-p (left right)
  (flet ((same (entry)
           (let ((var (car entry)))
             (equal (or (cdr (assoc var left :test #'eq)) t)
                    (or (cdr (assoc var right :test #'eq)) t)))))
    (and (every #'same left) (every #'same right))))

(defun ir-widen-type-environment (previous joined)
  (mapcar (lambda (entry)
            (let ((old (cdr (assoc (car entry) previous :test #'eq))) (new (cdr entry)))
              (if (and (ir-range-p old) (ir-range-p new))
                  (cons (car entry)
                        (let ((lower (< (second new) (second old)))
                              (upper (> (third new) (third old))))
                          (if (or (and lower (< (second new) +ir-fixnum-min+))
                                  (and upper (> (third new) +ir-fixnum-max+)))
                              'integer
                              (ir-integer-range
                               (if lower +ir-fixnum-min+ (second new))
                               (if upper +ir-fixnum-max+ (third new))))))
                  entry))) joined))

(defun ir-tagbody-types (node environment visit)
  "Solve local GO and fallthrough edges. Return a success flag as value four."
  (let* ((segments (ir-node-a node)) (group (ir-node-b node)) (count (length segments))
         (states (make-array count :initial-element :unreachable))
         (queued (make-array count :initial-element nil)) (pending nil)
         (exit-state :unreachable) (written nil) (steps 0) (size 0))
    (when (or (logtest 1 (ir-exit-flags group)) (> count 128))
      (return-from ir-tagbody-types (values nil nil nil nil)))
    (labels
        ((children (function form)
           ;; Function definitions are analyzed with their own entry state.
           (case (ir-node-kind form)
             ((6 7) (when (ir-node-p (ir-node-a form)) (funcall function (ir-node-a form)))
                    (when (= (ir-node-kind form) 7)
                      (loop for arg across (ir-node-b form) do (funcall function arg))))
             (13 (funcall function (ir-node-b form)))
             (24 nil)
             (otherwise (ir-map-children function form))))
         (plain (form)
           (when (> (incf size) 16384)
             (return-from ir-tagbody-types (values nil nil nil nil)))
           (and (/= (ir-node-kind form) 17)
                (let ((ok t))
                  (children (lambda (child) (unless (plain child) (setf ok nil))) form)
                  ok)))
         (supported (form)
           (case (ir-node-kind form)
             (17 (eq (ir-exit-group (ir-node-a form)) group))
             (9 (and (plain (ir-node-a form)) (supported (ir-node-b form))
                     (supported (ir-node-c form))))
             (10 (every #'supported (ir-node-a form)))
             (11 (and (every #'plain (ir-node-b form)) (supported (ir-node-c form))))
             (12 (and (plain (ir-node-b form)) (supported (ir-node-c form))))
             (otherwise (plain form))))
         (join (left right)
           (cond ((eq left :unreachable) right) ((eq right :unreachable) left)
                 (t (ir-join-type-environments left right))))
         (offer (index state)
           (unless (eq state :unreachable)
             (if (= index count)
                 (setf exit-state state)
                 (let* ((old (svref states index))
                        (new (if (eq old :unreachable) state
                                 (ir-widen-type-environment old (join old state)))))
                   (unless (and (not (eq old :unreachable))
                                (ir-type-environments-equal-p old new))
                     (setf (svref states index) new)
                     (unless (svref queued index)
                       (push index pending) (setf (svref queued index) t)))))))
         (walk (form state)
           (when (eq state :unreachable) (return-from walk (values t state nil)))
           (let ((type t) (write nil))
             (case (ir-node-kind form)
               (17 (offer (ir-exit-index (ir-node-a form)) state)
                   (setf state :unreachable))
               (9
                (multiple-value-setq (type state write) (funcall visit (ir-node-a form) state))
                (multiple-value-bind (yes yes-state yes-write)
                    (walk (ir-node-b form) (ir-refine-types (ir-node-a form) state))
                  (multiple-value-bind (no no-state no-write)
                      (walk (ir-node-c form) (ir-refine-types (ir-node-a form) state nil))
                    (setf type (cond ((eq yes-state :unreachable) no)
                                     ((eq no-state :unreachable) yes)
                                     (t (ir-type-join yes no)))
                          state (join yes-state no-state)
                          write (or write yes-write no-write)))))
               (10 (loop for child across (ir-node-a form)
                         do (multiple-value-bind (next next-state next-write) (walk child state)
                              (setf type next state next-state write (or write next-write)))))
               (11
                (loop for init across (ir-node-b form)
                      do (multiple-value-bind (ignored next-state next-write) (funcall visit init state)
                           (declare (ignore ignored))
                           (setf state next-state write (or write next-write))))
                (let ((vars (ir-node-a form)))
                  (unless (ir-node-d form)
                    (loop for var across vars for init across (ir-node-b form)
                          do (setf state (ir-bind-type var (ir-node-type init) state))))
                  (multiple-value-bind (next next-state next-write) (walk (ir-node-c form) state)
                    (setf type next write (or write next-write)
                          state (if (eq next-state :unreachable) next-state
                                    (remove-if (lambda (entry) (find (car entry) vars :test #'eq))
                                               next-state))))))
               (12
                (multiple-value-setq (type state write) (funcall visit (ir-node-b form) state))
                (multiple-value-bind (next next-state next-write) (walk (ir-node-c form) state)
                  (setf type next state next-state write (or write next-write))))
               (otherwise
                (multiple-value-setq (type state write) (funcall visit form state))
                (when (member (ir-node-kind form) '(15 19)) (setf state :unreachable))))
             (setf (ir-node-type form) type)
             (values type state write))))
      (unless (every (lambda (segment) (supported (cdr segment))) segments)
        (return-from ir-tagbody-types (values nil nil nil nil)))
      (offer 0 environment)
      (loop while pending
            for index = (pop pending)
            do (when (> (incf steps) (+ 512 (* 8 count)))
                 ;; The caller revisits every segment conservatively, replacing
                 ;; annotations from this unfinished fixed-point computation.
                 (return-from ir-tagbody-types (values nil nil nil nil)))
               (setf (svref queued index) nil)
               (multiple-value-bind (ignored state write)
                   (walk (cdr (svref segments index)) (svref states index))
                 (declare (ignore ignored))
                 (setf written (or written write))
                 (offer (1+ index) state)))
      (values 'null (if (eq exit-state :unreachable) (ir-immutable-types environment) exit-state)
              written t))))

(defun ir-summary-narrow (old new)
  ;; Each candidate is independently conservative. Keep a descending chain
  ;; even when loop widening makes a later candidate less precise.
  (cond ((equal old new) old) ((eq old t) new) ((eq new t) old)
        ((ir-known-subtype-p new old) new)
        ((ir-known-subtype-p old new) old)
