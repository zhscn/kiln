(in-package #:kiln.compiler)

;;; The domain is deliberately bounded: canonical value classes and finite
;;; target-fixnum intervals. T means unknown, not an assertion. Host FIXNUM
;;; bounds need not match the target's and must not determine inferred types.
(defconstant +ir-fixnum-min+ (- (ash 1 62)))
(defconstant +ir-fixnum-max+ (1- (ash 1 62)))

(defun ir-integer-range (low high)
  (if (and (<= +ir-fixnum-min+ low) (<= high +ir-fixnum-max+))
      (list 'integer low high)
      'integer))

(defun ir-range-p (type)
  (and (consp type) (eq (car type) 'integer)))

(defun ir-fixnum-type-p (type)
  (or (eq type 'fixnum) (ir-range-p type)))

(defun ir-type-join (a b)
  (cond ((equal a b) a)
        ((and (ir-range-p a) (ir-range-p b))
         (ir-integer-range (min (second a) (second b)) (max (third a) (third b))))
        ((and (ir-fixnum-type-p a) (ir-fixnum-type-p b)) 'fixnum)
        ((and (or (ir-fixnum-type-p a) (eq a 'integer))
              (or (ir-fixnum-type-p b) (eq b 'integer))) 'integer)
        ((and (member a '(null symbol)) (member b '(null symbol))) 'symbol)
        (t t)))

(defun ir-constant-type (value)
  (cond ((integerp value) (ir-integer-range value value))
        ((null value) 'null)
        ((symbolp value) 'symbol)
        ((consp value) 'cons)
        ((characterp value) 'character)
        ((stringp value) :native-string)
        ((typep value 'simple-vector) 'simple-vector)
        ((typep value 'single-float) 'single-float)
        ((typep value 'double-float) 'double-float)
        ((rationalp value) 'rational)
        ((complexp value) 'complex)
        (t t)))

(defun ir-predicate-type (name)
  (cdr (assoc name '((kiln.kernel::fixnump . fixnum) (integerp . integer) (rationalp . rational) (realp . real)
                    (numberp . number) (floatp . float) (consp . cons)
                    (symbolp . symbol) (characterp . character)
                    (simple-vector-p . simple-vector) (stringp . string)
                    (simple-string-p . simple-string) (vectorp . vector)
                    (arrayp . array) (functionp . function) (null . null)
                    (not . null) (listp . list)))))

(defun ir-type-predicate (name type)
  "Return a predicate's result and whether it is known for TYPE."
  (when (or (eq type t) (eq type 'boolean))
    (return-from ir-type-predicate (values nil nil)))
  (let* ((class (if (ir-fixnum-type-p type) 'integer type))
         (supers
           (case class
             (integer '(integer rational real number))
             (rational '(rational real number))
             ((single-float double-float float) '(float real number))
             (real '(real number)) (number '(number)) (complex '(number))
             (null '(null symbol list)) (symbol '(symbol)) (cons '(cons list))
             (character '(character)) (function '(function))
             (simple-vector '(simple-vector vector array))
             (:native-string '(simple-string string vector array))
             (simple-string '(simple-string string vector array))
             (string '(string vector array)) (vector '(vector array))
             (array '(array)) (list '(list))))
         (wanted (ir-predicate-type name)))
    (cond ((null wanted) (values nil nil))
          ((or (member wanted supers)
               (and (eq wanted 'fixnum) (ir-fixnum-type-p type))) (values t t))
          ((and (eq wanted 'fixnum) (eq class 'integer)) (values nil nil))
          ;; Broad classes may overlap without containment (LIST and SYMBOL
          ;; both include NIL; ARRAY includes vectors and strings).
          ((or (member class '(number real rational float array vector string simple-string list symbol))
               (and (eq wanted 'null) (eq class 'list)))
           (values nil nil))
          (t (values nil t)))))

(defun ir-call-type (name args)
  (let ((count (length args)))
    (cond
      ((ir-predicate-type name) 'boolean)
      ((member name '(< > <= >= = /= eq eql equal equalp zerop plusp minusp)) 'boolean)
      ((eq name 'cons) 'cons)
      ((eq name 'list) (if (zerop count) 'null 'cons))
      ((eq name 'vector) 'simple-vector)
      ((and (eq name 'char-code) (= count 1)) (ir-integer-range 0 #x10ffff))
      ((and (eq name 'values) (plusp count)) (ir-node-type (svref args 0)))
      ((and (member name '(+ - *)) (= count 2))
       (let ((a (ir-node-type (svref args 0))) (b (ir-node-type (svref args 1))))
         (when (and (ir-range-p a) (ir-range-p b))
           (return-from ir-call-type
             (case name
               (+ (ir-integer-range (+ (second a) (second b)) (+ (third a) (third b))))
               (- (ir-integer-range (- (second a) (third b)) (- (third a) (second b))))
               (* (let ((products (list (* (second a) (second b)) (* (second a) (third b))
                                        (* (third a) (second b)) (* (third a) (third b)))))
                    (ir-integer-range (apply #'min products) (apply #'max products)))))))
         (if (and (or (ir-fixnum-type-p a) (eq a 'integer))
                  (or (ir-fixnum-type-p b) (eq b 'integer)))
             'integer t)))
      ((and (member name '(1+ 1-)) (= count 1))
       (let ((type (ir-node-type (svref args 0))) (delta (if (eq name '1+) 1 -1)))
         (cond ((ir-range-p type)
                (ir-integer-range (+ (second type) delta) (+ (third type) delta)))
               ((or (ir-fixnum-type-p type) (eq type 'integer)) 'integer)
               (t t))))
      ((and (member name '(logand logior logxor)) (= count 2))
       (let ((a (ir-node-type (svref args 0))) (b (ir-node-type (svref args 1))))
         (when (eq name 'logand)
           (let ((limit nil))
             (dolist (type (list a b))
               (when (and (ir-range-p type) (<= 0 (second type)))
                 (setf limit (if limit (min limit (third type)) (third type)))))
             (when limit (return-from ir-call-type (ir-integer-range 0 limit)))))
         (cond ((and (ir-range-p a) (ir-range-p b) (<= 0 (second a)) (<= 0 (second b)))
                (ir-integer-range 0 (1- (ash 1 (max (integer-length (third a))
                                                  (integer-length (third b)))))))
               ((and (ir-fixnum-type-p a) (ir-fixnum-type-p b)) 'fixnum)
               ((and (or (ir-fixnum-type-p a) (eq a 'integer))
                     (or (ir-fixnum-type-p b) (eq b 'integer))) 'integer)
               (t t))))
      (t t))))

(defun ir-test-type (test)
  (when (= (ir-node-kind test) 7)
    (let ((args (ir-node-b test)) (name (ir-node-a test)))
      (cond ((= (length args) 1)
             (values (svref args 0) (ir-predicate-type name)))
            ((and (eq name 'typep) (= (length args) 2)
                  (= (ir-node-kind (svref args 1)) 0)
                  (member (ir-node-a (svref args 1))
                          '(fixnum integer rational real number float cons symbol character
                            simple-vector string simple-string vector array function null list)))
             (values (svref args 0) (ir-node-a (svref args 1))))))))

(defun ir-trackable-type-var-p (var)
  ;; A captured writer can run from an arbitrary call or a nonlocal exit.
  (/= (logand (ir-var-flags var) 3) 3))

(defun ir-bind-type (var type environment)
  (if (or (not (ir-trackable-type-var-p var))
          (equal type (or (cdr (assoc var environment :test #'eq)) t)))
      environment
      (acons var type environment)))

(defun ir-immutable-types (environment)
  (remove-if (lambda (entry) (logtest 1 (ir-var-flags (car entry)))) environment))

(defun ir-join-type-environments (left right)
  (if (eq left right)
      left
      (let ((seen (make-hash-table :test #'eq)) (result nil))
        (dolist (entry left result)
          (let ((var (car entry)))
            (unless (gethash var seen)
              (setf (gethash var seen) t)
              (let ((type (ir-type-join (cdr entry)
                                      (or (cdr (assoc var right :test #'eq)) t))))
                (unless (eq type t) (push (cons var type) result)))))))))

(defun ir-refine-types (test environment &optional (positive t))
  (when (and (= (ir-node-kind test) 7)
             (member (ir-node-a test) '(not null))
             (= (length (ir-node-b test)) 1)
             (= (ir-node-kind (svref (ir-node-b test) 0)) 7))
    (return-from ir-refine-types
      (ir-refine-types (svref (ir-node-b test) 0) environment (not positive))))
  (unless positive (return-from ir-refine-types environment))
  (multiple-value-bind (arg type) (ir-test-type test)
    (if (and type (= (ir-node-kind arg) 1))
        (let* ((var (ir-node-a arg)) (old (cdr (assoc var environment :test #'eq))))
          (ir-bind-type var
                        (if (and (ir-fixnum-type-p old)
                                 (member type '(fixnum integer rational real number)))
                            old type)
                        environment))
        environment)))

(defun infer-ir-types (root)
  "Propagate types in evaluation order. Return a type, a persistent state,
and a flag for local writes. Captured writers never acquire binding facts."
  (labels
      ((function-types (fun environment)
         (let ((environment (ir-immutable-types environment)))
           (ir-map-function (lambda (node) (visit node environment)) fun)))
       (many (nodes environment)
         (let ((type 'null) (written nil))
           (loop for node across nodes
                 do (multiple-value-bind (next-type next-env next-write) (visit node environment)
                      (setf type next-type environment next-env written (or written next-write))))
           (values type environment written)))
       (children (node environment)
         (let ((written nil))
           (ir-map-children
            (lambda (child)
              (multiple-value-bind (type next-env next-write) (visit child environment)
                (declare (ignore type))
                (setf environment next-env written (or written next-write)))) node)
           (values t environment written)))
       (visit (node environment)
         (let ((type t) (written nil))
           (case (ir-node-kind node)
             (0 (setf type (ir-constant-type (ir-node-a node))))
             (1 (when (ir-trackable-type-var-p (ir-node-a node))
                  (setf type (or (cdr (assoc (ir-node-a node) environment :test #'eq)) t))))
             ((2 4)
              (multiple-value-setq (type environment written) (visit (ir-node-b node) environment))
              (when (and (= (ir-node-kind node) 2) (ir-trackable-type-var-p (ir-node-a node)))
                (setf environment (ir-bind-type (ir-node-a node) type environment) written t)))
             ((6 7)
              (let ((callee (ir-node-a node)))
                (cond ((ir-node-p callee)
                       (multiple-value-setq (type environment written) (visit callee environment)))
                      ((ir-own-function node) (function-types callee environment))))
              (if (= (ir-node-kind node) 6)
                  (setf type 'function)
                  (multiple-value-bind (ignored next-env next-write) (many (ir-node-b node) environment)
                    (declare (ignore ignored))
                    (setf environment next-env written (or written next-write)
                          type (ir-call-type (ir-node-a node) (ir-node-b node))))))
             (9
              (multiple-value-setq (type environment written) (visit (ir-node-a node) environment))
              (multiple-value-bind (yes yes-env yes-write)
                  (visit (ir-node-b node) (ir-refine-types (ir-node-a node) environment))
                (multiple-value-bind (no no-env no-write)
                    (visit (ir-node-c node) (ir-refine-types (ir-node-a node) environment nil))
                  (setf type (ir-type-join yes no))
                  ;; Predicate refinements are local to their branch. Without
                  ;; assignments the incoming state is already the exact join.
                  (when (or yes-write no-write)
                    (setf environment (ir-join-type-environments yes-env no-env) written t)))))
             (10 (multiple-value-setq (type environment written) (many (ir-node-a node) environment)))
             (11
              (multiple-value-setq (type environment written) (many (ir-node-b node) environment))
              (let ((base environment) (vars (ir-node-a node)) (inits (ir-node-b node)))
                (unless (ir-node-d node)
                  (loop for var across vars for init across inits
                        do (setf environment (ir-bind-type var (ir-node-type init) environment))))
                (multiple-value-bind (body-type body-env body-write) (visit (ir-node-c node) environment)
                  (setf type body-type written (or written body-write)
                        environment (if body-write
                                        (remove-if (lambda (entry) (find (car entry) vars :test #'eq)) body-env)
                                        base)))))
             (12
              (multiple-value-setq (type environment written) (visit (ir-node-b node) environment))
              (multiple-value-bind (body-type body-env body-write) (visit (ir-node-c node) environment)
                (setf type body-type environment body-env written (or written body-write))))
             (13 (loop for fun across (ir-node-a node) do (function-types fun environment))
                 (multiple-value-setq (type environment written) (visit (ir-node-b node) environment)))
             (16
              ;; Every label can have a backedge. No mutable entry fact is
              ;; valid at a segment until a loop fixed-point analysis proves it.
              (let ((base (ir-immutable-types environment)) (loop-write nil))
                (loop for segment across (ir-node-a node)
                      do (multiple-value-bind (ignored next-env next-write) (visit (cdr segment) base)
                           (declare (ignore ignored next-env))
                           (setf loop-write (or loop-write next-write))))
                (when loop-write (setf environment base written t))))
             (20
              ;; Cleanup can run after an early exit from any protected form.
              ;; Its entry state cannot use the protected form's final state.
              (let ((base (ir-immutable-types environment)))
                (visit (ir-node-a node) environment)
                (visit (ir-node-b node) base)
                (setf environment base written t)))
             (22
              (multiple-value-setq (type environment written) (visit (ir-node-a node) environment))
              (multiple-value-bind (ignored next-env next-write) (visit (ir-node-b node) environment)
                (declare (ignore ignored))
                (setf environment next-env written (or written next-write))))
             (23 (multiple-value-setq (type environment written) (visit (ir-node-b node) environment)))
             (24 (function-types (ir-node-a node) nil))
             ((14 15 17 18 19 25)
              (let ((base (if (= (ir-node-kind node) 17) (ir-immutable-types environment) environment)))
                (multiple-value-bind (ignored next-env next-write) (children node base)
                  (declare (ignore ignored next-env))
                  ;; RETURN/GO/THROW can bypass later assignments. The exit
                  ;; continuation only retains immutable facts.
                  (when (or next-write (member (ir-node-kind node) '(15 17 19)))
                    (setf environment (ir-immutable-types environment) written t)))))
             (otherwise (multiple-value-setq (type environment written) (children node environment))))
           (setf (ir-node-type node) type)
           (values type environment written))))
    (function-types root nil))
  root)
