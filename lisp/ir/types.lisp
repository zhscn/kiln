(in-package #:kiln.compiler)

;;; The domain is deliberately bounded: canonical value classes and finite
;;; target-fixnum intervals. T means unknown, not an assertion. Host FIXNUM
;;; bounds need not match the target's and must not determine inferred types.
(defconstant +ir-fixnum-min+ (- (ash 1 62)))
(defconstant +ir-fixnum-max+ (1- (ash 1 62)))

(defun ir-integer-range (low high)
  (if (and (<= +ir-fixnum-min+ low) (<= high +ir-fixnum-max+))
      (list 'integer low high)
      'integer))

(defun ir-range-p (type)
  (and (consp type) (eq (car type) 'integer)))

(defun ir-fixnum-type-p (type)
  (or (eq type 'fixnum) (ir-range-p type)))

(defun ir-type-join (a b)
  (cond ((equal a b) a)
        ((and (ir-range-p a) (ir-range-p b))
         (ir-integer-range (min (second a) (second b)) (max (third a) (third b))))
        ((and (ir-fixnum-type-p a) (ir-fixnum-type-p b)) 'fixnum)
        ((and (or (ir-fixnum-type-p a) (eq a 'integer))
              (or (ir-fixnum-type-p b) (eq b 'integer))) 'integer)
        ((and (member a '(null symbol)) (member b '(null symbol))) 'symbol)
        (t t)))

(defun ir-constant-type (value)
  (cond ((integerp value) (ir-integer-range value value))
        ((null value) 'null)
        ((symbolp value) 'symbol)
        ((consp value) 'cons)
        ((characterp value) 'character)
        ((stringp value) :native-string)
        ((typep value 'simple-vector) 'simple-vector)
        ((typep value 'single-float) 'single-float)
        ((typep value 'double-float) 'double-float)
        ((rationalp value) 'rational)
        ((complexp value) 'complex)
        (t t)))

(defun ir-predicate-type (name)
  (cdr (assoc name '((kiln.kernel::fixnump . fixnum) (integerp . integer) (rationalp . rational) (realp . real)
                    (numberp . number) (floatp . float) (consp . cons)
                    (symbolp . symbol) (characterp . character)
                    (simple-vector-p . simple-vector) (stringp . string)
                    (simple-string-p . simple-string) (vectorp . vector)
                    (arrayp . array) (functionp . function) (null . null)
                    (not . null) (listp . list)))))

(defun ir-type-predicate (name type)
  "Return a predicate's result and whether it is known for TYPE."
  (when (or (eq type t) (eq type 'boolean))
    (return-from ir-type-predicate (values nil nil)))
  (let* ((class (if (ir-fixnum-type-p type) 'integer type))
         (supers
           (case class
             (integer '(integer rational real number))
             (rational '(rational real number))
             ((single-float double-float float) '(float real number))
             (real '(real number)) (number '(number)) (complex '(number))
             (null '(null symbol list)) (symbol '(symbol)) (cons '(cons list))
             (character '(character)) (function '(function))
             (simple-vector '(simple-vector vector array))
             (:native-string '(simple-string string vector array))
             (simple-string '(simple-string string vector array))
             (string '(string vector array)) (vector '(vector array))
             (array '(array)) (list '(list))))
         (wanted (ir-predicate-type name)))
    (cond ((null wanted) (values nil nil))
          ((or (member wanted supers)
               (and (eq wanted 'fixnum) (ir-fixnum-type-p type))) (values t t))
          ((and (eq wanted 'fixnum) (eq class 'integer)) (values nil nil))
          ;; Broad classes may overlap without containment (LIST and SYMBOL
          ;; both include NIL; ARRAY includes vectors and strings).
          ((or (member class '(number real rational float array vector string simple-string list symbol))
               (and (eq wanted 'null) (eq class 'list)))
           (values nil nil))
          (t (values nil t)))))

(defun ir-call-type (name args)
  (let ((count (length args)))
    (cond
      ((ir-predicate-type name) 'boolean)
      ((member name '(< > <= >= = /= eq eql equal equalp zerop plusp minusp)) 'boolean)
      ((eq name 'cons) 'cons)
      ((eq name 'list) (if (zerop count) 'null 'cons))
      ((eq name 'vector) 'simple-vector)
      ((and (eq name 'char-code) (= count 1)) (ir-integer-range 0 #x10ffff))
      ((and (eq name 'values) (plusp count)) (ir-node-type (svref args 0)))
      ((and (member name '(+ - *)) (= count 2))
       (let ((a (ir-node-type (svref args 0))) (b (ir-node-type (svref args 1))))
         (when (and (ir-range-p a) (ir-range-p b))
           (return-from ir-call-type
             (case name
               (+ (ir-integer-range (+ (second a) (second b)) (+ (third a) (third b))))
               (- (ir-integer-range (- (second a) (third b)) (- (third a) (second b))))
               (* (let ((products (list (* (second a) (second b)) (* (second a) (third b))
                                        (* (third a) (second b)) (* (third a) (third b)))))
                    (ir-integer-range (apply #'min products) (apply #'max products)))))))
         (if (and (or (ir-fixnum-type-p a) (eq a 'integer))
                  (or (ir-fixnum-type-p b) (eq b 'integer)))
             'integer t)))
      ((and (eq name 'logand) (= count 2))
       (dotimes (i 2 t)
         (let ((arg (svref args i)))
           (when (and (= (ir-node-kind arg) 0) (integerp (ir-node-a arg))
                      (<= 0 (ir-node-a arg) +ir-fixnum-max+))
             (return (ir-integer-range 0 (ir-node-a arg)))))))
      (t t))))

(defun ir-test-type (test)
  (when (= (ir-node-kind test) 7)
    (let ((args (ir-node-b test)) (name (ir-node-a test)))
      (cond ((= (length args) 1)
             (values (svref args 0) (ir-predicate-type name)))
            ((and (eq name 'typep) (= (length args) 2)
                  (= (ir-node-kind (svref args 1)) 0)
                  (member (ir-node-a (svref args 1))
                          '(fixnum integer rational real number float cons symbol character
                            simple-vector string simple-string vector array function null list)))
             (values (svref args 0) (ir-node-a (svref args 1))))))))

(defun ir-refine-types (test environment &optional (positive t))
  (when (and (= (ir-node-kind test) 7)
             (member (ir-node-a test) '(not null))
             (= (length (ir-node-b test)) 1)
             (= (ir-node-kind (svref (ir-node-b test) 0)) 7))
    (return-from ir-refine-types
      (ir-refine-types (svref (ir-node-b test) 0) environment (not positive))))
  (unless positive (return-from ir-refine-types environment))
  (multiple-value-bind (arg type) (ir-test-type test)
    (if (and type (= (ir-node-kind arg) 1)
             (not (logtest 1 (ir-var-flags (ir-node-a arg)))))
        (acons (ir-node-a arg) type environment)
        environment)))

(defun infer-ir-types (root)
  "Annotate primary-value types. Only immutable bindings carry facts across
expressions or calls; assignments, cells and control transfers stay general."
  (labels
      ((function-types (fun environment)
         (ir-map-function (lambda (node) (visit node environment)) fun))
       (visit (node environment)
         (let ((type t))
           (case (ir-node-kind node)
             (0 (setf type (ir-constant-type (ir-node-a node))))
             (1 (unless (logtest 1 (ir-var-flags (ir-node-a node)))
                  (setf type (or (cdr (assoc (ir-node-a node) environment :test #'eq)) t))))
             ((2 4) (setf type (visit (ir-node-b node) environment)))
             ((6 7)
              (let ((callee (ir-node-a node)))
                (cond ((ir-node-p callee) (visit callee environment))
                      ((ir-own-function node) (function-types callee environment))))
              (if (= (ir-node-kind node) 6)
                  (setf type 'function)
                  (let ((args (ir-node-b node)))
                    (loop for arg across args do (visit arg environment))
                    (setf type (ir-call-type (ir-node-a node) args)))))
             (9 (visit (ir-node-a node) environment)
                (setf type (ir-type-join
                            (visit (ir-node-b node) (ir-refine-types (ir-node-a node) environment))
                            (visit (ir-node-c node) (ir-refine-types (ir-node-a node) environment nil)))))
             (10 (setf type 'null)
                 (loop for child across (ir-node-a node) do (setf type (visit child environment))))
             (11 (let ((inits (ir-node-b node)) (vars (ir-node-a node)) (body-env environment))
                   (loop for init across inits do (visit init environment))
                   (unless (ir-node-d node)
                     (loop for var across vars for init across inits
                           unless (or (logtest 1 (ir-var-flags var))
                                      (eq (ir-node-type init) t))
                             do (push (cons var (ir-node-type init)) body-env)))
                   (setf type (visit (ir-node-c node) body-env))))
             (13 (loop for fun across (ir-node-a node) do (function-types fun environment))
                 (setf type (visit (ir-node-b node) environment)))
             (22 (setf type (visit (ir-node-a node) environment))
                 (visit (ir-node-b node) environment))
             (23 (setf type (visit (ir-node-b node) environment)))
             (24 (function-types (ir-node-a node) nil))
             (otherwise (ir-map-children (lambda (child) (visit child environment)) node)))
           (setf (ir-node-type node) type))))
    (function-types root nil))
  root)
