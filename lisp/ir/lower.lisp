(in-package #:kiln.compiler)

(defvar *ir-lowering-function*)
(defvar *ir-closure-layout*)
(defvar *ir-lifted-operands* nil)

(defun ir-raw-double-variable-p (var)
  (let ((value (ir-var-lowering var)))
    (and (consp value) (eq (car value) :double-bits))))

(defun ir-box-double-bits (bits)
  (let* ((bits (copy-to-var bits :raw)) (object (emit-alloc 16 +kind-double+)))
    (emit `(:store ,object 8 ,bits))
    (copy-to-var `(:add ,object ,+tag-general+))))

(defun ir-static-function-binding-p (var)
  (let ((value (ir-var-lowering var)))
    (and (consp value) (eq (car value) :static-function)
         (eq (ir-fun-lowering-epoch (cadr value)) *ir-lowering-epoch*))))

(defun ir-lifted-environment (fun)
  (and *ir-lifted-environments* (gethash fun *ir-lifted-environments*)))

(defun ir-prepare-native-environments (root)
  "Solve native capture requirements for direct-only local function entries."
  (unless (logtest 64 (ir-fun-flags root))
    (return-from ir-prepare-native-environments nil))
  (let ((seen (make-hash-table :test #'eq)) (bindings (make-hash-table :test #'eq))
        (invalid (make-hash-table :test #'eq)) (lifted (make-hash-table :test #'eq))
        (users (make-hash-table :test #'eq)) (members (make-hash-table :test #'eq))
        (layouts (make-hash-table :test #'eq))
        (functions nil) (definitions nil) (calls nil) (pending nil) (budget 4096))
    (labels ((collect-function (fun)
               (unless (gethash fun seen)
                 (setf (gethash fun seen) t)
                 (push fun functions)
                 (when (ir-fun-binding fun) (setf (gethash (ir-fun-binding fun) bindings) fun))
                 (ir-map-function (lambda (node) (collect-node node fun)) fun)))
             (definition (fun owner)
               (push (cons fun owner) definitions)
               (collect-function fun))
             (collect-node (node owner)
               (case (ir-node-kind node)
                 ((6 7)
                  (let ((callee (ir-node-a node)))
                    (when (ir-own-function node) (definition callee owner))
                    (when (and (= (ir-node-kind node) 7) (ir-fun-p callee))
                      (let* ((count (length (ir-node-b node)))
                             (ll (ir-fun-lambda-list callee))
                             (required (length (ir-lambda-list-required ll)))
                             (positional (+ required (length (ir-lambda-list-optional ll)))))
                        (push (vector callee owner count) calls)
                        (unless (and (>= count required)
                                     (or (ir-lambda-list-rest ll) (ir-lambda-list-key-p ll)
                                         (<= count positional))
                                     (or (not (ir-lambda-list-key-p ll))
                                         (evenp (max 0 (- count positional)))))
                          (setf (gethash callee invalid) t))))
                    (when (ir-node-p callee) (collect-node callee owner)))
                  (when (= (ir-node-kind node) 7)
                    (loop for arg across (ir-node-b node) do (collect-node arg owner))))
                 (13 (loop for fun across (ir-node-a node) do (definition fun owner))
                     (collect-node (ir-node-b node) owner))
                 (24 (collect-function (ir-node-a node)))
                 (otherwise (ir-map-children (lambda (child) (collect-node child owner)) node))))
             (edge (source user)
               (pushnew user (gethash source users) :test #'eq))
             (capture (fun var)
               (let ((dependency (gethash var bindings)))
                 (unless (or (eq (ir-var-owner var) fun) (eq (ir-fun-binding fun) var)
                             (and dependency (or (gethash dependency lifted)
                                                 (logtest 128 (ir-fun-flags dependency)))))
                   (let ((set (or (gethash fun members)
                                  (setf (gethash fun members) (make-hash-table :test #'eq)))))
                     (unless (gethash var set)
                       (when (minusp (decf budget))
                         (return-from ir-prepare-native-environments nil))
                       (setf (gethash var set) t)
                       (push var (gethash fun layouts))
                       (push (cons fun var) pending)))))))
      (collect-function root)
      (dolist (fun functions)
        (let ((ll (ir-fun-lambda-list fun)))
          (when (and (ir-fun-binding fun) ll (ir-fun-body fun)
                     (plusp (ir-fun-calls fun)) (zerop (ir-fun-value-refs fun))
                     (not (logtest 145 (ir-fun-flags fun))) (not (gethash fun invalid)))
            (setf (gethash fun lifted) t))))
      (when (zerop (hash-table-count lifted))
        (return-from ir-prepare-native-environments nil))
      (dolist (pair definitions) (edge (car pair) (cdr pair)))
      (dolist (call calls)
        (when (gethash (svref call 0) lifted) (edge (svref call 0) (svref call 1))))
      (dolist (fun functions)
        (loop for var across (ir-fun-free fun) do (capture fun var)))
      (loop while pending for pair = (pop pending)
            do (dolist (user (gethash (car pair) users))
                 (when (minusp (decf budget)) (return-from ir-prepare-native-environments nil))
                 (capture user (cdr pair))))
      (dolist (fun functions)
        (when (and (gethash fun lifted)
                   (> (+ (length (gethash fun layouts))
                         (length (ir-lambda-list-required (ir-fun-lambda-list fun)))
                         (length (ir-lambda-list-optional (ir-fun-lambda-list fun))))
                      (+ +reg-args+ +values-max+)))
          (return-from ir-prepare-native-environments nil)))
      (dolist (call calls)
        (when (and (gethash (svref call 0) lifted)
                   (> (+ (svref call 2) (length (gethash (svref call 0) layouts)))
                      (+ +reg-args+ +values-max+)))
          (return-from ir-prepare-native-environments nil)))
      (unless *ir-native-environments* (setf *ir-native-environments* (make-hash-table :test #'eq)))
      (unless *ir-lifted-environments* (setf *ir-lifted-environments* (make-hash-table :test #'eq)))
      (dolist (fun functions)
        (let ((layout (coerce (nreverse (gethash fun layouts)) 'simple-vector)))
          (setf (gethash fun *ir-native-environments*) layout)
          (when (gethash fun lifted) (setf (gethash fun *ir-lifted-environments*) layout)))))
    t))

(defun ir-native-environment (fun)
  (let ((free (ir-fun-free fun)) (binding (ir-fun-binding fun)))
    (if (or (logtest 128 (ir-fun-flags fun)) (zerop (length free)))
        #()
        (let ((cache (or *ir-native-environments*
                         (setf *ir-native-environments* (make-hash-table :test #'eq)))))
          (multiple-value-bind (layout found) (gethash fun cache)
            (if found layout
                (setf (gethash fun cache)
                      (if (or (find binding free :test #'eq)
                              (some #'ir-static-function-binding-p free))
                          (remove-if (lambda (var)
                                       (or (eq var binding) (ir-static-function-binding-p var)))
                                     free)
                          free))))))))

(defun ir-static-function-data (fun)
  (let* ((label (ir-function-label fun)) (data (kiln.kir::kir-name label "_fobj")))
    (module-data data `(:words ,+kind-function+ (:func ,label)))
    data))

(defun ir-variable-operand (var)
  (let ((parameter (assoc var *ir-lifted-operands* :test #'eq)))
    (when parameter (return-from ir-variable-operand (ir-var-lowering (cdr parameter)))))
  (when (eq var (ir-fun-binding *ir-lowering-function*))
    (return-from ir-variable-operand *self*))
  (when (ir-static-function-binding-p var)
    (return-from ir-variable-operand
      (copy-to-var `(:addr ,(cddr (ir-var-lowering var)) ,+tag-general+))))
  (if (eq (ir-var-owner var) *ir-lowering-function*)
      (let ((value (or (ir-var-lowering var) (fail "IR variable ~S is not bound" (ir-var-name var)))))
        (if (ir-raw-double-variable-p var) (cdr value) value))
      (let ((index (position var *ir-closure-layout* :test #'eq)))
        (unless index (fail "IR variable ~S is missing from closure layout" (ir-var-name var)))
        (copy-to-var `(:load ,*self* ,(+ +fobj-env+ (* 8 index)))))))

(defun ir-variable-value (var)
  (let ((value (ir-variable-operand var)))
    (cond ((ir-raw-double-variable-p var) (ir-box-double-bits value))
          ((logtest 4 (ir-var-flags var)) (copy-to-var `(:load ,value ,+cons-car+)))
          (t (copy-to-var value)))))

(defun ir-double-local-p (var)
  (and (ir-var-type var) (not (eq (ir-var-type var) t))
       (not (logtest 6 (ir-var-flags var)))
       (eq (ir-declaration-type (ir-var-type var)) 'double-float)))

(defun ir-bind-double-bits (var bits)
  (let ((operand (copy-to-var bits :f64)))
    (setf (ir-var-lowering var) (cons :double-bits operand))
    (note-debug-var operand (source-variable-name var) nil :double-bits)
    operand))

(defun ir-bind-variable (var value &optional raw-local)
  (when (and raw-local (ir-double-local-p var))
    (return-from ir-bind-variable
      (ir-bind-double-bits var `(:load ,value ,(- 8 +tag-general+)))))
  (let* ((cell (logtest 4 (ir-var-flags var)))
         (operand (copy-to-var (if cell (emit-cons value (nil-value)) value))))
    (setf (ir-var-lowering var) operand)
    (note-debug-var operand (source-variable-name var) cell)
    operand))

(defun ir-set-variable (var value &optional (actual t) (check t))
  (when check (ir-check-declaration value (ir-var-type var) actual))
  (cond ((ir-raw-double-variable-p var)
         (emit `(:set ,(ir-variable-operand var) (:load ,value ,(- 8 +tag-general+)))))
        ((logtest 4 (ir-var-flags var))
         (emit `(:store ,(ir-variable-operand var) ,+cons-car+ ,value)))
        (t (emit `(:set ,(ir-variable-operand var) ,value))))
  value)

(defun ir-parameter-list (fun)
  (let ((ll (ir-fun-lambda-list fun)))
    (append (loop for var across (ir-lambda-list-required ll) collect (vector var nil nil nil))
            (coerce (ir-lambda-list-optional ll) 'list)
            (when (ir-lambda-list-rest ll) (list (vector (ir-lambda-list-rest ll) nil nil nil)))
            (coerce (ir-lambda-list-keys ll) 'list))))

(defun ir-parsed-lambda-list (fun &optional captures)
  (let ((ll (ir-fun-lambda-list fun)))
    (make-parsed-lambda-list
     :required (append (mapcar #'cdr captures) (coerce (ir-lambda-list-required ll) 'list))
     :optional (loop for param across (ir-lambda-list-optional ll)
                     collect (list (svref param 0) (svref param 2)))
     :rest (ir-lambda-list-rest ll) :key-p (ir-lambda-list-key-p ll)
     :allow-other-keys (ir-lambda-list-allow-other-keys ll)
     :keys (loop for param across (ir-lambda-list-keys ll)
                 collect (list (svref param 0) (svref param 2) (svref param 3))))))

(defun ir-with-binding (name value body)
  (let* ((sym (constant-object name)) (index (emit-tls-index sym))
         (addr (copy-to-var `(:add (:load :ctx ,+ctx-tls+) (:shl ,index 2)) :raw))
         (region (establish-entry :bind sym)) (s `(:slot ,(region-slot region)))
         (r (new-var)) (n (new-var :raw)))
    (emit `(:store ,s ,+dyn-pend-target+ ,index))
    (emit `(:store ,s ,+dyn-pend-value+ (:load ,addr 0)))
    (emit `(:store ,addr 0 ,value))
    (let ((*regions* (cons region *regions*)))
      (multiple-value-call #'set-mv r n (funcall body)))
    (emit-unbind region)
    (pop-entry region)
    (values r n)))

(defun ir-entry-defaults (parameters fun)
  (if (null parameters)
      (ir-lower-mv (ir-fun-body fun))
      (let* ((parameter (first parameters)) (var (svref parameter 0))
             (init (svref parameter 1)) (supplied (svref parameter 2))
             (special (rassoc var (ir-fun-parameter-specials fun))))
        (when supplied
          (let ((initialize (new-block)) (next (new-block)))
            (br `(:eq ,(ir-variable-value supplied) ,(nil-value)) initialize next)
            (start-block initialize)
            (ir-set-variable var (ir-lower init) t nil)
            (jump next)
            (start-block next)))
        (unless (eq (ir-declaration-type (ir-var-type var)) t)
          (let* ((inputs (ir-fun-input-types fun))
                 (index (and inputs (position var (ir-lambda-list-required (ir-fun-lambda-list fun))
                                              :test #'eq))))
            (ir-check-declaration (ir-variable-value var) (ir-var-type var)
                                  (if index (svref inputs index) t))))
        (when (and supplied (not (eq (ir-declaration-type (ir-var-type supplied)) t)))
          (ir-check-declaration (ir-variable-value supplied) (ir-var-type supplied)))
        (if special
            (ir-with-binding (car special) (ir-variable-value var)
                             (lambda () (ir-entry-defaults (rest parameters) fun)))
            (ir-entry-defaults (rest parameters) fun)))))

(defun ir-function-label (fun)
  (if (eq (ir-fun-lowering-epoch fun) *ir-lowering-epoch*)
      (ir-fun-label fun)
      (setf (ir-fun-lowering-epoch fun) *ir-lowering-epoch*
            (ir-fun-label fun)
            (fresh-label (kiln.kir::kir-name "kiln_ir_"
                                            (local-function-label-name (or (ir-fun-name fun) 'lambda)) "_")))))

(defvar *ir-stack-conses* nil)
(defvar *ir-stack-slots* nil)

(defun ir-with-stack-conses (fun body)
  (let ((*ir-stack-slots* nil) (*regions* *regions*) (roots nil))
    (dolist (node (and *ir-stack-conses* (gethash fun *ir-stack-conses*)))
      (let ((slot (new-slot 24)))
        (push (cons node slot) *ir-stack-slots*)
        (emit `(:store (:slot ,slot) 0 ,+kind-cons+))
        (emit `(:store (:slot ,slot) 8 0))
        (emit `(:store (:slot ,slot) 16 0))
        (let ((region (establish-entry :stack-roots)))
          (emit `(:store (:slot ,(region-slot region)) ,+dyn-pend-target+ (:add (:slot ,slot) 8)))
          (emit `(:store (:slot ,(region-slot region)) ,+dyn-pend-value+ 2))
          (push region roots)
          (push region *regions*))))
    (multiple-value-prog1 (funcall body)
      (dolist (region roots) (pop-entry region)))))

(defun ir-compile-function (fun)
  (let ((name (ir-function-label fun)))
    (unless (gethash name (kiln.kir::kmodule-defined *module*))
      (setf (gethash name (kiln.kir::kmodule-defined *module*)) t)
      (let* ((*ir-lowering-function* fun) (*ir-closure-layout* (ir-native-environment fun))
             (*ir-lifted-operands*
               (loop for var across (or (ir-lifted-environment fun) #())
                     collect (cons var (make-ir-var :name (ir-var-name var) :owner fun))))
            (*regions* '())
            (*debug-vars* '()) (*debug-var-count* 0)
            (*function-name* (local-function-debug-name (or (ir-fun-name fun) (gensym "LAMBDA")))))
        (with-function (name)
          (let* ((ll (ir-parsed-lambda-list fun *ir-lifted-operands*))
                 ;; All arguments in registers: poll first, re-entering
                 ;; on the slow path (EMIT-ENTRY-POLL).
                 (early-poll (and (not (ll-rest ll)) (not (ll-key-p ll))
                                  (<= (+ (length (ll-required ll)) (length (ll-optional ll)))
                                      +reg-args+))))
            (when early-poll (emit-entry-poll))
            (let ((*self* (copy-to-var :self)))
              (let ((*ir-entry-p* t)) (emit-entry ll))
              (dolist (capture *ir-lifted-operands*)
                (note-debug-var (ir-var-lowering (cdr capture))
                                (source-variable-name (car capture))
                                (logtest 4 (ir-var-flags (car capture)))))
              ;; Every incoming argument is rooted before boxing can allocate.
              (dolist (parameter (ir-parameter-list fun))
                (let ((var (svref parameter 0)) (supplied (svref parameter 2)))
                  (ir-bind-variable var (ir-var-lowering var))
                  (when supplied (ir-bind-variable supplied (ir-var-lowering supplied)))))
              (unless early-poll (emit-poll :stack t))
              (multiple-value-bind (v n)
                  (ir-with-stack-conses fun (lambda () (ir-entry-defaults (ir-parameter-list fun) fun)))
                (emit `(:return ,v ,n)))))
          (set-function-debug *function-name* (ir-source-range (ir-fun-source fun))))))
    name))

(defun ir-allocate-function (fun)
  (let ((label (ir-compile-function fun)) (count (length (ir-native-environment fun))))
    (if (zerop count)
        (let ((data (kiln.kir::kir-name label "_fobj")))
          (module-data data `(:words ,+kind-function+ (:func ,label)))
          (copy-to-var `(:addr ,data ,+tag-general+)))
        (let ((p (emit-alloc (+ 16 (* 8 count)) (logior +kind-function+ (ash count +length-shift+)))))
          (emit `(:store ,p 8 (:addr ,label)))
          (copy-to-var `(:add ,p ,+tag-general+))))))

(defun ir-fill-function (fun object)
  (when (logtest 128 (ir-fun-flags fun)) (return-from ir-fill-function object))
  (loop for var across (ir-native-environment fun) for index from 0
        do (emit `(:store ,object ,(+ +fobj-env+ (* 8 index)) ,(ir-variable-operand var))))
  object)

(defun ir-lower-function (fun)
  (when (ir-lifted-environment fun)
    (return-from ir-lower-function
      (copy-to-var `(:addr ,(ir-static-function-data fun) ,+tag-general+))))
  (if (ir-fun-binding fun)
      (ir-variable-value (ir-fun-binding fun))
      (let ((object (ir-allocate-function fun))) (ir-fill-function fun object))))

(defun ir-lower-local-functions (node)
  (let ((functions (ir-node-a node)))
    (loop for fun across functions
          do (ir-function-label fun)
             (setf (ir-var-lowering (ir-fun-binding fun)) nil))
    (loop for fun across functions when (logtest 128 (ir-fun-flags fun))
          do (setf (ir-var-lowering (ir-fun-binding fun))
                   (cons :static-function (cons fun (ir-static-function-data fun)))))
    (loop for fun across functions when (or (logtest 128 (ir-fun-flags fun)) (ir-lifted-environment fun))
          do (ir-compile-function fun))
    (loop for fun across functions unless (or (logtest 128 (ir-fun-flags fun)) (ir-lifted-environment fun))
          do (ir-bind-variable (ir-fun-binding fun) (ir-allocate-function fun)))
    ;; Mutual recursion can capture any sibling's object, so fill only
    ;; after every object is allocated and rooted.
    (loop for fun across functions unless (or (logtest 128 (ir-fun-flags fun)) (ir-lifted-environment fun))
          do (ir-fill-function fun (ir-variable-operand (ir-fun-binding fun))))
    (ir-lower-mv (ir-node-b node))))

(defun ir-lower (node)
  (values (ir-lower-mv node)))

(defun ir-lower-effect (node)
  (case (ir-node-kind node)
    (2 (if (ir-raw-double-variable-p (ir-node-a node))
           (ir-lower-assignment node nil) (ir-lower node)))
    (9 (let ((*call-source* (or (ir-node-source node) *call-source*)))
         (ir-lower-if node #'ir-lower-effect)))
    (10 (loop for form across (ir-node-a node) do (ir-lower-effect form)))
    (11 (let ((*call-source* (or (ir-node-source node) *call-source*)))
          (ir-bind-let node) (ir-lower-effect (ir-node-c node))))
    (otherwise (ir-lower node))))

(defun ir-lower-sequence (nodes)
  (if (zerop (length nodes))
      (values (nil-value) 1)
      (progn (loop for i below (1- (length nodes)) do (ir-lower-effect (svref nodes i)))
             (ir-lower-mv (svref nodes (1- (length nodes)))))))

(defun ir-ref-to-p (node var)
  (and (= (ir-node-kind node) 1) (eq (ir-node-a node) var)))

(defun ir-switch-test (node)
  (when (and (= (ir-node-kind node) 7) (eq (ir-node-a node) 'eql)
             (= (length (ir-node-b node)) 2))
    (let ((args (ir-node-b node)))
      (dotimes (i 2)
        (let ((var (svref args i)) (constant (svref args (- 1 i))))
          (when (= (ir-node-kind var) 1)
            (multiple-value-bind (key found) (constant-value constant)
              (when (and found (typep key '(signed-byte 63)))
                (return-from ir-switch-test (values (ir-node-a var) (list key) var)))))))))
  ;; OR from grouped CASE keys: (LET ((TST test)) (IF TST TST rest)).
  (when (and (= (ir-node-kind node) 11) (not (ir-node-d node)) (= (length (ir-node-a node)) 1))
    (let ((var (svref (ir-node-a node) 0)) (body (ir-node-c node)))
      (when (and (= (ir-node-kind body) 9) (ir-ref-to-p (ir-node-a body) var)
                 (ir-ref-to-p (ir-node-b body) var))
        (multiple-value-bind (left keys reference) (ir-switch-test (svref (ir-node-b node) 0))
          (when left
            (multiple-value-bind (right rest) (ir-switch-test (ir-node-c body))
              (when (eq left right) (values left (append keys rest) reference)))))))))

(defun ir-or-test (node)
  "For (LET ((TMP test)) (IF TMP TMP rest)), as OR expands into, with TMP
used nowhere else: test and rest."
  (when (and (= (ir-node-kind node) 11) (not (ir-node-d node)) (= (length (ir-node-a node)) 1))
    (let ((var (svref (ir-node-a node) 0)) (body (ir-node-c node)))
      (when (and (ir-var-p var) (eq (ir-var-type var) t) (= (ir-var-refs var) 2)
                 (zerop (logand (ir-var-flags var) 3))
                 (= (ir-node-kind body) 9)
                 (ir-ref-to-p (ir-node-a body) var) (ir-ref-to-p (ir-node-b body) var))
        (values (svref (ir-node-b node) 0) (ir-node-c body))))))

(defun ir-bind-let (node)
  (let ((vars (ir-node-a node)) (inits (ir-node-b node)))
    (if (ir-node-d node)
        (multiple-value-bind (v0 n) (ir-lower-mv (svref inits 0))
          ;; Read every value from ctx.values into an obj variable before
          ;; IR-BIND-VARIABLE can allocate a cell.
          (let ((values (make-array (length vars))))
            (setf (svref values 0)
                  (copy-to-var (if (integerp n)
                                   (if (plusp n) v0 (nil-value))
                                   `(:select (:eq ,n 0) ,(nil-value) ,v0))))
            (loop for i from 1 below (length vars)
                  do (setf (svref values i)
                           (copy-to-var
                            (cond ((integerp n)
                                   (if (> n i)
                                       `(:load :ctx ,(+ +ctx-values+ (* 8 (1- i))))
                                       (nil-value)))
                                  ((> i +values-max+) (nil-value))
                                  (t `(:select (:gt ,n ,i)
                                               (:load :ctx ,(+ +ctx-values+ (* 8 (1- i))))
                                               ,(nil-value)))))))
            (loop for var across vars for value across values
                  do (ir-check-declaration value (ir-var-type var))
                     (ir-bind-variable var value t))))
        (let ((values (make-array (length vars))) (raw (make-array (length vars))))
          (loop for var across vars for init across inits for i from 0
                do (setf (svref raw i)
                         (and (ir-double-local-p var)
                              (eq (ir-node-type init) 'double-float)
                              (ir-declaration-proven-p (ir-node-type init) (ir-var-type var)))
                         (svref values i)
                         (if (svref raw i) (ir-lower-double-bits init)
                             (copy-to-var (ir-lower init)))))
          (loop for var across vars for value across values for init across inits
                for bits across raw
                do (if bits (ir-bind-double-bits var value)
                       (progn (ir-check-declaration value (ir-var-type var) (ir-node-type init))
                              (ir-bind-variable var value t))))))))

(defun ir-lower-branch (node then else)
  "Lowers NODE for its truth only: a jump to THEN or ELSE. A test that is
itself a conditional (IF, AND, OR, NOT) becomes branches, so that a
predicate inside it is branched on, not made into T or NIL and compared."
  (let ((*call-source* (or (ir-node-source node) *call-source*)))
    (ir-lower-branch-1 node then else)))

(defun ir-lower-branch-1 (node then else)
  (case (ir-node-kind node)
    (0 (jump (if (ir-node-a node) then else)))
    (9 (let ((yes (new-block)) (no (new-block)))
         (ir-lower-branch (ir-node-a node) yes no)
         (start-block yes)
         (ir-lower-branch (ir-node-b node) then else)
         (start-block no)
         (ir-lower-branch (ir-node-c node) then else)))
    (10 (let ((forms (ir-node-a node)))
          (if (zerop (length forms))
              (jump else)
              (progn
                (loop for i below (1- (length forms)) do (ir-lower (svref forms i)))
                (ir-lower-branch (svref forms (1- (length forms))) then else)))))
    (11 (multiple-value-bind (test rest) (ir-or-test node)
          (if test
              (let ((no (new-block)))
                (ir-lower-branch test then no)
                (start-block no)
                (ir-lower-branch rest then else))
              (progn
                (ir-bind-let node)
                (ir-lower-branch (ir-node-c node) then else)))))
    (7 (if (and (member (ir-node-a node) '(not null))
                (= (length (ir-node-b node)) 1))
           (ir-lower-branch (svref (ir-node-b node) 0) else then)
           (branch-on-value (ir-lower node) then else)))
    (otherwise (branch-on-value (ir-lower node) then else))))

(defun ir-lower-if (node &optional consumer)
  (let ((tail node) (definition nil) (reference nil) (arms '()))
    (loop while (= (ir-node-kind tail) 9)
          do (multiple-value-bind (var keys ref) (ir-switch-test (ir-node-a tail))
               (unless (and var (or (null definition) (eq definition var))) (return))
               (setf definition var reference ref)
               (dolist (key keys)
                 (unless (assoc key arms) (push (cons key (ir-node-b tail)) arms)))
               (setf tail (ir-node-c tail))))
    (when (>= (length arms) 3)
      (return-from ir-lower-if (lower-switch-mv reference (nreverse arms) tail consumer))))
  (let ((r (and (not consumer) (new-var))) (n (and (not consumer) (new-var :raw))) (yes (new-block)) (no (new-block)) (join (new-block)))
    (ir-lower-branch (ir-node-a node) yes no)
    (start-block yes)
    (if consumer (funcall consumer (ir-node-b node))
        (multiple-value-call #'set-mv r n (ir-lower-mv (ir-node-b node))))
    (jump join)
    (start-block no)
    (if consumer (funcall consumer (ir-node-c node))
        (multiple-value-call #'set-mv r n (ir-lower-mv (ir-node-c node))))
    (jump join)
    (start-block join)
    (if consumer (values (nil-value) 1) (values r n))))

(defun ir-lower-fixnum-arithmetic (name a b bounded &optional error-on-overflow)
  (if bounded
      (copy-to-var (case name
                     (+ `(:add ,a ,b)) (- `(:sub ,a ,b))
                     (* `(:mul (:sar ,a ,+fixnum-shift+) ,b))))
      ;; Input types do not prove that the result fits. Keep the overflow
      ;; edge and its arbitrary-precision result.
      (let ((r (new-var)) (ovf (new-var :raw)) (slow (new-block)) (done (new-block)))
        (emit (case name
                (+ `(:add-ovf ,r ,ovf ,a ,b))
                (- `(:sub-ovf ,r ,ovf ,a ,b))
                (* `(:mul-ovf ,r ,ovf (:sar ,a ,+fixnum-shift+) ,b))))
        (br ovf slow done)
        (start-block slow)
        (emit `(:set ,r ,(emit-slow-call
                         (case name (+ 'kiln.kernel::two-arg-+)
                                    (- 'kiln.kernel::two-arg--)
                                    (* 'kiln.kernel::two-arg-*)) a b)))
        (when error-on-overflow
          (emit-slow-call 'kiln.kernel::%declared-type-error r (constant-object 'fixnum)))
        (jump done) (start-block done) r)))

(defun ir-lower-small-search (node)
  (let* ((args (ir-node-b node)) (pattern nil))
    (unless (and (eq (ir-node-a node) 'search) (= (length args) 2)
                 (member (ir-node-type (svref args 1)) '(simple-vector :native-string :simple-array-vector)))
      (return-from ir-lower-small-search (values nil nil)))
    (let ((needle (svref args 0)))
      (cond ((and (= (ir-node-kind needle) 0) (ir-proper-list-p (ir-node-a needle)))
             (setf pattern (ir-node-a needle)))
            ((and (= (ir-node-kind needle) 7) (eq (ir-node-a needle) 'list)
                  (every (lambda (arg) (= (ir-node-kind arg) 0)) (ir-node-b needle)))
             (setf pattern (map 'list #'ir-node-a (ir-node-b needle))))))
    (unless (and pattern (<= (length pattern) 8)
                 (every (lambda (value) (or (symbolp value) (characterp value)
                                           (and (integerp value) (<= +ir-fixnum-min+ value +ir-fixnum-max+)))) pattern))
      (return-from ir-lower-small-search (values nil nil)))
    (let* ((vals (lower-args (coerce args 'list))) (vector (second vals))
           (limit (copy-to-var `(:sub ,(emit-slow-call 'length vector) ,(* 2 (length pattern)))))
           (index (copy-to-var 0)) (result (copy-to-var (nil-value)))
           (head (new-block)) (body (new-block)) (next (new-block)) (done (new-block)))
      (jump head) (start-block head)
      (br `(:gt ,index ,limit) done body)
      (start-block body) (emit-poll)
      (loop for value in pattern for offset from 0
            for matched = (new-block)
            for item = (emit-aref-1 vector (copy-to-var `(:add ,index ,(* 2 offset))) nil)
            do (br `(:eq ,item ,(constant-object value)) matched next)
               (start-block matched))
      (emit `(:set ,result ,index)) (jump done)
      (start-block next) (emit `(:set ,index (:add ,index 2))) (jump head)
      (start-block done)
      (values result t))))

(defun ir-double-arithmetic-p (node)
  (and (= (ir-node-kind node) 7)
       (let ((name (ir-node-a node)) (count (length (ir-node-b node))))
         (or (and (= count 2) (member name '(+ - *)))
             (and (= count 1) (member name '(- abs 1+ 1-)))))
       (every (lambda (arg) (eq (ir-node-type arg) 'double-float)) (ir-node-b node))))

(defun ir-lower-double-bits (node)
  (case (ir-node-kind node)
    (9 (let ((result (new-var :f64)))
         (ir-lower-if node (lambda (branch)
                            (emit `(:set ,result ,(ir-lower-double-bits branch)))))
         (return-from ir-lower-double-bits result)))
    (10 (let ((forms (ir-node-a node)))
          (when (plusp (length forms))
            (loop for i below (1- (length forms)) do (ir-lower-effect (svref forms i)))
            (return-from ir-lower-double-bits
              (ir-lower-double-bits (svref forms (1- (length forms))))))))
    (11 (ir-bind-let node)
        (return-from ir-lower-double-bits (ir-lower-double-bits (ir-node-c node))))
    (20 (return-from ir-lower-double-bits (ir-lower-unwind-protect node t)))
    (22 (let ((result (ir-lower-double-bits (ir-node-a node))))
          (ir-lower-effect (ir-node-b node))
          (return-from ir-lower-double-bits result)))
    (23 (return-from ir-lower-double-bits (ir-lower-double-bits (ir-node-b node)))))
  (when (and (= (ir-node-kind node) 1) (not (ir-node-c node))
             (ir-raw-double-variable-p (ir-node-a node)))
    (return-from ir-lower-double-bits (copy-to-var (ir-variable-operand (ir-node-a node)) :f64)))
  (if (ir-double-arithmetic-p node)
      (let* ((args (ir-node-b node)) (name (ir-node-a node))
             (left (ir-lower-double-bits (svref args 0))))
        (if (= (length args) 2)
            (let ((right (ir-lower-double-bits (svref args 1))))
              (copy-to-var `(,(case name (+ :f64-add) (- :f64-sub) (* :f64-mul))
                            ,left ,right) :f64))
            (case name
              (- (copy-to-var `(:xor ,left ,(- #x8000000000000000)) :f64))
              (abs (copy-to-var `(:and ,left #x7fffffffffffffff) :f64))
              (otherwise
               (copy-to-var `(,(if (eq name '1+) :f64-add :f64-sub)
                             ,left #x3ff0000000000000) :f64)))))
      (let ((object (ir-lower node)))
        (copy-to-var `(:load ,object ,(- 8 +tag-general+)) :f64))))

(defun ir-lower-typed-call (node)
  "Return a primary value and a success flag without partially lowering an
unsupported call. Arguments retain their evaluation order and effects."
  (when (eq (ir-node-a node) 'search)
    (multiple-value-bind (value specialized) (ir-lower-small-search node)
      (when specialized (return-from ir-lower-typed-call (values value t)))))
  (let* ((name (ir-node-a node)) (args (ir-node-b node)) (count (length args)))
    (when (= count 1)
      (multiple-value-bind (truth known) (ir-type-predicate name (ir-node-type (svref args 0)))
        (when known
          (ir-lower (svref args 0))
          (return-from ir-lower-typed-call (values (constant-object truth) t)))))
    (when (and (= count 1) (member name '(zerop plusp minusp))
               (ir-fixnum-type-p (ir-node-type (svref args 0))))
      (let ((value (copy-to-var (ir-lower (svref args 0)))))
        (return-from ir-lower-typed-call
          (values (boolean-value `(,(case name (zerop :eq) (plusp :gt) (minusp :lt)) ,value 0)) t))))
    (when (and (= count 1) (member name '(car cdr))
               (member (ir-node-type (svref args 0)) '(cons null)))
      (let ((value (copy-to-var (ir-lower (svref args 0)))))
        (return-from ir-lower-typed-call
          (values (if (eq (ir-node-type (svref args 0)) 'null) (nil-value)
                      (copy-to-var `(:load ,value ,(if (eq name 'car) +cons-car+ +cons-cdr+)))) t))))
    (when (and (= count 1) (eq name 'char-code)
               (eq (ir-node-type (svref args 0)) 'character))
      (let ((value (copy-to-var (ir-lower (svref args 0)))))
        (return-from ir-lower-typed-call
          (values (copy-to-var `(:shl (:shr ,value ,+character-shift+) ,+fixnum-shift+)) t))))
    (when (and (= count 1) (member name '(1+ 1-))
               (ir-fixnum-type-p (ir-node-type (svref args 0))))
      (let ((value (copy-to-var (ir-lower (svref args 0)))))
        (return-from ir-lower-typed-call
          (values (ir-lower-fixnum-arithmetic
                   (if (eq name '1+) '+ '-) value (ash 1 +fixnum-shift+)
                   (ir-fixnum-type-p (ir-node-type node))) t))))
    (when (ir-double-arithmetic-p node)
      (let* ((bits (ir-lower-double-bits node))
             (object (emit-alloc 16 +kind-double+)))
        (emit `(:store ,object 8 ,bits))
        (return-from ir-lower-typed-call
          (values (copy-to-var `(:add ,object ,+tag-general+)) t))))
    (when (and (= count 2)
               (ir-fixnum-type-p (ir-node-type (svref args 0)))
               (ir-fixnum-type-p (ir-node-type (svref args 1)))
               (member name '(+ - * < > <= >= = /= logand logior logxor)))
      (let* ((vals (lower-args (coerce args 'list))) (a (first vals)) (b (second vals)))
        (return-from ir-lower-typed-call
          (values
           (cond
             ((member name '(+ - *))
              (ir-lower-fixnum-arithmetic name a b (ir-fixnum-type-p (ir-node-type node))))
             ((member name '(logand logior logxor))
              (copy-to-var `(,(case name (logand :and) (logior :or) (logxor :xor)) ,a ,b)))
             (t (boolean-value `(,(case name (< :lt) (> :gt) (<= :le) (>= :ge) (= :eq) (/= :ne))
                                 ,a ,b))))
           t))))
    (when (and (= count 2) (member name '(aref svref elt))
               (eq (ir-node-type (svref args 0)) 'simple-vector))
      (let* ((vals (lower-args (coerce args 'list))) (v (first vals)) (i (second vals)))
        (return-from ir-lower-typed-call
          (values (emit-svref-fast-path
                   v i (lambda () `(:load (:add ,v (:shl ,i 2)) ,+vector-data+))
                   (lambda () (emit-slow-call 'svref v i)) t) t))))
    (when (and (= count 3) (member name '((setf aref) (setf svref) (setf elt)) :test #'equal)
               (eq (ir-node-type (svref args 1)) 'simple-vector))
      (let* ((vals (lower-args (coerce args 'list))) (x (first vals)) (v (second vals)) (i (third vals)))
        (return-from ir-lower-typed-call
          (values (emit-svref-fast-path
                   v i (lambda () (emit `(:store (:add ,v (:shl ,i 2)) ,+vector-data+ ,x)) x)
                   (lambda () (emit-slow-call name x v i)) t) t))))
    (when (and (= count 1) (eq name 'length)
               (member (ir-node-type (svref args 0)) '(simple-vector :native-string)))
      (let ((value (copy-to-var (ir-lower (svref args 0)))))
        (return-from ir-lower-typed-call (values (copy-to-var (vector-length value)) t))))
    (when (or (and (= count 2) (member name '(aref char schar elt))
                   (eq (ir-node-type (svref args 0)) :native-string))
              (and (= count 3) (member name '((setf aref) (setf char) (setf schar) (setf elt)) :test #'equal)
                   (eq (ir-node-type (svref args 1)) :native-string)))
      (let* ((vals (lower-args (coerce args 'list))) (store (= count 3))
             (string (if store (second vals) (first vals))) (index (if store (third vals) (second vals))))
        (return-from ir-lower-typed-call
          (values (emit-schar string index (and store (first vals)) name t) t))))
    (when (or (and (= count 2) (eq name 'elt)
                   (eq (ir-node-type (svref args 0)) :simple-array-vector))
              (and (= count 3) (equal name '(setf elt))
                   (eq (ir-node-type (svref args 1)) :simple-array-vector)))
      (let* ((vals (lower-args (coerce args 'list))) (store (= count 3)))
        (return-from ir-lower-typed-call
          (values (emit-aref-1 (if store (second vals) (first vals))
                              (if store (third vals) (second vals))
                              (and store (first vals))) t))))
    (values nil nil)))

(defun ir-lower-call (node)
  (let ((slot (cdr (assoc node *ir-stack-slots* :test #'eq))))
    (when slot
      (let ((args (lower-args (coerce (ir-node-b node) 'list))))
        (emit `(:store (:slot ,slot) 8 ,(first args)))
        (emit `(:store (:slot ,slot) 16 ,(second args)))
        (return-from ir-lower-call (values (copy-to-var `(:add (:slot ,slot) ,+tag-cons+)) 1)))))
  (multiple-value-bind (value specialized) (ir-lower-typed-call node)
    (when specialized (return-from ir-lower-call (values value 1))))
  (let ((callee (ir-node-a node)) (args (coerce (ir-node-b node) 'list)))
    (cond ((or (symbolp callee) (consp callee)) (lower-global-call callee args))
          (t
           (when (> (length args) (+ +reg-args+ +values-max+))
             (fail "IR call has too many arguments: ~D" (length args)))
           (let* ((object (if (ir-fun-p callee) (ir-lower-function callee)
                              (copy-to-var (ir-lower callee))))
                  (arguments (lower-args args))
                  (values (append (when (ir-fun-p callee)
                                    (loop for var across (or (ir-lifted-environment callee) #())
                                          collect (ir-variable-operand var)))
                                  arguments)))
             (if (ir-node-p callee)
                 (emit-lisp-call (emit-function-designator object) values)
                 (let ((r (new-var)) (n (new-var :raw)))
                   (loop for value in (nthcdr +reg-args+ values) for i from 0
                         do (emit `(:store :ctx ,(+ +ctx-values+ (* 8 i)) ,value)))
                   (emit `(:call-lisp ,r ,n (:addr ,(ir-function-label callee))
                                      (:ctx ,object ,(length values)
                                            ,@(subseq values 0 (min (length values) +reg-args+)))
                                      ,(handler) ,@(call-loc)))
                   (values r n))))))))

(defun ir-check-declaration (value type &optional (actual t))
  (unless (or (eq (ir-declaration-type type) t) (ir-declaration-proven-p actual type))
    (let* ((bad (new-block)) (done (new-block))
           (test (if (inline-typep-specifier-p type)
                     (emit-inline-typep value type)
                     (emit-slow-call 'typep value (constant-object type)))))
      (br `(:eq ,test ,(nil-value)) bad done)
      (start-block bad)
      (emit-slow-call 'kiln.kernel::%declared-type-error value (constant-object type))
      (jump done) (start-block done)))
  value)

(defun ir-lower-reference (node)
  (let ((value (ir-variable-value (ir-node-a node))))
    (when (ir-node-c node) (ir-check-declaration value (ir-node-b node)))
    value))

(defun ir-lower-assignment (node &optional (value-needed t))
  (let* ((var (ir-node-a node)) (init (ir-node-b node))
         (*call-source* (or (ir-node-source init) *call-source*)))
    (when (ir-raw-double-variable-p var)
      (let ((bits (if (ir-declaration-proven-p (ir-node-type init) (ir-var-type var))
                      (ir-lower-double-bits init)
                      (let ((value (ir-lower init)))
                        (ir-check-declaration value (ir-var-type var) (ir-node-type init))
                        (copy-to-var `(:load ,value ,(- 8 +tag-general+)) :raw)))))
        (emit `(:set ,(ir-variable-operand var) ,bits))
        (return-from ir-lower-assignment (if value-needed (ir-box-double-bits bits) (nil-value)))))
    ;; A checked fixnum destination can share arithmetic's overflow edge.
    ;; Construct the full result there so TYPE-ERROR retains its datum.
    (when (and (eq (ir-var-type var) 'fixnum) (= (ir-node-kind init) 7))
      (let* ((name (ir-node-a init)) (args (ir-node-b init)) (count (length args)))
        (when (and (or (and (= count 1) (member name '(1+ 1-)))
                       (and (= count 2) (member name '(+ - *))))
                   (every (lambda (arg) (ir-fixnum-type-p (ir-node-type arg))) args))
          (let* ((values (lower-args (coerce args 'list)))
                 (a (first values)) (b (if (= count 1) (ash 1 +fixnum-shift+) (second values)))
                 (op (case name (1+ '+) (1- '-) (otherwise name)))
                 (value (ir-lower-fixnum-arithmetic op a b
                                                  (ir-fixnum-type-p (ir-node-type init)) t)))
            (return-from ir-lower-assignment (ir-set-variable var value 'fixnum))))))
    (ir-set-variable var (copy-to-var (ir-lower init)) (ir-node-type init))))

(defun ir-lower-mv (node)
  (let ((*call-source* (or (ir-node-source node) *call-source*)))
    (multiple-value-bind (value count)
        (case (ir-node-kind node)
          (0 (constant-object (ir-node-a node)))
          (1 (ir-lower-reference node))
          (2 (ir-lower-assignment node))
          (3 (let* ((symbol (constant-object (ir-node-a node))) (value (emit-symbol-value symbol)))
               (emit-check-bound value symbol) value))
          (4 (let ((value (copy-to-var (ir-lower (ir-node-b node)))))
               (emit-set-symbol-value (constant-object (ir-node-a node)) value) value))
          (5 (function-cell-value (ir-node-a node)))
          (6 (ir-lower-function (ir-node-a node)))
          (7 (ir-lower-call node))
          (8 (funcall (gethash (ir-node-b node) *primops*) (lower-args (coerce (ir-node-a node) 'list))))
          (9 (ir-lower-if node))
          (10 (ir-lower-sequence (ir-node-a node)))
          (11 (ir-bind-let node)
              (ir-lower-mv (ir-node-c node)))
          (12 (ir-with-binding (ir-node-a node) (copy-to-var (ir-lower (ir-node-b node)))
                               (lambda () (ir-lower-mv (ir-node-c node)))))
          (13 (ir-lower-local-functions node))
          (14 (ir-lower-block node))
          (15 (ir-lower-return node))
          (16 (ir-lower-tagbody node))
          (17 (ir-lower-go node))
          (18 (ir-lower-catch node))
          (19 (ir-lower-throw node))
          (20 (ir-lower-unwind-protect node))
          (21 (let ((callee (ir-node-a node)))
                (if (and (= (ir-node-kind callee) 5) (eq (ir-node-a callee) 'list))
                    (let ((acc (nil-value)))
                      (loop for form across (ir-node-b node)
                            do (multiple-value-bind (v n) (ir-lower-mv form)
                                 (setf acc (emit-push-values v n acc))))
                      (emit-nreverse acc))
                    (let ((function (copy-to-var (ir-lower callee))) (acc (nil-value)))
                      (loop for form across (ir-node-b node)
                            do (multiple-value-bind (v n) (ir-lower-mv form)
                                 (setf acc (emit-push-values v n acc))))
                      (emit-apply (emit-function-designator function) (emit-nreverse acc))))))
          (22 (multiple-value-bind (v n) (ir-lower-mv (ir-node-a node))
                (let ((saved (emit-save-values v n)))
                  (ir-lower (ir-node-b node)) (emit-restore-values saved n))))
          (23 (ir-lower-mv (ir-node-b node)))
          (24 (copy-to-var `(:load (:addr ,(ir-node-c node)) 0)))
          (25 (ir-lower-progv node))
          (otherwise (fail "Unknown IR kind ~S" (ir-node-kind node))))
      (values value (or count 1)))))

(defmethod lower ((node ir-node)) (ir-lower node))
(defmethod lower-mv ((node ir-node)) (ir-lower-mv node))

(defun ir-lower-block (ast)
  (let* ((def (ir-node-a ast))
         (body (list (ir-node-b ast)))
         (nonlocal (logtest 1 (ir-exit-flags def)))
         (exit (new-block)) (r (new-var)) (n (new-var :raw)))
    (setf (ir-exit-lowering def)
          (make-exit-info :func *func* :regions *regions* :exit exit :result r :count n))
    (if (not nonlocal)
        (progn
          (bind-var (ir-exit-token (ir-node-a ast)) 0 :name nil)
          (multiple-value-call #'set-mv r n (lower-progn-mv body))
          (jump exit))
        (let* ((token (emit-exit-token))
               (region (establish-entry :exit-point token))
               (land (new-block)))
          (bind-var (ir-exit-token (ir-node-a ast)) token :name nil)
          (let ((*regions* (cons region *regions*)))
            (multiple-value-call #'set-mv r n (lower-progn-mv body)))
          (pop-entry region)
          (jump exit)
          (start-dispatch region land)
          ;; The runtime has unlinked the entry.
          (start-block land)
          (multiple-value-call #'set-mv r n (emit-landed-values))
          (jump exit)))
    (start-block exit)
    (values r n)))

(defun ir-lower-return (ast)
  (let ((info (ir-exit-lowering (ir-node-a ast))))
    (if (eq (exit-info-func info) *func*)
        (multiple-value-bind (v n) (lower-or-nil-mv (ir-node-b ast))
          (let ((r (exit-info-result info)) (rn (exit-info-count info))
                (target (exit-info-regions info)))
            (if (loop for rs on *regions*
                      until (eq rs target)
                      thereis (eq (region-kind (first rs)) :unwind-protect))
                ;; Cleanups run on the way out: keep the values safe.
                (let ((saved (emit-save-values v n)))
                  (emit-local-exit target)
                  (multiple-value-call #'set-mv r rn (emit-restore-values saved n)))
                (progn
                  (set-mv r rn v n)
                  (emit-local-exit target)))
            (jump (exit-info-exit info))))
        (multiple-value-bind (v packed)
            (multiple-value-call #'emit-unwind-values (lower-or-nil-mv (ir-node-b ast)))
          (let ((token (ir-variable-value (ir-exit-token (ir-exit-group (ir-node-a ast))))))
            (emit `(:call-rt ,(rt-exit-to) () (:ctx ,token ,v ,packed) ,(handler)))
            (emit-error +err-expired-exit+ token))))
    (nil-value)))


(defun ir-lower-catch (ast)
  (let* ((tv (lower (ir-node-a ast)))
         (r (new-var)) (n (new-var :raw)) (exit (new-block)) (land (new-block))
         (region (establish-entry :catch tv)))
    (let ((*regions* (cons region *regions*)))
      (multiple-value-call #'set-mv r n (lower-progn-mv (list (ir-node-b ast)))))
    (pop-entry region)
    (jump exit)
    (start-dispatch region land)
    ;; The runtime has unlinked the entry.
    (start-block land)
    (multiple-value-call #'set-mv r n (emit-landed-values))
    (jump exit)
    (start-block exit)
    (values r n)))

(defun ir-lower-throw (ast)
  (let ((tv (copy-to-var (lower (ir-node-a ast)))))
    (multiple-value-bind (vv packed)
        (multiple-value-call #'emit-unwind-values (lower-mv (ir-node-b ast)))
      (emit `(:call-rt ,(rt-throw) () (:ctx ,tv ,vv ,packed) ,(handler))))
    (emit-error +err-no-catch-tag+ tv)
    (nil-value)))

(defun ir-lower-unwind-protect (ast &optional double-primary)
  (let* ((cleanup (list (ir-node-b ast)))
         (r (new-var (if double-primary :f64 :obj)))
         (n (and (not double-primary) (new-var :raw))) (cont (new-block)) (land (new-block))
         (region (establish-entry :unwind-protect)))
    (setf (region-cleanup region) cleanup)
    (multiple-value-bind (v nv)
        (let ((*regions* (cons region *regions*)))
          (if double-primary (values (ir-lower-double-bits (ir-node-a ast)) 1)
              (lower-mv (ir-node-a ast))))
      (pop-entry region)
      (cond (double-primary
             (emit `(:set ,r ,v))
             (ir-lower-effect (ir-node-b ast)))
            (cleanup
             (let ((saved (emit-save-values v nv)))
               (lower-progn cleanup)
               (multiple-value-call #'set-mv r n (emit-restore-values saved nv))))
            (t (set-mv r n v nv))))
    (jump cont)
    (start-dispatch region land)
    ;; Entered by an unwind passing through: the entry stays linked, marked
    ;; as running its cleanup, with the pending target in it. The cleanup
    ;; runs in a region that only unlinks it on a local exit; calls in it
    ;; use the outer handler.
    (start-block land)
    (let ((*regions* (cons (make-region :kind :cleanup-running :slot (region-slot region)
                                        :handler (let ((outer (find-if #'region-handler *regions*)))
                                                   (and outer (region-handler outer)))
                                        :outer *regions*)
                           *regions*)))
      (lower-progn cleanup))
    (emit `(:call-rt ,(rt-continue-unwind) () (:ctx (:slot ,(region-slot region))) ,(handler)))
    (emit '(:trap))
    (start-block cont)
    (values r (or n 1))))


(defun ir-lower-progv (ast)
  (let* ((symbols (copy-to-var (lower (ir-node-a ast))))
         (vals (copy-to-var (lower (ir-node-b ast))))
         (saved (copy-to-var (nil-value))))
    (emit-check-proper-list symbols)
    (emit-check-proper-list vals)
    ;; Save the old values first, then link the entry, then bind: an
    ;; unwind then always finds the complete list.
    (let ((cur (copy-to-var symbols))
          (head (new-block)) (body (new-block)) (done (new-block)))
      (jump head)
      (start-block head)
      (br `(:eq ,cur ,(nil-value)) done body)
      (start-block body)
      (let* ((sym (copy-to-var `(:load ,cur ,+cons-car+)))
             (index (progn (emit-check-symbol sym) (emit-tls-index sym)))
             (old (copy-to-var `(:load (:add (:load :ctx ,+ctx-tls+) (:shl ,index 2)) 0))))
        (emit `(:set ,saved ,(emit-cons (emit-cons sym old) saved))))
      (emit `(:set ,cur (:load ,cur ,+cons-cdr+)))
      (jump head)
      (start-block done))
    (let ((region (establish-entry :progv saved))
          (cur (copy-to-var symbols)) (vcur (copy-to-var vals))
          (head (new-block)) (body (new-block)) (done (new-block))
          (r (new-var)) (n (new-var :raw)))
      (jump head)
      (start-block head)
      (br `(:eq ,cur ,(nil-value)) done body)
      (start-block body)
      ;; Symbols without a value become unbound.
      (let ((v (copy-to-var `(:select (:eq ,vcur ,(nil-value)) ,+unbound+ (:load ,vcur ,+cons-car+)))))
        (emit `(:store (:add (:load :ctx ,+ctx-tls+)
                             (:shl (:load (:load ,cur ,+cons-car+) ,+symbol-tls-index+) 2))
                       0 ,v)))
      (emit `(:set ,cur (:load ,cur ,+cons-cdr+)))
      (emit `(:set ,vcur (:select (:eq ,vcur ,(nil-value)) ,vcur (:load ,vcur ,+cons-cdr+))))
      (jump head)
      (start-block done)
      (let ((*regions* (cons region *regions*)))
        (multiple-value-call #'set-mv r n (lower-progn-mv (list (ir-node-c ast)))))
      (emit-unbind-progv region)
      (pop-entry region)
      (values r n))))


(defun ir-lower-tagbody (node)
  (let* ((segments (ir-node-a node)) (group (ir-node-b node))
         (nonlocal (logtest 1 (ir-exit-flags group)))
         (blocks (map 'simple-vector (lambda (s) (declare (ignore s)) (new-block)) segments))
         (exit (new-block)) (token (and nonlocal (emit-exit-token)))
         (region (and nonlocal (establish-entry :exit-point token)))
         (inner (if region (cons region *regions*) *regions*)))
    (when token (bind-var (ir-exit-token group) token :name nil))
    (loop for segment across segments for block across blocks
          do (setf (ir-exit-lowering (car segment))
                   (make-exit-info :func *func* :regions inner :block block)))
    (let ((*regions* inner))
      (jump (if (plusp (length blocks)) (svref blocks 0) exit))
      (loop for segment across segments for block across blocks for i from 0
            do (start-block block)
               (emit-poll)
               (ir-lower-effect (cdr segment))
               (jump (if (< (1+ i) (length blocks)) (svref blocks (1+ i)) exit))))
    (when region
      (let ((land (new-block)) (bad (new-block)))
        (start-dispatch region land)
        (start-block land)
        (emit `(:store :ctx ,+ctx-dynenv+ (:slot ,(region-slot region))))
        (emit `(:switch (:sar :exn1 ,+fixnum-shift+) ,(kiln.kir::kblock-name bad)
                        ,(loop for block across blocks for i from 0
                               collect (list i (kiln.kir::kblock-name block)))))
        (start-block bad)
        (emit '(:trap))))
    (start-block exit)
    (when region (pop-entry region))
    (nil-value)))

(defun ir-lower-go (node)
  (let* ((exit (ir-node-a node)) (info (ir-exit-lowering exit)))
    (if (eq (exit-info-func info) *func*)
        (progn (emit-local-exit (exit-info-regions info)) (jump (exit-info-block info)))
        (let ((token (ir-variable-value (ir-exit-token (ir-exit-group exit)))))
          (emit `(:call-rt ,(rt-exit-to) () (:ctx ,token ,(ash (ir-exit-index exit) +fixnum-shift+) 0) ,(handler)))
          (emit-error +err-expired-exit+ token)))
    (nil-value)))

(defun ir-lower-toplevel (fun)
  (ir-prepare-native-environments fun)
  (let ((*ir-lowering-function* fun) (*ir-closure-layout* (ir-native-environment fun))
        (*ir-stack-conses* (ir-prepare-stack-conses fun)))
    (loop for ltv across (ir-vector (ir-fun-load-time-values fun))
          for cell = (fresh-label "kiln_ir_ltv_")
          do (setf (kiln.kir::kmodule-replayable-p *module*) nil)
             (setf (ir-node-c ltv) cell)
             (module-data cell '(:words 0))
             (module-root cell 0)
             (let ((function (ir-lower-function (ir-node-a ltv))))
               (emit `(:store (:addr ,cell) 0 ,(emit-lisp-call function '())))))
    (ir-with-stack-conses fun (lambda () (ir-lower (ir-fun-body fun))))))
