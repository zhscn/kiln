(in-package #:kiln.compiler)

(defun ir-stack-cons-candidates (fun)
  "Prove cons identities remain within the binding that creates each one."
  (let ((candidates nil) (budget 8192) (tail-call nil))
    (labels ((children (function node)
               (case (ir-node-kind node)
                 ((6 24) nil)
                 (7 (when (ir-node-p (ir-node-a node)) (funcall function (ir-node-a node)))
                    (loop for arg across (ir-node-b node) do (funcall function arg)))
                 (13 (funcall function (ir-node-b node)))
                 (otherwise (ir-map-children function node))))
             (prove (binding var)
               (let ((eligible (make-hash-table :test #'eq)) (aliases (make-hash-table :test #'eq))
                     (returns (make-hash-table :test #'eq)) (sources nil) (blocks nil) (visible nil))
                 (loop for v across (ir-node-a binding) do (setf (gethash v eligible) t))
                 (setf (gethash var aliases) t)
                 (block proof
                   (labels ((fail () (return-from proof nil))
                            (tick () (when (minusp (decf budget)) (fail)))
                            (catalog (node)
                              (tick)
                              (case (ir-node-kind node)
                                (2 (push (cons (ir-node-a node) (ir-node-b node)) sources))
                                (11 (loop for v across (ir-node-a node) for init across (ir-node-b node)
                                          do (setf (gethash v eligible) t)
                                             (unless (ir-node-d node) (push (cons v init) sources))))
                                (15 (push (ir-node-b node) (gethash (ir-node-a node) returns))))
                              (children #'catalog node))
                            (tainted (node)
                              (tick)
                              (case (ir-node-kind node)
                                (1 (gethash (ir-node-a node) aliases))
                                ((2 4 23) (tainted (ir-node-b node)))
                                (9 (or (tainted (ir-node-b node)) (tainted (ir-node-c node))))
                                (10 (let ((forms (ir-node-a node)))
                                      (and (plusp (length forms)) (tainted (svref forms (1- (length forms)))))))
                                ((11 12 25) (tainted (ir-node-c node)))
                                (13 (tainted (ir-node-b node)))
                                (14 (or (tainted (ir-node-b node))
                                        (some #'tainted (gethash (ir-node-a node) returns))))
                                ((20 22) (tainted (ir-node-a node)))
                                (18 (tainted (ir-node-b node)))
                                (7 (and (member (ir-node-a node) '(rplaca rplacd))
                                        (plusp (length (ir-node-b node))) (tainted (svref (ir-node-b node) 0))))
                                (otherwise nil)))
                            (check-use (node usage)
                              (tick)
                              (when (and (eq usage :escape) (tainted node)) (fail))
                              (case (ir-node-kind node)
                                ((0 5) nil)
                                ((6 24) (when visible (fail)))
                                (17 (when (and visible (not (eq (ir-exit-owner (ir-node-a node)) fun))) (fail)))
                                (3 (when visible (fail)))
                                (1 (when (and visible (or (ir-node-c node)
                                                          (eq (ir-node-type node) 'double-float))) (fail))
                                   (when (and (gethash (ir-node-a node) aliases) (ir-node-b node)
                                              (not (ir-declaration-proven-p 'cons (ir-node-b node)))) (fail)))
                                (2 (when (and visible
                                              (eq (ir-declaration-type (ir-var-type (ir-node-a node))) 'double-float)) (fail))
                                   (when (and visible
                                              (not (ir-declaration-proven-p (ir-node-type (ir-node-b node))
                                                                           (ir-var-type (ir-node-a node))))
                                              (not (eq (ir-var-type (ir-node-a node)) t))) (fail))
                                   (check-use (ir-node-b node) (if (gethash (ir-node-a node) eligible) :flow :escape)))
                                (4 (when visible (fail)) (check-use (ir-node-b node) :escape))
                                (7
                                 (let* ((name (ir-node-a node)) (args (ir-node-b node)) (count (length args))
                                        (borrow (or (and (= count 1) (member name '(car cdr first rest consp listp atom null not)))
                                                    (and (= count 2) (member name '(eq eql)))))
                                        (mutate (and (= count 2) (member name '(rplaca rplacd)))))
                                   (when (and visible
                                              (not (or (and borrow (member name '(consp listp atom null not eq)))
                                                       (and (eq name 'eql) (= count 2)
                                                            (or (member (ir-node-type (svref args 0))
                                                                        '(cons symbol null character function simple-vector :native-string))
                                                                (ir-fixnum-type-p (ir-node-type (svref args 0)))))
                                                       (and (or borrow mutate)
                                                            (eq (ir-node-type (svref args 0)) 'cons)))))
                                     (fail))
                                   (when (ir-node-p name) (check-use name :escape))
                                   (loop for arg across args for i from 0
                                         do (check-use arg (if (or borrow (and mutate (zerop i))) :borrow :escape)))))
                                (8 (when visible (fail)) (loop for arg across (ir-node-a node) do (check-use arg :escape)))
                                (9 (check-use (ir-node-a node) :borrow)
                                   (check-use (ir-node-b node) usage) (check-use (ir-node-c node) usage))
                                (10 (let ((forms (ir-node-a node)))
                                      (loop for form across forms for i from 0
                                            do (check-use form (if (= i (1- (length forms))) usage :discard)))))
                                (11 (when (and visible (some (lambda (v) (logtest 4 (ir-var-flags v))) (ir-node-a node))) (fail))
                                    (loop for v across (ir-node-a node) for init across (ir-node-b node)
                                          do (when (and visible (not (eq (ir-var-type v) t))
                                                        (not (ir-declaration-proven-p (ir-node-type init) (ir-var-type v)))) (fail))
                                             (check-use init (if (and (not (ir-node-d node)) (gethash v eligible)) :flow :escape)))
                                    (check-use (ir-node-c node) usage))
                                (12 (when visible (fail)) (check-use (ir-node-b node) :escape) (check-use (ir-node-c node) usage))
                                (13 (when visible (fail)) (check-use (ir-node-b node) usage))
                                (14 (push (cons (ir-node-a node) usage) blocks)
                                    (check-use (ir-node-b node) usage) (pop blocks))
                                (15 (when (and visible (not (eq (ir-exit-owner (ir-node-a node)) fun))) (fail))
                                    (check-use (ir-node-b node) (or (cdr (assoc (ir-node-a node) blocks :test #'eq)) :escape)))
                                (16 (when visible (fail)) (loop for segment across (ir-node-a node) do (check-use (cdr segment) :discard)))
                                (18 (check-use (ir-node-a node) :borrow) (check-use (ir-node-b node) usage))
                                (19 (when visible (fail)) (check-use (ir-node-a node) :escape) (check-use (ir-node-b node) :escape))
                                (20 (check-use (ir-node-a node) usage) (check-use (ir-node-b node) :discard))
                                (21 (when visible (fail)) (check-use (ir-node-a node) :escape)
                                    (loop for arg across (ir-node-b node) do (check-use arg :escape)))
                                (22 (check-use (ir-node-a node) usage) (check-use (ir-node-b node) :discard))
                                (23 (when (and (tainted (ir-node-b node))
                                               (not (ir-declaration-proven-p 'cons (ir-node-a node)))) (fail))
                                    (when (and visible (not (eq (ir-node-a node) t))
                                               (not (ir-declaration-proven-p (ir-node-type (ir-node-b node)) (ir-node-a node)))) (fail))
                                    (check-use (ir-node-b node) usage))
                                (25 (when visible (fail)) (check-use (ir-node-a node) :escape) (check-use (ir-node-b node) :escape)
                                    (check-use (ir-node-c node) usage))
                                (otherwise (fail)))))
                     (catalog (ir-node-c binding))
                     ;; May-alias propagation includes every lexical write. A value
                     ;; may leave this binding only through one of the inspected uses.
                     (loop with changed = t while changed
                           do (setf changed nil)
                              (dolist (source sources)
                                (when (and (tainted (cdr source)) (not (gethash (car source) aliases)))
                                  (unless (gethash (car source) eligible) (fail))
                                  (setf (gethash (car source) aliases) t changed t))))
                     (maphash (lambda (alias value)
                                (declare (ignore value))
                                (when (source-variable-name alias) (setf visible t))
                                (when (or (logtest 2 (ir-var-flags alias))
                                          (not (or (eq (ir-var-type alias) t)
                                                   (ir-declaration-proven-p 'cons (ir-var-type alias)))))
                                  (fail))) aliases)
                     (when visible
                       (loop for v across (ir-node-a binding) for init across (ir-node-b binding)
                             when (or (logtest 4 (ir-var-flags v))
                                      (and (not (eq (ir-var-type v) t))
                                           (not (ir-declaration-proven-p (ir-node-type init) (ir-var-type v)))))
                               do (fail)))
                     (check-use (ir-node-c binding) :escape)
                     t))))
             (walk (node)
               (when (and (= (ir-node-kind node) 8)
                          (member (ir-node-b node) '(:tail-funcall :tail-funcall-function)))
                 (setf tail-call t))
               (when (and (= (ir-node-kind node) 11) (not (ir-node-d node)))
                 (loop for var across (ir-node-a node) for init across (ir-node-b node)
                       when (and (plusp budget) (< (length candidates) 16)
                                 (= (ir-node-kind init) 7) (eq (ir-node-a init) 'cons)
                                 (= (length (ir-node-b init)) 2)
                                 (not (eq (ir-node-d init) :notinline))
                                 (or (eq (ir-var-type var) t) (ir-declaration-proven-p 'cons (ir-var-type var)))
                                 (prove node var)) do (push init candidates)))
               (children #'walk node)))
      (ir-map-function #'walk fun))
    (unless tail-call (nreverse candidates))))

(defun ir-prepare-stack-conses (root)
  (let ((plans (make-hash-table :test #'eq)) (seen (make-hash-table :test #'eq)))
    (labels ((function-tree (fun)
               (unless (gethash fun seen)
                 (setf (gethash fun seen) t (gethash fun plans) (ir-stack-cons-candidates fun))
                 (ir-map-function #'walk fun)))
             (walk (node)
               (case (ir-node-kind node)
                 ((6 7) (let ((owned (ir-own-function node))) (when owned (function-tree owned)))
                        (when (ir-node-p (ir-node-a node)) (walk (ir-node-a node)))
                        (when (= (ir-node-kind node) 7) (loop for arg across (ir-node-b node) do (walk arg))))
                 (13 (loop for fun across (ir-node-a node) do (function-tree fun)) (walk (ir-node-b node)))
                 (24 (function-tree (ir-node-a node)))
                 (otherwise (ir-map-children #'walk node)))))
      (function-tree root))
    plans))
