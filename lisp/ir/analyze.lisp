      (dolist (entry entries)
        (let ((init (ir-function-alias-initializer entry)))
          (if (= (ir-node-kind init) 6)
              (when (gethash (ir-node-a init) seen) (offer entry entry))
              (let ((source (gethash (ir-node-a init) aliases)))
                (when source
                  (push entry (ir-function-alias-users source))
                  (setf (ir-function-alias-source entry) source))))))
      (when (null pending) (return-from resolve-ir-function-aliases nil))
      (loop while pending for entry = (pop pending)
            do (dolist (user (ir-function-alias-users entry))
                 (offer user (ir-function-alias-target entry))))
      (dolist (reference references)
        (let* ((ref (car reference)) (usage (cdr reference))
               (entry (gethash (ir-node-a ref) aliases))
               (seed (and entry (ir-function-alias-target entry))))
          (cond ((and seed (ir-node-p usage) (safe-reference-p ref))
                 (push (cons usage (ir-node-a (ir-function-alias-initializer seed))) rewrites)
                 (setf (ir-function-alias-used seed) t))
                ((and (ir-function-alias-p usage) (ir-function-alias-target usage)))
                (t (escape entry)))))
