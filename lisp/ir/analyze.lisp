(defun analyze-ir (root &optional (specialize t))
  "Compute captures and exits, then specialize calls using inferred facts.
Moved bodies are analyzed again against their final lexical owners."
  (setf (ir-fun-load-time-values root) (make-ir-buffer))
  (labels
      ((analyze (fun)
         (let ((*ir-function* fun) (free (make-ir-buffer)))
           (setf (ir-fun-flags fun) (logior 32 (ir-fun-flags fun)))
           (loop with buffer = (ir-fun-vars fun)
                 with data = (ir-buffer-data buffer)
                 with count = (ir-buffer-count buffer)
                 for index below count
                 for var = (svref data index)
                 do (setf (ir-var-flags var) (logandc2 (ir-var-flags var) 6)))
           (setf (ir-fun-exits fun) (make-ir-buffer))
           (labels
               ((capture (var)
                  (unless (eq (ir-var-owner var) fun)
                    (unless (find var (ir-buffer-data free) :end (ir-buffer-count free) :test #'eq)
                      (ir-push var free))
                    (setf (ir-var-flags var) (logior 2 (ir-var-flags var)))))
                (child (nested)
                  (setf (ir-fun-parent nested) (ir-canonical-function (ir-fun-parent nested)))
                  (analyze nested)
                  (loop for var across (ir-fun-free nested) do (capture var)))
                (exit-reference (exit)
                  (unless (eq (ir-exit-owner exit) fun)
                    (let ((group (ir-exit-group exit)))
                      (setf (ir-exit-flags group) 1)
                      (capture (ir-exit-token group)))))
                (visit (node)
                  (when (= (ir-node-kind node) 7) (ir-inline-call node fun))
                  (case (ir-node-kind node)
                    ((1 2) (capture (ir-node-a node))
                           (when (= (ir-node-kind node) 2) (visit (ir-node-b node))))
                    ((6 7)
                     (let ((callee (ir-node-a node)))
                       (cond ((ir-fun-p callee)
                              (if (ir-fun-binding callee) (capture (ir-fun-binding callee)) (child callee)))
                             ((ir-node-p callee) (visit callee))))
                     (when (= (ir-node-kind node) 7)
                       (loop for arg across (ir-node-b node) do (visit arg))))
                    (13 (loop for nested across (ir-node-a node)
                              unless (ir-inline-candidate-p nested fun) do (child nested))
                        (visit (ir-node-b node))
                        (setf (ir-node-a node)
                              (coerce (loop for nested across (ir-node-a node)
                                            unless (logtest 16 (ir-fun-flags nested)) collect nested)
                                      'simple-vector)))
                    ((14 16)
                     (let ((exit (if (= (ir-node-kind node) 14) (ir-node-a node) (ir-node-b node))))
                       (setf (ir-exit-flags exit) 0 (ir-exit-owner exit) fun)
                       (when (= (ir-node-kind node) 16)
                         (loop for segment across (ir-node-a node)
                               do (setf (ir-exit-owner (car segment)) fun)))
                       (ir-map-children #'visit node)
                       (when (logtest 1 (ir-exit-flags exit)) (ir-push exit (ir-fun-exits fun)))))
                    ((15 17) (exit-reference (ir-node-a node))
                             (when (= (ir-node-kind node) 15) (visit (ir-node-b node))))
                    (24 (analyze (ir-node-a node))
                        (ir-push node (ir-fun-load-time-values root)))
                    (otherwise (ir-map-children #'visit node)))))
             (ir-map-function #'visit fun))
           (setf (ir-fun-free fun) (ir-vector free))
           (when (plusp (length (ir-fun-free fun)))
             (setf (ir-fun-flags fun) (logior 2 (ir-fun-flags fun))))
           (when (= (ir-fun-calls fun) 1)
             (setf (ir-fun-flags fun) (logior 4 (ir-fun-flags fun))))
           (loop with buffer = (ir-fun-vars fun)
                 with data = (ir-buffer-data buffer)
                 with count = (ir-buffer-count buffer)
                 for index below count
                 for var = (svref data index)
                 when (= (logand (ir-var-flags var) 3) 3)
                   do (setf (ir-var-flags var) (logior 4 (ir-var-flags var)))))))
    (analyze root))
  (multiple-value-bind (typed local-calls conses) (infer-ir-types root)
    (declare (ignore typed))
    (when (and specialize local-calls (specialize-ir-calls root)) (analyze-ir root nil))
    (when (and specialize conses (scalar-replace-ir-conses root)) (analyze-ir root nil)))
  root)
