(defun resolve-ir-function-aliases (root)
  "Resolve immutable lexical function identities and remove nonescaping aliases."
  (let ((seen (make-hash-table :test #'eq)) (aliases (make-hash-table :test #'eq))
        (entries nil) (references nil) (functions nil) (binding-nodes nil)
        (pending nil) (rewrites nil) (budget 16384) (changed nil) (removed nil))
    (labels ((function-tree (fun)
               (unless (gethash fun seen)
                 (setf (gethash fun seen) t)
                 (push fun functions)
                 (labels ((walk (node) (visit node fun #'walk nil)))
                   (ir-map-function #'walk fun))))
             (safe-reference-p (node)
               (and (not (ir-node-c node))
                    (or (null (ir-node-b node))
                        (ir-declaration-proven-p 'function (ir-node-b node)))))
             (visit (node owner walk usage)
               (when (minusp (decf budget)) (return-from resolve-ir-function-aliases nil))
               (case (ir-node-kind node)
                 (1 (push (cons node usage) references))
                 (11 (let ((any nil))
                       (loop for var across (ir-node-a node) for init across (ir-node-b node)
                             for index from 0
                             for entry = (when (and (not (ir-node-d node))
                                                    (not (logtest 1 (ir-var-flags var)))
                                                    (or (eq (ir-var-type var) t)
                                                        (ir-declaration-proven-p 'function (ir-var-type var)))
                                                    (or (= (ir-node-kind init) 6)
                                                        (and (= (ir-node-kind init) 1) (safe-reference-p init))))
                                           (make-ir-function-alias node owner var init index))
                             do (when entry
                                  (setf (gethash var aliases) entry any t)
                                  (push entry entries))
                                (visit init owner walk entry))
                       (when any (push node binding-nodes)))
                     (funcall walk (ir-node-c node)))
                 ((6 7)
                  (let ((owned (ir-own-function node))) (when owned (function-tree owned)))
                  (when (ir-node-p (ir-node-a node))
                    (visit (ir-node-a node) owner walk (when (= (ir-node-kind node) 7) node)))
                  (when (= (ir-node-kind node) 7)
                    (loop for arg across (ir-node-b node) do (funcall walk arg))))
                 (13 (loop for fun across (ir-node-a node) do (function-tree fun))
                     (funcall walk (ir-node-b node)))
                 (24 (function-tree (ir-node-a node)))
                 (otherwise (ir-map-children walk node))))
             (offer (entry seed)
               (unless (ir-function-alias-target entry)
                 (setf (ir-function-alias-target entry) seed)
                 (push entry pending)))
             (escape (entry)
               (when (and entry (ir-function-alias-target entry) (not (ir-function-alias-escaped entry)))
                 (setf (ir-function-alias-escaped entry) t)
                 (push entry pending)))
             (discard-p (entry)
               (and entry (ir-function-alias-target entry) (not (ir-function-alias-escaped entry)))))
