                           (if discard (ir-node 0 (ir-node-source init) nil) init)))
            (when discard
              (setf (svref (ir-node-a node) index) (ir-new-var (gensym "DISCARDED") owner)))
            (setf changed t))
          (when discard
            (setf removed t changed t)
            (unless promote (setf (svref (ir-node-a node) index) nil)))))
      (dolist (rewrite rewrites)
        (setf (ir-node-a (car rewrite)) (cdr rewrite) (ir-node-d (car rewrite)) :notinline changed t))
      (when changed (ir-note-local-functions root))
      (when removed
        (dolist (node binding-nodes)
          (let ((vars (ir-node-a node)) (inits (ir-node-b node)))
            (when (position nil vars)
              (let ((keep (loop for i below (length vars) when (svref vars i) collect i)))
                (setf (ir-node-a node) (map 'simple-vector (lambda (i) (svref vars i)) keep)
                      (ir-node-b node) (map 'simple-vector (lambda (i) (svref inits i)) keep))))))
        (dolist (fun functions)
          (let* ((buffer (ir-fun-vars fun)) (data (ir-buffer-data buffer))
                 (old (ir-buffer-count buffer)) (write 0))
            (loop for i below old for var = (svref data i)
                  unless (discard-p (gethash var aliases)) do (setf (svref data write) var) (incf write))
            (loop for i from write below old do (setf (svref data i) nil))
            (setf (ir-buffer-count buffer) write)))))
    changed))

(defun prune-ir-local-functions (root)
  "Discard local definitions unreachable from execution or load-time roots."
  (let ((functions (make-hash-table :test #'eq)) (parents (make-hash-table :test #'eq))
        (live (make-hash-table :test #'eq)) (groups nil) (initializers nil)
        (pending nil) (retired nil) (changed nil))
    (labels ((catalog (fun parent)
               (unless (gethash fun functions)
                 (setf (gethash fun functions) t (gethash fun parents) parent)
                 (ir-map-function (lambda (node) (discover node fun)) fun)))
             (discover (node owner)
               (case (ir-node-kind node)
                 ((6 7)
                  (let ((owned (ir-own-function node))) (when owned (catalog owned owner)))
                  (when (ir-node-p (ir-node-a node)) (discover (ir-node-a node) owner))
                  (when (= (ir-node-kind node) 7)
                    (loop for arg across (ir-node-b node) do (discover arg owner))))
                 (13 (push (cons owner node) groups)
                     (loop for fun across (ir-node-a node) do (catalog fun owner))
                     (discover (ir-node-b node) owner))
                 (24 (push owner initializers) (catalog (ir-node-a node) owner))
                 (otherwise (ir-map-children (lambda (child) (discover child owner)) node))))
             (offer (fun)
               (unless (gethash fun live)
                 (setf (gethash fun live) t)
                 (push fun pending)))
             (visit (node owner)
               (case (ir-node-kind node)
                 ((1 2) (let ((var (ir-node-a node)))
                          (incf (ir-var-refs var))
                          (when (= (ir-node-kind node) 2)
                            (setf (ir-var-flags var) (logior 1 (ir-var-flags var)))
                            (visit (ir-node-b node) owner))))
                 ((6 7)
                  (let ((callee (ir-node-a node)))
                    (cond ((ir-fun-p callee)
                           (offer callee)
                           (if (= (ir-node-kind node) 6)
                               (progn (incf (ir-fun-value-refs callee))
                                      (setf (ir-fun-flags callee) (logior 1 (ir-fun-flags callee))))
                               (progn (incf (ir-fun-calls callee))
                                      (setf (ir-fun-caller callee) owner (ir-fun-call-site callee) node))))
                          ((ir-node-p callee) (visit callee owner))))
                  (when (= (ir-node-kind node) 7)
                    (loop for arg across (ir-node-b node) do (visit arg owner))))
                 (13 (visit (ir-node-b node) owner))
                 (24 (offer (ir-node-a node)))
                 (otherwise (ir-map-children (lambda (child) (visit child owner)) node)))))
      (catalog root nil)
      (maphash (lambda (fun ignored)
                 (declare (ignore ignored))
                 (setf (ir-fun-calls fun) 0 (ir-fun-value-refs fun) 0
                       (ir-fun-caller fun) nil (ir-fun-call-site fun) nil
                       (ir-fun-flags fun) (logandc2 (ir-fun-flags fun) 13))
                 (let ((buffer (ir-fun-vars fun)))
                   (loop for i below (ir-buffer-count buffer) for var = (svref (ir-buffer-data buffer) i)
                         do (setf (ir-var-refs var) 0 (ir-var-flags var) (logandc2 (ir-var-flags var) 7)))))
               functions)
      (offer root)
      (dolist (fun initializers)
        (loop for owner = fun then (gethash owner parents) while owner do (offer owner)))
      (loop while pending for fun = (pop pending)
            do (ir-map-function (lambda (node) (visit node fun)) fun))
      (maphash (lambda (fun ignored)
                 (declare (ignore ignored))
                 (when (zerop (ir-fun-value-refs fun))
                   (setf (ir-fun-flags fun) (logior 8 (ir-fun-flags fun))))) live)
      (dolist (entry groups)
        (let* ((node (cdr entry)) (definitions (ir-node-a node)))
          (when (some (lambda (fun) (not (gethash fun live))) definitions)
            (loop for fun across definitions unless (gethash fun live)
                  do (setf (gethash (ir-fun-binding fun)
                                   (or retired (setf retired (make-hash-table :test #'eq)))) t))
            (setf (ir-node-a node) (remove-if-not (lambda (fun) (gethash fun live)) definitions)
                  changed t))))
      (when retired
        (maphash (lambda (fun ignored)
                   (declare (ignore ignored))
                   (let* ((buffer (ir-fun-vars fun)) (data (ir-buffer-data buffer))
                          (old (ir-buffer-count buffer)) (write 0))
                     (loop for i below old for var = (svref data i)
                           unless (gethash var retired) do (setf (svref data write) var) (incf write))
                     (loop for i from write below old do (setf (svref data i) nil))
                     (setf (ir-buffer-count buffer) write))) functions)))
    changed))

(defun classify-ir-function-environments (root)
  "Mark function graphs whose captures resolve entirely to static functions."
  (let ((seen (make-hash-table :test #'eq)) (bindings (make-hash-table :test #'eq))
        (users (make-hash-table :test #'eq)) (dynamic (make-hash-table :test #'eq))
        (functions nil) (pending nil))
    (labels ((collect-function (fun)
               (unless (gethash fun seen)
                 (setf (gethash fun seen) t)
                 (push fun functions)
                 (when (ir-fun-binding fun) (setf (gethash (ir-fun-binding fun) bindings) fun))
                 (ir-map-function #'collect-node fun)))
             (collect-node (node)
               (case (ir-node-kind node)
                 ((6 7)
                  (let ((owned (ir-own-function node))) (when owned (collect-function owned)))
                  (when (ir-node-p (ir-node-a node)) (collect-node (ir-node-a node)))
                  (when (= (ir-node-kind node) 7) (loop for arg across (ir-node-b node) do (collect-node arg))))
                 (13 (loop for fun across (ir-node-a node) do (collect-function fun))
                     (collect-node (ir-node-b node)))
                 (24 (collect-function (ir-node-a node)))
                 (otherwise (ir-map-children #'collect-node node))))
             (reject (fun)
               (unless (gethash fun dynamic)
                 (setf (gethash fun dynamic) t)
                 (push fun pending))))
      (collect-function root)
      (dolist (fun functions)
        (setf (ir-fun-flags fun) (logandc2 (ir-fun-flags fun) 128))
        (loop for var across (ir-fun-free fun)
              for dependency = (gethash var bindings)
              do (if dependency (push fun (gethash dependency users)) (reject fun))))
      (loop while pending for fun = (pop pending)
            do (dolist (user (gethash fun users)) (reject user)))
      (dolist (fun functions)
        (unless (gethash fun dynamic) (setf (ir-fun-flags fun) (logior 128 (ir-fun-flags fun))))))
    root))

(defun analyze-ir (root &optional (specialize t))
  "Compute captures and exits, then specialize calls using inferred facts.
Moved bodies are analyzed again against their final lexical owners."
  (when (and (logtest 256 (ir-fun-flags root)) (not (logtest 32 (ir-fun-flags root))))
    (resolve-ir-function-aliases root))
  (when (and (logtest 64 (ir-fun-flags root)) (not (logtest 32 (ir-fun-flags root))))
    (prune-ir-local-functions root))
  (setf (ir-fun-load-time-values root) (make-ir-buffer))
  (labels
      ((analyze (fun)
         (let ((*ir-function* fun) (free (make-ir-buffer)))
           (setf (ir-fun-flags fun) (logior 32 (ir-fun-flags fun)))
           (loop with buffer = (ir-fun-vars fun)
                 with data = (ir-buffer-data buffer)
                 with count = (ir-buffer-count buffer)
                 for index below count
                 for var = (svref data index)
                 do (setf (ir-var-flags var) (logandc2 (ir-var-flags var) 6)))
           (setf (ir-fun-exits fun) (make-ir-buffer))
           (labels
               ((capture (var)
                  (unless (eq (ir-var-owner var) fun)
                    (unless (find var (ir-buffer-data free) :end (ir-buffer-count free) :test #'eq)
                      (ir-push var free))
                    (setf (ir-var-flags var) (logior 2 (ir-var-flags var)))))
                (child (nested)
                  (setf (ir-fun-parent nested) (ir-canonical-function (ir-fun-parent nested)))
                  (analyze nested)
                  (loop for var across (ir-fun-free nested) do (capture var)))
                (exit-reference (exit)
                  (unless (eq (ir-exit-owner exit) fun)
                    (let ((group (ir-exit-group exit)))
                      (setf (ir-exit-flags group) 1)
                      (capture (ir-exit-token group)))))
                (visit (node)
                  (when (= (ir-node-kind node) 7) (ir-inline-call node fun))
                  (case (ir-node-kind node)
                    ((1 2) (capture (ir-node-a node))
                           (when (= (ir-node-kind node) 2) (visit (ir-node-b node))))
                    ((6 7)
                     (let ((callee (ir-node-a node)))
                       (cond ((ir-fun-p callee)
                              (if (ir-fun-binding callee) (capture (ir-fun-binding callee)) (child callee)))
                             ((ir-node-p callee) (visit callee))))
                     (when (= (ir-node-kind node) 7)
                       (loop for arg across (ir-node-b node) do (visit arg))))
                    (13 (loop for nested across (ir-node-a node)
                              unless (ir-inline-candidate-p nested fun) do (child nested))
                        (visit (ir-node-b node))
                        (setf (ir-node-a node)
                              (coerce (loop for nested across (ir-node-a node)
                                            unless (logtest 16 (ir-fun-flags nested)) collect nested)
                                      'simple-vector)))
                    ((14 16)
                     (let ((exit (if (= (ir-node-kind node) 14) (ir-node-a node) (ir-node-b node))))
                       (setf (ir-exit-flags exit) 0 (ir-exit-owner exit) fun)
                       (when (= (ir-node-kind node) 16)
                         (loop for segment across (ir-node-a node)
                               do (setf (ir-exit-owner (car segment)) fun)))
                       (ir-map-children #'visit node)
                       (when (logtest 1 (ir-exit-flags exit)) (ir-push exit (ir-fun-exits fun)))))
                    ((15 17) (exit-reference (ir-node-a node))
                             (when (= (ir-node-kind node) 15) (visit (ir-node-b node))))
                    (24 (analyze (ir-node-a node))
                        (ir-push node (ir-fun-load-time-values root)))
                    (otherwise (ir-map-children #'visit node)))))
             (ir-map-function #'visit fun))
           (setf (ir-fun-free fun) (ir-vector free))
           (when (plusp (length (ir-fun-free fun)))
             (setf (ir-fun-flags fun) (logior 2 (ir-fun-flags fun))))
           (when (= (ir-fun-calls fun) 1)
             (setf (ir-fun-flags fun) (logior 4 (ir-fun-flags fun))))
           (loop with buffer = (ir-fun-vars fun)
                 with data = (ir-buffer-data buffer)
                 with count = (ir-buffer-count buffer)
                 for index below count
                 for var = (svref data index)
                 when (= (logand (ir-var-flags var) 3) 3)
                   do (setf (ir-var-flags var) (logior 4 (ir-var-flags var)))))))
    (analyze root))
  (when (logtest 64 (ir-fun-flags root)) (classify-ir-function-environments root))
  (multiple-value-bind (typed local-calls conses) (infer-ir-types root)
    (declare (ignore typed))
    (when (and specialize local-calls (specialize-ir-calls root)) (analyze-ir root nil))
    (when (and specialize conses (scalar-replace-ir-conses root)) (analyze-ir root nil)))
  root)
