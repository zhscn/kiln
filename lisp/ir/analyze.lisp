      (dolist (entry (reverse entries))
        (let* ((node (ir-function-alias-node entry)) (owner (ir-function-alias-owner entry))
               (init (ir-function-alias-initializer entry)) (index (ir-function-alias-index entry))
               (seed (ir-function-alias-target entry))
               (fun (and seed (ir-node-a (ir-function-alias-initializer seed))))
               (discard (discard-p entry))
               (promote (and fun (eq entry seed) (not (ir-fun-binding fun))
