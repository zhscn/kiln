(in-package #:kiln.compiler)

(defun ir-map-function (function fun)
  "Visit the roots owned by FUN, including default parameter forms."
  (let ((ll (ir-fun-lambda-list fun)))
    (when ll
      (loop for parameter across (ir-lambda-list-optional ll)
            do (funcall function (svref parameter 1)))
      (loop for parameter across (ir-lambda-list-keys ll)
            do (funcall function (svref parameter 1)))))
  (when (ir-fun-body fun) (funcall function (ir-fun-body fun))))

(defun ir-canonical-function (fun)
  (loop while (and fun (logtest 16 (ir-fun-flags fun))) do (setf fun (ir-fun-parent fun))
        finally (return fun)))

(defun ir-inline-candidate-p (fun caller)
  (let ((ll (ir-fun-lambda-list fun)) (call (ir-fun-call-site fun)))
    (and (= (ir-fun-calls fun) 1) (not (logtest 33 (ir-fun-flags fun)))
         (eq (ir-canonical-function (ir-fun-parent fun)) caller)
         (eq (ir-canonical-function (ir-fun-caller fun)) caller)
         call (not (eq (ir-node-d call) :notinline))
         (= (length (ir-node-b call)) (length (ir-lambda-list-required ll)))
         (zerop (length (ir-lambda-list-optional ll)))
         (not (ir-lambda-list-rest ll)) (not (ir-lambda-list-key-p ll))
         (null (ir-fun-parameter-specials fun)))))

(defun ir-inline-call (node caller)
  (let ((fun (ir-node-a node)))
    (when (and (ir-fun-p fun) (ir-inline-candidate-p fun caller))
      (loop with buffer = (ir-fun-vars fun)
            with data = (ir-buffer-data buffer)
            with count = (ir-buffer-count buffer)
            for index below count
            for var = (svref data index)
            do (setf (ir-var-owner var) caller
                     (ir-var-flags var) (logandc2 (ir-var-flags var) 6))
               (ir-push var (ir-fun-vars caller)))
      (setf (ir-node-kind node) 11
            (ir-node-a node) (ir-lambda-list-required (ir-fun-lambda-list fun))
            (ir-node-c node) (ir-fun-body fun)
            (ir-fun-body fun) nil
            (ir-fun-flags fun) (logior 16 (ir-fun-flags fun))))))

(defun ir-specialization-cost (fun)
  (let ((ll (ir-fun-lambda-list fun)) (size 0))
    (unless (and ll (ir-fun-body fun) (not (logtest 1 (ir-fun-flags fun)))
                 (zerop (length (ir-lambda-list-optional ll)))
                 (not (ir-lambda-list-rest ll)) (not (ir-lambda-list-key-p ll))
                 (null (ir-fun-parameter-specials fun)))
      (return-from ir-specialization-cost nil))
    (labels ((small (node)
               (when (> (incf size) 16) (return-from ir-specialization-cost nil))
               (unless (member (ir-node-kind node) '(0 1 2 3 4 5 7 8 9 10 11 12 21 22 23 25))
                 (return-from ir-specialization-cost nil))
               (when (and (= (ir-node-kind node) 7) (ir-fun-p (ir-node-a node)))
                 (return-from ir-specialization-cost nil))
               (ir-map-children #'small node)))
      (small (ir-fun-body fun)))
    size))

(defun ir-copy-specialization (fun caller call)
  (let ((copy (make-ir-fun :name (ir-fun-name fun) :source (ir-fun-source fun)
                           :parent caller :caller caller :call-site call :calls 1
                           :policy (ir-fun-policy fun)))
        (variables (make-hash-table :test #'eq)))
    (loop with buffer = (ir-fun-vars fun)
          for i below (ir-buffer-count buffer)
          for var = (svref (ir-buffer-data buffer) i)
          for new = (copy-ir-var var)
          do (setf (ir-var-owner new) copy (ir-var-lowering new) nil
                   (ir-var-flags new) (logandc2 (ir-var-flags new) 6)
                   (gethash var variables) new)
             (ir-push new (ir-fun-vars copy)))
    (labels ((variable (var)
               (or (gethash var variables)
                   (and (find var (ir-fun-free fun) :test #'eq) var)
                   (ir-error "Unmapped specialization variable")))
             (nodes (vector) (map 'simple-vector #'node vector))
             (node (old)
               (let ((new (copy-ir-node old)))
                 (setf (ir-node-type new) t (ir-node-mark new) 0)
                 (case (ir-node-kind old)
                   (1 (setf (ir-node-a new) (variable (ir-node-a old)) (ir-node-c new) nil))
                   (2 (setf (ir-node-a new) (variable (ir-node-a old))
                            (ir-node-b new) (node (ir-node-b old))))
                   ((4 23) (setf (ir-node-b new) (node (ir-node-b old))))
                   (7 (when (ir-node-p (ir-node-a old)) (setf (ir-node-a new) (node (ir-node-a old))))
                      (setf (ir-node-b new) (nodes (ir-node-b old))))
                   ((8 10) (setf (ir-node-a new) (nodes (ir-node-a old))))
                   ((9 25) (setf (ir-node-a new) (node (ir-node-a old))
                                 (ir-node-b new) (node (ir-node-b old))
                                 (ir-node-c new) (node (ir-node-c old))))
                   (11 (setf (ir-node-a new) (map 'simple-vector #'variable (ir-node-a old))
                             (ir-node-b new) (nodes (ir-node-b old))
                             (ir-node-c new) (node (ir-node-c old))))
                   (12 (setf (ir-node-b new) (node (ir-node-b old))
                             (ir-node-c new) (node (ir-node-c old))))
                   (21 (setf (ir-node-a new) (node (ir-node-a old))
                             (ir-node-b new) (nodes (ir-node-b old))))
                   (22 (setf (ir-node-a new) (node (ir-node-a old))
                             (ir-node-b new) (node (ir-node-b old)))))
                 new)))
      (setf (ir-fun-lambda-list copy)
            (make-ir-lambda-list :required (map 'simple-vector #'variable
                                              (ir-lambda-list-required (ir-fun-lambda-list fun))))
            (ir-fun-body copy) (node (ir-fun-body fun))))
    copy))

(defun specialize-ir-calls (root)
  (let ((costs (make-hash-table :test #'eq)) (growth (make-hash-table :test #'eq))
        (seen (make-hash-table :test #'eq)) (cloned (make-hash-table :test #'eq)) (changed nil))
    (labels ((function-tree (fun)
               (unless (gethash fun seen)
                 (setf (gethash fun seen) t)
                 (ir-map-function (lambda (node) (visit node fun)) fun)))
             (visit (node owner)
               (case (ir-node-kind node)
                 ((6 7)
                  (let ((callee (ir-node-a node)))
                    (when (and (= (ir-node-kind node) 7) (ir-fun-p callee)
                               (not (eq (ir-node-d node) :notinline)))
                      (let* ((cost (multiple-value-bind (cost found) (gethash callee costs)
                                     (if found cost (setf (gethash callee costs) (ir-specialization-cost callee)))))
                             (args (ir-node-b node)) (inputs (ir-fun-input-types callee)))
                        (when (and cost inputs (= (length args) (length inputs))
                                   (<= (+ cost (gethash owner growth 0)) 128)
                                   (or (<= cost 4)
                                       (and (plusp (length (ir-fun-free callee))) (<= cost 8))
                                       (loop for arg across args for input across inputs
                                             for actual = (ir-node-type arg)
                                             thereis (and (not (eq actual t)) (not (equal actual input))
                                                          (or (eq input t) (ir-known-subtype-p actual input))))))
                          (setf (ir-node-a node) (ir-copy-specialization callee owner node)
                                (gethash owner growth) (+ cost (gethash owner growth 0))
                                (gethash callee cloned) t changed t)
                          (decf (ir-fun-calls callee)))))
                    (cond ((ir-node-p callee) (visit callee owner))
                          ((and (ir-own-function node) (eq callee (ir-node-a node))) (function-tree callee))))
                  (when (= (ir-node-kind node) 7)
                    (loop for arg across (ir-node-b node) do (visit arg owner))))
                 (13 (loop for fun across (ir-node-a node) do (function-tree fun))
                     (visit (ir-node-b node) owner)
                     (setf (ir-node-a node)
                           (remove-if (lambda (fun) (and (gethash fun cloned) (zerop (ir-fun-calls fun))
                                                        (zerop (ir-fun-value-refs fun))))
                                      (ir-node-a node))))
                 (24 (function-tree (ir-node-a node)))
                 (otherwise (ir-map-children (lambda (child) (visit child owner)) node)))))
      (function-tree root))
    changed))

(defun scalar-replace-ir-conses (root)
  "Replace field-only conses that are dead at every intervening call.
Backward liveness preserves objects that a debugger could observe at a safepoint."
  (let ((changed nil) (seen (make-hash-table :test #'eq)))
    (labels ((function-tree (fun)
               (unless (gethash fun seen)
                 (setf (gethash fun seen) t)
                 (let ((budget 4096) (removed nil))
                   (labels ((candidate (node index)
                              (let* ((var (svref (ir-node-a node) index))
                                     (init (svref (ir-node-b node) index))
                                     (rewrites nil) (steps 0) (aliases nil) (alias-lets nil) (exits nil) (truncated nil))
                                (unless (and (= (ir-node-kind init) 7) (eq (ir-node-a init) 'cons)
                                             (= (length (ir-node-b init)) 2)
                                             (not (eq (ir-node-d init) :notinline))
                                             (not (logtest 7 (ir-var-flags var)))
                                             (or (eq (ir-var-type var) t)
                                                 (ir-declaration-proven-p 'cons (ir-var-type var))))
                                  (return-from candidate nil))
                                (setf aliases (list var))
                                (block proof
                                  (labels ((fail () (return-from proof nil))
                                           (many (nodes needed)
                                             (loop for i downfrom (1- (length nodes)) to 0
                                                   do (setf needed (walk (svref nodes i) needed)))
                                             needed)
                                           (sequence (form needed discarded)
                                             (let* ((nodes (ir-node-a form))
                                                    (end (loop for i below (length nodes)
                                                               do (when (or (> (incf steps) 256) (minusp (decf budget))) (fail))
                                                               when (= (ir-node-kind (svref nodes i)) 15) return i
                                                               finally (return (1- (length nodes))))))
                                               (when (< end (1- (length nodes))) (push (cons form (1+ end)) truncated))
                                               (loop for i downfrom end to 0
                                                     do (setf needed (walk (svref nodes i) needed
                                                                           (or discarded (< i end))))))
                                             needed)
                                           (walk (form needed &optional discarded)
                                             (when (or (> (incf steps) 256) (minusp (decf budget))) (fail))
                                             (case (ir-node-kind form)
                                               ((0 5) needed)
                                               (1 (when (or (member (ir-node-a form) aliases :test #'eq)
                                                            (and needed (or (ir-node-c form)
                                                                            (eq (ir-node-type form) 'double-float)))) (fail)) needed)
                                               (2
                                                (let ((target (ir-node-a form)) (value (ir-node-b form)))
                                                  (when (or (member target aliases :test #'eq)
                                                            (and needed
                                                                 (or (logtest 6 (ir-var-flags target))
                                                                     (eq (ir-declaration-type (ir-var-type target)) 'double-float)
                                                                     (and (not (eq (ir-var-type target) t))
                                                                          (not (ir-declaration-proven-p (ir-node-type value) (ir-var-type target)))))))
                                                    (fail))
                                                  (walk value needed)))
                                               (7
                                                (let ((args (ir-node-b form)))
                                                  (cond
                                                    ((and discarded (member (ir-node-a form) '(rplaca rplacd))
                                                          (= (length args) 2)
                                                          (= (ir-node-kind (svref args 0)) 1)
                                                          (member (ir-node-a (svref args 0)) aliases :test #'eq)
                                                          (not (ir-node-c (svref args 0)))
                                                          (not (eq (ir-node-d form) :notinline)))
                                                     (push (list form (if (eq (ir-node-a form) 'rplaca) 0 1) (svref args 1)) rewrites)
                                                     (walk (svref args 1) t))
                                                    ((and (member (ir-node-a form) '(car cdr)) (= (length args) 1)
                                                           (= (ir-node-kind (svref args 0)) 1)
                                                           (member (ir-node-a (svref args 0)) aliases :test #'eq)
                                                           (not (ir-node-c (svref args 0)))
                                                           (not (eq (ir-node-d form) :notinline)))
                                                     (push (list form (if (eq (ir-node-a form) 'car) 0 1)) rewrites) t)
                                                    (t
                                                        (when needed (fail))
                                                        (setf needed (many args needed))
                                                        (when (and needed (ir-own-function form)
                                                                   (plusp (length (ir-fun-free (ir-node-a form))))) (fail))
                                                        (if (ir-node-p (ir-node-a form))
                                                            (walk (ir-node-a form) needed) needed)))))
                                               (9 (let ((yes (walk (ir-node-b form) needed discarded))
                                                        (no (walk (ir-node-c form) needed discarded)))
                                                    (walk (ir-node-a form) (or yes no))))
                                               (10 (sequence form needed discarded))
                                               (11
                                                (when (ir-node-d form) (fail))
                                                (let ((bindings (ir-node-a form)) (values (ir-node-b form))
                                                      (new nil))
                                                  (loop for binding across bindings for value across values
                                                        do (when (or (> (incf steps) 256) (minusp (decf budget))) (fail))
                                                           (when (and (= (ir-node-kind value) 1)
                                                                      (member (ir-node-a value) aliases :test #'eq)
                                                                      (not (ir-node-c value))
                                                                      (not (logtest 7 (ir-var-flags binding)))
                                                                      (or (eq (ir-var-type binding) t)
                                                                          (ir-declaration-proven-p 'cons (ir-var-type binding))))
                                                             (push binding new)))
                                                  (when new
                                                    (push (cons form new) alias-lets)
                                                    (setf aliases (append new aliases)))
                                                  (setf needed (walk (ir-node-c form) needed discarded))
                                                  (when needed
                                                    (loop for binding across bindings for value across values
                                                          unless (member binding new :test #'eq)
                                                          do (when (or (logtest 4 (ir-var-flags binding))
                                                                       (and (not (eq (ir-var-type binding) t))
                                                                            (not (ir-declaration-proven-p (ir-node-type value) (ir-var-type binding)))))
                                                               (fail))))
                                                  (loop for i downfrom (1- (length values)) to 0
                                                        unless (member (svref bindings i) new :test #'eq)
                                                        do (setf needed (walk (svref values i) needed)))
                                                  needed))
                                               (14
                                                (let ((exit (ir-node-a form)))
                                                  (when (logtest 1 (ir-exit-flags exit)) (fail))
                                                  (push (list exit needed discarded) exits)
                                                  (prog1 (walk (ir-node-b form) needed discarded)
                                                    (pop exits))))
                                               (15
                                                (let* ((exit (ir-node-a form))
                                                       (target (assoc exit exits :test #'eq)))
                                                  (when (or (logtest 1 (ir-exit-flags exit))
                                                            (not (eq (ir-exit-owner exit) fun))) (fail))
                                                  (walk (ir-node-b form) (second target) (third target))))
                                               (otherwise (fail)))))
                                    (let ((needed (walk (ir-node-c node) nil)))
                                      (when needed
                                        (loop for binding across (ir-node-a node)
                                              for value across (ir-node-b node)
                                              do (when (or (logtest 4 (ir-var-flags binding))
                                                           (and (not (eq (ir-var-type binding) t))
                                                                (not (ir-declaration-proven-p (ir-node-type value) (ir-var-type binding)))))
                                                   (fail)))
                                        (loop for i downfrom (1- (length (ir-node-b node))) above index
                                              do (setf needed (walk (svref (ir-node-b node) i) needed))))))
                                  (let* ((fields (vector (make-ir-var :name (gensym "CAR") :owner fun)
                                                         (make-ir-var :name (gensym "CDR") :owner fun)))
                                         (vars (ir-node-a node)) (inits (ir-node-b node))
                                         (buffer (ir-fun-vars fun)))
                                    (dolist (rewrite rewrites)
                                      (let ((field (svref fields (second rewrite))) (read (first rewrite))
                                            (value (third rewrite)))
                                        (incf (ir-var-refs field))
                                        (when value (setf (ir-var-flags field) (logior 1 (ir-var-flags field))))
                                        (setf (ir-node-kind read) (if value 2 1) (ir-node-a read) field
                                              (ir-node-b read) value (ir-node-c read) nil (ir-node-d read) nil)))
                                    (dolist (entry truncated)
                                      (setf (ir-node-a (car entry)) (subseq (ir-node-a (car entry)) 0 (cdr entry))))
                                    (dolist (entry alias-lets)
                                      (let* ((binding-node (car entry)) (discard (cdr entry))
                                             (bindings (ir-node-a binding-node)) (values (ir-node-b binding-node))
                                             (keep (loop for i below (length bindings)
                                                         unless (member (svref bindings i) discard :test #'eq) collect i)))
                                        (setf (ir-node-a binding-node) (map 'simple-vector (lambda (i) (svref bindings i)) keep)
                                              (ir-node-b binding-node) (map 'simple-vector (lambda (i) (svref values i)) keep))
                                        (dolist (alias discard)
                                          (setf (ir-var-refs alias) 0
                                                (gethash alias (or removed (setf removed (make-hash-table :test #'eq)))) t))))
                                    (setf (ir-node-a node) (concatenate 'simple-vector (subseq vars 0 index) fields (subseq vars (1+ index)))
                                          (ir-node-b node) (concatenate 'simple-vector (subseq inits 0 index) (ir-node-b init) (subseq inits (1+ index))))
                                    (setf (ir-var-refs var) 0
                                          (gethash var (or removed (setf removed (make-hash-table :test #'eq)))) t)
                                    (loop for field across fields do (ir-push field buffer))
                                    (setf changed t)
                                    t))))
                            (visit (node)
                              (case (ir-node-kind node)
                                (11 (unless (ir-node-d node)
                                      (loop for index downfrom (1- (length (ir-node-a node))) to 0
                                            while (plusp budget) do (candidate node index)))
                                    (ir-map-children #'visit node))
                                (13 (loop for nested across (ir-node-a node) do (function-tree nested))
                                    (visit (ir-node-b node)))
                                ((6 7) (let ((nested (ir-own-function node))) (when nested (function-tree nested)))
                                       (when (= (ir-node-kind node) 7)
                                         (when (ir-node-p (ir-node-a node)) (visit (ir-node-a node)))
                                         (loop for arg across (ir-node-b node) do (visit arg))))
                                (24 (function-tree (ir-node-a node)))
                                (otherwise (ir-map-children #'visit node)))))
                     (ir-map-function #'visit fun))
                   (when removed
                     (let* ((buffer (ir-fun-vars fun)) (data (ir-buffer-data buffer))
                            (old (ir-buffer-count buffer)) (write 0))
                       (loop for i below old for var = (svref data i)
                             unless (gethash var removed) do (setf (svref data write) var) (incf write))
                       (loop for i from write below old do (setf (svref data i) nil))
                       (setf (ir-buffer-count buffer) write)))))))
      (function-tree root))
