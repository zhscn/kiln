(in-package #:kiln.kir)

;;;; A copied primary value and count do not identify the transfer-area
;;;; borrow after a join. Associate each explicit result pair with a view,
;;;; then rename that view when the pair moves to a common destination.

(defun lir-pair-view (state primary count)
  (unless (eq (gethash count (lir-function-types state)) :word)
    (lir-function-error state "result count is not a machine-word variable: ~S" count))
  (multiple-value-bind (old found) (gethash count (lir-function-view-primaries state))
    (when (and found (not (equalp old primary)))
      (lir-function-error state "count ~S belongs to different primary variables" count)))
  (setf (gethash count (lir-function-view-primaries state)) primary)
  (or (gethash count (lir-function-views state))
      (setf (gethash count (lir-function-views state)) (lir-new-temporary state :mv))))

(defun lir-record-alias (state variable value)
  (multiple-value-bind (old found) (gethash variable (lir-function-value-aliases state))
    (declare (ignore old))
    (setf (gethash variable (lir-function-value-aliases state))
          (if (and (not found) (or (gethash value (lir-function-types state)) (eq value :self))) value :unknown))))

(defun lir-scan-value-statement (state statement)
  (case (first statement)
    (:set (lir-record-alias state (second statement) (third statement)))
    ((:move-values :invoke :invoke-known :invoke-list :numeric-op :list-values :restore-values :landed-values)
     (lir-pair-view state (second statement) (third statement))
     (lir-record-alias state (second statement) :unknown)
     (lir-record-word-write state (third statement) :unknown))
    ((:fixnum-add-ovf :fixnum-sub-ovf :fixnum-mul-ovf :guarded-class-test :special-ref :alloc-fixed :alloc-vector :alloc-vector-elements :alloc-structure :stack-cons :rest-list)
     (lir-record-alias state (second statement) :unknown))))

(defun lir-primary-alias-p (state value primary)
  (let ((seen (make-hash-table :test 'equalp)))
    (loop
      (when (equalp value primary) (return t))
      (when (gethash value seen) (return nil))
      (setf (gethash value seen) t)
      (let ((alias (gethash value (lir-function-value-aliases state))))
        (unless (and alias (not (eq alias :unknown))) (return nil))
        (setf value alias)))))

(defun lir-view-for-values (state primary count)
  (cond ((and (integerp count) (<= 0 count 1))
         (let* ((arguments (when (= count 1) (list (lir-operand state primary :obj))))
                (view (lir-new-temporary state :mv)))
           (lir-emit state `(:values ,view ,arguments))
           (setf (lir-function-active-view state) view (lir-function-active-count state) count)
           view))
        ((integerp count)
         (unless (and (lir-function-active-view state) (eql count (lir-function-active-count state)))
           (lir-function-error state "fixed multiple values have no current publication"))
         (lir-function-active-view state))
        (t
         (let ((view (gethash count (lir-function-views state)))
               (expected (gethash count (lir-function-view-primaries state))))
           (unless view (lir-function-error state "result pair has no multi-value view for count ~S" count))
           (unless (lir-primary-alias-p state primary expected)
             (lir-function-error state "primary ~S does not belong to count ~S" primary count))
           view))))

(defun lir-bind-result-pair (state primary count view)
  (lir-emit state `(:set ,primary (:mv-ref ,view 0)))
  (lir-emit state `(:set ,count (:mv-count ,view)))
  (setf (lir-function-active-view state) view (lir-function-active-count state) nil))

(defun lir-move-result (state result count primary number)
  (let ((source (lir-view-for-values state primary number))
        (target (gethash count (lir-function-views state))))
    (unless target (lir-function-error state "missing result view for ~S" count))
    (lir-emit state `(:mv-move ,target ,source))
    (lir-bind-result-pair state result count target)))

(defun lir-condition-view (state expression)
  (when (and (consp expression) (member (first expression) '(:gt :ge :lt :le :eq :ne)))
    (gethash (second expression) (lir-function-views state))))

(defun lir-call-statement (state statement)
  (let* ((op (first statement)) (args (rest statement))
         (primary (first args)) (count (second args))
         (view (gethash count (lir-function-views state))))
    (ecase op
      ((:invoke :invoke-known)
       (let* ((known (eq op :invoke-known))
              (callee (nth (if known 3 2) args)) (arguments (nth (if known 4 3) args))
              (handler (nth (if known 5 4) args)) (location (nthcdr (if known 6 5) args)))
         (lir-check-handler state handler)
         (lir-emit state `(,(if known :call-known :call) ,view ,@(and known (list (third args)))
                           ,(lir-operand state callee :obj)
                           ,(mapcar (lambda (argument) (lir-operand state argument :obj)) arguments)
                           ,@(lir-handler-options state handler) ,@location))))
      (:invoke-list
       (lir-check-handler state (sixth args))
       (lir-emit state `(:call-spread ,view ,(lir-operand state (third args) :obj)
                           ,(mapcar (lambda (argument) (lir-operand state argument :obj)) (fourth args))
                           ,(lir-operand state (fifth args) :obj)
                           ,@(lir-handler-options state (sixth args)) ,@(nthcdr 6 args))))
      (:numeric-op
       (lir-check-handler state (fifth args))
       (lir-emit state `(:numeric ,view ,(third args)
                          ,(mapcar (lambda (argument) (lir-operand state argument :obj)) (fourth args))
                          ,@(lir-handler-options state (fifth args)) ,@(nthcdr 5 args)))))
    (lir-bind-result-pair state primary count view)))

(defun lir-value-statement (state statement)
  (let ((op (first statement)) (args (rest statement)))
    (ecase op
      (:move-values (apply #'lir-move-result state args))
      (:publish-values
       (let ((arguments (mapcar (lambda (argument) (lir-operand state argument :obj)) (first args)))
             (view (lir-new-temporary state :mv)))
         (lir-emit state `(:values ,view ,arguments))
         (setf (lir-function-active-view state) view
               (lir-function-active-count state) (length arguments))))
      ((:save-values :values-list :push-values)
       (lir-check-handler state (nth (if (eq op :push-values) 4 3) args))
       (let ((view (lir-view-for-values state (second args) (third args))))
         (lir-emit state (if (eq op :push-values)
                            `(:mv-push ,(first args) ,view ,(lir-operand state (fourth args) :obj))
                            `(:mv-save ,(first args) ,view)))
         (setf (lir-function-active-view state) nil (lir-function-active-count state) nil)))
      ((:list-values :restore-values)
       (lir-check-handler state (nth (if (eq op :list-values) 3 4) args))
       (let ((view (gethash (second args) (lir-function-views state))))
         (lir-emit state `(,(if (eq op :list-values) :values-from-list :mv-restore)
                           ,view ,(lir-operand state (third args) :obj)))
         (lir-bind-result-pair state (first args) (second args) view))))))
