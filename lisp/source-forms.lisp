;;;; Compact source graphs retain identities without materializing every form
;;;; in a loaded image. Unknown literal objects remain ordinary module literals.
(in-package #:kiln.compiler)

(defun encode-source-form (form &optional canonical-gensyms)
  (let ((*uninterned-symbols* (when canonical-gensyms (make-compiler-eq-table)))
        (*uninterned-count* 0)
        (ids (make-compiler-eq-table)) (next 0) (literals nil)
        (buffer (make-string 256)) (position 0) (capacity 256))
    (declare (simple-string buffer) (fixnum position capacity))
    (labels ((octet (value)
               (when (= position capacity)
                 (let ((larger (make-string (* 2 capacity))))
                   (replace larger buffer)
                   (setf buffer larger capacity (* 2 capacity))))
               (setf (schar buffer position) (code-char value))
               (incf position))
             (uint (value)
               (loop while (>= value 128)
                     do (octet (logior 128 (logand value 127)))
                        (setf value (ash value -7)))
               (octet value))
             (text (value)
               (uint (length value))
               (loop for char across value do (uint (char-code char))))
             (walk (value)
               (cond
                 ((null value) (uint 0))
                 ((eq value t) (uint 14))
                 ((integerp value)
                  (uint 7) (uint (if (minusp value) (1- (* -2 value)) (* 2 value))))
                 ((characterp value) (uint 8) (uint (char-code value)))
                 ((typep value 'single-float) (uint 9) (uint (single-float-bits value)))
                 ((typep value 'double-float)
                  (uint 10) (uint (double-float-high-bits value)) (uint (double-float-low-bits value)))
                 ((rationalp value) (uint 11) (walk (numerator value)) (walk (denominator value)))
                 ((complexp value) (uint 12) (walk (realpart value)) (walk (imagpart value)))
                 (t
                  (multiple-value-bind (id found) (compiler-eq-ref ids value)
                    (if found (progn (uint 1) (uint id))
                        (let ((id (prog1 next (incf next))))
                          (setf (compiler-eq-ref ids value) id)
                          (cond
                            ((consp value) (uint 2) (uint id) (walk (car value)) (walk (cdr value)))
                            ((symbolp value)
                             (uint (if (symbol-package value) 3 4)) (uint id)
                             (when (symbol-package value) (text (target-package-name (symbol-package value))))
                             (text (module-symbol-name value)))
                            ((stringp value) (uint 5) (uint id) (text value))
                            ((typep value 'simple-vector)
                             (uint 6) (uint id) (uint (length value))
                             (loop for item across value do (walk item)))
                            (t (uint 13) (uint id) (uint (length literals)) (push value literals))))))))))
      (walk form))
    (list :encoded-form (subseq buffer 0 position) (coerce (nreverse literals) 'simple-vector))))

(defun decode-source-form (encoded)
  (unless (and (consp encoded) (eq (car encoded) :encoded-form))
    (return-from decode-source-form encoded))
  (let ((bytes (second encoded)) (literals (third encoded)) (position 0)
        (objects (make-hash-table)))
    (labels ((uint ()
               (loop for shift from 0 by 7
                     for byte = (prog1 (char-code (char bytes position)) (incf position))
                     sum (ash (logand byte 127) shift) into value
                     when (< byte 128) return value))
             (text ()
               (let ((string (make-string (uint))))
                 (dotimes (i (length string) string) (setf (char string i) (code-char (uint))))))
             (walk ()
               (case (uint)
                 (0 nil) (14 t)
                 (1 (gethash (uint) objects))
                 (2 (let* ((id (uint)) (cell (cons nil nil)))
                      (setf (gethash id objects) cell (car cell) (walk) (cdr cell) (walk)) cell))
                 (3 (let* ((id (uint)) (package (text)) (name (text)))
                      (setf (gethash id objects)
                            (intern name (or (find-package package)
                                             (error "Missing source package ~S" package))))))
                 (4 (let ((id (uint))) (setf (gethash id objects) (make-symbol (text)))))
                 (5 (let ((id (uint))) (setf (gethash id objects) (text))))
                 (6 (let* ((id (uint)) (vector (make-array (uint))))
                      (setf (gethash id objects) vector)
                      (dotimes (i (length vector) vector) (setf (svref vector i) (walk)))))
                 (7 (let ((n (uint))) (if (oddp n) (- (ash (1+ n) -1)) (ash n -1))))
                 (8 (code-char (uint)))
                 (9 (let ((bits (uint)))
                      #+sbcl (sb-kernel:make-single-float (if (logbitp 31 bits) (- bits #x100000000) bits))
                      #+kiln (kiln.sys:%primop :make-single-float-bits bits)))
                 (10 (let ((high (uint)) (low (uint)))
                       #+sbcl (sb-kernel:make-double-float (if (logbitp 31 high) (- high #x100000000) high) low)
                       #+kiln (kiln.sys:%primop :make-double-float-bits high low)))
                 (11 (let ((a (walk))) (/ a (walk))))
                 (12 (let ((a (walk))) (complex a (walk))))
                 (13 (let ((id (uint))) (setf (gethash id objects) (svref literals (uint)))))
                 (otherwise (error "Invalid source graph encoding")))))
      (walk))))

(defun source-form-equal-p (a b)
  (let ((left (if (and (consp a) (eq (car a) :encoded-form)) a (encode-source-form a)))
        (right (if (and (consp b) (eq (car b) :encoded-form)) b (encode-source-form b))))
    (and (string= (second left) (second right))
         (= (length (third left)) (length (third right)))
         (every #'eq (third left) (third right)))))

(defun canonical-definition-references (form keys calls)
  "Order persisted references without changing the query collectors."
  (let ((ranks nil) (next 0))
    (labels ((name-symbol (name) (if (consp name) (second name) name))
             (want (name)
               (let ((symbol (name-symbol name)))
                 (unless (symbol-package symbol)
                   (unless ranks (setf ranks (make-hash-table :test 'eq)))
                   (setf (gethash symbol ranks) 0))))
             (rank (name)
               (let ((symbol (name-symbol name)))
                 (when (and ranks (not (symbol-package symbol)) (zerop (gethash symbol ranks 0)))
                   (setf (gethash symbol ranks) (incf next)))))
             (name-order (left right)
               (let* ((left-symbol (name-symbol left)) (right-symbol (name-symbol right))
                      (left-package (symbol-package left-symbol))
                      (right-package (symbol-package right-symbol))
                      (order
                        (cond
                          ((and left-package right-package)
                           (let ((a (target-package-name left-package)) (b (target-package-name right-package)))
                             (cond ((string< a b) -1) ((string< b a) 1)
                                   ((string< (symbol-name left-symbol) (symbol-name right-symbol)) -1)
                                   ((string< (symbol-name right-symbol) (symbol-name left-symbol)) 1)
                                   (t 0))))
                          (left-package -1) (right-package 1)
                          ((< (gethash left-symbol ranks) (gethash right-symbol ranks)) -1)
                          ((> (gethash left-symbol ranks) (gethash right-symbol ranks)) 1)
                          (t 0))))
                 (cond ((not (zerop order)) order)
                       ((and (not (consp left)) (consp right)) -1)
                       ((and (consp left) (not (consp right))) 1)
                       (t 0)))))
      (dolist (key keys) (want (first key)) (want (second key)))
      (dolist (call calls) (want call))
      (when ranks
        ;; Source identity, rather than a host gensym counter, orders private
        ;; names. Opaque names not present in the source retain first-use order.
        (let ((work (list form)) (seen (make-hash-table :test 'eq)))
          (loop while work for node = (pop work) do
            (cond ((symbolp node)
                   (when (and (gethash node ranks) (zerop (gethash node ranks))) (rank node)))
                  ((and (or (consp node) (typep node 'simple-vector)) (not (gethash node seen)))
                   (setf (gethash node seen) t)
                   (if (consp node)
                       (progn (push (cdr node) work) (push (car node) work))
                       (loop for index downfrom (1- (length node)) to 0 do (push (svref node index) work)))))))
        (dolist (key keys) (rank (first key)) (rank (second key)))
        (dolist (call calls) (rank call)))
      (values (stable-sort (copy-list keys)
                           (lambda (left right)
                             (let ((order (name-order (first left) (first right))))
                               (if (zerop order)
                                   (minusp (name-order (second left) (second right)))
                                   (minusp order)))))
              (stable-sort (copy-list calls) (lambda (left right) (minusp (name-order left right))))))))
