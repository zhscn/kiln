;;;; Compact source graphs retain identities without materializing every form
;;;; in a loaded image. Unknown literal objects remain ordinary module literals.
(in-package #:kiln.compiler)

(defun encode-source-form (form &optional canonical-gensyms)
  (let ((*uninterned-symbols* (when canonical-gensyms (make-hash-table :test 'eq)))
        (*uninterned-count* 0)
        (ids (make-hash-table :test 'eq)) (next 0) (literals nil))
    (list :encoded-form
          (with-output-to-string (stream)
            (labels ((uint (value)
                       (loop while (>= value 128)
                             do (write-char (code-char (logior 128 (logand value 127))) stream)
                                (setf value (ash value -7)))
                       (write-char (code-char value) stream))
                     (text (value)
                       (uint (length value))
                       (loop for char across value do (uint (char-code char))))
                     (walk (value)
                       (cond
                         ((null value) (uint 0))
                         ((eq value t) (uint 14))
                         ((integerp value)
                          (uint 7) (uint (if (minusp value) (1- (* -2 value)) (* 2 value))))
                         ((characterp value) (uint 8) (uint (char-code value)))
                         ((typep value 'single-float) (uint 9) (uint (single-float-bits value)))
                         ((typep value 'double-float)
                          (uint 10) (uint (double-float-high-bits value)) (uint (double-float-low-bits value)))
                         ((rationalp value) (uint 11) (walk (numerator value)) (walk (denominator value)))
                         ((complexp value) (uint 12) (walk (realpart value)) (walk (imagpart value)))
                         (t
                          (multiple-value-bind (id found) (gethash value ids)
                            (if found (progn (uint 1) (uint id))
                                (let ((id (prog1 next (incf next))))
                                  (setf (gethash value ids) id)
                                  (cond
                                    ((consp value) (uint 2) (uint id) (walk (car value)) (walk (cdr value)))
                                    ((symbolp value)
                                     (uint (if (symbol-package value) 3 4)) (uint id)
                                     (when (symbol-package value) (text (target-package-name (symbol-package value))))
                                     (text (module-symbol-name value)))
                                    ((stringp value) (uint 5) (uint id) (text value))
                                    ((typep value 'simple-vector)
                                     (uint 6) (uint id) (uint (length value))
                                     (loop for item across value do (walk item)))
                                    (t (uint 13) (uint id) (uint (length literals)) (push value literals))))))))))
              (walk form)))
          (coerce (nreverse literals) 'simple-vector))))

(defun decode-source-form (encoded)
  (unless (and (consp encoded) (eq (car encoded) :encoded-form))
    (return-from decode-source-form encoded))
  (let ((bytes (second encoded)) (literals (third encoded)) (position 0)
        (objects (make-hash-table)))
    (labels ((uint ()
               (loop for shift from 0 by 7
                     for byte = (prog1 (char-code (char bytes position)) (incf position))
                     sum (ash (logand byte 127) shift) into value
                     when (< byte 128) return value))
             (text ()
               (let ((string (make-string (uint))))
                 (dotimes (i (length string) string) (setf (char string i) (code-char (uint))))))
             (walk ()
               (case (uint)
                 (0 nil) (14 t)
                 (1 (gethash (uint) objects))
                 (2 (let* ((id (uint)) (cell (cons nil nil)))
                      (setf (gethash id objects) cell (car cell) (walk) (cdr cell) (walk)) cell))
                 (3 (let* ((id (uint)) (package (text)) (name (text)))
                      (setf (gethash id objects)
                            (intern name (or (find-package package)
                                             (error "Missing source package ~S" package))))))
                 (4 (let ((id (uint))) (setf (gethash id objects) (make-symbol (text)))))
                 (5 (let ((id (uint))) (setf (gethash id objects) (text))))
                 (6 (let* ((id (uint)) (vector (make-array (uint))))
                      (setf (gethash id objects) vector)
                      (dotimes (i (length vector) vector) (setf (svref vector i) (walk)))))
                 (7 (let ((n (uint))) (if (oddp n) (- (ash (1+ n) -1)) (ash n -1))))
                 (8 (code-char (uint)))
                 (9 (let ((bits (uint)))
                      #+sbcl (sb-kernel:make-single-float (if (logbitp 31 bits) (- bits #x100000000) bits))
                      #+kiln (kiln.sys:%primop :make-single-float-bits bits)))
                 (10 (let ((high (uint)) (low (uint)))
                       #+sbcl (sb-kernel:make-double-float (if (logbitp 31 high) (- high #x100000000) high) low)
                       #+kiln (kiln.sys:%primop :make-double-float-bits high low)))
                 (11 (let ((a (walk))) (/ a (walk))))
                 (12 (let ((a (walk))) (complex a (walk))))
                 (13 (let ((id (uint))) (setf (gethash id objects) (svref literals (uint)))))
                 (otherwise (error "Invalid source graph encoding")))))
      (walk))))

(defun source-form-equal-p (a b)
  (let ((left (if (and (consp a) (eq (car a) :encoded-form)) a (encode-source-form a)))
        (right (if (and (consp b) (eq (car b) :encoded-form)) b (encode-source-form b))))
    (and (string= (second left) (second right))
         (= (length (third left)) (length (third right)))
         (every #'eq (third left) (third right)))))
