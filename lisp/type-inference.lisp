(in-package #:kiln.compiler)

;;; The domain is deliberately bounded: canonical value classes and finite
;;; machine-word intervals plus unbounded nonnegative integers. T means unknown,
;;; not an assertion. Host FIXNUM
;;; bounds need not match the target's and must not determine inferred types.
(defconstant +hir-fixnum-min+ kiln.kir::+backend-fixnum-min+)
(defconstant +hir-fixnum-max+ kiln.kir::+backend-fixnum-max+)
(defconstant +hir-bound-min+ (- (ash 1 63)))
(defconstant +hir-bound-max+ (1- (ash 1 63)))
(defconstant +hir-vector-max-length+ #xffffffff)

(defun hir-integer-range (low high)
  (if (and (<= +hir-bound-min+ low) (<= high +hir-bound-max+))
      (list 'integer low high)
      (if (<= 0 low) 'unsigned-byte 'integer)))

(defun hir-range-p (type)
  (and (consp type) (eq (car type) 'integer)))

(defun hir-fixnum-type-p (type)
  (or (eq type 'fixnum)
      (and (hir-range-p type) (<= +hir-fixnum-min+ (second type))
           (<= (third type) +hir-fixnum-max+))))

(defun hir-integer-type-p (type)
  (or (eq type 'integer) (eq type 'fixnum) (eq type 'unsigned-byte) (hir-range-p type)))

(defun hir-nonnegative-integer-type-p (type)
  (or (eq type 'unsigned-byte) (and (hir-range-p type) (<= 0 (second type)))))

(defun hir-widen-integer-type (type)
  (cond ((hir-fixnum-type-p type)
         (if (hir-nonnegative-integer-type-p type)
             (hir-integer-range 0 +hir-fixnum-max+)
             'fixnum))
        ((hir-nonnegative-integer-type-p type) 'unsigned-byte)
        (t 'integer)))

(defun hir-type-range (type)
  (cond ((hir-range-p type) type)
        ((eq type 'fixnum) (hir-integer-range +hir-fixnum-min+ +hir-fixnum-max+))))

(defun hir-constant-right-shift (type)
  (when (and (hir-range-p type) (= (second type) (third type)) (<= (third type) 0))
    ;; A signed word has already reached its sign bit by this count.
    (min 63 (- (third type)))))

(defun hir-simple-specialized-array-p (type)
  (and (consp type) (eq (car type) :simple-specialized-array)))

(defun hir-simple-specialized-vector-p (type)
  (and (hir-simple-specialized-array-p type)
       (consp (third type)) (null (cdr (third type)))))

(defun hir-fixed-array-dimension (type axis)
  (when (and (hir-simple-specialized-array-p type)
             (hir-range-p axis)
             (= (second axis) (third axis))
             (listp (third type))
             (<= 0 (second axis))
             (< (second axis) (length (third type))))
    (let ((dimension (nth (second axis) (third type))))
      (when (integerp dimension) dimension))))

(defun hir-specialized-element-type (specifier)
  (cond ((member specifier '(single-float double-float fixnum)) specifier)
        ((and (consp specifier) (member (car specifier) '(unsigned-byte signed-byte))
              (member specifier kiln.sys::*array-element-type-upgrades* :test #'equal))
         (multiple-value-bind (low high bounded) (type-fixnum-bounds specifier)
           (when bounded (hir-integer-range low high))))))

(defun hir-upgraded-literal-element-type (specifier)
  (if (hir-specialized-element-type specifier)
      specifier
      (multiple-value-bind (low high bounded) (type-fixnum-bounds specifier)
        (when (and bounded (<= low high))
          (dolist (candidate kiln.sys::*array-element-type-upgrades*)
            (multiple-value-bind (minimum maximum supported) (type-fixnum-bounds candidate)
              (when (and supported (<= minimum low high maximum))
                (return (and (hir-specialized-element-type candidate) candidate)))))))))

(defun hir-array-dimensions-subtype-p (actual required)
  (or (eq required '*)
      (equal actual required)
      (and (listp actual) (listp required)
           (= (length actual) (length required))
           (every (lambda (a b) (or (eq b '*) (eql a b))) actual required))))


(defun hir-type-join (a b)
  (cond ((equal a b) a)
        ((and (hir-range-p a) (hir-range-p b))
         (hir-integer-range (min (second a) (second b)) (max (third a) (third b))))
        ((and (hir-nonnegative-integer-type-p a) (hir-nonnegative-integer-type-p b)) 'unsigned-byte)
        ((and (hir-fixnum-type-p a) (hir-fixnum-type-p b)) 'fixnum)
        ((and (hir-integer-type-p a)
              (hir-integer-type-p b)) 'integer)
        ((and (member a '(null symbol)) (member b '(null symbol))) 'symbol)
        (t t)))

(defun hir-constant-type (value)
  (cond ((integerp value) (hir-integer-range value value))
        ((null value) 'null)
        ((symbolp value) 'symbol)
        ((consp value) 'cons)
        ((characterp value) 'character)
        ((stringp value) :native-string)
        ((typep value 'simple-vector) 'simple-vector)
        ((typep value 'single-float) 'single-float)
        ((typep value 'double-float) 'double-float)
        ((rationalp value) 'rational)
        ((complexp value) 'complex)
        (t t)))

(defun hir-predicate-type (name)
  (cdr (assoc name '((kiln.kernel::fixnump . fixnum) (integerp . integer) (rationalp . rational) (realp . real)
                    (numberp . number) (floatp . float) (consp . cons)
                    (symbolp . symbol) (characterp . character)
                    (simple-vector-p . simple-vector) (stringp . string)
                    (simple-string-p . simple-string) (vectorp . vector)
                    (arrayp . array) (functionp . function) (null . null)
                    (not . null) (listp . list)))))

(defun hir-type-predicate (name type)
  "Return a predicate's result and whether it is known for TYPE."
  (when (or (eq type t) (eq type 'boolean))
    (return-from hir-type-predicate (values nil nil)))
  (let* ((class (cond ((hir-integer-type-p type) 'integer)
                      ((hir-simple-specialized-array-p type)
                       (if (and (consp (third type)) (null (cdr (third type))))
                           :simple-array-vector 'array))
                      (t type)))
         (supers
           (case class
             (integer '(integer rational real number))
             (rational '(rational real number))
             ((single-float double-float float) '(float real number))
             (real '(real number)) (number '(number)) (complex '(number))
             (null '(null symbol list)) (symbol '(symbol)) (cons '(cons list))
             (character '(character)) (function '(function))
             (simple-vector '(simple-vector vector array))
             (:simple-array-vector '(vector array))
             (:native-string '(simple-string string vector array))
             (simple-string '(simple-string string vector array))
             (string '(string vector array)) (vector '(vector array))
             (array '(array)) (list '(list))))
         (wanted (hir-predicate-type name)))
    (cond ((null wanted) (values nil nil))
          ((or (member wanted supers)
               (and (eq wanted 'fixnum) (hir-fixnum-type-p type))) (values t t))
          ((and (eq wanted 'fixnum) (eq class 'integer)) (values nil nil))
          ;; Broad classes may overlap without containment (LIST and SYMBOL
          ;; both include NIL; ARRAY includes vectors and strings).
          ((or (member class '(number real rational float array vector :simple-array-vector string simple-string list symbol))
               (and (eq wanted 'null) (eq class 'list)))
           (values nil nil))
          (t (values nil t)))))

(defun hir-positive-fixnum-constant (type)
  (when (and (hir-range-p type) (hir-fixnum-type-p type)
             (= (second type) (third type)) (plusp (second type)))
    (second type)))

(defun hir-fixnum-power-of-two-divisor (dividend divisor)
  (let ((value (hir-positive-fixnum-constant divisor)))
    (when (and value (hir-fixnum-type-p dividend)
               (zerop (logand value (1- value))))
      value)))

(defun inferred-call-type (name types)
  "Infer the primary result of a stable named function from argument types."
  (let ((count (length types)))
    (when (and (eq name 'array-dimension) (= count 2))
      (let ((dimension (hir-fixed-array-dimension (svref types 0) (svref types 1))))
        (when dimension
          (return-from inferred-call-type (hir-integer-range dimension dimension)))))
    (cond
      ((hir-predicate-type name) 'boolean)
      ((member name '(< > <= >= = /= eq eql equal equalp zerop plusp minusp evenp oddp)) 'boolean)
      ((eq name 'cons) 'cons)
      ((eq name 'list) (if (zerop count) 'null 'cons))
      ((eq name 'vector) 'simple-vector)
      ((eq name 'make-array) 'array)
      ((and (= count 2) (eq name 'ash)
            (hir-fixnum-type-p (svref types 0))
            (hir-constant-right-shift (svref types 1)))
       (let ((range (hir-type-range (svref types 0)))
             (shift (- (hir-constant-right-shift (svref types 1)))))
         (hir-integer-range (ash (second range) shift) (ash (third range) shift))))
      ((and (= count 2) (eq name 'mod) (hir-integer-type-p (svref types 0))
            (hir-positive-fixnum-constant (svref types 1)))
       (hir-integer-range 0 (1- (second (svref types 1)))))
      ((and (= count 2) (member name '(floor truncate))
            (hir-fixnum-power-of-two-divisor (svref types 0) (svref types 1)))
       (let ((range (hir-type-range (svref types 0)))
             (divisor (second (svref types 1)))
             (divide (if (eq name 'floor) #'floor #'truncate)))
         (hir-integer-range (funcall divide (second range) divisor)
                            (funcall divide (third range) divisor))))
      ((and (eq name 'identity) (= count 1)) (svref types 0))
      ((and (eq name 'length) (= count 1)
            (member (svref types 0) '(simple-vector :native-string)))
       (hir-integer-range 0 +hir-vector-max-length+))
      ((and (eq name 'length) (= count 1)
            (hir-simple-specialized-vector-p (svref types 0)))
       (let ((dimension (first (third (svref types 0)))))
         (if (integerp dimension)
             (hir-integer-range dimension dimension)
             (hir-integer-range 0 +hir-vector-max-length+))))
      ((and (>= count 1) (member name '(aref row-major-aref))
            (hir-simple-specialized-array-p (svref types 0)))
       (hir-specialized-element-type (second (svref types 0))))
      ((and (= count 2)
            (or (member name '(char schar))
                (and (member name '(aref elt)) (eq (svref types 0) :native-string))))
       'character)
      ((and (= count 3) (member name '((setf aref) (setf svref) (setf char) (setf schar) (setf elt)) :test #'equal))
       (svref types 0))
      ((and (eq name 'char-code) (= count 1)) (hir-integer-range 0 #x10ffff))
      ((eq name 'values) (if (plusp count) (svref types 0) 'null))
      ((and (eq name 'float) (= count 2)
            (member (svref types 1) '(single-float double-float)))
       (svref types 1))
      ((and (= count 1) (member name '(ffloor fceiling ftruncate fround))
            (member (svref types 0) '(single-float double-float)))
       (svref types 0))
      ((and (= count 1) (member name '(+ - * / abs 1+ 1-))
            (member (svref types 0) '(single-float double-float)))
       (svref types 0))
      ((and (= count 1) (eq name '-) (hir-integer-type-p (svref types 0)))
       (let ((range (hir-type-range (svref types 0))))
         (if range
             (hir-integer-range (- (third range)) (- (second range)))
             'integer)))
      ((and (>= count 2) (member name '(+ - * /))
            (some (lambda (type) (member type '(single-float double-float))) types)
            (every (lambda (type)
                     (or (member type '(single-float double-float rational))
                         (hir-integer-type-p type)))
                   types))
       (if (find 'double-float types) 'double-float 'single-float))
      ((and (eq name '+) (> count 2) (every #'hir-integer-type-p types))
       (let ((low 0) (high 0))
         (loop for type across types
               for range = (hir-type-range type)
               unless range
                 do (return-from inferred-call-type
                      (if (every #'hir-nonnegative-integer-type-p types) 'unsigned-byte 'integer))
               do (incf low (second range)) (incf high (third range)))
         (hir-integer-range low high)))
      ((and (member name '(+ - *)) (= count 2))
       (let* ((at (svref types 0)) (bt (svref types 1))
              (a (or (hir-type-range at) at)) (b (or (hir-type-range bt) bt)))
         (when (and (hir-range-p a) (hir-range-p b))
           (return-from inferred-call-type
             (case name
               (+ (hir-integer-range (+ (second a) (second b)) (+ (third a) (third b))))
               (- (hir-integer-range (- (second a) (third b)) (- (third a) (second b))))
               (* (let ((products (list (* (second a) (second b)) (* (second a) (third b))
                                        (* (third a) (second b)) (* (third a) (third b)))))
                    (hir-integer-range (apply #'min products) (apply #'max products)))))))
         (cond ((and (member name '(+ *))
                     (hir-nonnegative-integer-type-p a) (hir-nonnegative-integer-type-p b)) 'unsigned-byte)
               ((and (hir-integer-type-p a) (hir-integer-type-p b)) 'integer)
               (t t))))
      ((and (member name '(1+ 1-)) (= count 1))
       (let* ((actual (svref types 0)) (type (or (hir-type-range actual) actual))
              (delta (if (eq name '1+) 1 -1)))
         (cond ((hir-range-p type)
                (hir-integer-range (+ (second type) delta) (+ (third type) delta)))
               ((and (eq name '1+) (hir-nonnegative-integer-type-p type)) 'unsigned-byte)
               ((hir-integer-type-p type) 'integer)
               (t t))))
      ((and (member name '(logand logior logxor)) (= count 2))
       (let ((a (svref types 0)) (b (svref types 1)))
         (when (eq name 'logand)
           (let ((limit nil))
             (dolist (type (list a b))
               (when (and (hir-range-p type) (<= 0 (second type)))
                 (setf limit (if limit (min limit (third type)) (third type)))))
             (when limit (return-from inferred-call-type (hir-integer-range 0 limit)))))
         (cond ((and (hir-range-p a) (hir-range-p b) (<= 0 (second a)) (<= 0 (second b)))
                (hir-integer-range 0 (1- (ash 1 (max (integer-length (third a))
                                                  (integer-length (third b)))))))
               ((and (hir-integer-type-p a) (hir-integer-type-p b)
                     (if (eq name 'logand)
                         (or (hir-nonnegative-integer-type-p a) (hir-nonnegative-integer-type-p b))
                         (and (hir-nonnegative-integer-type-p a) (hir-nonnegative-integer-type-p b)))) 'unsigned-byte)
               ((and (hir-fixnum-type-p a) (hir-fixnum-type-p b)) 'fixnum)
               ((and (hir-integer-type-p a)
                     (hir-integer-type-p b)) 'integer)
               (t t))))
      (t t))))

(defun hir-type-intersection (a b)
  (cond ((eq b t) a)
        ((hir-known-subtype-p a b) a)
        ((or (and (eq a 'unsigned-byte) (hir-type-range b))
             (and (eq b 'unsigned-byte) (hir-type-range a)))
         (let ((range (hir-type-range (if (eq a 'unsigned-byte) b a))))
           (if (minusp (third range))
               b
               (hir-integer-range (max 0 (second range)) (third range)))))
        ((and (hir-range-p a) (eq b 'fixnum))
         (hir-type-intersection a (hir-integer-range +hir-fixnum-min+ +hir-fixnum-max+)))
        ((and (eq a 'fixnum) (hir-range-p b))
         (hir-type-intersection (hir-integer-range +hir-fixnum-min+ +hir-fixnum-max+) b))
        ((and (hir-range-p a) (hir-range-p b))
         (let ((low (max (second a) (second b))) (high (min (third a) (third b))))
           ;; An empty intersection has no normal return after the check.
           ;; Keep a safe overapproximation until the domain has bottom.
           (if (<= low high) (hir-integer-range low high) b)))
        (t b)))

(defun hir-declaration-check-type (type)
  "Return a discrimination type that cannot reject a valid declaration value."
  (labels ((walk (type positive)
             (cond ((and (consp type) (hir-proper-list-p type))
                    (case (car type)
                      (function (if positive 'function t))
                      ((and or)
                       (cons (if positive (car type) (if (eq (car type) 'and) 'or 'and))
                             (mapcar (lambda (part) (walk part positive)) (cdr type))))
                      (not (if (= (length type) 2) (walk (second type) (not positive)) type))
                      (cons
                       (let ((parts (mapcar (lambda (part) (if (eq part '*) part (walk part t))) (cdr type))))
                         (if positive (cons 'cons parts)
                             (if (equal parts (cdr type)) (list 'not type) t))))
                      ((array simple-array vector)
                       (if (null (cdr type)) (if positive type (list 'not type))
                           (let* ((element (second type))
                                  (checked (if (eq element '*) element (walk element t))))
                             (if positive (list* (car type) checked (cddr type))
                                 (if (equal element checked) (list 'not type) t)))))
                      (otherwise (if positive type (list 'not type)))))
                   (t (if positive type (list 'not type))))))
    (walk (hir-declaration-expanded type) t)))

(defun hir-declaration-type (specifier)
  "Project supported declarations into the value domain; T is unsupported."
  (setf specifier (hir-declaration-check-type specifier))
  (cond ((member specifier '(fixnum integer rational real number float single-float double-float
                            cons symbol character simple-vector simple-string string vector array
                            function null list)) specifier)
        ((eq specifier 'unsigned-byte) 'unsigned-byte)
        ((eq specifier 'signed-byte) 'integer)
        ((member specifier '(short-float long-float))
         (if (eq specifier 'short-float) 'single-float 'double-float))
        ((nth-value 2 (type-fixnum-bounds specifier))
         (multiple-value-bind (low high) (type-fixnum-bounds specifier)
           (hir-integer-range low high)))
        ((and (consp specifier) (hir-proper-list-p specifier))
         (case (car specifier)
           ((unsigned-byte signed-byte)
            (if (and (<= (length specifier) 2)
                     (or (null (cdr specifier)) (eq (second specifier) '*)))
                (if (eq (car specifier) 'unsigned-byte) 'unsigned-byte 'integer) t))
           (integer
            (if (and (member (length specifier) '(2 3)) (eql (second specifier) 0)
                     (or (= (length specifier) 2) (eq (third specifier) '*))) 'unsigned-byte t))
           ((array simple-array)
            (if (> (length specifier) 3) t
              (let ((element (if (cdr specifier) (second specifier) '*))
                    (dimensions (if (cddr specifier) (third specifier) '*)))
                (cond ((and (eq (car specifier) 'simple-array)
                            (hir-specialized-element-type element)
                            (or (eq dimensions '*)
                                (and (integerp dimensions) (<= 0 dimensions 64))
                                (and (hir-proper-list-p dimensions)
                                     (listp dimensions)
                                     (every (lambda (d) (or (eq d '*) (typep d '(integer 0 *)))) dimensions))))
                       (list :simple-specialized-array element
                             (if (integerp dimensions) (make-list dimensions :initial-element '*) dimensions)))
                      ((or (eql dimensions 1)
                           (and (consp dimensions) (hir-proper-list-p dimensions)
                                (= (length dimensions) 1)))
                       (if (and (eq (car specifier) 'simple-array) (eq element t))
                           'simple-vector (if (eq (car specifier) 'simple-array) :simple-array-vector 'vector)))
                      (t 'array)))))
           (and
            (let ((type t))
              (dolist (part (cdr specifier) type)
                (let ((next (hir-declaration-type part)))
                  (when (eq next t) (return-from hir-declaration-type t))
                  (setf type (hir-type-intersection type next))))))
           (or
            (let ((parts (cdr specifier)))
              (if (null parts) t
                  (reduce #'hir-type-join (mapcar #'hir-declaration-type parts)))))
           (otherwise t)))
        (t t)))

(defun hir-known-subtype-p (actual required)
  "A proof in the finite domain, independent of user-defined type aliases."
  (cond ((eq actual t) nil)
        ((equal actual required) t)
        ((eq required 'unsigned-byte) (hir-nonnegative-integer-type-p actual))
        ((eq required :simple-array-vector)
         (or (member actual '(simple-vector :native-string simple-string))
             (and (hir-simple-specialized-array-p actual)
                  (consp (third actual)) (null (cdr (third actual))))))
        ((hir-simple-specialized-array-p required)
         (and (hir-simple-specialized-array-p actual)
              (equal (second actual) (second required))
              (hir-array-dimensions-subtype-p (third actual) (third required))))
        ((hir-range-p required)
         (cond ((hir-range-p actual)
                (and (<= (second required) (second actual))
                     (<= (third actual) (third required))))
               ((eq actual 'fixnum)
                (and (<= (second required) +hir-fixnum-min+)
                     (<= +hir-fixnum-max+ (third required))))))
        (t
         (let ((predicate (case required
                            (fixnum 'kiln.kernel::fixnump) (integer 'integerp)
                            (rational 'rationalp) (real 'realp) (number 'numberp)
                            (float 'floatp) (cons 'consp) (symbol 'symbolp)
                            (character 'characterp) (simple-vector 'simple-vector-p)
                            (simple-string 'simple-string-p) (string 'stringp)
                            (vector 'vectorp) (array 'arrayp) (function 'functionp)
                            (null 'null) (list 'listp))))
           (and predicate
                (multiple-value-bind (truth known) (hir-type-predicate predicate actual)
                  (and truth known)))))))

(defun hir-declaration-proven-p (actual specifier)
  (setf specifier (hir-declaration-expanded specifier))
  (cond ((and (consp specifier) (member (car specifier) '(array simple-array)))
         (let ((required (hir-declaration-type specifier)))
           (or (and (hir-simple-specialized-array-p required)
                    (hir-known-subtype-p actual required))
               (and (equal specifier '(simple-array t (*)))
                    (hir-known-subtype-p actual 'simple-vector)))))
        ((and (consp specifier) (eq (car specifier) 'and))
         (every (lambda (part) (hir-declaration-proven-p actual part)) (cdr specifier)))
        ((and (consp specifier) (eq (car specifier) 'or))
         (some (lambda (part) (hir-declaration-proven-p actual part)) (cdr specifier)))
        (t (let ((required (hir-declaration-type specifier)))
             (and (not (eq required t)) (hir-known-subtype-p actual required))))))


(defun inferred-comparison-range (name actual other positive)
  "Bound an integer operand on an edge where NAME has the given truth value."
  (let ((left (hir-type-range actual)) (right (hir-type-range other)))
    (unless (and left right) (return-from inferred-comparison-range actual))
    (let ((low (second left)) (high (third left)))
      (case name
        (< (if positive (setf high (min high (1- (third right))))
               (setf low (max low (second right)))))
        (<= (if positive (setf high (min high (third right)))
                (setf low (max low (1+ (second right))))))
        (> (if positive (setf low (max low (1+ (second right))))
               (setf high (min high (third right)))))
        (>= (if positive (setf low (max low (second right)))
                (setf high (min high (1- (third right))))))
        (= (when positive
             (setf low (max low (second right)) high (min high (third right))))))
      ;; An impossible edge has no normal execution. Keep its input fact
      ;; until the domain can represent unreachable edges explicitly.
      (if (<= low high) (hir-integer-range low high) actual))))
