(cl:in-package #:parcl-low)

(defmethod shadowing-import (client package symbol)
  (let ((name (symbol-name client symbol)))
    (multiple-value-bind (present-symbol status)
        (find-present-symbol client package name)
      (unless (and status (eq symbol present-symbol))
        (when status (unintern client package present-symbol))
        (ensure-present-symbol client package symbol :internal)))
    (shadow client package name)))
