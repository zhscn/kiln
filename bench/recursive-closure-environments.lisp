(defvar *published-recursive-closure* nil)
(declaim (notinline benchmark-recursive-environments))
(defun benchmark-recursive-environments (count)
  (declare (type (integer 0 1048576) count))
  (dotimes (index count)
    (let ((value index))
      (labels ((read-value (n)
                 (declare (notinline read-value))
                 (if (zerop n) value (read-value (1- n)))))
        (setq *published-recursive-closure* #'read-value))))
  (if (zerop count) 0 (funcall *published-recursive-closure* 3)))
(let ((value (benchmark-recursive-environments 1000000)))
  (unless (= value 999999) (error "Unexpected result: ~S" value))
  (print value))
