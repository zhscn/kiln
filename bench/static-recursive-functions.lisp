;;; A data-free recursive component returns its own function object.
(declaim (notinline benchmark-static-recursive-functions))
(defun benchmark-static-recursive-functions (count)
  (declare (type (integer 0 1048576) count))
  (let ((checksum 0))
    (declare (fixnum checksum))
    (dotimes (index count checksum)
      (labels ((ping (n)
                 (declare (type (integer 0 1) n))
                 (if (<= n 0) #'pong (pong (1- n))))
               (pong (n)
                 (declare (type (integer 0 1) n))
                 (if (<= n 0) #'ping (ping (1- n)))))
        (declare (notinline ping pong))
        (unless (eq (ping 1) #'ping) (error "Recursive function identity changed"))
        (setq checksum (logxor checksum index))))))
(let ((value (benchmark-static-recursive-functions 1000000)))
  (unless (zerop value) (error "Unexpected static-recursive-functions result: ~S" value))
  (print value))
