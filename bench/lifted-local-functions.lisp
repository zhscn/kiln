;;; Direct recursive calls share a cell and need no function objects.
(declaim (notinline benchmark-lifted-local-functions))
(defun benchmark-lifted-local-functions (count)
  (declare (type (integer 0 1048576) count))
  (let ((value 0) (checksum 0))
    (dotimes (index count)
      (let ((bias index))
        (labels ((left (n)
                   (declare (notinline right))
                   (incf value)
                   (if (zerop n) (+ bias value) (right (1- n))))
                 (right (n)
                   (declare (notinline left))
                   (incf value)
                   (if (zerop n) (+ bias value) (left (1- n)))))
          (declare (notinline left right))
          (incf checksum (left 1))
          (incf checksum (right 1)))))
    checksum))
(let ((value (benchmark-lifted-local-functions 1000000)))
  (unless (= value 5000001000000) (error "Unexpected lifted-local-functions result: ~S" value))
  (print value))
