(defmacro timed (name n form)
  `(let ((start (get-internal-real-time)))
     (dotimes (i ,n) ,form)
     (format t "~a: ~,2f us~%" ,name (/ (- (get-internal-real-time) start) ,n 1.0))))
(defvar *heq* (make-hash-table :test 'eq))
(setf (gethash 'a *heq*) 1)
(defvar *x* 123456789012)
(timed "kiln-eq-hash" 10000 (salmagundi::kiln-eq-hash 'a))
(timed "make-hash" 10000 (salmagundi:make-hash salmagundi::*client*))
(timed "identity-hash" 10000 (kiln.sys:%primop :identity-hash 'a))
(timed "mix-integer" 10000 (salmagundi::mix-integer 5 *x*))
(timed "logand" 10000 (logand *x* #x3fffffffffffffff))
(timed "ash" 10000 (ash *x* -62))
(timed "mod" 10000 (mod *x* 16))
(timed "assoc eq" 10000 (assoc 'b '((a . 1) (b . 2)) :test 'eq))
(timed "hash-table-test" 10000 (salmagundi:hash-table-test *heq*))
(timed "hash-function" 10000 (salmagundi:hash-table-hash-function *heq*))
(timed "funcall symbol" 10000 (funcall 'identity 1))
(timed "gethash eq" 10000 (gethash 'a *heq*))
