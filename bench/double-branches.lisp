;;; Branch results are discarded; only the accumulator update is observable.
(declaim (notinline benchmark-double-branches))
(defun benchmark-double-branches (count)
  (declare (type (integer 0 1048576) count))
  (let ((value 1.25d0))
    (declare (double-float value))
    (dotimes (index count value)
      (case (logand index 3)
        (0 (setq value (+ (* value 0.5d0) (* value 0.5d0))))
        (1 (setq value (+ (* value 0.5d0) (* value 0.5d0))))
        (2 (setq value (+ (* value 0.5d0) (* value 0.5d0))))
        (otherwise (setq value (+ (* value 0.5d0) (* value 0.5d0))))))))
(let ((value (benchmark-double-branches 1000000)))
  (unless (= value 1.25d0) (error "Unexpected double-branches result: ~S" value))
  (print (= value 1.25d0)))
