;;; A direct recursive function uses both defaulted and supplied arguments.
(declaim (notinline benchmark-lifted-optional-functions))
(defun benchmark-lifted-optional-functions (count)
  (declare (type (integer 0 1048576) count))
  (let ((checksum 0))
    (dotimes (index count)
      (let ((value index))
        (labels ((read-value (&optional (n 1))
                   (declare (notinline read-value))
                   (if (zerop n) value (read-value (1- n)))))
          (declare (notinline read-value))
          (incf checksum (read-value)))))
    checksum))
(let ((value (benchmark-lifted-optional-functions 1000000)))
  (unless (= value 499999500000) (error "Unexpected lifted-optional-functions result: ~S" value))
  (print value))
