;;; Unreachable mutually recursive writers must not force closures or cells.
(declaim (notinline benchmark-dead-local-functions))
(defun benchmark-dead-local-functions (count)
  (declare (type (integer 0 1048576) count))
  (let ((checksum 0))
    (declare (fixnum checksum))
    (dotimes (index count checksum)
      (let ((value index))
        (labels ((ping () (pong))
                 (pong () (setq value (1+ value)) (ping)))
          (setq checksum (logxor checksum value)))))))
(let ((value (benchmark-dead-local-functions 1000000)))
  (unless (zerop value) (error "Unexpected dead-local-functions result: ~S" value))
  (print value))
