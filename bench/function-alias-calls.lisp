;;; Both named and anonymous local functions flow through immutable aliases.
(declaim (notinline named-function-alias-loop anonymous-function-alias-loop
                    benchmark-function-alias-calls))
(defun named-function-alias-loop (count)
  (declare (type (integer 0 1048576) count))
  (let ((checksum 0))
    (dotimes (index count)
      (let ((value index))
        (labels ((read-value (n) (+ value n)))
          (let* ((function #'read-value) (other function))
            (incf checksum (funcall function 1))
            (incf checksum (funcall other 2))))))
    checksum))
(defun anonymous-function-alias-loop (count)
  (declare (type (integer 0 1048576) count))
  (let ((checksum 0))
    (dotimes (index count)
      (let* ((value index) (function (lambda (n) (+ value n))) (other function))
        (incf checksum (funcall function 1))
        (incf checksum (funcall other 2))))
    checksum))
(defun benchmark-function-alias-calls (count)
  (+ (named-function-alias-loop count) (anonymous-function-alias-loop count)))
(let ((value (benchmark-function-alias-calls 1000000)))
  (unless (= value 2000004000000) (error "Unexpected function-alias-calls result: ~S" value))
  (print value))
