(defmacro timed (name n form)
  `(let ((start (get-internal-real-time)))
     (dotimes (i ,n) ,form)
     (format t "~a: ~,2f us~%" ,name (/ (- (get-internal-real-time) start) ,n 1.0))))
(defgeneric mb-gf (x))
(defmethod mb-gf ((x t)) x)
(defvar *h* (make-hash-table :test 'equal))
(setf (gethash '(a . b) *h*) 1)
(defvar *heq* (make-hash-table :test 'eq))
(setf (gethash 'a *heq*) 1)
(timed "generic call" 10000 (mb-gf 1))
(timed "subtypep character character" 10000 (subtypep 'character 'character))
(timed "gethash equal cons" 10000 (gethash (cons 'a 'b) *h*))
(timed "gethash eq" 10000 (gethash 'a *heq*))
(timed "cons" 10000 (cons 1 2))
(defclass mb-class () ((a :initarg :a :initform 1)))
(timed "make-instance (defined)" 1000 (make-instance 'mb-class :a 2))
(with-input-from-string (s (make-string 10000 :initial-element #\a))
  (timed "read-char string stream" 10000 (read-char s)))
(with-open-file (s "lisp/target/kernel.lisp")
  (timed "read-char file" 10000 (read-char s))
  (timed "stream-read-char file" 10000 (cyclosis:stream-read-char s))
  (timed "stream-read-octet file" 10000 (cyclosis::stream-read-octet s))
  (timed "check-character-stream" 10000 (cyclosis::check-character-stream s)))
(with-open-file (s "lisp/target/kernel.lisp")
  (let ((tr (cyclosis::octet-transcoder s)))
    (timed "read-element utf-8" 10000 (cyclosis::read-element tr s))
    (timed "stream-element-type" 10000 (stream-element-type s))
    (timed "subtypep (cached)" 10000 (subtypep 'character 'character))
    (timed "in-start accessor" 10000 (cyclosis::in-start s))
    (timed "svref" 10000 (svref (cyclosis::file-buffer s) 3))))
