;;; Generic function calls: the cost of dispatch and of effective methods.
(defmacro timed (name n form)
  `(let ((start (get-internal-real-time)))
     (dotimes (i ,n) ,form)
     (format t "~30a ~8,3f us~%" ,name (/ (- (get-internal-real-time) start) ,n 1.0))))

(defclass gb-a () ((x :initarg :x :accessor gb-x)))
(defclass gb-b (gb-a) ())
(defclass gb-c (gb-a) ())
(defgeneric gb-1 (a))
(defmethod gb-1 ((a gb-a)) 1)
(defmethod gb-1 ((a gb-b)) 2)
(defmethod gb-1 ((a integer)) 3)
(defgeneric gb-2 (a b))
(defmethod gb-2 ((a gb-a) (b gb-a)) 1)
(defmethod gb-2 ((a gb-b) (b integer)) 2)
(defgeneric gb-next (a))
(defmethod gb-next ((a gb-a)) 1)
(defmethod gb-next ((a gb-b)) (1+ (call-next-method)))
(defgeneric gb-around (a))
(defmethod gb-around ((a gb-a)) 1)
(defmethod gb-around :around ((a gb-a)) (call-next-method))
(defmethod gb-around :before ((a gb-b)) nil)
(defgeneric gb-opt (a &optional b))
(defmethod gb-opt ((a gb-a) &optional b) b)
(defgeneric gb-key (a &key k))
(defmethod gb-key ((a gb-a) &key k) k)
(defgeneric gb-eql (a))
(defmethod gb-eql ((a (eql :x))) 1)
(defmethod gb-eql ((a symbol)) 2)
(defun gb-fun (a) a)

(let ((a (make-instance 'gb-a :x 1))
      (b (make-instance 'gb-b :x 2))
      (c (make-instance 'gb-c :x 3))
      (n 200000))
  (gb-1 a) (gb-1 b) (gb-1 c) (gb-1 1)
  (timed "function call" n (gb-fun a))
  (timed "1 arg, class" n (gb-1 b))
  (timed "1 arg, inherited" n (gb-1 c))
  (timed "1 arg, fixnum" n (gb-1 1))
  (timed "2 args" n (gb-2 a b))
  (timed "reader" n (gb-x b))
  (timed "writer" n (setf (gb-x b) 4))
  (timed "call-next-method" n (gb-next b))
  (timed ":around :before" n (gb-around b))
  (timed "&optional" n (gb-opt a 1))
  (timed "&key" n (gb-key a :k 1))
  (timed "eql specializer" n (gb-eql :x))
  (timed "make-instance" 20000 (make-instance 'gb-a :x 1)))
