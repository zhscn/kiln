;;; Escaping closures retain data while static helper bindings need no slots.
(defvar *published-compact-closure* nil)
(declaim (notinline benchmark-compact-closure-environments))
(defun benchmark-compact-closure-environments (count)
  (declare (type (integer 0 1048576) count))
  (dotimes (index count)
    (let ((value index))
      (labels ((zero () 0) (one () 1)
               (read-value ()
                 (declare (notinline zero one))
                 (+ (zero) (one) value)))
        (setq *published-compact-closure* #'read-value))))
  (if (zerop count) 0 (funcall *published-compact-closure*)))
(let ((value (benchmark-compact-closure-environments 1000000)))
  (unless (= value 1000000) (error "Unexpected compact-closure-environments result: ~S" value))
  (print value))
