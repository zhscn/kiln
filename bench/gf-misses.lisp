;;; Which generic functions miss their discriminating functions while
;;; reading a file (a diagnostic for bench/fe-read.lisp).
(defvar *misses* (make-hash-table :test 'equal))
(defvar *recomputes* (make-hash-table :test 'equal))
(let ((old #'clostrophilia::default-discriminating-function))
  (setf (fdefinition 'clostrophilia::default-discriminating-function)
        (lambda (gf arguments profile)
          (incf (gethash (clostrophilia::generic-function-name gf) *misses* 0))
          (funcall old gf arguments profile))))
(let ((old #'clostrophilia::compute-and-install-discriminating-function))
  (setf (fdefinition 'clostrophilia::compute-and-install-discriminating-function)
        (lambda (gf)
          (incf (gethash (clostrophilia::generic-function-name gf) *recomputes* 0))
          (funcall old gf))))
(defun report (table title)
  (let ((entries '()))
    (maphash (lambda (k v) (push (cons k v) entries)) table)
    (format t "~a:~%" title)
    (loop for (name . count) in (subseq (sort entries #'> :key #'cdr) 0 (min 15 (length entries)))
          do (format t "  ~8d ~s~%" count name))))
(dotimes (i 2)
  (clrhash *misses*) (clrhash *recomputes*)
  (with-open-file (s "lisp/target/kernel.lisp")
    (loop with eof = (list nil)
          for object = (eclector.concrete-syntax-tree:read s nil eof)
          until (eq object eof)))
  (report *misses* "misses")
  (report *recomputes* "recomputes"))
